+// Bounded Darwin diagnostics for the Nezha fragmentation experiment: distinguish an oversized
+// growth retry from an allocation that still cannot fit. No counters or API behavior are forged.
+fn note_resource_fallback(growth: u64, required: u64) {
+    #[cfg(target_vendor = "apple")]
+    {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        static REPORTED: AtomicUsize = AtomicUsize::new(0);
+        if REPORTED.fetch_add(1, Ordering::Relaxed) < 8 {
+            unsafe extern "C" {
+                fn syslog(priority: i32, format: *const std::ffi::c_char, ...);
+            }
+            // SAFETY: a static format with exactly the two unsigned 64-bit arguments it names.
+            unsafe { syslog(3, c"pandora-metal: resource fallback growth=%llu required=%llu".as_ptr(), growth, required) };
+        }
+    }
+    #[cfg(not(target_vendor = "apple"))]
+    let _ = (growth, required);
+}
