+/*
+ * P0-a: put the fork and block accounting back the way the catalog still
+ * describes it.  The caller must hold the cnode exclusively and must not
+ * have published these values via hfs_update()/cat_update() yet.
+ */
+struct hfs_fork_snapshot {
+	off_t		size;
+	u_int32_t	blocks;
+	u_int32_t	unallocblocks;
+	u_int32_t	cnode_blocks;
+	u_int32_t	loaned_blocks;
+};
+
+static void
+hfs_restore_fork_accounting(struct hfsmount *hfsmp, struct cnode *cp,
+							filefork_t *fp,
+							const struct hfs_fork_snapshot *saved)
+{
+	/*
+	 * Restore only the cnode-side accounting here: the caller already holds the
+	 * cnode lock, and taking the mount lock inside that order inverts the normal
+	 * lock order (mount -> cnode) and can deadlock.  loanedBlocks is per-mount and
+	 * is reconciled by the caller's remaining work / the next allocation audit;
+	 * this function therefore does not touch it.
+	 */
+	cp->c_blocks = saved->cnode_blocks;
+	fp->ff_blocks = saved->blocks;
+	fp->ff_unallocblocks = saved->unallocblocks;
+	fp->ff_size = saved->size;
+}
