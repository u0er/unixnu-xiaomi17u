+/* Level 20.64 (v2061, 0593): re-send only map A's final frame.
+ *
+ * The 284th frame is 183 bytes and the only thing the ACK gate can attribute
+ * the missing commit to; the other 283 frames stay sent once. The header is
+ * rebuilt with the same 31 00 f0 ff <len+3> 06 <sub> <len> shape and the same
+ * payload bytes, so a re-send is byte-identical to the original final frame.
+ * No flush follows: the ACK may already be in the FIFO and the caller's gate
+ * is the correct reader. */
+static int
+bt_peri_aseg_resend_last(const uint8_t *body, unsigned len, uint8_t sub06, const char *what)
+{
+	uint8_t frame[BT_FW_SEG_MAX + 8u];
+	int err;
+
+	if (len == 0u || len > BT_FW_SEG_MAX) {
+		return EINVAL;
+	}
+	frame[0] = 0x31;
+	frame[1] = 0x00;
+	frame[2] = 0xf0;
+	frame[3] = 0xff;
+	frame[4] = (uint8_t)(len + 3u);
+	frame[5] = 0x06;
+	frame[6] = sub06;
+	frame[7] = (uint8_t)len;
+	for (unsigned i = 0; i < len; i++) {
+		frame[8u + i] = body[i];
+	}
+	err = bt_uart_tx_long(frame, len + 8u, what);
+	if (err == 0) {
+		printf("PANDORA BT: %s: last frame re-sent (%u bytes, same bytes as segment end)\n",
+		    what, len);
+		pandora_log_sync();
+	}
+	return err;
+}
