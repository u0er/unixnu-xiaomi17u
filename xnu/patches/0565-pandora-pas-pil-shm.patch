+/*
+ * The PIL metadata blob has to be below 4 GiB.
+ *
+ * INIT_IMAGE answered 0xffcfffbb (-3145797, "invalid parameter") for every candidate id while the
+ * blob sat at 0x8d0... (2026-11-21), and the ceiling ladder below has never found a low page on
+ * this phone: the low 4 GiB are the platform's carveouts, so every kmem_alloc_contig() ceiling
+ * fails and the blob lands at 0x8caf... (about 37 GiB).  The ladder is a set of failing requests,
+ * not a strategy.  What works on this hardware is the reservation the loader already makes for the
+ * DSP (/chosen pandora-dsp-shm, mapped by pandora_adsp.c's ad_shm_setup()), so the same shape is
+ * used here: /chosen pandora-pil-shm = {pa, size}, 4 KiB pages below 4 GiB, in the free DRAM hole
+ * the live FDT leaves outside /chosen dram-base (XNU never allocates from it).
+ *
+ * One slab per pas id.  A reload of the same image reuses its own slab only after TrustZone has
+ * been told to forget the old blob (pas_meta_release() in pas_meta_arena_take()), and a slab that
+ * another pas still holds is never reused: the ADSP and the modem load different ids, and their
+ * INIT_IMAGE metadata must not overwrite each other before each one's AUTH_AND_RESET.
+ *
+ * ml_io_map_unmappable() entries are permanent (see the trap on ml_io_unmap() below), so the arena
+ * is mapped once for the life of the boot and never freed; pas_meta_free() knows the difference.
+ */
+#define PAS_META_ARENA_SLAB  (16u << 10)
+#define PAS_META_ARENA_SIZE  ((uint64_t)PAS_META_SLOTS * PAS_META_ARENA_SLAB)
+
+static vm_offset_t pas_meta_arena_va;
+static uint64_t pas_meta_arena_pa;
+static bool pas_meta_arena_tried;
+
+static void
+pas_meta_arena_setup(void)
+{
+	DTEntry chosen;
+	const uint64_t *r;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "pandora-pil-shm", (void const **)&r, &size) != kSuccess || size != 16) {
+		printf("PANDORA PAS: no pandora-pil-shm in the ADT: metadata uses the kernel allocator\n");
+		return;
+	}
+	if (!r[1] || ((r[0] | r[1]) & 0xfff) || r[1] < PAS_META_ARENA_SIZE || r[0] + r[1] > (1ull << 32)) {
+		printf("PANDORA PAS: pandora-pil-shm %#llx + %#llx is not %llu bytes of 4 KiB pages below 4 GiB: "
+		    "metadata uses the kernel allocator\n", r[0], r[1], (unsigned long long)PAS_META_ARENA_SIZE);
+		return;
+	}
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)r[0], (vm_size_t)PAS_META_ARENA_SIZE, VM_WIMG_IO);
+	if (!va) {
+		printf("PANDORA PAS: pandora-pil-shm %#llx + %#llx not mapped\n", r[0], r[1]);
+		return;
+	}
+	bzero((void *)va, (size_t)PAS_META_ARENA_SIZE);
+	pas_meta_arena_va = va;
+	pas_meta_arena_pa = r[0];
+	printf("PANDORA PAS: metadata arena %#llx + %#llx below 4 GiB, %u slabs of %u bytes\n", r[0],
+	    (unsigned long long)PAS_META_ARENA_SIZE, (unsigned)PAS_META_SLOTS, (unsigned)PAS_META_ARENA_SLAB);
+}
+
+/* The reserved slab for this pas, or 0 when the caller must fall back to the kernel allocator. */
+static vm_offset_t
+pas_meta_arena_take(unsigned pas, uint64_t size, uint64_t *pa)
+{
+	if (!pas_meta_arena_va) {
+		return 0;
+	}
+	if (size > PAS_META_ARENA_SLAB) {
+		printf("PANDORA PAS: pas %u metadata is %llu bytes, more than a %u-byte slab\n", pas,
+		    (unsigned long long)size, (unsigned)PAS_META_ARENA_SLAB);
+		return 0;
+	}
+	unsigned slot = pas % PAS_META_SLOTS;
+	for (unsigned i = 0; i < PAS_META_SLOTS; i++) {
+		if (!pas_meta[i].used) {
+			continue;
+		}
+		if (pas_meta[i].pas == pas) {
+			/* TrustZone must forget the old blob before its memory is handed out again. */
+			pas_meta_release(pas);
+			break;
+		}
+		if (pas_meta[i].md == pas_meta_arena_va + (uint64_t)slot * PAS_META_ARENA_SLAB) {
+			printf("PANDORA PAS: arena slab %u is live for pas %u: pas %u falls back to the "
+			    "kernel allocator\n", slot, pas_meta[i].pas, pas);
+			return 0;
+		}
+	}
+	*pa = pas_meta_arena_pa + (uint64_t)slot * PAS_META_ARENA_SLAB;
+	return pas_meta_arena_va + (uint64_t)slot * PAS_META_ARENA_SLAB;
+}
+
+/* Free only what kmem_alloc_contig() handed out; the arena lives for the whole boot. */
+static void
+pas_meta_free(vm_offset_t md, uint64_t size)
+{
+	if (pas_meta_arena_va && md >= pas_meta_arena_va &&
+	    md + size <= pas_meta_arena_va + PAS_META_ARENA_SIZE) {
+		return;
+	}
+	kmem_free(kernel_map, md, (vm_size_t)size);
+}
+
