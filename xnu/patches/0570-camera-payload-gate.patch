+
+/* payload gate (draft): a sticky RX error bit only proves that an error was
+ * seen at some point in the stream. Clear the RX IRQ latch, then re-read the
+ * CSID1080 counters and the RX status inside the same window: a frame buffer
+ * may be consumed as P6 data only when PAYLOAD_CRC (bit25) does not re-latch
+ * after the clear (checked at +1 ms and +21 ms) and total_crc_err (0x8C8)
+ * is zero and not moving. The counters are cumulative since the CSID reset
+ * and are not cleared here, so a prior error keeps the gate closed for the
+ * whole stream. */
+#define PC_RX_IRQ_PAYLOAD_CRC  (1u << 25)
+static int
+pc_payload_gate(vm_offset_t csid, const char *tag)
+{
+	uint32_t rx_before, rx0, rx1, pkts0, pkts1, ecc0, ecc1, crc0, crc1;
+	int pass;
+
+	rx_before = pc_rd(csid, 0x1b0u);	/* CSI2_RX_IRQ_STATUS */
+	pc_wr(csid, 0x1b8u, 0xffffffffu);	/* RX IRQ clear */
+	pc_sleep(1);
+	pkts0 = pc_rd(csid, 0x8c0u);		/* total_pkts_rcvd */
+	ecc0  = pc_rd(csid, 0x8c4u);		/* stats_ecc */
+	crc0  = pc_rd(csid, 0x8c8u);		/* total_crc_err */
+	rx0   = pc_rd(csid, 0x1b0u);
+	pc_sleep(20);
+	pkts1 = pc_rd(csid, 0x8c0u);
+	ecc1  = pc_rd(csid, 0x8c4u);
+	crc1  = pc_rd(csid, 0x8c8u);
+	rx1   = pc_rd(csid, 0x1b0u);
+
+	pass = !(rx0 & PC_RX_IRQ_PAYLOAD_CRC) &&
+	    !(rx1 & PC_RX_IRQ_PAYLOAD_CRC) && crc1 == 0u && crc1 == crc0;
+	printf("PANDORA PAYLOADGATE: tag=%s csid=%#llx rx_before=%#x "
+	    "rx_after_clear=%#x rx_settled=%#x bit24=%u bit25=%u "
+	    "pkts0=%#x pkts1=%#x ecc0=%#x ecc1=%#x crc0=%#x crc1=%#x "
+	    "dcrc=%d dpkts=%d gate=%s\n",
+	    tag, (unsigned long long)csid, rx_before, rx0, rx1,
+	    (rx1 & (1u << 24)) ? 1u : 0u,
+	    (rx1 & PC_RX_IRQ_PAYLOAD_CRC) ? 1u : 0u,
+	    pkts0, pkts1, ecc0, ecc1, crc0, crc1,
+	    (int)(crc1 - crc0), (int)(pkts1 - pkts0),
+	    pass ? "PASS" : "FAIL");
+	(void)pandora_log_sync();
+	return pass;
+}
