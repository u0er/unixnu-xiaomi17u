diff --git a/bsd/dev/pandora_adsp.c b/bsd/dev/pandora_adsp.c
index 56132ef..bfc699d 100644
--- a/bsd/dev/pandora_adsp.c
+++ b/bsd/dev/pandora_adsp.c
@@ -753,20 +753,32 @@ pas_load(const char *base, bool part, unsigned pas, uint64_t mem_pa, uint64_t me
 		snprintf(name, sizeof(name), "%s.mdt", base);
 	}
 	struct fw_file mdt;
-	if (fw_open(name, part, &mdt) || mdt.size < 52 || mdt.size > 0x10000) {
+	if (fw_open(name, part, &mdt) || mdt.size < 52) {
 		printf("PANDORA ADSP: %s missing in the %s\n", name, part ? "firmware partition" : "pack");
 		return ENOENT;
 	}
+	/*
+	 * Only the ELF header and the program header table are needed up front; the segments and
+	 * the hash table are read straight from the image.  The 64 KiB staging buffer used to cap
+	 * the whole image, which rejected every real MDT (the VPU's vpu40_2v_v1.mbn is 2.35 MiB
+	 * and its hash segment sits at 0x258000), so this is now bounded by the header instead.
+	 */
 	static uint8_t hdr[0x10000];
-	int err = fw_pread(&mdt, 0, hdr, mdt.size);
+	unsigned hdr_bytes = mdt.size < sizeof(hdr) ? (unsigned)mdt.size : (unsigned)sizeof(hdr);
+	int err = fw_pread(&mdt, 0, hdr, hdr_bytes);
 	if (err) {
 		return err;
 	}
+	if (hdr_bytes < 52) {
+		printf("PANDORA ADSP: %s is %u bytes, shorter than an ELF header\n", name, hdr_bytes);
+		return EINVAL;
+	}
 	uint32_t phoff, phnum;
 	memcpy(&phoff, hdr + 28, 4);
 	phnum = hdr[44] | (hdr[45] << 8);
 	if (memcmp(hdr, "\177ELF", 4) || hdr[4] != 1 || phnum < 2 || phnum > 128 ||
-	    phoff + phnum * sizeof(struct elf32_phdr) > mdt.size) {
+	    (uint64_t)phoff + phnum * sizeof(struct elf32_phdr) > mdt.size ||
+	    (uint64_t)phoff + phnum * sizeof(struct elf32_phdr) > hdr_bytes) {
 		printf("PANDORA ADSP: %s is not a 32-bit ELF header\n", name);
 		return EINVAL;
 	}
@@ -783,17 +795,38 @@ pas_load(const char *base, bool part, unsigned pas, uint64_t mem_pa, uint64_t me
 		}
 		reloc |= (ph[i].p_flags & MDT_RELOCATABLE) != 0;
 		min = MIN(min, (uint64_t)ph[i].p_paddr);
-		max = MAX(max, ((uint64_t)ph[i].p_paddr + ph[i].p_memsz + 0xfff) & ~0xfffull);
+		/* Upstream qcom_mdt_load passes `max_addr - min_addr` untouched to
+		 * qcom_scm_pas_mem_setup; it never page-aligns it.  Keep the exact end
+		 * of the last segment, and align only where a mapping/length is needed
+		 * (max_page below), so mem_setup matches the reference byte for byte. */
+		max = MAX(max, (uint64_t)ph[i].p_paddr + ph[i].p_memsz);
 	}
+	const uint64_t max_page = (max + 0xfff) & ~0xfffull;
 	if (!hash || ph[0].p_type == 1 || min == ~0ull) {
 		printf("PANDORA ADSP: %s: no hash segment\n", name);
 		return EINVAL;
 	}
-	uint32_t ehdr_size = ph[0].p_filesz, hash_size = ph[hash].p_filesz;
+	/* The metadata blob TZ authenticates is the ELF header plus the program
+	 * header table, i.e. e_phoff + e_phnum * e_phentsize (52 + 22*32 = 756 for
+	 * the VPU image).  ph[0].p_filesz happens to equal that for this image
+	 * because segment 0 is a PT_NULL canary, but relying on it would break for
+	 * any image without that canary.  Require the canary shape, then use the
+	 * real formula. */
+	if (ph[0].p_type != 0) {
+		printf("PANDORA ADSP: %s: no PT_NULL canary in segment 0\n", name);
+		return EINVAL;
+	}
+	uint32_t ehdr_size = phoff + (uint32_t)phnum * (uint32_t)sizeof(struct elf32_phdr);
+	if (ehdr_size > ph[0].p_filesz) {
+		printf("PANDORA ADSP: %s: header table %u exceeds segment 0 (%u)\n", name,
+		    ehdr_size, ph[0].p_filesz);
+		return EINVAL;
+	}
+	uint32_t hash_size = ph[hash].p_filesz;
 	uint64_t md_size = ((uint64_t)ehdr_size + hash_size + 0xfff) & ~0xfffull;
 	printf("PANDORA ADSP: %s (%s): %u segments, hash %u (%u bytes), load %#llx-%#llx%s\n", name,
 	    part ? "firmware partition" : "pack", phnum, hash, hash_size, min, max, reloc ? " relocatable" : "");
-	if (max - min > mem_size) {
+	if (max_page - min > mem_size) {
 		printf("PANDORA ADSP: %s does not fit its carveout\n", name);
 		return EINVAL;
 	}
@@ -803,11 +836,25 @@ pas_load(const char *base, bool part, unsigned pas, uint64_t mem_pa, uint64_t me
 		return ENOMEM;
 	}
 	uint64_t md_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)md));
+	if (ehdr_size > hdr_bytes) {
+		printf("PANDORA ADSP: %s: ELF header is %u bytes, staging holds %u\n", name, ehdr_size,
+		    hdr_bytes);
+		return EINVAL;
+	}
 	memcpy((void *)md, hdr, ehdr_size);
-	if (ehdr_size + hash_size == mdt.size) {
-		memcpy((void *)(md + ehdr_size), hdr + ehdr_size, hash_size);
-	} else if ((uint64_t)ph[hash].p_offset + hash_size <= mdt.size) {
+	/*
+	 * The hash table normally sits at the end of the image (VPU: offset 0x258000 of 2.35 MiB),
+	 * well past the header staging area, so it has to come from the file.  Only an image whose
+	 * hash happens to be inside the staging window may be copied from memory.
+	 */
+	if ((uint64_t)ph[hash].p_offset + hash_size <= mdt.size &&
+	    (uint64_t)ph[hash].p_offset + hash_size <= hdr_bytes) {
 		memcpy((void *)(md + ehdr_size), hdr + ph[hash].p_offset, hash_size);
+	} else if ((uint64_t)ph[hash].p_offset + hash_size <= mdt.size) {
+		if ((err = fw_pread(&mdt, ph[hash].p_offset, (void *)(md + ehdr_size), hash_size))) {
+			printf("PANDORA ADSP: %s: hash segment read failed %d\n", name, err);
+			return err;
+		}
 	} else if ((err = mdt_segment(base, part, &mdt, &ph[hash], hash, (void *)(md + ehdr_size)))) {
 		return err;
 	}
