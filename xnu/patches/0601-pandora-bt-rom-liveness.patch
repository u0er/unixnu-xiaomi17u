+/* Level 20.66 (v2063, 0601): non-destructive ROM liveness handshake.
+ *
+ * Called only when a stage's tail timed out although the resident f0 04 stream
+ * was advancing. The order is the trace's own PERI order (9.766-9.930 s):
+ * reset 31 00 f1 ff 01 03 with the fd/fc wake, arbitrate v3, GetVer(00),
+ * TMEPatchVerReq v3, then 0x19 - the vendor command phase B opens with.
+ *
+ * The verdict is 0x19's answer, not the probe's own byte count: 0x19 is the
+ * gate the next stage needs, so an answer here is worth more than any number
+ * of records we did not ask for. A silent 0x19 leaves the caller on the old
+ * failure path, with the handshake's four anchors in the log as the reason.
+ *
+ * Stated once: a reset here could drop staged state in the ROM. It is the same
+ * reset Android sends 21 ms before its map stages, and the alternative is a
+ * phase that cannot pass on any ROM that does not implement the sub-06 ACK. */
+static int
+bt_peri_rom_alive_probe(const char *what)
+{
+	int rerr = bt_peri_reset();
+	int aerr = bt_peri_arbitrate_v3();
+	int gerr = bt_peri_getver_window(700u);
+	int verr = bt_peri_version_v3();
+	int oerr = bt_peri_vs_cmd(0x19u, 400u, "PERI ROM liveness 0x19");
+
+	printf("PANDORA BT: %s: ROM liveness handshake: reset %s (%d), arbitrate v3 %s (%d), GetVer(00) %s (%d), version v3 %s (%d), 0x19 %s (%d) -> %s\n",
+	    what, rerr ? "failed" : "ok", rerr, aerr ? "silent" : "ok", aerr,
+	    gerr ? "silent" : "ok", gerr, verr ? "silent" : "ok", verr,
+	    oerr ? "silent" : "answered", oerr,
+	    oerr ? "ROM STALLED" : "ROM ALIVE");
+	pandora_log_sync();
+	return oerr ? ETIMEDOUT : 0;
+}
