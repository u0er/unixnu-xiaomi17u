diff --git a/bsd/dev/pandora_vidc.c b/bsd/dev/pandora_vidc.c
--- a/bsd/dev/pandora_vidc.c
+++ b/bsd/dev/pandora_vidc.c
@@ -1737,10 +1737,21 @@
             VIDEO_REGION_PA, VIDEO_REGION_SIZE, true);
     }
     if (err == 0) {
-        /* Vendor parity: even with no CP region the video driver tells TZ the
-         * (empty) protected range.  That SCM call is the only vendor step our
-         * path never made; see pandora_scm_mem_protect_video_var(). */
-        (void)pandora_scm_mem_protect_video_var(0, 0, 0, 0);
+        /* Vendor parity, now with the vendor's own numbers instead of zeros.
+         *
+         * The vendor builds this 4-tuple from its platform table
+         * canoe_context_bank_table (ko .rodata+0x1ad58, 6 x 0x20 B) at
+         * __init_resources (0x4fb28-0x4fbfc) and folds it in
+         * msm_vidc_mem_protect_video_regions_v1 (0x9bfc): an entry whose
+         * flags (dst+0x28, copied from table+0x14) has BIT(1) supplies
+         * cp_size, an entry with BIT(4) supplies nonpixel start/size.
+         *   qcom,vidc,cb-ns          flags 0x0e  +8 0x25800000 -> cp_size
+         *   qcom,vidc,cb-sec-non-pxl flags 0x10  +8/+c 0x01000000/0x24800000
+         * => qcom_scm_mem_protect_video_var(0, 0x25800000, 0x01000000,
+         *    0x24800000), identical to mainline sm8750_data.tz_cp_config.
+         * Single variable for round 0546 (0539d base, nothing else). */
+        (void)pandora_scm_mem_protect_video_var(0, 0x25800000u, 0x01000000u,
+            0x24800000u);
     }
     if (err != 0) {
         printf("PANDORA VIDC: PAS load/auth failed for %s (err %d)\n", vidc_fw_name, err);
