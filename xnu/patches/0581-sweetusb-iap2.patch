+/* ---- /dev/iap2: raw if0 producer (sweetusb=6) ---- */
+
+static void
+iap2_rx_push(const uint8_t *buf, uint32_t len)
+{
+	uint32_t tail, first;
+
+	lck_mtx_lock(ia.lock);
+	if (!ia.open) {
+		ia.dropped += len;
+		lck_mtx_unlock(ia.lock);
+		return;
+	}
+	if (UD_IAP2_RING - ia.used < len) {
+		if (ia.dropped == 0) {
+			printf("SWEET IAP2: rx ring full, dropping (reader stalled)\n");
+		}
+		ia.dropped += len;
+		lck_mtx_unlock(ia.lock);
+		return;
+	}
+	tail = (ia.head + ia.used) % UD_IAP2_RING;
+	first = MIN(len, UD_IAP2_RING - tail);
+	memcpy(ia.rx + tail, buf, first);
+	if (len > first) {
+		memcpy(ia.rx, buf + first, len - first);
+	}
+	ia.used += len;
+	ia.in_bytes += len;
+	lck_mtx_unlock(ia.lock);
+	wakeup(&ia);
+	selwakeup(&ia.sel);
+}
+
+/* Bus reset: the endpoint dropped our TRB, so the writer must not wait on it. */
+static void
+iap2_quiesce(void)
+{
+	lck_mtx_lock(ia.lock);
+	ud.tx_busy = false;
+	ia.head = ia.used = 0;
+	lck_mtx_unlock(ia.lock);
+	wakeup(&ia);
+	selwakeup(&ia.sel);
+}
+
+static int
+iap2_open(dev_t dev __unused, int flags __unused, int devtype __unused,
+    proc_t p __unused)
+{
+	lck_mtx_lock(ia.lock);
+	if (ia.open) {
+		lck_mtx_unlock(ia.lock);
+		return EBUSY;
+	}
+	ia.open = true;
+	ia.head = ia.used = 0;
+	ia.dropped = 0;
+	ia.in_bytes = ia.out_bytes = 0;
+	lck_mtx_unlock(ia.lock);
+	printf("SWEET IAP2: producer opened /dev/iap2\n");
+	return 0;
+}
+
+static int
+iap2_close(dev_t dev __unused, int flags __unused, int devtype __unused,
+    proc_t p __unused)
+{
+	uint64_t in, out;
+	uint32_t dropped;
+
+	lck_mtx_lock(ia.lock);
+	ia.open = false;
+	in = ia.in_bytes;
+	out = ia.out_bytes;
+	dropped = ia.dropped;
+	ia.head = ia.used = 0;
+	lck_mtx_unlock(ia.lock);
+	wakeup(&ia);
+	selwakeup(&ia.sel);
+	printf("SWEET IAP2: producer closed, in %llu out %llu dropped %u\n",
+	    in, out, dropped);
+	return 0;
+}
+
+static int
+iap2_read(dev_t dev __unused, struct uio *uio, int ioflag __unused)
+{
+	int err = 0;
+
+	while (uio_resid(uio) > 0) {
+		uint32_t n, i;
+
+		lck_mtx_lock(ia.lock);
+		while (ia.used == 0) {
+			if (!ia.open) {
+				lck_mtx_unlock(ia.lock);
+				return 0;
+			}
+			err = msleep(&ia, ia.lock, PRIBIO | PCATCH, "iap2rd", NULL);
+			if (err) {
+				lck_mtx_unlock(ia.lock);
+				return err;
+			}
+		}
+		n = MIN(ia.used, (uint32_t)uio_resid(uio));
+		n = MIN(n, UD_IAP2_CHUNK);
+		for (i = 0; i < n; i++) {
+			ia.stage_rx[i] = ia.rx[(ia.head + i) % UD_IAP2_RING];
+		}
+		ia.head = (ia.head + n) % UD_IAP2_RING;
+		ia.used -= n;
+		lck_mtx_unlock(ia.lock);
+		if ((err = uiomove((caddr_t)ia.stage_rx, (int)n, uio)) != 0) {
+			return err;
+		}
+	}
+	return 0;
+}
+
+static int
+iap2_write(dev_t dev __unused, struct uio *uio, int ioflag __unused)
+{
+	int err = 0;
+
+	while (uio_resid(uio) > 0) {
+		uint32_t n = MIN((uint32_t)uio_resid(uio), UD_IAP2_CHUNK);
+
+		if ((err = uiomove((caddr_t)ia.stage_tx, (int)n, uio)) != 0) {
+			break;
+		}
+		lck_mtx_lock(ia.lock);
+		while (!err && ia.open && (!ud.configured || ud.tx_busy)) {
+			/* A bus reset clears configured/tx_busy outside this lock, so
+			 * a wakeup can be lost; the timeout keeps the writer making
+			 * progress instead of sleeping on a transfer that will never
+			 * complete. */
+			struct timespec ts = { .tv_sec = 1, .tv_nsec = 0 };
+
+			err = msleep(&ia, ia.lock, PRIBIO | PCATCH, "iap2wr", &ts);
+			if (err == EWOULDBLOCK) {
+				err = 0;
+			}
+		}
+		if (!err && !ia.open) {
+			err = EIO;
+		}
+		if (!err) {
+			memcpy((void *)(ud.dma + UD_TX), ia.stage_tx, n);
+			ud.tx_busy = true;
+			ia.out_bytes += n;
+			ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
+		}
+		lck_mtx_unlock(ia.lock);
+		if (err) {
+			printf("SWEET IAP2: write %u failed, err %d\n", n, err);
+			break;
+		}
+	}
+	return err;
+}
+
+static int
+iap2_select(dev_t dev __unused, int which, void *wql, proc_t p)
+{
+	int ready = 0;
+
+	lck_mtx_lock(ia.lock);
+	if (which == FREAD) {
+		ready = ia.used != 0;
+	} else if (which == FWRITE) {
+		ready = ud.configured && !ud.tx_busy;
+	}
+	if (!ready) {
+		selrecord(p, &ia.sel, wql);
+	}
+	lck_mtx_unlock(ia.lock);
+	return ready;
+}
+
+static const struct cdevsw iap2_cdevsw = {
+	.d_open     = iap2_open,
+	.d_close    = iap2_close,
+	.d_read     = iap2_read,
+	.d_write    = iap2_write,
+	.d_ioctl    = eno_ioctl,
+	.d_stop     = eno_stop,
+	.d_reset    = eno_reset,
+	.d_ttys     = NULL,
+	.d_select   = iap2_select,
+	.d_mmap     = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type     = 0,
+};
+
+static int
+iap2_dev_init(void)
+{
+	vm_offset_t va = 0;
+	int major;
+
+	if (ia.lock != NULL) {
+		return 0;
+	}
+	ia.grp = lck_grp_alloc_init("sweet_iap2", LCK_GRP_ATTR_NULL);
+	ia.lock = lck_mtx_alloc_init(ia.grp, LCK_ATTR_NULL);
+	if (kmem_alloc(kernel_map, &va, round_page(UD_IAP2_RING),
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		printf("SWEET IAP2: no rx ring\n");
+		return ENOMEM;
+	}
+	ia.rx = (uint8_t *)va;
+	if (kmem_alloc(kernel_map, &va, round_page(2 * UD_IAP2_CHUNK),
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		printf("SWEET IAP2: no staging buffer\n");
+		return ENOMEM;
+	}
+	ia.stage_rx = (uint8_t *)va;
+	ia.stage_tx = ia.stage_rx + UD_IAP2_CHUNK;
+	major = cdevsw_add(-1, &iap2_cdevsw);
+	if (major < 0) {
+		printf("SWEET IAP2: cdevsw_add failed\n");
+		return ENXIO;
+	}
+	if (devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL,
+	    0660, "iap2") == NULL) {
+		printf("SWEET IAP2: devfs node failed\n");
+		return ENXIO;
+	}
+	printf("SWEET IAP2: /dev/iap2 producer node ready\n");
+	return 0;
+}
