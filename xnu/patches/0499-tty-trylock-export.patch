diff --git a/bsd/kern/tty.c b/bsd/kern/tty.c
index e6f410a..79cd187 100644
--- a/bsd/kern/tty.c
+++ b/bsd/kern/tty.c
@@ -297,6 +297,25 @@ tty_unlock(struct tty *tp)
 	lck_mtx_unlock(&tp->t_lock);
 }
 
+
+/*
+ * tty_trylock
+ *
+ * Attempt to lock the requested tty structure, without blocking.
+ *
+ * Parameters:	tp				The tty we want to lock
+ *
+ * Returns:	TRUE if the lock was acquired, FALSE if it is already held
+ *
+ * Locks:	On success, tp is locked
+ */
+boolean_t
+tty_trylock(struct tty *tp)
+{
+	TTY_LOCK_NOTOWNED(tp);  /* debug assert */
+	return lck_mtx_try_lock(&tp->t_lock);
+}
+
