+/*
+ * 0569: the smallest consumer of the router's service table -- two ports, seven lookups, one line
+ * per answer with the node and the service.  Sends nothing and starts no session; idempotent and
+ * refused by pandora_cell_probe=0.  Called at pandora_mpss.c's mp_qrtr_state() up edge and from
+ * pandora_cell_start().
+ */
+void pandora_cell_qmi_probe(void);
+
 /*
  * The interface half alone: make en1, attach it, attach BPF, and leave it down until a data
  * session gives it an address. Returns 0 or an errno; EALREADY-and-quiet when en1 already exists.
