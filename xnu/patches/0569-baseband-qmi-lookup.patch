+/* ---- 0569: the service probe ----------------------------------------------------------------- *
+ *
+ * The attach ring stops at step 10 (the modem's FIFO, item 480), so step 11 never runs and neither
+ * pandora_cell_start() nor cell_qmi_links_open() exists in that ring.  The eleven NEW_SERVER
+ * announcements the ADSP's IPCRTR edge sends -- 0x0f three times, 0x33 three times, then 0x2b,
+ * 0x42, 0x190, 0x301 and 0x1399, all at node 5 -- therefore land in pandora_qrtr.c's
+ * pq_servers[] with nobody asking for them, and no line says what any of those ids is.
+ *
+ * This is the smallest consumer of that table: two ports (a port holds four lookups) and one
+ * lookup per service id, each answer printed with the node and the service.  It sends no QMI
+ * message, allocates no transaction and starts no session; its only effect is that the next ring
+ * can put a name to 0x0f/0x33/0x190/0x301/0x1399.
+ *
+ * The modem's six QMI ids are not in this list: cell_qmi_links_open() looks them up, and
+ * cell_link_server() now prints the service they answered with, so asking for them again would
+ * only duplicate the lines.
+ */
+#define CELL_PROBE_PORTS        2       /* pq_ports is sixteen wide; the probe takes two */
+#define CELL_PROBE_PER_PORT     4       /* pq_ports[] lookups[4], the router's own limit */
+
+static const uint32_t cell_probe_services[] = {
+	0x0f, 0x2b, 0x33, 0x42, 0x190, 0x301, 0x1399,
+};
+
+static struct pandora_qrtr_port *cell_probe_port[CELL_PROBE_PORTS];
+static bool cell_probe_asked;
+
+/* One line per answer: the node it came from, the port, and the service. */
+static void
+cell_probe_server(void *context, bool arrived, uint32_t service, uint32_t version,
+    uint32_t instance, uint32_t node, uint32_t port)
+{
+	(void)context;
+	/*
+	 * The version and instance words are not printed: an announcement's instance reaches
+	 * pq_tell() raw while a lookup's answer reaches pandora_qrtr_fresh() as version|instance<<8,
+	 * so a line naming them would be right on one path and wrong on the other.  Node and port
+	 * are what both paths carry unchanged, and they are what this probe is for.
+	 */
+	(void)version;
+	(void)instance;
+	if (!arrived) {
+		pandora_say("QMI probe: service %#x at node %u port %u went away\n", service, node, port);
+		return;
+	}
+	pandora_say("QMI probe: service %#x at node %u port %u\n", service, node, port);
+}
+
+/*
+ * Idempotent, and refused by pandora_cell_probe=0.  Called from mp_qrtr_state() at the router
+ * channel's up edge (before the HELLO and the directory that follow it) and from
+ * pandora_cell_start(): the first is the only one that runs in the attach ring, the second covers
+ * a boot whose link step is skipped.
+ */
+void
+pandora_cell_qmi_probe(void)
+{
+	unsigned on = 1;
+	unsigned asked = 0;
+
+	if (cell_probe_asked) {
+		return;
+	}
+	cell_probe_asked = true;
+	if (PE_parse_boot_argn("pandora_cell_probe", &on, sizeof(on)) && on == 0) {
+		pandora_say("QMI probe: off (pandora_cell_probe=0)\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(cell_probe_services) / sizeof(cell_probe_services[0]); i++) {
+		unsigned slot = asked / CELL_PROBE_PER_PORT;
+
+		if (slot >= CELL_PROBE_PORTS) {
+			break;
+		}
+		if (cell_probe_port[slot] == NULL) {
+			cell_probe_port[slot] = pandora_qrtr_open(NULL, cell_probe_server, NULL);
+			if (cell_probe_port[slot] == NULL) {
+				pandora_say("QMI probe: the router has no free port\n");
+				return;
+			}
+			pandora_say("QMI probe: port %u\n",
+			    pandora_qrtr_port_number(cell_probe_port[slot]));
+		}
+		if (pandora_qrtr_lookup(cell_probe_port[slot], cell_probe_services[i], 0, 0) != 0) {
+			pandora_say("QMI probe: no lookup slot for %#x\n", cell_probe_services[i]);
+			return;
+		}
+		pandora_say("QMI probe: looking up %#x\n", cell_probe_services[i]);
+		asked++;
+	}
+	if (asked != 0) {
+		pandora_say("QMI probe: %u services in\n", asked);
+		/*
+		 * A lookup stays "fresh" until the router's own pump replays it, and pq_tell() holds a
+		 * fresh one back on purpose.  In the attach ring that pump is never reached -- step 10
+		 * fails before pandora_mpss.c starts mp_link_thread -- so this call is what makes the
+		 * lookups live: from here on every NEW_SERVER the peer sends rings cell_probe_server(),
+		 * and any service already in the table is answered now.
+		 */
+		pandora_qrtr_fresh();
+	}
+}
