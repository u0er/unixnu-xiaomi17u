 	printf("PANDORA MPSS: channel %s %s\n", channel->name, up ? "up" : "down");
+	/*
+	 * 0569: the service probe goes in here, at the channel's up edge, because this is the last
+	 * point that runs before the HELLO and the directory the peer sends next: its lookups must
+	 * already be in the router's table when those announcements are parsed.  With the attach ring
+	 * stopping at step 10 this edge is reached and step_qrtr()'s pandora_cell_start() is not.
+	 */
+	if (up) {
+		pandora_cell_qmi_probe();
+	}
 }
 
