+/* ---------------------------------------------------------------------------
+ * CSIPHY0 real-sensor receive front-end (boot arg pandora_csiphy=1), slice A.
+ * Brings up the wide sensor's CSI D-PHY (csiphy0 @ 0x9523000) on top of the
+ * proven TPG clock/power tree, then reads back PHY status to verify the analog
+ * front-end initializes without fault. Does NOT yet route real data into CSID
+ * (slice B adds the CSID real RX mux + sensor stream-on + frame capture).
+ *
+ * Facts: mainline phy-qcom-mipi-csi2-3ph-dphy.c (lane_regs_x1e80100, 3ph ops) +
+ * phy-qcom-mipi-csi2-core.c (power-on order); live base.dtb csiphy0 supplies
+ * (csi-vdd-0p9 = pmh0110_i_l3 -> L3I_E0, csi-vdd-1p2 = pmh0110_d_l1 -> L1D_E0);
+ * clk_camcc-kaanapali.c (csiphy0_clk branch 0x2001c, csi0phytimer 0x20018 /
+ * RCG 0x20000). Wide link_freq ~1067.7 MHz (DT cphy_rx_clk_src 266.9 MHz = link/4),
+ * timer 400 MHz -> settle_cnt 29. GPL-2.0 fact-only rewrite.
+ * ------------------------------------------------------------------------- */
+#define PC_CSIPHY0_PA      0x09523000u
+#define PC_CSIPHY0_BYTES   0x2000u
+#define PC_CPHY_CMN        0x1000u          /* common_regs_offset */
+#define PC_CPHY_CTRL(n)    (PC_CPHY_CMN + 4u * (n))
+#define PC_CPHY_STATUS(n)  (0x10b0u + 4u * (n))
+#define PC_CSIPHY0_CLK_CBCR    0x2001cu     /* csiphy0_clk branch */
+#define PC_CSI0PHYTIMER_CBCR   0x20018u     /* csi0phytimer_clk branch */
+#define PC_CSI0PHYTIMER_RCG    0x20000u     /* csi0phytimer_clk_src RCG */
+#define PC_WIDE_LINK_FREQ      1067715244ull
+#define PC_CPHY_TIMER_RATE     400000000u
+
+extern int pandora_rpmh_arc(const char *, uint32_t);
+
+static void
+pc_csiphy_mark(const char *msg)
+{
+	printf("PANDORA CSIPHY: %s\n", msg);
+	(void)pandora_log_sync();
+}
+
+/* settle_cnt per mainline phy_qcom_mipi_csi2_settle_cnt_calc (ps math). */
+static unsigned
+pc_csiphy_settle(uint64_t link_freq, uint32_t timer_rate)
+{
+	uint64_t ui_ps = 1000000000000ull / link_freq / 2;
+	uint64_t settle_ps = 85000 + 6 * ui_ps;
+	uint64_t timer_ps = 1000000000000ull / timer_rate;
+	if (settle_ps / timer_ps < 6)
+		return 0;
+	return (unsigned)(settle_ps / timer_ps - 6);
+}
+
+/* ---------------------------------------------------------------------------
+ * Slice B1: real sensor -> CSIPHY0 -> CSID real RX mux -> RDI0 input events.
+ * Boot arg pandora_csiphy=2 runs slice A (PHY front-end up) and then this.
+ * =1 keeps slice A byte-for-byte unchanged, so the single-variable A/B stays
+ * intact and a negative result is attributable to B1 alone.
+ *
+ * Facts (CAMERA_L2_TPG_IMPL §3.2/§3.3 + mainline camss-csid.c):
+ *   RX_CFG0 real mux = PHY_NUM_SEL BIT(20) | lane_assign 0x3210 << 4 |
+ *   (lane_cnt-1)=3 -> 0x00132103. No TPG_MUX_EN BIT(27) / TPG_MUX_SEL.
+ *   RDI_CFG0 is resolution independent: 0x002BF160, enabled by readback |
+ *   BIT(31). RDI_CFG1 = PACKING_FORMAT_MIPI BIT(15). Non-lite only:
+ *   RDI_PIX_STORE_CFG0 = 9. RDIN IRQ @0x224: RUP_DONE BIT(23),
+ *   INPUT_SOF BIT(12), INPUT_EOF BIT(9) -- SOF/EOF are input-side events and
+ *   need no capture buffer, which is exactly what B1 asserts (VFE DMA is B2).
+ *   Sensor: wide ovx10500u, CCI0 master1, slave 0x10, 8-bit data. The live DT
+ *   has no mode node, so the real output size is latched in 0x034C..0x034F
+ *   (16-bit big-endian pairs) and has to be measured on-device.
+ *
+ * Order: the source streams LAST (same rule that fixed the TPG RDI_CFG0 race):
+ * replay the Android table, read the size back, return the sensor to standby,
+ * arm CSID RX/RDI, then issue stream-on and poll.
+ * ------------------------------------------------------------------------- */
+#define PC_SLICEB_SLAVE    0x10u
+#define PC_SLICEB_MASTER   1u
+#define PC_RDIN_IRQ(n)     (0x224u + 0x10u * (n))
+#define PC_RDIN_RUP_DONE   PC_BIT(23)
+#define PC_RDIN_INPUT_SOF  PC_BIT(12)
+#define PC_RDIN_INPUT_EOF  PC_BIT(9)
+
+/* One 8-bit sensor register read through the verified timed read path. The
+ * helper returns the data byte in *ret's value; errors are reported by the
+ * helper itself and surface as ret != 0. */
+static uint8_t
+pc_sliceb_rd8(uint16_t reg, int *ret)
+{
+	uint16_t v = 0;
+
+	*ret = pc_cci_read_reg16_timed(pc_cci[0], PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, reg, &v);
+	return (uint8_t)(v & 0xffu);
+}
+
+static void
+pc_sliceb_stream_on(int on)
+{
+	int ret = pc_cci_write_reg(pc_cci[0], PC_SLICEB_MASTER, PC_SLICEB_SLAVE,
+	    0x0100u, on ? 1u : 0u, 1u);
+
+	printf("PANDORA SLICEB: sensor 0x0100 stream %s ret=%d\n",
+	    on ? "on" : "off", ret);
+	(void)pandora_log_sync();
+}
+
+/* Arm CSID for one RX mux candidate: reset, RX_CFG0/1, RDI0 (payload-only,
+ * resolution independent), 2x AUP + RUP, RDI_CTRL=1. Returns the RDI base that
+ * latched, or 0 when the CSID reset never completed (then nothing was armed).
+ * RX_CFG0 = (csiphy_id << PHY_NUM_SEL(20)) | (lane_assign << 4) | (lane_cnt-1)
+ * per mainline camss-csid-gen2.c __csid_configure_rx, so csiphy0 contributes
+ * NO bit20: the earlier 0x00132103 selected csiphy1 and could never see data. */
+static uint32_t
+pc_sliceb_arm(vm_offset_t csid0, uint32_t rx_cfg0)
+{
+	uint32_t rdi_base = 0x5480u;
+	bool rdi_lite = false;
+	unsigned rst_done = 0;
+
+	pc_wr(csid0, 0x188, 0x9u);        /* TOP_IRQ_CLEAR: RST_DONE|BUF_DONE */
+	pc_wr(csid0, 0x184, 0x9u);        /* TOP_IRQ_MASK */
+	pc_wr(csid0, 0x1a8, 0x10000u);    /* BUF_DONE_IRQ_CLEAR: VC0 */
+	pc_wr(csid0, 0x1a4, 0x10000u);    /* BUF_DONE_IRQ_MASK: VC0 */
+	pc_wr(csid0, 0x110, 0x1u);        /* IRQ_CMD: clear */
+	pc_wr(csid0, 0x108, 0x11u);       /* RST_CFG */
+	pc_wr(csid0, 0x10c, 0x5u);        /* RST_CMD: HW_RST|IRQ_RST */
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (pc_rd(csid0, 0x180) & 0x1u) { rst_done = 1; break; }
+		pc_sleep(1);
+	}
+	printf("PANDORA SLICEB: CSID reset rst_done=%u top_irq=%#x\n",
+	    rst_done, pc_rd(csid0, 0x180));
+	(void)pandora_log_sync();
+	if (!rst_done)
+		return 0;
+
+	pc_wr(csid0, 0x880, rx_cfg0);     /* RX_CFG0: real csiphy input mux */
+	pc_wr(csid0, 0x884, 0x1u);        /* RX_CFG1: ECC_CORRECTION_EN */
+
+	/* RDI0 latch probe across non-lite 0x5480 / lite 0x3080 (same race the
+	 * proven TPG path documents); payload value is resolution independent. */
+	for (unsigned try = 0; try < 50; try++) {
+		pc_wr(csid0, 0x5480, 0x002bf160u);
+		if (pc_rd(csid0, 0x5480) == 0x002bf160u) {
+			rdi_base = 0x5480u; rdi_lite = false; break;
+		}
+		pc_wr(csid0, 0x3080, 0x002bf160u);
+		if (pc_rd(csid0, 0x3080) == 0x002bf160u) {
+			rdi_base = 0x3080u; rdi_lite = true; break;
+		}
+		pc_sleep(1);
+	}
+	pc_wr(csid0, rdi_base, 0x002bf160u);              /* RDI_CFG0: RAW10 VC0 */
+	pc_wr(csid0, rdi_base + 0x14, 0x8000u);           /* RDI_CFG1: MIPI packing */
+	if (!rdi_lite)
+		pc_wr(csid0, 0x5498, 0x9u);               /* PIX_STORE (non-lite) */
+	pc_wr(csid0, rdi_base + 0x8, 0x0u);               /* RDI_CTRL: 0 */
+	pc_wr(csid0, rdi_base, pc_rd(csid0, rdi_base) | 0x80000000u); /* EN */
+	for (unsigned i = 0; i < 2; i++) {
+		pc_wr(csid0, 0x118, 0x100u);   /* AUP_CMD: RDI0 */
+		pc_wr(csid0, 0x11c, 0x1u);     /* RUP_AUP_CMD: RUP_SET */
+	}
+	pc_wr(csid0, 0x114, 0x100u);       /* RUP_CMD: RDI0 */
+	pc_wr(csid0, 0x11c, 0x1u);         /* RUP_AUP_CMD: RUP_SET */
+	pc_wr(csid0, rdi_base + 0x8, 0x1u);               /* RDI_CTRL: RESUME */
+	pc_sleep(2);
+	printf("PANDORA SLICEB: RDI0 armed rx_cfg0=%#x cfg0=%#x ctrl=%#x base=%#x\n",
+	    rx_cfg0, pc_rd(csid0, rdi_base), pc_rd(csid0, rdi_base + 0x8), rdi_base);
+	(void)pandora_log_sync();
+	return rdi_base;
+}
+
+/* Watch the input-side frame boundary for iters ms. SOF/EOF live in the RDIN
+ * wrapper IRQ (@0x224) and do not need a capture buffer, so a positive result
+ * proves real MIPI data reached CSID without any VFE DMA. */
+static uint32_t
+pc_sliceb_poll(vm_offset_t csid0, unsigned iters, uint32_t *rx_out,
+    uint32_t *buf_out)
+{
+	uint32_t seen_rdi = 0, seen_rx = 0, seen_buf = 0;
+
+	for (unsigned i = 0; i < iters; i++) {
+		seen_rdi |= pc_rd(csid0, PC_RDIN_IRQ(0));
+		seen_rx |= pc_rd(csid0, 0x1b0);
+		seen_buf |= pc_rd(csid0, 0x1a0);
+		pc_sleep(1);
+	}
+	if (rx_out)
+		*rx_out = seen_rx;
+	if (buf_out)
+		*buf_out = seen_buf;
+	return seen_rdi;
+}
+
+/* Diagnostic mode (pandora_csiphy=4): locate the dead stage when no SOF/EOF
+ * appears. Read-only probes inside already powered domains:
+ *   - BDISTMCLKCC MCLK branch: RCG CMD bit31 (root off) + CBCR bit31 (clk off)
+ *   - sensor 0x0100/0x0300/0x0301/0x0304/0x0305/0x3208 before the table, after
+ *     the table, and after stream-on (does the replay actually change it?)
+ *   - CSIPHY common CTRL/STATUS + lane0 state
+ *   - CSID RX/RDIN IRQ with no CSID arm, so only the source can produce events
+ * Every line is synced, so the last stage reached survives a later fault. */
+static void
+pc_sliceb_diag(void)
+{
+	static const uint32_t mclk_cmd[] = { 0x4000u, 0x4038u, 0x4054u, 0x4070u };
+	static const uint32_t mclk_cbcr[] = { 0x4018u, 0x4050u, 0x406cu, 0x4088u };
+	static const uint16_t regs[] = { 0x0100u, 0x0300u, 0x0301u, 0x0304u, 0x0305u, 0x3208u };
+	uint8_t pre[6], post[6], on[6];
+	vm_offset_t csid0;
+	int ret;
+
+	pc_csiphy_mark("diag start: map CSID0 + sensor bus");
+	csid0 = ml_io_map_unmappable(PC_CSID0_PA, 0x5e80u, VM_WIMG_IO);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	for (unsigned n = 0; n < 3; n++)
+		pc_cci[n] = ml_io_map_unmappable(PC_CCI_PA(n), 0x1000u, VM_WIMG_IO);
+	if (!csid0 || !pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_csiphy0_va) {
+		printf("PANDORA SLICEB: diag map failed csid0=%#llx bdistm=%#llx tlmm=%#llx "
+		    "cci0=%#llx phy=%#llx\n", (unsigned long long)csid0,
+		    (unsigned long long)pc_bdistm, (unsigned long long)pc_tlmm,
+		    (unsigned long long)pc_cci[0], (unsigned long long)pc_csiphy0_va);
+		(void)pandora_log_sync();
+		return;
+	}
+
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t cmd = pc_rd(pc_bdistm, mclk_cmd[i]);
+		uint32_t cfg = pc_rd(pc_bdistm, mclk_cmd[i] + 4);
+		uint32_t cbcr = pc_rd(pc_bdistm, mclk_cbcr[i]);
+		printf("PANDORA SLICEB: mclk[%u] cmd=%#x root_off=%u cfg=%#x cbcr=%#x "
+		    "clk_off=%u\n", i, cmd, cmd >> 31, cfg, cbcr, cbcr >> 31);
+	}
+	(void)pandora_log_sync();
+
+	for (unsigned i = 0; i < 6; i++)
+		pre[i] = pc_sliceb_rd8(regs[i], &ret);
+	printf("PANDORA SLICEB: sensor pre-table 0100=%#x 0300=%#x 0301=%#x 0304=%#x "
+	    "0305=%#x 3208=%#x\n", pre[0], pre[1], pre[2], pre[3], pre[4], pre[5]);
+	(void)pandora_log_sync();
+
+	pc_csiphy_mark("diag: replay wide table");
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-diag");
+	for (unsigned i = 0; i < 6; i++)
+		post[i] = pc_sliceb_rd8(regs[i], &ret);
+	printf("PANDORA SLICEB: sensor post-table 0100=%#x 0300=%#x 0301=%#x 0304=%#x "
+	    "0305=%#x 3208=%#x\n", post[0], post[1], post[2], post[3], post[4], post[5]);
+	(void)pandora_log_sync();
+
+	pc_csiphy_mark("diag: stream on + read sensor/PHY/CSID");
+	pc_sliceb_stream_on(1);
+	pc_sleep(30);
+	for (unsigned i = 0; i < 6; i++)
+		on[i] = pc_sliceb_rd8(regs[i], &ret);
+	printf("PANDORA SLICEB: sensor stream-on 0100=%#x 0300=%#x 0301=%#x 0304=%#x "
+	    "0305=%#x 3208=%#x\n", on[0], on[1], on[2], on[3], on[4], on[5]);
+	pc_csiphy_mark("diag: PHY + CSID status");
+	printf("PANDORA SLICEB: phy CTRL0=%#x CTRL5=%#x CTRL6=%#x CTRL7=%#x "
+	    "STATUS0=%#x STATUS1=%#x STATUS2=%#x STATUS3=%#x\n",
+	    pc_rd(pc_csiphy0_va, PC_CPHY_CTRL(0)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_CTRL(5)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_CTRL(6)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_CTRL(7)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(0)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(1)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(2)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(3)));
+	printf("PANDORA SLICEB: lane0 ctrl0=%#x settle=%#x ctrl4=%#x | csid rx_irq=%#x "
+	    "rdin=%#x top_irq=%#x\n", pc_rd(pc_csiphy0_va, 0x00),
+	    pc_rd(pc_csiphy0_va, 0x08), pc_rd(pc_csiphy0_va, 0x10),
+	    pc_rd(csid0, 0x1b0), pc_rd(csid0, 0x224), pc_rd(csid0, 0x180));
+	(void)pandora_log_sync();
+	pc_sliceb_stream_on(0);
+	pc_csiphy_mark("diag done (no stream left on)");
+}
+
+/* Write-path probe (pandora_csiphy=5). The v3 diagnostics showed identical
+ * sensor registers before and after the 6944-entry replay: the CCI writes are
+ * ACKed but change nothing. pc_cci_write_reg() waits on the REPORT bit only and
+ * never inspects the NACK bit, so a NACKed write is counted as applied. This
+ * does a few controlled writes of 0x0100 (8-bit vs 16-bit data) plus a safe
+ * rewrite of 0x0301 with its own read-back value, and prints the raw IRQ
+ * status, so one boot separates "no data" from "NACKed writes". No table. */
+static void
+pc_sliceb_wprobe(uint16_t reg, uint16_t val, unsigned bytes, const char *tag)
+{
+	uint32_t irq, cur;
+	int ret = pc_cci_write_reg(pc_cci[0], PC_SLICEB_MASTER, PC_SLICEB_SLAVE,
+	    reg, val, bytes);
+
+	/* The wait clears the REPORT bit, so use the status captured inside the
+	 * wait loop (pc_cci_last_irq) and also report CUR_WORD_CNT, which proves
+	 * the queue actually drained. */
+	irq = pc_cci_last_irq;
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(PC_SLICEB_MASTER, 0));
+	printf("PANDORA SLICEB: wprobe %s reg=%#x val=%#x bytes=%u ret=%d irq=%#x "
+	    "rep=%u nack=%u cur=%u\n", tag, reg, val, bytes, ret, irq,
+	    (irq >> (4u + PC_SLICEB_MASTER * 12u)) & 1u,
+	    (irq >> (27u + PC_SLICEB_MASTER * 2u)) & 1u, cur);
+	(void)pandora_log_sync();
+}
+
+static void
+pc_sliceb_wtest(void)
+{
+	int ret = 0;
+	uint8_t v;
+
+	pc_csiphy_mark("wtest start: map sensor bus");
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc) {
+		printf("PANDORA SLICEB: wtest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+
+	v = pc_sliceb_rd8(0x0100u, &ret);
+	printf("PANDORA SLICEB: wtest 0x0100 before=%#x ret=%d\n", v, ret);
+	pc_sliceb_wprobe(0x0100u, 0x0001u, 1u, "8bit-on");
+	pc_sleep(50);
+	v = pc_sliceb_rd8(0x0100u, &ret);
+	printf("PANDORA SLICEB: wtest 0x0100 after8bit-on=%#x ret=%d\n", v, ret);
+	pc_sliceb_wprobe(0x0100u, 0x0000u, 1u, "8bit-off");
+	pc_sleep(10);
+	pc_sliceb_wprobe(0x0100u, 0x0001u, 2u, "16bit-on");
+	pc_sleep(50);
+	v = pc_sliceb_rd8(0x0100u, &ret);
+	printf("PANDORA SLICEB: wtest 0x0100 after16bit-on=%#x ret=%d\n", v, ret);
+	pc_sliceb_wprobe(0x0100u, 0x0000u, 2u, "16bit-off");
+
+	v = pc_sliceb_rd8(0x0301u, &ret);
+	printf("PANDORA SLICEB: wtest 0x0301 before=%#x ret=%d\n", v, ret);
+	pc_sliceb_wprobe(0x0301u, (uint16_t)v, 2u, "16bit-rewrite-same");
+	v = pc_sliceb_rd8(0x0301u, &ret);
+	printf("PANDORA SLICEB: wtest 0x0301 after=%#x ret=%d\n", v, ret);
+	pc_csiphy_mark("wtest done (sensor left in standby)");
+}
+
+/* Reset-effect probe (pandora_csiphy=6): "write ACKed but inert" and "readback
+ * unreliable" look identical until a write has an observable side effect.
+ * 0x0103 is the sensor software-reset register; a real write clears the PLL
+ * registers (0x0301 read 0x40), while the chip ID must survive the reset. */
+static void
+pc_sliceb_rtest(void)
+{
+	int ret = 0;
+	uint8_t id0, pll0, rst0, id1, pll1, rst1;
+
+	pc_csiphy_mark("rtest start: map sensor bus");
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc) {
+		printf("PANDORA SLICEB: rtest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+
+	id0 = pc_sliceb_rd8(0x300au, &ret);
+	pll0 = pc_sliceb_rd8(0x0301u, &ret);
+	rst0 = pc_sliceb_rd8(0x0103u, &ret);
+	printf("PANDORA SLICEB: rtest before id=%#x pll=%#x rst=%#x\n", id0, pll0, rst0);
+	pc_sliceb_wprobe(0x0103u, 0x0001u, 1u, "reset-8bit");
+	pc_sleep(100);
+	id1 = pc_sliceb_rd8(0x300au, &ret);
+	pll1 = pc_sliceb_rd8(0x0301u, &ret);
+	rst1 = pc_sliceb_rd8(0x0103u, &ret);
+	printf("PANDORA SLICEB: rtest after id=%#x pll=%#x rst=%#x id_changed=%u "
+	    "pll_changed=%u\n", id1, pll1, rst1, id0 != id1, pll0 != pll1);
+	pc_csiphy_mark("rtest done (verdict: pll_changed=1 means writes reach the sensor)");
+}
+
+/* Register-write judge probe (pandora_csiphy=7). The 0x0103 reset probe cannot
+ * distinguish "reset happened" from "write inert" because 0x0301 may default to
+ * 0x40. This writes ordinary RW registers with a distinctive value and reads
+ * them back, prints the GPIO state of the MCLK pad (89) and the wide reset pad
+ * (106), and (via wprobe) reports the full CCI IRQ word plus CUR_WORD_CNT. */
+static void
+pc_sliceb_ghtest(void)
+{
+	int ret = 0;
+	uint8_t v;
+
+	pc_csiphy_mark("ghtest start: map sensor bus");
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc) {
+		printf("PANDORA SLICEB: ghtest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	printf("PANDORA SLICEB: gpio89(mclk) ctl=%#x io=%#x | gpio106(wide rst) "
+	    "ctl=%#x io=%#x\n", pc_rd(pc_tlmm, PC_GPIO(89)),
+	    pc_rd(pc_tlmm, PC_GPIO(89) + 4), pc_rd(pc_tlmm, PC_GPIO(106)),
+	    pc_rd(pc_tlmm, PC_GPIO(106) + 4));
+	(void)pandora_log_sync();
+
+	v = pc_sliceb_rd8(0x0300u, &ret);
+	printf("PANDORA SLICEB: ghtest 0x0300 before=%#x\n", v);
+	pc_sliceb_wprobe(0x0300u, 0x0077u, 1u, "0300=0x77");
+	pc_sleep(10);
+	v = pc_sliceb_rd8(0x0300u, &ret);
+	printf("PANDORA SLICEB: ghtest 0x0300 after=%#x\n", v);
+
+	v = pc_sliceb_rd8(0x3208u, &ret);
+	printf("PANDORA SLICEB: ghtest 0x3208 before=%#x\n", v);
+	pc_sliceb_wprobe(0x3208u, 0x0001u, 1u, "3208=1");
+	pc_sleep(10);
+	v = pc_sliceb_rd8(0x3208u, &ret);
+	printf("PANDORA SLICEB: ghtest 0x3208 after=%#x\n", v);
+	pc_sliceb_wprobe(0x3208u, 0x0000u, 1u, "3208=0");
+	pc_csiphy_mark("ghtest done");
+}
+
+/* Settle/timer sweep (pandora_csiphy=8). The sensor now streams, but CSID sees
+ * nothing. The D-PHY HS settle time is derived from the link frequency, and the
+ * driver currently assumes timer=400 MHz -> settle=29 (link 1067.7 MHz). The
+ * mainline PHY instead clocks the timer at link/4 (~266.9 MHz) and would use
+ * settle 17. This prints the two RCG configs and then retimes only the settle
+ * registers (lane array type==1) across a small sweep, re-arming CSID and
+ * polling SOF/EOF for each value. Everything else (lane enables, mux, RDI) is
+ * identical, so a hit is attributable to the settle value alone. */
+static void
+pc_sliceb_stest(void)
+{
+	static const unsigned cand[] = { 12u, 17u, 20u, 23u, 26u, 29u, 32u };
+	vm_offset_t csid0;
+	uint32_t seen_rdi;
+	int ret = 0;
+
+	pc_csiphy_mark("stest start: map sensor bus + CSID");
+	csid0 = ml_io_map_unmappable(PC_CSID0_PA, 0x5e80u, VM_WIMG_IO);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!csid0 || !pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc ||
+	    !pc_csiphy0_va) {
+		printf("PANDORA SLICEB: stest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	printf("PANDORA SLICEB: cphy_rx cmd=%#x cfg=%#x | phytimer cmd=%#x cfg=%#x\n",
+	    pc_rd(pc_camcc, 0x21064u), pc_rd(pc_camcc, 0x21068u),
+	    pc_rd(pc_camcc, 0x20000u), pc_rd(pc_camcc, 0x20004u));
+	(void)pandora_log_sync();
+
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	pc_csiphy_mark("stest: replay wide table");
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-stest");
+	pc_sliceb_stream_on(0);
+	pc_sleep(2);
+
+	for (unsigned c = 0; c < (unsigned)(sizeof(cand) / sizeof(cand[0])); c++) {
+		/* Retime only the settle registers; nothing else changes. */
+		for (unsigned i = 0; i < PC_CSIPHY_LANE_REGS_N; i++) {
+			const struct pc_csiphy_lane_reg *r = &pc_csiphy_lane_regs_x1e80100[i];
+			if (r->type == 1)
+				pc_wr(pc_csiphy0_va, r->addr, cand[c] & 0xffu);
+		}
+		uint32_t base = pc_sliceb_arm(csid0, 0x00032103u);
+		seen_rdi = 0;
+		if (base) {
+			pc_sliceb_stream_on(1);
+			seen_rdi = pc_sliceb_poll(csid0, 500, NULL, NULL);
+			pc_sliceb_stream_on(0);
+		}
+		printf("PANDORA SLICEB: settle[%u]=%u lane0=%#x rdi=%#x sof=%u eof=%u arm=%#x\n",
+		    c, cand[c], pc_rd(pc_csiphy0_va, 0x08), seen_rdi,
+		    (seen_rdi & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+		    (seen_rdi & PC_RDIN_INPUT_EOF) ? 1u : 0u, base);
+		(void)pandora_log_sync();
+		if (seen_rdi & (PC_RDIN_INPUT_SOF | PC_RDIN_INPUT_EOF))
+			break;
+	}
+	pc_csiphy_mark("stest done (sensor left in standby)");
+}
+
+/* Timer-rate probe (pandora_csiphy=9). The settle sweep at the driver's fixed
+ * timer (400 MHz) changed nothing, so retime the PHY timer to the rate mainline
+ * derives from the link: link/4 = 266.7 MHz. CAMCC RCG cfg layout is
+ * BIT(20) | sel<<8 | hid, with div = (hid+1)/2, so PLL0_MAIN/4.5 is
+ * 0x00100108. Then re-run a short settle sweep (17 is the value mainline would
+ * compute at this timer). */
+static void
+pc_sliceb_ttest(void)
+{
+	static const unsigned cand[] = { 14u, 17u, 20u };
+	vm_offset_t csid0;
+	uint32_t seen_rdi, cmd;
+
+	pc_csiphy_mark("ttest start: map sensor bus + CSID");
+	csid0 = ml_io_map_unmappable(PC_CSID0_PA, 0x5e80u, VM_WIMG_IO);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!csid0 || !pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc ||
+	    !pc_csiphy0_va) {
+		printf("PANDORA SLICEB: ttest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	printf("PANDORA SLICEB: ttest timer before cmd=%#x cfg=%#x\n",
+	    pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG),
+	    pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG + 4));
+	pc_wr(pc_camcc, PC_CSI0PHYTIMER_RCG + 4, 0x00100108u);	/* /4.5 = 266.7 MHz */
+	cmd = pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG);
+	pc_wr(pc_camcc, PC_CSI0PHYTIMER_RCG, (cmd & ~0x80000000u) | 0x1u);
+	for (unsigned i = 0; i < 50; i++) {
+		if (!(pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG) & 0x1u))
+			break;
+		pc_sleep(1);
+	}
+	printf("PANDORA SLICEB: ttest timer after cmd=%#x cfg=%#x\n",
+	    pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG),
+	    pc_rd(pc_camcc, PC_CSI0PHYTIMER_RCG + 4));
+	(void)pandora_log_sync();
+
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-ttest");
+	pc_sliceb_stream_on(0);
+	pc_sleep(2);
+
+	for (unsigned c = 0; c < (unsigned)(sizeof(cand) / sizeof(cand[0])); c++) {
+		for (unsigned i = 0; i < PC_CSIPHY_LANE_REGS_N; i++) {
+			const struct pc_csiphy_lane_reg *r = &pc_csiphy_lane_regs_x1e80100[i];
+			if (r->type == 1)
+				pc_wr(pc_csiphy0_va, r->addr, cand[c] & 0xffu);
+		}
+		uint32_t base = pc_sliceb_arm(csid0, 0x00032103u);
+		seen_rdi = 0;
+		if (base) {
+			pc_sliceb_stream_on(1);
+			seen_rdi = pc_sliceb_poll(csid0, 800, NULL, NULL);
+			pc_sliceb_stream_on(0);
+		}
+		printf("PANDORA SLICEB: ttest settle=%u lane0=%#x rdi=%#x sof=%u eof=%u arm=%#x\n",
+		    cand[c], pc_rd(pc_csiphy0_va, 0x08), seen_rdi,
+		    (seen_rdi & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+		    (seen_rdi & PC_RDIN_INPUT_EOF) ? 1u : 0u, base);
+		(void)pandora_log_sync();
+		if (seen_rdi & (PC_RDIN_INPUT_SOF | PC_RDIN_INPUT_EOF))
+			break;
+	}
+	pc_csiphy_mark("ttest done (sensor left in standby)");
+}
+
+/* Lane/clock status probe (pandora_csiphy=10). Read-only while the sensor is
+ * streaming: dump the CSIPHY common STATUS0..15, CTRL0..10, and per-lane
+ * ctrl0/1/settle/3/4/5 for all four data lanes, then re-read STATUS0..3 after
+ * 200 ms. Purpose: decide whether any clock/data lane reaches HS at all, and
+ * decode CTRL7 (readback 0x7a, mainline writes 0x02). No writes occur. */
+static void
+pc_sliceb_ltest(void)
+{
+	pc_csiphy_mark("ltest start: map sensor bus + PHY status");
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!pc_bdistm || !pc_tlmm || !pc_cci[0] || !pc_camcc || !pc_csiphy0_va) {
+		printf("PANDORA SLICEB: ltest map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-ltest");
+	pc_sliceb_stream_on(1);
+	pc_sleep(100);
+
+	for (unsigned n = 0; n < 16; n += 4) {
+		printf("PANDORA SLICEB: ltest STATUS%u..%u = %#x %#x %#x %#x\n",
+		    n, n + 3, pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(n)),
+		    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(n + 1)),
+		    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(n + 2)),
+		    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(n + 3)));
+	}
+	for (unsigned n = 0; n <= 10; n++) {
+		printf("PANDORA SLICEB: ltest CTRL%u=%#x\n", n,
+		    pc_rd(pc_csiphy0_va, PC_CPHY_CTRL(n)));
+	}
+	for (unsigned lane = 0; lane < 4; lane++) {
+		uint32_t b = 0x400u * lane;
+		printf("PANDORA SLICEB: ltest LN%u ctrl0=%#x ctrl1=%#x settle=%#x "
+		    "ctrl3=%#x ctrl4=%#x ctrl5=%#x\n", lane,
+		    pc_rd(pc_csiphy0_va, b + 0x00), pc_rd(pc_csiphy0_va, b + 0x04),
+		    pc_rd(pc_csiphy0_va, b + 0x08), pc_rd(pc_csiphy0_va, b + 0x0c),
+		    pc_rd(pc_csiphy0_va, b + 0x10), pc_rd(pc_csiphy0_va, b + 0x14));
+	}
+	(void)pandora_log_sync();
+	pc_sleep(200);
+	printf("PANDORA SLICEB: ltest STATUS0..3 after200ms = %#x %#x %#x %#x\n",
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(0)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(1)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(2)),
+	    pc_rd(pc_csiphy0_va, PC_CPHY_STATUS(3)));
+	(void)pandora_log_sync();
+	pc_sliceb_stream_on(0);
+	pc_csiphy_mark("ltest done (sensor left in standby)");
+}
+
+static void
+pc_sliceb_stream(void)
+{
+	vm_offset_t csid0;
+	uint8_t w_hi = 0, w_lo = 0, h_hi = 0, h_lo = 0;
+	int rw0 = -1, rw1 = -1, rh0 = -1, rh1 = -1;
+	uint32_t seen_rdi = 0, seen_rx = 0, seen_buf = 0;
+	uint32_t base = 0;
+
+	if (pc_csiphy == 4u) {
+		pc_sliceb_diag();
+		return;
+	}
+	if (pc_csiphy == 5u) {
+		pc_sliceb_wtest();
+		return;
+	}
+	if (pc_csiphy == 6u) {
+		pc_sliceb_rtest();
+		return;
+	}
+	if (pc_csiphy == 7u) {
+		pc_sliceb_ghtest();
+		return;
+	}
+	if (pc_csiphy == 8u) {
+		pc_sliceb_stest();
+		return;
+	}
+	if (pc_csiphy == 9u) {
+		pc_sliceb_ttest();
+		return;
+	}
+	if (pc_csiphy >= 10u) {
+		pc_sliceb_ltest();
+		return;
+	}
+
+	pc_csiphy_mark("slice B1 start: map CSID0 + sensor bus (BDISTM/TLMM/CCI0)");
+	csid0 = ml_io_map_unmappable(PC_CSID0_PA, 0x5e80u, VM_WIMG_IO);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	for (unsigned n = 0; n < 3; n++)
+		pc_cci[n] = ml_io_map_unmappable(PC_CCI_PA(n), 0x1000u, VM_WIMG_IO);
+	if (!csid0 || !pc_bdistm || !pc_tlmm || !pc_cci[0]) {
+		printf("PANDORA SLICEB: map failed csid0=%#llx bdistm=%#llx tlmm=%#llx "
+		    "cci0=%#llx\n", (unsigned long long)csid0,
+		    (unsigned long long)pc_bdistm, (unsigned long long)pc_tlmm,
+		    (unsigned long long)pc_cci[0]);
+		(void)pandora_log_sync();
+		return;
+	}
+
+	/* Sensor front-end: rails + MCLK 19.2 MHz + CCI0 37.5 MHz, then the
+	 * Android-dumped wide table through the verified write path (w44). */
+	pc_csiphy_mark("slice B1: sensor power_up (rails/MCLK/CCI)");
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	pc_csiphy_mark("slice B1: replay wide init table");
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-sliceb");
+
+	/* Actual output size: 16-bit big-endian halves, read as single bytes at
+	 * 0x034C..0x034F (0x034C x-hi, 0x034D x-lo, ...) by the timed helper. */
+	w_hi = pc_sliceb_rd8(0x034cu, &rw0);
+	w_lo = pc_sliceb_rd8(0x034du, &rw1);
+	h_hi = pc_sliceb_rd8(0x034eu, &rh0);
+	h_lo = pc_sliceb_rd8(0x034fu, &rh1);
+	printf("PANDORA SLICEB: sensor size 0x034C..0x034F=%#x %#x %#x %#x ret=%d/%d/%d/%d "
+	    "-> %ux%u\n", w_hi, w_lo, h_hi, h_lo, rw0, rw1, rh0, rh1,
+	    ((unsigned)w_hi << 8) | w_lo, ((unsigned)h_hi << 8) | h_lo);
+	(void)pandora_log_sync();
+
+	/* Back to standby before arming CSID: the table may itself end with a
+	 * stream-on write, and the source must not run while RDI is configured. */
+	pc_sliceb_stream_on(0);
+	pc_sleep(2);
+
+	/* CSID mux candidates. PHY_NUM_SEL is csiphy_id (0 for csiphy0), so bit20
+	 * must be CLEAR -- the first trial wrote 0x00132103 and armed csiphy1,
+	 * which can never see this sensor. lane_assign for the real sensor is not
+	 * in the live DT (csiphy0 has no data-lanes child), so =3 sweeps both
+	 * documented encodings and keeps the csiphy1 values as controls. */
+	if (pc_csiphy >= 3u) {
+		static const struct {
+			uint32_t cfg;
+			const char *tag;
+		} cand[] = {
+			{ 0x00032103u, "phy0 assign0x3210" },
+			{ 0x00001393u, "phy0 assign0x0139" },
+			{ 0x00132103u, "phy1 assign0x3210 control" },
+			{ 0x00101393u, "phy1 assign0x0139 control" },
+		};
+		pc_csiphy_mark("slice B1: mux sweep (diag=3, 4 candidates x 500 ms)");
+		for (unsigned c = 0; c < (unsigned)(sizeof(cand) / sizeof(cand[0])); c++) {
+			pc_sliceb_stream_on(0);
+			pc_sleep(2);
+			seen_rdi = seen_rx = seen_buf = 0;
+			base = pc_sliceb_arm(csid0, cand[c].cfg);
+			if (!base) {
+				printf("PANDORA SLICEB: cand[%u] %s -> CSID reset timeout\n",
+				    c, cand[c].tag);
+				(void)pandora_log_sync();
+				continue;
+			}
+			pc_sliceb_stream_on(1);
+			seen_rdi = pc_sliceb_poll(csid0, 500, &seen_rx, &seen_buf);
+			printf("PANDORA SLICEB: cand[%u] %s rdi=%#x rx=%#x buf=%#x "
+			    "sof=%u eof=%u\n", c, cand[c].tag, seen_rdi, seen_rx, seen_buf,
+			    (seen_rdi & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+			    (seen_rdi & PC_RDIN_INPUT_EOF) ? 1u : 0u);
+			(void)pandora_log_sync();
+			if (seen_rdi & (PC_RDIN_INPUT_SOF | PC_RDIN_INPUT_EOF))
+				break;
+		}
+	} else {
+		/* Single-variable B1 (=2): the fact-corrected mux only. */
+		pc_csiphy_mark("slice B1: arm CSID real RX mux 0x00032103");
+		base = pc_sliceb_arm(csid0, 0x00032103u);
+		if (base) {
+			pc_csiphy_mark("slice B1: sensor stream on (source last)");
+			pc_sliceb_stream_on(1);
+			pc_csiphy_mark("slice B1: polling RDIN IRQ (SOF/EOF/RUP) + RX + BUF_DONE");
+			seen_rdi = pc_sliceb_poll(csid0, 800, &seen_rx, &seen_buf);
+		} else {
+			pc_csiphy_mark("slice B1: CSID reset TIMEOUT - aborting (no RDI)");
+		}
+	}
+	printf("PANDORA SLICEB: RESULT rdi_irq=%#x rx_irq=%#x buf_done=%#x "
+	    "sof=%u eof=%u rup=%u\n", seen_rdi, seen_rx, seen_buf,
+	    (seen_rdi & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+	    (seen_rdi & PC_RDIN_INPUT_EOF) ? 1u : 0u,
+	    (seen_rdi & PC_RDIN_RUP_DONE) ? 1u : 0u);
+	(void)pandora_log_sync();
+	pc_csiphy_mark((seen_rdi & (PC_RDIN_INPUT_SOF | PC_RDIN_INPUT_EOF))
+	    ? "slice B1 PASS: real sensor frame events at CSID RDI0"
+	    : "slice B1 FAIL: no SOF/EOF at CSID RDI0");
+
+	pc_csiphy_mark("slice B1: stop (stream off + RDI0 stop; no teardown)");
+	pc_sliceb_stream_on(0);
+	if (base)
+		pc_wr(csid0, base + 0x8, 0x0u);
+	pc_sleep(1);
+	pc_csiphy_mark("slice B1 done (PHY+sensor parked; VFE DMA/FRAME_INCR is B2)");
+}
+
+static void
+pc_csiphy0_bringup(void)
+{
+	pc_sleep(4000);
+	pc_csiphy_mark("slice A start: map CAMCC + CSIPHY0");
+	pc_camcc = ml_io_map_unmappable(PC_CAMCC_PA, 0x80000, VM_WIMG_IO);
+	pc_csiphy0_va = ml_io_map_unmappable(PC_CSIPHY0_PA, PC_CSIPHY0_BYTES, VM_WIMG_IO);
+	vm_offset_t phy = pc_csiphy0_va;
+	if (!pc_camcc || !phy) {
+		printf("PANDORA CSIPHY: map failed camcc=%#llx phy=%#llx\n",
+		    (unsigned long long)pc_camcc, (unsigned long long)phy);
+		(void)pandora_log_sync();
+		return;
+	}
+
+	/* Analog rails + MMCX/MX ARC levels before any PHY register access. */
+	pc_csiphy_mark("vote analog rails L3I_E0(0p9) L1D_E0(1p2) + MMCX/MX");
+	(void)pandora_rpmh_resource("L3I_E0", 0, 900);
+	(void)pandora_rpmh_resource("L3I_E0", 4, 1);
+	(void)pandora_rpmh_resource("L1D_E0", 0, 1200);
+	(void)pandora_rpmh_resource("L1D_E0", 4, 1);
+	(void)pandora_rpmh_arc("mmcxc.lvl", 384);
+	(void)pandora_rpmh_arc("mx.lvl", 384);
+	(void)pandora_log_sync();
+
+	/* Reuse the TPG power/clock tree: GDSCs, PLL0, RCGs, branches. */
+	static const uint32_t gdscs[4] = {
+		PC_GDSCR, PC_TFE0_GDSCR, PC_TFE1_GDSCR, PC_TFE2_GDSCR };
+	static const char *gdsc_names[4] = { "titan_top", "tfe_0", "tfe_1", "tfe_2" };
+	for (unsigned i = 0; i < 4; i++) {
+		pc_csiphy_mark(gdsc_names[i]);
+		(void)pc_tpg_gdsc_up(gdscs[i], gdsc_names[i]);
+	}
+	pc_csiphy_mark("pll0 enable");
+	(void)pc_tpg_pll_enable(0x0000u, 0x0044003eu, 0x8000u, 0x840fu, "pll0");
+	for (unsigned i = 0; i < PC_TPG_NRCG; i++) {
+		pc_csiphy_mark(pc_tpg_rcgs[i].name);
+		(void)pc_tpg_rcg_set(&pc_tpg_rcgs[i]);
+	}
+	/* phytimer RCG 400 MHz (PLL0_MAIN/3, sel 1 hid 5) + its branch. */
+	struct pc_tpg_rcg phytimer = { PC_CSI0PHYTIMER_RCG, 1u, 5u, "csi0phytimer" };
+	pc_csiphy_mark("csi0phytimer rcg");
+	(void)pc_tpg_rcg_set(&phytimer);
+
+	pc_csiphy_mark("core_ahb + branches");
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, pc_rd(pc_camcc, PC_CORE_AHB_CBCR) | PC_CBCR_ENABLE);
+	pc_sleep(1);
+	for (unsigned i = 0; i < PC_TPG_NBRANCH; i++) {
+		pc_wr(pc_camcc, pc_tpg_branches[i],
+		    pc_rd(pc_camcc, pc_tpg_branches[i]) | PC_CBCR_ENABLE);
+		(void)pc_wait_branch_on("csiphy", pc_tpg_branches[i]);
+	}
+	pc_wr(pc_camcc, PC_CSIPHY0_CLK_CBCR, pc_rd(pc_camcc, PC_CSIPHY0_CLK_CBCR) | PC_CBCR_ENABLE);
+	(void)pc_wait_branch_on("csiphy", PC_CSIPHY0_CLK_CBCR);
+	pc_wr(pc_camcc, PC_CSI0PHYTIMER_CBCR, pc_rd(pc_camcc, PC_CSI0PHYTIMER_CBCR) | PC_CBCR_ENABLE);
+	(void)pc_wait_branch_on("csiphy", PC_CSI0PHYTIMER_CBCR);
+	(void)pandora_log_sync();
+
+	/* PHY reset: CTRL0=1, 5-8 ms, =0 (mainline phy_qcom_mipi_csi2_reset). */
+	pc_csiphy_mark("PHY reset");
+	pc_wr(phy, PC_CPHY_CTRL(0), 1u);
+	pc_sleep(8);
+	pc_wr(phy, PC_CPHY_CTRL(0), 0u);
+	pc_sleep(1);
+
+	/* hw_version_read: CTRL6=2, read STATUS12..15. */
+	pc_wr(phy, PC_CPHY_CTRL(6), 2u);
+	uint32_t v0 = pc_rd(phy, PC_CPHY_STATUS(12));
+	uint32_t v1 = pc_rd(phy, PC_CPHY_STATUS(13));
+	uint32_t v2 = pc_rd(phy, PC_CPHY_STATUS(14));
+	uint32_t v3 = pc_rd(phy, PC_CPHY_STATUS(15));
+	printf("PANDORA CSIPHY: hw_version STATUS12..15 = %#x %#x %#x %#x\n", v0, v1, v2, v3);
+	(void)pandora_log_sync();
+
+	/* lanes_enable: CTRL5 lane bitmap (4 data + clk = 0xD5), CTRL6 pwrDN_b=1,
+	 * CTRL7=2, CTRL0=0, then the 105-entry lane array (settle substituted,
+	 * skew skipped), then mask all IRQs (CTRL11..21=0). */
+	unsigned settle = pc_csiphy_settle(PC_WIDE_LINK_FREQ, PC_CPHY_TIMER_RATE);
+	printf("PANDORA CSIPHY: link=%llu Hz timer=%u Hz settle_cnt=%u\n",
+	    (unsigned long long)PC_WIDE_LINK_FREQ, PC_CPHY_TIMER_RATE, settle);
+	pc_csiphy_mark("lanes_enable CTRL5=0xD5");
+	pc_wr(phy, PC_CPHY_CTRL(5), 0xD5u);
+	pc_wr(phy, PC_CPHY_CTRL(6), 1u);
+	pc_wr(phy, PC_CPHY_CTRL(7), 2u);
+	pc_wr(phy, PC_CPHY_CTRL(0), 0u);
+	for (unsigned i = 0; i < PC_CSIPHY_LANE_REGS_N; i++) {
+		const struct pc_csiphy_lane_reg *r = &pc_csiphy_lane_regs_x1e80100[i];
+		if (r->type == 2)	/* CSIPHY_SKEW_CAL: skip */
+			continue;
+		uint32_t val = (r->type == 1) ? (settle & 0xffu) : r->val;
+		pc_wr(phy, r->addr, val);
+		if (r->delay_us)
+			delay(r->delay_us);
+	}
+	for (unsigned n = 11; n <= 21; n++)
+		pc_wr(phy, PC_CPHY_CTRL(n), 0u);
+	(void)pandora_log_sync();
+
+	/* Per-lane control readback (not IRQ status): data lane stride 0x400,
+	 * 0x00=ctrl0 0x08=settle byte 0x10=ctrl4. Real status is common STATUS0. */
+	for (unsigned lane = 0; lane < 4; lane++) {
+		uint32_t base = 0x400u * lane;
+		printf("PANDORA CSIPHY: LN%u ctrl0=%#x settle_reg=%#x ctrl4=%#x\n",
+		    lane, pc_rd(phy, base + 0x00), pc_rd(phy, base + 0x08), pc_rd(phy, base + 0x10));
+	}
+	printf("PANDORA CSIPHY: common CTRL5=%#x CTRL6=%#x CTRL7=%#x STATUS0=%#x\n",
+	    pc_rd(phy, PC_CPHY_CTRL(5)), pc_rd(phy, PC_CPHY_CTRL(6)),
+	    pc_rd(phy, PC_CPHY_CTRL(7)), pc_rd(phy, PC_CPHY_STATUS(0)));
+	pc_csiphy_mark("slice A done (PHY front-end up; CSID real mux is slice B)");
+	/* =2 adds slice B1 (real sensor -> CSID RX mux -> RDI0 SOF/EOF). =1 stops
+	 * here exactly as the verified w45 baseline did. */
+	if (pc_csiphy >= 2u)
+		pc_sliceb_stream();
+}
+
+static void
+pc_tpg_p0_bringup(void)
+{
+	uint32_t gdscr_before[4];
+	uint32_t branch_before[PC_TPG_NBRANCH];
+	uint32_t core_before, rcg_cmd_before[PC_TPG_NRCG], rcg_cfg_before[PC_TPG_NRCG];
+	uint32_t pll0_mode0, pll0_op0, pll3_mode0, pll3_op0;
+	uint32_t gdsc_up_mask = 0;
+	bool br_up[PC_TPG_NBRANCH] = {0};
+	unsigned gdsc_ok = 0, pll_ok = 0, rcg_ok = 0, br_ok = 0;
+	vm_offset_t tpg2, csid0, vfe0;
+	uint32_t gcc_hf0 = 0, gcc_sf0 = 0;
+	vm_offset_t gccaxi = 0;
+
+	printf("PANDORA TPG: P0 bring-up starts (CAMSS TPG clock/power tree; "
+	    "no rail/GPIO/CCI; GCC hf/sf deliberately skipped, direction C)\n");
+	/* Let the log file come up and flush the early boot before touching any
+	 * camera MMIO, so a freeze leaves the preceding steps on disk. */
+	pc_sleep(4000);
+	pc_tpg_mark("diag: log ready, about to map CAMCC");
+
+	/* S1: map CAMCC + the three block apertures. Mapping a powered-off
+	 * aperture is safe; only the later reads need the clocks up. No unmap. */
+	pc_camcc = ml_io_map_unmappable(PC_CAMCC_PA, 0x80000, VM_WIMG_IO);
+	pc_tpg_mark("diag: CAMCC mapped");
+	tpg2 = ml_io_map_unmappable(PC_TPG2_PA, 0x400, VM_WIMG_IO);
+	pc_tpg_mark("diag: tpg2 mapped");
+	/* CSID0 aperture is 0x5e80 (isp@900b000 reg): RDI0 CFG0 @0x5480 lies
+	 * beyond the first 4K page, so a 0x1000 window faults on RDI writes. */
+	csid0 = ml_io_map_unmappable(PC_CSID0_PA, 0x5e80, VM_WIMG_IO);
+	pc_tpg_mark("diag: csid0 mapped");
+	vfe0 = ml_io_map_unmappable(PC_VFE0_PA, 0x4000, VM_WIMG_IO);
+	pc_tpg_mark("diag: vfe0 mapped");
+	if (!pc_camcc || !tpg2 || !csid0 || !vfe0) {
+		printf("PANDORA TPG: mapping failed camcc=%#llx tpg2=%#llx csid0=%#llx vfe0=%#llx\n",
+		    (unsigned long long)pc_camcc, (unsigned long long)tpg2,
+		    (unsigned long long)csid0, (unsigned long long)vfe0);
+		(void)pandora_log_sync();
+		return;
+	}
+
+	/* Snapshot power-critical state for reverse-order rollback. */
+	static const uint32_t gdscs[4] = {
+		PC_GDSCR, PC_TFE0_GDSCR, PC_TFE1_GDSCR, PC_TFE2_GDSCR };
+	static const char *gdsc_names[4] = { "titan_top", "tfe_0", "tfe_1", "tfe_2" };
+	pc_tpg_mark("diag: about to read CAMCC gdscr snapshot");
+	for (unsigned i = 0; i < 4; i++)
+		gdscr_before[i] = pc_rd(pc_camcc, gdscs[i]);
+	pc_tpg_mark("diag: gdscr snapshot done");
+	for (unsigned i = 0; i < PC_TPG_NBRANCH; i++)
+		branch_before[i] = pc_rd(pc_camcc, pc_tpg_branches[i]);
+	core_before = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+	for (unsigned i = 0; i < PC_TPG_NRCG; i++) {
+		rcg_cmd_before[i] = pc_rd(pc_camcc, pc_tpg_rcgs[i].cmd);
+		rcg_cfg_before[i] = pc_rd(pc_camcc, pc_tpg_rcgs[i].cmd + 4);
+	}
+	pc_tpg_mark("diag: branch/rcg snapshot done");
+	pll0_mode0 = pc_rd(pc_camcc, 0x00); pll0_op0 = pc_rd(pc_camcc, 0x04);
+	pc_tpg_mark("diag: pll0 snapshot done");
+	pll3_mode0 = pc_rd(pc_camcc, 0x3000); pll3_op0 = pc_rd(pc_camcc, 0x3004);
+	pc_tpg_mark("diag: pll3 snapshot done");
+
+	/* S2/S3: GDSCs in dependency order (TITAN_TOP is the parent). */
+	for (unsigned i = 0; i < 4; i++) {
+		pc_tpg_mark(gdsc_names[i]);
+		if (pc_tpg_gdsc_up(gdscs[i], gdsc_names[i]) == 0) {
+			gdsc_ok++;
+			gdsc_up_mask |= (1u << i);
+		}
+		(void)pandora_log_sync();
+	}
+	if (gdsc_ok < 4)
+		printf("PANDORA TPG: only %u/4 gdsc up; continuing to read what we can\n", gdsc_ok);
+
+	/* S4/S5: PLL0 (csid/cphy_rx/camnoc/AHB) + PLL3 (tfe_0). Enable only;
+	 * skip config rewrite when already running. PLL0 1200 MHz, PLL3 720.56. */
+	pc_tpg_mark("diag: about to enable pll0");
+	if (pc_tpg_pll_enable(0x0000u, 0x0044003eu, 0x8000u, 0x840fu, "pll0") == 0)
+		pll_ok++;
+	(void)pandora_log_sync();
+	pc_tpg_mark("diag: about to enable pll3");
+	if (pc_tpg_pll_enable(0x3000u, 0x00480025u, 0x8777u, 0x40fu, "pll3") == 0)
+		pll_ok++;
+	(void)pandora_log_sync();
+
+	/* S6: RCG rates before enabling the branches (§12 discipline). */
+	for (unsigned i = 0; i < PC_TPG_NRCG; i++) {
+		pc_tpg_mark(pc_tpg_rcgs[i].name);
+		if (pc_tpg_rcg_set(&pc_tpg_rcgs[i]) == 0)
+			rcg_ok++;
+		(void)pandora_log_sync();
+	}
+
+	/* S7: CORE_AHB (BRANCH_HALT_DELAY: enable+delay, no halt poll) then the
+	 * AHB/AXI/qdss branches. S8: TPG/CSID/VFE + all three cpas_vfe. */
+	pc_tpg_mark("diag: about to enable core_ahb");
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core_before | PC_CBCR_ENABLE);
+	pc_sleep(1);
+	(void)pandora_log_sync();
+	for (unsigned i = 0; i < PC_TPG_NBRANCH; i++) {
+		printf("PANDORA TPG: branch[%u] +%#x\n", i, pc_tpg_branches[i]);
+		(void)pandora_log_sync();
+		pc_wr(pc_camcc, pc_tpg_branches[i],
+		    branch_before[i] | PC_CBCR_ENABLE);
+		br_up[i] = (pc_wait_branch_on("tpg", pc_tpg_branches[i]) == 0);
+		if (br_up[i])
+			br_ok++;
+		(void)pandora_log_sync();
+	}
+	printf("PANDORA TPG: resources gdsc=%u/4 pll=%u/2 rcg=%u/%u branch=%u/%u\n",
+	    gdsc_ok, pll_ok, rcg_ok, (unsigned)PC_TPG_NRCG, br_ok, (unsigned)PC_TPG_NBRANCH);
+	(void)pandora_log_sync();
+
+	/* S9 (direction B): enable the GCC camera hf/sf AXI bridge now that the
+	 * CAMCC domain is fully up. VFE register reads froze without it. Single
+	 * sub-page map, never unmapped; read-then-write the two offsets Android
+	 * proved readable; BRANCH_HALT_SKIP so no halt poll. */
+	pc_tpg_mark("diag: about to map GCC cam-axi page");
+	gccaxi = ml_io_map_unmappable(PC_GCC_CAM_AXI_PA, 0x1000, VM_WIMG_IO);
+	if (gccaxi) {
+		pc_tpg_mark("diag: GCC page mapped, about to read hf/sf");
+		gcc_hf0 = pc_rd(gccaxi, PC_GCC_HF_AXI_OFF);
+		gcc_sf0 = pc_rd(gccaxi, PC_GCC_SF_AXI_OFF);
+		printf("PANDORA TPG: gcc hf=%#x sf=%#x before\n", gcc_hf0, gcc_sf0);
+		(void)pandora_log_sync();
+		pc_wr(gccaxi, PC_GCC_HF_AXI_OFF, gcc_hf0 | PC_CBCR_ENABLE);
+		pc_wr(gccaxi, PC_GCC_SF_AXI_OFF, gcc_sf0 | PC_CBCR_ENABLE);
+		printf("PANDORA TPG: gcc hf=%#x sf=%#x after (no halt poll)\n",
+		    pc_rd(gccaxi, PC_GCC_HF_AXI_OFF), pc_rd(gccaxi, PC_GCC_SF_AXI_OFF));
+		(void)pandora_log_sync();
+	} else {
+		pc_tpg_mark("gcc cam-axi map FAILED (VFE read may freeze)");
+	}
+
+	/* S11: read HW versions only for blocks whose GDSC + clock branches are
+	 * confirmed up. A read into a still-powered-off block is a Synchronous
+	 * External Abort (the panic this project already hit once), so each read
+	 * is gated on its own prerequisites. Print + sync IMMEDIATELY after each
+	 * read so an abort on a later block still leaves the earlier versions on
+	 * disk. TPG v2.4.0 = 0x20040000. */
+	pc_sleep(2);
+	uint32_t tv = 0, cv = 0, vv = 0;
+	/* branch idx: 0=cpas_ahb 5=csiphy_rx 6=csid 7=vfe0; gdsc bit0=top bit1=tfe_0 */
+	if ((gdsc_up_mask & 0x1u) && br_up[0] && br_up[5]) {
+		pc_tpg_mark("diag: about to read tpg2 version");
+		tv = pc_rd(tpg2, 0x0);
+		printf("PANDORA TPG: tpg2@%#x HW_VERSION=%#x (gen=%u rev=%u step=%u) -> %s\n",
+		    PC_TPG2_PA, tv, (unsigned)(tv >> 28), (unsigned)((tv >> 16) & 0xfffu),
+		    (unsigned)(tv & 0xffffu), (tv == 0x20040000u) ? "TPG_2.4.0" : "UNEXPECTED");
+		(void)pandora_log_sync();
+	} else {
+		pc_tpg_mark("tpg2 version SKIPPED (titan_top/cpas_ahb/csiphy_rx not all up)");
+	}
+	if ((gdsc_up_mask & 0x1u) && br_up[6] && br_up[5]) {
+		pc_tpg_mark("diag: about to read csid0 version");
+		cv = pc_rd(csid0, 0x0);
+		printf("PANDORA TPG: csid0@%#x HW_VERSION=%#x\n", PC_CSID0_PA, cv);
+		(void)pandora_log_sync();
+	} else {
+		pc_tpg_mark("csid0 version SKIPPED");
+	}
+	if ((gdsc_up_mask & 0x2u) && br_up[7]) {
+		pc_tpg_mark("diag: about to read vfe0 version");
+		vv = pc_rd(vfe0, 0x0);
+		printf("PANDORA TPG: vfe0@%#x HW_VERSION=%#x\n", PC_VFE0_PA, vv);
+		(void)pandora_log_sync();
+	} else {
+		pc_tpg_mark("vfe0 version SKIPPED");
+	}
+
+	/* P1: lease a camera SMMU bank and map the frame buffer to IOVA 0x100000
+	 * (SID 0x1c00). Independent of camera power (apps-smmu is always on); the
+	 * mapping is kept alive for the VFE DMA in the next increment. */
+	pc_tpg_mark("diag: about to map camera SMMU frame buffer");
+	int smmu_err = pc_tpg_smmu_map();
+	printf("PANDORA TPG: camera SMMU map result=%d\n", smmu_err);
+	(void)pandora_log_sync();
+	/* Increment 2a: with the camera fully up and the frame buffer mapped,
+	 * drive TPG->CSID RDI0 and look for frame events. Gated on the TPG/CSID
+	 * HW versions actually read back (a write into a powered-off block is a
+	 * Synchronous External Abort). VFE DMA is the next increment (2b). */
+	if (tv == 0x20040000u && cv != 0 && cv != 0xffffffffu) {
+		pc_tpg_stream_2a(tpg2, csid0, vfe0);
+	} else {
+		pc_tpg_mark("2a SKIPPED (tpg2/csid0 version not confirmed up)");
+	}
+
+
+	/* Reverse-order power-down: branches off, RCG/PLL state restored, GDSCs
+	 * collapsed child-first. Restoring exact before-values leaves no camera
+	 * state behind (the w1 rollback discipline). The GCC-enable trial froze the
+	 * whole kernel right after the vfe0 version read, i.e. somewhere in here;
+	 * every step is marked + synced so a bus hang on any single MMIO write is
+	 * pinpointed on disk (the helpers' own prints are not synced). */
+	pc_tpg_mark("teardown: begin (reverse order)");
+	if (gccaxi) {
+		pc_tpg_mark("teardown: about to restore GCC hf/sf");
+		pc_wr(gccaxi, PC_GCC_HF_AXI_OFF, gcc_hf0);
+		pc_wr(gccaxi, PC_GCC_SF_AXI_OFF, gcc_sf0);
+		pc_tpg_mark("teardown: GCC hf/sf restored");
+	}
+	pc_tpg_mark("teardown: about to restore 12 branches + core_ahb");
+	for (unsigned i = 0; i < PC_TPG_NBRANCH; i++)
+		pc_wr(pc_camcc, pc_tpg_branches[i], branch_before[i]);
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core_before);
+	pc_tpg_mark("teardown: branches restored");
+	pc_tpg_mark("teardown: about to restore 6 RCGs");
+	for (unsigned i = 0; i < PC_TPG_NRCG; i++) {
+		pc_wr(pc_camcc, pc_tpg_rcgs[i].cmd + 4, rcg_cfg_before[i]);
+		pc_wr(pc_camcc, pc_tpg_rcgs[i].cmd, rcg_cmd_before[i]);
+	}
+	pc_tpg_mark("teardown: RCGs restored");
+	pc_tpg_mark("teardown: about to handle pll0/pll3");
+	printf("PANDORA TPG: teardown: pll0 before mode=%#x op=%#x; pll3 before mode=%#x op=%#x\n",
+	    pll0_mode0, pll0_op0, pll3_mode0, pll3_op0);
+	(void)pandora_log_sync();
+	/* Do NOT blind-restore the boot-time off-snapshot to a RUNNING PLL. The
+	 * 724f9d2 trial hung the whole bus on exactly these writes (last mark
+	 * "about to restore pll0/pll3"; "PLLs restored" never flushed). The verified
+	 * CCI path (pc_cci_clk_37mhz) only restores mode/op when the PLL FAILED to
+	 * start; on success it leaves PLL0 running. Mirror that: leave PLL0/PLL3
+	 * enabled. The RCGs are already back on XO and the GDSCs collapse below, so
+	 * the camera is parked; an idle PLL is harmless (the 0460 CCI image booted to
+	 * the desktop with PLL0 left running). */
+	pc_tpg_mark("teardown: PLLs left running (no blind off-restore; verified CCI behavior)");
+	for (unsigned i = 4; i-- > 0;) {
+		printf("PANDORA TPG: teardown: about to collapse %s\n", gdsc_names[i]);
+		(void)pandora_log_sync();
+		pc_tpg_gdsc_down(gdscs[i], gdsc_names[i]);
+	}
+	pc_tpg_mark("teardown: GDSCs collapsed");
+	printf("PANDORA TPG: P0 bring-up done tpg_version=%#x gdsc=%u pll=%u rcg=%u branch=%u\n",
+	    tv, gdsc_ok, pll_ok, rcg_ok, br_ok);
+	(void)pandora_log_sync();
+}
+
+static void
+pc_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 0;
+	(void)PE_parse_boot_argn("pandora_camera_delay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("pandora_steps", &pc_steps_ms, sizeof(pc_steps_ms));
+	if (delay_s) {
+		printf("PANDORA CAMERA: waiting %u s before read-only diag\n", delay_s);
+		pc_sleep(delay_s * 1000u);
+	}
+	/* TPG P0 is a self-contained, separately-gated path (pandora_tpg=1). It
+	 * does not run the sensor/CCI diagnostics below, so it is a clean single
+	 * variable against the verified pandora_camera=1/2 baseline. */
+	if (pc_tpg) {
+		pc_tpg_p0_bringup();
+		goto out;
+	}
+	/* CSIPHY0 real-sensor receive front-end (pandora_csiphy=1), slice A:
+	 * separately gated, clean single variable against the TPG baseline. */
+	if (pc_csiphy) {
+		pc_csiphy0_bringup();
+		goto out;
+	}
+	/* No GCC map: the GPU/touch drivers already map 0x100000 and report its vote; a second
+	 * unmappable mapping of the same aperture plus a later unmap unmaps the shared window. */
+	pc_step("CAMCC", PC_CAMCC_PA);
+	pc_camcc = ml_io_map_unmappable(PC_CAMCC_PA, 0x80000, VM_WIMG_IO);
+	pc_step("BDISTMCLKCC", PC_BDISTM_PA);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000, VM_WIMG_IO);
+	pc_step("TLMM", PC_TLMM_PA);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000, VM_WIMG_IO);
+	if (!pc_camcc || !pc_bdistm || !pc_tlmm) {
+		printf("PANDORA CAMERA: mapping failed camcc=%#llx bdistm=%#llx tlmm=%#llx\n",
+		    (unsigned long long)pc_camcc,
+		    (unsigned long long)pc_bdistm, (unsigned long long)pc_tlmm);
+		goto out;
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		pc_step("CCI", PC_CCI_PA(n));
+		pc_cci[n] = ml_io_map_unmappable(PC_CCI_PA(n), 0x1000, VM_WIMG_IO);
+		if (!pc_cci[n]) {
+			printf("PANDORA CAMERA: CCI%u mapping failed\n", n);
+			continue;
+		}
+		pc_cci_dump(n);
+	}
+	pc_camcc_dump();
+	pc_tlmm_dump();
+	/* DT strap dump (not MMIO): which sensor would be read first, and what
+	 * its rails cost. Values are the live DT's, already cross-checked by
+	 * resolving each *-supply phandle to its regulator node. */
+	printf("PANDORA CAMERA: sensor0 (wide, ovx10500u 0x20) CCI0 master1 csiphy0 mclk=gpio89 rst=gpio106 "
+	    "vana=GPIO107 2.8V vdig=GPIO107 0.95V vaf=GPIO116 3.3V vio=L5M_E1 1.8V bob=B1B_E0 bob2=B2B_E0\n");
+	printf("PANDORA CAMERA: sensor3 (tele, s5khpe 0x5a) CCI0 master0 csiphy3 mclk=gpio92 rst=gpio105 "
+	    "vana=GPIO113 2.2V vdig=GPIO113 0.95V vio=L5M_E1 vaf=L5N_E1 3.3V custom1=L3N_E1\n");
+	printf("PANDORA CAMERA: sensor (ultra, s5kjn5 0x7a) no live-DT node; front (ov50m) not in this run\n");
+	printf("PANDORA CAMERA: C-2a diag done (read-only), 3 rear sensors recorded; vendor config not downloaded; "
+	    "C-2a issued no rail vote and no write\n");
+	/* All read-only evidence (C-2a, C-2b-p, C-2b-w0) is printed before the
+	 * first write, so a restart can be attributed to a named w1 step. */
+	pc_clock_probe();
+	pc_w0_dump();
+	pc_w4_pll_snapshot();
+	pc_w1_bringup();
+	printf("PANDORA CAMERA: C-2b-w1 thread done\n");
+	/* Stage D: real driver bring-up (power + driver read/write path), distinct
+	 * from the read-only diagnostics above. Leaves sensors powered for use. */
+	pc_sensor_init();
+out:
+	/* Deliberately no unmaps anywhere in this file: a one-shot boot diagnostic shares
+	 * the TLMM/CCI apertures with the worker threads (and the GCC aperture already taught
+	 * the lesson), so the maps stay for the whole boot, like the other pandora drivers. */
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_camera_init(void)
+{
+	(void)PE_parse_boot_argn("pandora_camera", &pc_level, sizeof(pc_level));
+	(void)PE_parse_boot_argn("pandora_tpg", &pc_tpg, sizeof(pc_tpg));
+	(void)PE_parse_boot_argn("pandora_csiphy", &pc_csiphy, sizeof(pc_csiphy));
+	if (!pc_level && !pc_tpg && !pc_csiphy) {
+		return;
+	}
+	if (pc_started) {
+		return;
+	}
+	pc_started = true;
+	thread_t thread;
+	if (kernel_thread_start(pc_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("PANDORA CAMERA: diag thread allocation failed\n");
+	}
+}
+#endif /* PANDORA */
