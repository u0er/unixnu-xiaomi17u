+/*
+ * C-2b-w12: powered CCI queue diagnostic. Power up the sensor first (w9
+ * sequence), then run w11-style queue tests. Also reads I2C SDA/SCL GPIO
+ * pin states before and during the transaction.
+ */
+static void
+pc_w12_powered_diag(void)
+{
+	uint32_t v, cur, qs_val;
+	unsigned m = 1;
+
+	if (pc_cci[0] == 0) {
+		printf("PANDORA CAMERA: w12 CCI not mapped, skip\n");
+		return;
+	}
+
+	/* CCI0 branch on */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w12", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: w12 branch did NOT come up; abort\n");
+		return;
+	}
+
+	/* CCI reset + clear */
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	{
+		uint32_t rst_st = 0;
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA CAMERA: w12 CCI reset done (status=%#x)\n", rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+
+	/* Timing */
+	{
+		static const uint32_t timings[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), timings[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), timings[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), timings[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), timings[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), timings[0][4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* Power up wide sensor (same as w9) */
+	printf("PANDORA CAMERA: w12 RPMh: L5M_E1 1800mV, B1B_E0 3400mV, B2B_E0 2704mV\n");
+	pandora_rpmh_resource("L5M_E1", 0, 1800);
+	pandora_rpmh_resource("L5M_E1", 4, 1);
+	pandora_rpmh_resource("B1B_E0", 0, 3400);
+	pandora_rpmh_resource("B1B_E0", 4, 1);
+	pandora_rpmh_resource("B2B_E0", 0, 2704);
+	pandora_rpmh_resource("B2B_E0", 4, 1);
+	pc_sleep(1);
+
+	printf("PANDORA CAMERA: w12 GPIO: 107=high (wide pwr), 116=high (afvdd)\n");
+	pc_gpio_set(107, 0, 0, 2, 1);
+	pc_gpio_set(116, 0, 0, 2, 1);
+	pc_sleep(1);
+
+	printf("PANDORA CAMERA: w12 GPIO 106=low (reset assert)\n");
+	pc_gpio_set(106, 0, 0, 2, 0);
+	pc_sleep(10);
+
+	printf("PANDORA CAMERA: w12 GPIO 89=cam_mclk (func=1, 8mA)\n");
+	pc_gpio_set(89, 1, 0, 8, -1);
+	pc_sleep(5);
+
+	/* Read I2C SDA/SCL pin state via TLMM GPIO config+in */
+	/* CCI0 I2C pins: SDA=gpio5, SCL=gpio4 (from vendor DT) */
+	printf("PANDORA CAMERA: w12 I2C pin state (before xfer):\n");
+	printf("PANDORA CAMERA: w12   gpio5 SDA cfg=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0005u * 0x1000u), pc_rd(pc_tlmm, 0x0005u * 0x1000u + 0x004u));
+	printf("PANDORA CAMERA: w12   gpio4 SCL cfg=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0004u * 0x1000u), pc_rd(pc_tlmm, 0x0004u * 0x1000u + 0x004u));
+
+	/* Test A: REPORT-only (verify engine works with power) */
+	printf("PANDORA CAMERA: w12 TEST A: REPORT-only on M%u (powered)\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w12 A cur_word_cnt=%u\n", cur);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 A IRQ now=%#x\n", v);
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w12 A wait_irq ret=%d\n", ret);
+	}
+
+	/* Reset between tests */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	pc_sleep(1);
+
+	/* Test B: full SET_PARAM+WRITE+REPORT (powered) */
+	printf("PANDORA CAMERA: w12 TEST B: SET_PARAM+WRITE+REPORT on M%u (powered)\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | (0x20u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w12 B cur_word_cnt=%u\n", cur);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 B IRQ now=%#x\n", v);
+	pc_sleep(2);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 B IRQ +2ms=%#x cur_cmd=%#x\n",
+	    v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	/* Read I2C pins during transfer */
+	printf("PANDORA CAMERA: w12 I2C pin state (during xfer):\n");
+	printf("PANDORA CAMERA: w12   gpio5 SDA in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0005u * 0x1000u + 0x004u));
+	printf("PANDORA CAMERA: w12   gpio4 SCL in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0004u * 0x1000u + 0x004u));
+
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w12 B wait_irq ret=%d status=%#x\n",
+		    ret, pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0));
+		if (ret == 0)
+			printf("PANDORA CAMERA: w12 B report_status=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)));
+	}
+
+	/* Rollback */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	printf("PANDORA CAMERA: w12 rollback: MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	pc_gpio_set(89, 0, 0, 2, -1);
+	pc_gpio_set(106, 0, 0, 2, 1);
+	pc_gpio_set(107, 0, 0, 2, 0);
+	pc_gpio_set(116, 0, 0, 2, 0);
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	printf("PANDORA CAMERA: C-2b-w12 result: powered diag done\n");
+}
+
+/*
+ * C-2b-w13: pinmux fix + powered I2C chip-ID probe.
+ * w12 proved: engine works (REPORT-only IRQ ok), power works, but WRITE hangs
+ * because CCI I2C pins (gpio 109-112) are in GPIO mode (func=0), not CCI I2C.
+ * w13 configures the pins to CCI I2C function, then runs chip-ID reads.
+ */
+static void
+pc_w13_pinnmux_i2c(void)
+{
+	uint32_t v, cur, ctl;
+	unsigned m = 1; /* CCI0 M1 = wide, slave 0x20 */
+	int clk37 = 0;  /* set by pc_cci_clk_37mhz(); selects the timing table */
+	static const uint8_t cci0_m0[] = {109, 110}; /* SDA, SCL */
+	static const uint8_t cci0_m1[] = {111, 112}; /* SDA, SCL */
+
+	if (pc_cci[0] == 0 || pc_tlmm == 0) {
+		printf("PANDORA CAMERA: w13 CCI/TLMM not mapped, skip\n");
+		return;
+	}
+
+	/* 1. CCI0 branch on */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w13", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: w13 branch did NOT come up; abort\n");
+		return;
+	}
+
+	/* 2. CCI reset */
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	{
+		uint32_t rst_st = 0;
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA CAMERA: w13 CCI reset done (status=%#x)\n", rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+
+	/* 3. Power up sensor - w30: 1:1 mirror of the Android
+	 * cam_sensor_power_up() sequence measured on THIS device with tracefs
+	 * (docs/CAMERA_C2B_ANDROID_POWER_SEQUENCE.md).
+	 *
+	 * Android order: assert resets + park MCLK pins as input -> B2B_E0
+	 *   -> afvdd(116) -> VIO(L5M_E1) -> tele(113 + L3N/L5N)
+	 *   -> MCLK 19.2MHz from XO -> wide(107) -> wide reset release
+	 *   -> tele reset release -> CCI0 37.5MHz -> settle -> I2C.
+	 * Each rail is separated by ~1 ms. MCLK is XO/19.2 MHz with
+	 * CFG_RCGR=0x00100001 / CBCR=0x08000001; Android never enables a
+	 * BDISTM PLL0 (w21..w29 wrongly used 960 MHz / 24 MHz).
+	 */
+	{
+		/* step0: Android drives gpio89/92 as INPUT (OE=0, func=cam_mclk,
+		 * 2 mA, bias-disable) and asserts BOTH resets BEFORE any rail.
+		 * w21..w29 drove them as GPIO outputs (OE=1, 8 mA), which can
+		 * override the clock controller's MCLK output entirely. */
+		/* out=-1 is required: pc_gpio_set() sets CTL OE bit (0x200) for ANY
+		 * out >= 0, including 0. Only -1 leaves OE=0 (input direction). */
+		pc_gpio_set(89, 1, 0, 2, -1);
+		pc_gpio_set(92, 1, 0, 2, -1);
+		pc_gpio_set(106, 0, 0, 2, 0);  /* wide reset assert (low) */
+		pc_gpio_set(105, 0, 0, 2, 0);  /* tele reset assert (low) */
+		printf("PANDORA CAMERA: w30 step0 reset-first: 89ctl=%#x 92ctl=%#x "
+		    "106ctl=%#x 105ctl=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(89)), pc_rd(pc_tlmm, PC_GPIO(92)),
+		    pc_rd(pc_tlmm, PC_GPIO(106)), pc_rd(pc_tlmm, PC_GPIO(105)));
+		pc_sleep(1);
+
+		/* step1: B2B_E0 (bob2) 2704 mV - first rail in Android trace.
+		 * B1B_E0 3400 mV is kept from w22 (already verified healthy). */
+		{
+			int a = pandora_rpmh_resource("B1B_E0", 0, 3400);
+			int b = pandora_rpmh_resource("B1B_E0", 4, 1);
+			int c = pandora_rpmh_resource("B2B_E0", 0, 2704);
+			int d = pandora_rpmh_resource("B2B_E0", 4, 1);
+			printf("PANDORA CAMERA: w30 step1 B1B(%d,%d) B2B(%d,%d)\n",
+			    a, b, c, d);
+		}
+		/* w28/w29 MODE vote kept verbatim (w29 healthy). */
+		{
+			int m1 = pandora_rpmh_resource("L5M_E1", 8, 7);
+			int m2 = pandora_rpmh_resource("B1B_E0", 8, 7);
+			int m3 = pandora_rpmh_resource("B2B_E0", 8, 7);
+			printf("PANDORA CAMERA: w30 step1 MODE ret: L5M=%d B1B=%d B2B=%d\n",
+			    m1, m2, m3);
+		}
+		pc_sleep(1);
+
+		/* step2: wide afvdd gpio116 */
+		pc_gpio_set(116, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step2 afvdd gpio116 ctl=%#x in=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(116)), pc_rd(pc_tlmm, PC_GPIO(116) + 0x4));
+		pc_sleep(1);
+
+		/* step3: VIO L5M_E1 1800 mV */
+		{
+			int a = pandora_rpmh_resource("L5M_E1", 0, 1800);
+			int b = pandora_rpmh_resource("L5M_E1", 4, 1);
+			printf("PANDORA CAMERA: w30 step3 VIO L5M_E1 1800mV ret(%d,%d)\n", a, b);
+		}
+		pc_sleep(1);
+
+		/* step4: tele rails + gpio113 (Android enables n_l3/n_l5 here) */
+		{
+			int a = pandora_rpmh_resource("L3N_E1", 0, 1800);
+			int b = pandora_rpmh_resource("L3N_E1", 4, 1);
+			int c = pandora_rpmh_resource("L5N_E1", 0, 3300);
+			int d = pandora_rpmh_resource("L5N_E1", 4, 1);
+			printf("PANDORA CAMERA: w30 step4 tele RPMh L3N(%d,%d) L5N(%d,%d)\n",
+			    a, b, c, d);
+		}
+		pc_gpio_set(113, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step4 tele vana/vdig gpio113 ctl=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(113)));
+		pc_sleep(1);
+
+		/* step5: MCLK - copy the Android running register values.
+		 * CFG_RCGR=0x00100001 = SRC_SEL 0 (bi_tcxo/XO), SRC_DIV 1,
+		 * HW_CLK_CTRL; CBCR BIT(0) only (upper bits are read-only).
+		 * Offsets from pc_clock_probe(): cmd 4000/4038/4054/4070,
+		 * cbcr 4018/4050/406c/4088. w21's 0x401c was NOT a cmd_rcgr. */
+		{
+			static const uint32_t mclk_cmd[] = { 0x4000u, 0x4038u, 0x4054u, 0x4070u };
+			static const uint32_t mclk_cbcr[] = { 0x4018u, 0x4050u, 0x406cu, 0x4088u };
+			for (unsigned mi = 0; mi < 4; mi++) {
+				uint32_t cmd = mclk_cmd[mi];
+				uint32_t cbcr = mclk_cbcr[mi];
+				printf("PANDORA CAMERA: w30 step5 mclk%u BEFORE cfg=%#x cmd=%#x cbcr=%#x\n",
+				    mi, pc_rd(pc_bdistm, cmd + 4), pc_rd(pc_bdistm, cmd),
+				    pc_rd(pc_bdistm, cbcr));
+				pc_wr(pc_bdistm, cmd + 4, 0x00100001u);
+				/* shared RCG: clear CMD_ROOT_OFF(bit31), then UPDATE(bit0).
+				 * Android running state reads CMD_RCGR=0, so do NOT leave
+				 * ROOT_EN(bit1) set like w21's 0x3 did. */
+				pc_wr(pc_bdistm, cmd, (pc_rd(pc_bdistm, cmd) & ~0x80000000u) | 0x1u);
+				for (unsigned pi = 0; pi < 50; pi++) {
+					if (!(pc_rd(pc_bdistm, cmd) & 0x1u))
+						break;
+					pc_sleep(1);
+				}
+				pc_wr(pc_bdistm, cbcr, pc_rd(pc_bdistm, cbcr) | 0x1u);
+				printf("PANDORA CAMERA: w30 step5 mclk%u AFTER cfg=%#x cmd=%#x "
+				    "cbcr=%#x target cfg=0x100001 cbcr=0x8000001\n",
+				    mi, pc_rd(pc_bdistm, cmd + 4), pc_rd(pc_bdistm, cmd),
+				    pc_rd(pc_bdistm, cbcr));
+			}
+		}
+		pc_sleep(1);
+
+		/* step6: wide avdd/dvdd/avdd1 gpio107 */
+		pc_gpio_set(107, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step6 wide pwr gpio107 ctl=%#x in=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(107)), pc_rd(pc_tlmm, PC_GPIO(107) + 0x4));
+		pc_sleep(1);
+
+		/* step7: wide reset RELEASE (Android holds assert ~17 ms) */
+		pc_gpio_set(106, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step7 wide reset 106 RELEASE\n");
+		pc_sleep(18);
+
+		/* step8: tele reset RELEASE */
+		pc_gpio_set(105, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step8 tele reset 105 RELEASE\n");
+		pc_sleep(3);
+	}
+
+	/* w29: align CCI core clock AND the I2C timing with the working
+	 * Android configuration (both must match or SCL/tsu/thd go wrong).
+	 * w30: now runs AFTER the sensor reset releases, matching Android
+	 * where cam_cc_cci_0_clk is enabled LAST, just before the first I2C. */
+	clk37 = pc_cci_clk_37mhz();
+
+	/* 4. PINMUX FIX: configure CCI0 I2C pins to CCI I2C function */
+	/* TLMM layout: bits[1:0]=pull, bits[5:2]=func, bits[7:6]=drv, bit[9]=oe */
+	/* CCI I2C function = 1 (cci_i2c_sdaN/sclN) */
+	printf("PANDORA CAMERA: w13 PINMUX: configuring CCI0 I2C pins\n");
+	for (unsigned i = 0; i < 2; i++) {
+		/* M0 pins */
+		ctl = pc_rd(pc_tlmm, PC_GPIO(cci0_m0[i]));
+		printf("PANDORA CAMERA: w13   gpio%u BEFORE ctl=%#x\n", cci0_m0[i], ctl);
+		/* w28: DT nezha_cci_*_active/config = bias-disable + 2mA. */
+		ctl = (ctl & ~0x3ffu) | (1u << 2);
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m0[i]), ctl);
+		printf("PANDORA CAMERA: w13   gpio%u AFTER  ctl=%#x\n", cci0_m0[i],
+		    pc_rd(pc_tlmm, PC_GPIO(cci0_m0[i])));
+
+		/* M1 pins */
+		ctl = pc_rd(pc_tlmm, PC_GPIO(cci0_m1[i]));
+		printf("PANDORA CAMERA: w13   gpio%u BEFORE ctl=%#x\n", cci0_m1[i], ctl);
+		ctl = (ctl & ~0x3ffu) | (1u << 2);
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m1[i]), ctl);
+		printf("PANDORA CAMERA: w13   gpio%u AFTER  ctl=%#x\n", cci0_m1[i],
+		    pc_rd(pc_tlmm, PC_GPIO(cci0_m1[i])));
+	}
+
+	/* 5. CCI timing: MUST match the core clock actually running.
+	 * Upstream hw_params[19.2MHz][STD] vs hw_params[37.5MHz][STD].
+	 * DT has no clock-frequency property -> I2C_MODE_STANDARD. */
+	{
+		static const uint32_t tim_19m[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		static const uint32_t tim_37m[][5] = {
+			{ 201u << 16 | 174u, 204u << 16 | 231u, 22u << 16 | 162u, 227u, 0x163u },
+		};
+		const uint32_t (*t)[5] = clk37 ? tim_37m : tim_19m;
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), t[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), t[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), t[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), t[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), t[0][4]);
+		}
+		printf("PANDORA CAMERA: w28c timing %s: scl=%#x sda0=%#x sda1=%#x "
+		    "sda2=%#x misc=%#x\n",
+		    clk37 ? "37.5MHz STD" : "19.2MHz STD",
+		    t[0][0], t[0][1], t[0][2], t[0][3], t[0][4]);
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* 6. Pin state after mux */
+	printf("PANDORA CAMERA: w13 I2C pin state after mux:\n");
+	printf("PANDORA CAMERA: w13   gpio111 SDA ctl=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, PC_GPIO(111)), pc_rd(pc_tlmm, PC_GPIO(111) + 4));
+	printf("PANDORA CAMERA: w13   gpio112 SCL ctl=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, PC_GPIO(112)), pc_rd(pc_tlmm, PC_GPIO(112) + 4));
+
+	/* 7. Multi-address I2C scan on M1 (wide) */
+	/* w25: trace the pads while CCI runs one transaction, before the scan.
+	 * pinmux is func=1 (CCI) and CCI0 branch is on at this point. */
+	pc_cci_pad_trace(m, 0x10u); /* 0x10 = a w23/w24 bit-bang ACK address */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	pc_sleep(2);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	printf("PANDORA CAMERA: w13 extra settle delay 100ms\n");
+
+	pc_sleep(100);
+
+	/* w31: discriminate the CCI queue shape BEFORE the legacy sweep.
+	 * Both pairs use the Android-confirmed 7-bit sid; the 8-bit forms are
+	 * still covered by the scan loop below as controls. */
+	pc_cci_shape_matrix(1u, 0x10u, 0x300au, clk37); /* wide M1, OV chip-ID 0x5058 */
+	pc_cci_shape_matrix(0u, 0x2du, 0x0000u, clk37); /* tele M0, chip-ID 0x1b7e */
+	/* NEGATIVE CONTROLS: addresses with no device on either master.
+	 * If these return the SAME data as 0x10/0x2d, the w31 "read data" was
+	 * CCI FIFO residue and the whole conclusion must be withdrawn. */
+	pc_cci_shape_matrix(1u, 0x08u, 0x300au, clk37); /* no device on M1 */
+	pc_cci_shape_matrix(0u, 0x77u, 0x0000u, clk37); /* no device on M0 */
+
+	/* w27: one A/B control, then a full address sweep with a clean engine
+	 * before EVERY transaction. First reliable address-layer measurement
+	 * in the C-2b series (w16..w25 never reset between addresses). */
+	pc_cci_txn_ab(m, 0x10u);
+	{
+		unsigned acks = 0;
+		printf("PANDORA CAMERA: w30 WRITE-PROBE sweep 0x08..0x77 on M%u "
+		    "(android sid wide=0x10 tele=0x2d; 8-bit form 0x20/0x5a)\n", m);
+		for (unsigned a = 0x08u; a <= 0x77u; a++)
+			acks += pc_cci_write_probe(m, (uint8_t)a);
+		printf("PANDORA CAMERA: w27 WRITE-PROBE total=%u ACK addresses "
+		    "out of 112\n", acks);
+	}
+	pc_cci_reset_engine();
+
+	/* w30: Android cam_cci_burst tracepoint shows "CCI0_M1_Q0 ... sid : 0x10"
+	 * while vendor dmesg logs "slave_addr:0x20". The vendor value is the
+	 * 8-bit form; CCI SET_PARAM needs the 7-bit address (0x20 >> 1 = 0x10).
+	 * Same for tele 0x5a -> 0x2d and ultra 0x7a -> 0x3d. w16..w29 wrote the
+	 * 8-bit values straight into SET_PARAM, so the controller sent 0x40/0xb4.
+	 * This also explains the w23/w24/w26 bit-bang hit sets: M1 hit 0x10 and
+	 * M0 hit 0x2d, while the DT/vendor 8-bit values 0x20/0x5a never hit.
+	 * Keep both forms so a single boot discriminates the encoding. */
+	static const uint8_t scan_addrs[] = {
+		0x10u, 0x2du, 0x3du,   /* 7-bit Android sid: wide, tele, ultra */
+		0x20u, 0x5au, 0x7au,   /* 8-bit vendor log form (control) */
+		0x34u, 0x36u, 0x1au, 0x3au, 0x6au
+	};
+	for (unsigned ai = 0; ai < sizeof(scan_addrs); ai++) {
+		uint8_t slave = scan_addrs[ai];
+		/* w32: the shape matrix proved per-transaction timing refresh is the
+		 * strongest candidate; apply it to the legacy sweep too. */
+		pc_cci_refresh_timing(clk37);
+		printf("PANDORA CAMERA: w13 SCAN addr=%#x on M1\n", slave);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+		/* w17 combined transaction: SET_PARAM + WRITE reg 0x0000 + READ 2b + REPORT */
+		/* WRITE+READ in same Q0 => CCI generates REPEATED_START (no STOP between) */
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_READ | (2u << 4));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+		cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+		pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+		pc_wr(pc_cci[0], PC_CCI_QUEUE_START, (1u << (m * 2u + 0u)));
+
+		pc_sleep(10);
+		v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		printf("PANDORA CAMERA: w17 SCAN addr=%#x IRQ=%#x cur_cmd=%#x\n",
+		    slave, v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+		/* NACK check: BIT(29)=M1_Q0, BIT(30)=M1_Q1 (from i2c-qcom-cci.c) */
+		if (v & 0x60000000u) {
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> NACK (irq=%#x)\n", slave, v);
+		} else if (v & (1u << (4u + m * 12u))) {
+			uint32_t rd0 = pc_rd(pc_cci[0], PC_CCI_READ_DATA(m));
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> ACK! read_data=%#x\n", slave, rd0);
+		} else {
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> other IRQ=%#x\n", slave, v);
+		}
+
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+		pc_sleep(2);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+	/* w30: tele (sensor3) power/reset/MCLK is now part of the unified
+	 * Android-mirrored power-up above (steps 0/4/8), BEFORE any M0 xfer. */
+
+	/* Also try M0 (tele, Android sid 0x2d = vendor 8-bit 0x5a>>1, chip-ID
+	 * 0x1b7e) with combined transaction. */
+	printf("PANDORA CAMERA: w30 TEST: combined SET_PARAM+WRITE+READ+REPORT on M0 (tele sid=0x2d)\n");
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	m = 0;
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)0x2du << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_READ | (2u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0),
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0)));
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, (1u << (m * 2u + 0u)));
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w17 M0 IRQ now=%#x\n", v);
+	pc_sleep(5);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w17 M0 IRQ +5ms=%#x cur_cmd=%#x\n", v,
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w17 M0 wait_irq ret=%d status=%#x\n", ret,
+		    pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0));
+		if (ret == 0) {
+			uint32_t rd0 = pc_rd(pc_cci[0], PC_CCI_READ_DATA(m));
+			printf("PANDORA CAMERA: w17 M0 report_status=%#x read_data=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)), rd0);
+			if ((rd0 & 0xffff) == 0x1b7eu) {
+				printf("PANDORA CAMERA: w17 CHIP ID MATCH (tele s5khpe = 0x1b7e)\n");
+			} else {
+				printf("PANDORA CAMERA: w17 M0 CHIP ID MISMATCH (got %#x, expect 0x1b7e)\n",
+				    rd0 & 0xffff);
+			}
+		}
+	}
+
+	/* 7b. w24: verify w23's scattered ACKs are real devices (3 rounds +
+	 * pre/post sampling + no-START control). Both sensors still powered. */
+	printf("PANDORA CAMERA: w24: disabling CCI0 branch for GPIO bit-bang\n");
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	pc_sleep(5);
+	/* w23 hits on each bus + DT sensor addresses + low/high controls.
+	 * Deliberately small: a full 0x08..0x77 sweep x 3 rounds at 3 ms per
+	 * edge would stall early boot for ~60 s and risk the watchdog. */
+	static const uint8_t m1_addrs[] = {
+		0x0cu, 0x10u, 0x20u, 0x21u, 0x51u, 0x59u, /* w23 M1 hits + DT wide */
+		0x08u, 0x77u,                              /* controls */
+	};
+	static const uint8_t m0_addrs[] = {
+		0x2du, 0x33u, 0x54u, 0x59u, 0x5cu, 0x5au, /* w23 M0 hits + DT tele */
+		0x08u, 0x77u,                              /* controls */
+	};
+	pc_bb_probe(111, 112, "CCI0_M1(wide 111/112)", m1_addrs,
+	    sizeof(m1_addrs) / sizeof(m1_addrs[0]));
+	pc_bb_probe(109, 110, "CCI0_M0(tele 109/110)", m0_addrs,
+	    sizeof(m0_addrs) / sizeof(m0_addrs[0]));
+
+	/* 8. Rollback: restore pinmux, power off */
+	printf("PANDORA CAMERA: w13 rollback: restore pinmux -> MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	for (unsigned i = 0; i < 2; i++) {
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m0[i]), 0x1u); /* restore to GPIO pull-down */
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m1[i]), 0x1u);
+	}
+	pc_gpio_set(89, 0, 0, 2, 0);   /* wide MCLK off */
+	pc_gpio_set(92, 0, 0, 2, 0);   /* tele MCLK off (w22) */
+	pc_gpio_set(106, 0, 0, 2, 1);  /* wide reset high */
+	pc_gpio_set(105, 0, 0, 2, 1);  /* tele reset high (w22) */
+	pc_gpio_set(107, 0, 0, 2, 0);  /* wide pwr off */
+	pc_gpio_set(116, 0, 0, 2, 0);  /* afvdd off */
+	pc_gpio_set(113, 0, 0, 2, 0);  /* tele vana+vdig off (w22) */
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+	pandora_rpmh_resource("L5N_E1", 4, 0); /* tele vaf (w22) */
+	pandora_rpmh_resource("L3N_E1", 4, 0); /* tele custom1 (w22) */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	printf("PANDORA CAMERA: C-2b-w22 result: pinmux+powered I2C done (see above)\n");
+}
+
+static void
+pc_w9_power_probe(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint16_t id = 0;
+	int ret;
+
+	if (!pc_camcc || !pc_cci[0] || !pc_tlmm) {
+		printf("PANDORA CAMERA: C-2b-w9 skipped (camcc/cci/tlmm unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w9 power probe (wide sensor) before: "
+	    "cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x\n",
+	    cbcr_before, cmd_before, cfg_before);
+
+	/* 1. CCI0 branch on */
+	pc_step("w9 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w9", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w9 branch did NOT come up; abort\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+
+	/* 2. CCI reset (w8 fix) */
+	{
+		uint32_t rst_st = 0;
+		pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24)) {
+				printf("PANDORA CAMERA: w9 CCI reset done (status=%#x)\n",
+				    rst_st);
+				break;
+			}
+			pc_sleep(1);
+		}
+		if (!(rst_st & PC_BIT(24))) {
+			printf("PANDORA CAMERA: w9 CCI reset ACK timeout (status=%#x)\n",
+			    rst_st);
+		}
+		/* Clear stale RST_DONE_ACK so it doesn't block queue execution */
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		printf("PANDORA CAMERA: w9 CCI IRQ cleared after reset\n");
+	}
+
+	/* 3. Vote RPMh rails for wide sensor */
+	printf("PANDORA CAMERA: w9 RPMh: L5M_E1 1800mV, B1B_E0 3400mV, B2B_E0 2704mV\n");
+	pandora_rpmh_resource("L5M_E1", 0, 1800);
+	pandora_rpmh_resource("L5M_E1", 4, 1);
+	pandora_rpmh_resource("B1B_E0", 0, 3400);
+	pandora_rpmh_resource("B1B_E0", 4, 1);
+	pandora_rpmh_resource("B2B_E0", 0, 2704);
+	pandora_rpmh_resource("B2B_E0", 4, 1);
+	pc_sleep(1);
+
+	/* 4. GPIO power enables: GPIO 107 (wide AVDD/DVDD), GPIO 116 (AFVDD) */
+	printf("PANDORA CAMERA: w9 GPIO: 107=high (wide pwr), 116=high (afvdd)\n");
+	pc_gpio_set(107, 0, 0, 2, 1);   /* GPIO 107 high, 2mA */
+	pc_gpio_set(116, 0, 0, 2, 1);   /* GPIO 116 high, 2mA */
+	pc_sleep(1);                     /* 100us ramp + settle */
+
+	/* 5. Assert reset (GPIO 106 low) */
+	printf("PANDORA CAMERA: w9 GPIO 106=low (reset assert)\n");
+	pc_gpio_set(106, 0, 0, 2, 0);   /* reset low */
+	pc_sleep(10);                    /* 10ms hold */
+
+	/* 6. Enable MCLK (GPIO 89 as cam_mclk, func=1, 8mA) */
+	printf("PANDORA CAMERA: w9 GPIO 89=cam_mclk (func=1, 8mA)\n");
+	pc_gpio_set(89, 1, 0, 8, -1);   /* function 1 = cam_mclk, 8mA, no OE */
+	pc_sleep(2);                     /* settle */
+
+	/* 7. CCI timing (19.2MHz Standard) + IRQ mask */
+	{
+		static const uint32_t timings[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		for (unsigned m = 0; m < 2; m++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(m), timings[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(m), timings[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(m), timings[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(m), timings[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(m), timings[0][4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* 8. Read chip-ID (wide: slave 0x20 on M1) */
+	printf("PANDORA CAMERA: w9 I2C: M1 slave=0x20 (wide) expect=0x5058\n");
+	id = 0;
+	ret = pc_cci_read_reg16(pc_cci[0], 1, 0x20, &id);
+	if (ret == 0 && id == 0x5058u) {
+		printf("PANDORA CAMERA: C-2b-w9 wide CHIP ID MATCH (%#x)\n", id);
+	} else if (ret == 0) {
+		printf("PANDORA CAMERA: C-2b-w9 wide chip_id=%#x (expect 0x5058) "
+		    "MISMATCH\n", id);
+	} else {
+		printf("PANDORA CAMERA: C-2b-w9 wide -> NACK/timeout (ret=%d)\n",
+		    ret);
+	}
+
+	/* Also try tele (slave 0x5a on M0) -- no power for tele, just check bus */
+	printf("PANDORA CAMERA: w9 I2C: M0 slave=0x5a (tele) expect=0x1b7e\n");
+	id = 0;
+	ret = pc_cci_read_reg16(pc_cci[0], 0, 0x5a, &id);
+	if (ret == 0 && id == 0x1b7eu) {
+		printf("PANDORA CAMERA: C-2b-w9 tele CHIP ID MATCH (%#x)\n", id);
+	} else if (ret == 0) {
+		printf("PANDORA CAMERA: C-2b-w9 tele chip_id=%#x (expect 0x1b7e) "
+		    "MISMATCH\n", id);
+	} else {
+		printf("PANDORA CAMERA: C-2b-w9 tele -> NACK/timeout (ret=%d)\n",
+		    ret);
+	}
+
+	/* 9. Rollback in reverse */
+	printf("PANDORA CAMERA: w9 rollback: MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	pc_gpio_set(89, 0, 0, 2, -1);   /* GPIO 89 back to GPIO func */
+	pc_gpio_set(106, 0, 0, 2, 1);  /* reset deassert */
+	pc_sleep(1);
+	pc_gpio_set(107, 0, 0, 2, 0);  /* wide power off */
+	pc_gpio_set(116, 0, 0, 2, 0);  /* afvdd off */
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+
+	/* restore timing to saved values (restore original SCL/SDA) */
+	pc_wr(pc_cci[0], PC_CCI_SCL_CTL(0), pc_rd(pc_cci[0], PC_CCI_SCL_CTL(0)));
+	/* (timing restore is best-effort; the values written are the standard set) */
+
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	printf("PANDORA CAMERA: C-2b-w9 cleanup: cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CBCR), pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR));
+	printf("PANDORA CAMERA: C-2b-w9 result: power+I2C probe done "
+	    "(see CHIP ID / NACK lines above)\n");
+}
+static void
+pc_w1_bringup(void)
+{
+	static const uint32_t critical[] = { 0x21398u, 0x21390u, 0x21364u, 0x21368u };
+	uint32_t gdscr0, core0, top0, cfg, gdscr_now;
+	uint32_t cci0_0 = 0;
+	uint32_t cmd0 = 0, cfg0 = 0, cmd_restored = 0, cfg_restored = 0;
+	int ret = 0, down_ret;
+	bool gdsc_up = false, branch_up = false, restored, power_down_ok = false;
+	bool core_ahb_stuck = false;
+	bool w2_up = false, w2_ran = false, root_reparked = false, w2_clean = true;
+
+	printf("PANDORA CAMERA: C-2b-w1 bring-up starts (GDSC + 2 AHB branches; "
+	    "no rail vote, no RCG, no CCI, no GPIO)\n");
+
+	/* Precondition: the critical CBCRs were enabled at boot (C-2b-p read
+	 * 0x08000001 on all four). If they are not, write nothing at all. */
+	for (unsigned i = 0; i < sizeof(critical) / sizeof(critical[0]); i++) {
+		cfg = pc_rd(pc_camcc, critical[i]);
+		printf("PANDORA CAMERA: w1 critical +%#x = %#x\n", critical[i], cfg);
+		if (!(cfg & PC_CBCR_ENABLE)) {
+			printf("PANDORA CAMERA: w1 ABORT: critical CBCR +%#x has no enable bit; no write issued\n",
+			    critical[i]);
+			return;
+		}
+	}
+
+	gdscr0 = pc_rd(pc_camcc, PC_GDSCR);
+	core0 = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+	top0 = pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR);
+	printf("PANDORA CAMERA: w1 before: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x cam_top_ahb=%#x\n",
+	    gdscr0, pc_rd(pc_camcc, PC_CFG_GDSCR), core0, top0);
+
+	/* 1. TITAN_TOP GDSC: clear SW_COLLAPSE, poll CFG_GDSCR bit 16. */
+	pc_step("w1 GDSC enable", PC_CAMCC_PA + PC_GDSCR);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0 & ~PC_GDSC_SW_COLLAPSE);
+	printf("PANDORA CAMERA: w1 wrote gdscr=%#x (SW_COLLAPSE cleared)\n",
+	    pc_rd(pc_camcc, PC_GDSCR));
+	ret = pc_wait_gdsc_up();
+	if (ret) {
+		printf("PANDORA CAMERA: w1 GDSC ERROR %d (power-up complete never observed)\n", ret);
+	} else {
+		gdsc_up = true;
+		pc_sleep(1);                 /* upstream udelay(1) after toggle */
+		pc_wr(pc_camcc, PC_GDSCR, pc_rd(pc_camcc, PC_GDSCR) | PC_GDSC_RETAIN_FF);
+		printf("PANDORA CAMERA: w1 GDSC up: gdscr=%#x cfg_gdscr=%#x\n",
+		    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR));
+	}
+
+	/* 2. CORE_AHB: BRANCH_HALT_DELAY has no halt bit, just a delay. */
+	if (ret == 0) {
+		pc_step("w1 CORE_AHB", PC_CAMCC_PA + PC_CORE_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0 | PC_CBCR_ENABLE);
+		pc_sleep(1);                 /* upstream udelay(10) */
+		cfg = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+		/* camcc-kaanapali.c: cam_cc_core_ahb_clk is an ordinary
+		 * clk_branch2 with enable_mask BIT(0), not a critical or
+		 * hardware-voted clock. A missing readback bit is therefore an
+		 * unexplained observation, not a BRANCH_HALT_DELAY quirk. */
+		core_ahb_stuck = !(cfg & PC_CBCR_ENABLE);
+		printf("PANDORA CAMERA: w1 core_ahb now=%#x enable_stuck=%s "
+		    "(BRANCH_HALT_DELAY has no halt poll)\n",
+		    cfg, core_ahb_stuck ? "YES" : "no");
+
+		/* 3. CAM_TOP_AHB: BRANCH_HALT, poll CLK_OFF clearing. */
+		pc_step("w1 CAM_TOP_AHB", PC_CAMCC_PA + PC_CAM_TOP_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0 | PC_CBCR_ENABLE);
+		ret = pc_wait_branch_on("w1", PC_CAM_TOP_AHB_CBCR);
+		if (ret) {
+			printf("PANDORA CAMERA: w1 CAM_TOP_AHB ERROR %d (CLK_OFF never cleared)\n", ret);
+		} else {
+			branch_up = true;
+		}
+	}
+
+	/* A/B snapshot while (if) the domain is up. CCI0's own branch and RCG
+	 * were deliberately left off, so a zero CCI timing register here is the
+	 * expected state, NOT a failure of w1. */
+	printf("PANDORA CAMERA: w1 A/B snapshot: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x "
+	    "cam_top_ahb=%#x cci0_cbcr=%#x\n",
+	    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR),
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, 0x21268u));
+	if (pc_cci[0]) {
+		printf("PANDORA CAMERA: w1 CCI0 m0 scl_ctl=%#x (CCI branch/RCG untouched; "
+		    "zero is expected)\n", pc_rd(pc_cci[0], 0x100u));
+	}
+	pc_w1_cci_snapshot();
+
+	/* C-2b-w2 runs while the GDSC is still up. It reads the CCI0 RCG state
+	 * and writes only the CCI0 branch CBCR. The parent RCG is in ROOT_OFF
+	 * (C-2b-p), so "branch not on" is an expected possible outcome and is
+	 * reported as its own result; it never changes the w1 verdict. */
+	pc_w2_dump();
+	if (gdsc_up && branch_up) {
+		w2_ran = true;
+		w2_up = pc_w2_branch(&cci0_0, &cmd0, &cfg0);
+		printf("PANDORA CAMERA: C-2b-w2 result: branch_up=%s cmd_rcgr=%#x root_off=%s "
+		    "-> %s (exploratory; does not gate the w1 verdict)\n",
+		    w2_up ? "yes" : "no",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    (pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF) ? "yes" : "no",
+		    w2_up ? "BRANCH ON" : "BRANCH NOT ON");
+	} else {
+		printf("PANDORA CAMERA: C-2b-w2 skipped (GDSC or CAM_TOP_AHB not up)\n");
+	}
+
+	/* C-2b-w5 runs while the GDSC is still up (same gate as w2). It switches
+	 * the CCI0 RCG source from XO to PLL0_OUT_EVEN/16 (37.5 MHz) via the cached
+	 * clk_rcg2_shared_set_rate handshake, then rolls the RCG back. No PLL/RCG M/N
+	 * register is touched; it does NOT gate the w1 verdict. */
+	if (gdsc_up && branch_up) {
+		pc_w13_pinnmux_i2c();
+	}
+
+	/* 4. Rollback in reverse order, always. Restore the exact values read
+	 * before the probe, so no camera state is left changed by a diagnostic. */
+	pc_step("w1 rollback", PC_CAMCC_PA + PC_GDSCR);
+	if (w2_ran) {
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cci0_0);
+		/* Read while the GDSC is still up — the same condition as the
+		 * before/after reads — so the RCG comparison is meaningful.
+		 * w2 never writes CMD_RCGR; if the hardware does not re-park the
+		 * root on branch disable, the probe has left state behind and
+		 * must say so rather than claiming a clean rollback. */
+		cmd_restored = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		cfg_restored = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+		root_reparked = (cmd_restored & PC_CMD_ROOT_OFF) != 0;
+		w2_clean = root_reparked && (cmd_restored == cmd0) &&
+		    (cfg_restored == cfg0);
+		printf("PANDORA CAMERA: C-2b-w3 cleanup: cmd_rcgr=%#x (before=%#x) "
+		    "cfg_rcgr=%#x (before=%#x) root_reparked=%s -> %s\n",
+		    cmd_restored, cmd0, cfg_restored, cfg0,
+		    root_reparked ? "yes" : "no",
+		    w2_clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+	}
+	pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0);
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0);
+	/* Upstream gdsc_disable() polls CFG_GDSCR POWER_DOWN_COMPLETE (bit 15).
+	 * A single read is not proof the domain returned to OFF. */
+	down_ret = pc_wait_gdsc_down();
+	if (down_ret) {
+		printf("PANDORA CAMERA: w1 GDSC-DOWN ERROR %d (power-down complete never observed)\n",
+		    down_ret);
+	} else {
+		power_down_ok = true;
+	}
+	gdscr_now = pc_rd(pc_camcc, PC_GDSCR);
+	cfg = pc_rd(pc_camcc, PC_CFG_GDSCR);
+	/* Compare software control bits only. GDSCR high bits are live hardware
+	 * status and never read back the written value (PC_GDSCR_CTRL_MASK). */
+	restored = (((gdscr_now ^ gdscr0) & PC_GDSCR_CTRL_MASK) == 0) &&
+	    (pc_rd(pc_camcc, PC_CORE_AHB_CBCR) == core0) &&
+	    (pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR) == top0) &&
+	    (!w2_ran || (pc_rd(pc_camcc, PC_CCI0_CBCR) == cci0_0));
+	printf("PANDORA CAMERA: w1 rollback: gdscr=%#x ctrl_mask=%#x cfg_gdscr=%#x "
+	    "(power_down_bit=%s) core_ahb=%#x cam_top_ahb=%#x cci0_cbcr=%#x "
+	    "restored=%s power_down=%s\n",
+	    gdscr_now, PC_GDSCR_CTRL_MASK, cfg,
+	    (cfg & PC_CFG_GDSC_PWR_DOWN) ? "set" : "clear",
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, PC_CCI0_CBCR),
+	    restored ? "yes" : "NO", power_down_ok ? "yes" : "NO");
+	if (w2_ran) {
+		/* Cross-check after the GDSC is off: C-2b-p read 0x80000000 for
+		 * CMD_RCGR in that state. Read-only; no RCG write. */
+		printf("PANDORA CAMERA: w3 post-GDSC-off cmd_rcgr=%#x cfg_rcgr=%#x "
+		    "(C-2b-p baseline 0x80000000)\n",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR));
+	}
+	if (core_ahb_stuck) {
+		printf("PANDORA CAMERA: w1 CORE_AHB enable_stuck: BIT(0) did not read back; "
+		    "unresolved observation, NOT a success. It is reported separately and "
+		    "does not enter the verdict, whose target is the GDSC + CAM_TOP_AHB path.\n");
+	}
+	printf("PANDORA CAMERA: C-2b-w1 result: gdsc_up=%s branch_up=%s restored=%s "
+	    "power_down=%s core_ahb_enable_stuck=%s w2_cleanup=%s%s\n",
+	    gdsc_up ? "yes" : "no", branch_up ? "yes" : "no",
+	    restored ? "yes" : "no", power_down_ok ? "yes" : "no",
+	    core_ahb_stuck ? "YES" : "no",
+	    w2_ran ? (w2_clean ? "CLEAN" : "LEFTOVER") : "n/a",
+	    (gdsc_up && branch_up && restored && power_down_ok) ? " -> PASS" : " -> NOT PASS");
+}
+
+static void
+pc_tlmm_dump(void)
+{
+	/* CCI I2C SDA/SCL pins (DT pinctrl cci0/1/2): mux function is
+	 * cci_i2c_sdaN / sclN. TLMM CTL: func [5:2]. Print the current CTL so
+	 * a later mux step has a before-picture. No pin is driven here. */
+	static const uint8_t pins[] = {109, 110, 111, 112, 113, 114, 107, 160, 108, 149, 115, 116,
+	    89, 106, 92, 105};
+	printf("PANDORA CAMERA: TLMM CCI/sensor pins (ctl/value):\n");
+	for (unsigned i = 0; i < sizeof(pins); i++) {
+		printf("PANDORA CAMERA:   gpio%u ctl=%#x val=%#x\n", pins[i],
+		    pc_rd(pc_tlmm, PC_GPIO(pins[i])), pc_rd(pc_tlmm, PC_GPIO(pins[i]) + 4));
+	}
+}
+
+static void
+pc_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 0;
+	(void)PE_parse_boot_argn("pandora_camera_delay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("pandora_steps", &pc_steps_ms, sizeof(pc_steps_ms));
+	if (delay_s) {
+		printf("PANDORA CAMERA: waiting %u s before read-only diag\n", delay_s);
+		pc_sleep(delay_s * 1000u);
+	}
+	/* No GCC map: the GPU/touch drivers already map 0x100000 and report its vote; a second
+	 * unmappable mapping of the same aperture plus a later unmap unmaps the shared window. */
+	pc_step("CAMCC", PC_CAMCC_PA);
+	pc_camcc = ml_io_map_unmappable(PC_CAMCC_PA, 0x80000, VM_WIMG_IO);
+	pc_step("BDISTMCLKCC", PC_BDISTM_PA);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000, VM_WIMG_IO);
+	pc_step("TLMM", PC_TLMM_PA);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000, VM_WIMG_IO);
+	if (!pc_camcc || !pc_bdistm || !pc_tlmm) {
+		printf("PANDORA CAMERA: mapping failed camcc=%#llx bdistm=%#llx tlmm=%#llx\n",
+		    (unsigned long long)pc_camcc,
+		    (unsigned long long)pc_bdistm, (unsigned long long)pc_tlmm);
+		goto out;
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		pc_step("CCI", PC_CCI_PA(n));
+		pc_cci[n] = ml_io_map_unmappable(PC_CCI_PA(n), 0x1000, VM_WIMG_IO);
+		if (!pc_cci[n]) {
+			printf("PANDORA CAMERA: CCI%u mapping failed\n", n);
+			continue;
+		}
+		pc_cci_dump(n);
+	}
+	pc_camcc_dump();
+	pc_tlmm_dump();
+	/* DT strap dump (not MMIO): which sensor would be read first, and what
+	 * its rails cost. Values are the live DT's, already cross-checked by
+	 * resolving each *-supply phandle to its regulator node. */
+	printf("PANDORA CAMERA: sensor0 (wide, ovx10500u 0x20) CCI0 master1 csiphy0 mclk=gpio89 rst=gpio106 "
+	    "vana=GPIO107 2.8V vdig=GPIO107 0.95V vaf=GPIO116 3.3V vio=L5M_E1 1.8V bob=B1B_E0 bob2=B2B_E0\n");
+	printf("PANDORA CAMERA: sensor3 (tele, s5khpe 0x5a) CCI0 master0 csiphy3 mclk=gpio92 rst=gpio105 "
+	    "vana=GPIO113 2.2V vdig=GPIO113 0.95V vio=L5M_E1 vaf=L5N_E1 3.3V custom1=L3N_E1\n");
+	printf("PANDORA CAMERA: sensor (ultra, s5kjn5 0x7a) no live-DT node; front (ov50m) not in this run\n");
+	printf("PANDORA CAMERA: C-2a diag done (read-only), 3 rear sensors recorded; vendor config not downloaded; "
+	    "C-2a issued no rail vote and no write\n");
+	/* All read-only evidence (C-2a, C-2b-p, C-2b-w0) is printed before the
+	 * first write, so a restart can be attributed to a named w1 step. */
+	pc_clock_probe();
+	pc_w0_dump();
+	pc_w4_pll_snapshot();
+	pc_w1_bringup();
+	printf("PANDORA CAMERA: C-2b-w1 thread done\n");
+out:
+	/* Deliberately no unmaps anywhere in this file: a one-shot boot diagnostic shares
+	 * the TLMM/CCI apertures with the worker threads (and the GCC aperture already taught
+	 * the lesson), so the maps stay for the whole boot, like the other pandora drivers. */
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_camera_init(void)
+{
+	(void)PE_parse_boot_argn("pandora_camera", &pc_level, sizeof(pc_level));
+	if (!pc_level) {
+		return;
+	}
+	if (pc_started) {
+		return;
+	}
+	pc_started = true;
+	thread_t thread;
+	if (kernel_thread_start(pc_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("PANDORA CAMERA: diag thread allocation failed\n");
+	}
+}
+#endif /* PANDORA */
