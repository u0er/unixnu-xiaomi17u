+}
+
+/* C-2b-w4: read-only TAYCAN_ELU PLL0 + CCI0 RCG state snapshot. This is the
+ * device-side read of PLL0's runtime state that §6 of
+ * CAMERA_C2B_RCG_CCI_INPUTS.md lists as still open. The authoritative
+ * clk_taycan_elu_pll_configure() body is NOT in torvalds/linux (only the enum
+ * /regs table / dispatch case are), and the PLL bit masks live in clk-regmap.h
+ * which is not cached, so this probe does NOT write any PLL register — it only
+ * reads and prints the raw values alongside the known config values for
+ * comparison. Decoding the MODE/STATE/STATUS bits is best-effort until those
+ * masks are located; the raw hex is the deliverable. No clock is voted. */
+static void
+pc_w4_pll_snapshot(void)
+{
+	uint32_t mode, opmcde, state, status, lval, alpha, uctl, uctu;
+	uint32_t cfg, cfgu, cfgu1, tctl, tctu;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: w4 PLL0 snapshot skipped (camcc unmapped)\n");
+		return;
+	}
+	mode   = pc_rd(pc_camcc, PC_PLL0_MODE);
+	opmcde = pc_rd(pc_camcc, PC_PLL0_OPMCDE);
+	state  = pc_rd(pc_camcc, PC_PLL0_STATE);
+	status = pc_rd(pc_camcc, PC_PLL0_STATUS);
+	lval   = pc_rd(pc_camcc, PC_PLL0_L_VAL);
+	alpha  = pc_rd(pc_camcc, PC_PLL0_ALPHA);
+	uctl   = pc_rd(pc_camcc, PC_PLL0_USER_CTL);
+	uctu   = pc_rd(pc_camcc, PC_PLL0_USER_CTL_U);
+	cfg    = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL);
+	cfgu   = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL_U);
+	cfgu1  = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL_U1);
+	tctl   = pc_rd(pc_camcc, PC_PLL0_TEST_CTL);
+	tctu   = pc_rd(pc_camcc, PC_PLL0_TEST_CTL_U);
+	printf("PANDORA CAMERA: C-2b-w4 PLL0 (TAYCAN_ELU, camcc+0x0) read-only snapshot\n");
+	printf("PANDORA CAMERA: w4 PLL0 mode     +0x000=%#x  opmcde +0x004=%#x  state +0x008=%#x  status +0x00c=%#x\n",
+	    mode, opmcde, state, status);
+	printf("PANDORA CAMERA: w4 PLL0 l_val    +0x010=%#x (config l=%#x)  alpha +0x014=%#x (config alpha=%#x)\n",
+	    lval, 0x3eu, alpha, 0x8000u);
+	printf("PANDORA CAMERA: w4 PLL0 user_ctl +0x018=%#x (config %#x)  user_ctu +0x01c=%#x (config %#x)\n",
+	    uctl, 0x00008408u, uctu, 0x00000002u);
+	printf("PANDORA CAMERA: w4 PLL0 cfg_ctl  +0x020=%#x (config %#x)  cfg_ctu +0x024=%#x (config %#x)  cfg_ctu1 +0x028=%#x (config %#x)\n",
+	    cfg, 0x25c400e7u, cfgu, 0x0a8062e0u, cfgu1, 0xf51dea20u);
+	printf("PANDORA CAMERA: w4 PLL0 test_ctl +0x02c=%#x  test_ctu +0x030=%#x\n", tctl, tctu);
+	printf("PANDORA CAMERA: w4 CCI0 cmd_rcgr +0x21250=%#x cfg_rcgr +0x21254=%#x m +0x21258=%#x n +0x2125c=%#x d +0x21260=%#x cbcr +0x21268=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR), pc_rd(pc_camcc, PC_CCI0_CFG_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_M_REG), pc_rd(pc_camcc, PC_CCI0_N_REG),
+	    pc_rd(pc_camcc, PC_CCI0_D_REG), pc_rd(pc_camcc, PC_CCI0_CBCR));
+}
+
+/* C-2b-w2/w3: write ONLY the CCI0 branch CBCR BIT(0) and bounded-poll
+ * CLK_OFF. Capture the full CMD_RCGR / CFG_RCGR before and after so the
+ * hardware's ROOT_OFF behaviour is visible, and read the controller state
+ * while the branch is on. The caller restores the exact pre-write CBCR and
+ * checks that the RCG root re-parked. Returns true only if CLK_OFF cleared. */
+static bool
+pc_w2_branch(uint32_t *before, uint32_t *cmd_before, uint32_t *cfg_before)
+{
+	uint32_t v = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	uint32_t cmd_after, cfg_after;
+	int ret;
+
+	*before = v;
+	*cmd_before = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	*cfg_before = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w2 CCI0 branch before=%#x cmd_rcgr=%#x cfg_rcgr=%#x "
+	    "(BIT(0) only; RCG/PLL untouched)\n", v, *cmd_before, *cfg_before);
+	pc_step("w2 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, v | PC_CBCR_ENABLE);
+	ret = pc_wait_branch_on("w2", PC_CCI0_CBCR);
+	cmd_after = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_after = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w2 CCI0 branch after=%#x poll_ret=%d cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s\n",
+	    pc_rd(pc_camcc, PC_CCI0_CBCR), ret, cmd_after, cfg_after,
+	    (cmd_after & PC_CMD_ROOT_OFF) ? "yes" : "no");
+	pc_w3_controller("w3-branch-on");
+	return ret == 0;
+}
+
+/* C-2b-w5: switch the CCI0 RCG source from XO (SRC_SEL=0) to
+ * PLL0_OUT_EVEN/16 (37.5 MHz) using the cached clk_rcg2_shared_set_rate
+ * handshake, then roll it back. Runs while the parent TITAN_TOP GDSC and the
+ * AHB branches are already up (called from pc_w1_bringup after w2).
+ *
+ * Sequence (cached clk-rcg2.c update_config / clk_rcg2_configure):
+ *   1. snapshot CMD_RCGR/CFG_RCGR/CBCR before.
+ *   2. force-enable root + branch on: write CCI0 CBCR BIT(0), poll CLK_OFF
+ *      clear. HW_CLK_CTRL un-parks the root (CMD_ROOT_OFF clears) -- proven in
+ *      w2/w3, so this IS the force-enable; no separate CMD_ROOT_EN write.
+ *   3. write CFG_RCGR with SRC_SEL=2 (PLL0_OUT_EVEN), SRC_DIV=16, keep
+ *      HW_CLK_CTRL, MODE=0.
+ *   4. commit: write CMD_RCGR CMD_UPDATE, poll CMD_UPDATE until it clears.
+ *   5. read back CFG_RCGR/CMD_RCGR/CBCR; report whether SRC_SEL switched.
+ *   6. roll back in reverse: restore CFG, CMD_UPDATE+poll, then branch off
+ *      (root re-parks, as w3 proved), verify CMD_RCGR+CFG_RCGR restored.
+ * No PLL register, RCG M/N, rail, GPIO or CCI queue word is touched. Every
+ * failure is printed and still rolls back; a missing status bit is never
+ * turned into success. */
+static void __unused
+pc_w5_rcg_switch(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint32_t cfg_new, cmd_after, cfg_after, cbcr_after;
+	uint32_t cmd_restored, cfg_restored;
+	int upd_ret = 0, rb_upd_ret = 0;
+	bool switched = false, root_reparked = false, restored_clean = false;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: C-2b-w5 skipped (camcc unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w5 RCG switch before: cbcr=%#x cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s src_sel=%u src_div=%u hw_clk_ctrl=%s\n",
+	    cbcr_before, cmd_before, cfg_before,
+	    (cmd_before & PC_CMD_ROOT_OFF) ? "yes" : "no",
+	    (unsigned)((cfg_before & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_before & PC_CFG_SRC_DIV_MASK),
+	    (cfg_before & PC_CFG_HW_CLK_CTRL) ? "yes" : "no");
+
+	/* 2. branch on (running clock to observe), then FORCE-ENABLE root via
+	 *    CMD_ROOT_EN. HW_CLK_CTRL branch-on alone un-parks the root (clock
+	 *    runs) but does NOT make CMD_UPDATE latch -- the RCG needs CMD_ROOT_EN
+	 *    set, exactly like Linux clk_rcg2_shared_set_rate's clk_rcg2_set_force_enable.
+	 *    Without it CMD_UPDATE times out and the new source is never applied. */
+	pc_step("w5 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w5", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w5 branch did NOT come up; aborting "
+		    "switch (no CFG write issued)\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+	pc_step("w5 force-enable root", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_ROOT_EN);
+	bool root_on = false;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF)) {
+			root_on = true;
+			break;
+		}
+		pc_sleep(1);
+	}
+	printf("PANDORA CAMERA: C-2b-w5 root force-enabled=%s cmd_rcgr=%#x\n",
+	    root_on ? "yes" : "NO", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+
+	/* 3. compute new CFG_RCGR: SRC_SEL=2, SRC_DIV=16, keep HW_CLK_CTRL, MODE=0. */
+	cfg_new = (cfg_before &
+	    ~(PC_CFG_SRC_SEL_MASK | PC_CFG_SRC_DIV_MASK | PC_CFG_MODE_MASK |
+	      PC_CFG_HW_CLK_CTRL)) |
+	    (2u << PC_CFG_SRC_SEL_SHIFT) | (16u << 0) | PC_CFG_HW_CLK_CTRL;
+	printf("PANDORA CAMERA: C-2b-w5 writing cfg_rcgr=%#x (SRC_SEL=2 PLL0_OUT_EVEN, "
+	    "SRC_DIV=16, HW_CLK_CTRL kept, MODE=0)\n", cfg_new);
+	pc_step("w5 CFG_RCGR", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+
+	/* 4. commit: CMD_UPDATE + poll CMD_UPDATE clear (update_config). */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+		upd_ret = ETIMEDOUT;
+	}
+	printf("PANDORA CAMERA: C-2b-w5 update_config ret=%d\n", upd_ret);
+
+	/* 5. read back after. SWITCHED requires BOTH the new SRC_SEL in CFG_RCGR AND
+	 *    the hardware having ACKed CMD_UPDATE (cmd_update_clear). A register write
+	 *    alone is NOT proof -- if CMD_UPDATE is still set the RCG never latched
+	 *    the new source. */
+	cmd_after  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_after  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	cbcr_after = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	bool update_acked = !(cmd_after & PC_CMD_UPDATE);
+	switched = (((cfg_after & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT) == 2u)
+	    && update_acked;
+	printf("PANDORA CAMERA: C-2b-w5 after: cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x "
+	    "src_sel=%u src_div=%u clk_off=%s update_acked=%s -> %s\n",
+	    cbcr_after, cmd_after, cfg_after,
+	    (unsigned)((cfg_after & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_after & PC_CFG_SRC_DIV_MASK),
+	    (cbcr_after & PC_CBCR_CLK_OFF) ? "yes" : "no",
+	    update_acked ? "yes" : "no",
+	    switched ? "SWITCHED" : "NOT SWITCHED");
+	pc_w3_controller("w5-switched");
+
+	/* 6. roll back in reverse: restore CFG, CMD_UPDATE+poll, CLEAR force-enable,
+	 *    branch off -> HW_CLK_CTRL re-parks the root. */
+	pc_step("w5 rollback", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_before);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			rb_upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+		rb_upd_ret = ETIMEDOUT;
+	}
+	/* clear force-enable (CMD_ROOT_EN), then branch off. Without clearing
+	 * CMD_ROOT_EN the root would stay force-enabled after the probe. */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & ~PC_CMD_ROOT_EN);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	cmd_restored = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_restored = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	root_reparked = (cmd_restored & PC_CMD_ROOT_OFF) != 0;
+	restored_clean = (cmd_restored == cmd_before) &&
+	    (cfg_restored == cfg_before);
+	printf("PANDORA CAMERA: C-2b-w5 cleanup: cmd_rcgr=%#x (before=%#x) "
+	    "cfg_rcgr=%#x (before=%#x) root_reparked=%s rb_update=%d -> %s\n",
+	    cmd_restored, cmd_before, cfg_restored, cfg_before,
+	    root_reparked ? "yes" : "no", rb_upd_ret,
+	    restored_clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+	if (switched) {
+		printf("PANDORA CAMERA: C-2b-w5 result: branch_up=yes source_switched=yes "
+		    "rollback=%s -> %s\n", restored_clean ? "CLEAN" : "LEFTOVER",
+		    restored_clean ? "PASS (runtime proof PLL0 usable w/o sw enable)"
+		                   : "PARTIAL (switch ok, rollback incomplete)");
+	} else {
+		printf("PANDORA CAMERA: C-2b-w5 result: source NOT switched; "
+		    "update_acked=%s rollback=%s\n",
+		    update_acked ? "yes" : "no", restored_clean ? "CLEAN" : "LEFTOVER");
+	}
+}
+
+/* C-2b-w6: diagnose the CMD_UPDATE non-ack seen in w5 (update_config ret=60,
+ * ETIMEDOUT). Four hypotheses, one boot, CCI0 RCG registers only -- no PLL,
+ * no RCG M/N/D, no rail/GPIO/CCI transaction:
+ *
+ *   Phase A: reproduce w5 exactly (branch-on + CMD_ROOT_EN force-enable +
+ *            write CFG_RCGR SRC_SEL=2/SRC_DIV=16/HW_CLK_CTRL + CMD_UPDATE).
+ *   Phase B (H2): if CMD_UPDATE is stuck, write 0 explicitly to clear it.
+ *            Does the bit clear, or is it frozen hardware state?
+ *   Phase C (H5): CMD_UPDATE again with CFG_HW_CLK_CTRL cleared. Is the
+ *            update refused *because* bit 20 is set?
+ *   Phase D (H1/H4): restore HW_CLK_CTRL CFG, then branch off->on. Does the
+ *            mux reload without CMD_UPDATE? Then retry CMD_UPDATE once more
+ *            (maybe the reload unblocks it).
+ *   Phase E (H3): read-only PLL0 dump (USER_CTL/USER_CTL_U/STATE/STATUS) --
+ *            is PLL0_OUT_EVEN output gated even though the PLL is running?
+ *   Phase F: rollback. Restore CFG, CMD_UPDATE + poll, explicit 0-clear if
+ *            frozen, clear CMD_ROOT_EN, branch off -> HW_CLK_CTRL re-parks
+ *            the root. CLEAN = ROOT_OFF set + CMD_UPDATE/CMD_ROOT_EN clear +
+ *            CFG restored (this is the state w3 checks as 0x80000000).
+ */
+static void __unused
+pc_w6_update_diag(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint32_t cfg_new, v;
+	bool update_acked = false;
+	bool h2_clear_worked = false;
+	bool h5_acked = false;
+	bool h1_clock_ran = false;
+	bool h1d2_acked = false;
+	int upd_ret;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: C-2b-w6 skipped (camcc unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w6 diag before: cbcr=%#x cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s src_sel=%u src_div=%u hw_clk_ctrl=%s\n",
+	    cbcr_before, cmd_before, cfg_before,
+	    (cmd_before & PC_CMD_ROOT_OFF) ? "yes" : "no",
+	    (unsigned)((cfg_before & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_before & PC_CFG_SRC_DIV_MASK),
+	    (cfg_before & PC_CFG_HW_CLK_CTRL) ? "yes" : "no");
+
+	cfg_new = (cfg_before &
+	    ~(PC_CFG_SRC_SEL_MASK | PC_CFG_SRC_DIV_MASK | PC_CFG_MODE_MASK |
+	      PC_CFG_HW_CLK_CTRL)) |
+	    (2u << PC_CFG_SRC_SEL_SHIFT) | (16u << 0) | PC_CFG_HW_CLK_CTRL;
+
+	/* Phase A: reproduce w5. */
+	pc_step("w6 branch on", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w6", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w6 branch did NOT come up; abort "
+		    "(no CFG write issued)\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+	pc_step("w6 force-enable root", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_ROOT_EN);
+	printf("PANDORA CAMERA: C-2b-w6 A force-enable cmd_rcgr=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	pc_step("w6 A CFG write", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	update_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 A reproduce: update_config ret=%d "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x update_acked=%s\n", upd_ret, v,
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), update_acked ? "yes" : "no");
+
+	/* Phase B (H2): explicit 0-write to clear a stuck CMD_UPDATE. */
+	if (!update_acked) {
+		pc_step("w6 B H2 explicit clear", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		h2_clear_worked = !(v & PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 B H2 explicit CMD_UPDATE clear: "
+		    "cmd_rcgr=%#x h2_clear_worked=%s\n", v,
+		    h2_clear_worked ? "yes" : "no");
+	}
+
+	/* Phase C (H5): CMD_UPDATE with HW_CLK_CTRL cleared in CFG. */
+	pc_step("w6 C H5 cfg w/o HW_CLK_CTRL", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new & ~PC_CFG_HW_CLK_CTRL);
+	printf("PANDORA CAMERA: C-2b-w6 C H5 writing cfg_rcgr=%#x "
+	    "(HW_CLK_CTRL cleared)\n", cfg_new & ~PC_CFG_HW_CLK_CTRL);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	h5_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 C H5 update w/o HW_CLK_CTRL: ret=%d "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x h5_acked=%s\n", upd_ret, v,
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), h5_acked ? "yes" : "no");
+	if (!h5_acked) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 C H5 explicit clear -> %#x\n",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	}
+
+	/* Phase D (H1/H4): branch off->on with HW_CLK_CTRL CFG restored. */
+	pc_step("w6 D H1 cfg restore", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+	printf("PANDORA CAMERA: C-2b-w6 D H1/H4 branch off->on with cfg=%#x\n",
+	    cfg_new);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);                 /* off */
+	pc_sleep(1);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE); /* on */
+	h1_clock_ran = (pc_wait_branch_on("w6-h1", PC_CCI0_CBCR) == 0);
+	printf("PANDORA CAMERA: C-2b-w6 D H1/H4 branch_reload: clock_running=%s "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x cbcr=%#x\n",
+	    h1_clock_ran ? "yes" : "no", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), pc_rd(pc_camcc, PC_CCI0_CBCR));
+	/* D2: retry CMD_UPDATE once after the reload. */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	h1d2_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 D2 CMD_UPDATE after reload: ret=%d "
+	    "cmd_rcgr=%#x h1d2_acked=%s\n", upd_ret, v,
+	    h1d2_acked ? "yes" : "no");
+	if (!h1d2_acked) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+	}
+
+	/* Phase E (H3): read-only PLL0 output-enable dump. */
+	printf("PANDORA CAMERA: C-2b-w6 E H3 PLL0 dump (read-only): mode=%#x "
+	    "state=%#x status=%#x l_val=%#x user_ctl=%#x user_ctl_u=%#x\n",
+	    pc_rd(pc_camcc, PC_PLL0_MODE), pc_rd(pc_camcc, PC_PLL0_STATE),
+	    pc_rd(pc_camcc, PC_PLL0_STATUS), pc_rd(pc_camcc, PC_PLL0_L_VAL),
+	    pc_rd(pc_camcc, PC_PLL0_USER_CTL),
+	    pc_rd(pc_camcc, PC_PLL0_USER_CTL_U));
+	pc_w3_controller("w6-diag");
+
+	/* Phase F: rollback to the idle parked state (w3's 0x80000000). */
+	pc_step("w6 rollback", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_before);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	if (v & PC_CMD_UPDATE) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 rollback: CMD_UPDATE frozen, "
+		    "explicit clear -> %#x\n", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	}
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & ~PC_CMD_ROOT_EN);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_new = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);   /* reuse as cfg_restored */
+	{
+		bool root_reparked = (v & PC_CMD_ROOT_OFF) != 0;
+		bool cmd_clear = !(v & (PC_CMD_UPDATE | PC_CMD_ROOT_EN));
+		bool clean = root_reparked && cmd_clear && (cfg_new == cfg_before);
+		printf("PANDORA CAMERA: C-2b-w6 cleanup: cmd_rcgr=%#x (entry=%#x) "
+		    "cfg_rcgr=%#x (entry=%#x) root_reparked=%s cmd_bits_clear=%s "
+		    "rb_update=%d -> %s\n",
+		    v, cmd_before, cfg_new, cfg_before,
+		    root_reparked ? "yes" : "no", cmd_clear ? "yes" : "no",
+		    upd_ret, clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+		printf("PANDORA CAMERA: C-2b-w6 result: A_update_acked=%s "
+		    "B_h2_explicit_clear=%s C_h5_acked_no_hwctl=%s "
+		    "D_branch_reload_clock=%s D2_update_after_reload=%s "
+		    "rollback=%s\n",
+		    update_acked ? "yes" : "no",
+		    h2_clear_worked ? "yes" : "no",
+		    h5_acked ? "yes" : "no",
+		    h1_clock_ran ? "yes" : "no",
+		    h1d2_acked ? "yes" : "no",
+		    clean ? "CLEAN" : "LEFTOVER");
+	}
+}
+
+/* C-2b-w7 (Path A): I2C bus probe on the XO/div1 CCI0 clock. No PLL write.
+ *
+ * Rationale (see CAMERA_C2B_RCG_CCI_INPUTS.md §6.1): the 37.5 MHz
+ * PLL0_OUT_EVEN source is gated off (PLL0 outputs disabled), so the RCG
+ * source switch cannot succeed yet. Instead of touching the PLL, use the
+ * CCI clock that is already running (XO/div1, 19.2 MHz) with the upstream
+ * driver's own 19.2 MHz timing table, and attempt chip-ID reads.
+ *
+ * Writes ONLY: CCI0 branch CBCR (as w2), CCI0 timing registers
+ * (SCL/SDA/MISC_CTL for M0 and M1), CCI queue/IRQ/RESET registers,
+ * then restores everything in reverse. No PLL / RCG / rail / GPIO /
+ * sensor register write beyond the chip-ID read itself.
+ *
+ * Targets (from CAMERA_C2B_VENDOR_SENSOR_INPUTS.md):
+ *   CCI0 M0 (master 0): tele s5khpe   slave 0x5a  expect 0x1b7e
+ *   CCI0 M1 (master 1): wide ovx10500u slave 0x20 expect 0x5058
+ * Chip-ID register assumed 0x0000 (16-bit, common convention; s5kjn5
+ * upstream driver confirms CCI_REG16(0x0000)).
+ */
+#define PC_CCI_RESET_CMD        0x004u
+#define PC_CCI_RESET_CMD_MASK   0x0f73f3f7u
+#define PC_CCI_QUEUE_START      0x008u
+#define PC_CCI_HALT_REQ         0x034u
+#define PC_CCI_SDA_CTL_1(m)     (0x108u + 0x100u * (m))
+#define PC_CCI_SDA_CTL_2(m)     (0x10cu + 0x100u * (m))
+#define PC_CCI_MISC_CTL(m)      (0x110u + 0x100u * (m))
+#define PC_CCI_READ_DATA(m)     (0x118u + 0x100u * (m))
+
+
+#define PC_CCI_IRQ_GLOBAL_CLEAR_CMD 0xc00u
+#define PC_CCI_IRQ_CLEAR_0          0xc08u
+#define PC_CCI_I2C_SET_PARAM    1u
+#define PC_CCI_I2C_REPORT       8u
+#define PC_CCI_I2C_WRITE        9u
+#define PC_CCI_I2C_READ         10u
+#define PC_CCI_I2C_REPORT_IRQ_EN 0x100u
+#define PC_CCI_I2C_LOCK         6u   /* vendor cam_cci: queue LOCK  (seen 0x510:0x6) */
+#define PC_CCI_I2C_UNLOCK       7u   /* vendor cam_cci: queue UNLOCK(seen 0x510:0x7) */
+
+
+/* 19.2 MHz Standard-mode timing (i2c-qcom-cci.c cci_hw_params[19.2][STD]). */
+#define PC_T_THIGH   78u
+#define PC_T_TLOW    114u
+#define PC_T_SSU_STO 28u
+#define PC_T_SSU_STA 28u
+#define PC_T_THD_DAT 10u
+#define PC_T_THD_STA 77u
+#define PC_T_TBUF    118u
+#define PC_T_TRDHLD  6u
+#define PC_T_TSP     1u
+
+static uint32_t
+pc_cci_load_word(uint32_t b0, uint32_t b1, uint32_t b2, uint32_t b3)
+{
+	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
+}
+
+/* Wait for a CCI IRQ status bit (bounded poll). Returns 0 on success. */
+static uint32_t pc_cci_last_irq;	/* last IRQ_STATUS seen by any wait (diag) */
+static int
+pc_cci_wait_irq(vm_offset_t cci, uint32_t mask)
+{
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		uint32_t s = pc_rd(cci, PC_CCI_IRQ_STATUS_0);
+		pc_cci_last_irq = s;
+		if (s & mask) {
+			/* clear: global clear + W1C */
+			pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+			pc_wr(cci, PC_CCI_IRQ_CLEAR_0, s & mask);
+			return 0;
+		}
+		pc_sleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* Issue a 2-byte register read (reg 0x0000) on the given CCI master.
+ * Uses QUEUE_0 for the register-address write, QUEUE_1 for the data read.
+ * Returns 0 on success and stores the 16-bit big-endian value in *out. */
+static int
+pc_cci_read_reg16(vm_offset_t cci, unsigned master, uint8_t slave,
+    uint16_t *out)
+{
+	uint32_t v, cur, buf;
+	int ret;
+	unsigned words;
+
+	/* --- write: set register address 0x0000 (2 bytes) --- */
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+	/* WRITE cmd + 2 data bytes (0x00,0x00) packed into one word */
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	/* REPORT with IRQ */
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 0));
+	printf("PANDORA CAMERA: w7 M%u write cur_words=%u slave=%#x\n",
+	    master, cur, slave);
+	if (cur == 0 || cur > 32u) {
+		printf("PANDORA CAMERA: w7 M%u write queue empty/overflow\n", master);
+		return EINVAL;
+	}
+	pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 0), cur);
+	pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 0u));
+	ret = pc_cci_wait_irq(cci, 1u << (4u + master * 12u));  /* Q0: M0=BIT(4),M1=BIT(16) */
+	if (ret != 0) {
+		printf("PANDORA CAMERA: w7 M%u write IRQ timeout (status=%#x)\n",
+		    master, pc_rd(cci, PC_CCI_IRQ_STATUS_0));
+		return ret;
+	}
+	v = pc_rd(cci, PC_CCI_Qn_REPORT_STATUS(master, 0));
+	printf("PANDORA CAMERA: w7 M%u write report_status=%#x\n", master, v);
+
+	/* --- read: 2 bytes from current register pointer --- */
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+	    PC_CCI_I2C_READ | (2u << 4));
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 1));
+	printf("PANDORA CAMERA: w7 M%u read cur_words=%u\n", master, cur);
+	if (cur == 0 || cur > 32u) {
+		printf("PANDORA CAMERA: w7 M%u read queue empty/overflow\n", master);
+		return EINVAL;
+	}
+	pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 1), cur);
+	pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 1u));
+	ret = pc_cci_wait_irq(cci, 1u << (8u + master * 12u));  /* Q1: M0=BIT(8),M1=BIT(20) */
+	if (ret != 0) {
+		printf("PANDORA CAMERA: w7 M%u read IRQ timeout (status=%#x)\n",
+		    master, pc_rd(cci, PC_CCI_IRQ_STATUS_0));
+		return ret;
+	}
+	v = pc_rd(cci, PC_CCI_Qn_REPORT_STATUS(master, 1));
+	words = pc_rd(cci, PC_CCI_READ_BUF_LEVEL(master));
+	buf = words ? pc_rd(cci, PC_CCI_READ_DATA(master)) : 0;
+	printf("PANDORA CAMERA: w7 M%u read report_status=%#x buf_level=%u "
+	    "read_data=%#x\n", master, v, words, buf);
+	/* read_data layout: first byte is status, following bytes are payload */
+	if (words >= 1) {
+		*out = (uint16_t)(((buf >> 8) & 0xffu) << 8) | (uint16_t)((buf >> 16) & 0xffu);
+		/* bytes: [0]=status,[1]=first data,[2]=second data in little-endian word */
+		*out = (uint16_t)((buf >> 8) & 0xffu) | (uint16_t)(((buf >> 16) & 0xffu) << 8);
+		return 0;
+	}
+	return EIO;
+}
+
+static void __unused
+pc_w7_i2c_probe(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint32_t scl0, sda0_0, sda1_0, sda2_0, misc0;
+	uint32_t scl1, sda0_1, sda1_1, sda2_1, misc1;
+	uint16_t id;
+	int ret;
+	bool branch_up = false;
+
+	if (!pc_camcc || !pc_cci[0]) {
+		printf("PANDORA CAMERA: C-2b-w7 skipped (camcc or cci unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w7 I2C probe (XO/div1 timing, no PLL write) "
+	    "before: cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x\n",
+	    cbcr_before, cmd_before, cfg_before);
+
+	/* 1. branch on */
+	pc_step("w7 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	branch_up = (pc_wait_branch_on("w7", PC_CCI0_CBCR) == 0);
+	if (!branch_up) {
+		printf("PANDORA CAMERA: C-2b-w7 branch did NOT come up; abort\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+
+	/* 2. save original timing */
+	scl0   = pc_rd(pc_cci[0], PC_CCI_SCL_CTL(0));
+	sda0_0 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_0(0));
+	sda1_0 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_1(0));
+	sda2_0 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_2(0));
+	misc0  = pc_rd(pc_cci[0], PC_CCI_MISC_CTL(0));
+	scl1   = pc_rd(pc_cci[0], PC_CCI_SCL_CTL(1));
+	sda0_1 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_0(1));
+	sda1_1 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_1(1));
+	sda2_1 = pc_rd(pc_cci[0], PC_CCI_SDA_CTL_2(1));
+	misc1  = pc_rd(pc_cci[0], PC_CCI_MISC_CTL(1));
+	printf("PANDORA CAMERA: w7 timing before: M0 scl=%#x sda0=%#x sda1=%#x "
+	    "sda2=%#x misc=%#x\n", scl0, sda0_0, sda1_0, sda2_0, misc0);
+	printf("PANDORA CAMERA: w7 timing before: M1 scl=%#x sda0=%#x sda1=%#x "
+	    "sda2=%#x misc=%#x\n", scl1, sda0_1, sda1_1, sda2_1, misc1);
+
+	/* 3. write 19.2 MHz Standard timing to M0 and M1 */
+	pc_step("w7 timing write", PC_CCI_PA(0) + PC_CCI_SCL_CTL(0));
+	for (unsigned m = 0; m < 2; m++) {
+		pc_wr(pc_cci[0], PC_CCI_SCL_CTL(m),
+		    PC_T_THIGH << 16 | PC_T_TLOW);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(m),
+		    PC_T_SSU_STO << 16 | PC_T_SSU_STA);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(m),
+		    PC_T_THD_DAT << 16 | PC_T_THD_STA);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(m), PC_T_TBUF);
+		pc_wr(pc_cci[0], PC_CCI_MISC_CTL(m),
+		    0x100u | PC_T_TRDHLD << 4 | PC_T_TSP);  /* SCL_STRETCH_EN */
+	}
+	printf("PANDORA CAMERA: w7 timing written: scl=%#x sda0=%#x sda1=%#x "
+	    "sda2=%#x misc=%#x (19.2MHz Standard)\n",
+	    PC_T_THIGH << 16 | PC_T_TLOW, PC_T_SSU_STO << 16 | PC_T_SSU_STA,
+	    PC_T_THD_DAT << 16 | PC_T_THD_STA, PC_T_TBUF,
+	    0x100u | PC_T_TRDHLD << 4 | PC_T_TSP);
+
+	/* 4. enable report IRQs */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u);
+	/* CCI controller reset (mirrors cci_reset() in i2c-qcom-cci.c):
+	 * write RESET_CMD_MASK, poll IRQ_STATUS_0 for RST_DONE_ACK (BIT 24). */
+	{
+		uint32_t rst_st;
+		pc_step("w7 CCI reset", PC_CCI_PA(0) + PC_CCI_RESET_CMD);
+		pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24)) {
+				printf("PANDORA CAMERA: w7 CCI reset done (status=%#x)\n",
+				    rst_st);
+				break;
+			}
+			pc_sleep(1);
+		}
+		if (!(rst_st & PC_BIT(24))) {
+			printf("PANDORA CAMERA: w7 CCI reset ACK timeout (status=%#x) "
+			    "continuing anyway\n", rst_st);
+		}
+	}
+	/* clear stale status via global clear + W1C */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_STATUS_0, 0xffffffffu);
+
+	/* 5. try chip-ID reads */
+	{
+		static const struct {
+			unsigned master;
+			uint8_t slave;
+			uint16_t expect;
+			const char *name;
+		} tgts[] = {
+			{ 0, 0x5a, 0x1b7e, "tele s5khpe" },
+			{ 1, 0x20, 0x5058, "wide ovx10500u" },
+		};
+		for (unsigned t = 0; t < sizeof(tgts) / sizeof(tgts[0]); t++) {
+			printf("PANDORA CAMERA: w7 try M%u slave=%#x (%s) "
+			    "expect=%#x\n", tgts[t].master, tgts[t].slave,
+			    tgts[t].name, tgts[t].expect);
+			id = 0;
+			ret = pc_cci_read_reg16(pc_cci[0], tgts[t].master,
+			    tgts[t].slave, &id);
+			if (ret == 0 && id == tgts[t].expect) {
+				printf("PANDORA CAMERA: w7 M%u %s -> CHIP ID MATCH "
+				    "(%#x)\n", tgts[t].master, tgts[t].name, id);
+			} else if (ret == 0) {
+				printf("PANDORA CAMERA: w7 M%u %s -> chip_id=%#x "
+				    "(expect %#x) MISMATCH\n", tgts[t].master,
+				    tgts[t].name, id, tgts[t].expect);
+			} else {
+				printf("PANDORA CAMERA: w7 M%u %s -> no response "
+				    "(ret=%d) NACK/timeout\n", tgts[t].master,
+				    tgts[t].name, ret);
+			}
+		}
+	}
+
+	/* 6. restore timing */
+	pc_step("w7 timing restore", PC_CCI_PA(0) + PC_CCI_SCL_CTL(0));
+	pc_wr(pc_cci[0], PC_CCI_SCL_CTL(0), scl0);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(0), sda0_0);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(0), sda1_0);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(0), sda2_0);
+	pc_wr(pc_cci[0], PC_CCI_MISC_CTL(0), misc0);
+	pc_wr(pc_cci[0], PC_CCI_SCL_CTL(1), scl1);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(1), sda0_1);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(1), sda1_1);
+	pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(1), sda2_1);
+	pc_wr(pc_cci[0], PC_CCI_MISC_CTL(1), misc1);
+
+	/* 7. branch off */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	cmd_before = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w7 cleanup: cbcr=%#x cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x (RCG untouched by w7)\n",
+	    pc_rd(pc_camcc, PC_CCI0_CBCR), cmd_before, cfg_before);
+	printf("PANDORA CAMERA: C-2b-w7 result: branch_up=yes "
+	    "(timing + I2C queue probe done, no PLL write)\n");
+}
+
+/* pandora_adsp.c exports pandora_rpmh_resource(name, offset, value).
+ * offset 0 = voltage mV, offset 4 = enable, offset 8 = mode. */
+extern int pandora_rpmh_resource(const char *, uint32_t, uint32_t);
+
+/* TLMM GPIO write (replicates pt_gpio in pandora_touch.c exactly).
+ * n = pin, func = 0 for GPIO, pull = 0/1/2, ma = drive in mA, out = 0/1/-1. */
+static void
+pc_gpio_set(unsigned n, unsigned func, unsigned pull, unsigned ma, int out)
+{
+	uint32_t ctl;
+	if (out >= 0) {
+		pc_wr(pc_tlmm, PC_GPIO(n) + 4, out ? 2u : 0u);
+	}
+	ctl = pc_rd(pc_tlmm, PC_GPIO(n)) & ~0x3ffu;
+	ctl |= pull | (func << 2) | ((ma / 2 - 1) << 6) | (out >= 0 ? 0x200u : 0u);
+	if (ctl & (1u << 11)) {
+		ctl |= 1u << 12;
+	}
+	pc_wr(pc_tlmm, PC_GPIO(n), ctl);
+}
+
+/* C-2b-w23: bit-bang I2C on the TLMM pads, bypassing the CCI controller.
+ * Ten rounds of register-level fixes (reset, pinmux, timing, MCLK, voltages,
+ * PLL0, tele GPIOs) all took effect but the controller still reports NACK on
+ * every address. NACK only means "no device drove SDA low on the 9th clock".
+ * So drive SDA/SCL as open-drain GPIOs and look for an ACK directly on the
+ * wire: if a slave ACKs here the fault is CCI configuration; if none does,
+ * the fault is sensor power / clock / pin mapping (or the pads are not the
+ * ones the sensor is wired to). Read-only towards the sensor: address byte
+ * plus STOP, no register writes. */
+static void
+pc_bb_set(unsigned n, int high)
+{
+	/* high = release the pad (input + internal pull-up); low = drive 0 */
+	if (high)
+		pc_gpio_set(n, 0, 3, 2, -1); /* func=0 GPIO, no OE, pull-up */
+	else
+		pc_gpio_set(n, 0, 0, 2, 0);  /* func=0 GPIO, OE, output low */
+}
+
+/* C-2b-w24: verify whether w23's scattered ACKs are real devices.
+ * w23 saw 10 ACKs but they included reserved address 0x0c, the DT sensor
+ * addresses (0x20 wide / 0x5a tele) were absent, and 0x10 ACKed under GPIO
+ * while the CCI controller reported NACK for the same address. Decide with:
+ *   (1) a no-START control: release SDA, toggle SCL 9x, SDA must stay high;
+ *   (2) pre/post sampling around the 9th SCL rising edge -- a real slave
+ *       drives SDA low only after the clock edge (pre=1, post=0), whereas a
+ *       slow pull-up shows pre=0 already;
+ *   (3) three full sweeps: a real device ACKs at the same address every time.
+ * Longer settle times than w23 (3 ms) to rule out rise-time artifacts. */
+static void
+pc_bb_probe(unsigned sda, unsigned scl, const char *tag,
+    const uint8_t *addrs, unsigned naddrs)
+{
+	unsigned round;
+
+	pc_bb_set(sda, 1);
+	pc_bb_set(scl, 1);
+	pc_sleep(5);
+	printf("PANDORA CAMERA: w26 %s idle SDA=%#x SCL=%#x\n", tag,
+	    pc_rd(pc_tlmm, PC_GPIO(sda) + 4), pc_rd(pc_tlmm, PC_GPIO(scl) + 4));
+
+	/* Control A: no START, no address, SDA released for 9 clocks.
+	 * SDA must stay high the whole time. Any low here means the bus is
+	 * floating / weakly pulled and every following "ACK" is bogus. */
+	{
+		unsigned lows = 0;
+		for (unsigned i = 0; i < 9; i++) {
+			pc_bb_set(scl, 0);
+			pc_sleep(3);
+			pc_bb_set(scl, 1);
+			pc_sleep(3);
+			if ((pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u) == 0)
+				lows++;
+		}
+		pc_bb_set(scl, 0);
+		pc_sleep(3);
+		printf("PANDORA CAMERA: w26 %s CONTROL(no START): %u/9 low samples "
+		    "(expect 0)\n", tag, lows);
+	}
+
+	for (round = 0; round < 3; round++) {
+		unsigned hits = 0, pre_low = 0;
+		for (unsigned ai = 0; ai < naddrs; ai++) {
+			unsigned a = addrs[ai];
+			uint8_t byte = (uint8_t)(a << 1); /* write direction */
+			uint32_t pre, post, bus_free;
+
+			/* START: SDA falls while SCL is high */
+			pc_bb_set(sda, 0);
+			pc_sleep(3);
+			pc_bb_set(scl, 0);
+			pc_sleep(3);
+
+			for (int i = 7; i >= 0; i--) {
+				pc_bb_set(sda, (byte >> i) & 1u);
+				pc_sleep(3);
+				pc_bb_set(scl, 1);
+				pc_sleep(3);
+				pc_bb_set(scl, 0);
+				pc_sleep(3);
+			}
+
+			/* 9th clock (ACK). NOTE: a real slave starts driving SDA low
+			 * right after the 8th falling edge, i.e. BEFORE the 9th rising
+			 * edge -- so pre=0 is the NORMAL electrical signature of an
+			 * ACK, not a pull-up failure. w24 mislabelled this. */
+			pc_bb_set(sda, 1);
+			pc_sleep(3);
+			pre = pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u;
+			pc_bb_set(scl, 1);
+			pc_sleep(3);
+			post = pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u;
+			pc_bb_set(scl, 0);
+			pc_sleep(3);
+
+			/* STOP. w25 clocked out an extra data byte here and left SDA
+			 * pinned low, so every later address (including the 0x08/0x77
+			 * controls) read back post=0. Do NOT add clocks past the ACK. */
+			pc_bb_set(sda, 0);
+			pc_sleep(3);
+			pc_bb_set(scl, 1);
+			pc_sleep(3);
+			pc_bb_set(sda, 1);
+			pc_sleep(3);
+			bus_free = pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u;
+
+			if (pre == 0)
+				pre_low++;
+			if (post == 0) {
+				hits++;
+				printf("PANDORA CAMERA: w26 %s r%u addr=%#x post=0 pre=%u "
+				    "bus_free=%u %s\n", tag, round, a, pre,
+				    bus_free,
+				    bus_free == 1u ? "ACK_BUS_RELEASED" : "STUCK_LOW");
+			}
+		}
+		printf("PANDORA CAMERA: w26 %s round %u done: %u post=0 hits, "
+		    "%u pre=0 (normal for ACK)\n", tag, round, hits, pre_low);
+	}
+}
+
+/* C-2b-w28: bring CAMCC PLL0 up per upstream camcc-kaanapali.c
+ * cam_cc_pll0_config, then switch the CCI0 RCG from XO/19.2MHz to
+ * PLL0_OUT_EVEN/16 = 37.5MHz. That is what the working Android camera uses
+ * (clk_summary measured 37500000). w5 failed only because PLL0 outputs were
+ * gated; here we enable the PLL first. CMD_UPDATE timeout rolls CFG back and
+ * continues on XO instead of aborting.
+ */
+static int
+pc_cci_clk_37mhz(void)
+{
+	uint32_t cfg0, cmd, st, mode0, opmode0;
+	unsigned i;
+
+	/* Idempotent guard: the probe bringup already configures PLL0+CCI0,
+	 * and pc_sensor_power_up() calls this a second time. The w35 log proved
+	 * that re-running the full sequence on a LIVE clock tree kills CCI0:
+	 * re-writing PLL0 config/L/alpha while it feeds CCI0 glitches the PLL,
+	 * after which queue loads read back CUR_WORD_CNT=0 and IRQ stays 0
+	 * (all CCI register writes dropped) while the 0.4s probe reads worked.
+	 * If the tree is already in the 37.5 MHz state, leave it untouched. */
+	{
+		uint32_t mode = pc_rd(pc_camcc, 0x00);
+		uint32_t opmode = pc_rd(pc_camcc, 0x04);
+		if ((opmode & 0x1u) && ((mode & 0x5u) == 0x5u) &&
+		    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR) == 0x0010021fu &&
+		    (pc_rd(pc_camcc, PC_CCI0_CBCR) & PC_CBCR_ENABLE) != 0) {
+			printf("PANDORA CAMERA: clk37 already configured "
+			    "(mode=%#x opmode=%#x), skip reconfig\n", mode, opmode);
+			return 1;
+		}
+	}
+
+	mode0 = pc_rd(pc_camcc, 0x00);
+	opmode0 = pc_rd(pc_camcc, 0x04);
+	cfg0 = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: w28 CCI0 BEFORE cfg=%#x cmd=%#x cbcr=%#x\n",
+	    cfg0, pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_CBCR));
+	printf("PANDORA CAMERA: w28 PLL0 BEFORE mode=%#x opmode=%#x status=%#x "
+	    "l=%#x alpha=%#x user=%#x cfgctl=%#x\n",
+	    pc_rd(pc_camcc, 0x00), pc_rd(pc_camcc, 0x04), pc_rd(pc_camcc, 0x0c),
+	    pc_rd(pc_camcc, 0x10), pc_rd(pc_camcc, 0x14), pc_rd(pc_camcc, 0x18),
+	    pc_rd(pc_camcc, 0x20));
+
+	/* cam_cc_pll0_config: 1200 MHz, TAYCAN_EKO_T register offsets.
+	 * Skip entirely if the PLL is already running: rewriting config/L/alpha
+	 * on a live PLL that already feeds CCI0 risks glitching it (w35 suspect),
+	 * and the running values below match what we would write anyway. The
+	 * RCG switch + CBCR enable after this block are still needed because the
+	 * probe rollback parks CMD_RCGR and clears the CCI0 branch enable. */
+	if (!((pc_rd(pc_camcc, 0x04) & 0x1u) &&
+	    ((pc_rd(pc_camcc, 0x00) & 0x5u) == 0x5u))) {
+		pc_wr(pc_camcc, 0x20, 0x25c400e7u);
+		pc_wr(pc_camcc, 0x24, 0x0a8062e0u);
+		pc_wr(pc_camcc, 0x28, 0xf51dea20u);
+		pc_wr(pc_camcc, 0x10, 0x0044003eu); /* Android running: cal_l<<16 | l=0x3e */
+		pc_wr(pc_camcc, 0x14, 0x8000u);
+		pc_wr(pc_camcc, 0x18, 0x840fu);  /* Android running: PLL_OUT_MASK=0x7 */
+		pc_wr(pc_camcc, 0x1c, 0x2u);
+		/* w29: TAYCAN exposes PLL_STATUS_00..31; 0x0c is NOT a single lock
+		 * register, so the w28c BIT(31) poll was reading the wrong object.
+		 * Upstream trion_pll_is_enabled() = OPMODE.RUN && MODE.OUTCTRL.
+		 * Android running: MODE low bits = 0x5 (OUTCTRL|RESET_N), OPMODE=1. */
+		pc_wr(pc_camcc, 0x04, 0x1u);   /* OPMODE: PLL_RUN */
+		for (i = 0; i < 20; i++)
+			pc_sleep(1);
+		pc_wr(pc_camcc, 0x00, pc_rd(pc_camcc, 0x00) | 0x5u);
+	}
+	st = pc_rd(pc_camcc, 0x0c);
+	{
+		uint32_t mode = pc_rd(pc_camcc, 0x00);
+		uint32_t opmode = pc_rd(pc_camcc, 0x04);
+		printf("PANDORA CAMERA: w29 PLL0 AFTER mode=%#x opmode=%#x state=%#x "
+		    "status=%#x l=%#x user=%#x enabled=%s\n",
+		    mode, opmode, pc_rd(pc_camcc, 0x08), st,
+		    pc_rd(pc_camcc, 0x10), pc_rd(pc_camcc, 0x18),
+		    ((opmode & 0x1u) && (mode & 0x1u)) ? "YES" : "NO");
+		if (!((opmode & 0x1u) && (mode & 0x1u))) {
+			pc_wr(pc_camcc, 0x00, mode0);
+			pc_wr(pc_camcc, 0x04, opmode0);
+			printf("PANDORA CAMERA: w29 PLL0 NOT ENABLED -> restored mode=%#x opmode=%#x\n",
+			    mode0, opmode0);
+			return 0;
+		}
+	}
+
+	/* SRC_SEL=2 (PLL0_OUT_EVEN), SRC_DIV=16, HW_CLK_CTRL BIT(20) */
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, 0x0010021fu); /* Android running value */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, 0x1u); /* UPDATE only; no ROOT_EN left set */
+	for (i = 0; i < 100; i++) {
+		cmd = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		if (!(cmd & 0x1u))
+			break;
+		pc_sleep(1);
+	}
+	printf("PANDORA CAMERA: w29 CCI0 AFTER cfg=%#x cmd=%#x polls=%u -> %s\n",
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), cmd, i,
+	    (cmd & 0x1u) ? "NOT_SWITCHED(CFG rolled back)" : "SWITCHED_37P5MHZ");
+	if (cmd & 0x1u)
+		pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg0);
+	pc_wr(pc_camcc, PC_CCI0_CBCR,
+	    pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	return (cmd & 0x1u) ? 0 : 1; /* 1 = CCI core is now 37.5 MHz */
+}
+
+/* C-2b-w25: trace the physical pads while the CCI controller runs a
+ * transaction. GPIO bit-bang reaches devices on gpio109-112, yet the CCI
+ * controller reports NACK on every address for 12 rounds. If CCI is really
+ * wired to these pads (func=1), SDA/SCL must toggle during a transaction.
+ * If they stay static, either func=1 is not the CCI0 I2C mux value or the
+ * CCI core clock never started -- that would explain the discrepancy without
+ * blaming sensor power. TLMM GPIO_IN reflects the pad level regardless of
+ * the pin's function select, so this is a valid observation. */
+static void
+pc_cci_pad_trace(unsigned m, uint8_t slave)
+{
+	uint32_t sda = (m == 0) ? 109u : 111u;
+	uint32_t scl = (m == 0) ? 110u : 112u;
+	unsigned i;
+	uint32_t ps = 2, pc = 2, s, c, exec;
+	unsigned base_lo = 0, base_tog = 0;
+	unsigned run_sda_lo = 0, run_scl_lo = 0, run_sda_tog = 0, run_scl_tog = 0;
+
+	/* Baseline: bus idle, no transaction. */
+	ps = pc = 2;
+	for (i = 0; i < 2048; i++) {
+		s = pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u;
+		c = pc_rd(pc_tlmm, PC_GPIO(scl) + 4) & 1u;
+		if (c == 0) base_lo++;
+		if (ps != 2 && s != ps) base_tog++;
+		if (pc != 2 && c != pc) base_tog++;
+		ps = s; pc = c;
+	}
+	printf("PANDORA CAMERA: w25 PAD TRACE baseline M%u: scl_low=%u "
+	    "toggles=%u (expect 0/0)\n", m, base_lo, base_tog);
+
+	/* Queue a minimal one-byte WRITE to <slave> and watch the wires. */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (1u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	exec = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), exec);
+
+	ps = pc = 2;
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u + 0u));
+	for (i = 0; i < 4096; i++) {
+		s = pc_rd(pc_tlmm, PC_GPIO(sda) + 4) & 1u;
+		c = pc_rd(pc_tlmm, PC_GPIO(scl) + 4) & 1u;
+		if (s == 0) run_sda_lo++;
+		if (c == 0) run_scl_lo++;
+		if (ps != 2 && s != ps) run_sda_tog++;
+		if (pc != 2 && c != pc) run_scl_tog++;
+		ps = s; pc = c;
+	}
+	printf("PANDORA CAMERA: w25 PAD TRACE active M%u addr=%#x: "
+	    "sda_low=%u scl_low=%u sda_tog=%u scl_tog=%u irq=%#x\n",
+	    m, slave, run_sda_lo, run_scl_lo, run_sda_tog, run_scl_tog,
+	    pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0));
+	printf("PANDORA CAMERA: w25 PAD TRACE verdict: %s\n",
+	    (run_scl_tog > 2 || run_sda_tog > 2) ?
+	    "CCI IS DRIVING THESE PADS" : "CCI NOT DRIVING THESE PADS (mux/clock)");
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+}
+
+/* C-2b-w26: w25 proved the CCI controller IS driving gpio111/112
+ * (active scl_tog=38 vs baseline 0), and a minimal 1-byte WRITE to 0x10
+ * finished with irq=0x10000 = M1_Q0_REPORT and NO NACK bit. The very same
+ * address in the scan reports BIT(29) NACK with cur_cmd=0x2a, which is
+ * exactly CCI_I2C_READ(10)|(2<<4). So the NACK lives in the READ stage,
+ * not in the address byte or sensor power. Compare two transaction shapes
+ * on identical addresses in a single boot.
+ */
+/* C-2b-w27: w26 proved a CCI NACK halts the engine -- after the first
+ * NACK every later transaction timed out (irq=0) and CUR_WORD_CNT kept
+ * accumulating (3,4,6,9,12,15). The w16..w25 scan loops only cleared IRQ
+ * between addresses, never reset the engine, so those "7 addresses all
+ * NACK" results were NOT independent probes. Reset before EVERY transaction.
+ */
+static void
+pc_cci_reset_engine(void)
+{
+	uint32_t st = 0;
+	unsigned i;
+
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	for (i = 0; i < 20; i++) {
+		st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		if (st & PC_BIT(24)) /* RST_DONE_ACK */
+			break;
+		pc_sleep(1);
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+}
+
+/* w31: vendor CCI queue shape matrix.
+ * Android cam_cci debug log (CAMERA_C2B_ANDROID_CCI_QUEUE.md) shows EVERY
+ * transaction is a 5-word queue wrapped in LOCK(0x6)/UNLOCK(0x7): pure writes
+ * on Q0, read-with-address on Q1, and cam_cci_set_clk_param() rewrites the
+ * timing registers before EACH transaction. w1..w30 had neither the
+ * LOCK/UNLOCK words nor per-transaction timing refresh.
+ * One boot runs Q0/Q1 x lock/no-lock so we discriminate a whole shape class
+ * instead of betting on a single guess. */
+static void
+pc_cci_refresh_timing(int clk37)
+{
+	static const uint32_t tim_19[5] = {
+		78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u
+	};
+	static const uint32_t tim_37[5] = {
+		201u << 16 | 174u, 204u << 16 | 231u, 22u << 16 | 162u, 227u, 0x163u
+	};
+	const uint32_t *t = clk37 ? tim_37 : tim_19;
+	unsigned mm;
+
+	for (mm = 0; mm < 2; mm++) {
+		pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), t[0]);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), t[1]);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), t[2]);
+		pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), t[3]);
+		pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), t[4]);
+	}
+}
+
+/* Stage D driver helpers.
+ * w31..w33 proved the CCI0 sensors answer ONLY when every transaction is
+ * preceded by pc_cci_reset_engine() + pc_cci_refresh_timing(). That fix
+ * lived in the probe blocks; these helpers move it into the normal driver
+ * read/write path so a real sensor init table can talk to the parts without
+ * re-implementing the reset+timing dance at every call site.
+ * CCI core is 37.5 MHz (Android running state; DT clock-rates 37500000). */
+
+/* Generalized register write used by the init-table replay. reg is always a
+ * 16-bit address (2 bytes on the bus); data_bytes is 1 (8-bit data) or 2
+ * (16-bit data). Every transaction does the per-sensor reset+timing refresh. */
+static int
+pc_cci_write_reg(vm_offset_t cci, unsigned master, uint8_t slave,
+    uint16_t reg, uint16_t val, unsigned data_bytes)
+{
+	uint32_t cur;
+	int ret;
+
+	pc_cci_reset_engine();
+	pc_cci_refresh_timing(1);	/* 37.5 MHz, verified talking to sensors */
+	pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* Q0: SET_PARAM(select slave) + ONE WRITE word carrying the 2-byte register
+	 * address AND the data + REPORT.
+	 * SET_PARAM is mandatory: without it the engine has no target address and
+	 * every write times out (w35-apply: applied=0 fails=14376 ret=60).
+	 *
+	 * The v5 reset probe proved the old two-WRITE shape never reached the
+	 * sensor: writing 0x0103=1 left PLL 0x0301 at 0x40 and 0x0103 at 0.
+	 * mainline i2c-qcom-cci.c `cci_i2c_write()` puts the caller's whole buffer
+	 * (register address bytes + data bytes) behind a SINGLE `CCI_I2C_WRITE |
+	 * len << 4` word, so the 2+1 and 2+2 cases are one transaction here too.
+	 * The old code emitted WRITE(2)/WRITE(1), i.e. two separate transactions:
+	 * the data byte was taken as a new register pointer and nothing was
+	 * written. This is the central fix; the read path was already correct. */
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+	if (data_bytes >= 2u) {
+		/* 4 data bytes: cmd + 3 bytes in word0, the last byte in word1. */
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (4u << 4),
+		        (uint32_t)(reg >> 8) & 0xffu, (uint32_t)reg & 0xffu,
+		        (uint32_t)(val >> 8) & 0xffu));
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    (uint32_t)val & 0xffu);
+	} else {
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (3u << 4),
+		        (uint32_t)(reg >> 8) & 0xffu, (uint32_t)reg & 0xffu,
+		        (uint32_t)val & 0xffu));
+	}
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 0));
+	if (cur == 0 || cur > 32u) {
+		printf("PANDORA CAMERA: cci_write M%u queue empty/overflow\n", master);
+		return EINVAL;
+	}
+	pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 0), cur);
+	pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 0u));
+	ret = pc_cci_wait_irq(cci, 1u << (4u + master * 12u));
+	if (ret != 0) {
+		printf("PANDORA CAMERA: cci_write M%u IRQ timeout status=%#x\n",
+		    master, pc_rd(cci, PC_CCI_IRQ_STATUS_0));
+		return ret;
+	}
+	return 0;
+}
+
+/* Read a 16-bit register over CCI0 master, with the per-transaction
+ * reset+timing the sensors require. Stores big-endian value in *out.
+ * Mirrors pc_cci_read_reg16 but owns its timing instead of relying on the
+ * caller, so it is safe to call from the driver bring-up path. */
+static int
+pc_cci_read_reg16_timed(vm_offset_t cci, unsigned master, uint8_t slave,
+    uint16_t reg, uint16_t *out)
+{
+	uint32_t rep0 = 1u << (4u + master * 12u);
+	uint32_t nack0 = 1u << (27u + master * 2u);
+	uint32_t rep1 = 1u << (8u + master * 12u);
+	uint32_t nack1 = 1u << (28u + master * 2u);
+	uint32_t cur, irq, rd, level;
+	unsigned i;
+	int attempt;
+
+	/* Mirror the proven w33 chip-id read: per-transaction reset+timing,
+	 * poll IRQ for REPORT/NACK, lenient cur (diagnose, never bail), 1-byte read.
+	 * The strict cur==0 EINVAL bail was the ret=22 bug after power_up. */
+	for (attempt = 0; attempt < 2; attempt++) {
+		pc_cci_reset_engine();
+		pc_cci_refresh_timing(1);	/* 37.5 MHz, verified talking to sensors */
+		pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+		/* Q0: set 16-bit register address pointer */
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4),
+		        (uint32_t)(reg >> 8) & 0xffu, (uint32_t)reg & 0xffu, 0x00u));
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+		    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+		cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 0));
+		printf("PANDORA CAMERA: rdm M%u reg=%#x Q0 cur=%u try=%d\n",
+		    master, reg, cur, attempt);
+		pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 0), cur);
+		pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 0u));
+		for (i = 0; i < 100; i++) {
+			irq = pc_rd(cci, PC_CCI_IRQ_STATUS_0);
+			if (irq & (rep0 | nack0)) break;
+			pc_sleep(1);
+		}
+		if (!(irq & rep0) || (irq & nack0)) {
+			printf("PANDORA CAMERA: rdm M%u reg=%#x Q0 irq=%#x retry\n",
+			    master, reg, irq);
+			continue;
+		}
+
+		/* Q1: read 1 byte from current register pointer */
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+		    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+		    PC_CCI_I2C_READ | (1u << 4));
+		pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 1),
+		    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+		pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 1));
+		pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 1), cur);
+		pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 1u));
+		for (i = 0; i < 100; i++) {
+			irq = pc_rd(cci, PC_CCI_IRQ_STATUS_0);
+			if (irq & (rep1 | nack1)) break;
+			pc_sleep(1);
+		}
+		level = pc_rd(cci, PC_CCI_READ_BUF_LEVEL(master));
+		rd = level ? pc_rd(cci, PC_CCI_READ_DATA(master)) : 0;
+		printf("PANDORA CAMERA: rdm M%u reg=%#x raw=%#x buf=%u\n",
+		    master, reg, rd, level);
+		pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		if (level >= 1) {
+			/* byte[1] is the data (status prefix in byte[0]) */
+			*out = (uint16_t)((rd >> 8) & 0xffu);
+			return 0;
+		}
+	}
+	return EIO;
+}
+
+static void
+pc_cci_shape_matrix(unsigned m, uint8_t slave, uint16_t reg, int clk37)
+{
+	unsigned shape;
+
+	for (shape = 0; shape < 4; shape++) {
+		unsigned q = (shape & 1u) ? 1u : 0u;
+		int locked = (shape & 2u) ? 1 : 0;
+		uint32_t rep, nack, irq = 0, words, rst, rd, level;
+		unsigned i;
+
+		pc_cci_reset_engine();
+		pc_cci_refresh_timing(clk37);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+		if (locked)
+			pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q), PC_CCI_I2C_LOCK);
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q),
+		    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+		/* w32: real 16-bit register address. Samsung-family chip-ID is at
+		 * 0x0000; OmniVision-family is conventionally at 0x300a. */
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4),
+		        ((uint32_t)reg >> 8) & 0xffu, (uint32_t)reg & 0xffu, 0x00u));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q),
+		    PC_CCI_I2C_READ | (2u << 4));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q),
+		    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+		if (locked)
+			pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, q), PC_CCI_I2C_UNLOCK);
+
+		words = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, q));
+		pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, q), words);
+		pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u + q));
+
+		/* Q0: M0 BIT(4)/M1 BIT(16); Q1: M0 BIT(8)/M1 BIT(20).
+		 * NACK: M0_Q0 BIT(27), M0_Q1 BIT(28), M1_Q0 BIT(29), M1_Q1 BIT(30). */
+		rep  = 1u << (4u + m * 12u + q * 4u);
+		nack = 1u << (27u + m * 2u + q);
+		for (i = 0; i < 100; i++) {
+			irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (irq & (rep | nack))
+				break;
+			pc_sleep(1);
+		}
+		rst = pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, q));
+		level = pc_rd(pc_cci[0], PC_CCI_READ_BUF_LEVEL(m));
+		rd = level ? pc_rd(pc_cci[0], PC_CCI_READ_DATA(m)) : 0;
+		printf("PANDORA CAMERA: w32 S%u M%u Q%u lock=%d addr=%#x reg=%#x "
+		    "words=%u polls=%u irq=%#x report=%#x buf=%u data=%#x -> %s\n",
+		    shape, m, q, locked, slave, reg, words, i, irq, rst, level, rd,
+		    (irq & nack) ? "NACK" : ((irq & rep) ? "DONE_NO_NACK" : "TIMEOUT"));
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+	pc_cci_reset_engine();
+}
+
+/* Pure 1-byte WRITE address probe. No READ, so it cannot be polluted by
+ * the READ-stage NACK. Returns 1 if the queue completed without a NACK. */
+static unsigned
+pc_cci_write_probe(unsigned m, uint8_t slave)
+{
+	uint32_t irq = 0, exec;
+	uint32_t rep = 1u << (4u + m * 12u);   /* Q0 REPORT: M1 = BIT(16) */
+	uint32_t nack = 1u << (27u + m * 2u);  /* Q0 NACK:   M1 = BIT(29) */
+	unsigned i;
+
+	pc_cci_reset_engine();
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (1u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	exec = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), exec);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u));
+	for (i = 0; i < 60; i++) {
+		irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		if (irq & (rep | nack))
+			break;
+		pc_sleep(1);
+	}
+	/* A TIMEOUT also has irq=0, so "no NACK bit" is NOT sufficient.
+	 * Only a real Q0 REPORT with no NACK counts as an ACK. */
+	if (irq & nack)
+		return 0u;
+	if (irq & rep) {
+		printf("PANDORA CAMERA: w27 WRITE-PROBE M%u addr=%#x -> ACK "
+		    "exec=%u polls=%u irq=%#x\n", m, slave, exec, i, irq);
+		return 1u;
+	}
+	printf("PANDORA CAMERA: w27 WRITE-PROBE M%u addr=%#x -> TIMEOUT "
+	    "exec=%u polls=%u irq=%#x\n", m, slave, exec, i, irq);
+	return 0u;
+}
+
+static void
+pc_cci_txn_ab(unsigned m, uint8_t slave)
+{
+	uint32_t irq, exec, rep_q0, nack_q0, rep_q1, nack_q1;
+	unsigned i;
+
+	rep_q0  = 1u << (4u + m * 12u);   /* M1_Q0_REPORT = BIT(16) */
+	nack_q0 = 1u << (27u + m * 2u);   /* M1_Q0_NACK   = BIT(29) */
+	rep_q1  = rep_q0 << 4u;            /* M1_Q1_REPORT = BIT(20) */
+	nack_q1 = nack_q0 << 1u;           /* M1_Q1_NACK   = BIT(30) */
+
+	/* A: minimal 1-byte WRITE on Q0 (identical to w25 pad trace) */
+	pc_cci_reset_engine();
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (1u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	exec = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), exec);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u));
+	for (i = 0; i < 200; i++) {
+		irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		if (irq & (rep_q0 | nack_q0))
+			break;
+		pc_sleep(1);
+	}
+	printf("PANDORA CAMERA: w26 TXN-A min-WRITE1B M%u addr=%#x exec=%u "
+	    "polls=%u irq=%#x -> %s\n", m, slave, exec, i, irq,
+	    (irq & nack_q0) ? "NACK" :
+	    ((irq & rep_q0) ? "DONE_NO_NACK" : "TIMEOUT"));
+
+	/* B: upstream cci_i2c_read() shape - SET_PARAM + READ + REPORT on Q1 */
+	pc_cci_reset_engine();
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+	    PC_CCI_I2C_READ | (2u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	exec = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 1));
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 1), exec);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u + 1u));
+	for (i = 0; i < 200; i++) {
+		irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		if (irq & (rep_q1 | nack_q1))
+			break;
+		pc_sleep(1);
+	}
+	printf("PANDORA CAMERA: w26 TXN-B upstream-READ2B M%u addr=%#x exec=%u "
+	    "polls=%u irq=%#x data=%#x -> %s\n", m, slave, exec, i, irq,
+	    pc_rd(pc_cci[0], PC_CCI_READ_DATA(m)),
+	    (irq & nack_q1) ? "NACK" :
+	    ((irq & rep_q1) ? "DONE_NO_NACK" : "TIMEOUT"));
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+}
+
+/* C-2b-w9: sensor power-up + chip-ID (Path A continuation). */
+/*
+ * C-2b-w11: CCI queue diagnostic. Verifies register writes take effect and
+ * tests minimal vs full queues. No power-up, no sensor writes.
+ */
+static void
+pc_w11_queue_diag(void)
+{
+	uint32_t v, cur, exec_cnt, qs_val;
+	unsigned m = 1;
+
+	if (pc_cci[0] == 0) {
+		printf("PANDORA CAMERA: w11 CCI not mapped, skip\n");
+		return;
+	}
+
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w11", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: w11 branch did NOT come up; abort\n");
+		return;
+	}
+
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	{
+		uint32_t rst_st = 0;
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA CAMERA: w11 CCI reset done (status=%#x)\n", rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+
+	{
+		static const uint32_t timings[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), timings[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), timings[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), timings[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), timings[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), timings[0][4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	printf("PANDORA CAMERA: w11 DIAG timing: SCL=%#x SDA0=%#x MISC=%#x\n",
+	    pc_rd(pc_cci[0], PC_CCI_SCL_CTL(m)),
+	    pc_rd(pc_cci[0], PC_CCI_SDA_CTL_0(m)),
+	    pc_rd(pc_cci[0], PC_CCI_MISC_CTL(m)));
+
+	/* --- Test A: minimal REPORT-only --- */
+	printf("PANDORA CAMERA: w11 TEST A: REPORT-only on M%u\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w11 A cur_word_cnt=%u (expect 1)\n", cur);
+	printf("PANDORA CAMERA: w11 A cur_cmd=%#x\n",
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	exec_cnt = pc_rd(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w11 A exec_word_cnt readback=%u\n", exec_cnt);
+
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+	printf("PANDORA CAMERA: w11 A QUEUE_START w=%#x rb=%#x\n",
+	    qs_val, pc_rd(pc_cci[0], PC_CCI_QUEUE_START));
+
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w11 A IRQ now=%#x\n", v);
+	pc_sleep(2);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w11 A IRQ +2ms=%#x cur_cmd=%#x\n",
+	    v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w11 A wait_irq ret=%d\n", ret);
+		if (ret == 0)
+			printf("PANDORA CAMERA: w11 A report_status=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)));
+	}
+
+	/* Reset between tests */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	pc_sleep(1);
+
+	/* --- Test B: SET_PARAM+WRITE+REPORT --- */
+	printf("PANDORA CAMERA: w11 TEST B: SET_PARAM+WRITE+REPORT on M%u\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | (0x20u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w11 B cur_word_cnt=%u (expect 3)\n", cur);
+	printf("PANDORA CAMERA: w11 B cur_cmd=%#x\n",
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+	printf("PANDORA CAMERA: w11 B QUEUE_START w=%#x rb=%#x\n",
+	    qs_val, pc_rd(pc_cci[0], PC_CCI_QUEUE_START));
+
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w11 B IRQ now=%#x\n", v);
+	pc_sleep(2);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w11 B IRQ +2ms=%#x cur_cmd=%#x\n",
+	    v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w11 B wait_irq ret=%d\n", ret);
+		if (ret == 0)
+			printf("PANDORA CAMERA: w11 B report_status=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)));
+	}
+
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	printf("PANDORA CAMERA: C-2b-w11 result: queue diag done\n");
+}
+
+/*
+ * C-2b-w12: powered CCI queue diagnostic. Power up the sensor first (w9
+ * sequence), then run w11-style queue tests. Also reads I2C SDA/SCL GPIO
+ * pin states before and during the transaction.
+ */
+static void
+pc_w12_powered_diag(void)
+{
+	uint32_t v, cur, qs_val;
+	unsigned m = 1;
+
+	if (pc_cci[0] == 0) {
+		printf("PANDORA CAMERA: w12 CCI not mapped, skip\n");
+		return;
+	}
+
+	/* CCI0 branch on */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w12", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: w12 branch did NOT come up; abort\n");
+		return;
+	}
+
+	/* CCI reset + clear */
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	{
+		uint32_t rst_st = 0;
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA CAMERA: w12 CCI reset done (status=%#x)\n", rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+
+	/* Timing */
+	{
+		static const uint32_t timings[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), timings[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), timings[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), timings[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), timings[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), timings[0][4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* Power up wide sensor (same as w9) */
+	printf("PANDORA CAMERA: w12 RPMh: L5M_E1 1800mV, B1B_E0 3400mV, B2B_E0 2704mV\n");
+	pandora_rpmh_resource("L5M_E1", 0, 1800);
+	pandora_rpmh_resource("L5M_E1", 4, 1);
+	pandora_rpmh_resource("B1B_E0", 0, 3400);
+	pandora_rpmh_resource("B1B_E0", 4, 1);
+	pandora_rpmh_resource("B2B_E0", 0, 2704);
+	pandora_rpmh_resource("B2B_E0", 4, 1);
+	pc_sleep(1);
+
+	printf("PANDORA CAMERA: w12 GPIO: 107=high (wide pwr), 116=high (afvdd)\n");
+	pc_gpio_set(107, 0, 0, 2, 1);
+	pc_gpio_set(116, 0, 0, 2, 1);
+	pc_sleep(1);
+
+	printf("PANDORA CAMERA: w12 GPIO 106=low (reset assert)\n");
+	pc_gpio_set(106, 0, 0, 2, 0);
+	pc_sleep(10);
+
+	printf("PANDORA CAMERA: w12 GPIO 89=cam_mclk (func=1, 8mA)\n");
+	pc_gpio_set(89, 1, 0, 8, -1);
+	pc_sleep(5);
+
+	/* Read I2C SDA/SCL pin state via TLMM GPIO config+in */
+	/* CCI0 I2C pins: SDA=gpio5, SCL=gpio4 (from vendor DT) */
+	printf("PANDORA CAMERA: w12 I2C pin state (before xfer):\n");
+	printf("PANDORA CAMERA: w12   gpio5 SDA cfg=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0005u * 0x1000u), pc_rd(pc_tlmm, 0x0005u * 0x1000u + 0x004u));
+	printf("PANDORA CAMERA: w12   gpio4 SCL cfg=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0004u * 0x1000u), pc_rd(pc_tlmm, 0x0004u * 0x1000u + 0x004u));
+
+	/* Test A: REPORT-only (verify engine works with power) */
+	printf("PANDORA CAMERA: w12 TEST A: REPORT-only on M%u (powered)\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w12 A cur_word_cnt=%u\n", cur);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 A IRQ now=%#x\n", v);
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w12 A wait_irq ret=%d\n", ret);
+	}
+
+	/* Reset between tests */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	pc_sleep(1);
+
+	/* Test B: full SET_PARAM+WRITE+REPORT (powered) */
+	printf("PANDORA CAMERA: w12 TEST B: SET_PARAM+WRITE+REPORT on M%u (powered)\n", m);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | (0x20u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+	cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+	printf("PANDORA CAMERA: w12 B cur_word_cnt=%u\n", cur);
+
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+	qs_val = 1u << (m * 2u + 0u);
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, qs_val);
+
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 B IRQ now=%#x\n", v);
+	pc_sleep(2);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w12 B IRQ +2ms=%#x cur_cmd=%#x\n",
+	    v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+	/* Read I2C pins during transfer */
+	printf("PANDORA CAMERA: w12 I2C pin state (during xfer):\n");
+	printf("PANDORA CAMERA: w12   gpio5 SDA in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0005u * 0x1000u + 0x004u));
+	printf("PANDORA CAMERA: w12   gpio4 SCL in=%#x\n",
+	    pc_rd(pc_tlmm, 0x0004u * 0x1000u + 0x004u));
+
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w12 B wait_irq ret=%d status=%#x\n",
+		    ret, pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0));
+		if (ret == 0)
+			printf("PANDORA CAMERA: w12 B report_status=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)));
+	}
+
+	/* Rollback */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	printf("PANDORA CAMERA: w12 rollback: MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	pc_gpio_set(89, 0, 0, 2, -1);
+	pc_gpio_set(106, 0, 0, 2, 1);
+	pc_gpio_set(107, 0, 0, 2, 0);
+	pc_gpio_set(116, 0, 0, 2, 0);
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	printf("PANDORA CAMERA: C-2b-w12 result: powered diag done\n");
+}
+
+/*
+ * C-2b-w13: pinmux fix + powered I2C chip-ID probe.
+ * w12 proved: engine works (REPORT-only IRQ ok), power works, but WRITE hangs
+ * because CCI I2C pins (gpio 109-112) are in GPIO mode (func=0), not CCI I2C.
+ * w13 configures the pins to CCI I2C function, then runs chip-ID reads.
+ */
+static void
+pc_w13_pinnmux_i2c(void)
+{
+	uint32_t v, cur, ctl;
+	unsigned m = 1; /* CCI0 M1 = wide, slave 0x20 */
+	int clk37 = 0;  /* set by pc_cci_clk_37mhz(); selects the timing table */
+	static const uint8_t cci0_m0[] = {109, 110}; /* SDA, SCL */
+	static const uint8_t cci0_m1[] = {111, 112}; /* SDA, SCL */
+
+	if (pc_cci[0] == 0 || pc_tlmm == 0) {
+		printf("PANDORA CAMERA: w13 CCI/TLMM not mapped, skip\n");
+		return;
+	}
+
+	/* 1. CCI0 branch on */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w13", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: w13 branch did NOT come up; abort\n");
+		return;
+	}
+
+	/* 2. CCI reset */
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	{
+		uint32_t rst_st = 0;
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA CAMERA: w13 CCI reset done (status=%#x)\n", rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+
+	/* 3. Power up sensor - w30: 1:1 mirror of the Android
+	 * cam_sensor_power_up() sequence measured on THIS device with tracefs
+	 * (docs/CAMERA_C2B_ANDROID_POWER_SEQUENCE.md).
+	 *
+	 * Android order: assert resets + park MCLK pins as input -> B2B_E0
+	 *   -> afvdd(116) -> VIO(L5M_E1) -> tele(113 + L3N/L5N)
+	 *   -> MCLK 19.2MHz from XO -> wide(107) -> wide reset release
+	 *   -> tele reset release -> CCI0 37.5MHz -> settle -> I2C.
+	 * Each rail is separated by ~1 ms. MCLK is XO/19.2 MHz with
+	 * CFG_RCGR=0x00100001 / CBCR=0x08000001; Android never enables a
+	 * BDISTM PLL0 (w21..w29 wrongly used 960 MHz / 24 MHz).
+	 */
+	{
+		/* step0: Android drives gpio89/92 as INPUT (OE=0, func=cam_mclk,
+		 * 2 mA, bias-disable) and asserts BOTH resets BEFORE any rail.
+		 * w21..w29 drove them as GPIO outputs (OE=1, 8 mA), which can
+		 * override the clock controller's MCLK output entirely. */
+		/* out=-1 is required: pc_gpio_set() sets CTL OE bit (0x200) for ANY
+		 * out >= 0, including 0. Only -1 leaves OE=0 (input direction). */
+		pc_gpio_set(89, 1, 0, 2, -1);
+		pc_gpio_set(92, 1, 0, 2, -1);
+		pc_gpio_set(106, 0, 0, 2, 0);  /* wide reset assert (low) */
+		pc_gpio_set(105, 0, 0, 2, 0);  /* tele reset assert (low) */
+		printf("PANDORA CAMERA: w30 step0 reset-first: 89ctl=%#x 92ctl=%#x "
+		    "106ctl=%#x 105ctl=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(89)), pc_rd(pc_tlmm, PC_GPIO(92)),
+		    pc_rd(pc_tlmm, PC_GPIO(106)), pc_rd(pc_tlmm, PC_GPIO(105)));
+		pc_sleep(1);
+
+		/* step1: B2B_E0 (bob2) 2704 mV - first rail in Android trace.
+		 * B1B_E0 3400 mV is kept from w22 (already verified healthy). */
+		{
+			int a = pandora_rpmh_resource("B1B_E0", 0, 3400);
+			int b = pandora_rpmh_resource("B1B_E0", 4, 1);
+			int c = pandora_rpmh_resource("B2B_E0", 0, 2704);
+			int d = pandora_rpmh_resource("B2B_E0", 4, 1);
+			printf("PANDORA CAMERA: w30 step1 B1B(%d,%d) B2B(%d,%d)\n",
+			    a, b, c, d);
+		}
+		/* w28/w29 MODE vote kept verbatim (w29 healthy). */
+		{
+			int m1 = pandora_rpmh_resource("L5M_E1", 8, 7);
+			int m2 = pandora_rpmh_resource("B1B_E0", 8, 7);
+			int m3 = pandora_rpmh_resource("B2B_E0", 8, 7);
+			printf("PANDORA CAMERA: w30 step1 MODE ret: L5M=%d B1B=%d B2B=%d\n",
+			    m1, m2, m3);
+		}
+		pc_sleep(1);
+
+		/* step2: wide afvdd gpio116 */
+		pc_gpio_set(116, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step2 afvdd gpio116 ctl=%#x in=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(116)), pc_rd(pc_tlmm, PC_GPIO(116) + 0x4));
+		pc_sleep(1);
+
+		/* step3: VIO L5M_E1 1800 mV */
+		{
+			int a = pandora_rpmh_resource("L5M_E1", 0, 1800);
+			int b = pandora_rpmh_resource("L5M_E1", 4, 1);
+			printf("PANDORA CAMERA: w30 step3 VIO L5M_E1 1800mV ret(%d,%d)\n", a, b);
+		}
+		pc_sleep(1);
+
+		/* step4: tele rails + gpio113 (Android enables n_l3/n_l5 here) */
+		{
+			int a = pandora_rpmh_resource("L3N_E1", 0, 1800);
+			int b = pandora_rpmh_resource("L3N_E1", 4, 1);
+			int c = pandora_rpmh_resource("L5N_E1", 0, 3300);
+			int d = pandora_rpmh_resource("L5N_E1", 4, 1);
+			printf("PANDORA CAMERA: w30 step4 tele RPMh L3N(%d,%d) L5N(%d,%d)\n",
+			    a, b, c, d);
+		}
+		pc_gpio_set(113, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step4 tele vana/vdig gpio113 ctl=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(113)));
+		pc_sleep(1);
+
+		/* step5: MCLK - copy the Android running register values.
+		 * CFG_RCGR=0x00100001 = SRC_SEL 0 (bi_tcxo/XO), SRC_DIV 1,
+		 * HW_CLK_CTRL; CBCR BIT(0) only (upper bits are read-only).
+		 * Offsets from pc_clock_probe(): cmd 4000/4038/4054/4070,
+		 * cbcr 4018/4050/406c/4088. w21's 0x401c was NOT a cmd_rcgr. */
+		{
+			static const uint32_t mclk_cmd[] = { 0x4000u, 0x4038u, 0x4054u, 0x4070u };
+			static const uint32_t mclk_cbcr[] = { 0x4018u, 0x4050u, 0x406cu, 0x4088u };
+			for (unsigned mi = 0; mi < 4; mi++) {
+				uint32_t cmd = mclk_cmd[mi];
+				uint32_t cbcr = mclk_cbcr[mi];
+				printf("PANDORA CAMERA: w30 step5 mclk%u BEFORE cfg=%#x cmd=%#x cbcr=%#x\n",
+				    mi, pc_rd(pc_bdistm, cmd + 4), pc_rd(pc_bdistm, cmd),
+				    pc_rd(pc_bdistm, cbcr));
+				pc_wr(pc_bdistm, cmd + 4, 0x00100001u);
+				/* shared RCG: clear CMD_ROOT_OFF(bit31), then UPDATE(bit0).
+				 * Android running state reads CMD_RCGR=0, so do NOT leave
+				 * ROOT_EN(bit1) set like w21's 0x3 did. */
+				pc_wr(pc_bdistm, cmd, (pc_rd(pc_bdistm, cmd) & ~0x80000000u) | 0x1u);
+				for (unsigned pi = 0; pi < 50; pi++) {
+					if (!(pc_rd(pc_bdistm, cmd) & 0x1u))
+						break;
+					pc_sleep(1);
+				}
+				pc_wr(pc_bdistm, cbcr, pc_rd(pc_bdistm, cbcr) | 0x1u);
+				printf("PANDORA CAMERA: w30 step5 mclk%u AFTER cfg=%#x cmd=%#x "
+				    "cbcr=%#x target cfg=0x100001 cbcr=0x8000001\n",
+				    mi, pc_rd(pc_bdistm, cmd + 4), pc_rd(pc_bdistm, cmd),
+				    pc_rd(pc_bdistm, cbcr));
+			}
+		}
+		pc_sleep(1);
+
+		/* step6: wide avdd/dvdd/avdd1 gpio107 */
+		pc_gpio_set(107, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step6 wide pwr gpio107 ctl=%#x in=%#x\n",
+		    pc_rd(pc_tlmm, PC_GPIO(107)), pc_rd(pc_tlmm, PC_GPIO(107) + 0x4));
+		pc_sleep(1);
+
+		/* step7: wide reset RELEASE (Android holds assert ~17 ms) */
+		pc_gpio_set(106, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step7 wide reset 106 RELEASE\n");
+		pc_sleep(18);
+
+		/* step8: tele reset RELEASE */
+		pc_gpio_set(105, 0, 0, 2, 1);
+		printf("PANDORA CAMERA: w30 step8 tele reset 105 RELEASE\n");
+		pc_sleep(3);
+	}
+
+	/* w29: align CCI core clock AND the I2C timing with the working
+	 * Android configuration (both must match or SCL/tsu/thd go wrong).
+	 * w30: now runs AFTER the sensor reset releases, matching Android
+	 * where cam_cc_cci_0_clk is enabled LAST, just before the first I2C. */
+	clk37 = pc_cci_clk_37mhz();
+
+	/* 4. PINMUX FIX: configure CCI0 I2C pins to CCI I2C function */
+	/* TLMM layout: bits[1:0]=pull, bits[5:2]=func, bits[7:6]=drv, bit[9]=oe */
+	/* CCI I2C function = 1 (cci_i2c_sdaN/sclN) */
+	printf("PANDORA CAMERA: w13 PINMUX: configuring CCI0 I2C pins\n");
+	for (unsigned i = 0; i < 2; i++) {
+		/* M0 pins */
+		ctl = pc_rd(pc_tlmm, PC_GPIO(cci0_m0[i]));
+		printf("PANDORA CAMERA: w13   gpio%u BEFORE ctl=%#x\n", cci0_m0[i], ctl);
+		/* w28: DT nezha_cci_*_active/config = bias-disable + 2mA. */
+		ctl = (ctl & ~0x3ffu) | (1u << 2);
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m0[i]), ctl);
+		printf("PANDORA CAMERA: w13   gpio%u AFTER  ctl=%#x\n", cci0_m0[i],
+		    pc_rd(pc_tlmm, PC_GPIO(cci0_m0[i])));
+
+		/* M1 pins */
+		ctl = pc_rd(pc_tlmm, PC_GPIO(cci0_m1[i]));
+		printf("PANDORA CAMERA: w13   gpio%u BEFORE ctl=%#x\n", cci0_m1[i], ctl);
+		ctl = (ctl & ~0x3ffu) | (1u << 2);
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m1[i]), ctl);
+		printf("PANDORA CAMERA: w13   gpio%u AFTER  ctl=%#x\n", cci0_m1[i],
+		    pc_rd(pc_tlmm, PC_GPIO(cci0_m1[i])));
+	}
+
+	/* 5. CCI timing: MUST match the core clock actually running.
+	 * Upstream hw_params[19.2MHz][STD] vs hw_params[37.5MHz][STD].
+	 * DT has no clock-frequency property -> I2C_MODE_STANDARD. */
+	{
+		static const uint32_t tim_19m[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		static const uint32_t tim_37m[][5] = {
+			{ 201u << 16 | 174u, 204u << 16 | 231u, 22u << 16 | 162u, 227u, 0x163u },
+		};
+		const uint32_t (*t)[5] = clk37 ? tim_37m : tim_19m;
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), t[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), t[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), t[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), t[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), t[0][4]);
+		}
+		printf("PANDORA CAMERA: w28c timing %s: scl=%#x sda0=%#x sda1=%#x "
+		    "sda2=%#x misc=%#x\n",
+		    clk37 ? "37.5MHz STD" : "19.2MHz STD",
+		    t[0][0], t[0][1], t[0][2], t[0][3], t[0][4]);
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* 6. Pin state after mux */
+	printf("PANDORA CAMERA: w13 I2C pin state after mux:\n");
+	printf("PANDORA CAMERA: w13   gpio111 SDA ctl=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, PC_GPIO(111)), pc_rd(pc_tlmm, PC_GPIO(111) + 4));
+	printf("PANDORA CAMERA: w13   gpio112 SCL ctl=%#x in=%#x\n",
+	    pc_rd(pc_tlmm, PC_GPIO(112)), pc_rd(pc_tlmm, PC_GPIO(112) + 4));
+
+	/* 7. Multi-address I2C scan on M1 (wide) */
+	/* w25: trace the pads while CCI runs one transaction, before the scan.
+	 * pinmux is func=1 (CCI) and CCI0 branch is on at this point. */
+	pc_cci_pad_trace(m, 0x10u); /* 0x10 = a w23/w24 bit-bang ACK address */
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+	pc_sleep(2);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	printf("PANDORA CAMERA: w13 extra settle delay 100ms\n");
+
+	pc_sleep(100);
+
+	/* w31: discriminate the CCI queue shape BEFORE the legacy sweep.
+	 * Both pairs use the Android-confirmed 7-bit sid; the 8-bit forms are
+	 * still covered by the scan loop below as controls. */
+	pc_cci_shape_matrix(1u, 0x10u, 0x300au, clk37); /* wide M1, OV chip-ID 0x5058 */
+	pc_cci_shape_matrix(0u, 0x2du, 0x0000u, clk37); /* tele M0, chip-ID 0x1b7e */
+	/* NEGATIVE CONTROLS: addresses with no device on either master.
+	 * If these return the SAME data as 0x10/0x2d, the w31 "read data" was
+	 * CCI FIFO residue and the whole conclusion must be withdrawn. */
+	pc_cci_shape_matrix(1u, 0x08u, 0x300au, clk37); /* no device on M1 */
+	pc_cci_shape_matrix(0u, 0x77u, 0x0000u, clk37); /* no device on M0 */
+	/* w33: clean single-byte ID read to nail the exact chip-ID bytes.
+	 * w32 negative controls proved the sensor responds; here we read the ID
+	 * registers ONE BYTE AT A TIME (separate Q0 address-write + Q1 data-read
+	 * transactions) and dump the raw 32-bit READ_DATA so the byte layout
+	 * (status prefix vs payload) is unambiguous. CCI0 core is always 37.5MHz. */
+	{
+		struct { unsigned m; uint8_t slave; const char *name; uint16_t regs[2]; } devs[] = {
+			{ 1u, 0x10u, "wide", { 0x300au, 0x300bu } },
+			{ 0u, 0x2du, "tele", { 0x0000u, 0x0001u } },
+		};
+		for (unsigned d = 0; d < 2; d++) {
+			unsigned m = devs[d].m;
+			uint8_t slave = devs[d].slave;
+			uint32_t rep0  = 1u << (4u  + m * 12u);   /* Q0 REPORT */
+			uint32_t nack0 = 1u << (27u + m * 2u);    /* Q0 NACK  */
+			uint32_t rep1  = 1u << (8u  + m * 12u);   /* Q1 REPORT */
+			uint32_t nack1 = 1u << (28u + m * 2u);    /* Q1 NACK  */
+			for (unsigned b = 0; b < 2; b++) {
+				uint16_t reg = devs[d].regs[b];
+				uint32_t cur, irq, rd, level;
+				unsigned i;
+				pc_cci_reset_engine();
+				pc_cci_refresh_timing(1);
+				pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+				pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+				/* Q0: set 16-bit register address pointer */
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+				    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+				    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4),
+				        ((uint32_t)reg >> 8) & 0xffu,
+				        (uint32_t)reg & 0xffu, 0x00u));
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+				    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+				cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+				pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+				pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u + 0u));
+				for (i = 0; i < 100; i++) {
+					irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+					if (irq & (rep0 | nack0)) break;
+					pc_sleep(1);
+				}
+				if (irq & nack0) {
+					printf("PANDORA CAMERA: w33 %s reg=%#x addr-write NACK\n",
+					    devs[d].name, reg);
+					pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+					pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+					continue;
+				}
+				/* Q1: read exactly 1 byte */
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+				    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+				    PC_CCI_I2C_READ | (1u << 4));
+				pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 1),
+				    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+				pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+				pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+				cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 1));
+				pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 1), cur);
+				pc_wr(pc_cci[0], PC_CCI_QUEUE_START, 1u << (m * 2u + 1u));
+				for (i = 0; i < 100; i++) {
+					irq = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+					if (irq & (rep1 | nack1)) break;
+					pc_sleep(1);
+				}
+				level = pc_rd(pc_cci[0], PC_CCI_READ_BUF_LEVEL(m));
+				rd = level ? pc_rd(pc_cci[0], PC_CCI_READ_DATA(m)) : 0;
+				printf("PANDORA CAMERA: w33 %s reg=%#x raw=%#x buf=%u "
+				    "b0=%#x b1=%#x b2=%#x b3=%#x\n",
+				    devs[d].name, reg, rd, level,
+				    (rd & 0xffu), ((rd >> 8) & 0xffu),
+				    ((rd >> 16) & 0xffu), ((rd >> 24) & 0xffu));
+				pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+				pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+			}
+		}
+	}
+
+
+	/* w27: one A/B control, then a full address sweep with a clean engine
+	 * before EVERY transaction. First reliable address-layer measurement
+	 * in the C-2b series (w16..w25 never reset between addresses). */
+	pc_cci_txn_ab(m, 0x10u);
+	{
+		unsigned acks = 0;
+		printf("PANDORA CAMERA: w30 WRITE-PROBE sweep 0x08..0x77 on M%u "
+		    "(android sid wide=0x10 tele=0x2d; 8-bit form 0x20/0x5a)\n", m);
+		for (unsigned a = 0x08u; a <= 0x77u; a++)
+			acks += pc_cci_write_probe(m, (uint8_t)a);
+		printf("PANDORA CAMERA: w27 WRITE-PROBE total=%u ACK addresses "
+		    "out of 112\n", acks);
+	}
+	pc_cci_reset_engine();
+
+	/* w30: Android cam_cci_burst tracepoint shows "CCI0_M1_Q0 ... sid : 0x10"
+	 * while vendor dmesg logs "slave_addr:0x20". The vendor value is the
+	 * 8-bit form; CCI SET_PARAM needs the 7-bit address (0x20 >> 1 = 0x10).
+	 * Same for tele 0x5a -> 0x2d and ultra 0x7a -> 0x3d. w16..w29 wrote the
+	 * 8-bit values straight into SET_PARAM, so the controller sent 0x40/0xb4.
+	 * This also explains the w23/w24/w26 bit-bang hit sets: M1 hit 0x10 and
+	 * M0 hit 0x2d, while the DT/vendor 8-bit values 0x20/0x5a never hit.
+	 * Keep both forms so a single boot discriminates the encoding. */
+	static const uint8_t scan_addrs[] = {
+		0x10u, 0x2du, 0x3du,   /* 7-bit Android sid: wide, tele, ultra */
+		0x20u, 0x5au, 0x7au,   /* 8-bit vendor log form (control) */
+		0x34u, 0x36u, 0x1au, 0x3au, 0x6au
+	};
+	for (unsigned ai = 0; ai < sizeof(scan_addrs); ai++) {
+		uint8_t slave = scan_addrs[ai];
+		/* w32: the shape matrix proved per-transaction timing refresh is the
+		 * strongest candidate; apply it to the legacy sweep too. */
+		pc_cci_refresh_timing(clk37);
+		printf("PANDORA CAMERA: w13 SCAN addr=%#x on M1\n", slave);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+		/* w17 combined transaction: SET_PARAM + WRITE reg 0x0000 + READ 2b + REPORT */
+		/* WRITE+READ in same Q0 => CCI generates REPEATED_START (no STOP between) */
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave << 4));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_READ | (2u << 4));
+		pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+		    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+
+		cur = pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0));
+		pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0), cur);
+		pc_wr(pc_cci[0], PC_CCI_QUEUE_START, (1u << (m * 2u + 0u)));
+
+		pc_sleep(10);
+		v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		printf("PANDORA CAMERA: w17 SCAN addr=%#x IRQ=%#x cur_cmd=%#x\n",
+		    slave, v, pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+
+		/* NACK check: BIT(29)=M1_Q0, BIT(30)=M1_Q1 (from i2c-qcom-cci.c) */
+		if (v & 0x60000000u) {
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> NACK (irq=%#x)\n", slave, v);
+		} else if (v & (1u << (4u + m * 12u))) {
+			uint32_t rd0 = pc_rd(pc_cci[0], PC_CCI_READ_DATA(m));
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> ACK! read_data=%#x\n", slave, rd0);
+		} else {
+			printf("PANDORA CAMERA: w17 SCAN addr=%#x -> other IRQ=%#x\n", slave, v);
+		}
+
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+		pc_sleep(2);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	}
+	/* w30: tele (sensor3) power/reset/MCLK is now part of the unified
+	 * Android-mirrored power-up above (steps 0/4/8), BEFORE any M0 xfer. */
+
+	/* Also try M0 (tele, Android sid 0x2d = vendor 8-bit 0x5a>>1, chip-ID
+	 * 0x1b7e) with combined transaction. */
+	printf("PANDORA CAMERA: w30 TEST: combined SET_PARAM+WRITE+READ+REPORT on M0 (tele sid=0x2d)\n");
+	pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	m = 0;
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)0x2du << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    pc_cci_load_word(PC_CCI_I2C_WRITE | (2u << 4), 0x00u, 0x00u, 0x00u));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_READ | (2u << 4));
+	pc_wr(pc_cci[0], PC_CCI_Qn_LOAD_DATA(m, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	pc_wr(pc_cci[0], PC_CCI_Qn_EXEC_WORD_CNT(m, 0),
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(m, 0)));
+	pc_wr(pc_cci[0], PC_CCI_QUEUE_START, (1u << (m * 2u + 0u)));
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w17 M0 IRQ now=%#x\n", v);
+	pc_sleep(5);
+	v = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	printf("PANDORA CAMERA: w17 M0 IRQ +5ms=%#x cur_cmd=%#x\n", v,
+	    pc_rd(pc_cci[0], PC_CCI_Qn_CUR_CMD(m, 0)));
+	{
+		int ret = pc_cci_wait_irq(pc_cci[0], 1u << (4u + m * 12u));
+		printf("PANDORA CAMERA: w17 M0 wait_irq ret=%d status=%#x\n", ret,
+		    pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0));
+		if (ret == 0) {
+			uint32_t rd0 = pc_rd(pc_cci[0], PC_CCI_READ_DATA(m));
+			printf("PANDORA CAMERA: w17 M0 report_status=%#x read_data=%#x\n",
+			    pc_rd(pc_cci[0], PC_CCI_Qn_REPORT_STATUS(m, 0)), rd0);
+			if ((rd0 & 0xffff) == 0x1b7eu) {
+				printf("PANDORA CAMERA: w17 CHIP ID MATCH (tele s5khpe = 0x1b7e)\n");
+			} else {
+				printf("PANDORA CAMERA: w17 M0 CHIP ID MISMATCH (got %#x, expect 0x1b7e)\n",
+				    rd0 & 0xffff);
+			}
+		}
+	}
+
+	/* 7b. w24: verify w23's scattered ACKs are real devices (3 rounds +
+	 * pre/post sampling + no-START control). Both sensors still powered. */
+	printf("PANDORA CAMERA: w24: disabling CCI0 branch for GPIO bit-bang\n");
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	pc_sleep(5);
+	/* w23 hits on each bus + DT sensor addresses + low/high controls.
+	 * Deliberately small: a full 0x08..0x77 sweep x 3 rounds at 3 ms per
+	 * edge would stall early boot for ~60 s and risk the watchdog. */
+	static const uint8_t m1_addrs[] = {
+		0x0cu, 0x10u, 0x20u, 0x21u, 0x51u, 0x59u, /* w23 M1 hits + DT wide */
+		0x08u, 0x77u,                              /* controls */
+	};
+	static const uint8_t m0_addrs[] = {
+		0x2du, 0x33u, 0x54u, 0x59u, 0x5cu, 0x5au, /* w23 M0 hits + DT tele */
+		0x08u, 0x77u,                              /* controls */
+	};
+	pc_bb_probe(111, 112, "CCI0_M1(wide 111/112)", m1_addrs,
+	    sizeof(m1_addrs) / sizeof(m1_addrs[0]));
+	pc_bb_probe(109, 110, "CCI0_M0(tele 109/110)", m0_addrs,
+	    sizeof(m0_addrs) / sizeof(m0_addrs[0]));
+
+	/* 8. Rollback: restore pinmux, power off */
+	printf("PANDORA CAMERA: w13 rollback: restore pinmux -> MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	for (unsigned i = 0; i < 2; i++) {
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m0[i]), 0x1u); /* restore to GPIO pull-down */
+		pc_wr(pc_tlmm, PC_GPIO(cci0_m1[i]), 0x1u);
+	}
+	pc_gpio_set(89, 0, 0, 2, 0);   /* wide MCLK off */
+	pc_gpio_set(92, 0, 0, 2, 0);   /* tele MCLK off (w22) */
+	pc_gpio_set(106, 0, 0, 2, 1);  /* wide reset high */
+	pc_gpio_set(105, 0, 0, 2, 1);  /* tele reset high (w22) */
+	pc_gpio_set(107, 0, 0, 2, 0);  /* wide pwr off */
+	pc_gpio_set(116, 0, 0, 2, 0);  /* afvdd off */
+	pc_gpio_set(113, 0, 0, 2, 0);  /* tele vana+vdig off (w22) */
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+	pandora_rpmh_resource("L5N_E1", 4, 0); /* tele vaf (w22) */
+	pandora_rpmh_resource("L3N_E1", 4, 0); /* tele custom1 (w22) */
+	pc_wr(pc_camcc, PC_CCI0_CBCR, pc_rd(pc_camcc, PC_CCI0_CBCR) & ~PC_CBCR_ENABLE);
+	printf("PANDORA CAMERA: C-2b-w22 result: pinmux+powered I2C done (see above)\n");
+}
+
+static void
+pc_w9_power_probe(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint16_t id = 0;
+	int ret;
+
+	if (!pc_camcc || !pc_cci[0] || !pc_tlmm) {
+		printf("PANDORA CAMERA: C-2b-w9 skipped (camcc/cci/tlmm unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w9 power probe (wide sensor) before: "
+	    "cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x\n",
+	    cbcr_before, cmd_before, cfg_before);
+
+	/* 1. CCI0 branch on */
+	pc_step("w9 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w9", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w9 branch did NOT come up; abort\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+
+	/* 2. CCI reset (w8 fix) */
+	{
+		uint32_t rst_st = 0;
+		pc_wr(pc_cci[0], PC_CCI_RESET_CMD, PC_CCI_RESET_CMD_MASK);
+		for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+			rst_st = pc_rd(pc_cci[0], PC_CCI_IRQ_STATUS_0);
+			if (rst_st & PC_BIT(24)) {
+				printf("PANDORA CAMERA: w9 CCI reset done (status=%#x)\n",
+				    rst_st);
+				break;
+			}
+			pc_sleep(1);
+		}
+		if (!(rst_st & PC_BIT(24))) {
+			printf("PANDORA CAMERA: w9 CCI reset ACK timeout (status=%#x)\n",
+			    rst_st);
+		}
+		/* Clear stale RST_DONE_ACK so it doesn't block queue execution */
+		pc_wr(pc_cci[0], PC_CCI_IRQ_CLEAR_0, rst_st);
+		pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+		printf("PANDORA CAMERA: w9 CCI IRQ cleared after reset\n");
+	}
+
+	/* 3. Vote RPMh rails for wide sensor */
+	printf("PANDORA CAMERA: w9 RPMh: L5M_E1 1800mV, B1B_E0 3400mV, B2B_E0 2704mV\n");
+	pandora_rpmh_resource("L5M_E1", 0, 1800);
+	pandora_rpmh_resource("L5M_E1", 4, 1);
+	pandora_rpmh_resource("B1B_E0", 0, 3400);
+	pandora_rpmh_resource("B1B_E0", 4, 1);
+	pandora_rpmh_resource("B2B_E0", 0, 2704);
+	pandora_rpmh_resource("B2B_E0", 4, 1);
+	pc_sleep(1);
+
+	/* 4. GPIO power enables: GPIO 107 (wide AVDD/DVDD), GPIO 116 (AFVDD) */
+	printf("PANDORA CAMERA: w9 GPIO: 107=high (wide pwr), 116=high (afvdd)\n");
+	pc_gpio_set(107, 0, 0, 2, 1);   /* GPIO 107 high, 2mA */
+	pc_gpio_set(116, 0, 0, 2, 1);   /* GPIO 116 high, 2mA */
+	pc_sleep(1);                     /* 100us ramp + settle */
+
+	/* 5. Assert reset (GPIO 106 low) */
+	printf("PANDORA CAMERA: w9 GPIO 106=low (reset assert)\n");
+	pc_gpio_set(106, 0, 0, 2, 0);   /* reset low */
+	pc_sleep(10);                    /* 10ms hold */
+
+	/* 6. Enable MCLK (GPIO 89 as cam_mclk, func=1, 8mA) */
+	printf("PANDORA CAMERA: w9 GPIO 89=cam_mclk (func=1, 8mA)\n");
+	pc_gpio_set(89, 1, 0, 8, -1);   /* function 1 = cam_mclk, 8mA, no OE */
+	pc_sleep(2);                     /* settle */
+
+	/* 7. CCI timing (19.2MHz Standard) + IRQ mask */
+	{
+		static const uint32_t timings[][5] = {
+			{ 78u << 16 | 114u, 28u << 16 | 28u, 10u << 16 | 77u, 118u, 0x161u },
+		};
+		for (unsigned m = 0; m < 2; m++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(m), timings[0][0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(m), timings[0][1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(m), timings[0][2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(m), timings[0][3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(m), timings[0][4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	/* 8. Read chip-ID (wide: slave 0x20 on M1) */
+	printf("PANDORA CAMERA: w9 I2C: M1 slave=0x20 (wide) expect=0x5058\n");
+	id = 0;
+	ret = pc_cci_read_reg16(pc_cci[0], 1, 0x20, &id);
+	if (ret == 0 && id == 0x5058u) {
+		printf("PANDORA CAMERA: C-2b-w9 wide CHIP ID MATCH (%#x)\n", id);
+	} else if (ret == 0) {
+		printf("PANDORA CAMERA: C-2b-w9 wide chip_id=%#x (expect 0x5058) "
+		    "MISMATCH\n", id);
+	} else {
+		printf("PANDORA CAMERA: C-2b-w9 wide -> NACK/timeout (ret=%d)\n",
+		    ret);
+	}
+
+	/* Also try tele (slave 0x5a on M0) -- no power for tele, just check bus */
+	printf("PANDORA CAMERA: w9 I2C: M0 slave=0x5a (tele) expect=0x1b7e\n");
+	id = 0;
+	ret = pc_cci_read_reg16(pc_cci[0], 0, 0x5a, &id);
+	if (ret == 0 && id == 0x1b7eu) {
+		printf("PANDORA CAMERA: C-2b-w9 tele CHIP ID MATCH (%#x)\n", id);
+	} else if (ret == 0) {
+		printf("PANDORA CAMERA: C-2b-w9 tele chip_id=%#x (expect 0x1b7e) "
+		    "MISMATCH\n", id);
+	} else {
+		printf("PANDORA CAMERA: C-2b-w9 tele -> NACK/timeout (ret=%d)\n",
+		    ret);
+	}
+
+	/* 9. Rollback in reverse */
+	printf("PANDORA CAMERA: w9 rollback: MCLK off -> reset high -> GPIO off -> RPMh off\n");
+	pc_gpio_set(89, 0, 0, 2, -1);   /* GPIO 89 back to GPIO func */
+	pc_gpio_set(106, 0, 0, 2, 1);  /* reset deassert */
+	pc_sleep(1);
+	pc_gpio_set(107, 0, 0, 2, 0);  /* wide power off */
+	pc_gpio_set(116, 0, 0, 2, 0);  /* afvdd off */
+	pandora_rpmh_resource("L5M_E1", 4, 0);
+	pandora_rpmh_resource("B1B_E0", 4, 0);
+	pandora_rpmh_resource("B2B_E0", 4, 0);
+
+	/* restore timing to saved values (restore original SCL/SDA) */
+	pc_wr(pc_cci[0], PC_CCI_SCL_CTL(0), pc_rd(pc_cci[0], PC_CCI_SCL_CTL(0)));
+	/* (timing restore is best-effort; the values written are the standard set) */
+
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	printf("PANDORA CAMERA: C-2b-w9 cleanup: cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CBCR), pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR));
+	printf("PANDORA CAMERA: C-2b-w9 result: power+I2C probe done "
+	    "(see CHIP ID / NACK lines above)\n");
+}
+static void
+pc_w1_bringup(void)
+{
+	static const uint32_t critical[] = { 0x21398u, 0x21390u, 0x21364u, 0x21368u };
+	uint32_t gdscr0, core0, top0, cfg, gdscr_now;
+	uint32_t cci0_0 = 0;
+	uint32_t cmd0 = 0, cfg0 = 0, cmd_restored = 0, cfg_restored = 0;
+	int ret = 0, down_ret;
+	bool gdsc_up = false, branch_up = false, restored, power_down_ok = false;
+	bool core_ahb_stuck = false;
+	bool w2_up = false, w2_ran = false, root_reparked = false, w2_clean = true;
+
+	printf("PANDORA CAMERA: C-2b-w1 bring-up starts (GDSC + 2 AHB branches; "
+	    "no rail vote, no RCG, no CCI, no GPIO)\n");
+
+	/* Precondition: the critical CBCRs were enabled at boot (C-2b-p read
+	 * 0x08000001 on all four). If they are not, write nothing at all. */
+	for (unsigned i = 0; i < sizeof(critical) / sizeof(critical[0]); i++) {
+		cfg = pc_rd(pc_camcc, critical[i]);
+		printf("PANDORA CAMERA: w1 critical +%#x = %#x\n", critical[i], cfg);
+		if (!(cfg & PC_CBCR_ENABLE)) {
+			printf("PANDORA CAMERA: w1 ABORT: critical CBCR +%#x has no enable bit; no write issued\n",
+			    critical[i]);
+			return;
+		}
+	}
+
+	gdscr0 = pc_rd(pc_camcc, PC_GDSCR);
+	core0 = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+	top0 = pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR);
+	printf("PANDORA CAMERA: w1 before: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x cam_top_ahb=%#x\n",
+	    gdscr0, pc_rd(pc_camcc, PC_CFG_GDSCR), core0, top0);
+
+	/* 1. TITAN_TOP GDSC: clear SW_COLLAPSE, poll CFG_GDSCR bit 16. */
+	pc_step("w1 GDSC enable", PC_CAMCC_PA + PC_GDSCR);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0 & ~PC_GDSC_SW_COLLAPSE);
+	printf("PANDORA CAMERA: w1 wrote gdscr=%#x (SW_COLLAPSE cleared)\n",
+	    pc_rd(pc_camcc, PC_GDSCR));
+	ret = pc_wait_gdsc_up();
+	if (ret) {
+		printf("PANDORA CAMERA: w1 GDSC ERROR %d (power-up complete never observed)\n", ret);
+	} else {
+		gdsc_up = true;
+		pc_sleep(1);                 /* upstream udelay(1) after toggle */
+		pc_wr(pc_camcc, PC_GDSCR, pc_rd(pc_camcc, PC_GDSCR) | PC_GDSC_RETAIN_FF);
+		printf("PANDORA CAMERA: w1 GDSC up: gdscr=%#x cfg_gdscr=%#x\n",
+		    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR));
+	}
+
+	/* 2. CORE_AHB: BRANCH_HALT_DELAY has no halt bit, just a delay. */
+	if (ret == 0) {
+		pc_step("w1 CORE_AHB", PC_CAMCC_PA + PC_CORE_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0 | PC_CBCR_ENABLE);
+		pc_sleep(1);                 /* upstream udelay(10) */
+		cfg = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+		/* camcc-kaanapali.c: cam_cc_core_ahb_clk is an ordinary
+		 * clk_branch2 with enable_mask BIT(0), not a critical or
+		 * hardware-voted clock. A missing readback bit is therefore an
+		 * unexplained observation, not a BRANCH_HALT_DELAY quirk. */
+		core_ahb_stuck = !(cfg & PC_CBCR_ENABLE);
+		printf("PANDORA CAMERA: w1 core_ahb now=%#x enable_stuck=%s "
+		    "(BRANCH_HALT_DELAY has no halt poll)\n",
+		    cfg, core_ahb_stuck ? "YES" : "no");
+
+		/* 3. CAM_TOP_AHB: BRANCH_HALT, poll CLK_OFF clearing. */
+		pc_step("w1 CAM_TOP_AHB", PC_CAMCC_PA + PC_CAM_TOP_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0 | PC_CBCR_ENABLE);
+		ret = pc_wait_branch_on("w1", PC_CAM_TOP_AHB_CBCR);
+		if (ret) {
+			printf("PANDORA CAMERA: w1 CAM_TOP_AHB ERROR %d (CLK_OFF never cleared)\n", ret);
+		} else {
+			branch_up = true;
+		}
+	}
+
+	/* A/B snapshot while (if) the domain is up. CCI0's own branch and RCG
+	 * were deliberately left off, so a zero CCI timing register here is the
+	 * expected state, NOT a failure of w1. */
+	printf("PANDORA CAMERA: w1 A/B snapshot: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x "
+	    "cam_top_ahb=%#x cci0_cbcr=%#x\n",
+	    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR),
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, 0x21268u));
+	if (pc_cci[0]) {
+		printf("PANDORA CAMERA: w1 CCI0 m0 scl_ctl=%#x (CCI branch/RCG untouched; "
+		    "zero is expected)\n", pc_rd(pc_cci[0], 0x100u));
+	}
+	pc_w1_cci_snapshot();
+
+	/* C-2b-w2 runs while the GDSC is still up. It reads the CCI0 RCG state
+	 * and writes only the CCI0 branch CBCR. The parent RCG is in ROOT_OFF
+	 * (C-2b-p), so "branch not on" is an expected possible outcome and is
+	 * reported as its own result; it never changes the w1 verdict. */
+	pc_w2_dump();
+	if (gdsc_up && branch_up) {
+		w2_ran = true;
+		w2_up = pc_w2_branch(&cci0_0, &cmd0, &cfg0);
+		printf("PANDORA CAMERA: C-2b-w2 result: branch_up=%s cmd_rcgr=%#x root_off=%s "
+		    "-> %s (exploratory; does not gate the w1 verdict)\n",
+		    w2_up ? "yes" : "no",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    (pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF) ? "yes" : "no",
+		    w2_up ? "BRANCH ON" : "BRANCH NOT ON");
+	} else {
+		printf("PANDORA CAMERA: C-2b-w2 skipped (GDSC or CAM_TOP_AHB not up)\n");
+	}
+
+	/* C-2b-w5 runs while the GDSC is still up (same gate as w2). It switches
+	 * the CCI0 RCG source from XO to PLL0_OUT_EVEN/16 (37.5 MHz) via the cached
+	 * clk_rcg2_shared_set_rate handshake, then rolls the RCG back. No PLL/RCG M/N
+	 * register is touched; it does NOT gate the w1 verdict. */
+	if (gdsc_up && branch_up) {
+		pc_w13_pinnmux_i2c();
+	}
+
+	/* 4. Rollback in reverse order, always. Restore the exact values read
+	 * before the probe, so no camera state is left changed by a diagnostic. */
+	pc_step("w1 rollback", PC_CAMCC_PA + PC_GDSCR);
+	if (w2_ran) {
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cci0_0);
+		/* Read while the GDSC is still up — the same condition as the
+		 * before/after reads — so the RCG comparison is meaningful.
+		 * w2 never writes CMD_RCGR; if the hardware does not re-park the
+		 * root on branch disable, the probe has left state behind and
+		 * must say so rather than claiming a clean rollback. */
+		cmd_restored = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		cfg_restored = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+		root_reparked = (cmd_restored & PC_CMD_ROOT_OFF) != 0;
+		w2_clean = root_reparked && (cmd_restored == cmd0) &&
+		    (cfg_restored == cfg0);
+		printf("PANDORA CAMERA: C-2b-w3 cleanup: cmd_rcgr=%#x (before=%#x) "
+		    "cfg_rcgr=%#x (before=%#x) root_reparked=%s -> %s\n",
+		    cmd_restored, cmd0, cfg_restored, cfg0,
+		    root_reparked ? "yes" : "no",
+		    w2_clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+	}
+	pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0);
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0);
+	/* Upstream gdsc_disable() polls CFG_GDSCR POWER_DOWN_COMPLETE (bit 15).
+	 * A single read is not proof the domain returned to OFF. */
+	down_ret = pc_wait_gdsc_down();
+	if (down_ret) {
+		printf("PANDORA CAMERA: w1 GDSC-DOWN ERROR %d (power-down complete never observed)\n",
+		    down_ret);
+	} else {
+		power_down_ok = true;
+	}
+	gdscr_now = pc_rd(pc_camcc, PC_GDSCR);
+	cfg = pc_rd(pc_camcc, PC_CFG_GDSCR);
+	/* Compare software control bits only. GDSCR high bits are live hardware
+	 * status and never read back the written value (PC_GDSCR_CTRL_MASK). */
+	restored = (((gdscr_now ^ gdscr0) & PC_GDSCR_CTRL_MASK) == 0) &&
+	    (pc_rd(pc_camcc, PC_CORE_AHB_CBCR) == core0) &&
+	    (pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR) == top0) &&
+	    (!w2_ran || (pc_rd(pc_camcc, PC_CCI0_CBCR) == cci0_0));
+	printf("PANDORA CAMERA: w1 rollback: gdscr=%#x ctrl_mask=%#x cfg_gdscr=%#x "
+	    "(power_down_bit=%s) core_ahb=%#x cam_top_ahb=%#x cci0_cbcr=%#x "
+	    "restored=%s power_down=%s\n",
+	    gdscr_now, PC_GDSCR_CTRL_MASK, cfg,
+	    (cfg & PC_CFG_GDSC_PWR_DOWN) ? "set" : "clear",
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, PC_CCI0_CBCR),
+	    restored ? "yes" : "NO", power_down_ok ? "yes" : "NO");
+	if (w2_ran) {
+		/* Cross-check after the GDSC is off: C-2b-p read 0x80000000 for
+		 * CMD_RCGR in that state. Read-only; no RCG write. */
+		printf("PANDORA CAMERA: w3 post-GDSC-off cmd_rcgr=%#x cfg_rcgr=%#x "
+		    "(C-2b-p baseline 0x80000000)\n",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR));
+	}
+	if (core_ahb_stuck) {
+		printf("PANDORA CAMERA: w1 CORE_AHB enable_stuck: BIT(0) did not read back; "
+		    "unresolved observation, NOT a success. It is reported separately and "
+		    "does not enter the verdict, whose target is the GDSC + CAM_TOP_AHB path.\n");
+	}
+	printf("PANDORA CAMERA: C-2b-w1 result: gdsc_up=%s branch_up=%s restored=%s "
+	    "power_down=%s core_ahb_enable_stuck=%s w2_cleanup=%s%s\n",
+	    gdsc_up ? "yes" : "no", branch_up ? "yes" : "no",
+	    restored ? "yes" : "no", power_down_ok ? "yes" : "no",
+	    core_ahb_stuck ? "YES" : "no",
+	    w2_ran ? (w2_clean ? "CLEAN" : "LEFTOVER") : "n/a",
+	    (gdsc_up && branch_up && restored && power_down_ok) ? " -> PASS" : " -> NOT PASS");
+}
+
+static void
+pc_tlmm_dump(void)
+{
+	/* CCI I2C SDA/SCL pins (DT pinctrl cci0/1/2): mux function is
+	 * cci_i2c_sdaN / sclN. TLMM CTL: func [5:2]. Print the current CTL so
+	 * a later mux step has a before-picture. No pin is driven here. */
+	static const uint8_t pins[] = {109, 110, 111, 112, 113, 114, 107, 160, 108, 149, 115, 116,
+	    89, 106, 92, 105};
+	printf("PANDORA CAMERA: TLMM CCI/sensor pins (ctl/value):\n");
+	for (unsigned i = 0; i < sizeof(pins); i++) {
+		printf("PANDORA CAMERA:   gpio%u ctl=%#x val=%#x\n", pins[i],
+		    pc_rd(pc_tlmm, PC_GPIO(pins[i])), pc_rd(pc_tlmm, PC_GPIO(pins[i]) + 4));
+	}
+}
+
+/* Power up the front (ov50m) and ultra (s5kjn5) sensors that live on the QUP
+ * I2C bus (SE9 @0x884000 / SE8 @0x880000). They are reachable ONLY through a
+ * QUP GENI I2C master, which the driver does not implement yet, so this helper
+ * does the SAFE half only: rails + reset sequencing, no I2C traffic. DT
+ * authority (Android DTBO overlay, resolved via __fixups__ -> __symbols__):
+ *   front  cam-sensor1: MCLK2 pad=TLMM 91, reset=TLMM 3,  7-bit reg=0x10,
+ *           vio=L5M_E1 vdig=L1N_E1 vana=L6N_E1 vaf=L4N_E1,
+ *           bob1=B1B_E0 bob2=B2B_E0 (shared with wide/tele, not re-voted)
+ *   ultra  cam-sensor2: MCLK4 pad=TLMM 93, reset=TLMM 7,  7-bit reg=0x36,
+ *           vio=L5M_E1 vdig=L2M_E1 vana=L4M_E1 vaf=L3M_E1 v_custom2=L6M_E1,
+ *           bob2=B2B_E0 (shared, not re-voted)
+ * reset is active-low (gpios flags=0), same as wide/tele. BOB1/BOB2 are already
+ * voted by pc_sensor_power_up() above, so we skip them. MCLK pads are
+ * deliberately NOT muxed: the clock sources are enabled but no signal is driven
+ * to the sensors while they sit in reset, and we do no I2C. Opt-in via
+ * pandora_camera=3 (pc_level >= 3). */
+static void
+pc_sensor_power_up_uf(void)
+{
+	/* assert both resets (active low) before any rail comes up */
+	pc_gpio_set(3, 0, 0, 2, 0);   /* front reset assert (low) */
+	pc_gpio_set(7, 0, 0, 2, 0);   /* ultra reset assert (low) */
+	pc_sleep(1);
+
+	/* front rails (regulator-names order: vio vdig vana vaf bob bob2) */
+	(void)pandora_rpmh_resource("L5M_E1", 0, 1800);   /* vio  (shared, idempotent) */
+	(void)pandora_rpmh_resource("L5M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L1N_E1", 0, 1200);   /* vdig */
+	(void)pandora_rpmh_resource("L1N_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L6N_E1", 0, 2800);   /* vana */
+	(void)pandora_rpmh_resource("L6N_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L4N_E1", 0, 1800);   /* vaf  */
+	(void)pandora_rpmh_resource("L4N_E1", 4, 1);
+	pc_sleep(1);
+
+	/* ultra rails (regulator-names order: vio vdig vana vaf v_custom2 bob2) */
+	(void)pandora_rpmh_resource("L5M_E1", 0, 1800);   /* vio  (shared, idempotent) */
+	(void)pandora_rpmh_resource("L5M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L2M_E1", 0, 1104);   /* vdig */
+	(void)pandora_rpmh_resource("L2M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L4M_E1", 0, 2200);   /* vana */
+	(void)pandora_rpmh_resource("L4M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L3M_E1", 0, 2900);   /* vaf  */
+	(void)pandora_rpmh_resource("L3M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L6M_E1", 0, 2800);   /* v_custom2 */
+	(void)pandora_rpmh_resource("L6M_E1", 4, 1);
+	pc_sleep(1);
+
+	/* release resets (active low -> high) */
+	pc_gpio_set(3, 0, 0, 2, 1);   /* front reset release */
+	pc_sleep(1);
+	pc_gpio_set(7, 0, 0, 2, 1);   /* ultra reset release */
+	pc_sleep(3);
+	printf("PANDORA CAMERA: power_up_uf done (front gpio3 / ultra gpio7)\n");
+}
+
+/* Stage D driver bring-up. Unlike the C-2b probes this does NOT roll the
+ * sensor back off: it leaves wide+tele powered and CCI0 configured so the
+ * driver read/write helpers (or a later init-table pass) can use them. The
+ * init table itself is still sourced from Android -- see pc_sensor_init(). */
+static unsigned
+pc_sensor_power_up(void)
+{
+	int clk37;
+	uint32_t ctl;
+	/* 1:1 mirror of Android cam_sensor_power_up() on THIS device
+	 * (docs/CAMERA_C2B_ANDROID_POWER_SEQUENCE.md). reset-first, then rails
+	 * ~1 ms apart, MCLK 19.2 MHz XO, reset release, CCI0 37.5 MHz. */
+	/* The probe bringup rolls back at the end and powers the TITAN_TOP GDSC
+	 * down (w13/w1 rollback: power_down=yes). CCI0 lives inside that domain:
+	 * with it down, CCI register reads return 0 and writes are dropped
+	 * (w35: rdm Q0 cur=0 irq=0 while the pre-rollback probe reads worked).
+	 * Bring the domain back up exactly like w1: clear SW_COLLAPSE, poll
+	 * POWER_UP_COMPLETE, RETAIN_FF, then CORE_AHB + CAM_TOP_AHB branches. */
+	{
+		uint32_t g = pc_rd(pc_camcc, PC_GDSCR);
+		if (!(pc_rd(pc_camcc, PC_CFG_GDSCR) & PC_CFG_GDSC_PWR_UP)) {
+			pc_wr(pc_camcc, PC_GDSCR, g & ~PC_GDSC_SW_COLLAPSE);
+			if (pc_wait_gdsc_up() == 0) {
+				pc_sleep(1);
+				pc_wr(pc_camcc, PC_GDSCR,
+				    pc_rd(pc_camcc, PC_GDSCR) | PC_GDSC_RETAIN_FF);
+			} else {
+				printf("PANDORA CAMERA: power_up GDSC ERROR "
+				    "(power-up complete never observed)\n");
+			}
+		}
+		pc_wr(pc_camcc, PC_CORE_AHB_CBCR,
+		    pc_rd(pc_camcc, PC_CORE_AHB_CBCR) | PC_CBCR_ENABLE);
+		pc_sleep(1);
+		pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR,
+		    pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR) | PC_CBCR_ENABLE);
+		(void)pc_wait_branch_on("pu", PC_CAM_TOP_AHB_CBCR);
+		printf("PANDORA CAMERA: power_up gdsc=%#x cfg_gdscr=%#x core_ahb=%#x "
+		    "cam_top_ahb=%#x\n", pc_rd(pc_camcc, PC_GDSCR),
+		    pc_rd(pc_camcc, PC_CFG_GDSCR), pc_rd(pc_camcc, PC_CORE_AHB_CBCR),
+		    pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR));
+	}
+	pc_gpio_set(89, 1, 0, 2, -1);   /* MCLK pins: input, func=cam_mclk */
+	pc_gpio_set(92, 1, 0, 2, -1);
+	pc_gpio_set(106, 0, 0, 2, 0);   /* wide reset assert (low) */
+	pc_gpio_set(105, 0, 0, 2, 0);   /* tele reset assert (low) */
+	pc_sleep(1);
+
+	(void)pandora_rpmh_resource("B1B_E0", 0, 3400);
+	(void)pandora_rpmh_resource("B1B_E0", 4, 1);
+	(void)pandora_rpmh_resource("B2B_E0", 0, 2704);
+	(void)pandora_rpmh_resource("B2B_E0", 4, 1);
+	(void)pandora_rpmh_resource("L5M_E1", 8, 7);
+	(void)pandora_rpmh_resource("B1B_E0", 8, 7);
+	(void)pandora_rpmh_resource("B2B_E0", 8, 7);
+	pc_sleep(1);
+
+	pc_gpio_set(116, 0, 0, 2, 1);   /* wide afvdd */
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L5M_E1", 0, 1800);
+	(void)pandora_rpmh_resource("L5M_E1", 4, 1);
+	pc_sleep(1);
+	(void)pandora_rpmh_resource("L3N_E1", 0, 1800);
+	(void)pandora_rpmh_resource("L3N_E1", 4, 1);
+	(void)pandora_rpmh_resource("L5N_E1", 0, 3300);
+	(void)pandora_rpmh_resource("L5N_E1", 4, 1);
+	pc_gpio_set(113, 0, 0, 2, 1);   /* tele vana/vdig */
+	pc_sleep(1);
+
+	/* MCLK 19.2 MHz from XO (DT clock-rates 0x124f800), Android running values */
+	{
+		static const uint32_t mclk_cmd[] = { 0x4000u, 0x4038u, 0x4054u, 0x4070u };
+		static const uint32_t mclk_cbcr[] = { 0x4018u, 0x4050u, 0x406cu, 0x4088u };
+		for (unsigned mi = 0; mi < 4; mi++) {
+			pc_wr(pc_bdistm, mclk_cmd[mi] + 4, 0x00100001u);
+			pc_wr(pc_bdistm, mclk_cmd[mi],
+			    (pc_rd(pc_bdistm, mclk_cmd[mi]) & ~0x80000000u) | 0x1u);
+			for (unsigned pi = 0; pi < 50; pi++) {
+				if (!(pc_rd(pc_bdistm, mclk_cmd[mi]) & 0x1u))
+					break;
+				pc_sleep(1);
+			}
+			pc_wr(pc_bdistm, mclk_cbcr[mi],
+			    pc_rd(pc_bdistm, mclk_cbcr[mi]) | 0x1u);
+		}
+	}
+	pc_sleep(1);
+
+	pc_gpio_set(107, 0, 0, 2, 1);   /* wide avdd/dvdd */
+	pc_sleep(1);
+	pc_gpio_set(106, 0, 0, 2, 1);   /* wide reset release (hold ~17 ms) */
+	pc_sleep(18);
+	pc_gpio_set(105, 0, 0, 2, 1);   /* tele reset release */
+	pc_sleep(3);
+
+	clk37 = pc_cci_clk_37mhz();
+
+	/* pinmux CCI0 I2C pads to cci_i2c function (func=1) */
+	{
+		static const uint8_t pins[] = { 109u, 110u, 111u, 112u };
+		for (unsigned i = 0; i < 4; i++) {
+			ctl = pc_rd(pc_tlmm, PC_GPIO(pins[i]));
+			ctl = (ctl & ~0x3ffu) | (1u << 2);
+			pc_wr(pc_tlmm, PC_GPIO(pins[i]), ctl);
+		}
+	}
+	/* CCI timing for 37.5 MHz Standard (Android running values) */
+	{
+		static const uint32_t t0[5] = {
+			201u << 16 | 174u, 204u << 16 | 231u,
+			22u << 16 | 162u, 227u, 0x163u };
+		for (unsigned mm = 0; mm < 2; mm++) {
+			pc_wr(pc_cci[0], PC_CCI_SCL_CTL(mm), t0[0]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_0(mm), t0[1]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_1(mm), t0[2]);
+			pc_wr(pc_cci[0], PC_CCI_SDA_CTL_2(mm), t0[3]);
+			pc_wr(pc_cci[0], PC_CCI_MISC_CTL(mm), t0[4]);
+		}
+	}
+	pc_wr(pc_cci[0], PC_CCI_IRQ_MASK_0,
+	    0x1u | 0x10u | 0x100u | 0x1000u | 0x10000u | 0x100000u
+	    | PC_BIT(24) | 0x18000ee6u | 0x60ee6000u);
+	pc_wr(pc_cci[0], PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+	if (pc_level >= 3u) {
+		pc_sensor_power_up_uf();
+	}
+	printf("PANDORA CAMERA: driver power_up done clk37=%d\n", clk37);
+	return (unsigned)(clk37 > 0);
+}
+
+/* Replay an Android-dumped init table through the real driver write path.
+ * width 0 in an entry means "use the sensor family default". Each entry is a
+ * full transaction with per-transaction reset+timing. Opt-in only: called from
+ * pc_sensor_init when the pandora_camera_apply boot arg is set.
+ * UNVERIFIED on-device: a wrong data width can lock a sensor until a power
+ * cycle. Default widths: wide 8-bit, tele/ultra 16-bit (from the trace's value
+ * distribution; per-register width is inferred, not authoritative). */
+static int
+pc_sensor_apply_tbl(const struct pc_init_reg *t, unsigned n, unsigned master,
+    uint8_t slave, unsigned def_width, unsigned cap, const char *name)
+{
+	unsigned applied = 0, fails = 0, skipped = 0;
+	for (unsigned i = 0; i < n; i++) {
+		/* reg 0xFFFF is a trace artifact (52% of the wide dump), not a
+		 * real register; writing it NACKs and pollutes the fail count. */
+		if (t[i].reg == 0xffffu) {
+			skipped++;
+			continue;
+		}
+		if (cap && (applied + fails) >= cap) {
+			break;
+		}
+		unsigned w = t[i].width ? t[i].width : def_width;
+		int ret = pc_cci_write_reg(pc_cci[0], master, slave,
+		    t[i].reg, t[i].val, w);
+		if (ret != 0) {
+			fails++;
+			if (fails <= 8)
+				printf("PANDORA CAMERA: apply %s[%u] reg=0x%04x FAIL ret=%d\n",
+				    name, i, t[i].reg, ret);
+		} else {
+			applied++;
+			if (applied <= 4)
+				printf("PANDORA CAMERA: apply %s[%u] reg=0x%04x val=0x%04x OK\n",
+				    name, i, t[i].reg, t[i].val);
+		}
+	}
+	printf("PANDORA CAMERA: apply %s done applied=%u fails=%u skipped=%u cap=%u\n",
+	    name, applied, fails, skipped, cap);
+	return fails ? EIO : 0;
+}
+
+/* Stage D driver init: power up, write the (pending) init table through the
+ * real driver write path, then self-check the bus on the driver READ path
+ * (pc_cci_read_reg16_timed owns per-transaction reset+timing, no probe block).
+ * The init table rows are NOT guessed: they are dumped from Android's running
+ * sensor config (vendor tuning bin carries no source). The replay is opt-in
+ * (boot arg) so the safe self-check always runs even when replay is off. */
+static void
+pc_sensor_init(void)
+{
+	uint16_t id;
+	int ret;
+
+	if (!pc_camcc || !pc_cci[0] || !pc_tlmm || !pc_bdistm) {
+		printf("PANDORA CAMERA: driver init skipped (mmio not mapped)\n");
+		return;
+	}
+	pc_sensor_power_up();
+
+	/* Opt-in init-table replay. OFF by default. Enable with either
+	 *   pandora_camera_apply=1
+	 * or (zero-cost alias, cmdline field is only 608 bytes)
+	 *   pandora_camera=2
+	 * on the boot cmdline to actually write the Android-dumped settings.
+	 * wide = CCI0 M1 sid 0x10 (8-bit data); tele = CCI0 M0 sid 0x2d (16-bit).
+	 * ultra/front are on QUP I2C (SE8/SE9) and are NOT replayed here -- they
+	 * only get a power-up-only sequence at pandora_camera=3 (pc_level==3),
+	 * gated separately in pc_sensor_power_up(). Use == 2 so that level 3
+	 * stays a pure uf power-up test and does not also replay wide/tele. */
+	{
+		unsigned apply = 0;
+		(void)PE_parse_boot_argn("pandora_camera_apply", &apply,
+		    sizeof(apply));
+		if (pc_level == 2u && !apply) {
+			apply = 1;
+		}
+		if (apply) {
+			/* apply==1 -> full replay; apply>1 -> first N valid entries
+			 * (quick write-path verification, single variable). */
+			unsigned cap = (apply > 1u) ? apply : 0u;
+			pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, 1, 0x10u, 1, cap, "wide");
+			pc_sensor_apply_tbl(pc_tele_tbl, pc_tele_tbl_n, 0, 0x2du, 2, cap, "tele");
+		}
+	}
+
+	/* self-check via the DRIVER read path: read each sensor's chip-id
+	 * register (wide ovx10500 @ 0x300a, tele s5khpe @ 0x0000). */
+	ret = pc_cci_read_reg16_timed(pc_cci[0], 1, 0x10u, 0x300au, &id);
+	printf("PANDORA CAMERA: driver self-check wide chip_id=%#x ret=%d\n", id, ret);
+	ret = pc_cci_read_reg16_timed(pc_cci[0], 0, 0x2du, 0x0000u, &id);
+	printf("PANDORA CAMERA: driver self-check tele chip_id=%#x ret=%d\n", id, ret);
+}
+
+/* ---------------------------------------------------------------------------
+ * TPG P0 resource bring-up (boot arg pandora_tpg=1). Implements
+ * CAMERA_L2_CAMCC_P0_2026-11-12.md §12 steps S1-S8 + S11, direction C: the two
+ * GCC camera AXI branches (0x26014/0x26028) are deliberately NOT touched, so
+ * "can TPG produce a frame without gcc_axi_hf/sf" becomes a first-hand datum.
+ *
+ * This path is independent of the verified sensor path (pandora_camera=1/2):
+ * no RPMh rail vote, no GPIO, no CCI/QUP traffic, no sensor pin. It only pulls
+ * the CAMSS TPG clock/power tree, reads the TPG/CSID/VFE HW version, then powers
+ * down in reverse. Read-back-first, bounded polls (PC_POLL_STEPS), a missing
+ * status bit is never reported as success. Offsets/bits are the cached
+ * camcc-kaanapali.c / gdsc.c / clk-rcg2.c facts cross-checked in §12; the RCG
+ * divider field is hid = 2*div - 1 (verified CCI0 0x0010021f, §12.2).
+ * ------------------------------------------------------------------------- */
+
+/* GDSCR offsets (§2.1). TITAN_TOP is PC_GDSCR; CFG_GDSCR is always gdscr+4. */
+#define PC_TFE0_GDSCR   0x21004u
+#define PC_TFE1_GDSCR   0x21080u
+#define PC_TFE2_GDSCR   0x210e4u
+
+/* S7/S8 branch CBCRs (§3), in enable order. CORE_AHB (0x21348) is handled
+ * separately: BRANCH_HALT_DELAY has no halt bit, so it is enable+delay only. */
+static const uint32_t pc_tpg_branches[] = {
+	0x2137cu, 0x2136cu, 0x212f8u, 0x212e4u, 0x21330u, /* cpas_ahb/fast_ahb/nrt/rt/qdss */
+	0x20020u, 0x212bcu, 0x21030u, 0x2105cu,           /* csiphy_rx/csid/vfe0/vfe0_fast_ahb */
+	0x21040u, 0x210bcu, 0x21120u                      /* cpas_vfe0/1/2 (all three, v24) */
+};
+#define PC_TPG_NBRANCH  (sizeof(pc_tpg_branches) / sizeof(pc_tpg_branches[0]))
+
+/* S6 RCGs: cmd_rcgr, SRC_SEL, hid (=2*div-1). §12.3. */
+struct pc_tpg_rcg { uint32_t cmd; unsigned sel; unsigned hid; const char *name; };
+static const struct pc_tpg_rcg pc_tpg_rcgs[] = {
+	{ 0x21064u, 1u, 5u,  "cphy_rx" },       /* PLL0_MAIN/3   = 400 MHz */
+	{ 0x212a4u, 1u, 5u,  "csid" },          /* PLL0_MAIN/3   = 400 MHz */
+	{ 0x21018u, 6u, 1u,  "tfe_0" },         /* PLL3_EVEN/1   = 360.28 MHz */
+	{ 0x212ccu, 1u, 4u,  "camnoc_rt_axi" }, /* PLL0_MAIN/2.5 = 480 MHz */
+	{ 0x200dcu, 2u, 3u,  "fast_ahb" },      /* PLL0_EVEN/2   = 300 MHz */
+	{ 0x20100u, 2u, 14u, "slow_ahb" }       /* PLL0_EVEN/7.5 = 80 MHz */
+};
+#define PC_TPG_NRCG  (sizeof(pc_tpg_rcgs) / sizeof(pc_tpg_rcgs[0]))
+
+/* Diagnostic: the first TPG boots froze before the 3 s log flush, leaving a
+ * stale log. pandora_log_sync() (sweet_ufs.c) forces a thread-safe flush, so
+ * printing + syncing before each step keeps the last completed step on disk
+ * even if the next step freezes the kernel. */
+extern bool pandora_log_sync(void);
+static void
+pc_tpg_mark(const char *msg)
+{
+	printf("PANDORA TPG: %s\n", msg);
+	(void)pandora_log_sync();
+}
+
+static int
+pc_tpg_gdsc_up(uint32_t gdscr, const char *name)
+{
+	uint32_t g = pc_rd(pc_camcc, gdscr);
+	if (pc_rd(pc_camcc, gdscr + 4) & PC_CFG_GDSC_PWR_UP) {
+		printf("PANDORA TPG: %s gdsc already up gdscr=%#x\n", name, g);
+		return 0;
+	}
+	/* Clear only SW_COLLAPSE; the read-back value keeps the EN_REST/EN_FEW/
+	 * CLK_DIS_WAIT fields (§2.1) intact. */
+	pc_wr(pc_camcc, gdscr, g & ~PC_GDSC_SW_COLLAPSE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (pc_rd(pc_camcc, gdscr + 4) & PC_CFG_GDSC_PWR_UP) {
+			pc_sleep(1);
+			pc_wr(pc_camcc, gdscr, pc_rd(pc_camcc, gdscr) | PC_GDSC_RETAIN_FF);
+			printf("PANDORA TPG: %s gdsc up gdscr=%#x cfg=%#x\n", name,
+			    pc_rd(pc_camcc, gdscr), pc_rd(pc_camcc, gdscr + 4));
+			return 0;
+		}
+		pc_sleep(1);
+	}
+	printf("PANDORA TPG: %s gdsc ERROR power-up complete never observed\n", name);
+	return ETIMEDOUT;
+}
+
+static void
+pc_tpg_gdsc_down(uint32_t gdscr, const char *name)
+{
+	pc_wr(pc_camcc, gdscr, pc_rd(pc_camcc, gdscr) | PC_GDSC_SW_COLLAPSE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (pc_rd(pc_camcc, gdscr + 4) & PC_CFG_GDSC_PWR_DOWN) {
+			printf("PANDORA TPG: %s gdsc down cfg=%#x\n", name,
+			    pc_rd(pc_camcc, gdscr + 4));
+			return;
+		}
+		pc_sleep(1);
+	}
+	printf("PANDORA TPG: %s gdsc down NOT observed (continuing teardown)\n", name);
+}
+
+/* TAYCAN_EKO_T(=ELU) alpha-PLL enable, mirroring the verified pc_cci_clk_37mhz
+ * sequence. If the PLL is already running we do NOT rewrite config/L/alpha
+ * (w35: rewriting a live PLL glitches it); we only ensure the output-enable
+ * bits (USER_CTL[2:0], PLL_OUT_MASK=0x7) are set. Returns 0 on running. */
+static int
+pc_tpg_pll_enable(uint32_t off, uint32_t l_val, uint32_t alpha,
+    uint32_t user_ctl, const char *name)
+{
+	uint32_t mode0 = pc_rd(pc_camcc, off + 0x00);
+	uint32_t opmode0 = pc_rd(pc_camcc, off + 0x04);
+	if ((opmode0 & 0x1u) && ((mode0 & 0x5u) == 0x5u)) {
+		pc_wr(pc_camcc, off + 0x18,
+		    pc_rd(pc_camcc, off + 0x18) | (user_ctl & 0x7u));
+		printf("PANDORA TPG: %s pll already running mode=%#x opmode=%#x user=%#x\n",
+		    name, mode0, opmode0, pc_rd(pc_camcc, off + 0x18));
+		return 0;
+	}
+	pc_wr(pc_camcc, off + 0x20, 0x25c400e7u);
+	pc_wr(pc_camcc, off + 0x24, 0x0a8062e0u);
+	pc_wr(pc_camcc, off + 0x28, 0xf51dea20u);
+	pc_wr(pc_camcc, off + 0x10, l_val);
+	pc_wr(pc_camcc, off + 0x14, alpha);
+	pc_wr(pc_camcc, off + 0x18, user_ctl);
+	pc_wr(pc_camcc, off + 0x1c, 0x2u);
+	pc_wr(pc_camcc, off + 0x04, 0x1u);      /* OPMODE: PLL_RUN */
+	for (unsigned i = 0; i < 20; i++)
+		pc_sleep(1);
+	pc_wr(pc_camcc, off + 0x00, pc_rd(pc_camcc, off + 0x00) | 0x5u);
+	uint32_t mode = pc_rd(pc_camcc, off + 0x00);
+	uint32_t opmode = pc_rd(pc_camcc, off + 0x04);
+	if ((opmode & 0x1u) && (mode & 0x1u)) {
+		printf("PANDORA TPG: %s pll enabled mode=%#x opmode=%#x l=%#x alpha=%#x\n",
+		    name, mode, opmode, pc_rd(pc_camcc, off + 0x10),
+		    pc_rd(pc_camcc, off + 0x14));
+		return 0;
+	}
+	pc_wr(pc_camcc, off + 0x00, mode0);
+	pc_wr(pc_camcc, off + 0x04, opmode0);
+	printf("PANDORA TPG: %s pll NOT enabled -> restored mode=%#x opmode=%#x\n",
+	    name, mode0, opmode0);
+	return EIO;
+}
+
+/* Configure one RCG: force-enable the root (CMD_ROOT_EN) so CMD_UPDATE latches
+ * (the w5 lesson), write CFG SRC_SEL/hid preserving HW_CLK_CTRL, commit with
+ * CMD_UPDATE and poll it clear. Returns 0 only when the hardware ACKed. */
+static int
+pc_tpg_rcg_set(const struct pc_tpg_rcg *r)
+{
+	uint32_t cfg = r->cmd + 4;
+	uint32_t cmd0 = pc_rd(pc_camcc, r->cmd);
+	uint32_t cfg0 = pc_rd(pc_camcc, cfg);
+	pc_wr(pc_camcc, r->cmd, cmd0 | PC_CMD_ROOT_EN);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, r->cmd) & PC_CMD_ROOT_OFF))
+			break;
+		pc_sleep(1);
+	}
+	uint32_t cfg_new = (cfg0 &
+	    ~(PC_CFG_SRC_SEL_MASK | PC_CFG_SRC_DIV_MASK | PC_CFG_MODE_MASK)) |
+	    (r->sel << PC_CFG_SRC_SEL_SHIFT) | r->hid;
+	pc_wr(pc_camcc, cfg, cfg_new);
+	pc_wr(pc_camcc, r->cmd, pc_rd(pc_camcc, r->cmd) | PC_CMD_UPDATE);
+	int ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, r->cmd) & PC_CMD_UPDATE)) {
+			ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	uint32_t cfg_a = pc_rd(pc_camcc, cfg);
+	printf("PANDORA TPG: rcg %s cmd=%#x cfg %#x->%#x sel=%u hid=%u update=%s\n",
+	    r->name, pc_rd(pc_camcc, r->cmd), cfg0, cfg_a,
+	    (unsigned)((cfg_a & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_a & PC_CFG_SRC_DIV_MASK), ret ? "TIMEOUT" : "acked");
+	return ret;
+}
+
+/* ---- Camera frame-buffer SMMU lease (apps-smmu@15000000, SID 0x1c00) ----
+ * Adapted from the verified pandora_wifi.c:wifi_dma_locked(): scan a free exact
+ * stream slot + a disabled unreferenced stage-1 bank + a free ASID, build a
+ * native-4K stage-1 table mapping one frame buffer to IOVA 0x100000, program the
+ * disabled context and attach the stream. Never touches the GPU kgsl-smmu or
+ * another agent's bank (the suite refuses any conflict). Held under the shared
+ * pandora_apps_smmu_lock. The mapping is kept alive (no unmap), like WiFi. */
+static vm_offset_t pc_smmu_base;
+static unsigned pc_smmu_bank, pc_smmu_slot, pc_smmu_asid;
+static uint64_t pc_smmu_ctx_off;
+static uint32_t pc_smmu_sctlr;
+static vm_offset_t pc_frame_va, pc_tables_va;
+static uint64_t pc_frame_pa, pc_tables_pa;
+static ArmSmmu4KConfig pc_table_config;
+static ArmSmmu4KResult pc_table_result;
+static ArmSmmu4KContextConfig pc_context;
+static ArmSmmu4KStreamState pc_stream_state;
+static ArmSmmu4KStreamResult pc_stream_result;
+static ArmSmmu4KProgramResult pc_prog_result;
+
+static int pc_smmu_rd32(void *c, size_t o, uint32_t *v)
+{ *v = pc_rd((vm_offset_t)c, (uint32_t)o); return 0; }
+static int pc_smmu_wr32(void *c, size_t o, uint32_t v)
+{ pc_wr((vm_offset_t)c, (uint32_t)o, v); return 0; }
+static int pc_smmu_rd64(void *c, size_t o, uint64_t *v)
+{
+	uint32_t lo = pc_rd((vm_offset_t)c, (uint32_t)o);
+	uint32_t hi = pc_rd((vm_offset_t)c, (uint32_t)o + 4);
+	*v = ((uint64_t)hi << 32) | lo;
+	return 0;
+}
+static int pc_smmu_wr64(void *c, size_t o, uint64_t v)
+{
+	pc_wr((vm_offset_t)c, (uint32_t)o, (uint32_t)v);
+	pc_wr((vm_offset_t)c, (uint32_t)o + 4, (uint32_t)(v >> 32));
+	return 0;
+}
+static int pc_smmu_barrier(void *c)
+{ (void)c; __asm__ volatile("dsb sy" ::: "memory"); return 0; }
+
+static vm_offset_t pc_contig(size_t bytes, uint64_t *pa)
+{
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, bytes, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+		return 0;
+	*pa = ptoa_64(pmap_find_phys(kernel_pmap, va));
+	return va;
+}
+
+static void pc_nocache(vm_offset_t va, size_t bytes)
+{
+	for (size_t off = 0; off < bytes; off += PAGE_SIZE)
+		pmap_set_cache_attributes(pmap_find_phys(kernel_pmap, va + off), VM_WIMG_WCOMB);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Invalidate (not clean) the data cache for a VA range so a CPU read fetches
+ * what a device DMA wrote to physical memory, discarding stale cache lines. */
+static void pc_dcache_invalidate(vm_offset_t va, size_t bytes)
+{
+	uint64_t ctr;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	uint64_t line = 4ull << ((ctr >> 16) & 0xf);
+	va &= ~(line - 1);
+	for (vm_offset_t end = va + bytes; va < end; va += line)
+		__asm__ volatile("dc ivac, %0" :: "r"(va) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+pc_tpg_smmu_map(void)
+{
+	pandora_apps_smmu_lock();
+	pc_smmu_base = ml_io_map_unmappable(PC_CAM_SMMU_PA, PC_CAM_SMMU_BYTES, VM_WIMG_IO);
+	if (!pc_smmu_base) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU map FAILED\n");
+		return ENOMEM;
+	}
+	uint32_t id0 = pc_rd(pc_smmu_base, 0x20);
+	uint32_t id1 = pc_rd(pc_smmu_base, 0x24);
+	uint32_t id2 = pc_rd(pc_smmu_base, 0x28);
+	unsigned slots = id0 & 255, banks = id1 & 255, s2banks = (id1 >> 16) & 255;
+	uint64_t page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	uint64_t cbbase = page << (((id1 >> 28) & 7) + 1);
+	printf("PANDORA TPG: SMMU id0=%#x id1=%#x id2=%#x slots=%u banks=%u s2=%u page=%#llx cbbase=%#llx\n",
+	    id0, id1, id2, slots, banks, s2banks,
+	    (unsigned long long)page, (unsigned long long)cbbase);
+	(void)pandora_log_sync();
+	if (!(id0 & (1u << 27)) || !slots || !banks || banks > 128 || s2banks >= banks ||
+	    cbbase + banks * page > PC_CAM_SMMU_BYTES || (id0 & (1u << 8))) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU unsupported layout\n");
+		return ENOTSUP;
+	}
+	bool used[128] = {false}, asid_used[256] = {false};
+	pc_smmu_slot = ~0u;
+	for (unsigned s = 0; s < slots; s++) {
+		uint32_t smr = pc_rd(pc_smmu_base, 0x800 + s * 4);
+		uint32_t s2cr = pc_rd(pc_smmu_base, 0xc00 + s * 4);
+		if (!(smr & (1u << 31))) { if (pc_smmu_slot == ~0u) pc_smmu_slot = s; continue; }
+		if (((PC_CAM_SID ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+			pandora_apps_smmu_unlock();
+			printf("PANDORA TPG: SMMU SID %#x already owned by slot %u\n", PC_CAM_SID, s);
+			return EBUSY;
+		}
+		if (((s2cr >> 16) & 3) == 0 && (s2cr & 255) < banks) used[s2cr & 255] = true;
+	}
+	pc_smmu_bank = ~0u;
+	for (unsigned b = s2banks; b < banks; b++) {
+		uint32_t ctl = pc_rd(pc_smmu_base, (uint32_t)(cbbase + b * page));
+		if (!(ctl & 1) && !used[b]) { if (pc_smmu_bank == ~0u) pc_smmu_bank = b; continue; }
+		if (ctl & 1) {
+			uint64_t ttbr = 0;
+			pc_smmu_rd64((void *)pc_smmu_base, cbbase + b * page + 0x20, &ttbr);
+			if ((ttbr >> 48) < 256) asid_used[ttbr >> 48] = true;
+		}
+	}
+	unsigned asid = 1;
+	while (asid < 256 && asid_used[asid]) asid++;
+	if (pc_smmu_slot == ~0u || pc_smmu_bank == ~0u || asid == 256) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU no free slot/bank/asid (slot=%u bank=%u asid=%u)\n",
+		    pc_smmu_slot, pc_smmu_bank, asid);
+		return EBUSY;
+	}
+	pc_smmu_asid = asid;
+	ArmSmmu4KIo io = {(void *)pc_smmu_base, PC_CAM_SMMU_BYTES,
+	    pc_smmu_rd32, pc_smmu_rd64, pc_smmu_wr32, pc_smmu_wr64, pc_smmu_barrier};
+	pc_wr(pc_smmu_base, 0xc00 + pc_smmu_slot * 4, 2u << 16);   /* S2CR -> fault */
+	ArmSmmu4KStream route = {pc_smmu_slot, PC_CAM_SID};
+	if (ArmSmmu4KCheckFaultedStreams(&io, &route, 1, pc_smmu_bank, &pc_stream_result) != ArmSmmu4KSuccess) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU CheckFaultedStreams refused\n");
+		return EBUSY;
+	}
+	pc_frame_va = pc_contig(PC_CAM_FRAME_BYTES, &pc_frame_pa);
+	pc_tables_va = pc_contig(PC_CAM_TABLE_BYTES, &pc_tables_pa);
+	if (!pc_frame_va || !pc_tables_va) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU contig alloc FAILED\n");
+		return ENOMEM;
+	}
+	pc_nocache(pc_frame_va, PC_CAM_FRAME_BYTES);
+	static const uint8_t widths[] = {32, 36, 40, 42, 44, 48};
+	unsigned encoding = (id2 >> 4) & 15;
+	if (encoding >= sizeof(widths) ||
+	    (pc_frame_pa + PC_CAM_FRAME_BYTES) >> widths[encoding] ||
+	    (pc_tables_pa + PC_CAM_TABLE_BYTES) >> widths[encoding]) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU output width unsupported\n");
+		return ENOTSUP;
+	}
+	pc_table_config = (ArmSmmu4KConfig){32, widths[encoding], pc_tables_pa,
+	    (PC_CAM_IOVA_LIMIT - PC_CAM_IOVA) / 0x1000};
+	ArmSmmu4KRange range = {PC_CAM_IOVA, pc_frame_pa, PC_CAM_FRAME_BYTES,
+	    ArmSmmu4KRead | ArmSmmu4KWrite, 0, 2};
+	if (ArmSmmu4KBuild(&pc_table_config, &range, 1, (uint64_t *)pc_tables_va,
+	    PC_CAM_TABLE_BYTES / 0x1000, &pc_table_result) != ArmSmmu4KSuccess) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU Build refused\n");
+		return ENOTSUP;
+	}
+	clean_dcache64(pc_tables_pa, PC_CAM_TABLE_BYTES, TRUE);
+	pc_context = (ArmSmmu4KContextConfig){&pc_table_config, NULL, &pc_table_result,
+	    NULL, id0, id2, asid, 0, 0, 0};
+	pc_wr(pc_smmu_base, (uint32_t)(cbbase + pc_smmu_bank * page + 4), 0);  /* ACTLR */
+	if (pc_rd(pc_smmu_base, (uint32_t)(cbbase + pc_smmu_bank * page + 4))) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU ACTLR not zero\n");
+		return EIO;
+	}
+	if (ArmSmmu4KProgramDisabledContext(&io, pc_smmu_bank, &pc_context, 1000, &pc_prog_result) != ArmSmmu4KSuccess) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU ProgramDisabledContext refused phase=%u fault=%#x\n",
+		    pc_prog_result.phase, pc_prog_result.fault_status);
+		return EIO;
+	}
+	if (ArmSmmu4KAttachStreams(&io, &pc_stream_state, &route, 1, pc_smmu_bank,
+	    &pc_context, &pc_stream_result) != ArmSmmu4KSuccess) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA TPG: SMMU AttachStreams refused phase=%u\n", pc_stream_result.phase);
+		return EIO;
+	}
+	pc_smmu_ctx_off = cbbase + pc_smmu_bank * page;
+	uint32_t ctl = pc_rd(pc_smmu_base, (uint32_t)pc_smmu_ctx_off);
+	ctl &= ~(1u << 6);   /* CFIE clear: this port has no fault IRQ dispatcher */
+	pc_wr(pc_smmu_base, (uint32_t)pc_smmu_ctx_off, ctl);
+	pc_smmu_sctlr = pc_rd(pc_smmu_base, (uint32_t)pc_smmu_ctx_off);
+	uint32_t smr = pc_rd(pc_smmu_base, 0x800 + pc_smmu_slot * 4);
+	uint32_t s2cr = pc_rd(pc_smmu_base, 0xc00 + pc_smmu_slot * 4);
+	uint32_t fsr = pc_rd(pc_smmu_base, (uint32_t)(pc_smmu_ctx_off + 0x58));
+	printf("PANDORA TPG: SMMU SID %#x -> bank %u slot %u ASID %u IOVA %#llx pa %#llx bytes %#x\n",
+	    PC_CAM_SID, pc_smmu_bank, pc_smmu_slot, pc_smmu_asid,
+	    (unsigned long long)PC_CAM_IOVA, (unsigned long long)pc_frame_pa, PC_CAM_FRAME_BYTES);
+	printf("PANDORA TPG: SMMU readback SMR=%#x S2CR=%#x SCTLR=%#x FSR=%#x frame_va=%#llx\n",
+	    smr, s2cr, pc_smmu_sctlr, fsr, (unsigned long long)pc_frame_va);
+	(void)pandora_log_sync();
+	pandora_apps_smmu_unlock();
+	return 0;
+}
+
+/* Increment 2a: drive the TPG->CSID RDI0 path far enough to observe frame
+ * events at the CSID, without VFE yet (VFE DMA is increment 2b). Spec:
+ * CAMERA_L2_TPG_IMPL_2026-11-12.md §2 (TPG v2.4.0), §3 (CSID 1080 reset/RX/RDI),
+ * §8.2 (tpg2 @0x93ff000 <-> MUX_SEL=3 <-> RX_CFG0=0x38000003). Offsets/values
+ * are factual register data; the sequence is rewritten in C. 640x480 RAW10,
+ * 4 lane. Every block is marked+synced so a bus hang on any MMIO write is
+ * pinpointed on disk. Caller gates on confirmed TPG/CSID HW versions. */
+static void
+pc_tpg_stream_2a(vm_offset_t tpg2, vm_offset_t csid0, vm_offset_t vfe0)
+{
+	/* P6 diagnostic: pre-fill the DMA buffer with a known pattern so the
+	 * post-stream readback can tell "DMA wrote here" from a stale cache. */
+	if (pc_frame_va) {
+		volatile uint32_t *fb = (volatile uint32_t *)pc_frame_va;
+		for (unsigned i = 0; i < PC_CAM_FRAME_BYTES / 4; i++) fb[i] = 0xa5a5a5a5u;
+		clean_dcache64(pc_frame_pa, PC_CAM_FRAME_BYTES, TRUE);
+		printf("PANDORA TPG: P6 prefill 0xa5a5a5a5 done frame_pa=%#llx\n",
+		    (unsigned long long)pc_frame_pa);
+		(void)pandora_log_sync();
+	}
+
+	/* ---- P2: CSID reset (§3.1), bounded poll of INFO_RST_DONE ---- */
+	pc_tpg_mark("P2: CSID reset begin");
+	pc_wr(csid0, 0x188, 0x9u);        /* TOP_IRQ_CLEAR: RST_DONE|BUF_DONE */
+	pc_wr(csid0, 0x184, 0x9u);        /* TOP_IRQ_MASK */
+	pc_wr(csid0, 0x1a8, 0x10000u);    /* BUF_DONE_IRQ_CLEAR: VC0 */
+	pc_wr(csid0, 0x1a4, 0x10000u);    /* BUF_DONE_IRQ_MASK: VC0 */
+	pc_wr(csid0, 0x110, 0x1u);        /* IRQ_CMD: clear */
+	pc_wr(csid0, 0x108, 0x11u);       /* RST_CFG: RST_LOCATION|RST_MODE */
+	pc_tpg_mark("P2: about to issue CSID_RST_CMD");
+	pc_wr(csid0, 0x10c, 0x5u);        /* RST_CMD: HW_RST|IRQ_RST */
+	unsigned rst_done = 0;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (pc_rd(csid0, 0x180) & 0x1u) { rst_done = 1; break; }
+		pc_sleep(1);
+	}
+	printf("PANDORA TPG: P2 CSID reset rst_done=%u top_irq_status=%#x\n",
+	    rst_done, pc_rd(csid0, 0x180));
+	(void)pandora_log_sync();
+	if (!rst_done) {
+		pc_tpg_mark("P2: CSID reset TIMEOUT - aborting stream (no RDI)");
+		return;
+	}
+
+	/* ---- P3: TPG v2.4.0 config (§2), 640x480 RAW10 / 4 lane ---- */
+	pc_tpg_mark("P3: TPG config begin");
+	pc_wr(tpg2, 0x1f4, 0x1u);         /* CTRL_CMD: HW_RESET (v2.4.0 reset) */
+	pc_sleep(1);
+	pc_wr(tpg2, 0x68, 0x0u);          /* VC_0_CFG0: 0 = continuous frames */
+	pc_wr(tpg2, 0x6c, 0x12345678u);   /* VC_0_LSFR_SEED */
+	pc_wr(tpg2, 0x70, 0x442u);        /* VC_0_HBI_CFG = 1090 */
+	pc_wr(tpg2, 0x74, 0x30u);         /* VC_0_VBI_CFG = 48 */
+	pc_wr(tpg2, 0x78, 0xa00u);        /* VC_0_COLOR_BARS_CFG */
+	pc_wr(tpg2, 0x7c, 0x028001e0u);   /* DT_0_CFG_0: W=640 H=480 */
+	pc_wr(tpg2, 0x80, 0x2bu);         /* DT_0_CFG_1: DATA_TYPE=RAW10 */
+	pc_wr(tpg2, 0x84, 0x20000be8u);   /* DT_0_CFG_2: payload mode 8 */
+	pc_wr(tpg2, 0x64, 0x30u);         /* CTRL: 4 lane, 1 VC (no TEST_EN) */
+	pc_tpg_mark("P3: TPG configured (TEST_EN deferred until RX/RDI/VFE ready)");
+	pc_sleep(2);
+	printf("PANDORA TPG: P3 TPG configured ctrl=%#x ctrl_cmd=%#x hw_status=%#x\n",
+	    pc_rd(tpg2, 0x64), pc_rd(tpg2, 0x1f4), pc_rd(tpg2, 0x4));
+	(void)pandora_log_sync();
+	pc_sleep(5);
+	printf("PANDORA TPG: P3 TPG cfg vc0=%#x dt0_cfg0=%#x dt0_cfg1=%#x dt0_cfg2=%#x hbi=%#x vbi=%#x bars=%#x hw_status=%#x\n",
+	    pc_rd(tpg2, 0x68), pc_rd(tpg2, 0x7c), pc_rd(tpg2, 0x80), pc_rd(tpg2, 0x84),
+	    pc_rd(tpg2, 0x70), pc_rd(tpg2, 0x74), pc_rd(tpg2, 0x78), pc_rd(tpg2, 0x4));
+	(void)pandora_log_sync();
+
+	/* ---- P4: CSID RX mux + RDI0 (§3.2/§3.3), adaptive RDI page ---- */
+	pc_tpg_mark("P4: CSID RX/RDI begin");
+	pc_wr(csid0, 0x880, 0x38032103u); /* RX_CFG0: tpg2 mux_en+sel=3, lane_assign=0x3210<<4, 4 lane */
+	pc_wr(csid0, 0x884, 0x1u);        /* RX_CFG1: ECC_CORRECTION_EN */
+	/* RDI_CFG0 writes intermittently read back 0 (2a/2b) yet latched in the
+	 * probe trial: a race against CSID reset settling, not an offset error.
+	 * Readback-verify-retry up to 50 ms, probing non-lite 0x5480 then lite
+	 * 0x3080 each pass; keep whichever latches. */
+	uint32_t rb_nl = 0, rb_l = 0;
+	uint32_t rdi_base = 0x5480;
+	bool rdi_lite = false;
+	unsigned latch_tries = 0;
+	for (unsigned try = 0; try < 50; try++) {
+		pc_wr(csid0, 0x5480, 0x002bf160u);
+		rb_nl = pc_rd(csid0, 0x5480);
+		if (rb_nl == 0x002bf160u) { rdi_base = 0x5480; rdi_lite = false; latch_tries = try + 1; break; }
+		pc_wr(csid0, 0x3080, 0x002bf160u);
+		rb_l = pc_rd(csid0, 0x3080);
+		if (rb_l == 0x002bf160u) { rdi_base = 0x3080; rdi_lite = true; latch_tries = try + 1; break; }
+		pc_sleep(1);
+	}
+	printf("PANDORA TPG: P4 RDI latch tries=%u nonlite@0x5480=%#x lite@0x3080=%#x -> base=%#x lite=%u\n",
+	    latch_tries, rb_nl, rb_l, rdi_base, (unsigned)rdi_lite);
+	(void)pandora_log_sync();
+	pc_wr(csid0, rdi_base, 0x002bf160u);         /* RDI_CFG0: payload-only RAW10 VC0 */
+	pc_wr(csid0, rdi_base + 0x14, 0x8000u);      /* RDI_CFG1: PACKING_FORMAT_MIPI */
+	if (!rdi_lite)
+		pc_wr(csid0, 0x5498, 0x9u);                /* RDI_PIX_STORE_CFG0: non-lite only */
+	pc_wr(csid0, rdi_base + 0x8, 0x0u);          /* RDI_CTRL: 0 before enable */
+	uint32_t rdi_cfg0 = pc_rd(csid0, rdi_base);
+	pc_wr(csid0, rdi_base, rdi_cfg0 | 0x80000000u); /* RDI_CFG0 EN */
+	/* CAMSS_INIT_BUF_COUNT=2 address updates, each committed via RUP_SET */
+	for (unsigned i = 0; i < 2; i++) {
+		pc_wr(csid0, 0x118, 0x100u);  /* AUP_CMD: RDI0 */
+		pc_wr(csid0, 0x11c, 0x1u);    /* RUP_AUP_CMD: RUP_SET */
+	}
+	pc_wr(csid0, 0x114, 0x100u);      /* RUP_CMD: RDI0 reg update */
+	pc_wr(csid0, 0x11c, 0x1u);        /* RUP_AUP_CMD: RUP_SET */
+	pc_tpg_mark("P4: about to start RDI0 (RDI_CTRL START_CMD)");
+	pc_wr(csid0, rdi_base + 0x8, 0x1u);          /* RDI_CTRL: START_CMD */
+	pc_sleep(2);
+	printf("PANDORA TPG: P4 RDI0 started rdi_cfg0=%#x rdi_ctrl=%#x rx_cfg0=%#x rx_irq=%#x\n",
+	    pc_rd(csid0, rdi_base), pc_rd(csid0, rdi_base + 0x8), pc_rd(csid0, 0x880), pc_rd(csid0, 0x1b0));
+	(void)pandora_log_sync();
+
+	/* ---- P5: VFE0 write-master wm=0x17 (§4), DMA dest = SMMU IOVA ----
+	 * The CSID RDI buffer address is supplied by the VFE WM (2a had no
+	 * destination, so no buf_done). BUS=0x1000, wm=0x17 -> 0x2Cxx. */
+	pc_tpg_mark("P5: VFE0 WM config begin");
+	pc_wr(vfe0, 0x1008, 0x7ffffffu);   /* WM_CGC_OVERRIDE */
+	pc_wr(vfe0, 0x1128, 0x0u);         /* WM_TEST_BUS_CTRL */
+	pc_wr(vfe0, 0x2c08, 0x5dcu);       /* WM_FRAME_INCR = (ALIGN(800,16)*480)>>8 */
+	pc_wr(vfe0, 0x2c0c, 0xffffu);      /* WM_IMAGE_CFG_0 */
+	pc_wr(vfe0, 0x2c14, 0xffffu);      /* WM_IMAGE_CFG_2 */
+	pc_wr(vfe0, 0x2c18, 0x0u);         /* WM_PACKER_CFG */
+	pc_wr(vfe0, 0x2c30, 0x0u);         /* IRQ_SUBSAMPLE_PERIOD */
+	pc_wr(vfe0, 0x2c34, 0x1u);         /* IRQ_SUBSAMPLE_PATTERN */
+	pc_wr(vfe0, 0x2c38, 0x0u);         /* FRAMEDROP_PERIOD (non-lite) */
+	pc_wr(vfe0, 0x2c3c, 0x1u);         /* FRAMEDROP_PATTERN */
+	pc_wr(vfe0, 0x2c60, 0x1u);         /* MMU_PREFETCH_CFG */
+	pc_wr(vfe0, 0x2c64, 0xffffffffu);  /* MMU_PREFETCH_MAX_OFFSET */
+	pc_wr(vfe0, 0x2c04, (uint32_t)(PC_CAM_IOVA >> 8)); /* IMAGE_ADDR = iova>>8 */
+	pc_tpg_mark("P5: about to enable VFE WM (WM_CFG)");
+	pc_wr(vfe0, 0x2c00, 0x10001u);     /* WM_CFG: EN bit0 | MODE bit16 */
+	/* VFE reg_update forwards to CSID RUP (§4.2): commit the address. */
+	pc_wr(csid0, 0x114, 0x100u);       /* CSID_RUP_CMD: RDI0 */
+	pc_wr(csid0, 0x11c, 0x1u);         /* CSID_RUP_AUP_CMD: RUP_SET */
+	pc_sleep(2);
+	printf("PANDORA TPG: P5 VFE WM wm_cfg=%#x image_addr=%#x frame_incr=%#x\n",
+	    pc_rd(vfe0, 0x2c00), pc_rd(vfe0, 0x2c04), pc_rd(vfe0, 0x2c08));
+	(void)pandora_log_sync();
+
+	/* P5b: enable TPG last (v24 order: CSID RX/RDI + VFE WM ready before the
+	 * source streams). Starting TPG before RDI config raced RDI_CFG0 access. */
+	pc_tpg_mark("P5b: start TPG (CTRL_CMD TEST_EN) after RX/RDI/VFE ready");
+	pc_wr(tpg2, 0x1f4, 0x10u);        /* CTRL_CMD: TEST_EN = start */
+	pc_sleep(2);
+	printf("PANDORA TPG: P5b TPG started ctrl=%#x ctrl_cmd=%#x hw_status=%#x\n",
+	    pc_rd(tpg2, 0x64), pc_rd(tpg2, 0x1f4), pc_rd(tpg2, 0x4));
+	(void)pandora_log_sync();
+
+	/* ---- Observe: bounded poll of BUF_DONE / RX / RDI-wrapper IRQ ---- */
+	pc_tpg_mark("P5: polling CSID BUF_DONE/RX/RDI IRQ for frame events");
+	uint32_t buf_done = 0, rx_irq = 0, rdi_irq = 0;
+	unsigned frames = 0;
+	for (unsigned i = 0; i < 200; i++) {
+		buf_done = pc_rd(csid0, 0x1a0);   /* BUF_DONE_IRQ_STATUS */
+		rx_irq = pc_rd(csid0, 0x1b0);     /* CSI2_RX_IRQ_STATUS */
+		rdi_irq = pc_rd(csid0, 0x224);    /* CSI2_RDIN_IRQ_STATUS(0): SOF/EOF/RUP */
+		if (buf_done & 0x10000u) {        /* VC0 buffer done */
+			frames++;
+			pc_wr(csid0, 0x1a8, 0x10000u); /* clear VC0 */
+		}
+		pc_sleep(1);
+	}
+	printf("PANDORA TPG: P5 RESULT frames=%u buf_done=%#x rx_irq=%#x rdi_irq=%#x top_irq=%#x\n",
+	    frames, buf_done, rx_irq, rdi_irq, pc_rd(csid0, 0x180));
+	(void)pandora_log_sync();
+	pc_tpg_mark(frames ? "P5: CSID observed TPG frame events (PASS)"
+	                   : "P5: NO CSID frame events (FAIL - check rdi_irq/mux)");
+	/* P6 judge: dump the first words of the SMMU frame buffer (color bars?).
+	 * pc_frame_va is the kernel VA of the same pages the VFE DMAs to. */
+	if (pc_frame_va) {
+		pc_dcache_invalidate(pc_frame_va, PC_CAM_FRAME_BYTES);
+		volatile uint32_t *fb = (volatile uint32_t *)pc_frame_va;
+		printf("PANDORA TPG: P6 frame[0..7]=%#x %#x %#x %#x %#x %#x %#x %#x\n",
+		    fb[0], fb[1], fb[2], fb[3], fb[4], fb[5], fb[6], fb[7]);
+		unsigned n_a5 = 0, n_ff = 0, n_00 = 0, n_other = 0, first_idx = 0;
+		uint32_t first_other = 0;
+		for (unsigned i = 0; i < PC_CAM_FRAME_BYTES / 4; i++) {
+			uint32_t w = fb[i];
+			if (w == 0xa5a5a5a5u) n_a5++;
+			else if (w == 0xffffffffu) n_ff++;
+			else if (w == 0u) n_00++;
+			else { if (!n_other) { first_other = w; first_idx = i; } n_other++; }
+		}
+		printf("PANDORA TPG: P6 scan a5=%u ff=%u zero=%u other=%u first_other[%u]=%#x\n",
+		    n_a5, n_ff, n_00, n_other, first_idx, first_other);
+		(void)pandora_log_sync();
+	}
+
+	/* Graceful stop before the caller's power-down: halt RDI0 then reset
+	 * the TPG so no block is streaming when clocks/GDSCs are pulled. */
+	pc_tpg_mark("P5: stopping VFE WM + RDI0 + TPG before teardown");
+	pc_wr(vfe0, 0x2c00, 0x0u);        /* VFE WM_CFG: disable */
+	pc_wr(csid0, rdi_base + 0x8, 0x0u); /* RDI_CTRL: stop */
+	pc_wr(tpg2, 0x1f4, 0x1u);         /* TPG CTRL_CMD: HW_RESET = stream off */
+	pc_sleep(1);
+}
