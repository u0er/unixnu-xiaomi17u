+/*
+ * 0584: flush the metadata through the mapping that owns it.
+ *
+ * flush_dcache64(pa, size, TRUE) turns the physical address into a virtual one with
+ * phystokv_range(), and that function panics for any PA outside the kernel's direct map
+ * (osfmk/arm64/arm_vm_init.c:406, "illegal PA").  The reserved PIL arena sits at 0xdf100000,
+ * below gPhysBase 0x8c0000000, so the 2026-11-26 13:33 boot died 0.226 s in, immediately after
+ * the arena's metadata line:
+ *   phystokv_range: illegal PA: 0xdf118000; phys base 0x8c0000000, size 0xbff00000
+ * (docs/MPSS3_BOOT_2026-11-26.md).  The arena is written through the VA that
+ * ml_io_map_unmappable() returned, so it is flushed through that VA: DC CIVAC over the range,
+ * then dsb sy.  No PA->VA conversion happens on this path, and kvtophys() is no alternative --
+ * it walks the same direct map and would panic on the identical address.
+ *
+ * The kmem_alloc_contig() fallback is ordinary kernel memory whose PA does map, and keeps the
+ * physical flush, which also drives the external caches through cpu_cache_dispatch.
+ */
+static void
+pas_meta_flush(vm_offset_t md, uint64_t md_pa, uint64_t size, bool reserved)
+{
+	if (reserved) {
+		FlushPoC_DcacheRegion(md, (size_t)size);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		return;
+	}
+	flush_dcache64((addr64_t)md_pa, (unsigned)size, TRUE);
+}
