+/* Give the queue window back as soon as the ladder stops needing it.
+ *
+ * Measured on this board: the TOUCH driver's 128 KiB
+ * kmem_alloc(KMA_NOFAIL|KMA_KOBJECT|KMA_ZERO) fails at 5.168 s on every boot
+ * whose ladder still holds VIDC's buffers (`failed with 3 @vm_kern.c:178` ->
+ * restart type 4), while the probe-only level 1 never panics.  Publishing has
+ * already read 0xA004C and printed the verdict by this point, so dropping the
+ * 3 MiB qtable here restores the map to the level-1 shape before the touch
+ * window opens.  The owned streams are moved to FAULT (abort, never bypass)
+ * before the free, so no DMA can reach the recycled pages; the SFR and UC
+ * pages stay allocated; the qtable IOVA is marked invalid so nothing in this
+ * build can publish it again. */
+static bool
+vidc_streams_fault(void)
+{
+    if (!vidc_smmu_on)
+        return true;                    /* nothing was routed */
+    if (!vidc_smmu_va)
+        return false;
+    ArmSmmu4KMmio mmio = { (volatile unsigned char *)vidc_smmu_va, VIDC_SMMU_SIZE };
+    ArmSmmu4KIo io;
+    ArmSmmu4KStreamResult res;
+    if (ArmSmmu4KBindMmio(&mmio, &io) != ArmSmmu4KSuccess)
+        return false;
+    pandora_apps_smmu_lock();
+    ArmSmmu4KStatus st = ArmSmmu4KFaultStreams(&io, &vidc_smmu_sstate, &res);
+    pandora_apps_smmu_unlock();
+    printf("PANDORA VIDC: SMMU streams -> FAULT: %s\n",
+        st == ArmSmmu4KSuccess ? "ok" : "refused, qtable kept");
+    return st == ArmSmmu4KSuccess;
+}
+
+static void
+vidc_release_qtable(void)
+{
+    if (!vidc_qtable_va)
+        return;
+    /* Stop the core and its translations BEFORE the pages go back to the map:
+     * a still-running VPU can DMA through 0xFF000000 into recycled pages, which
+     * panics minutes later (and that panic is what dirties the volume). */
+    vidc_wr(R_CPU_BOOT_CTRL, 0);              /* hold the VPU in reset */
+    __asm__ volatile ("dsb sy" ::: "memory");
+    delay(2000);                               /* delay() takes microseconds */
+    if (!vidc_streams_fault()) {
+        printf("PANDORA VIDC: qtable kept allocated (streams still active)\n");
+        return;
+    }
+    printf("PANDORA VIDC: releasing qtable %#x bytes before the 5.17 s window\n",
+        VIDC_QTABLE_ALLOC);
+    kmem_free(kernel_map, vidc_qtable_va, VIDC_QTABLE_ALLOC);
+    vidc_qtable_va = 0;
+    vidc_qtable_pa = 0;
+    vidc_qtable_iova = 0;
+    vidc_smmu_on = false;
+}
+
