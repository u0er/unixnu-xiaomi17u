+/* Every queue-window access must stay inside OUR allocation.  This is not
+ * belt-and-braces: vidc_sync_in/out clean or flush cache lines at
+ * `vidc_qtable_pa + off`, so an offset past the window would discard another
+ * buffer's dirty lines -- including page-cache pages -- which is exactly the
+ * silent volume corruption we must never risk.  Ring offsets also derive from
+ * `start_addr`, a field the device writes, so they are untrusted. */
+static bool vidc_qt_off_bad_logged;
+static inline bool
+vidc_qt_off_ok(uint64_t off, unsigned len)
+{
+    if (off + len <= (uint64_t)vidc_qtable_bytes) return true;
+    if (!vidc_qt_off_bad_logged) {
+        vidc_qt_off_bad_logged = true;
+        printf("PANDORA VIDC: REFUSED queue-window access off=%#llx len=%u "
+               "(window %#x) -- it would touch memory outside our allocation\n",
+            (unsigned long long)off, len, vidc_qtable_bytes);
+    }
+    return false;
+}
+
 static inline uint32_t
 vidc_qt_rd(uint32_t off)
 {
+    if (!vidc_qt_off_ok(off, 4)) return 0;
     return vidc_ld32(vidc_qtable_va, off);
 }
 
@@ -554,6 +576,7 @@ vidc_ring_rd(uint32_t ring_off, uint32_t ring_end, uint32_t off)
 static inline void
 vidc_qt_wr(uint32_t off, uint32_t v)
 {
+    if (!vidc_qt_off_ok(off, 4)) return;
     vidc_st32(vidc_qtable_va, off, v);
     __asm__ volatile ("dmb oshst" ::: "memory");
 }
