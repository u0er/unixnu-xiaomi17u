diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -642,6 +642,14 @@
 ud_if_output(ifnet_t ifp, mbuf_t m)
 {
 	lck_mtx_lock(ud.lock);
+	if (ud.personality == UD_APPLE) {
+		/* Apple personality owns the TX buffer for mux frames;
+		 * drop Ethernet output from ue0 so the two don't collide. */
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
 	if (ud.txq_count == UD_TXQ || !ud.configured) {
 		lck_mtx_unlock(ud.lock);
 		mbuf_freem(m);
@@ -982,9 +990,10 @@
 		printf("SWEET USB: personality %s (sweetusb=%d)\n",
 		    ud.personality == UD_APPLE ? "apple-usbmux" : "cdc-ecm", mode);
 	}
-	if (ud.personality == UD_ECM) {
-		ud_if_create();
-	}
+	/* Always create ue0 so userspace network configuration is happy,
+	 * even in the Apple personality where bulk endpoints carry mux
+	 * protocol instead of Ethernet frames. */
+	ud_if_create();
 
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
