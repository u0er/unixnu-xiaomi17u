+		if (bid_post == 0u || bid_post == 0xffffu) {
+			printf("PANDORA BT: 0x19 silent but BID post %04x (%s); entering the single reset+replay arm\n",
+			    bid_post,
+			    bid_post == 0u ? "ROM alive on the board-id path" :
+			    "board-id path silent, GetVer decides");
 			pandora_log_sync();
