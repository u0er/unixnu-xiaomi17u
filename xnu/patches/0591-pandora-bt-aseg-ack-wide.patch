+/* Level 20.63 (v2061): map A's tail reader - one TLV event, line noise tolerated.
+ *
+ * The shared bt_peri_wait_sub path treats any byte other than fd/fc/fe/ff as
+ * EPROTO. On the A tail the ROM emits 0xf9 as the last byte of the write
+ * (v2060 kernel @2.147: exactly one byte f9, one ms after the 284th frame),
+ * so the strict reader returned before the 1500 ms budget could apply. This
+ * reader is used by the A-tail gate only: unknown bytes are logged into the
+ * raw dump and ignored, fd still gets fc, and a 34 00 ff record is assembled
+ * normally. Silence stays bounded by the caller's deadline. */
+static int
+bt_peri_aseg_next_event(uint8_t *rx, unsigned cap, unsigned *got, uint64_t deadline,
+    uint8_t *raw, unsigned raw_cap, unsigned *raw_len)
+{
+	unsigned field = 0;
+	int err;
+
+	*got = 0;
+	for (;;) {
+		err = bt_rx_exact(rx, 1, &field, deadline);
+		if (err) {
+			return err;
+		}
+		*got = field;
+		if (rx[0] == 0x34) {
+			break;
+		}
+		if (*raw_len < raw_cap) {
+			raw[(*raw_len)++] = rx[0];
+		}
+		printf("PANDORA BT: PERI TME-L map A last segment: between-frame byte %#x tolerated (%u byte(s))\n",
+		    rx[0], *raw_len);
+		if (rx[0] == 0xfd) {
+			const uint8_t ack = 0xfc;
+
+			err = bt_uart_tx(&ack, 1, "PERI download wake ACK FC");
+			if (err) {
+				return err;
+			}
+		}
+		pandora_log_sync();
+		*got = 0;
+	}
+	err = bt_rx_exact(rx + 1, 3, &field, deadline);
+	*got += field;
+	if (err) {
+		return err;
+	}
+	if (rx[1] != 0 || rx[2] != 0xff) {
+		return EPROTO;
+	}
+	if ((unsigned)rx[3] > cap - 4u) {
+		return EMSGSIZE;
+	}
+	err = bt_rx_exact(rx + 4, rx[3], &field, deadline);
+	*got += field;
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < *got && *raw_len < raw_cap; i++) {
+		raw[(*raw_len)++] = rx[i];
+	}
+	return 0;
+}
