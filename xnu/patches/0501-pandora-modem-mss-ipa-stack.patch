diff --git a/bsd/dev/pandora_adsp.c b/bsd/dev/pandora_adsp.c
index 56132ef..5a1b7be 100644
--- a/bsd/dev/pandora_adsp.c
+++ b/bsd/dev/pandora_adsp.c
@@ -246,6 +246,42 @@ pandora_scm_call(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64
 	*a1 = r.a1;
 }
 
+/*
+ * For bsd/dev/pandora_pas.c: the three-argument form, which PAS_MEM_SETUP needs (pas, base,
+ * span).  Routes through scm_smc() like every other call in this kernel, so the
+ * SCM_INTERRUPTED retry and the WAITQ_SLEEP resume stay in one place.
+ */
+void pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t *a0);
+
+void
+pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t *a0)
+{
+	struct scm_res r;
+
+	scm_smc(fn, arginfo, x2, x3, x4, 0, &r);
+	*a0 = r.a0;
+}
+
+/*
+ * For bsd/dev/pandora_mpss.c and bsd/dev/pandora_rmtfs.c: the full form, five arguments and both
+ * result words.  SCM_MP_ASSIGN needs all five (the buffer, its owners, the permissions, their
+ * count) and its answer is read from a1, so the two-argument form above is not enough.
+ */
+void pandora_scm_call5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t x5, uint64_t *a0, uint64_t *a1);
+
+void
+pandora_scm_call5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t x5,
+    uint64_t *a0, uint64_t *a1)
+{
+	struct scm_res r;
+
+	scm_smc(fn, arginfo, x2, x3, x4, x5, &r);
+	*a0 = r.a0;
+	*a1 = r.a1;
+}
+
 static int
 scm_call_avail(unsigned svc, unsigned cmd)
 {
diff --git a/bsd/dev/pandora_fw.c b/bsd/dev/pandora_fw.c
new file mode 100644
index 0000000..e4ad7a7
--- /dev/null
+++ b/bsd/dev/pandora_fw.c
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Firmware out of the phone's own firmware partitions, in place: each partition's FAT16 is mounted
+ * read only and the files are read where they lie. There are two of them on this phone and they hold
+ * different halves, which is why this takes the partition by name:
+ *
+ *   modemfirmware_<slot>  200 MiB. image/modem.mdt + modem.b00..b25, b27, image/modem_dtb.mdt
+ *                         + modem_dtb.b00..b02, qdsp6_oemsw.mbn, qdsp6m.qdb, the modem_pr MCFG tree.
+ *                         The modem's own signed image. NOT Android's /vendor/firmware_mnt.
+ *   modem_<slot>          160 MiB. Android's /vendor/firmware_mnt: image/ipa_fws.mdt and its
+ *                         segments, the ADSP's adsp.mdt, the Wi-Fi's, the display's.
+ *
+ * Nothing is written and nothing is staged: the 67 MiB modem image does not fit the 64 MiB firmware
+ * pack and does not need to, because the kernel reads it off the partition at boot in a few seconds.
+ * The slot comes from the boot-arg pandora_slot=a|b (the Android active slot), never guessed.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "pandora_fw.h"
+#include "pandora_part.h"
+#include "qcom/FatVolume.h"
+
+#define FW_MAX_VOLUMES 3          /* the modem's, the firmware_mnt one, and one spare */
+#define FW_NAME         48
+
+static struct {
+	char part[16];
+	struct pandora_part *handle;
+	FatVolume vol;
+	int state;                        /* 0 not tried, 1 mounted, -1 not usable */
+} fw_vol[FW_MAX_VOLUMES];
+static unsigned fw_nvol;
+
+LCK_GRP_DECLARE(fw_grp, "pandora_firmware");
+LCK_MTX_DECLARE(fw_lock, &fw_grp);
+
+struct pandora_fw {
+	FatFile file;
+	uint64_t size;
+	unsigned vol;                     /* which volume it was opened on */
+};
+
+/* The slot the Android system is running from: pandora_slot=a or b, as the board's boot-args say. */
+static int
+fw_slot(char *out, size_t out_size)
+{
+	char slot[4] = "";
+	if (!PE_parse_boot_arg_str("pandora_slot", slot, sizeof(slot)) || (slot[0] != 'a' && slot[0] != 'b') ||
+	    slot[1]) {
+		printf("PANDORA FW: no boot-arg pandora_slot=a|b: the firmware partitions are not read\n");
+		return ENOENT;
+	}
+	snprintf(out, out_size, "%c", slot[0]);
+	return 0;
+}
+
+static int
+fw_part_read(void *context, uint64_t off, void *to, size_t len)
+{
+	return pandora_part_read((struct pandora_part *)context, off, to, len);
+}
+
+/* The index of the mounted volume whose GPT name begins with prefix, or -1. Caller holds fw_lock. */
+static int
+fw_vol_find(const char *prefix)
+{
+	for (unsigned i = 0; i < fw_nvol; i++) {
+		if (!strncmp(fw_vol[i].part, prefix, strlen(prefix))) {
+			return fw_vol[i].state > 0 ? (int)i : -1;
+		}
+	}
+	return -1;
+}
+
+/* Mounts prefix_<slot>'s FAT once. Caller holds fw_lock. Returns the volume index or -1. */
+static int
+fw_vol_mount(const char *prefix)
+{
+	int v = fw_vol_find(prefix);
+	if (v >= 0 || fw_nvol == FW_MAX_VOLUMES) {
+		return v;
+	}
+	char slot[2];
+	if (fw_slot(slot, sizeof(slot))) {
+		return -1;
+	}
+	v = (int)fw_nvol;
+	strlcpy(fw_vol[v].part, prefix, sizeof(fw_vol[v].part));
+	strlcat(fw_vol[v].part, "_", sizeof(fw_vol[v].part));
+	snprintf(fw_vol[v].part + strlen(fw_vol[v].part),
+	    sizeof(fw_vol[v].part) - strlen(fw_vol[v].part), "%c", slot[0]);
+	fw_vol[v].state = -1;
+	struct pandora_part *handle = NULL;
+	int err = pandora_part_open(fw_vol[v].part, &handle);
+	if (err) {
+		printf("PANDORA FW: partition %s not found: %d\n", fw_vol[v].part, err);
+		return -1;
+	}
+	/* fat_mount() reads the boot sector and stops at the cluster count it declares. */
+	err = fat_mount(&fw_vol[v].vol, pandora_part_size(handle), fw_part_read, handle);
+	if (err != FatOk) {
+		printf("PANDORA FW: %s: not a FAT volume (%d)\n", fw_vol[v].part, err);
+		pandora_part_close(handle);
+		return -1;
+	}
+	fw_vol[v].handle = handle;
+	fw_vol[v].state = 1;
+	fw_nvol++;
+	printf("PANDORA FW: %s mounted: FAT%s, %u-byte sectors, %u-byte clusters, %u clusters (%llu MiB)\n",
+	    fw_vol[v].part, fw_vol[v].vol.fat32 ? "32" : "16", fw_vol[v].vol.sector_bytes,
+	    fw_vol[v].vol.cluster_bytes, fw_vol[v].vol.clusters,
+	    ((uint64_t)fw_vol[v].vol.clusters * fw_vol[v].vol.cluster_bytes) >> 20);
+	return v;
+}
+
+/*
+ * Opens image/<name> in the partition whose GPT name begins with prefix ("modemfirmware" for the
+ * modem's own image, "modem" for Android's /vendor/firmware_mnt). Returns a handle to be given back
+ * with pandora_fw_close(); *size is the file's length.
+ */
+int
+pandora_fw_open(const char *prefix, const char *name, struct pandora_fw **out, uint64_t *size)
+{
+	if (!prefix || !name || !out || !name[0] || name[0] == '/' || strnlen(name, FW_NAME) >= FW_NAME ||
+	    strnstr(name, "..", FW_NAME)) {
+		return EINVAL;
+	}
+	*out = NULL;
+	struct pandora_fw *f = kalloc_data(sizeof(*f), Z_WAITOK | Z_ZERO);
+	if (!f) {
+		return ENOMEM;
+	}
+	char path[FW_NAME + 8];
+	snprintf(path, sizeof(path), "image/%s", name);
+	lck_mtx_lock(&fw_lock);
+	int v = fw_vol_mount(prefix);
+	int err = ENOENT;
+	if (v >= 0) {
+		int rc = fat_open(&fw_vol[v].vol, path, &f->file);
+		if (rc == FatOk && f->file.directory) {
+			rc = FatIsDirectory;
+		}
+		if (rc == FatOk) {
+			f->size = f->file.size;
+			f->vol = (unsigned)v;
+			err = 0;
+		} else if (rc != FatNotFound && rc != FatIsDirectory) {
+			err = EIO;
+		}
+		if (rc != FatOk) {
+			printf("PANDORA FW: %s: %s -> %d\n", fw_vol[v].part, path, rc);
+		}
+	}
+	lck_mtx_unlock(&fw_lock);
+	if (err) {
+		kfree_data(f, sizeof(*f));
+		return err;
+	}
+	if (size) {
+		*size = f->size;
+	}
+	*out = f;
+	return 0;
+}
+
+/* Reads len bytes at offset off of the file. */
+int
+pandora_fw_file_read(struct pandora_fw *f, uint64_t off, void *dst, uint64_t len)
+{
+	if (!f || (len && !dst) || off + len < off || off + len > f->size) {
+		return EINVAL;
+	}
+	if (!len) {
+		return 0;
+	}
+	lck_mtx_lock(&fw_lock);
+	int rc = fat_read(&fw_vol[f->vol].vol, &f->file, off, dst, (size_t)len);
+	lck_mtx_unlock(&fw_lock);
+	return rc == FatOk ? 0 : EIO;
+}
+
+void
+pandora_fw_close(struct pandora_fw *f)
+{
+	if (f) {
+		kfree_data(f, sizeof(*f));
+	}
+}
diff --git a/bsd/dev/pandora_fw.h b/bsd/dev/pandora_fw.h
new file mode 100644
index 0000000..8c65b5e
--- /dev/null
+++ b/bsd/dev/pandora_fw.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Firmware out of the phone's own firmware partitions, in place (bsd/dev/pandora_fw.c).
+ *
+ * Two partitions on this phone hold different halves and are chosen by GPT name prefix:
+ *   pandora_fw_open("modemfirmware", "modem.mdt", ...)  the modem's signed image (200 MiB, sde8)
+ *   pandora_fw_open("modem", "ipa_fws.mdt", ...)        Android's /vendor/firmware_mnt (160 MiB, sde7)
+ * The active slot comes from the boot-arg pandora_slot=a|b.
+ */
+#ifndef PANDORA_FW_H
+#define PANDORA_FW_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pandora_fw;
+
+int pandora_fw_open(const char *prefix, const char *name, struct pandora_fw **out, uint64_t *size);
+int pandora_fw_file_read(struct pandora_fw *file, uint64_t off, void *dst, uint64_t len);
+void pandora_fw_close(struct pandora_fw *file);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/pandora_ipa.c b/bsd/dev/pandora_ipa.c
new file mode 100644
index 0000000..4c780c1
--- /dev/null
+++ b/bsd/dev/pandora_ipa.c
@@ -0,0 +1,3007 @@
+/*
+ * PANDORA IPA: the Internet Packet Accelerator on canoe (IPA 5.5, GSI 2.x) -- its firmware, its
+ * registers, its local memory, the GSI channels of this processor's four endpoints, and the QMI
+ * handshake with the modem's own IPA driver.
+ *
+ * This is bsd/dev/hakios.ipa.c (the data path, IPA 4.11 on SM7325 "redwood") plus the IPA half of
+ * bsd/dev/hakios.mpss.c (the clock, the local memory, the hardware programming, the SMMU and the
+ * QMI service), ported to IPA 5.5 on SM8850 "canoe" with the X85 modem. Every number comes from
+ * work/baseband-port/ipa-v55-spec.md unless a comment says otherwise, and every place where this
+ * port departs from that spec, or where the spec itself was not certain, carries a PORTER'S NOTE.
+ *
+ * What the IPA is, for this side (the four endpoints of execution environment 0, the application
+ * processor's):
+ *
+ *   command  ch 12, ep 14, toward the IPA  immediate commands: where the tables are
+ *   lan-rx   ch 13, ep 16, from the IPA   the default route and its exceptions; looked at, dropped
+ *   modem-tx ch 11, ep  2, toward the IPA IP packets to the modem, 4-byte QMAP header in front
+ *   modem-rx ch  1, ep 23, from the IPA   IP packets from the modem, QMAP-framed, aggregated
+ *
+ * A channel is a ring of 16-byte transfer elements (TREs) that this processor fills and the GSI
+ * consumes, and an event ring the GSI fills with one event per finished TRE. A doorbell tells the
+ * GSI how far the ring is filled; the event ring's write pointer, read from a register, tells us
+ * how far it got. No interrupt is taken: the link thread polls (pandora_ipa_poll()). That is what
+ * HakiOS did and it avoids mapping the IPA's GIC interrupts on this platform.
+ *
+ * The order matters and is the spec's section 9.5: registers, clock, SMMU, firmware, local memory,
+ * hardware, data path, QMI. The modem is started by pandora_mpss.c afterwards and reads what this
+ * file left in the IPA's local memory.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <arm/caches_internal.h>
+#include "pandora_modem.h"
+#include "pandora_pas.h"
+#include "pandora_qrtr.h"
+#include "pandora_ipa.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern uint64_t kvtophys(vm_offset_t);
+extern void flush_dcache64(addr64_t, unsigned, int);
+
+/*
+ * pandora_adsp.c's RPMh and SCM helpers. The names are the ones pandora_modem.h does not carry
+ * because only the ADSP's and this file's code use them; they are exported from pandora_adsp.c
+ * for exactly this.
+ *
+ * pandora_scm_call() and its three- and five-argument forms go through scm_smc(), which serialises
+ * every SCM call in this kernel on ad_scm_lock and handles SCM_INTERRUPTED and a queued
+ * (WAITQ_SLEEP) call. The PAS calls below must go through it: on this platform the ADSP's
+ * shm_bridge_enable and the GPU's is_call_avail met in TrustZone 0.18 s apart and every later call
+ * came back 2 (pandora_adsp.c:195-206). A hand-rolled "smc #0" here would reintroduce that.
+ */
+extern void pandora_scm_call(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t *a0, uint64_t *a1);
+extern void pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t *a0);
+extern int pandora_rpmh_resource(const char *, uint32_t, uint32_t);
+extern int pandora_rpmh_arc(const char *name, uint32_t level);
+extern void pandora_rpmh_lock(void);
+extern void pandora_rpmh_unlock(void);
+extern void pandora_apps_smmu_lock(void);
+extern void pandora_apps_smmu_unlock(void);
+/*
+ * Ending this file's polling thread from inside it. Not in <kern/thread.h> under this name: the
+ * header has thread_terminate_self() and the internal forms, while pandora_adsp.c and pandora_amp.c
+ * both declare thread_terminate() themselves and this file does the same (pandora_adsp.c:58).
+ */
+extern kern_return_t thread_terminate(thread_t);
+
+static LCK_GRP_DECLARE(ipa_grp, "pandora-ipa");
+static LCK_MTX_DECLARE(ipa_lock, &ipa_grp);
+
+/* =====================================================================================
+ * 1. Where the IPA and the GSI are, and the boot arguments that move them
+ *
+ * canoe (device-recon/07-dt-ipa.txt): the node whose compatible is "qcom,ipa" has
+ *   reg = <0x3e00000 0x84000>, <0x3e04000 0xfc000>   -- "ipa-base" and "gsi-base"
+ * and qcom,ipa-hw-ver = 0x18 (24: IPA 5.5). The GSI window's 0xfc000 is the whole of what the
+ * GSI block answers to; this file maps 0x30000 of it, which reaches CNTXT_SCRATCH_0 at 0x25400.
+ * ===================================================================================== */
+
+#define IPA_REGS_PA_DEFAULT     0x3e00000ull
+#define IPA_REGS_SIZE           0x30000         /* to IPA_IRQ_STTS at 0xc008 and the ENDP registers at 0x1b88+ */
+
+#define GSI_PA_DEFAULT          0x3e04000ull
+#define GSI_SIZE                0x30000         /* to CNTXT_SCRATCH_0 (0x25400); 4.11's 0x7000 stopped at 0x13000 */
+
+/*
+ * IPA 5.5's local memory: Linux's ipa_mem_data.imem_addr / imem_size (ipa_data-v5.5.c). The IPA
+ * reaches it through the SMMU as a device; this side maps it to read the microcontroller's
+ * "booted" byte and to write the region table's canaries.
+ *
+ * PORTER'S NOTE (spec 3.3, the least certain thing in the port): canoe's devicetree has no
+ * "ipa-shared" reg at all -- only "ipa-base" and "gsi-base". Android maps the local memory a
+ * second way, as ipa_smmu_ap's qcom,additional-mapping = <0x14683000 0x2000>, while Linux's
+ * ipa_data-v5.5.c says 0x14688000. Both are mapped here (0x10000 from 0x14680000 covers both),
+ * the SHARED_MEM_SIZE register decides the offset within it, and the register window is
+ * boot-arg overridable in case neither is right. The check that settles it is the
+ * microcontroller's "booted" byte at sram + mem_offset + 0x1000 + 0x0c (spec 5.9 item 6).
+ */
+#define IPA_SRAM_PA_DEFAULT     0x14688000ull
+#define IPA_SRAM_SIZE           0x10000
+
+/*
+ * The firmware's carveout: ipa_gsi_region@99590000, 0xa000 (device-recon, reserved-memory). This
+ * is the region Android's PIL uses for ipa_fws -- HakiOS recorded that loading it at the
+ * ipa_fw_region (0x99580000 here, 0x8b700000 there) starts GSI but the microcontroller never
+ * writes "booted" and the modem never answers INIT_DRIVER (hakios.mpss.c:1803-1808), and that
+ * loading it at ipa_gsi did work.
+ */
+#define IPA_FW_PA_DEFAULT       0x99590000ull
+#define IPA_FW_SIZE_DEFAULT     0xa000u
+#define IPA_PAS                 15u             /* dt: qcom,pas-id of qcom,ipa_fws = 0x0f */
+
+/* The two apps-SMMU stream ids of the IPA (device-recon/64-iommu-groups-ipa.txt). */
+#define IPA_STREAM_AP_DEFAULT   0x4a0u
+#define IPA_STREAM_UC_DEFAULT   0x4a2u
+
+/* Apps SMMU: apps-smmu@15000000, "qcom,qsmmu-v500", reg 0x100000 (device-recon/41-smmu-gsi-ofnode.txt). */
+#define APPS_SMMU_PA            0x15000000ull
+#define APPS_SMMU_SIZE          0x100000ull
+
+/* The one gigabyte of DDR the IPA is shown as it is, and the 2 MB block holding the imem. */
+#define IPA_SPACE_BASE          0x80000000ull
+#define IPA_IMEM_DEFAULT        0x14600000u
+
+/* ---- the execution environment, the register offsets ---------------------------------- */
+
+/*
+ * EE0 is the application processor's (ipa_version.h: GSI_EE_AP = 0), so every "+ stride * EE"
+ * term of the GSI's register file is zero here and the offsets below are absolute. 4.11's file
+ * had these laid out from 0xf000 with a 0x4000 stride; 5.0 moved the whole block up and widened
+ * the stride (spec 2.2, from reg/gsi_reg-v5.0.c, which is what gsi.c uses for v5.5 too).
+ */
+#define GSI_CH_CNTXT(c, n)      (0x14000 + 0x80 * (c) + 4 * (n))
+#define GSI_CH_QOS(c)           (0x14048 + 0x80 * (c))
+#define GSI_CH_SCRATCH(c, n)    (0x1404c + 0x80 * (c) + 4 * (n))
+#define GSI_EV_CNTXT(e, n)      (0x1c000 + 0x80 * (e) + 4 * (n))
+#define GSI_CH_DOORBELL(c)      (0x24000 + 8 * (c))
+#define GSI_EV_DOORBELL(e)      (0x24800 + 8 * (e))
+#define GSI_STATUS              0x25000
+#define GSI_CH_CMD              0x25008
+#define GSI_EV_CH_CMD           0x25010
+#define GSI_CNTXT_TYPE_IRQ      0x25080
+#define GSI_CNTXT_TYPE_IRQ_MSK  0x25088
+#define GSI_CNTXT_SRC_CH_IRQ    0x25090
+#define GSI_CNTXT_SRC_CH_IRQ_MSK 0x25094
+#define GSI_CNTXT_SRC_CH_IRQ_CLR 0x25098
+#define GSI_CNTXT_SRC_EV_CH_IRQ 0x2509c
+#define GSI_CNTXT_SRC_EV_CH_IRQ_MSK 0x250a0
+#define GSI_CNTXT_SRC_EV_CH_IRQ_CLR 0x250a4
+#define GSI_CNTXT_SRC_IEOB_IRQ  0x250a8
+#define GSI_CNTXT_SRC_IEOB_IRQ_MSK 0x250ac
+#define GSI_CNTXT_SRC_IEOB_IRQ_CLR 0x250b0
+#define GSI_CNTXT_GLOB_IRQ_STTS 0x25200
+#define GSI_CNTXT_GLOB_IRQ_EN   0x25204
+#define GSI_CNTXT_GLOB_IRQ_CLR  0x25208
+#define GSI_CNTXT_GSI_IRQ_STTS  0x2520c
+#define GSI_CNTXT_GSI_IRQ_EN    0x25210
+#define GSI_CNTXT_GSI_IRQ_CLR   0x25214
+#define GSI_CNTXT_INTSET        0x25220
+#define GSI_ERROR_LOG           0x25240
+#define GSI_ERROR_LOG_CLR       0x25244
+/*
+ * The inter-EE masks swapped places between 4.11 and 5.0 (spec 2.2): the channel mask is the odd
+ * one now. Both are only ever written zero here (every interrupt is off), so the consequence of
+ * getting them wrong is small, but they are written right.
+ */
+#define GSI_INTER_EE_SRC_CH_IRQ_MSK    0xc01c
+#define GSI_INTER_EE_SRC_EV_CH_IRQ_MSK 0xc028
+
+/* GSI_CFG and MCS_CFG: the two registers that say whether the firmware really started (spec 2.10). */
+#define GSI_CFG                 0x000
+#define GSI_MCS_CFG             0xb000
+#define GSI_HW_PARAM_2          0x25040
+#define GSI_HW_PARAM_4          0x25050
+
+/* Channel and event-ring states (context register bits 23:20). */
+#define CH_STATE_NOT_ALLOCATED  0
+#define CH_STATE_ALLOCATED      1
+#define CH_STATE_STARTED        2
+#define CH_STATE_STOPPED        3
+#define EV_STATE_NOT_ALLOCATED  0
+#define EV_STATE_ALLOCATED      1
+
+/* Channel commands (CH_CMD / EV_CH_CMD: opcode in bits 31:24, the id in 7:0 -- unchanged in 5.0). */
+#define GSI_CH_ALLOCATE         0x0
+#define GSI_CH_START            0x1
+#define GSI_CH_STOP             0x2
+#define GSI_CH_RESET            0x9
+#define GSI_CH_DE_ALLOC         0xa
+#define GSI_EVT_ALLOCATE        0x0
+#define GSI_EVT_RESET           0x9
+#define GSI_EVT_DE_ALLOC        0xa
+
+#define GSI_CHANNEL_TYPE_GPI    2
+#define ELEMENT_SIZE            16
+
+/* ---- the IPA's own registers (spec section 4: every one of these moved from 4.11) ------- */
+
+#define IPA_FLAVOR_0            0x000
+#define IPA_COMP_CFG            0x048
+#define IPA_CLKON_CFG           0x050
+#define IPA_ROUTE               0x054
+#define IPA_SHARED_MEM_SIZE     0x05c           /* 4.11 had this at 0x54, which is ROUTE here */
+#define IPA_QSB_MAX_WRITES      0x070
+#define IPA_QSB_MAX_READS       0x074
+#define IPA_FILT_ROUT_CACHE_FLUSH 0x404         /* 4.11's FILT_ROUT_HASH_FLUSH (0x14c) is gone in 5.0 */
+#define IPA_LOCAL_PKT_PROC_CNTXT 0x478          /* 4.11: 0x1e8 */
+#define IPA_IDLE_INDICATION_CFG 0x4a8
+#define IPA_QTIME_TIMESTAMP_CFG 0x4ac
+#define IPA_TIMERS_XO_CLK_DIV_CFG 0x4b0
+#define IPA_TIMERS_PULSE_GRAN_CFG 0x4b4
+#define IPA_SRC_RSRC_GRP_01(n)  (0x500 + 0x20 * (n))    /* x_min [5:0] x_max [13:8] y_min [21:16] y_max [29:24] */
+#define IPA_SRC_RSRC_GRP_23(n)  (0x504 + 0x20 * (n))
+#define IPA_DST_RSRC_GRP_01(n)  (0x600 + 0x20 * (n))    /* 4.11 had the destinations at 0x500 */
+#define IPA_DST_RSRC_GRP_23(n)  (0x604 + 0x20 * (n))
+#define RSRC(xmin, xmax, ymin, ymax) \
+	((uint32_t)(xmin) | (uint32_t)(xmax) << 8 | (uint32_t)(ymin) << 16 | (uint32_t)(ymax) << 24)
+
+/*
+ * The endpoint registers: stride 0x80 from 0x1008 (4.11: 0x70 from 0x808). This is not a shift
+ * but a relayout: ENDP_INIT_CFG(23), the modem receive endpoint, is at 0x1008 + 0x80*23 = 0x1b88,
+ * where 4.11's formula gives 0x1a18. That is why IPA_REGS_SIZE above is 0x30000 and not 4.11's
+ * 0x1000 -- writing 4.11's size here would be an out-of-window write on the twenty-third endpoint.
+ */
+#define IPA_ENDP_INIT_CFG(ep)           (0x1008 + 0x80 * (ep))
+#define IPA_ENDP_INIT_NAT(ep)           (0x100c + 0x80 * (ep))
+#define IPA_ENDP_INIT_HDR(ep)           (0x1010 + 0x80 * (ep))
+#define IPA_ENDP_INIT_HDR_EXT(ep)       (0x1014 + 0x80 * (ep))
+#define IPA_ENDP_INIT_HDR_METADATA_MASK(ep) (0x1018 + 0x80 * (ep))
+#define IPA_ENDP_INIT_MODE(ep)          (0x1020 + 0x80 * (ep))
+#define IPA_ENDP_INIT_AGGR(ep)          (0x1024 + 0x80 * (ep))
+#define IPA_ENDP_INIT_HOL_BLOCK_EN(ep)  (0x102c + 0x80 * (ep))
+#define IPA_ENDP_INIT_DEAGGR(ep)        (0x1034 + 0x80 * (ep))
+#define IPA_ENDP_INIT_RSRC_GRP(ep)      (0x1038 + 0x80 * (ep))
+#define IPA_ENDP_INIT_SEQ(ep)           (0x103c + 0x80 * (ep))
+#define IPA_ENDP_STATUS(ep)             (0x1040 + 0x80 * (ep))
+
+/* ---- what Android's driver and Linux's put in those registers (spec 4.4) ---------------- */
+
+/* ENDP_INIT_MODE.ENDP_MODE: 0 is IPA_BASIC, 3 is IPA_DMA. */
+#define IPA_MODE_BASIC          0u
+#define IPA_MODE_DMA            3u
+/* ENDP_INIT_SEQ.SEQ_TYPE */
+#define IPA_SEQ_DMA                    0x00
+#define IPA_SEQ_2_PASS_SKIP_LAST_UC    0x04
+/* ENDP_INIT_AGGR.AGGR_EN */
+#define IPA_AGGR_BYPASS         0u
+#define IPA_AGGR_ENABLE         1u
+#define IPA_AGGR_DEAGGR         2u
+/* ENDP_INIT_AGGR.AGGR_TYPE */
+#define IPA_AGGR_GENERIC        4u
+#define IPA_AGGR_QCMAP          6u
+
+/* The immediate-command opcodes the command endpoint carries. */
+#define IPA_CMD_IP_V4_FILTER_INIT  0x3
+#define IPA_CMD_IP_V6_FILTER_INIT  0x4
+#define IPA_CMD_IP_V4_ROUTING_INIT 0x7
+#define IPA_CMD_IP_V6_ROUTING_INIT 0x8
+#define IPA_CMD_HDR_INIT_LOCAL     0x9
+
+/* =====================================================================================
+ * 2. The boot arguments
+ *
+ * Every one is pandora_ipa_<name>, parsed with PE_parse_boot_argn exactly as pandora_mpss.c's
+ * option() does. HakiOS's names (modem_ipa_*, soc_ipa_*) are accepted as aliases by option()
+ * below so that an existing boot command line still works.
+ * ===================================================================================== */
+
+static uint64_t ipa_regs_pa = IPA_REGS_PA_DEFAULT;
+static uint64_t gsi_pa = GSI_PA_DEFAULT;
+static uint64_t ipa_sram_pa = IPA_SRAM_PA_DEFAULT;
+static uint64_t ipa_fw_pa = IPA_FW_PA_DEFAULT;
+static uint32_t ipa_fw_size = IPA_FW_SIZE_DEFAULT;
+static uint32_t ipa_stream = IPA_STREAM_AP_DEFAULT;
+static uint32_t ipa_stream_uc = IPA_STREAM_UC_DEFAULT;
+static uint32_t ipa_routes = 11;                /* Linux v5.5's modem_route_count */
+
+static bool ipa_trace, ipa_quiet;
+static bool ipa_no_status = true;               /* spec 4.4: ENDP_STATUS off for a first version */
+static bool ipa_status_on;                      /* pandora_ipa_status_on=1 asks for them anyway */
+static bool ipa_up;                             /* the whole bring-up got through */
+static bool ipa_claimed;                        /* so a second call does nothing */
+static volatile bool ipa_stopping;
+
+/* A boot argument of ours: pandora_ipa_<name>. */
+static bool
+ipa_option(const char *name)
+{
+	char full[48];
+	uint32_t on = 0;
+
+	snprintf(full, sizeof(full), "pandora_ipa_%s", name);
+	if (PE_parse_boot_argn(full, &on, sizeof(on))) {
+		return on != 0;
+	}
+	/*
+	 * PORTER'S NOTE: HakiOS's names, kept working. Its scripts and the notes in
+	 * work/baseband-port talk in modem_ipa_* and soc_ipa_*, and a boot command line that
+	 * already had one of those should not silently turn a feature off because this file
+	 * invented a new prefix.
+	 */
+	snprintf(full, sizeof(full), "modem_ipa_%s", name);
+	if (PE_parse_boot_argn(full, &on, sizeof(on))) {
+		return on != 0;
+	}
+	snprintf(full, sizeof(full), "soc_ipa_%s", name);
+	return PE_parse_boot_argn(full, &on, sizeof(on)) && on != 0;
+}
+
+/* The same, for the arguments that carry a value rather than a yes. */
+static bool
+ipa_arg(const char *name, void *value, size_t size)
+{
+	char full[48];
+
+	snprintf(full, sizeof(full), "pandora_ipa_%s", name);
+	if (PE_parse_boot_argn(full, value, (uint32_t)size)) {
+		return true;
+	}
+	snprintf(full, sizeof(full), "modem_ipa_%s", name);
+	if (PE_parse_boot_argn(full, value, (uint32_t)size)) {
+		return true;
+	}
+	snprintf(full, sizeof(full), "soc_ipa_%s", name);
+	return PE_parse_boot_argn(full, value, (uint32_t)size);
+}
+
+static void
+ipa_boot_args(void)
+{
+	(void)ipa_arg("regs", &ipa_regs_pa, sizeof(ipa_regs_pa));
+	(void)ipa_arg("gsi", &gsi_pa, sizeof(gsi_pa));
+	(void)ipa_arg("sram", &ipa_sram_pa, sizeof(ipa_sram_pa));
+	(void)ipa_arg("fw_at", &ipa_fw_pa, sizeof(ipa_fw_pa));
+	(void)ipa_arg("fw_size", &ipa_fw_size, sizeof(ipa_fw_size));
+	(void)ipa_arg("stream", &ipa_stream, sizeof(ipa_stream));
+	(void)ipa_arg("stream_uc", &ipa_stream_uc, sizeof(ipa_stream_uc));
+	(void)ipa_arg("routes", &ipa_routes, sizeof(ipa_routes));
+	ipa_trace = ipa_option("trace");
+	ipa_quiet = ipa_option("quiet");
+	/*
+	 * Status packets are off by default, which is the spec's pandora_ipa_no_status=1 for a first
+	 * version: ENDP_STATUS is what tells the modem's driver about flow control and checksum results
+	 * on what we send it, and nothing here handles the status packets that come back through the
+	 * LAN endpoint (spec 4.4). HakiOS ran IPA 4.11 with them off entirely.
+	 *
+	 * Both spellings of the switch work: pandora_ipa_no_status=1 keeps them off (and the argument
+	 * being absent does the same thing, which is why the default is true and only an explicit
+	 * zero turns them on), and pandora_ipa_status_on=1 turns them on. The second one exists because
+	 * "=0 to enable" is easy to get wrong on a boot command line.
+	 */
+	{
+		uint32_t off = 1;
+
+		if (ipa_arg("no_status", &off, sizeof(off)) && off == 0) {
+			ipa_no_status = false;
+		}
+	}
+	ipa_status_on = ipa_option("status_on");
+	if (ipa_status_on) {
+		ipa_no_status = false;
+	}
+	if (!ipa_no_status) {
+		/* 21 is the modem's own AP-receive endpoint, where its driver's status comes back. */
+		printf("PANDORA IPA: status packets are ON: the modem transmit endpoint reports to endpoint 21\n");
+	}
+}
+
+/* =====================================================================================
+ * 3. Getting at the registers, and at memory the hardware reads and writes
+ * ===================================================================================== */
+
+static vm_offset_t ipa_regs;                    /* IPA_REGS_SIZE bytes of IPA registers */
+static vm_offset_t gsi_regs;                    /* GSI_SIZE bytes of GSI registers */
+
+/*
+ * A window of device registers, mapped uncached. ml_io_map_unmappable() is what every driver in
+ * this tree uses for a window whose size is not known at compile time (pandora_adsp.c's ad_map(),
+ * pandora_pas.c's carveout mapping); ml_io_map() would do for a fixed size but this is the same
+ * call they make and it rounds the length up to a page itself.
+ */
+static vm_offset_t
+ipa_map(uint64_t pa, uint64_t len)
+{
+	return ml_io_map_unmappable((vm_offset_t)pa, (vm_size_t)((len + 0xfff) & ~0xfffull), VM_WIMG_IO);
+}
+
+/*
+ * The barriers are pandora_adsp.c's ad_rd()/ad_wr() (its :130-146), which are Linux's
+ * readl()/writel() on arm64: a load-load barrier after the read, a store-store barrier before the
+ * write and a full system barrier after it. The GSI's doorbells in particular must not be
+ * reordered with the TRE that precedes them.
+ */
+static inline uint32_t
+ipa_rd(uint32_t offset)
+{
+	uint32_t v = *(volatile uint32_t *)(ipa_regs + offset);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+ipa_wr(uint32_t offset, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ipa_regs + offset) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static inline uint32_t
+gsi_rd(uint32_t offset)
+{
+	uint32_t v = *(volatile uint32_t *)(gsi_regs + offset);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+gsi_wr(uint32_t offset, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(gsi_regs + offset) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* One page of zeroed kernel memory, written back, with its physical address: what a ring or a
+ * page of buffers is made of. HakiOS's dma_page(), hakios.ipa.c:172-183. */
+struct dma {
+	vm_offset_t     virt;
+	uint64_t        phys;
+};
+
+static bool
+dma_page(struct dma *d)
+{
+	vm_offset_t virt = 0;
+
+	if (kmem_alloc(kernel_map, &virt, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	d->virt = virt;
+	d->phys = kvtophys(virt);
+	FlushPoC_DcacheRegion(virt, PAGE_SIZE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
+}
+
+/*
+ * Written back and dropped from the cache: before the hardware reads what we wrote, and before we
+ * read what the hardware wrote. HakiOS's dma_sync(), hakios.ipa.c:188-198, which is FlushPoC's
+ * "dc civac" (clean and invalidate to the point of coherency) widened to whole cache lines.
+ *
+ * PORTER'S NOTE: the cache maintenance is right for this core (A710 is PIPT, so a clean and
+ * invalidate needs no separate invalidate pass first), and it is what pandora_pas.c's
+ * flush_dcache64(pa, len, TRUE) does -- but FlushPoC_DcacheRegion takes a virtual address and
+ * flush_dcache64 a physical one, and every buffer here is kernel_map memory that the kernel may
+ * have mapped more than once. The virtual form is the right one for kernel_map pages, so that is
+ * what is used.
+ */
+static inline void
+dma_sync(vm_offset_t virt, size_t size)
+{
+	vm_offset_t from = virt & ~63ul;
+
+	FlushPoC_DcacheRegion(from, ((virt + size + 63) & ~63ul) - from);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---- the channels ---------------------------------------------------------------------- */
+
+/*
+ * A transfer element, and the event the GSI writes when one finishes. Both are 16 bytes and both
+ * layouts are the GSI protocol's, unchanged from 4.11 to 5.5 (spec 7.1): there is a BUILD_BUG_ON
+ * on sizeof(struct gsi_event) == 16 in Linux's gsi.c for exactly this reason. HakiOS's struct tre
+ * and struct event, hakios.ipa.c:198-218, verbatim.
+ */
+struct tre {
+	uint64_t        addr;           /* the buffer's physical address, or the command payload's */
+	uint16_t        len_opcode;     /* bytes to move, or the immediate command's opcode */
+	uint16_t        reserved;
+	uint32_t        flags;          /* TRE_* */
+};
+
+struct event {
+	uint64_t        xfer;           /* the address of the TRE that finished -- an address, not an index */
+	uint16_t        len;            /* bytes moved (for a receive, what the buffer got) */
+	uint8_t         reserved1;
+	uint8_t         code;           /* completion code; 0 is success */
+	uint16_t        reserved2;
+	uint8_t         type;
+	uint8_t         chid;
+};
+
+#define TRE_CHAIN               (1u << 0)       /* this TRE is followed by another of the transaction */
+#define TRE_IEOT                (1u << 9)       /* an event when it finishes */
+#define TRE_BEI                 (1u << 10)      /* ... but no interrupt; we poll */
+#define TRE_TYPE_XFER           (2u << 16)      /* a move */
+#define TRE_TYPE_COMMAND        (3u << 16)      /* an immediate command */
+
+/*
+ * The four channels of execution environment 0.
+ *
+ * The numbers are Linux's ipa_gsi_endpoint_data[] for IPA 5.5 (ipa_data-v5.5.c:63-183), which is
+ * the authority (spec 1.6):
+ *
+ *   channel_id, endpoint_id, toward_ipa, tre, event, tlv, rsrc_grp,   qmap,  aggr,  status
+ *   { 12, 14, true,   64,  64,  20, 0 = SRC_UL, false, false, false },  AP_COMMAND_TX
+ *   { 13, 16, false,  64,  64,   9, 0 = DST_UL, false, true,  true  },  AP_LAN_RX
+ *   { 11,  2, true,  128, 128,  25, 0 = SRC_UL, true,  false, true  },  AP_MODEM_TX
+ *   {  1, 23, false, 128, 128,   9, 1 = DST_DL, true,  true,  false },  AP_MODEM_RX
+ *
+ * The rings here are smaller powers of two than Linux's, which the GSI allows (it requires a power
+ * of two and nothing more); tlv is how many TREs may be outstanding on a channel and must not
+ * exceed Linux's, so those are Linux's values exactly.
+ *
+ * Note AP_MODEM_RX's resource group is 1 (DST_DL), not 0. HakiOS wrote 0 for every endpoint
+ * (hakios.ipa.c:442), which on 4.11 was right because both groups had the same limits; on 5.5 the
+ * downlink group has its own and an endpoint in the wrong one has no quota (spec 4.7).
+ */
+struct channel {
+	const char *    name;
+	uint8_t         id, ring_id, endpoint;  /* the GSI channel, its event ring, the IPA's endpoint */
+	bool            to_ipa;                 /* this processor writes the TREs and the IPA consumes them */
+	bool            command;                /* the immediate-command endpoint */
+	bool            qmap;                   /* the traffic carries a QMAP header */
+	bool            aggregate;              /* the IPA aggregates on receive */
+	bool            close_eof;              /* ... and closes a buffer at the end of a packet */
+	bool            status;                 /* the endpoint may generate status packets */
+	uint32_t        slots;                  /* TREs in the ring, and (for receive) buffers */
+	uint32_t        tlv;                    /* the endpoint's TLV FIFO depth */
+	uint32_t        buffer_size;            /* bytes per slot */
+	uint8_t         resource_group;
+	struct dma      tre_ring, event_ring;
+	struct dma *    pages;                  /* the data buffers, a page at a time */
+	uint32_t        page_count;
+	uint32_t        next;                   /* the next TRE to fill (counts up; the slot is next % slots) */
+	uint32_t        done;                   /* the next TRE whose completion is awaited */
+	uint32_t        events;                 /* the next event to read (counts up) */
+	bool            started;
+	uint64_t        packets, bytes, dropped, errors;
+};
+
+/*
+ * The receive buffer is Linux's rx.buffer_size for both receive endpoints, 8192 (spec 1.2, 1.4).
+ * HakiOS used a whole 16 KB page and refused to run at all if PAGE_SIZE was not 16384
+ * (hakios.ipa.c:238, :806-809); that assertion is gone with the buffer size.
+ */
+#define RECEIVE_BUFFER          8192
+#define COMMAND_BUFFER          4096           /* one immediate command's payload fits many times over */
+
+/*
+ * The aggregation parameters, from Linux's data table through spec 4.5:
+ *
+ *   BYTE_LIMIT 6 KB -- ipa_aggr_size_kb(8192 - IPA_MTU(1500) - IPA_RX_BUFFER_OVERHEAD(0)) = 6,
+ *                      HakiOS's 12 was for a 16 KB buffer;
+ *   TIME_LIMIT 5     -- aggr_time_limit_encode(500 us) with the first pulse generator at 100 us,
+ *                      which lands on exactly the 5 HakiOS had.
+ *
+ * The register's field layout did not move between 4.11 and 5.5 (spec 4.4): AGGR_EN[1:0],
+ * AGGR_TYPE[4:2], BYTE_LIMIT[10:5], TIME_LIMIT[16:12], SW_EOF_ACTIVE[23].
+ */
+#define AGGR_LIMIT_KB           6
+#define AGGR_TIME_TICKS         5
+
+static struct channel command = {
+	.name = "command", .id = 12, .ring_id = 0, .endpoint = 14,
+	.to_ipa = true, .command = true, .qmap = false, .aggregate = false, .close_eof = false,
+	.slots = 64, .tlv = 20, .buffer_size = COMMAND_BUFFER, .resource_group = 0,
+};
+static struct channel lan_rx = {
+	.name = "lan-rx", .id = 13, .ring_id = 1, .endpoint = 16,
+	.to_ipa = false, .qmap = false, .aggregate = true, .status = true,
+	.slots = 64, .tlv = 9, .buffer_size = RECEIVE_BUFFER, .resource_group = 0,
+};
+static struct channel modem_tx = {
+	.name = "modem-tx", .id = 11, .ring_id = 2, .endpoint = 2,
+	.to_ipa = true, .qmap = true, .status = true,
+	.slots = 128, .tlv = 25, .buffer_size = 2048, .resource_group = 0,
+};
+static struct channel modem_rx = {
+	.name = "modem-rx", .id = 1, .ring_id = 3, .endpoint = 23,
+	.to_ipa = false, .qmap = true, .aggregate = true, .close_eof = true,
+	.slots = 128, .tlv = 9, .buffer_size = RECEIVE_BUFFER, .resource_group = 1,
+};
+static struct channel *channels[] = { &command, &lan_rx, &modem_tx, &modem_rx };
+#define IPA_CHANNELS (sizeof(channels) / sizeof(channels[0]))
+
+/*
+ * The endpoints this file does not program, for the QMI and DPM narratives (spec 1.5). The modem's
+ * own execution environment allocates their GSI channels; only their numbers are used here.
+ */
+#define IPA_EP_MODEM_AP_TX      12              /* ch 0, toward the IPA, filters */
+#define IPA_EP_MODEM_AP_RX      21              /* ch 7, from the IPA */
+#define IPA_EP_MODEM_DL_NLO_TX  15              /* ch 2, toward the IPA, filters */
+
+/* =====================================================================================
+ * 4. The GSI: rings, commands, channel and event-ring programming
+ *
+ * The order in channel_setup() below is Linux's (gsi_evt_ring_program() then
+ * gsi_channel_program()) and HakiOS's (:362-397): allocate the event ring, write its context,
+ * ring its doorbell, allocate the channel, write its context, its QOS and its scratch. The
+ * contexts may only be written once the ring is ALLOCATED, which is why the commands are
+ * interleaved with the writes (spec 2.7).
+ * ===================================================================================== */
+
+static inline vm_offset_t
+slot_virt(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].virt + at % PAGE_SIZE;
+}
+
+static inline uint64_t
+slot_phys(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].phys + at % PAGE_SIZE;
+}
+
+static inline struct tre *
+tre_at(const struct channel *ch, uint32_t index)
+{
+	return (struct tre *)(ch->tre_ring.virt + (index % ch->slots) * ELEMENT_SIZE);
+}
+
+static inline struct event *
+event_at(const struct channel *ch, uint32_t index)
+{
+	return (struct event *)(ch->event_ring.virt + (index % ch->slots) * ELEMENT_SIZE);
+}
+
+/* The rings and the slot buffers: one page each for the two rings, then as many as the buffers
+ * take. HakiOS's channel_memory(), hakios.ipa.c:278-293. */
+static bool
+channel_memory(struct channel *ch)
+{
+	uint64_t bytes = (uint64_t)ch->slots * ch->buffer_size;
+
+	ch->page_count = (uint32_t)((bytes + PAGE_SIZE - 1) / PAGE_SIZE);
+	ch->pages = kalloc_data((vm_size_t)(ch->page_count * sizeof(struct dma)), Z_WAITOK | Z_ZERO);
+	if (ch->pages == NULL) {
+		return false;
+	}
+	if (!dma_page(&ch->tre_ring) || !dma_page(&ch->event_ring)) {
+		return false;
+	}
+	for (uint32_t p = 0; p < ch->page_count; p++) {
+		if (!dma_page(&ch->pages[p])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+gsi_error(const char *what)
+{
+	uint32_t log = gsi_rd(GSI_ERROR_LOG);
+
+	printf("PANDORA IPA: %s: GSI status %#x, error log %#x (code %u, type %u, EE %u, index %u, args %#x), "
+	    "global %#x, general %#x\n", what, gsi_rd(GSI_STATUS), log, (log >> 12) & 0xf, (log >> 24) & 0xf,
+	    log >> 28, (log >> 19) & 0x1f, log & 0xfff, gsi_rd(GSI_CNTXT_GLOB_IRQ_STTS),
+	    gsi_rd(GSI_CNTXT_GSI_IRQ_STTS));
+	if (log != 0) {
+		gsi_wr(GSI_ERROR_LOG, 0);
+		gsi_wr(GSI_ERROR_LOG_CLR, ~0u);
+	}
+}
+
+static inline uint32_t
+channel_state(const struct channel *ch)
+{
+	return (gsi_rd(GSI_CH_CNTXT(ch->id, 0)) >> 20) & 0xf;
+}
+
+static inline uint32_t
+event_ring_state(const struct channel *ch)
+{
+	return (gsi_rd(GSI_EV_CNTXT(ch->ring_id, 0)) >> 20) & 0xf;
+}
+
+/*
+ * A command to the GSI about a channel or an event ring, waited for until the state is `wanted`
+ * (up to 50 ms). The completion is also flagged as an interrupt source, which is masked here but
+ * still has to be cleared. HakiOS's gsi_command(), hakios.ipa.c:322-347, with the offsets swapped.
+ */
+static bool
+gsi_command(struct channel *ch, bool event, uint32_t opcode, uint32_t wanted)
+{
+	uint32_t state = 0, number = event ? ch->ring_id : ch->id;
+
+	gsi_wr(event ? GSI_EV_CH_CMD : GSI_CH_CMD, number | opcode << 24);
+	for (unsigned us = 0; us < 50000; us += 100) {
+		state = event ? event_ring_state(ch) : channel_state(ch);
+		if (state == wanted) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	gsi_wr(event ? GSI_CNTXT_SRC_EV_CH_IRQ_CLR : GSI_CNTXT_SRC_CH_IRQ_CLR, 1u << number);
+	if (state != wanted) {
+		printf("PANDORA IPA: %s: command %#x on %s %u leaves it in state %u, not %u\n", ch->name, opcode,
+		    event ? "event ring" : "channel", number, state, wanted);
+		gsi_error(ch->name);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * As Linux's gsi_irq_setup(): interrupts, not MSIs, and every source masked. Nothing here is
+ * handled, because the rings are polled (spec 2.9). Taking the IPA's GIC interrupts on this
+ * platform would mean establishing interrupt mappings for SPIs 654 and 432; HakiOS did not, and a
+ * polling interval of a millisecond or less does not noticeably degrade a 500 us aggregation
+ * window.
+ */
+static void
+gsi_interrupts_off(void)
+{
+	gsi_wr(GSI_CNTXT_INTSET, 1);
+	gsi_wr(GSI_CNTXT_TYPE_IRQ_MSK, 0);
+	gsi_wr(GSI_CNTXT_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(GSI_CNTXT_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(GSI_CNTXT_GLOB_IRQ_EN, 0);
+	gsi_wr(GSI_CNTXT_SRC_IEOB_IRQ_MSK, 0);
+	gsi_wr(GSI_INTER_EE_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(GSI_INTER_EE_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(GSI_CNTXT_GSI_IRQ_EN, 0);
+}
+
+/*
+ * One channel and its event ring, for the GPI protocol.
+ *
+ * Three bit fields moved between 4.11 and 5.0 and all three are silent failures if written the
+ * old way (spec 2.3, 2.4, and the spec's hazard table):
+ *
+ *   1. EV_CH_E_CNTXT_0's INTYPE is bit 7 in 5.0, not bit 16 -- bit 16 is EV_EE now, so 4.11's
+ *      "1u << 16" hangs the event ring on execution environment 1 (the modem's) and this
+ *      processor never sees an event again.
+ *   2. CH_C_CNTXT_0 has no ERINDEX field in 5.0: it moved to CH_C_CNTXT_1[31:24]
+ *      (CVE-2026-43345). 4.11's "event ring << 14" lands in the middle of CHID here.
+ *   3. The channel direction is bit 7 (CHTYPE_DIR), not bit 3 (which is inside CHTYPE_PROTOCOL,
+ *      now seven bits wide).
+ */
+static bool
+channel_setup(struct channel *ch)
+{
+	uint32_t e = ch->ring_id, c = ch->id, value;
+
+	if (!gsi_command(ch, true, GSI_EVT_ALLOCATE, EV_STATE_ALLOCATED)) {
+		return false;
+	}
+	/*
+	 * EV_CH_E_CNTXT_0: EV_CHTYPE = 2 (GPI), EV_INTYPE = bit 7 (interrupt, not MSI),
+	 * EV_ELEMENT_SIZE = 16 at bits 31:24. EV_EVCHID stays 0: it is the EE's event ring index,
+	 * and execution environment 0's rings are numbered from zero.
+	 */
+	gsi_wr(GSI_EV_CNTXT(e, 0), GSI_CHANNEL_TYPE_GPI | 1u << 7 | ELEMENT_SIZE << 24);
+	gsi_wr(GSI_EV_CNTXT(e, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(GSI_EV_CNTXT(e, 2), (uint32_t)ch->event_ring.phys);
+	gsi_wr(GSI_EV_CNTXT(e, 3), (uint32_t)(ch->event_ring.phys >> 32));
+	/*
+	 * EV_MODT = 32 and EV_MODC = 1: the moderation timer is 1 ms at 32 kHz. Identical in 4.11
+	 * and 5.0 (gsi.c: GSI_EVT_RING_INT_MODT = 32 * 1), so this line is HakiOS's unchanged.
+	 */
+	gsi_wr(GSI_EV_CNTXT(e, 8), 32 | 1u << 16);
+	for (unsigned n = 9; n <= 13; n++) {
+		gsi_wr(GSI_EV_CNTXT(e, n), 0);          /* no MSI, no read pointer updates */
+	}
+	/* "the last processed event": the ring's last entry, since nothing has been processed yet */
+	gsi_wr(GSI_EV_DOORBELL(e), (uint32_t)(ch->event_ring.phys + (ch->slots - 1) * ELEMENT_SIZE));
+
+	if (!gsi_command(ch, false, GSI_CH_ALLOCATE, CH_STATE_ALLOCATED)) {
+		return false;
+	}
+	/* CH_C_CNTXT_0: GPI protocol, direction, ELEMENT_SIZE 16 at bits 31:24 -- no ERINDEX here. */
+	gsi_wr(GSI_CH_CNTXT(c, 0), GSI_CHANNEL_TYPE_GPI | (ch->to_ipa ? 1u << 7 : 0) | ELEMENT_SIZE << 24);
+	/* CH_C_CNTXT_1: CH_R_LENGTH[23:0] is the ring's length in bytes, CH_ERINDEX[31:24] its event ring. */
+	gsi_wr(GSI_CH_CNTXT(c, 1), (uint32_t)(ch->slots * ELEMENT_SIZE) | e << 24);
+	gsi_wr(GSI_CH_CNTXT(c, 2), (uint32_t)ch->tre_ring.phys);
+	gsi_wr(GSI_CH_CNTXT(c, 3), (uint32_t)(ch->tre_ring.phys >> 32));
+	/*
+	 * CH_C_QOS: the command channel gets the lowest round-robin weight and no escape buffer;
+	 * every channel has the doorbell count bytes. These three bits happen to be where they were
+	 * in 4.11 (WRR_WEIGHT[3:0], PREFETCH_MODE[13:10] = 1 for escape-buffer-only, DB_IN_BYTES
+	 * bit 24), even though 4.11 called bit 9 "USE_ESCAPE_BUF_ONLY" and 5.0 calls it
+	 * "USE_DB_ENG" -- so HakiOS's line is right on 5.5 by coincidence, and the comment is not.
+	 */
+	value = (ch->command ? 0xf : 0) | (ch->command ? 0 : 1u << 10) | 1u << 24;
+	gsi_wr(GSI_CH_QOS(c), value);
+	/* The GPI scratch: the most TREs outstanding (in bytes), then the threshold, two TREs. */
+	gsi_wr(GSI_CH_SCRATCH(c, 0), (ch->tlv * ELEMENT_SIZE) << 16);
+	gsi_wr(GSI_CH_SCRATCH(c, 1), (2 * ELEMENT_SIZE) << 16);
+	gsi_wr(GSI_CH_SCRATCH(c, 2), 0);
+	gsi_wr(GSI_CH_SCRATCH(c, 3), gsi_rd(GSI_CH_SCRATCH(c, 3)) & 0xffff);
+	return true;
+}
+
+/*
+ * The IPA's endpoint for a channel, as Linux's ipa_endpoint_program() writes it for IPA 5.5, with
+ * no checksum offload and (unless asked) no status packets.
+ *
+ * Bit fields that changed and are written accordingly:
+ *   ENDP_INIT_CFG      PIPE_REPLICATE_EN is new at bit 9; CS_OFFLOAD_EN is [2:1], left 0.
+ *   ENDP_INIT_HDR      HDR_A5_MUX (4.11's bit 26) and HDR_METADATA_REG_VALID (bit 28) are gone;
+ *                      HDR_LEN_MSB[29:28] and HDR_OFST_METADATA_MSB[31:30] are new at the top.
+ *   ENDP_INIT_HDR_EXT  HDR_PAD_TO_ALIGNMENT[13:10] is used here and HakiOS never set it at all,
+ *                      on 4.11 either -- the receive buffers' QMAP payloads are padded to 4 bytes
+ *                      (pad_align = ilog2(sizeof(u32)) = 2) and the IPA has to be told so.
+ *   ENDP_INIT_MODE     DEST_PIPE_INDEX widened from [8:4] to [11:4]; 16 fits either way.
+ *   ENDP_INIT_AGGR     fields are where they were; BYTE_LIMIT is 6 KB, not 12.
+ *   ENDP_INIT_RSRC_GRP widened from [1:0] to [2:0] and is per-endpoint now (0 for the uplink
+ *                      group, 1 for the downlink).
+ *   ENDP_STATUS        STATUS_ENDP widened from [5:1] to [8:1] because 5.5 has 24 endpoints.
+ */
+static void
+endpoint_program(const struct channel *ch)
+{
+	uint32_t ep = ch->endpoint, value;
+
+	/* ENDP_INIT_CFG: no fragment offload, no checksum offload, no pipe replication. */
+	ipa_wr(IPA_ENDP_INIT_CFG(ep), 0);
+	/* ENDP_INIT_NAT: bypassed (0). Only meaningful on a transmit endpoint. */
+	ipa_wr(IPA_ENDP_INIT_NAT(ep), 0);
+
+	value = 0;
+	if (ch->qmap) {
+		/* HDR_LEN = 4 (struct rmnet_map_header), and the metadata carries the mux id. */
+		value = 4 | 1u << 6;
+		if (!ch->to_ipa) {
+			/*
+			 * On receive the IPA makes the header: it writes the mux id (byte 1 of the
+			 * header) from the metadata and the packet's length (bytes 2-3) from the
+			 * transfer. offsetof(struct rmnet_map_header, mux_id) = 1,
+			 * offsetof(..., pkt_len) = 2.
+			 */
+			value |= 1u << 7 | 1u << 19 | 2u << 20;
+		}
+	}
+	ipa_wr(IPA_ENDP_INIT_HDR(ep), value);
+
+	value = 0;
+	if (ch->qmap) {
+		value = 1;                              /* HDR_ENDIANNESS: big */
+		if (!ch->to_ipa) {
+			value |= 1u << 1;               /* HDR_TOTAL_LEN_OR_PAD_VALID: the pad is in the header */
+			value |= 1u << 3;               /* HDR_PAYLOAD_LEN_INC_PADDING */
+		}
+	}
+	if (!ch->to_ipa) {
+		value |= 2u << 10;                      /* HDR_PAD_TO_ALIGNMENT = 2: four-byte payloads */
+	}
+	ipa_wr(IPA_ENDP_INIT_HDR_EXT(ep), value);
+
+	if (!ch->to_ipa) {
+		/*
+		 * The metadata's mux id is one byte of a big-endian word, so only the lowest byte
+		 * matters. Apache's driver writes cpu_to_be32(IPA_ENDPOINT_QMAP_METADATA_MASK) =
+		 * 0xff000000 and so did HakiOS (:428); it is the same value here.
+		 */
+		ipa_wr(IPA_ENDP_INIT_HDR_METADATA_MASK(ep), ch->qmap ? 0xff000000u : 0);
+	} else {
+		/*
+		 * The command endpoint moves its payload to the LAN receive endpoint (IPA_DMA mode)
+		 * and names it in DEST_PIPE_INDEX; the modem's transmit endpoint is plain
+		 * (IPA_BASIC), which is ENDP_MODE = 0.
+		 */
+		if (ch->command) {
+			ipa_wr(IPA_ENDP_INIT_MODE(ep), IPA_MODE_DMA | (uint32_t)lan_rx.endpoint << 4);
+		} else {
+			ipa_wr(IPA_ENDP_INIT_MODE(ep), IPA_MODE_BASIC);
+		}
+	}
+
+	if (!ch->to_ipa && ch->aggregate) {
+		value = IPA_AGGR_ENABLE | IPA_AGGR_GENERIC << 2 | AGGR_LIMIT_KB << 5 | AGGR_TIME_TICKS << 12 |
+		    (ch->close_eof ? 1u << 23 : 0);
+	} else if (ch->to_ipa && ch->qmap) {
+		value = IPA_AGGR_DEAGGR | IPA_AGGR_QCMAP << 2;
+	} else {
+		value = IPA_AGGR_BYPASS;
+	}
+	ipa_wr(IPA_ENDP_INIT_AGGR(ep), value);
+
+	if (!ch->to_ipa) {
+		ipa_wr(IPA_ENDP_INIT_HOL_BLOCK_EN(ep), 0);      /* no head-of-line blocking */
+	} else {
+		ipa_wr(IPA_ENDP_INIT_DEAGGR(ep), 0);            /* no deaggregation header */
+	}
+
+	/* The resource group this endpoint draws its quota from: 0 uplink, 1 downlink. */
+	ipa_wr(IPA_ENDP_INIT_RSRC_GRP(ep), ch->resource_group);
+
+	if (ch->to_ipa) {
+		ipa_wr(IPA_ENDP_INIT_SEQ(ep), ch->command ? IPA_SEQ_DMA : IPA_SEQ_2_PASS_SKIP_LAST_UC);
+	}
+
+	/*
+	 * ENDP_STATUS. 0 turns status packets off, which is what the first version wants (spec 4.4,
+	 * "start with HakiOS's 0, turn the modem transmit endpoint's on later"). The values for the
+	 * day they are on are the data table's: the modem transmit endpoint reports to the modem's
+	 * AP receive endpoint (21), status and nothing in STATUS_ENDP, and the LAN receive endpoint
+	 * has status with a destination of 0.
+	 */
+	if (!ipa_no_status || !ch->status) {
+		value = 0;
+	} else if (ch->endpoint == modem_tx.endpoint) {
+		value = 1u | (uint32_t)IPA_EP_MODEM_AP_RX << 1;
+	} else {
+		value = 1u;
+	}
+	ipa_wr(IPA_ENDP_STATUS(ep), value);
+}
+
+/* The TRE at `index` of the ring, filled and written out of the cache; its doorbell is rung
+ * separately. HakiOS's tre_fill(), hakios.ipa.c:453-462. */
+static void
+tre_fill(struct channel *ch, uint32_t index, uint64_t addr, uint16_t len_opcode, uint32_t flags)
+{
+	struct tre *t = tre_at(ch, index);
+
+	t->addr = addr;
+	t->len_opcode = len_opcode;
+	t->reserved = 0;
+	t->flags = flags;
+	dma_sync((vm_offset_t)t, sizeof(*t));
+}
+
+static inline void
+channel_doorbell(struct channel *ch)
+{
+	gsi_wr(GSI_CH_DOORBELL(ch->id), (uint32_t)(ch->tre_ring.phys + (ch->next % ch->slots) * ELEMENT_SIZE));
+}
+
+/*
+ * The events the hardware has written since last time, each to `each`. The event ring's write
+ * pointer is in its context register 4 (read only); the doorbell afterwards tells the hardware
+ * the last event read, which makes room. HakiOS's channel_events(), hakios.ipa.c:477-500.
+ */
+static unsigned
+channel_events(struct channel *ch, void (*each)(struct channel *, const struct event *, void *), void *context)
+{
+	uint32_t wp = gsi_rd(GSI_EV_CNTXT(ch->ring_id, 4)), base = (uint32_t)ch->event_ring.phys, index;
+	unsigned n = 0;
+
+	if (wp < base || wp >= base + ch->slots * ELEMENT_SIZE) {
+		if (ch->errors++ == 0) {
+			printf("PANDORA IPA: %s: the event ring's write pointer %#x is outside the ring at %#x\n",
+			    ch->name, wp, base);
+		}
+		return 0;
+	}
+	index = (wp - base) / ELEMENT_SIZE;
+	while (ch->events % ch->slots != index) {
+		struct event *e = event_at(ch, ch->events);
+
+		dma_sync((vm_offset_t)e, sizeof(*e));
+		each(ch, e, context);
+		ch->events++;
+		n++;
+	}
+	if (n != 0) {
+		gsi_wr(GSI_EV_DOORBELL(ch->ring_id),
+		    (uint32_t)(ch->event_ring.phys + ((ch->events - 1) % ch->slots) * ELEMENT_SIZE));
+	}
+	return n;
+}
+
+/* =====================================================================================
+ * 5. Immediate commands, and the filter and route tables they install
+ *
+ * The IPA is told where its tables are by commands it runs itself, carried as TREs on the command
+ * endpoint: the TRE's "length" word is the opcode and its address points at the command's payload
+ * in memory the IPA can reach (the command endpoint is in IPA_DMA mode, so it copies the payload
+ * out to the LAN receive endpoint's pipe -- that is the DMA that makes the payload visible).
+ * ===================================================================================== */
+
+struct command_done {
+	uint64_t        tre;
+	bool            done;
+	uint8_t         code;
+};
+
+static void
+command_event(__unused struct channel *ch, const struct event *e, void *context)
+{
+	struct command_done *waiting = context;
+
+	if (e->xfer == waiting->tre) {
+		waiting->done = true;
+		waiting->code = e->code;
+	}
+	command.done++;
+}
+
+/*
+ * One immediate command, waited for (up to 200 ms). The payload is copied into the slot's buffer
+ * first. HakiOS's ipa_command(), hakios.ipa.c:531-559.
+ */
+static bool
+ipa_command(const char *what, uint8_t opcode, const void *payload, size_t size)
+{
+	uint32_t slot = command.next % command.slots;
+	struct command_done waiting = { .tre = command.tre_ring.phys + (uint64_t)slot * ELEMENT_SIZE };
+
+	if (size > command.buffer_size || command.next - command.done >= command.slots - 1) {
+		return false;
+	}
+	memcpy((void *)slot_virt(&command, slot), payload, size);
+	dma_sync(slot_virt(&command, slot), size);
+	tre_fill(&command, command.next, slot_phys(&command, slot), opcode, TRE_TYPE_COMMAND | TRE_IEOT);
+	command.next++;
+	channel_doorbell(&command);
+	for (unsigned us = 0; us < 200000 && !waiting.done; us += 200) {
+		channel_events(&command, command_event, &waiting);
+		if (!waiting.done) {
+			delay_for_interval(200, NSEC_PER_USEC);
+		}
+	}
+	if (!waiting.done) {
+		printf("PANDORA IPA: the command %s (opcode %#x) is not answered in 200 ms; channel state %u\n",
+		    what, opcode, channel_state(&command));
+		gsi_error(what);
+		return false;
+	}
+	if (ipa_trace) {
+		printf("PANDORA IPA: the command %s (opcode %#x) done, code %u\n", what, opcode, waiting.code);
+	}
+	return true;
+}
+
+/*
+ * The tables, as Linux's ipa_table_init() lays them out in one buffer: a "zero rule" (8 bytes of
+ * zero, which every entry points at until somebody installs a rule), then the filter table's
+ * bitmap of the endpoints that filter, then as many entries as the longest table, each holding the
+ * zero rule's address.
+ *
+ * Two things changed in 5.0 and both are silent failures (spec 4.10):
+ *
+ *   - The bitmap's bit numbering: before 5.0, bit 0 meant "filter at all" and endpoint X was bit
+ *     X+1; from 5.0 on, endpoint X is simply bit X, no shift. HakiOS shifts left by one
+ *     (hakios.ipa.c:590).
+ *   - The entry count: the route tables are 0x98 bytes in 5.5 (19 entries), not 0x78 (15).
+ *
+ * The bitmap itself is the endpoints that have filter_support in Linux's data table: our modem
+ * transmit endpoint 2, and the modem's own 12 (MODEM_AP_TX) and 15 (MODEM_DL_NLO_TX).
+ */
+#define FILTERED_ENDPOINTS      ((1u << 2) | (1u << IPA_EP_MODEM_AP_TX) | (1u << IPA_EP_MODEM_DL_NLO_TX))
+#define FILTER_ENTRIES          4               /* the bitmap and one per filtering endpoint */
+#define ROUTE_ENTRIES           19              /* IPA_MEM_V4_ROUTE.size 0x98 / 8 */
+
+/* The local memory's regions this file names, from Linux's ipa_data-v5.5.c (spec 3.1). The
+ * offsets are within the IPA's local memory, so they all carry mem_offset. */
+#define IPA_MEM_V4_FILTER_HASHED    0x1288
+#define IPA_MEM_V4_FILTER           0x1308
+#define IPA_MEM_V6_FILTER_HASHED    0x1388
+#define IPA_MEM_V6_FILTER           0x1408
+#define IPA_MEM_V4_ROUTE_HASHED     0x1488
+#define IPA_MEM_V4_ROUTE            0x1528
+#define IPA_MEM_V6_ROUTE_HASHED     0x15c8
+#define IPA_MEM_V6_ROUTE            0x1668
+#define IPA_MEM_AP_HEADER           0x1948
+#define IPA_MEM_AP_HEADER_SIZE      0x01e0
+#define IPA_MEM_MODEM_PROC_CTX      0x1b40
+
+static uint32_t ipa_mem_offset;                 /* the local memory's offset in the shared block */
+
+static struct dma table_dma;                    /* the rules' page */
+static struct dma zero_dma;                     /* a page of zeros, for the tables that point at nothing */
+
+/*
+ * The filter and route table command's payload, and its flags word: the hashed table's length in
+ * bytes at bits 11:0, its address in the local memory at 27:12, the unhashed table's length at
+ * 39:28 and its address at 55:40, each address in units of eight bytes from the start of the local
+ * memory. HakiOS's table_init(), hakios.ipa.c:579-592, and the flags encode is right as it stands.
+ */
+static bool
+table_init(const char *what, uint8_t opcode, bool filter, uint32_t hashed_offset, uint32_t offset)
+{
+	struct {
+		uint64_t hash_rules_addr, flags, nhash_rules_addr;
+	} payload;
+	uint32_t entries = filter ? FILTER_ENTRIES : ROUTE_ENTRIES, size = entries * 8;
+	uint64_t source = table_dma.phys + (filter ? 8 : 16);
+
+	payload.hash_rules_addr = source;
+	payload.nhash_rules_addr = source;
+	payload.flags = (uint64_t)size | (uint64_t)(ipa_mem_offset + hashed_offset) << 12 |
+	    (uint64_t)size << 28 | (uint64_t)(ipa_mem_offset + offset) << 40;
+	return ipa_command(what, opcode, &payload, sizeof(payload));
+}
+
+static struct dma table_dma;                    /* the rules' page */
+static struct dma zero_dma;                     /* a page of zeros, for the tables that point at nothing */
+
+static bool
+tables_setup(void)
+{
+	uint64_t *t = (uint64_t *)table_dma.virt;
+	struct {
+		uint64_t hdr_table_addr;
+		uint32_t flags, reserved;
+	} headers;
+
+	t[0] = 0;                                       /* the zero rule */
+	t[1] = FILTERED_ENDPOINTS;                      /* the filter bitmap: bit X is endpoint X */
+	for (unsigned n = 0; n < ROUTE_ENTRIES; n++) {
+		t[2 + n] = table_dma.phys;
+	}
+	dma_sync(table_dma.virt, (2 + ROUTE_ENTRIES) * 8);
+
+	if (!table_init("IPv4 route table init", IPA_CMD_IP_V4_ROUTING_INIT, false,
+	    IPA_MEM_V4_ROUTE_HASHED, IPA_MEM_V4_ROUTE) ||
+	    !table_init("IPv6 route table init", IPA_CMD_IP_V6_ROUTING_INIT, false,
+	    IPA_MEM_V6_ROUTE_HASHED, IPA_MEM_V6_ROUTE) ||
+	    !table_init("IPv4 filter table init", IPA_CMD_IP_V4_FILTER_INIT, true,
+	    IPA_MEM_V4_FILTER_HASHED, IPA_MEM_V4_FILTER) ||
+	    !table_init("IPv6 filter table init", IPA_CMD_IP_V6_FILTER_INIT, true,
+	    IPA_MEM_V6_FILTER_HASHED, IPA_MEM_V6_FILTER)) {
+		return false;
+	}
+
+	/*
+	 * The header table: this processor's own header region (IPA_MEM_AP_HEADER), not the modem's,
+	 * and not the two together. HakiOS passed 0x440 -- the modem's headers and ours in 4.11 --
+	 * at offset 0x688 (hakios.ipa.c:606-608); 5.5's IPA_MEM_MODEM_HEADER is 0x240 and
+	 * IPA_MEM_AP_HEADER is 0x1e0, and IPA_CMD_HDR_INIT_LOCAL initialises only this
+	 * processor's part (Linux: ipa_cmd_hdr_init_local_add with IPA_MEM_AP_HEADER's offset and
+	 * size).
+	 */
+	headers.hdr_table_addr = zero_dma.phys;
+	headers.flags = IPA_MEM_AP_HEADER_SIZE | (ipa_mem_offset + IPA_MEM_AP_HEADER) << 12;
+	headers.reserved = 0;
+	if (!ipa_command("header table init", IPA_CMD_HDR_INIT_LOCAL, &headers, sizeof(headers))) {
+		return false;
+	}
+
+	/*
+	 * The hashed tables' caches, flushed. 4.11 had a four-bit register at 0x14c
+	 * (FILT_ROUT_HASH_FLUSH) with a bit per IPv4/IPv6 x filter/route; 5.0 replaced both caches
+	 * with one unified filter/route cache and a two-bit flush at 0x404, so the value is 0x11
+	 * (router cache and filter cache), not 0x1111.
+	 */
+	ipa_wr(IPA_FILT_ROUT_CACHE_FLUSH, 1u | 1u << 4);
+	return true;
+}
+
+/* =====================================================================================
+ * 6. The data path: receiving the modem's packets and sending ours
+ *
+ * The QMAP framing is the hardware's, unchanged from 4.11 to 5.5 (spec 7.2): a four-byte
+ * big-endian header in front of each packet, and on receive several of them in one buffer:
+ *
+ *   byte 0    bit 7   CD: 0 data, 1 command
+ *             bit 6   reserved
+ *             [5:0]   pad_len, padding after the payload
+ *   byte 1            mux_id
+ *   bytes 2-3         pkt_len, big-endian, the payload's length after this header
+ *
+ * On receive the IPA fills mux_id itself from the metadata (ENDP_INIT_HDR_METADATA_MASK above), so
+ * this side only has to walk the buffers. On transmit this side writes the header.
+ * ===================================================================================== */
+
+void (*pandora_ipa_receive)(uint32_t mux, const uint8_t *packet, size_t length);
+
+/* A receive slot handed to the hardware: one TRE for the whole buffer. HakiOS's receive_post(),
+ * hakios.ipa.c:629-633. */
+static void
+receive_post(struct channel *ch, uint32_t slot)
+{
+	tre_fill(ch, ch->next, slot_phys(ch, slot),
+	    (uint16_t)(ch->buffer_size > 0xffff ? 0xffff : ch->buffer_size), TRE_TYPE_XFER | TRE_IEOT);
+	ch->next++;
+}
+
+/*
+ * A packet lifted out of a receive buffer, to be handed to the cell layer once the lock is gone.
+ *
+ * PORTER'S NOTE (this is a departure from HakiOS, and it is deliberate). HakiOS called the network
+ * stack from inside receive_event() while holding ipa_lock (hakios.ipa.c:673-676) -- and its transmit
+ * path takes the same lock (hakios.ipa.c:717). A packet the stack answers immediately on receipt
+ * (an ARP reply, a DHCP answer, an ICMP echo, a TCP ACK) would then take ipa_lock a second time, and
+ * an lck_mtx is not recursive there: it deadlocks. The stack's own receive callbacks do answer
+ * immediately. So the QMAP walk here only records where each packet is; pandora_ipa_poll() copies
+ * and hands them over after the unlock.
+ *
+ * The buffer a packet points into is one of the channel's own slots, which the hardware may write to
+ * again as soon as the slot is re-posted -- hence the copy into the spool below and not a pointer.
+ */
+#define IPA_SPOOL_PACKETS       32              /* packets one poll may lift out of the rings */
+#define IPA_SPOOL_BYTES         32768           /* ... and the bytes they may take between them */
+
+struct spooled {
+	uint32_t        mux;
+	uint32_t        length;
+	uint32_t        at;                     /* where in the spool's bytes this packet starts */
+};
+
+struct receive_context {
+	unsigned        packets;
+	uint8_t *       spool;                  /* IPA_SPOOL_BYTES of it, from the caller */
+	uint32_t        used;
+	unsigned        count;                  /* how many of `packets_array` are filled in */
+	struct spooled  packets_array[IPA_SPOOL_PACKETS];
+	unsigned        overflow;               /* ... and how many did not fit */
+};
+
+/*
+ * A receive buffer is full (or closed): the QMAP packets in it, one by one; then the slot is
+ * posted again. HakiOS's receive_event(), hakios.ipa.c:642-696, with the hand-over deferred.
+ */
+static void
+receive_event(struct channel *ch, const struct event *e, void *context)
+{
+	struct receive_context *rc = context;
+	uint32_t slot, length = e->len;
+	const uint8_t *buffer;
+
+	if (e->xfer < ch->tre_ring.phys) {
+		if (ch->errors++ < 4) {
+			printf("PANDORA IPA: %s: an event for TRE %#llx, below the ring at %#llx\n", ch->name,
+			    e->xfer, ch->tre_ring.phys);
+		}
+		return;
+	}
+	slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE);
+	if (slot >= ch->slots) {
+		if (ch->errors++ < 4) {
+			printf("PANDORA IPA: %s: an event for TRE %#llx, outside the ring at %#llx\n", ch->name,
+			    e->xfer, ch->tre_ring.phys);
+		}
+		return;
+	}
+	/*
+	 * Receives complete in order: this->done is the next slot expected and this->next the next to
+	 * post, which is slots-1 ahead of it.
+	 */
+	if (slot != ch->done % ch->slots) {
+		if (ch->errors++ < 4) {
+			printf("PANDORA IPA: %s: slot %u finished while slot %u was expected\n", ch->name, slot,
+			    ch->done % ch->slots);
+		}
+	}
+	ch->done++;
+	buffer = (const uint8_t *)slot_virt(ch, slot);
+	if (length > ch->buffer_size) {
+		length = ch->buffer_size;
+	}
+	/* Before reading what the hardware wrote: drop the stale lines from the cache. */
+	dma_sync((vm_offset_t)buffer, length);
+	ch->bytes += length;
+	if (ipa_trace) {
+		printf("PANDORA IPA: %s: slot %u: %u bytes (code %u): %02x %02x %02x %02x %02x %02x %02x %02x ...\n",
+		    ch->name, slot, length, e->code, buffer[0], buffer[1], buffer[2], buffer[3], buffer[4],
+		    buffer[5], buffer[6], buffer[7]);
+	}
+	if (ch->qmap) {
+		for (uint32_t at = 0; at + 4 <= length;) {
+			uint32_t pad = buffer[at] & 0x3f, cmd = buffer[at] & 0x80, mux = buffer[at + 1];
+			uint32_t packet = (uint32_t)buffer[at + 2] << 8 | buffer[at + 3];
+			uint32_t body;
+
+			if (packet == 0 || at + 4 + packet > length || pad > packet) {
+				break;
+			}
+			body = packet - pad;
+			if (cmd == 0) {
+				ch->packets++;
+				rc->packets++;
+				if (rc->count < IPA_SPOOL_PACKETS && rc->used + body <= IPA_SPOOL_BYTES) {
+					struct spooled *sp = &rc->packets_array[rc->count];
+
+					memcpy(rc->spool + rc->used, buffer + at + 4, body);
+					sp->mux = mux;
+					sp->length = body;
+					sp->at = rc->used;
+					rc->used += body;
+					rc->count++;
+				} else {
+					rc->overflow++;
+				}
+			} else if (ipa_trace) {
+				printf("PANDORA IPA: %s: a QMAP command (%u bytes) on mux %u\n", ch->name, packet, mux);
+			}
+			at += 4 + packet;
+		}
+	} else {
+		ch->packets++;                          /* the LAN endpoint: looked at, dropped */
+	}
+	/*
+	 * The slot posted again -- the one at the ring's next TRE, which is this one while the
+	 * hardware finishes in order (this->next is a whole ring ahead of this->done).
+	 */
+	receive_post(ch, ch->next % ch->slots);
+	channel_doorbell(ch);
+}
+
+static void
+transmit_event(struct channel *ch, const struct event *e, __unused void *context)
+{
+	uint32_t slot;
+
+	if (e->xfer < ch->tre_ring.phys) {
+		ch->errors++;
+		return;
+	}
+	slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE);
+	if (slot != ch->done % ch->slots && ch->errors++ < 4) {
+		printf("PANDORA IPA: %s: slot %u finished while slot %u was expected (code %u)\n", ch->name, slot,
+		    ch->done % ch->slots, e->code);
+	}
+	ch->done++;
+}
+
+int
+pandora_ipa_transmit(uint32_t mux, const void *packet, size_t length)
+{
+	struct channel *ch = &modem_tx;
+	uint32_t slot;
+	uint8_t *buffer;
+
+	if (!ipa_up || packet == NULL || length == 0 || length + 4 > ch->buffer_size) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&ipa_lock);
+	channel_events(ch, transmit_event, NULL);
+	/* One slot always left free: a doorbell level with the read pointer means "empty", not "full". */
+	if (ch->next - ch->done >= ch->slots - 1) {
+		ch->dropped++;
+		lck_mtx_unlock(&ipa_lock);
+		return ENOBUFS;
+	}
+	slot = ch->next % ch->slots;
+	buffer = (uint8_t *)slot_virt(ch, slot);
+	buffer[0] = 0;                                  /* no pad, not a command */
+	buffer[1] = (uint8_t)mux;
+	buffer[2] = (uint8_t)(length >> 8);
+	buffer[3] = (uint8_t)length;
+	memcpy(buffer + 4, packet, length);
+	dma_sync((vm_offset_t)buffer, length + 4);
+	/*
+	 * TRE_BEI: an event when the modem has it, but no interrupt. There are none here anyway
+	 * (gsi_interrupts_off()), so BEI is belt and braces -- HakiOS set it and Linux sets the same
+	 * bit for the same reason (its transfers complete without raising).
+	 */
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(length + 4), TRE_TYPE_XFER | TRE_IEOT | TRE_BEI);
+	ch->next++;
+	channel_doorbell(ch);
+	ch->packets++;
+	ch->bytes += length;
+	if (ipa_trace) {
+		printf("PANDORA IPA: %s: slot %u: %zu bytes on mux %u\n", ch->name, slot, length, mux);
+	}
+	lck_mtx_unlock(&ipa_lock);
+	return 0;
+}
+
+/*
+ * Drain the rings, then hand what came out of them to the cell layer with no lock held (see the
+ * PORTER'S NOTE on struct receive_context above for why the hand-over is not done in place).
+ *
+ * The spool is one allocation for the lifetime of the data path: 32 KB of packets and the array of
+ * them, which is one page and is not worth churning per poll.
+ */
+static uint8_t *ipa_spool;
+
+void
+pandora_ipa_poll(void)
+{
+	struct receive_context rc;
+	unsigned overflow;
+
+	if (!ipa_up || ipa_spool == NULL) {
+		return;
+	}
+	rc.packets = 0;
+	rc.spool = ipa_spool;
+	rc.used = 0;
+	rc.count = 0;
+	rc.overflow = 0;
+
+	lck_mtx_lock(&ipa_lock);
+	channel_events(&modem_rx, receive_event, &rc);
+	channel_events(&lan_rx, receive_event, &rc);
+	/* Clean up finished transmits so the ring does not fill while nothing is being sent. */
+	channel_events(&modem_tx, transmit_event, NULL);
+	lck_mtx_unlock(&ipa_lock);
+
+	overflow = rc.overflow;
+	if (overflow != 0) {
+		/*
+		 * Counted, not silently dropped: this means the spool was too small for what one poll
+		 * found, and the fix is a bigger spool or a shorter poll period.
+		 */
+		modem_rx.errors += overflow;
+		if (ipa_trace) {
+			printf("PANDORA IPA: %u packets did not fit in the poll's spool\n", overflow);
+		}
+	}
+	if (pandora_ipa_receive == NULL) {
+		return;
+	}
+	for (unsigned n = 0; n < rc.count; n++) {
+		pandora_ipa_receive(rc.packets_array[n].mux, rc.spool + rc.packets_array[n].at,
+		    rc.packets_array[n].length);
+	}
+}
+
+bool
+pandora_ipa_data_ready(void)
+{
+	return ipa_up;
+}
+
+unsigned
+pandora_ipa_modem_endpoints(uint32_t *to_modem, uint32_t *from_modem)
+{
+	/*
+	 * 2 and 23: what Linux exports as modem/tx_endpoint_id and modem/rx_endpoint_id for IPA
+	 * 5.5, and what the modem is told through DPM/WDA's TLV 0x11. 4.11's pair was 2 and 16,
+	 * which is where HakiOS's default of 16 came from (hakios.mpss.c:5469).
+	 */
+	if (to_modem != NULL) {
+		*to_modem = modem_tx.endpoint;
+	}
+	if (from_modem != NULL) {
+		*from_modem = modem_rx.endpoint;
+	}
+	return 2;
+}
+
+void
+pandora_ipa_status(char *to, size_t size)
+{
+	if (to == NULL || size == 0) {
+		return;
+	}
+	snprintf(to, size, "to the modem %llu packets (%llu bytes, %llu dropped), from it %llu (%llu bytes), "
+	    "%llu to the LAN endpoint; errors %llu/%llu/%llu; channels %u/%u/%u/%u", modem_tx.packets,
+	    modem_tx.bytes, modem_tx.dropped, modem_rx.packets, modem_rx.bytes, lan_rx.packets, modem_tx.errors,
+	    modem_rx.errors, lan_rx.errors, channel_state(&command), channel_state(&lan_rx),
+	    channel_state(&modem_tx), channel_state(&modem_rx));
+}
+
+/* =====================================================================================
+ * 7. The IPA's local memory, and the hardware programming that goes with it
+ *
+ * Both are Android's driver's work before the modem starts (techpack/dataipa: ipa3_post_init()
+ * -> ipa3_init_hw(), ipa3_set_resorce_groups_min_max_limits(), ipa3_cfg_route()), and HakiOS's
+ * ipa_memory_init() and ipa_hardware_init() (hakios.mpss.c:1849-1946) are transcriptions of it
+ * for 4.11. Everything below is the same work for 5.5, region by region and register by register.
+ * ===================================================================================== */
+
+static vm_offset_t ipa_sram;                    /* IPA_SRAM_SIZE bytes at the local memory */
+
+/*
+ * The local memory is not a register file: it is memory the IPA reaches through the SMMU, and this
+ * side reaches through the mapping made in ipa_maps_make(). It is written with the same barriers as
+ * a register (HakiOS mapped it with need() and wrote it with wr(), hakios.mpss.c:1862-1873).
+ *
+ * The window is mapped from a 64 KB boundary below IPA_SRAM_PA (ipa_maps_make(), because the exact
+ * address of the local memory is one of the things this port is not certain of and a wide window
+ * covers every candidate). So the offsets below, which are offsets within the local memory, have
+ * to be shifted by however far the mapping's base sits below the local memory's own base --
+ * otherwise every read lands up to 0x8000 bytes past where it should and the offsets look plausible
+ * while being wrong.
+ */
+static uint32_t ipa_sram_at;                    /* IPA_SRAM_PA's offset within the mapped window */
+
+static inline void
+ipa_wr_sram(uint32_t offset, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ipa_sram + ipa_sram_at + offset) = value;
+}
+
+static inline uint32_t
+ipa_rd_sram(uint32_t offset)
+{
+	uint32_t v = *(volatile uint32_t *)(ipa_sram + ipa_sram_at + offset);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/*
+ * The local memory as Linux's ipa_mem_config() and ipa_mem_setup() leave it: zeroed from the
+ * microcontroller's area onwards, with "canaries" (0xdeadbeef) in the words before the regions
+ * that have them, and the register that says where the modem's processing contexts begin.
+ *
+ * Two things are different from 4.11 and both are transcribed from Linux's ipa_data-v5.5.c
+ * (spec 3.1, 3.2):
+ *
+ *   - The zeroing starts at 0x1000, not 0x288: the region at 0x0000 is IPA_MEM_UC_EVENT_RING, a
+ *     whole 4 KB of the microcontroller's own command and response ring, and 4.11 had no such
+ *     region. Zeroing it would take the microcontroller's mailbox away. It ends at 0x4fe8, the
+ *     end of IPA_MEM_PDN_CONFIG, which is the last region (0x4ee8 + 0x100); 4.11 ended at 0x3000.
+ *   - The canary table is fifteen entries of two each, not fourteen of one or two: 5.5's
+ *     NAT_TABLE (0x45e0) has no canaries and its PDN_CONFIG (0x4ee8) has two, where 4.11 had one
+ *     at its NAT table and none at the end.
+ *
+ * LOCAL_PKT_PROC_CNTXT moved from 0x1e8 to 0x478 and now holds 0x1b40 (IPA_MEM_MODEM_PROC_CTX)
+ * where 4.11 held 0x0ad0: the modem's processing contexts are a different region and a different
+ * size (0xb20 instead of 0xac0).
+ */
+static void
+ipa_memory_init(void)
+{
+	static const struct {
+		uint16_t offset, canaries;
+	} regions[] = {
+		{ 0x1288, 2 },  /* V4_FILTER_HASHED   */
+		{ 0x1308, 2 },  /* V4_FILTER          */
+		{ 0x1388, 2 },  /* V6_FILTER_HASHED   */
+		{ 0x1408, 2 },  /* V6_FILTER          */
+		{ 0x1488, 2 },  /* V4_ROUTE_HASHED    */
+		{ 0x1528, 2 },  /* V4_ROUTE           */
+		{ 0x15c8, 2 },  /* V6_ROUTE_HASHED    */
+		{ 0x1668, 2 },  /* V6_ROUTE           */
+		{ 0x1708, 2 },  /* MODEM_HEADER       */
+		{ 0x1b40, 2 },  /* MODEM_PROC_CTX     */
+		{ 0x2868, 2 },  /* STATS_QUOTA_MODEM  */
+		{ 0x29b8, 2 },  /* AP_V4_FILTER       */
+		{ 0x2cd0, 2 },  /* STATS_FILTER_ROUTE */
+		{ 0x3898, 2 },  /* MODEM              */
+		{ 0x4ee8, 2 },  /* PDN_CONFIG         */
+	};
+	const uint32_t from = 0x1000, to = 0x4fe8;
+
+	if (ipa_sram == 0) {
+		return;
+	}
+	for (uint32_t at = from; at < to; at += 4) {
+		ipa_wr_sram(ipa_mem_offset + at, 0);
+	}
+	for (unsigned r = 0; r < sizeof(regions) / sizeof(regions[0]); r++) {
+		for (unsigned c = 1; c <= regions[r].canaries; c++) {
+			ipa_wr_sram(ipa_mem_offset + regions[r].offset - 4 * c, 0xdeadbeef);
+		}
+	}
+	/* Where the modem's processing contexts begin. */
+	ipa_wr(IPA_LOCAL_PKT_PROC_CNTXT, ipa_mem_offset + IPA_MEM_MODEM_PROC_CTX);
+	pandora_settle();
+	if (!ipa_quiet) {
+		printf("PANDORA IPA: its local memory zeroed (%#x..%#x at offset %#x), %u canaries written, "
+		    "the processing contexts' base set to %#x\n", from, to, ipa_mem_offset,
+		    2 * (unsigned)(sizeof(regions) / sizeof(regions[0])), ipa_mem_offset + IPA_MEM_MODEM_PROC_CTX);
+	}
+}
+
+/*
+ * The QSB masters' outstanding reads and writes, the Qtime timers, the GSI's in-order bits of
+ * COMP_CFG, the idle indication, the resource groups' limits and the default route.
+ *
+ * Without the resource groups nothing can be processed at all: the modem's own commands to the
+ * IPA would never complete, and its answer to INIT_DRIVER never come (HakiOS's note at
+ * hakios.mpss.c:1880). Without the right default route every packet that matches no rule is
+ * dropped.
+ */
+static void
+ipa_hardware_init(void)
+{
+	/*
+	 * The source groups' five types, group 0 (UL) in X and group 1 (DL) in Y. Linux's
+	 * ipa_data-v5.5.c:186-282 (spec 4.7):
+	 *
+	 *   type                 UL min/max  DL min/max
+	 *   SRC_PKT_CONTEXTS     3 / 9       4 / 10
+	 *   SRC_DESCRIPTOR_LISTS 9 / 9       12 / 12
+	 *   SRC_DESCRIPTOR_BUFF  9 / 9       24 / 24
+	 *   SRC_HPS_DMARS        0 / 63      0 / 63
+	 *   SRC_ACK_ENTRIES      22 / 22     16 / 16
+	 *
+	 * This is the hazard the spec calls the most easily missed of the four (spec 4.7): 4.11 had
+	 * no non-zero limits for group 1, so HakiOS wrote Y as 0 for every type and it worked. On
+	 * 5.5 the downlink group has its own limits and a zero in Y leaves the modem-to-this-
+	 * processor direction with no quota -- uplink works, downlink loses every packet.
+	 */
+	static const struct {
+		uint8_t ul_min, ul_max, dl_min, dl_max;
+	} source[] = {
+		{ 3, 9, 4, 10 },        /* SRC_PKT_CONTEXTS    */
+		{ 9, 9, 12, 12 },       /* SRC_DESCRIPTOR_LISTS */
+		{ 9, 9, 24, 24 },       /* SRC_DESCRIPTOR_BUFF  */
+		{ 0, 63, 0, 63 },       /* SRC_HPS_DMARS        */
+		{ 22, 22, 16, 16 },     /* SRC_ACK_ENTRIES      */
+	};
+	uint32_t value;
+
+	/* ---- QSB: no limit on the DDR master's writes, 12 reads, and 8 on the PCIe master ---- */
+	/*
+	 * 5.5's data is { max_writes = 0 (unlimited), max_reads = 12, beats = 0 } for the DDR
+	 * master and { 0, 8, 0 } for PCIe (spec 4.2). HakiOS wrote 12 writes, 13 reads and 120
+	 * beats, because those were 4.11's. Both masters fit in the one word each: writes in
+	 * [3:0] and [7:4], reads likewise, the beats in [23:16] and [31:24].
+	 */
+	value = ipa_rd(IPA_QSB_MAX_WRITES);
+	ipa_wr(IPA_QSB_MAX_WRITES, (value & ~0xffu) | 0u | 0u << 4);
+	value = ipa_rd(IPA_QSB_MAX_READS);
+	ipa_wr(IPA_QSB_MAX_READS, (value & ~0xff0000ffu) | 12u | 8u << 4 | 0u << 16 | 0u << 24);
+
+	/* ---- Qtime: the divider off, the timestamps, the pulse generators, the divider on ---- */
+	/*
+	 * 5.5 dropped DPL_TIMESTAMP_LSB and DPL_TIMESTAMP_SEL from QTIME_TIMESTAMP_CFG (spec 4.3),
+	 * so the value is 0x180e00 where HakiOS's 0x180e8e had the two dead fields in the low byte:
+	 * TAG_TIMESTAMP_LSB = 14 at [12:8], NAT_TIMESTAMP_LSB = 24 at [20:16].
+	 *
+	 * TIMERS_PULSE_GRAN_CFG is where 5.5's two new pulse generators show: gran 0 = 100 us (3),
+	 * gran 1 = 1 ms (4), gran 2 = 10 ms (5, was 1 ms) and gran 3 = 10 ms (5, was unset), so
+	 * 3 | 4<<3 | 5<<6 | 5<<9 = 0x0b63 where HakiOS's 0x123 had 4 and 0. Gran 0 is what the
+	 * receive endpoints' aggregation time limit is counted in, which is why it must match
+	 * AGGR_TIME_TICKS's 100 us assumption above.
+	 */
+	ipa_wr(IPA_TIMERS_XO_CLK_DIV_CFG, 0);
+	ipa_wr(IPA_QTIME_TIMESTAMP_CFG, (uint32_t)14 << 8 | (uint32_t)24 << 16);
+	ipa_wr(IPA_TIMERS_PULSE_GRAN_CFG, 3u | 4u << 3 | 5u << 6 | 5u << 9);
+	ipa_wr(IPA_TIMERS_XO_CLK_DIV_CFG, 0xbf);                /* 192 - 1, the divider itself */
+	ipa_wr(IPA_TIMERS_XO_CLK_DIV_CFG, 0x800000bf);          /* ... and enabled (bit 31) */
+
+	/* ---- COMP_CFG: the GSI's two in-order bits, written twice (the HPG asks for it) ---- */
+	value = ipa_rd(IPA_COMP_CFG);
+	value |= 1u << 7 | 1u << 8;                             /* GSI_MULTI_INORDER_RD_DIS, _WR_DIS */
+	ipa_wr(IPA_COMP_CFG, value);
+	ipa_wr(IPA_COMP_CFG, value);
+
+	/* ---- the idle indication: enter idle after 256, no constant non-idle ---- */
+	ipa_wr(IPA_IDLE_INDICATION_CFG, 256);
+
+	/* ---- the resource groups ---- */
+	for (unsigned n = 0; n < sizeof(source) / sizeof(source[0]); n++) {
+		ipa_wr(IPA_SRC_RSRC_GRP_01(n), RSRC(source[n].ul_min, source[n].ul_max, source[n].dl_min,
+		    source[n].dl_max));
+	}
+	/*
+	 * The destination groups' three types (spec 4.7):
+	 *
+	 *   DST_DATA_SECTORS    6 / 6   5 / 5     <- the downlink's 5 is the one that matters here
+	 *   DST_DPS_DMARS       0 / 3   0 / 3
+	 *   DST_ULSO_SEGMENTS   0 / 63  0 / 63
+	 *
+	 * HakiOS wrote 3 for the uplink data sectors and 25 into group 2 (DRB_IP) and nothing at all
+	 * into the destinations' Y positions; the 5 in the downlink is exactly what the modem's
+	 * receive endpoint (resource group 1) draws on.
+	 */
+	ipa_wr(IPA_DST_RSRC_GRP_01(0), RSRC(6, 6, 5, 5));       /* DATA_SECTORS  */
+	ipa_wr(IPA_DST_RSRC_GRP_01(1), RSRC(0, 3, 0, 3));       /* DPS_DMARS     */
+	ipa_wr(IPA_DST_RSRC_GRP_01(2), RSRC(0, 63, 0, 63));     /* ULSO_SEGMENTS */
+
+	/*
+	 * ---- the default route ----
+	 *
+	 * 5.5's field layout is completely different from 4.11's (spec 4.6): DEF_PIPE is [7:0] not
+	 * [5:1], FRAG_DEF_PIPE is [15:8] not [21:17], DEF_HDR_TABLE moved from bit 6 to bit 26,
+	 * DEF_RETAIN_HDR from 24 to 27 and ROUTE_DIS from 0 to 28.
+	 *
+	 * HakiOS's 0x1120052 is 4.11's encoding: default pipe 9 (the LAN receive endpoint there),
+	 * header table 1, fragments to 9, header retained. Read with 5.5's fields it decodes to
+	 * DEF_PIPE = 0x52 = 82, which is not an endpoint at all -- the default route points at
+	 * nothing and every packet that matches no rule is dropped. That is the "the data path looks
+	 * up but not one packet arrives" symptom.
+	 *
+	 * The right value for 5.5 names the LAN receive endpoint (16) in both pipe fields:
+	 * 16 | 16 << 8 | BIT(26) | BIT(27) = 0x0c001010.
+	 */
+	ipa_wr(IPA_ROUTE, 0x0c001010u);
+	pandora_settle();
+	if (!ipa_quiet) {
+		printf("PANDORA IPA: the hardware set up as Android's driver does before the modem: QSB writes %#x reads %#x, "
+		    "COMP_CFG %#x, idle %#x, route %#x, source groups %#x/%#x/%#x/%#x/%#x, destination groups %#x/%#x/%#x\n",
+		    ipa_rd(IPA_QSB_MAX_WRITES), ipa_rd(IPA_QSB_MAX_READS), ipa_rd(IPA_COMP_CFG),
+		    ipa_rd(IPA_IDLE_INDICATION_CFG), ipa_rd(IPA_ROUTE), ipa_rd(IPA_SRC_RSRC_GRP_01(0)),
+		    ipa_rd(IPA_SRC_RSRC_GRP_01(1)), ipa_rd(IPA_SRC_RSRC_GRP_01(2)), ipa_rd(IPA_SRC_RSRC_GRP_01(3)),
+		    ipa_rd(IPA_SRC_RSRC_GRP_01(4)), ipa_rd(IPA_DST_RSRC_GRP_01(0)), ipa_rd(IPA_DST_RSRC_GRP_01(1)),
+		    ipa_rd(IPA_DST_RSRC_GRP_01(2)));
+	}
+}
+
+/* =====================================================================================
+ * 8. The clock, the SMMU, the firmware and the mappings
+ * ===================================================================================== */
+
+/*
+ * ---- the clock ----
+ *
+ * The IPA's clock is the RPMh resource RPMH_IPA_CLK (Linux: clocks = <&rpmhcc RPMH_IPA_CLK>).
+ * HakiOS voted it as the BCM "IP0" with the full 0x3fff level (hakios.mpss.c:999-1022), and voted
+ * the interconnect BCMs on the IPA's way to memory (SN8, SH0, MC0, ACV) while the IPA was on.
+ *
+ * PORTER'S NOTE (spec 5.7, confidence LOW): the command database's name for that clock on canoe is
+ * not verified. "IP0" is what it is on the platforms HakiOS ran; "ipa" is what RPMH_IPA_CLK is
+ * called in Linux's command database entries for this family. Both are tried, and neither name
+ * existing is not fatal -- the bootloader or the PAS may have left the clock on -- so bring-up
+ * prints which one took and carries on. Boot-arg pandora_ipa_clock_off=1 skips the votes entirely.
+ *
+ * The buses: pandora_adsp.c's bcm_vote() is static, and pandora_rpmh_resource() is the exported
+ * path to a command-database write. BCM_VOTE's encoding is TCS-shaped -- commit, valid, x, y,
+ * 14 bits each -- and is reproduced here for the same reason pandora_adsp.c has it: an ARC vote
+ * and a BCM vote are different things and the resource's own entry says which it is.
+ */
+#define BCM_CMD(commit, valid, x, y) \
+	(((uint32_t)(commit) << 30) | ((uint32_t)(valid) << 29) | (((uint32_t)(x) & 0x3fff) << 14) | \
+	((uint32_t)(y) & 0x3fff))
+#define BCM_VOTE_MAX     0x3fffu
+
+static bool
+ipa_clock(bool on)
+{
+	static const char *const clocks[] = { "IP0", "ipa" };
+	static const char *const buses[] = { "SN8", "SH0", "MC0", "ACV" };
+	bool took = false;
+
+	if (ipa_option("clock_off")) {
+		printf("PANDORA IPA: the clock is not voted for (pandora_ipa_clock_off)\n");
+		return true;
+	}
+	for (unsigned c = 0; c < sizeof(clocks) / sizeof(clocks[0]); c++) {
+		if (pandora_rpmh_resource(clocks[c], 0, BCM_CMD(1, 1, 0, on ? BCM_VOTE_MAX : 0)) == 0) {
+			printf("PANDORA IPA: the clock %s is voted %s\n", clocks[c], on ? "on" : "off");
+			took = true;
+			break;
+		}
+	}
+	if (!took) {
+		/*
+		 * Not fatal: the bootloader may have left it running, and the PAS call below is the
+		 * authority on whether the firmware starts. Say so plainly rather than failing here.
+		 */
+		printf("PANDORA IPA: neither RPMh resource name for the IPA's clock (IP0, ipa) is in the "
+		    "command database: going on without voting for it\n");
+	}
+	for (unsigned b = 0; b < sizeof(buses) / sizeof(buses[0]); b++) {
+		(void)pandora_rpmh_resource(buses[b], 0, BCM_CMD(1, 1, 0, on ? BCM_VOTE_MAX : 0));
+	}
+	return true;
+}
+
+/*
+ * ---- the SMMU ----
+ *
+ * The IPA reaches memory through the application processors' SMMU, where a stream nobody matches
+ * faults and the hypervisor grants no bypass (HakiOS tried on 24 October: the S2CR stayed "fault",
+ * hakios.mpss.c:1949-1953). So, as the Wi-Fi's radio has in pandora_wifi.c: a translation context
+ * of our own, with the first two free match registers and the lowest free context, and page tables
+ * of ours that show the IPA memory as it is.
+ *
+ * What changed for canoe (spec 6.3):
+ *   - the stream ids: 0x4a0 (AP) and 0x4a2 (the microcontroller), not 0x480/0x482. The
+ *     hypervisor checks what is written to a match register against the device tree's iommus
+ *     entries, so these must be the real ones or the SMR reads back 0;
+ *   - the mask stays 0, which is what the device tree says (<&apps_smmu 0x4a0 0x0>), so each
+ *     stream takes a match register of its own;
+ *   - the mapping is the whole 0x100000 of the DT's reg, not 2 KB: the context banks live from
+ *     +0x2000 to +0x100000 and HakiOS's 0x2000 could not reach its own context;
+ *   - the page tables cover all of DDR (the phone has 12 or 16 GB, HakiOS's 8 GB of 1 GB blocks
+ *     stopped short) and its block descriptors have AP[2] clear so the IPA can write.
+ *
+ * PORTER'S NOTE (spec 6.5, confidence MEDIUM): HakiOS's IPA_BLOCK has bit 6 set, which in the ARMv8
+ * long descriptor is AP[2] -- read-only at EL1. Its comment says "RW" and its author recorded IPA
+ * data flowing on SM7325, so either the SMMU does not enforce AP[2] on DMA writes or the constant
+ * was wrong all along. This port clears it: a page table that describes the memory as writable is
+ * the correct description, and if the IPA then faults with FSR.PERMISSION (0x10) the bit is the
+ * thing to put back. ipa_space_faults() logs exactly that.
+ */
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR0           0x050
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+/*
+ * CBAR and CBA2R (the context bank's attributes and its "64-bit TTBR" switch) are not in the
+ * window's first page: HakiOS mapped the SMMU twice, with apps_smmu_second.phys = apps_smmu.phys +
+ * ipa_space.page, and wrote CBAR at 4*n and CBA2R at 0x800 + 4*n within that second mapping
+ * (hakios.mpss.c:2004, :2124-2125). This file maps the whole 0x100000 window once, so the same
+ * address is the second page's start plus those offsets -- see ipa_space_second() below, which
+ * computes it from the page size the SMMU reports rather than assuming 0x1000.
+ */
+#define SMMU_CBAR_IN_PAGE(n)    (4 * (n))
+#define SMMU_CBA2R_IN_PAGE(n)   (0x800 + 4 * (n))
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CBA2R_64_BIT       1
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44      /* attr 0 uncached, attr 1 cached, attr 2 device */
+#define SMMU_FSR_ALL            0xc00001fe
+/* A 2 MB block, uncached, writable, outer-shareable, accessible, non-global. */
+#define IPA_BLOCK               (1ull | 0ull << 2 | 0ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)
+/* The same as a device, for the SoC's internal memory. */
+#define IPA_BLOCK_DEVICE        (1ull | 2ull << 2 | 0ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)
+#define IPA_TABLE               3ull            /* a table descriptor */
+
+static struct {
+	bool            on;
+	uint32_t        page, pages, match, match_uc, context;
+	uint32_t        old_smr, old_s2cr, old_smr_uc, old_s2cr_uc, old_sctlr;
+	vm_offset_t     smmu;                   /* the whole SMMU window */
+	vm_offset_t     tables;                 /* three pages: the root, the DDR's blocks, the SoC's */
+	uint64_t        tables_pa;
+} ipa_space;
+
+/* One SMMU register, at an absolute offset in the window. */
+static inline uint32_t
+smmu_rd(uint32_t offset)
+{
+	uint32_t v = *(volatile uint32_t *)(ipa_space.smmu + offset);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+smmu_wr(uint32_t offset, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ipa_space.smmu + offset) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* The IPA's context: its status register, its fault address and its fault syndrome, when asked
+ * for. HakiOS's ipa_space_faults(), hakios.mpss.c:2018-2035. */
+static void
+ipa_space_faults(const char *when)
+{
+	uint32_t status, global, cb;
+
+	if (!ipa_space.on) {
+		return;
+	}
+	cb = (uint32_t)((ipa_space.pages + ipa_space.context) * ipa_space.page);
+	status = smmu_rd(cb + SMMU_CB_FSR);
+	global = smmu_rd(SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		if (!ipa_quiet) {
+			printf("PANDORA IPA: %s: the SMMU has refused the IPA nothing (context %u)\n", when,
+			    ipa_space.context);
+		}
+		return;
+	}
+	{
+		uint64_t far = (uint64_t)smmu_rd(cb + SMMU_CB_FAR + 4) << 32 | smmu_rd(cb + SMMU_CB_FAR);
+
+		printf("PANDORA IPA: %s: THE SMMU HAS REFUSED A REQUEST OF THE IPA'S: context %u: status %#x, "
+		    "address %#llx, syndrome %#x%s; the SMMU as a whole: status %#x, syndromes %#x %#x\n", when,
+		    ipa_space.context, status, far, smmu_rd(cb + SMMU_CB_FSYNR0),
+		    (status & 0x20) ? " (TRANSLATION: the page tables do not map that address)" :
+		    (status & 0x10) ? " (PERMISSION: the block's AP bits)" : "", global,
+		    smmu_rd(SMMU_SGFSYNR0), smmu_rd(SMMU_SGFSYNR1));
+	}
+	smmu_wr(cb + SMMU_CB_FSR, SMMU_FSR_ALL);
+}
+
+/*
+ * The page tables, and the context that uses them.
+ *
+ * The layout is HakiOS's (hakios.mpss.c:2085-2115) with the coverage and the block attributes as
+ * above: a root table of 1 GB blocks over all of DDR (level 1, entries from index 2 = 0x80000000
+ * upwards), a second-level table for the first gigabyte holding the one 2 MB device block that is
+ * the SoC's internal memory, and nothing else below. 512 entries x 1 GB = the whole 512 GB address
+ * space, which costs one page and leaves no address of this phone unmapped.
+ */
+static bool
+ipa_space_tables(void)
+{
+	uint64_t *root, *soc;
+
+	if (ipa_space.tables == 0) {
+		if (kmem_alloc(kernel_map, &ipa_space.tables, 2 * PAGE_SIZE,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return false;
+		}
+	}
+	ipa_space.tables_pa = kvtophys(ipa_space.tables);
+	root = (uint64_t *)ipa_space.tables;
+	soc = (uint64_t *)(ipa_space.tables + PAGE_SIZE);
+	bzero((void *)ipa_space.tables, 2 * PAGE_SIZE);
+
+	/*
+	 * DDR, all of it, as 1 GB blocks (index 2 is 0x80000000). The rings and buffers this file
+	 * allocates are wherever the kernel's memory is, and on a 12 or 16 GB phone that is not
+	 * always in the first gigabyte.
+	 */
+	for (unsigned g = (unsigned)(IPA_SPACE_BASE >> 30); g < 512; g++) {
+		root[g] = ((uint64_t)g << 30) | IPA_BLOCK;
+	}
+	/*
+	 * The SoC's internal memory: the 2 MB block that holds ipa_sram_pa, as a device. The block
+	 * descriptor has to be 2 MB aligned, so this uses IPA_IMEM_DEFAULT's block and not the
+	 * imem address itself -- 0x14688000 is inside the block at 0x14600000.
+	 */
+	soc[(IPA_IMEM_DEFAULT >> 21) & 0x1ff] = ((uint64_t)IPA_IMEM_DEFAULT) | IPA_BLOCK_DEVICE;
+	root[IPA_IMEM_DEFAULT >> 30] = ipa_space.tables_pa + PAGE_SIZE | IPA_TABLE;
+
+	FlushPoC_DcacheRegion(ipa_space.tables, 2 * PAGE_SIZE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
+}
+
+/*
+ * Find two free match registers and the lowest free context, then program the context and only
+ * then let the streams in -- the order matters (HakiOS's ipa_space_on(),
+ * hakios.mpss.c:2038-2165, and Linux's arm_smmu_attach_dev()).
+ */
+static bool
+ipa_space_on(void)
+{
+	bool used[256] = { false };
+	uint32_t scr0, idr0, idr1, matches, contexts, cb;
+	uint64_t ttbr;
+	bool ok = false;
+
+	if (ipa_space.on) {
+		return true;
+	}
+	if (ipa_space.smmu == 0) {
+		ipa_space.smmu = ipa_map(APPS_SMMU_PA, APPS_SMMU_SIZE);
+		if (ipa_space.smmu == 0) {
+			printf("PANDORA IPA: the apps SMMU cannot be mapped\n");
+			return false;
+		}
+	}
+	pandora_apps_smmu_lock();
+	scr0 = smmu_rd(SMMU_SCR0);
+	idr0 = smmu_rd(SMMU_IDR0);
+	idr1 = smmu_rd(SMMU_IDR1);
+	matches = idr0 & 0xff;
+	contexts = idr1 & 0xff;
+	ipa_space.page = (idr1 >> 31) ? 0x10000 : 0x1000;
+	ipa_space.pages = 2u << ((idr1 >> 28) & 7);
+	if ((scr0 & 1u << 3) || 2 * ipa_space.pages * ipa_space.page != 0x100000) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA IPA: the SMMU is not of the shape this knows (scr0 %#x, idr1 %#x)\n", scr0, idr1);
+		return false;
+	}
+	ipa_space.match = ipa_space.match_uc = ~0u;
+	for (uint32_t n = 0; n < matches && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = smmu_rd(SMMU_SMR(n)), s2cr = smmu_rd(SMMU_S2CR(n));
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+		} else if (ipa_space.match == ~0u) {
+			ipa_space.match = n;
+			ipa_space.old_smr = smr;
+			ipa_space.old_s2cr = s2cr;
+		} else if (ipa_space.match_uc == ~0u) {
+			ipa_space.match_uc = n;
+			ipa_space.old_smr_uc = smr;
+			ipa_space.old_s2cr_uc = s2cr;
+		}
+	}
+	for (ipa_space.context = 0; ipa_space.context < contexts && used[ipa_space.context];
+	    ipa_space.context++) {
+	}
+	if (ipa_space.match == ~0u || ipa_space.match_uc == ~0u || ipa_space.context >= contexts) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA IPA: the SMMU has not two match registers free or no context left\n");
+		return false;
+	}
+	cb = (uint32_t)((ipa_space.pages + ipa_space.context) * ipa_space.page);
+	ipa_space.old_sctlr = smmu_rd(cb + SMMU_CB_SCTLR);
+	if (ipa_space.old_sctlr & 1) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA IPA: context %u of the SMMU is switched on although no stream of ours goes "
+		    "through it: left alone\n", ipa_space.context);
+		return false;
+	}
+	if (!ipa_space_tables()) {
+		pandora_apps_smmu_unlock();
+		printf("PANDORA IPA: no memory for the SMMU's tables\n");
+		return false;
+	}
+	ttbr = ipa_space.tables_pa | (uint64_t)ipa_space.context << 48;
+	printf("PANDORA IPA: THE SMMU IS ABOUT TO BE WRITTEN: context %u gets our tables (root %#llx: DDR from "
+	    "%#llx as it is, and the SoC's memory at %#x) and match registers %u and %u send streams %#x and %#x "
+	    "through it (before: smr %#x s2cr %#x, smr %#x s2cr %#x, sctlr %#x)\n", ipa_space.context,
+	    ttbr & 0x0000fffffffff000ull, IPA_SPACE_BASE, IPA_IMEM_DEFAULT, ipa_space.match, ipa_space.match_uc,
+	    ipa_stream, ipa_stream_uc, ipa_space.old_smr, ipa_space.old_s2cr, ipa_space.old_smr_uc,
+	    ipa_space.old_s2cr_uc, ipa_space.old_sctlr);
+
+	smmu_wr(cb + SMMU_CB_SCTLR, 0);
+	smmu_wr(ipa_space.page + SMMU_CBA2R_IN_PAGE(ipa_space.context), SMMU_CBA2R_64_BIT);
+	smmu_wr(ipa_space.page + SMMU_CBAR_IN_PAGE(ipa_space.context), SMMU_CBAR_STAGE_1);
+	smmu_wr(cb + SMMU_CB_TCR2, SMMU_TCR2);
+	smmu_wr(cb + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	smmu_wr(cb + SMMU_CB_TTBR0, (uint32_t)ttbr);
+	smmu_wr(cb + SMMU_CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	smmu_wr(cb + SMMU_CB_TTBR1, 0);
+	smmu_wr(cb + SMMU_CB_TTBR1 + 4, 0);
+	smmu_wr(cb + SMMU_CB_MAIR0, SMMU_MAIR0);
+	smmu_wr(cb + SMMU_CB_MAIR1, 0);
+	smmu_wr(cb + SMMU_CB_FSR, SMMU_FSR_ALL);
+	smmu_wr(cb + SMMU_CB_TLBIASID, ipa_space.context);
+	smmu_wr(cb + SMMU_CB_TLBSYNC, 1);
+	for (unsigned ms = 0; smmu_rd(cb + SMMU_CB_TLBSTATUS) & 1; ms++) {
+		if (ms == 100) {
+			pandora_apps_smmu_unlock();
+			printf("PANDORA IPA: the SMMU does not finish forgetting old translations\n");
+			return false;
+		}
+		pandora_sleep_ms(1);
+	}
+	smmu_wr(cb + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	ipa_space.on = true;
+	/* Only now do the streams go in: the context has to be live first. */
+	{
+		uint32_t sees = 1u << 31 | ipa_stream, sees_uc = 1u << 31 | ipa_stream_uc;
+
+		smmu_wr(SMMU_S2CR(ipa_space.match), ipa_space.context);
+		smmu_wr(SMMU_SMR(ipa_space.match), sees);
+		smmu_wr(SMMU_S2CR(ipa_space.match_uc), ipa_space.context);
+		smmu_wr(SMMU_SMR(ipa_space.match_uc), sees_uc);
+		ok = smmu_rd(SMMU_SMR(ipa_space.match)) == sees &&
+		    (smmu_rd(SMMU_S2CR(ipa_space.match)) & 0x300ff) == ipa_space.context &&
+		    smmu_rd(SMMU_SMR(ipa_space.match_uc)) == sees_uc &&
+		    (smmu_rd(SMMU_S2CR(ipa_space.match_uc)) & 0x300ff) == ipa_space.context &&
+		    (smmu_rd(cb + SMMU_CB_SCTLR) & 1) && smmu_rd(cb + SMMU_CB_TTBR0) == (uint32_t)ttbr;
+		if (!ok) {
+			printf("PANDORA IPA: THE SMMU DID NOT TAKE WHAT WAS WRITTEN: streams %#x and %#x are not both "
+			    "going through context %u (smr %#x s2cr %#x, smr %#x s2cr %#x, sctlr %#x)\n", ipa_stream,
+			    ipa_stream_uc, ipa_space.context, smmu_rd(SMMU_SMR(ipa_space.match)),
+			    smmu_rd(SMMU_S2CR(ipa_space.match)), smmu_rd(SMMU_SMR(ipa_space.match_uc)),
+			    smmu_rd(SMMU_S2CR(ipa_space.match_uc)), smmu_rd(cb + SMMU_CB_SCTLR));
+		}
+	}
+	pandora_apps_smmu_unlock();
+	if (ok) {
+		printf("PANDORA IPA: THE IPA'S STREAMS GO THROUGH CONTEXT %u OF THE SMMU, with our tables (match "
+		    "registers %u and %u)\n", ipa_space.context, ipa_space.match, ipa_space.match_uc);
+	}
+	return ok;
+}
+
+static void
+ipa_space_off(void)
+{
+	uint32_t cb;
+
+	if (!ipa_space.on) {
+		return;
+	}
+	ipa_space_faults("at the end");
+	cb = (uint32_t)((ipa_space.pages + ipa_space.context) * ipa_space.page);
+	pandora_apps_smmu_lock();
+	smmu_wr(SMMU_SMR(ipa_space.match), ipa_space.old_smr);
+	smmu_wr(SMMU_S2CR(ipa_space.match), ipa_space.old_s2cr);
+	smmu_wr(SMMU_SMR(ipa_space.match_uc), ipa_space.old_smr_uc);
+	smmu_wr(SMMU_S2CR(ipa_space.match_uc), ipa_space.old_s2cr_uc);
+	smmu_wr(cb + SMMU_CB_SCTLR, ipa_space.old_sctlr);
+	pandora_apps_smmu_unlock();
+	ipa_space.on = false;
+	printf("PANDORA IPA: the IPA's streams and context %u of the SMMU are put back as they were found\n",
+	    ipa_space.context);
+}
+
+/* ---- the firmware ----------------------------------------------------------------------- */
+
+/*
+ * The firmware is PAS image 15, loaded out of the modem's firmware partition into the
+ * ipa_gsi_region carveout: pandora_pas_load("modem", "ipa_fws", 15, 0x99590000, 0xa000) and then
+ * pandora_pas_auth(15). Both are pandora_pas.c's, which is pandora_adsp.c's PAS sequence separated
+ * out; there is nothing for this file to do but call them.
+ *
+ * Why "modem": the image is image/ipa_fws.mdt and its segments on the modem_a partition (Android's
+ * /vendor/firmware_mnt), next to the modem's own images. pandora_fw_open("modem", ...) resolves
+ * that by GPT prefix, and pandora_pas.c's mdt_segment() builds the segment names "%s.b%02u" from
+ * the base name, so "ipa_fws" finds ipa_fws.b00 through .b04 with nothing more to say (spec 5.5:
+ * HakiOS hard-coded "image/yupik_ipa_fws.b%02u" and could not be moved to another image).
+ *
+ * Why the ipa_gsi region and not ipa_fw: HakiOS recorded that on SM7325 the image loaded at the
+ * ipa_fw reservation (0x8b700000) started GSI but the microcontroller never wrote "booted" and
+ * the modem never answered INIT_DRIVER, while the ipa_gsi reservation (0x8b710000) worked
+ * (hakios.mpss.c:1803-1808). canoe's devicetree names ipa_gsi_region@99590000 for exactly this.
+ */
+static bool
+ipa_firmware_load(void)
+{
+	if (ipa_option("fw_off")) {
+		printf("PANDORA IPA: the firmware is not loaded (pandora_ipa_fw_off)\n");
+		return true;
+	}
+	if (pandora_pas_load("modem", "ipa_fws", IPA_PAS, ipa_fw_pa, ipa_fw_size) != 0) {
+		printf("PANDORA IPA: the firmware could not be loaded (PAS %u at %#llx, %u bytes)\n", IPA_PAS,
+		    ipa_fw_pa, ipa_fw_size);
+		return false;
+	}
+	if (pandora_pas_auth(IPA_PAS) != 0) {
+		printf("PANDORA IPA: TrustZone refused to start the firmware (PAS %u)\n", IPA_PAS);
+		return false;
+	}
+	/*
+	 * The microcontroller does not answer at once. HakiOS slept and then read; 50 ms is enough
+	 * on the evidence of the platform's own driver and costs nothing at boot.
+	 */
+	pandora_sleep_ms(50);
+	return true;
+}
+
+/*
+ * Whether the firmware really started, and what it says of itself (spec 5.9, HakiOS's
+ * ipa_status(), hakios.mpss.c:1813-1838).
+ *
+ * The three registers that answer the first question, in the order they come up:
+ *   GSI_CFG (GSI base + 0x000),  bit 0: the GSI firmware is enabled
+ *   MCS_CFG (GSI base + 0xb000), bit 0: the microcontroller's sequencer is running
+ *   GSI_STATUS (+ 0x25000),     bit 0: the GSI is enabled    -- 4.11 read this at +0x12000
+ *
+ * And the one that answers whether it is usefully up: the microcontroller's shared area is at
+ * local memory + mem_offset + 0x1000, and its response byte (offset 0x0c) is 1 once it has booted
+ * and can answer commands. That byte is also the check that mem_offset was read correctly, which
+ * is the least certain thing in this port (spec 3.3).
+ */
+static bool
+ipa_firmware_running(void)
+{
+	uint32_t cfg = gsi_rd(GSI_CFG), mcs = gsi_rd(GSI_MCS_CFG), status = gsi_rd(GSI_STATUS);
+	bool running = (cfg & 1) != 0 && (status & 1) != 0;
+
+	printf("PANDORA IPA: GSI_CFG %#x (%s), MCS_CFG %#x (%s), GSI_STATUS %#x (%s)\n", cfg,
+	    (cfg & 1) ? "the GSI firmware is enabled" : "NOT enabled", mcs,
+	    (mcs & 1) ? "the sequencer runs" : "NOT running", status,
+	    (status & 1) ? "ENABLED" : "NOT ENABLED");
+	if (running) {
+		return true;
+	}
+	/*
+	 * The last resort Android has and HakiOS copied (hakios.mpss.c:2361-2374): if TrustZone
+	 * loaded the image into DDR but never moved it into the IPA's own iRAM, the sequencer and
+	 * the GSI can be started by hand. It is not tried unless asked for, because if the image
+	 * really is not there this makes a wrong state rather than a right one.
+	 */
+	if (ipa_option("gsi_enable")) {
+		printf("PANDORA IPA: starting the GSI by hand (pandora_ipa_gsi_enable): sequencer on, then GSI on "
+		    "with twice the sequencer clock and the sleep clock halved\n");
+		gsi_wr(GSI_MCS_CFG, 1);
+		gsi_wr(GSI_CFG, 1u | 1u << 2 | 2u << 8);
+		pandora_settle();
+		cfg = gsi_rd(GSI_CFG);
+		mcs = gsi_rd(GSI_MCS_CFG);
+		status = gsi_rd(GSI_STATUS);
+		printf("PANDORA IPA: after that: GSI_CFG %#x, MCS_CFG %#x, GSI_STATUS %#x\n", cfg, mcs, status);
+		return (cfg & 1) != 0 && (status & 1) != 0;
+	}
+	return false;
+}
+
+/* What the IPA says of itself: its local memory's offset and size, the microcontroller's words,
+ * the GSI's status and error log. HakiOS's ipa_status(), with 5.5's offsets. */
+static void
+ipa_report(const char *when)
+{
+	uint32_t shared, uc0, uc3, uc5, uc7, uc8, iface = 0;
+
+	if (ipa_regs == 0) {
+		return;
+	}
+	shared = ipa_rd(IPA_SHARED_MEM_SIZE);
+	/*
+	 * MEM_BADDR is bits 31:16 in units of eight bytes; MEM_SIZE is bits 15:0 likewise
+	 * (Linux's ipa_mem_config()). Reading 4.11's 0x54 here gives the ROUTE register, which is
+	 * how the offset comes out as nonsense.
+	 */
+	ipa_mem_offset = 8 * (shared >> 16);
+	if (ipa_sram != 0) {
+		uc0 = ipa_rd_sram(ipa_mem_offset + 0x00);       /* command (byte 0) */
+		uc3 = ipa_rd_sram(ipa_mem_offset + 0x0c);       /* response (byte 0): 1 once booted */
+		uc5 = ipa_rd_sram(ipa_mem_offset + 0x14);       /* event (byte 0) */
+		uc7 = ipa_rd_sram(ipa_mem_offset + 0x1c);       /* the first error's address */
+		uc8 = ipa_rd_sram(ipa_mem_offset + 0x20);       /* hw_state (byte 0), warnings (byte 1) */
+		iface = ipa_rd_sram(ipa_mem_offset + 0x1080 + 0x24) & 0xffff;   /* UC_INFO's interface version */
+	} else {
+		uc0 = uc3 = uc5 = uc7 = uc8 = 0;
+	}
+	if (ipa_quiet) {
+		return;
+	}
+	printf("PANDORA IPA: %s: shared memory %#x (offset %u = 8 * %#x, %u bytes); uC command %#x response %#x "
+	    "(%s) event %#x error address %#x hw_state %u warnings %u, interface %#x; GSI status %#x (%s), error "
+	    "log %#x\n", when, shared, ipa_mem_offset, shared >> 16, 8 * (shared & 0xffff), uc0 & 0xff, uc3 & 0xff,
+	    (uc3 & 0xff) == 1 ? "BOOTED" : "not booted", uc5 & 0xff, uc7, uc8 & 0xff, (uc8 >> 8) & 0xff, iface,
+	    gsi_rd(GSI_STATUS), (gsi_rd(GSI_STATUS) & 1) ? "ENABLED" : "NOT ENABLED", gsi_rd(GSI_ERROR_LOG));
+}
+
+/* The microcontroller has booted: its response byte is 1. */
+static bool
+ipa_uc_booted(void)
+{
+	if (ipa_sram == 0) {
+		return false;
+	}
+	return (ipa_rd_sram(ipa_mem_offset + 0x0c) & 0xff) == 1;
+}
+
+/* =====================================================================================
+ * 9. The data path's bring-up
+ *
+ * HakiOS's hakios_ipa_data_setup(), hakios.ipa.c:790-870, with the boot-arg names changed, the
+ * PAGE_SIZE assertion dropped, the register windows resized, 5.5's SHARED_MEM_SIZE offset, and the
+ * default route written here rather than in ipa_hardware_init() because its value is the LAN
+ * receive endpoint's number and that is the channel table's to say (spec 9.6).
+ * ===================================================================================== */
+
+static bool
+ipa_data_setup(void)
+{
+	uint32_t shared;
+
+	if (ipa_up) {
+		return true;
+	}
+	if (ipa_option("data_off")) {
+		printf("PANDORA IPA: no data path (pandora_ipa_data_off)\n");
+		return false;
+	}
+	shared = ipa_rd(IPA_SHARED_MEM_SIZE);
+	ipa_mem_offset = 8 * (shared >> 16);
+	if (ipa_mem_offset == 0) {
+		printf("PANDORA IPA: the local memory's offset in SHARED_MEM_SIZE is zero (%#x): no data path\n", shared);
+		return false;
+	}
+	if ((gsi_rd(GSI_STATUS) & 1) == 0) {
+		printf("PANDORA IPA: the GSI is not enabled (status %#x): no data path\n", gsi_rd(GSI_STATUS));
+		return false;
+	}
+	/*
+	 * The spool pandora_ipa_poll() lifts packets into before handing them to the cell layer with no
+	 * lock held. One allocation, kept for the data path's lifetime; see the PORTER'S NOTE on struct
+	 * receive_context for why the hand-over is not done inside the rings' walk.
+	 */
+	if (ipa_spool == NULL) {
+		ipa_spool = kalloc_data(IPA_SPOOL_BYTES, Z_WAITOK | Z_ZERO);
+		if (ipa_spool == NULL) {
+			printf("PANDORA IPA: no memory for the receive spool: no data path\n");
+			return false;
+		}
+	}
+	if (!dma_page(&table_dma) || !dma_page(&zero_dma)) {
+		printf("PANDORA IPA: no memory for the tables: no data path\n");
+		return false;
+	}
+	for (unsigned n = 0; n < IPA_CHANNELS; n++) {
+		if (!channel_memory(channels[n])) {
+			printf("PANDORA IPA: no memory for the %s channel: no data path\n", channels[n]->name);
+			return false;
+		}
+	}
+	printf("PANDORA IPA: setting up this processor's data path: GSI status %#x, local memory at %#x; rings and "
+	    "buffers in DDR from %#llx (the tables at %#llx)\n", gsi_rd(GSI_STATUS), ipa_mem_offset,
+	    modem_rx.pages[0].phys, table_dma.phys);
+	gsi_interrupts_off();
+	for (unsigned n = 0; n < IPA_CHANNELS; n++) {
+		struct channel *ch = channels[n];
+
+		if (!channel_setup(ch)) {
+			printf("PANDORA IPA: the %s channel (%u, event ring %u) cannot be set up: no data path\n",
+			    ch->name, ch->id, ch->ring_id);
+			return false;
+		}
+		endpoint_program(ch);
+	}
+	for (unsigned n = 0; n < IPA_CHANNELS; n++) {
+		struct channel *ch = channels[n];
+
+		if (!gsi_command(ch, false, GSI_CH_START, CH_STATE_STARTED)) {
+			printf("PANDORA IPA: the %s channel does not start: no data path\n", ch->name);
+			return false;
+		}
+		ch->started = true;
+		if (!ch->to_ipa) {
+			/*
+			 * One short of the ring: the doorbell is the write pointer and writing it level
+			 * with the read pointer means "empty", not "full".
+			 */
+			for (uint32_t slot = 0; slot + 1 < ch->slots; slot++) {
+				receive_post(ch, slot);
+			}
+			channel_doorbell(ch);
+		}
+	}
+	if (!tables_setup()) {
+		printf("PANDORA IPA: the IPA does not take its tables: no data path (the channels stay)\n");
+		return false;
+	}
+	ipa_up = true;
+	return true;
+}
+
+/* The channels and the endpoints are made quiescent and given up, in the reverse order. */
+static void
+ipa_data_teardown(void)
+{
+	for (unsigned n = 0; n < IPA_CHANNELS; n++) {
+		struct channel *ch = channels[n];
+
+		if (!ch->started) {
+			continue;
+		}
+		(void)gsi_command(ch, false, GSI_CH_STOP, CH_STATE_STOPPED);
+		(void)gsi_command(ch, false, GSI_CH_RESET, CH_STATE_NOT_ALLOCATED);
+		(void)gsi_command(ch, false, GSI_CH_DE_ALLOC, CH_STATE_NOT_ALLOCATED);
+		(void)gsi_command(ch, true, GSI_EVT_RESET, EV_STATE_NOT_ALLOCATED);
+		(void)gsi_command(ch, true, GSI_EVT_DE_ALLOC, EV_STATE_NOT_ALLOCATED);
+		ch->started = false;
+	}
+	/*
+	 * The spool and the channels' memory stay: a bring-up after a shutdown would otherwise have to
+	 * allocate them again, and the pages are already this file's (nothing else frees them either --
+	 * HakiOS leaked them the same way, hakios.ipa.c:790's channel_memory() with no counterpart).
+	 * PORTER'S NOTE: this leak is deliberate and bounded -- 4 channels of rings and buffers plus the
+	 * spool, once, for a data path that comes up once per boot.
+	 */
+	ipa_up = false;
+}
+
+/* =====================================================================================
+ * 10. The IPA's QMI handshake with the modem
+ *
+ * The modem's LTE downlink task dies on a null pointer the moment the modem goes online if this
+ * handshake has not happened (HakiOS saw it on 23 October: enl2_dl, three of three; hakios.mpss.c
+ * :4693-4698). Two directions, on QRTR:
+ *
+ *   the modem's way    it registers for an indication with us (0x20), we answer, and once our
+ *                      IPA driver is up we tell it (indication 0x22); it says its own is up (0x35)
+ *   our way            we ask it to initialise its driver (0x21, INIT_DRIVER) with where the
+ *                      tables are in the IPA's local memory, it answers with a result, and we
+ *                      tell it that all is done (0x22)
+ *
+ * Service 0x31. This processor hosts instance 1 (IPA_HOST_INSTANCE 0x101), the modem is instance 2
+ * (IPA_MODEM_INSTANCE 0x201). The message numbers and the TLV types are the QMI service's and did
+ * not change from 4.11 to 5.5; the values inside INIT_DRIVER are the local memory's layout and all
+ * of those did (spec 8.3).
+ * ===================================================================================== */
+
+#define IPA_QMI_SERVICE                 0x31
+#define IPA_HOST_INSTANCE               0x101   /* version 1, instance 1: ours */
+#define IPA_MODEM_INSTANCE              0x201   /* version 1, instance 2: the modem's */
+
+#define IPA_QMI_INDICATION_REGISTER     0x20
+#define IPA_QMI_INIT_DRIVER             0x21
+#define IPA_QMI_INIT_COMPLETE           0x22
+#define IPA_QMI_INSTALL_FILTER_RULE     0x23
+#define IPA_QMI_FILTER_INSTALLED_NOTIF  0x24
+#define IPA_QMI_CONFIG                  0x27
+#define IPA_QMI_DRIVER_INIT_COMPLETE    0x35
+
+#define QMI_REQUEST                     0
+#define QMI_RESPONSE                    2
+#define QMI_INDICATION                  4
+
+/* The two ports: ours (the service we host) and the one we look the modem's up on. */
+static struct pandora_qrtr_port *ipa_client_port;
+static uint32_t ipa_modem_node, ipa_modem_port;         /* the modem's IPA service; 0: not seen */
+static uint32_t ipa_register_node, ipa_register_port;   /* who asked for the indication */
+static bool ipa_indication_wanted, ipa_indication_sent, ipa_driver_ready, ipa_uc_ready;
+static uint16_t ipa_transaction;
+
+/* One TLV of a QMI message, or NULL. HakiOS's qmi_tlv(), hakios.mpss.c:3740-3756. */
+static const uint8_t *
+ipa_qmi_tlv(const uint8_t *m, size_t length, uint8_t type, uint16_t *size)
+{
+	for (size_t at = 7; at + 3 <= length;) {
+		uint16_t n = (uint16_t)(m[at + 1] | m[at + 2] << 8);
+
+		if (at + 3 + n > length) {
+			return NULL;
+		}
+		if (m[at] == type) {
+			*size = n;
+			return m + at + 3;
+		}
+		at += 3 + n;
+	}
+	return NULL;
+}
+
+/* A TLV holding one 32-bit value, little-endian. HakiOS's qmi_put_u32(), :4718-4728. */
+static unsigned
+ipa_qmi_put_u32(uint8_t *at, uint8_t type, uint32_t value)
+{
+	at[0] = type;
+	at[1] = 4;
+	at[2] = 0;
+	for (unsigned b = 0; b < 4; b++) {
+		at[3 + b] = (uint8_t)(value >> (8 * b));
+	}
+	return 7;
+}
+
+/* A TLV holding two 32-bit values, little-endian. HakiOS's qmi_put_pair(), :4730-4740. */
+static unsigned
+ipa_qmi_put_pair(uint8_t *at, uint8_t type, uint32_t first, uint32_t second)
+{
+	at[0] = type;
+	at[1] = 8;
+	at[2] = 0;
+	for (unsigned b = 0; b < 4; b++) {
+		at[3 + b] = (uint8_t)(first >> (8 * b));
+		at[7 + b] = (uint8_t)(second >> (8 * b));
+	}
+	return 11;
+}
+
+/* A QMI message with only the result TLV: an answer (flags 2, the transaction echoed) or an
+ * indication (flags 4). HakiOS's ipa_qmi_result(), :4743-4750. */
+static void
+ipa_qmi_result(struct pandora_qrtr_port *from, uint32_t node, uint32_t port, uint8_t flags,
+    uint16_t transaction, uint16_t message)
+{
+	uint8_t packet[14] = { flags, (uint8_t)transaction, (uint8_t)(transaction >> 8), (uint8_t)message,
+			       (uint8_t)(message >> 8), 7, 0, 2, 4, 0, 0, 0, 0, 0 };
+
+	if (from != NULL) {
+		(void)pandora_mpss_qrtr_send(from, node, port, packet, sizeof(packet));
+	}
+}
+
+/* Tell the modem that this processor's side of the IPA is completely set up, once both it and we
+ * have said our own drivers are (indication 0x22). HakiOS's ipa_init_complete(), :4752-4760. */
+static void
+ipa_init_complete(void)
+{
+	if (ipa_indication_wanted && !ipa_indication_sent && ipa_driver_ready) {
+		ipa_qmi_result(pandora_ipa_host_port, ipa_register_node, ipa_register_port, QMI_INDICATION, 0,
+		    IPA_QMI_INIT_COMPLETE);
+		ipa_indication_sent = true;
+		printf("PANDORA IPA: the modem is told that the IPA is all set up (indication %#x)\n",
+		    IPA_QMI_INIT_COMPLETE);
+	}
+}
+
+/*
+ * The modem's requests to our IPA service, from the link's thread.
+ *
+ * Every one of them is answered with success. The filter rules (0x23) are carried in TLV 0x15 as a
+ * count and that many 173-byte structures as ipa_qmi_service_v01.c encodes them, with each rule's
+ * id at byte 168 of its structure (byte 163 in cycle 28 made the modem assert on the ids); the
+ * answer echoes the ids and installs nothing, because this side has no filter programming yet.
+ * HakiOS's ipa_host_receive(), hakios.mpss.c:4765-4856.
+ */
+static void
+ipa_host_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *m = data;
+	uint16_t message, transaction;
+
+	if (length < 7 || m[0] != QMI_REQUEST) {
+		return;
+	}
+	transaction = (uint16_t)(m[1] | m[2] << 8);
+	message = (uint16_t)(m[3] | m[4] << 8);
+	switch (message) {
+	case IPA_QMI_INDICATION_REGISTER:
+		ipa_qmi_result(pandora_ipa_host_port, node, port, QMI_RESPONSE, transaction, message);
+		ipa_register_node = node;
+		ipa_register_port = port;
+		ipa_indication_wanted = true;
+		printf("PANDORA IPA: the modem registers for the IPA's indication (node %u port %u)\n", node, port);
+		ipa_init_complete();
+		break;
+	case IPA_QMI_DRIVER_INIT_COMPLETE:
+		ipa_qmi_result(pandora_ipa_host_port, node, port, QMI_RESPONSE, transaction, message);
+		ipa_uc_ready = true;
+		printf("PANDORA IPA: the modem says its IPA driver is up\n");
+		ipa_init_complete();
+		break;
+	case IPA_QMI_INSTALL_FILTER_RULE: {
+		uint16_t size = 0;
+		const uint8_t *list = ipa_qmi_tlv(m, length, 0x15, &size);
+		uint8_t answer[7 + 7 + 3 + 1 + 4 * 64];
+		unsigned at = 7, count = list != NULL && size >= 1 ? list[0] : 0;
+
+		if (list == NULL || size != 1 + count * 173 || count > 64) {
+			ipa_qmi_result(pandora_ipa_host_port, node, port, QMI_RESPONSE, transaction, message);
+			printf("PANDORA IPA: the modem's filter rules (%u, %u bytes) are not of the shape this knows: "
+			    "answered with success alone\n", count, size);
+			break;
+		}
+		answer[0] = QMI_RESPONSE;
+		answer[1] = (uint8_t)transaction;
+		answer[2] = (uint8_t)(transaction >> 8);
+		answer[3] = (uint8_t)message;
+		answer[4] = (uint8_t)(message >> 8);
+		answer[at++] = 2;                       /* the result: success */
+		answer[at++] = 4;
+		answer[at++] = 0;
+		answer[at++] = 0;
+		answer[at++] = 0;
+		answer[at++] = 0;
+		answer[at++] = 0;
+		answer[at++] = 0x11;                    /* the rules' ids */
+		answer[at++] = (uint8_t)(1 + 4 * count);
+		answer[at++] = (uint8_t)((1 + 4 * count) >> 8);
+		answer[at++] = (uint8_t)count;
+		for (unsigned r = 0; r < count; r++) {
+			memcpy(answer + at, list + 1 + r * 173 + 168, 4);
+			at += 4;
+		}
+		answer[5] = (uint8_t)(at - 7);
+		answer[6] = (uint8_t)((at - 7) >> 8);
+		if (pandora_ipa_host_port != NULL) {
+			(void)pandora_mpss_qrtr_send(pandora_ipa_host_port, node, port, answer, at);
+		}
+		printf("PANDORA IPA: the modem's %u filter rules taken (not installed), their ids answered\n", count);
+		break;
+	}
+	case IPA_QMI_CONFIG:
+	case IPA_QMI_FILTER_INSTALLED_NOTIF:
+	default:
+		/*
+		 * After the handshake the modem asks for the IPA's configuration (0x27), has its uplink
+		 * filter rules installed (0x23) and tells that they are (0x24). Android's driver answers
+		 * each with success and little else; so does this.
+		 */
+		ipa_qmi_result(pandora_ipa_host_port, node, port, QMI_RESPONSE, transaction, message);
+		printf("PANDORA IPA: the modem's request %#x (%s) answered with success\n", message,
+		    message == IPA_QMI_CONFIG ? "configuration" :
+		    message == IPA_QMI_INSTALL_FILTER_RULE ? "install filter rules" :
+		    message == IPA_QMI_FILTER_INSTALLED_NOTIF ? "filters installed" : "not known here");
+		break;
+	}
+}
+
+/*
+ * The modem's answer to our INIT_DRIVER, from the link's thread. Every datagram on this port is
+ * printed at first: on 24 October HakiOS's answer was waited for in vain and the question of
+ * whether it came at all could not be answered from the log.
+ */
+static void
+ipa_client_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *m = data;
+	uint16_t size = 0;
+	const uint8_t *value;
+
+	if (ipa_trace) {
+		printf("PANDORA IPA: from node %u port %u, %u bytes:", node, port, (unsigned)length);
+		for (size_t i = 0; i < length && i < 24; i++) {
+			printf(" %02x", m[i]);
+		}
+		printf("%s\n", length > 24 ? " ..." : "");
+	}
+	if (length < 7 || m[0] != QMI_RESPONSE || node != ipa_modem_node || port != ipa_modem_port) {
+		return;
+	}
+	value = ipa_qmi_tlv(m, length, 2, &size);
+	if ((m[3] | m[4] << 8) == IPA_QMI_INIT_DRIVER && value != NULL && size == 4) {
+		uint16_t result = (uint16_t)(value[0] | value[1] << 8), error = (uint16_t)(value[2] | value[3] << 8);
+
+		printf("PANDORA IPA: the modem %s our INIT_DRIVER (result %u, error %u)\n",
+		    result == 0 ? "ACCEPTS" : "REFUSES", result, error);
+		ipa_driver_ready = result == 0;
+		ipa_init_complete();
+	}
+}
+
+/*
+ * The IPA's local memory, told to the modem: INIT_DRIVER (0x21), TLV by TLV.
+ *
+ * This is the second of the three things that decide whether the modem's data path comes up (the
+ * first is IPA_ROUTE, the third the resource groups), and every value in it is a local memory
+ * offset or size that changed from 4.11 to 5.5 (spec 8.3). The base `o` is the local memory's
+ * offset in the shared block, 8 * (SHARED_MEM_SIZE >> 16) -- so as long as that register is read
+ * at 0x5c and not 4.11's 0x54, everything below follows automatically.
+ *
+ * HakiOS's ipa_init_driver(), hakios.mpss.c:4877-4955.
+ */
+static void
+ipa_init_driver(void)
+{
+	uint8_t packet[200];
+	unsigned at = 7;
+	const uint32_t o = ipa_mem_offset;
+	/* The route table's last index the modem may use; modem_ipa_routes=N overrides it. */
+	uint32_t routes = ipa_routes;
+	uint32_t last;
+
+	(void)ipa_arg("routes", &routes, sizeof(routes));
+	/*
+	 * "routes" is a count, so the last index the modem may use is one less. PORTER'S NOTE: the
+	 * boot argument is read here as well as in ipa_boot_args() because this is where it is used,
+	 * and computing `last` from it after the read is the point -- HakiOS computed its
+	 * "routes - 1" from a default of 8 and then let modem_ipa_routes change only the count, which
+	 * would have left the two out of step (hakios.mpss.c:4881-4884).
+	 */
+	last = routes ? routes - 1 : 0;
+
+	ipa_transaction = (uint16_t)(ipa_transaction + 1 == 0 ? 1 : ipa_transaction + 1);
+	packet[0] = QMI_REQUEST;
+	packet[1] = (uint8_t)ipa_transaction;
+	packet[2] = (uint8_t)(ipa_transaction >> 8);
+	packet[3] = IPA_QMI_INIT_DRIVER;
+	packet[4] = 0;
+	/* 0x10: the platform. 3 is MSM Android, which is what Android's driver says ("platform_type 3"). */
+	at += ipa_qmi_put_u32(packet + at, 0x10, 3);
+	/* 0x11: the modem's headers. 5.5: IPA_MEM_MODEM_HEADER at 0x1708, 0x240 (same size as 4.11). */
+	at += ipa_qmi_put_pair(packet + at, 0x11, o + 0x1708, o + 0x1708 + 0x0240 - 1);
+	/* 0x12/0x13: the IPv4 and IPv6 route tables, unhashed. 5.5: 0x1528, 0x1668; 11 of 19 entries
+	 * are the modem's (Linux's modem_route_count), so the last index is 10. */
+	at += ipa_qmi_put_pair(packet + at, 0x12, o + IPA_MEM_V4_ROUTE, last);
+	at += ipa_qmi_put_pair(packet + at, 0x13, o + IPA_MEM_V6_ROUTE, last);
+	/* 0x14/0x15: the filter tables, unhashed. 5.5: 0x1308, 0x1408. */
+	at += ipa_qmi_put_u32(packet + at, 0x14, o + IPA_MEM_V4_FILTER);
+	at += ipa_qmi_put_u32(packet + at, 0x15, o + IPA_MEM_V6_FILTER);
+	/* 0x16: the modem's own region. 5.5: IPA_MEM_MODEM at 0x3898, 0xd48 (4.11 was 0x27d8, 0x800). */
+	at += ipa_qmi_put_pair(packet + at, 0x16, o + 0x3898, 0xd48);
+	/* 0x17: our endpoint for its control messages: the modem receive endpoint, 23 (4.11 said 16). */
+	at += ipa_qmi_put_u32(packet + at, 0x17, modem_rx.endpoint);
+	/*
+	 * 0x18 is "is_ssr_bootup" to Android's driver and "skip_uc_load" to Linux's: whether the modem
+	 * is being restarted with the microcontroller already loaded. Android leaves it out on a first
+	 * boot and the modem then loads the microcontroller itself. Sent as 1 only when asked for.
+	 */
+	if (ipa_option("skip_uc")) {
+		packet[at++] = 0x18;
+		packet[at++] = 1;
+		packet[at++] = 0;
+		packet[at++] = 1;
+	}
+	/* 0x19: the modem's processing contexts. 5.5: 0x1b40, 0xb20 (4.11: 0x0ad0, 0xac0). */
+	at += ipa_qmi_put_pair(packet + at, 0x19, o + IPA_MEM_MODEM_PROC_CTX,
+	    o + IPA_MEM_MODEM_PROC_CTX + 0x0b20 - 1);
+	/* 0x1b/0x1c: the hashed route tables. 5.5: 0x1488, 0x15c8. */
+	at += ipa_qmi_put_pair(packet + at, 0x1b, o + IPA_MEM_V4_ROUTE_HASHED, last);
+	at += ipa_qmi_put_pair(packet + at, 0x1c, o + IPA_MEM_V6_ROUTE_HASHED, last);
+	/* 0x1d/0x1e: the hashed filter tables. 5.5: 0x1288, 0x1388. */
+	at += ipa_qmi_put_u32(packet + at, 0x1d, o + IPA_MEM_V4_FILTER_HASHED);
+	at += ipa_qmi_put_u32(packet + at, 0x1e, o + IPA_MEM_V6_FILTER_HASHED);
+	/*
+	 * 0x1f/0x20: the modem's quota statistics -- the address, then the size as a TLV of its own
+	 * (the modem reads 0x1f as "where" and 0x20 as "how long"). 5.5: 0x2868, 0x60 (4.11 0x1d00,
+	 * 0x30). These are two TLVs and not a pair, which is why they are written separately.
+	 */
+	at += ipa_qmi_put_u32(packet + at, 0x1f, o + 0x2868);
+	at += ipa_qmi_put_u32(packet + at, 0x20, 0x60);
+	/* 0x21/0x22: the drop statistics. 5.5: 0x3870, 0x20 (the size is what 4.11 had too). */
+	at += ipa_qmi_put_u32(packet + at, 0x21, o + 0x3870);
+	at += ipa_qmi_put_u32(packet + at, 0x22, 0x20);
+	packet[5] = (uint8_t)(at - 7);
+	packet[6] = (uint8_t)((at - 7) >> 8);
+	printf("PANDORA IPA: about to ask the modem's IPA driver (node %u port %u) to initialise with the IPA's "
+	    "memory layout (%u bytes, offset %#x, %u routes)\n", ipa_modem_node, ipa_modem_port, at, o, routes);
+	if (ipa_client_port == NULL ||
+	    pandora_mpss_qrtr_send(ipa_client_port, ipa_modem_node, ipa_modem_port, packet, at) != 0) {
+		printf("PANDORA IPA: INIT_DRIVER not sent\n");
+	}
+}
+
+/* The modem's IPA service appeared (or went): ask it to initialise, or forget it. */
+static void
+ipa_client_server(__unused void *context, bool arrived, uint32_t service, __unused uint32_t version,
+    uint32_t instance, uint32_t node, uint32_t port)
+{
+	if (service != IPA_QMI_SERVICE || instance != 2) {
+		return;
+	}
+	if (arrived) {
+		ipa_modem_node = node;
+		ipa_modem_port = port;
+		printf("PANDORA IPA: the modem's IPA service (0x%x instance %u) is at node %u port %u\n",
+		    service, instance, node, port);
+		ipa_init_driver();
+	} else {
+		printf("PANDORA IPA: the modem's IPA service has gone\n");
+		ipa_modem_node = ipa_modem_port = 0;
+		ipa_driver_ready = ipa_indication_sent = ipa_indication_wanted = false;
+	}
+}
+
+/*
+ * The two ports: the one our service 0x31 instance 1 is hosted on (the caller publishes it, and
+ * pandora_rmtfs.c reads pandora_ipa_host_port to do so), and the one the modem's instance 2 is
+ * looked up on.
+ *
+ * PORTER'S NOTE: pandora_ipa_host_port is declared in pandora_modem.h and *defined* in
+ * pandora_qrtr.c ("this file stores it", pandora_qrtr.c:77) -- so it is assigned here and not
+ * declared again, or the two would be two variables and pandora_rmtfs.c would publish port 0.
+ */
+bool
+pandora_ipa_qmi_start(void)
+{
+	if (ipa_option("qmi_off")) {
+		printf("PANDORA IPA: no QMI handshake (pandora_ipa_qmi_off)\n");
+		return false;
+	}
+	if (pandora_ipa_host_port == NULL) {
+		pandora_ipa_host_port = pandora_qrtr_open(ipa_host_receive, NULL, NULL);
+	}
+	if (ipa_client_port == NULL) {
+		ipa_client_port = pandora_qrtr_open(ipa_client_receive, ipa_client_server, NULL);
+		if (ipa_client_port != NULL) {
+			(void)pandora_qrtr_lookup(ipa_client_port, IPA_QMI_SERVICE, 1, 2);
+		}
+	}
+	ipa_driver_ready = ipa_indication_sent = ipa_indication_wanted = ipa_uc_ready = false;
+	if (pandora_ipa_host_port == NULL || ipa_client_port == NULL) {
+		printf("PANDORA IPA: the QRTR ports for the IPA's service could not be opened (host %p, client %p)\n",
+		    (void *)pandora_ipa_host_port, (void *)ipa_client_port);
+		return false;
+	}
+	printf("PANDORA IPA: the QRTR ports are open: our service 0x%x instance 1 on port %u, the modem's "
+	    "instance 2 looked up on port %u\n", IPA_QMI_SERVICE, pandora_qrtr_port_number(pandora_ipa_host_port),
+	    pandora_qrtr_port_number(ipa_client_port));
+	return true;
+}
+
+void
+pandora_ipa_qmi_stop(void)
+{
+	if (pandora_ipa_host_port != NULL) {
+		pandora_qrtr_close(pandora_ipa_host_port);
+		pandora_ipa_host_port = NULL;
+	}
+	if (ipa_client_port != NULL) {
+		pandora_qrtr_close(ipa_client_port);
+		ipa_client_port = NULL;
+	}
+	ipa_modem_node = ipa_modem_port = 0;
+	ipa_register_node = ipa_register_port = 0;
+	ipa_indication_wanted = ipa_indication_sent = ipa_driver_ready = ipa_uc_ready = false;
+}
+
+/* =====================================================================================
+ * 11. The mappings, and the order of the whole thing
+ * ===================================================================================== */
+
+/*
+ * The three windows this file looks through: the IPA's registers, the GSI's, and the local
+ * memory. The local memory is mapped wide on purpose (spec 3.3): 0x10000 from 0x14680000 covers
+ * both 0x14683000 (Android's qcom,additional-mapping for ipa_smmu_ap) and 0x14688000 (Linux's
+ * imem_addr), so whichever the hardware means is inside the window, and the SHARED_MEM_SIZE
+ * register's offset picks the right part of it.
+ */
+static bool
+ipa_maps_make(void)
+{
+	ipa_regs = ipa_map(ipa_regs_pa, IPA_REGS_SIZE);
+	if (ipa_regs == 0) {
+		printf("PANDORA IPA: the IPA's registers at %#llx cannot be mapped\n", ipa_regs_pa);
+		return false;
+	}
+	gsi_regs = ipa_map(gsi_pa, GSI_SIZE);
+	if (gsi_regs == 0) {
+		printf("PANDORA IPA: the GSI's registers at %#llx cannot be mapped\n", gsi_pa);
+		return false;
+	}
+	/* Round the local memory's window down to a 64 KB boundary: the imem may be anywhere in it. */
+	{
+		uint64_t base = ipa_sram_pa & ~0xffffull;
+
+		ipa_sram = ipa_map(base, IPA_SRAM_SIZE);
+		ipa_sram_at = (uint32_t)(ipa_sram_pa - base);
+	}
+	if (ipa_sram == 0) {
+		printf("PANDORA IPA: the local memory at %#llx cannot be mapped: the microcontroller's state "
+		    "cannot be read (the data path does not depend on it)\n", ipa_sram_pa);
+		/* Not fatal: only ipa_report() and ipa_uc_booted() read it. */
+	}
+	if (!ipa_quiet) {
+		printf("PANDORA IPA: IPA registers at %#llx (%#x bytes), GSI at %#llx (%#x bytes), local memory at "
+		    "%#llx (%#x bytes); the window at %#llx\n", ipa_regs_pa, IPA_REGS_SIZE, gsi_pa, GSI_SIZE,
+		    ipa_sram_pa, IPA_SRAM_SIZE, (unsigned long long)ipa_regs);
+	}
+	return true;
+}
+
+/*
+ * Bring the IPA up, in the order the spec gives (9.4, 9.5) and HakiOS uses (hakios.mpss.c:2196):
+ * registers, clock, SMMU, firmware, local memory, hardware, data path, QMI.
+ *
+ * The modem is started by pandora_mpss.c after this returns, and reads the local memory this leaves
+ * behind: that is why the order is not negotiable. If anything fails, the modem still starts --
+ * NAS and SMS do not need the IPA -- and the failure is printed with the step it happened at.
+ *
+ * Two flags and no more (ipa_up and ipa_claimed above): `claimed` is "a bring-up was attempted, do
+ * not attempt another", so a failed attempt is not silently retried behind the step machine's back,
+ * and `up` is "the data path is running". pandora_ipa_shutdown() clears both, so the pair can be
+ * brought up again after a teardown.
+ */
+
+bool
+pandora_ipa_bringup(void)
+{
+	bool space = false;
+
+	if (ipa_up) {
+		return true;
+	}
+	if (ipa_claimed) {
+		/* A previous attempt failed; do not try again behind the step machine's back. */
+		return false;
+	}
+	if (ipa_option("off")) {
+		printf("PANDORA IPA: the IPA is left out entirely (pandora_ipa_off)\n");
+		ipa_claimed = true;
+		return false;
+	}
+	ipa_claimed = true;
+	ipa_boot_args();
+	pandora_announce("giving the IPA its registers, its clock, its SMMU context, its firmware and its "
+	    "local memory");
+
+	if (!ipa_maps_make()) {
+		goto fail;
+	}
+	if (!ipa_clock(true)) {
+		goto fail;
+	}
+	if (!ipa_option("smmu_off")) {
+		if (!ipa_space_on()) {
+			printf("PANDORA IPA: the SMMU context is not up: the IPA would fault on every access "
+			    "(pandora_ipa_smmu_off=1 goes on without it)\n");
+			goto fail_clock;
+		}
+		space = true;
+	} else {
+		printf("PANDORA IPA: no SMMU context (pandora_ipa_smmu_off)\n");
+	}
+	if (!ipa_firmware_load()) {
+		goto fail_space;
+	}
+	if (!ipa_firmware_running()) {
+		printf("PANDORA IPA: the firmware did not start (pandora_ipa_gsi_enable=1 tries to start the GSI "
+		    "by hand): the modem will start without a data path\n");
+		goto fail_space;
+	}
+	ipa_report("after its firmware's start");
+
+	/* The local memory's offset comes from the register, so it has to be read before it is used. */
+	ipa_mem_offset = 8 * (ipa_rd(IPA_SHARED_MEM_SIZE) >> 16);
+	if (ipa_mem_offset == 0) {
+		printf("PANDORA IPA: SHARED_MEM_SIZE (%#x) gives no offset for the local memory: the firmware may "
+		    "not have configured it\n", ipa_rd(IPA_SHARED_MEM_SIZE));
+	}
+	ipa_memory_init();
+	ipa_hardware_init();
+
+	if (!ipa_data_setup()) {
+		goto fail_space;
+	}
+	/*
+	 * The microcontroller's "booted" byte is the functional check that the firmware can answer
+	 * commands, and the one that confirms the local memory's offset was read correctly. It is a
+	 * warning and not a failure: HakiOS saw it stay zero on 4.11 while the data path still worked,
+	 * and the modem's own answer to INIT_DRIVER is the authority either way.
+	 */
+	if (!ipa_uc_booted()) {
+		printf("PANDORA IPA: the microcontroller has not said \"booted\" (%#x): the local memory's offset "
+		    "%#x may be wrong, or the firmware is not answering (the data path is up regardless)\n",
+		    ipa_sram != 0 ? ipa_rd_sram(ipa_mem_offset + 0x0c) : 0, ipa_mem_offset);
+	} else if (!ipa_quiet) {
+		printf("PANDORA IPA: the microcontroller says \"booted\" -- the firmware is up and answering\n");
+	}
+	{
+		char line[256];
+
+		pandora_ipa_status(line, sizeof(line));
+		printf("PANDORA IPA: THE DATA PATH IS UP: endpoints %u (commands), %u (LAN in), %u (to the modem), "
+		    "%u (from the modem); the tables set; %s\n", command.endpoint, lan_rx.endpoint,
+		    modem_tx.endpoint, modem_rx.endpoint, line);
+	}
+	/* The QMI side is asynchronous: it waits for the modem's service to appear. */
+	if (!ipa_option("qmi_off")) {
+		(void)pandora_ipa_qmi_start();
+	}
+	return true;
+
+fail_space:
+	if (space) {
+		ipa_space_off();
+	}
+fail_clock:
+	(void)ipa_clock(false);
+fail:
+	printf("PANDORA IPA: THE IPA IS NOT UP: the modem starts without a data path (pandora_ipa_off=1 skips "
+	    "this entirely; pandora_ipa_trace=1 says more)\n");
+	return false;
+}
+
+/*
+ * Put it all back, in the reverse order (spec 5.10, which improves on HakiOS's
+ * ipa_firmware_stop() by stopping the GSI's channels as well: switching from this kernel back to
+ * Android is routine, and leaving them allocated has the next boot's firmware find them in a
+ * half-finished state).
+ */
+void
+pandora_ipa_shutdown(void)
+{
+	if (!ipa_claimed && !ipa_up) {
+		return;
+	}
+	pandora_ipa_qmi_stop();
+	ipa_stopping = true;
+	if (ipa_up) {
+		pandora_announce("taking the IPA down: its channels, its firmware, its SMMU context and its clock");
+		ipa_data_teardown();
+	}
+	pandora_pas_shutdown(IPA_PAS);
+	ipa_space_off();
+	(void)ipa_clock(false);
+	ipa_up = false;
+	ipa_claimed = false;
+	ipa_stopping = false;
+	printf("PANDORA IPA: the IPA is down\n");
+}
+
+/* =====================================================================================
+ * 12. The top-level entry and its thread
+ *
+ * The step machine calls pandora_ipa_bringup() at the one point in pandora_mpss.c's step_start()
+ * where the IPA has to be ready (after IPCC is enabled, before rmtfs_buffer_make()). This entry is
+ * for a boot that wants the IPA polled from a thread of its own -- the cell layer can equally drive
+ * pandora_ipa_poll() from the link thread, and pandora_cell.c does -- and for bringing the data
+ * path up late, from userland, through a boot argument.
+ * ===================================================================================== */
+
+static thread_t ipa_thread;
+static bool ipa_thread_running;
+static event_t ipa_thread_chan;
+
+static void
+ipa_poll_loop(void *context __unused, wait_result_t result __unused)
+{
+	while (!ipa_stopping) {
+		pandora_ipa_poll();
+		/*
+		 * A millisecond: short enough that the receive endpoints' 500 us aggregation window
+		 * is not left waiting (spec 2.9 says a poll period above about a millisecond starts to
+		 * cost throughput). assert_wait_deadline() and thread_block() are how pandora_adsp.c's
+		 * ad_sleep() sleeps, so this wakes on its own deadline and on nothing else.
+		 */
+		if (ipa_up) {
+			uint64_t deadline;
+
+			clock_interval_to_deadline(1, NSEC_PER_MSEC, &deadline);
+			(void)assert_wait_deadline((event_t)&ipa_thread_chan, THREAD_INTERRUPTIBLE, deadline);
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		} else {
+			pandora_sleep_ms(50);
+		}
+	}
+	ipa_thread_running = false;
+	/*
+	 * thread_terminate() does not necessarily stop the thread where it is called; the block after
+	 * it is what actually leaves the processor, which is the idiom pandora_adsp.c:3210-3211 and
+	 * pandora_amp.c:1105 both use.
+	 */
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_ipa_init(void)
+{
+	if (ipa_option("off")) {
+		printf("PANDORA IPA: not started (pandora_ipa_off)\n");
+		return;
+	}
+	if (ipa_thread_running) {
+		return;
+	}
+	if (!pandora_ipa_bringup()) {
+		return;
+	}
+	/*
+	 * A thread of its own to drain the rings. PORTER'S NOTE: this is not the only way to poll --
+	 * pandora_cell.c drives pandora_ipa_poll() from the link thread, which is HakiOS's arrangement
+	 * and is what a first version should use. This exists so a boot can bring the IPA up and watch
+	 * it without the cell layer, and so a later interrupt-free data path has somewhere to live.
+	 * The thread does nothing while ipa_up is false, so starting it is harmless either way.
+	 */
+	if (kernel_thread_start(ipa_poll_loop, NULL, &ipa_thread) != KERN_SUCCESS) {
+		printf("PANDORA IPA: the polling thread could not be started: the cell layer must poll\n");
+		return;
+	}
+	ipa_thread_running = true;
+	printf("PANDORA IPA: a thread polls its rings every millisecond\n");
+}
diff --git a/bsd/dev/pandora_ipa.h b/bsd/dev/pandora_ipa.h
new file mode 100644
index 0000000..08b96bf
--- /dev/null
+++ b/bsd/dev/pandora_ipa.h
@@ -0,0 +1,90 @@
+/*
+ * PANDORA IPA: the Internet Packet Accelerator (IPA 5.5, GSI 2.x) on canoe -- its firmware, its
+ * registers, its local memory, the GSI channels of this processor's four endpoints, and the QMI
+ * handshake with the modem's own IPA driver.
+ *
+ * This is HakiOS's bsd/dev/hakios.ipa.c and the IPA half of bsd/dev/hakios.mpss.c, ported from
+ * IPA 4.11 (SM7325 "redwood") to IPA 5.5 (SM8850 "canoe", X85). Every number in it comes from
+ * work/baseband-port/ipa-v55-spec.md; the places where the spec was not certain, or where this
+ * port departs from it, are marked PORTER'S NOTE at the code that depends on them.
+ *
+ * Who calls what:
+ *
+ *   pandora_mpss.c   pandora_ipa_bringup()   in step_start(), after IPCC is enabled and before
+ *                                            rmtfs_buffer_make() -- the IPA must be up before
+ *                                            the modem runs (its local memory, canaries and
+ *                                            default route are what the modem reads)
+ *                    pandora_ipa_shutdown()  on the modem's quiesce path
+ *   pandora_cell.c   pandora_ipa_data_ready(), pandora_ipa_poll(),
+ *                    pandora_ipa_transmit(), pandora_ipa_modem_endpoints()
+ *   pandora_rmtfs.c  pandora_ipa_qmi_start()/pandora_ipa_qmi_stop() publish and withdraw the
+ *                    QRTR service 0x31 instance 1 this file answers
+ *   pandora_qrtr.c   pandora_ipa_host_port      the port that service lives on
+ *
+ * The two symbols that keep the kernel from linking are pandora_ipa_qmi_start() and
+ * pandora_ipa_qmi_stop(); everything else has a caller already written against the signatures
+ * below.
+ */
+#ifndef _BSD_DEV_PANDORA_IPA_H_
+#define _BSD_DEV_PANDORA_IPA_H_
+
+#if defined(PANDORA)
+
+#include <sys/types.h>
+
+/* ---- the interface (pandora_modem.h declares the first two for pandora_rmtfs.c) ---------- */
+
+/*
+ * Bring the IPA up: registers, clock, SMMU, firmware (PAS 15), its local memory, its hardware
+ * programming, the GSI channels and endpoints, the filter/route tables, and the QMI handshake.
+ * True once the data path is up. Idempotent. Boot-arg pandora_ipa_off=1 skips all of it.
+ *
+ * Failure is not fatal to the modem: the modem runs without a data path (NAS, SMS), which is how
+ * HakiOS treats it too.
+ */
+bool pandora_ipa_bringup(void);
+
+/*
+ * Put it all back: the QMI ports, the GSI channels, the firmware (PAS_SHUTDOWN), the SMMU
+ * context and the clock. Safe to call when it never came up.
+ */
+void pandora_ipa_shutdown(void);
+
+/* The data path's channels are started and the tables are in: pakora_ipa_transmit() and
+ * pandora_ipa_poll() do something. */
+bool pandora_ipa_data_ready(void);
+
+/*
+ * Drain the event rings and hand every QMAP-framed packet from the modem to the cell layer
+ * (pandora_cell.c's receive). Called from the link thread; not re-entrant with itself.
+ */
+void pandora_ipa_poll(void);
+
+/*
+ * One IP packet (no Ethernet header) to the modem under QMAP mux `mux`. 0 sent, an errno
+ * otherwise (ENXIO when the data path is down, ENOBUFS when the transmit ring is full).
+ */
+int pandora_ipa_transmit(uint32_t mux, const void *frame, size_t length);
+
+/* The two endpoints the cell layer tells the modem about in its DPM/WDA configuration:
+ * to the modem ep 2 (AP_MODEM_TX), from it ep 23 (AP_MODEM_RX). Returns 2. */
+unsigned pandora_ipa_modem_endpoints(uint32_t *to_modem, uint32_t *from_modem);
+
+/* The QRTR service 0x31 instance 1 this processor hosts (pandora_rmtfs.c publishes it). */
+bool pandora_ipa_qmi_start(void);
+void pandora_ipa_qmi_stop(void);
+
+/* The top-level entry: boot-arg gated, spawned on its own thread. Not called by the step
+ * machine -- pandora_ipa_bringup() is. */
+void pandora_ipa_init(void);
+
+/* What the cell layer receives a packet through: mux id, the packet, its length. pandora_cell.c
+ * sets it. NULL until it does, and packets are then counted and dropped. */
+extern void (*pandora_ipa_receive)(uint32_t mux, const uint8_t *packet, size_t length);
+
+/* One line of counters, for the log and for a status call. */
+void pandora_ipa_status(char *to, size_t size);
+
+#endif /* PANDORA */
+
+#endif /* _BSD_DEV_PANDORA_IPA_H_ */
diff --git a/bsd/dev/pandora_modem.h b/bsd/dev/pandora_modem.h
new file mode 100644
index 0000000..b36249c
--- /dev/null
+++ b/bsd/dev/pandora_modem.h
@@ -0,0 +1,124 @@
+/*
+ * PANDORA modem: the pieces bsd/dev/pandora_mpss.c owns and the rest of the modem stack calls.
+ *
+ * The port is split across files that used to be one (HakiOS keeps all of it in hakios.mpss.c):
+ *
+ *   pandora_mpss.c    the step machine, the two PAS stages, SMP2P, GLINK, the QRTR link
+ *   pandora_rmtfs.c   RMTFS, TFTP over QRTR and the service registry (pd-mapper)
+ *   pandora_qrtr.c    the QRTR port table and its control port
+ *   pandora_ipa.c     the IPA's firmware, registers and data path
+ *   pandora_cell.c    en1 over the IPA, and the QMI sessions that keep it up
+ *
+ * So the small helpers that in HakiOS were file statics -- the step counter, option(), say(),
+ * tell(), settle(), the SCM call, the firmware read, the raw partition read -- are declared here,
+ * defined once in pandora_mpss.c, and used from all of them. Everything else stays behind its own
+ * header.
+ *
+ * This file holds no state and no code.
+ */
+#ifndef _BSD_DEV_PANDORA_MODEM_H_
+#define _BSD_DEV_PANDORA_MODEM_H_
+
+#if defined(PANDORA)
+
+#include <sys/types.h>
+
+/* ---- the step machine's context ------------------------------------------------------- */
+
+/* The step being performed, 1..PANDORA_MODEM_STEPS; what the log lines are numbered by. */
+extern uint32_t pandora_step;
+extern uint32_t pandora_modem_steps;
+
+/* Boot-arg "name=1" (HakiOS option(), hakios.mpss.c:211). */
+extern bool pandora_option(const char *name);
+
+/* The three ways to say a thing (hakios.mpss.c:131-180): say() is the plain log, tell() goes to
+ * the loader's log as well, announce() prefixes the step number. All three are printf-shaped. */
+extern int pandora_say(const char *format, ...) __printflike(1, 2);
+extern int pandora_tell(const char *format, ...) __printflike(1, 2);
+extern void pandora_announce(const char *what);
+
+/* Make writes visible before the modem reads them (HakiOS settle(), hakios.mpss.c:1456). */
+extern void pandora_settle(void);
+extern void pandora_sleep_ms(uint32_t ms);
+
+/* ---- TrustZone ------------------------------------------------------------------------ */
+
+/*
+ * An SCM call, one at a time through pandora_adsp.c's scm_smc() -- which is where the SCM_INTERRUPTED
+ * and WAITQ_SLEEP handling lives, and the reason no file here does its own "smc #0".
+ *
+ * "function" is HakiOS's encoding, SCM_CALL(service, command) = service << 8 | command; this lifts
+ * it into the SMCCC one. "arguments" is the packed arginfo word (SCM_ARGS(4) | (SCM_RW << 6) ...).
+ * Returns the call's result (0 for success, negative on a TrustZone refusal); *answer gets a1.
+ */
+extern int32_t pandora_scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first,
+    uint64_t second, uint64_t third, uint64_t fourth, uint64_t *answer);
+
+#define PANDORA_SCM_CALL(service, command)   ((uint64_t)(service) << 8 | (command))
+#define PANDORA_SCM_MP_ASSIGN               PANDORA_SCM_CALL(0xc, 0x16)
+/*
+ * SCM_MP_ASSIGN's arginfo, 0x1117: seven arguments -- buffer, value, buffer, value, buffer, 2 values
+ * -- which is not expressible as SCM_ARGS(n) | SCM_RW << 6, so it is written out as Linux's
+ * qcom_scm_assign_mem() packs it.
+ */
+#define PANDORA_SCM_ASSIGN_ARGUMENTS        0x1117u
+#define PANDORA_VMID_HLOS                   3u
+#define PANDORA_VMID_MSS_MSA                15u
+
+/* ---- firmware, read in place off the phone's own partitions ---------------------------- */
+
+/*
+ * A file of image/ from whichever firmware partition has it, whole, in a buffer the CALLER frees
+ * with kfree_data(data, *size). modemfirmware_<slot> is searched first (the modem's own image),
+ * then modem_<slot> (Android's /vendor/firmware_mnt, which has the IPA's and the ADSP's).
+ *
+ * NULL when it is in neither, *size 0 when the file is empty. Never fails silently: the reason is
+ * printed. (HakiOS root_file(), hakios.mpss.c:1060, which read the XNU root instead because its
+ * firmware did not fit the small image. On this phone neither is staged; see bsd/dev/pandora_fw.c.)
+ */
+extern const uint8_t *pandora_root_file(const char *name, uint64_t *size);
+
+/*
+ * A whole GPT partition by name (HakiOS's loader-side hakios.ufs.c), for the four file systems the
+ * modem keeps on the phone's storage. With NULL buffer, only *size is filled in and nothing is read.
+ */
+extern int pandora_ufs_read_partition(const char *name, uint64_t offset, void *buffer,
+    uint64_t length, uint64_t *size);
+
+/* ---- what the rest of the modem stack exports back ------------------------------------ */
+
+/* bsd/dev/pandora_qrtr.c */
+struct pandora_qrtr_port;
+
+/* bsd/dev/pandora_ipa.c: the handshake rmtfs_start() publishes RMTFS once it has answered. */
+extern bool pandora_ipa_qmi_start(void);
+extern void pandora_ipa_qmi_stop(void);
+extern struct pandora_qrtr_port *pandora_ipa_host_port;
+
+/*
+ * bsd/dev/pandora_rmtfs.c: the four file systems the modem keeps on the phone's storage, the
+ * buffer TrustZone hands it for those files, and the three services it answers on QRTR. HakiOS's
+ * hakios.mpss.c calls them at :1175 (load, in step 2), :2448 (buffer and share, in step 7),
+ * :3987 (start, in step 9) and :4025 (stop, at shutdown).
+ */
+extern unsigned pandora_rmtfs_load(void);          /* step 2: read modemst1/modemst2/fsc/fsg */
+extern void pandora_servreg_load(void);            /* step 2: the servreg registry from *.jsn */
+extern bool pandora_rmtfs_buffer_make(void);       /* step 7: the buffer, from boot-arg modem_buffer */
+extern bool pandora_rmtfs_share(bool in);          /* step 7: SCM_MP_ASSIGN it to the modem, or take it back */
+extern bool pandora_rmtfs_start(void);             /* step 9: the RMTFS/TFTP/servreg ports */
+extern void pandora_rmtfs_stop(void);              /* shutdown: the ports, and the services with them */
+
+/*
+ * The services our node publishes on QRTR's control port (HakiOS's our_servers[4], hakios.mpss.c:3106).
+ * pandora_rmtfs_start() fills it in and pandora_rmtfs_stop() clears it; the control-port handler in
+ * pandora_qrtr.c reads it back to answer a lookup.
+ */
+struct pandora_our_server {
+	uint32_t service, instance, port;
+};
+extern struct pandora_our_server pandora_our_servers[4];
+
+#endif /* PANDORA */
+
+#endif /* _BSD_DEV_PANDORA_MODEM_H_ */
diff --git a/bsd/dev/pandora_mpss.c b/bsd/dev/pandora_mpss.c
new file mode 100644
index 0000000..f39036d8
--- /dev/null
+++ b/bsd/dev/pandora_mpss.c
@@ -0,0 +1,1316 @@
+/*
+ * PANDORA modem (MPSS) bring-up for the X85 on SM8850 (canoe).
+ *
+ * Boot-arg pandora_mpss=1 brings the modem up on a thread beside the system's start and leaves it
+ * up; pandora_mpss_step=N runs steps 1..N and stops, which is how each stage is proven on its own
+ * before the next is attempted.
+ *
+ * The sequence, as drivers/remoteproc/qcom_q6v5_pas.c and drivers/soc/qcom/qcom_aoss.c do it, and
+ * as the working ADSP bring-up (bsd/dev/pandora_adsp.c) already does it on this same phone:
+ *
+ *   1 survey    the shared-memory table: our partition with the modem, its items, whether it ran
+ *   2 firmware  image/modem.mdt and image/modem_dtb.mdt out of modemfirmware_<slot>, checked
+ *               against the carveout before anything is asked of TrustZone
+ *   3 mailbox   the AOP's mailbox, unless an earlier kernel left it open
+ *   4 dtb       modem_dtb.mdt (pas 38) into q6_mpss_dtb_region, authenticated and reset
+ *   5 header    modem.mdt's metadata (pas 4), and where its image will be
+ *   6 image     modem.mdt's segments into mpss_region, written and read back
+ *   7 item      our SMP2P item 428 with "master-kernel", the GLINK marks, the doorbells
+ *   8 start     the rails up, the AOP told "modem: on", PAS_AUTH_AND_RESET, then its first words
+ *   9 queues    the modem's GLINK FIFOs, decoded
+ *  10 link      our side of GLINK (version, IPCRTR both ways, our intents), then a thread listens
+ *  11 qrtr      QRTR: hello both ways, and the services the modem says it has
+ *
+ * The modem is the same shape as the ADSP and the SOCCP links this kernel already runs, only its
+ * numbers differ: pid 1, SMP2P item 428 out and 435 in, IPCC client 2 with signal 0 for GLINK and 2
+ * for SMP2P. Two things are its own: it needs TWO images loaded in order (the DTB one first), and
+ * its firmware is 67 MiB and comes off the phone's own modemfirmware partition rather than out of
+ * the firmware pack, which is why bsd/dev/pandora_fw.c reads it in place.
+ *
+ * What this file does NOT do: put a baseband node in the ADT. CommCenter takes a "has baseband"
+ * path when one is there and faults in ApplePDPHelperInterface on a null mutex, every few seconds;
+ * the data path is the fake ethernet interface of bsd/dev/pandora_cell.c instead.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include "qcom/QcomSmem.h"
+#include "qcom/QcomSmp2p.h"
+#include "qcom/QcomGlink.h"
+#include "pandora_fw.h"
+#include "pandora_part.h"
+#include "pandora_pas.h"
+#include "pandora_modem.h"
+#include "pandora_qrtr.h"
+
+extern kern_return_t thread_terminate(thread_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern int pandora_rpmh_arc(const char *name, uint32_t level);
+extern void pandora_scm_call5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t x5, uint64_t *a0, uint64_t *a1);
+
+/* ---- the phone's own numbers (devicetree: work/device-recon/01-reserved-memory-decoded.txt) ---- */
+
+#define MP_PID            1u
+#define MP_ITEM_OUT       428u           /* ours: "master-kernel" (smp2p-modem qcom,smem = <435 428>) */
+#define MP_ITEM_IN        435u           /* the modem's: "slave-kernel", bit 0 fatal 1 ready 2 handover */
+#define MP_ITEM_GL_DESC   478u
+#define MP_ITEM_GL_TX     479u
+#define MP_ITEM_GL_RX     480u
+#define MP_GL_FIFO        0x4000u
+/*
+ * The channel that carries QRTR (dt qcom,modem_qrtr: qcom,glink-channels = "IPCRTR", and
+ * qcom,intents = <0x800 5 0x2000 3 0x4400 2> -- three sizes, five/three/two of each, the same
+ * numbers HakiOS uses for its single channel at hakios.mpss.c:2596). Our number for it is 1, which
+ * is what the DSP's OPEN names.
+ */
+#define MP_GL_CHANNEL     "IPCRTR"
+#define MP_GL_OURS         1u
+#define MP_GL_INTENT_MAX   64
+
+#define MP_MEM_PA         0x8aa00000ull  /* mpss_region@8aa00000: 0x0e100000 (225 MiB), end 0x98b00000 */
+#define MP_MEM_SIZE       0x0e100000ull
+#define MP_DTB_PA         0x99500000ull  /* q6_mpss_dtb_region@99500000: 0x80000 */
+#define MP_DTB_SIZE       0x80000ull
+#define MP_PAS            4u             /* canoe_mpss_resource, decoded from qcom_q6v5_pas.ko */
+#define MP_PAS_DTB        0x26u          /* 38 */
+#define MP_IPA_FW_PA      0x99580000ull  /* ipa_fw_region@99580000: 0x10000 */
+#define MP_IPA_FW_SIZE    0x10000ull
+#define MP_IPA_GSI_PA     0x99590000ull  /* ipa_gsi_region@99590000: 0xa000 -- what the IPA driver picks */
+#define MP_IPA_GSI_SIZE   0xa000ull
+#define MP_PAS_IPA        15u
+
+#define MP_QMP_PA         0x0c300000u    /* power-controller@c300000 (qcom,aoss-qmp) */
+#define MP_QMP_SIZE       0x400u
+#define MP_IPCC_PA        0x01106000u    /* qcom,ipcc@1106000 */
+#define MP_IPCC_SIZE      0x1000u
+#define MP_SMEM_PA        0x81d00000u    /* smem_region@81d00000 */
+#define MP_SMEM_SIZE      0x00200000u
+#define MP_MUTEX_PA       0x01f43000u    /* the TCSR hardware mutex SMEM allocation takes */
+#define MP_MUTEX_SIZE     0x1000u
+
+#define MP_CLIENT         2u
+#define MP_SIG_GLINK      0u
+#define MP_SIG_SMP2P      2u
+
+#define MP_SLAVE_FATAL    1u
+#define MP_SLAVE_READY    2u
+#define MP_SLAVE_HANDOVER 4u
+
+/* IPCC registers (drivers/mailbox/qcom-ipcc.c) */
+#define IPCC_SEND         0x0cu
+#define IPCC_RECV_ID      0x10u
+#define IPCC_RECV_ENABLE  0x14u
+#define IPCC_RECV_CLEAR   0x1cu
+#define IPCC_NONE         0xffffffffu
+
+/* AOP QMP message memory (drivers/soc/qcom/qcom_aoss.c) */
+#define QMP_MAGIC         0x00u
+#define QMP_MAGIC_MAIL    0x4d41494cu     /* "MAIL" */
+#define QMP_THEIR_LINK    0x0cu
+#define QMP_OUR_LINK      0x24u
+#define QMP_OUR_BOX_SIZE  0x34u
+#define QMP_OUR_BOX       0x38u
+#define QMP_UP            0x0000ffffu
+#define QMP_DOWN          0xffff0000u
+#define QMP_MESSAGE       64u
+
+#define MP_FW_PART        "modemfirmware"  /* the modem's own image; NOT Android's firmware_mnt */
+#define MP_STEPS          11
+
+static vm_offset_t mp_qmp, mp_ipcc, mp_smem_va, mp_mutex;
+static QcomSmem mp_smem;
+static QcomSmp2p mp_p2p;
+static QcomSmemPartition mp_part;
+static QcomGlink mp_gl;
+/*
+ * The channel above, and the buffers its intents point into. Three groups, as the DT's qcom,intents
+ * says: 5 x 0x800, 3 x 0x2000, 2 x 0x4400. QcomGlink takes one size and one count, so what it
+ * advertises is the largest group's count at the largest size -- 5 x 0x4400, 34 KiB, which is more
+ * than the modem needs and is what one channel object can say. The DSP's own three groups are all
+ * served by that one advertisement: it sends us frames of any of the three sizes and GLINK's
+ * rx_done carries the length.
+ */
+static uint8_t *mp_gl_storage;                 /* 5 * 0x4400, the intents the DSP may send into */
+#define MP_GL_INTENT_SIZE  0x4400u
+#define MP_GL_INTENT_COUNT 5u
+static bool mp_link_running, mp_link_stop;
+static bool mp_mapped, mp_qmp_open, mp_p2p_on, mp_gl_on;
+
+/*
+ * The router's channel, and the three calls the QRTR block (bsd/dev/pandora_qrtr.c) makes back
