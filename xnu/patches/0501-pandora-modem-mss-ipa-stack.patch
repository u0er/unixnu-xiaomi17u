+/*
+ * For bsd/dev/pandora_pas.c: the three-argument form, which PAS_MEM_SETUP needs (pas, base,
+ * span).  Routes through scm_smc() like every other call in this kernel, so the
+ * SCM_INTERRUPTED retry and the WAITQ_SLEEP resume stay in one place.
+ */
+void pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t *a0);
+
+void
+pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t *a0)
+{
+	struct scm_res r;
+
+	scm_smc(fn, arginfo, x2, x3, x4, 0, &r);
+	*a0 = r.a0;
+}
+
+/*
+ * For bsd/dev/pandora_mpss.c and bsd/dev/pandora_rmtfs.c: the full form, five arguments and both
+ * result words.  SCM_MP_ASSIGN needs all five (the buffer, its owners, the permissions, their
+ * count) and its answer is read from a1, so the two-argument form above is not enough.
+ */
+void pandora_scm_call5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t x5, uint64_t *a0, uint64_t *a1);
+
+void
+pandora_scm_call5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t x5,
+    uint64_t *a0, uint64_t *a1)
+{
+	struct scm_res r;
+
+	scm_smc(fn, arginfo, x2, x3, x4, x5, &r);
+	*a0 = r.a0;
+	*a1 = r.a1;
+}
