+/* ---- state ---------------------------------------------------------------------------------- */
+
+static LCK_GRP_DECLARE(cell_lock_group, "pandora-cell");
+static LCK_MTX_DECLARE(cell_lock, &cell_lock_group);
+
+static ifnet_t cell_interface;                  /* en1, retained until reboot */
+static thread_t cell_thread;
+static bool cell_attached;
+static bool cell_started;
+static bool cell_trace;
+
+/*
+ * The data session as DHCP and ARP see it (spec 1.2). Copied whole under the lock by the output
+ * path rather than read field by field, so that a DHCP answer cannot mix two sessions' settings.
+ */
+struct cell_session {
+	bool            up;
+	uint32_t        address;                /* host order, from WDS (spec 3.2) */
+	uint32_t        mask;                   /* the /24 this layer imposes, not the modem's */
+	uint32_t        router;                 /* the made-up peer in that /24 */
+	uint32_t        dns1, dns2;
+	uint32_t        mtu;
+	uint32_t        modem_mask, modem_gateway;      /* what the modem said, for the log */
+};
+static struct cell_session session;
+
+static struct cell_counts {
+	uint64_t        arp, dhcp, to_modem, from_modem, dropped_out, dropped_in, not_ip4, other_mux;
+} cell_count;
+
+/* BOOT ARGUMENTS (spec 10.6): read once, in pandora_cell_start(). */
+static bool cell_data_off;                      /* pandora_cell_data_off: NAS and the SIM only */
+static bool cell_dpm_off;                       /* pandora_cell_dpm_off */
+static bool cell_wda_off;                       /* pandora_cell_wda_off */
+static bool cell_nobind;                        /* pandora_cell_nobind */
+static bool cell_sim_switch_off;                /* pandora_cell_sim_switch_off */
+static uint8_t cell_apn[64];                    /* pandora_cell_apn */
+static size_t cell_apn_length;
+
