+/*
+ * ---- what the rest of the modem stack calls (bsd/dev/pandora_modem.h) ------------------
+ *
+ * HakiOS keeps the whole modem in one file, so its say()/tell()/settle()/option() were statics.
+ * Here the stack is four files -- this one, pandora_rmtfs.c, pandora_qrtr.c, pandora_ipa.c --
+ * so they are exported, with their HakiOS names and their HakiOS behaviour.
+ */
+
+uint32_t pandora_step;
+uint32_t pandora_modem_steps = MP_STEPS;
