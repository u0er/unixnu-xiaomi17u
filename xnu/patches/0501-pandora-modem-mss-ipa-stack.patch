+
+/*
+ * The SCM call in HakiOS's encoding (SCM_CALL(service, command) = service << 8 | command) lifted
+ * into the SMCCC one that pandora_adsp.c's scm_smc() takes. Going through scm_smc() rather than a
+ * private "smc #0" is the point: that is where SCM_INTERRUPTED is retried and where a
+ * SCM_WAITQ_SLEEP is resumed through GET_WQ_CTX, without which every later TrustZone call of the
+ * kernel comes back 2 (see the comment above scm_smc in bsd/dev/pandora_adsp.c).
+ */
+int32_t
+pandora_scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first,
+    uint64_t second, uint64_t third, uint64_t fourth, uint64_t *answer)
+{
+	uint64_t a0 = 0, a1 = 0;
+	/* SCM_CALL's 16-bit layout -> SCM_FN's: svc = function >> 8, cmd = function & 0xff. */
+	uint64_t fn = (1ull << 30) | (2ull << 24) |
+	    (((function >> 8) & 0xffull) << 8) | (function & 0xffull);
+
+	pandora_scm_call5(fn, arguments, first, second, third, fourth, &a0, &a1);
+	if (answer) {
+		*answer = a1;
+	}
+	if (what) {
+		printf("PANDORA MPSS: %u: SCM %s: fn %#llx args %#llx -> %#llx answer %#llx\n", pandora_step,
+		    what, fn, arguments, a0, a1);
+	}
+	return (int32_t)(a0 & 0xffffffffull);
+}
+
+/*
+ * A file of image/ from whichever partition has it (HakiOS root_file(), with the third source the
+ * old docs wanted instead of staging 85 MB into the root file system: pandora_fw.c reads the
+ * phone's own FAT partitions in place).
+ */
+const uint8_t *
+pandora_root_file(const char *name, uint64_t *size)
+{
+	static const char *const prefixes[] = {MP_FW_PART, "modem"};
+	static uint8_t *buffer;
+	static uint64_t buffer_size;
+	struct pandora_fw *file = NULL;
+	uint64_t bytes = 0;
+	int rc = ENOENT;
+
+	buffer_size = 0;
+	for (unsigned i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]) && rc; i++) {
+		rc = pandora_fw_open(prefixes[i], name, &file, &bytes);
+	}
+	if (rc) {
+		if (size) {
+			*size = 0;
+		}
+		return NULL;
+	}
+	if (bytes == 0) {
+		pandora_fw_close(file);
+		if (size) {
+			*size = 0;
+		}
+		return NULL;
+	}
+	if (bytes > 0x4000000ull) {          /* 64 MiB: a firmware file larger than this is a mistake */
+		printf("PANDORA MPSS: %u: %s is %llu bytes: refused\n", pandora_step, name, bytes);
+		pandora_fw_close(file);
+		if (size) {
+			*size = 0;
+		}
+		return NULL;
+	}
+	if (buffer == NULL || bytes > buffer_size) {
+		if (buffer) {
+			kfree_data(buffer, buffer_size);
+			buffer = NULL;
+			buffer_size = 0;
+		}
+		buffer = kalloc_data((vm_size_t)bytes, Z_WAITOK | Z_ZERO);
+		if (buffer == NULL) {
+			printf("PANDORA MPSS: %u: no memory for %s (%llu bytes)\n", pandora_step, name, bytes);
+			pandora_fw_close(file);
+			if (size) {
+				*size = 0;
+			}
+			return NULL;
+		}
+		buffer_size = bytes;
+	}
+	rc = pandora_fw_file_read(file, 0, buffer, bytes);
+	pandora_fw_close(file);
+	if (rc) {
+		printf("PANDORA MPSS: %u: %s: read error %d\n", pandora_step, name, rc);
+		if (size) {
+			*size = 0;
+		}
+		return NULL;
+	}
+	if (size) {
+		*size = bytes;
+	}
+	return buffer;
+}
+
+/*
+ * A whole GPT partition by name. HakiOS reads these through its own loader (hakios.ufs.c); this
+ * kernel already has the read (bsd/dev/sweet_ufs.c, patch 0229), and bsd/dev/pandora_fw.c wraps it.
+ * With a NULL buffer only the size is filled in.
+ */
+int
+pandora_ufs_read_partition(const char *name, uint64_t offset, void *buffer, uint64_t length,
+    uint64_t *size)
+{
+	struct pandora_part *part = NULL;
+	int rc = pandora_part_open(name, &part);
+	if (rc) {
+		return rc;
+	}
+	if (size) {
+		*size = pandora_part_size(part);
+	}
+	if (buffer != NULL && length != 0) {
+		rc = pandora_part_read(part, offset, buffer, length);
+	}
+	pandora_part_close(part);
+	return rc;
+}
