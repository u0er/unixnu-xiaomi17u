+/* ---- the interface's numbers (spec 1.1, 1.2, 1.7) -------------------------------------------- */
+
+#define CELL_UNIT               1       /* en1: the modem's packets (HakiOS CELL_UNIT, hakios.cell.c:29) */
+#define CELL_MUX                1       /* the QMAP mux id the session is bound to (WDS Bind Mux Data Port) */
+#define CELL_ETHER_HEADER       14      /* an Ethernet header, no VLAN, no 802.3 length field */
+#define CELL_FRAME_MAX          1514    /* HakiOS HAKIOS_NET_FRAME_MAX, hakios.net.h:27 */
+#define CELL_MTU                1500    /* what en1 is told; the modem's MTU only reaches DHCP */
+#define CELL_TICK_MS            100     /* the state machine's tick */
+/*
+ * The largest frame this layer builds itself: an ARP reply (42 bytes) or a DHCP reply, which is
+ * Ethernet + IPv4 + UDP + the padded BOOTP body (spec 2.1: 300 bytes of it at least). 512 is
+ * comfortably more than both, and keeps cell_output()'s two buffers from crowding the kernel stack.
+ */
+#define CELL_REPLY_MAX          512
+
+/*
+ * Locally administered: "pand" and the unit, not HakiOS's 02:68:61:6b:69:01 ("haki"), so that a
+ * log or a packet capture of the two ports cannot be confused (spec 10.2's MAC section, and risk
+ * 16). The router's is the same prefix with 0xfe in the last byte, which is HakiOS's arrangement
+ * (hakios.cell.c:32-33) and keeps the two addresses visibly a pair.
+ */
+static const uint8_t cell_mac[6] = { 0x02, 0x70, 0x61, 0x6e, 0x64, 0x01 };
+static const uint8_t router_mac[6] = { 0x02, 0x70, 0x61, 0x6e, 0x64, 0xfe };
+
+/* ---- the QMI wire (spec 3.2, 4.2, 5.1, 7.1, 8) ----------------------------------------------- */
+
+#define QMI_WDS                         0x01
+#define WDS_START_NETWORK_INTERFACE     0x0020
+#define WDS_GET_CURRENT_SETTINGS        0x002d
+#define WDS_BIND_MUX_DATA_PORT          0x00a2
+#define WDS_SET_IP_FAMILY               0x004d
+
+#define QMI_DMS                         0x02
+#define DMS_SET_OPERATING_MODE          0x002e
+#define DMS_GET_OPERATING_MODE          0x002d
+#define DMS_ONLINE                      0
+#define DMS_LOW_POWER                   1
+
+#define QMI_NAS                         0x03
+#define NAS_SERVING_SYSTEM              0x0024
+#define NAS_GET_SIGNAL_INFO             0x004f
+#define NAS_SIGNAL_INFO                 0x0051
+#define NAS_INITIATE_NETWORK_REGISTER   0x0022
+#define NAS_GET_SYSTEM_SELECTION_PREFERENCE 0x0034
+#define NAS_GET_SYSTEM_INFO             0x004d
+
+#define QMI_UIM                         0x0b
+#define UIM_GET_CARD_STATUS             0x002f
+#define UIM_SWITCH_SLOT                 0x0046
+#define UIM_CHANGE_PROVISIONING_SESSION 0x0038
+
+#define QMI_WDA                         0x1a
+#define WDA_SET_DATA_FORMAT             0x0020
+
+#define QMI_DPM                         0x2f
+#define DPM_OPEN_PORT                   0x0020
+
+#define DATA_ENDPOINT_EMBEDDED          4       /* spec 5.1: the port type the modem maps */
+#define DATA_ENDPOINT_INTERFACE         1       /* ... and the interface number inside it */
+
+/* The QMI result's "the device is not ready yet": DMS's cold-boot refusal to go straight online. */
+#define QMI_ERR_DEVICE_NOT_READY        52
