+
+/* ---- step 1: the shared-memory table ------------------------------------------------ */
+
+static volatile uint8_t *
+mp_smem_item(uint16_t item, uint32_t *size)
+{
+	uint32_t at = 0, bytes = 0;
+	if (qcom_smem_find(&mp_smem, &mp_part, item, &at, &bytes)) {
+		return NULL;
+	}
+	if (size) {
+		*size = bytes;
+	}
+	return (volatile uint8_t *)mp_smem_va + at;
+}
+
+static void
+mp_smem_survey(const char *when)
+{
+	uint16_t items[5] = {MP_ITEM_OUT, MP_ITEM_IN, MP_ITEM_GL_DESC, MP_ITEM_GL_TX, MP_ITEM_GL_RX};
+	char have[96];
+	have[0] = 0;
+	for (unsigned i = 0; i < 5; i++) {
+		uint32_t size = 0;
+		if (mp_smem_item(items[i], &size)) {
+			char one[16];
+			snprintf(one, sizeof(one), " %u:%u", items[i], size);
+			strlcat(have, one, sizeof(have));
+		}
+	}
+	printf("PANDORA MPSS: SMEM %s: partition at %#x size %#x hosts %u/%u, cacheline %u; items there:%s\n", when,
+	    mp_part.offset, mp_part.size, mp_part.host0, mp_part.host1, mp_part.cacheline, have[0] ? have : " none");
+}
+
+static bool
+step_survey(void)
+{
+	int rc = qcom_smem_partition(&mp_smem, QCOM_SMEM_HOST_APPS, MP_PID, &mp_part);
+	if (rc) {
+		printf("PANDORA MPSS: no SMEM partition apps-mpss (host %u to %u): %d\n", QCOM_SMEM_HOST_APPS, MP_PID, rc);
+		return false;
+	}
+	mp_smem_survey("before the image");
+	volatile uint8_t *in = mp_smem_item(MP_ITEM_IN, NULL);
+	if (in) {
+		QcomSmp2p view;
+		bzero(&view, sizeof(view));
+		view.in = (volatile uint32_t *)in;
+		int index = qcom_smp2p_check_in(view.in, 0, MP_PID) ? -1 : qcom_smp2p_find_in(&view, "slave-kernel");
+		printf("PANDORA MPSS: SMP2P from an earlier start: slave-kernel %#x\n",
+		    index >= 0 ? qcom_smp2p_in_value(&view, index) : 0xffffffffu);
+	}
+	printf("PANDORA MPSS: carveout %#llx+%#llx (ends %#llx), DTB region %#llx+%#llx, IPCC %#x client %u, SMEM %#lx\n",
+	    MP_MEM_PA, MP_MEM_SIZE, MP_MEM_PA + MP_MEM_SIZE, MP_DTB_PA, MP_DTB_SIZE, MP_IPCC_PA, MP_CLIENT,
+	    (unsigned long)MP_SMEM_PA);
+	return true;
+}
+
+/* ---- step 2: the firmware, found and checked before TrustZone is asked anything -------- */
+
+/* Reads image/<name> whole. The caller frees. */
+static uint8_t *
+mp_fw_read(const char *name, uint64_t *size_out)
+{
+	struct pandora_fw *f = NULL;
+	uint64_t size = 0;
+	int err = pandora_fw_open(MP_FW_PART, name, &f, &size);
+	if (err) {
+		printf("PANDORA MPSS: %s/image/%s not readable: %d\n", MP_FW_PART, name, err);
+		return NULL;
+	}
+	uint8_t *buf = kalloc_data((vm_size_t)size, Z_WAITOK);
+	if (!buf) {
+		pandora_fw_close(f);
+		return NULL;
+	}
+	err = pandora_fw_file_read(f, 0, buf, size);
+	pandora_fw_close(f);
+	if (err) {
+		printf("PANDORA MPSS: %s/image/%s read failed: %d\n", MP_FW_PART, name, err);
+		kfree_data(buf, (vm_size_t)size);
+		return NULL;
+	}
+	if (size_out) {
+		*size_out = size;
+	}
+	return buf;
+}
+
+struct mp_elf {
+	uint32_t phoff, phnum, hash, hashes;
+	uint64_t min, max;
+	bool reloc;
+};
+
+/* Checks base.mdt the way both the bootloader and this kernel's PAS loader will see it. */
+static bool
+mp_mdt_check(const char *base, uint64_t carveout_pa, uint64_t carveout_size, struct mp_elf *out)
+{
+	char name[PAS_FW_NAME];
+	snprintf(name, sizeof(name), "%s.mdt", base);
+	uint64_t size = 0;
+	uint8_t *buf = mp_fw_read(name, &size);
+	if (!buf) {
+		return false;
+	}
+	if (size < 52 || size > 0x10000) {
+		printf("PANDORA MPSS: %s is %llu bytes, not a sane MDT header\n", name, size);
+		kfree_data(buf, (vm_size_t)size);
+		return false;
+	}
+	struct elf32_phdr {
+		uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+	};
+	memcpy(&out->phoff, buf + 28, 4);
+	out->phnum = (uint32_t)(buf[44] | (buf[45] << 8));
+	if (memcmp(buf, "\177ELF", 4) || buf[4] != 1 || out->phnum < 2 || out->phnum > 64 ||
+	    (uint64_t)out->phoff + (uint64_t)out->phnum * sizeof(struct elf32_phdr) > size) {
+		printf("PANDORA MPSS: %s is not a 32-bit ELF (phnum %u)\n", name, out->phnum);
+		kfree_data(buf, (vm_size_t)size);
+		return false;
+	}
+	const struct elf32_phdr *ph = (const struct elf32_phdr *)(buf + out->phoff);
+	out->hash = 0;
+	out->hashes = 0;
+	out->min = ~0ull;
+	out->max = 0;
+	out->reloc = false;
+	unsigned segments = 0;
+	uint64_t bytes = 0;
+	for (unsigned i = 0; i < out->phnum; i++) {
+		if (!out->hash && i && ((ph[i].flags >> 24) & 7) == 2) {
+			out->hash = i;
+			out->hashes = ph[i].filesz;
+			continue;
+		}
+		if (ph[i].type != 1 || ph[i].memsz == 0) {
+			continue;
+		}
+		out->reloc = out->reloc || (ph[i].flags & (1u << 27)) != 0;
+		out->min = MIN(out->min, (uint64_t)ph[i].paddr);
+		out->max = MAX(out->max, ((uint64_t)ph[i].paddr + ph[i].memsz + 0xfff) & ~0xfffull);
+		segments++;
+		bytes += ph[i].filesz;
+	}
+	bool ok = true;
+	if (!out->hash || ph[0].type == 1) {
+		printf("PANDORA MPSS: %s: no hash segment (ph[0] type %u)\n", name, ph[0].type);
+		ok = false;
+	} else if (out->max > carveout_pa + carveout_size || out->min < carveout_pa) {
+		printf("PANDORA MPSS: %s loads %#llx-%#llx, outside its carveout %#llx+%#llx\n", name, out->min,
+		    out->max, carveout_pa, carveout_size);
+		ok = false;
+	} else if (52 + 32ull * out->phnum + out->hashes != size) {
+		/* the header plus the program headers plus the hash segment is the whole file */
+		printf("PANDORA MPSS: %s is %llu bytes; header+phdrs+hash says %llu\n", name, size,
+		    52 + 32ull * out->phnum + out->hashes);
+		ok = false;
+	}
+	printf("PANDORA MPSS: %s: %llu bytes, %u segments (%llu bytes of them), hash %u (%u bytes), loads %#llx-%#llx "
+	    "in %#llx+%#llx%s%s\n", name, size, segments, bytes, out->hash, out->hashes, out->min, out->max, carveout_pa,
+	    carveout_size, out->reloc ? ", relocatable" : "", ok ? "" : " -- NOT USABLE");
+	kfree_data(buf, (vm_size_t)size);
+	return ok;
+}
+
+/* Whether every segment file the header names is there and the size it claims. */
+static bool
+mp_mdt_segments_present(const char *base, const struct mp_elf *e)
+{
+	char name[PAS_FW_NAME];
+	snprintf(name, sizeof(name), "%s.mdt", base);
+	uint64_t size = 0;
+	uint8_t *buf = mp_fw_read(name, &size);
+	if (!buf) {
+		return false;
+	}
+	struct elf32_phdr {
+		uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+	};
+	const struct elf32_phdr *ph = (const struct elf32_phdr *)(buf + e->phoff);
+	unsigned missing = 0, wrong = 0, checked = 0;
+	for (unsigned i = 0; i < e->phnum; i++) {
+		if (ph[i].type != 1 || ph[i].memsz == 0 || ((ph[i].flags >> 24) & 7) == 2 || ph[i].filesz == 0) {
+			continue;
+		}
+		char segname[PAS_FW_NAME];
+		snprintf(segname, sizeof(segname), "%s.b%02u", base, i);
+		struct pandora_fw *f = NULL;
+		uint64_t got = 0;
+		checked++;
+		if (pandora_fw_open(MP_FW_PART, segname, &f, &got)) {
+			/* an image whose segments are inside the .mdt is fine too */
+			if ((uint64_t)ph[i].offset + ph[i].filesz > size) {
+				printf("PANDORA MPSS: %s missing and not inside %s\n", segname, name);
+				missing++;
+			}
+			continue;
+		}
+		pandora_fw_close(f);
+		if (got != ph[i].filesz) {
+			printf("PANDORA MPSS: %s is %llu bytes, segment %u wants %u\n", segname, got, i, ph[i].filesz);
+			wrong++;
+		}
+	}
+	kfree_data(buf, (vm_size_t)size);
+	printf("PANDORA MPSS: %s: %u segment files checked, %u missing, %u the wrong size\n", base, checked, missing,
+	    wrong);
+	return missing == 0 && wrong == 0;
+}
+
+static bool
+step_firmware(void)
+{
+	struct mp_elf dtb, main_image;
+	if (!mp_mdt_check("modem_dtb", MP_DTB_PA, MP_DTB_SIZE, &dtb)) {
+		return false;
+	}
+	if (!mp_mdt_check("modem", MP_MEM_PA, MP_MEM_SIZE, &main_image)) {
+		return false;
+	}
+	/* the modem's own check, and the one the PAS loader relies on: the lowest segment is the base */
+	if (main_image.min != MP_MEM_PA) {
+		printf("PANDORA MPSS: modem.mdt's lowest segment is %#llx, not the carveout's base %#llx\n",
+		    main_image.min, MP_MEM_PA);
+		return false;
+	}
+	if (dtb.min != MP_DTB_PA) {
+		printf("PANDORA MPSS: modem_dtb.mdt's lowest segment is %#llx, not the DTB region's base %#llx\n",
+		    dtb.min, MP_DTB_PA);
+		return false;
+	}
+	if (!mp_mdt_segments_present("modem_dtb", &dtb) || !mp_mdt_segments_present("modem", &main_image)) {
+		return false;
+	}
+	mp_survey_dtb_end = (uint32_t)(dtb.max - MP_DTB_PA);
+	mp_survey_main_end = (uint32_t)(main_image.max - MP_MEM_PA);
+	mp_survey_segments = main_image.phnum;
+	printf("PANDORA MPSS: the firmware is whole: the main image ends %#llx with %#llx to spare in the carveout\n",
+	    main_image.max, MP_MEM_PA + MP_MEM_SIZE - main_image.max);
+
+	/*
+	 * The modem's own file systems, read now for the same reason HakiOS reads them here (hakios.mpss.c:1175):
+	 * the modem asks for them over RMTFS the moment it is out of reset, and a modem whose RMTFS never answers
+	 * "offers no services but its own -- DMS and NAS stay away". Nothing here is fatal: a missing partition
+	 * leaves that file absent and RMTFS answers ENOENT, which is the modem's problem to report, not ours.
+	 */
+	unsigned files = pandora_rmtfs_load();
+	(void)files;
+	pandora_servreg_load();
+	return true;
+}
+
+/* ---- step 3: the AOP's mailbox -------------------------------------------------------- */
+
+static bool
+mp_qmp_open_mailbox(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	if (mp_rd(mp_qmp, QMP_MAGIC) != QMP_MAGIC_MAIL) {
+		printf("PANDORA MPSS: the mailbox's magic is %#x, not MAIL\n", mp_rd(mp_qmp, QMP_MAGIC));
+		return false;
+	}
+	/*
+	 * qcom_aoss_qmp_init: our link word up and the box's size, then the AOP's answer. A kernel
+	 * before this one may have left it open (the mailbox is memory the AOP keeps), which is fine:
+	 * the handshake is idempotent.
+	 */
+	mp_wr(mp_qmp, QMP_OUR_LINK, QMP_UP);
+	mp_wr(mp_qmp, QMP_OUR_BOX_SIZE, QMP_MESSAGE);
+	for (unsigned n = 0; n < 100 && mp_rd(mp_qmp, QMP_THEIR_LINK) != QMP_UP; n++) {
+		mp_sleep(1);
+	}
+	bool up = mp_rd(mp_qmp, QMP_THEIR_LINK) == QMP_UP;
+	printf("PANDORA MPSS: the AOP's mailbox %s after %llu ms (its link %#x, ours %#x, box %#x at %#x)\n",
+	    up ? "is open" : "DID NOT OPEN", mp_ms(t0), mp_rd(mp_qmp, QMP_THEIR_LINK), mp_rd(mp_qmp, QMP_OUR_LINK),
+	    mp_rd(mp_qmp, QMP_OUR_BOX_SIZE), QMP_OUR_BOX);
+	if (up) {
+		mp_qmp_open = true;
+	}
+	return up;
+}
+
+static void
+mp_mailbox_send(const char *text)
+{
+	if (!mp_qmp_open) {
+		return;
+	}
+	size_t len = strlen(text);
+	if (len >= QMP_MESSAGE) {
+		len = QMP_MESSAGE - 1;
+	}
+	uint8_t *box = (uint8_t *)(mp_qmp + QMP_OUR_BOX);
+	memset(box, 0, QMP_MESSAGE);
+	memcpy(box, text, len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	mp_wr(mp_ipcc, IPCC_SEND, 0u << 16 | 0u);       /* IPCC client 0 (the AOP), signal 0 */
+	printf("PANDORA MPSS: told the AOP: %s\n", text);
+}
+
+static bool
+step_mailbox(void)
+{
+	if (!mp_qmp_open) {
+		if (!mp_qmp_open_mailbox()) {
+			return false;
+		}
+	}
+	mp_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+	return true;
+}
+
+/* ---- step 4: the modem's DTB image (pas 38) ------------------------------------------- */
+
+static bool
+step_dtb(void)
+{
+	if (pandora_pas_load(MP_FW_PART, "modem_dtb", MP_PAS_DTB, MP_DTB_PA, MP_DTB_SIZE)) {
+		printf("PANDORA MPSS: modem_dtb.mdt did not load\n");
+		return false;
+	}
+	if (pandora_pas_auth(MP_PAS_DTB)) {
+		printf("PANDORA MPSS: TrustZone refused the DTB image\n");
+		return false;
+	}
+	mp_dtb_written = true;
+	printf("PANDORA MPSS: the DTB image is in %#llx and authenticated (pas %u)\n", MP_DTB_PA, MP_PAS_DTB);
+	return true;
+}
+
+/* ---- steps 5 and 6: the main image --------------------------------------------------- */
+
+static bool
+step_header(void)
+{
+	uint32_t in = 0;
+	if (mp_smem_item(MP_ITEM_IN, NULL) && !mp_option("pandora_mpss_again")) {
+		QcomSmp2p view;
+		bzero(&view, sizeof(view));
+		view.in = (volatile uint32_t *)mp_smem_item(MP_ITEM_IN, NULL);
+		int index = qcom_smp2p_check_in(view.in, 0, MP_PID) ? -1 : qcom_smp2p_find_in(&view, "slave-kernel");
+		if (index >= 0 && (qcom_smp2p_in_value(&view, index) & (MP_SLAVE_READY | MP_SLAVE_FATAL))) {
+			printf("PANDORA MPSS: the modem's words say %#x: it may be running. Asking it to stop.\n",
+			    qcom_smp2p_in_value(&view, index));
+			(void)pandora_pas_shutdown(MP_PAS);
+		}
+	}
+	(void)in;
+	/* The metadata is what pandora_pas_load() sends; INIT_IMAGE happens there, so this step only
+	 * proves the carveout is the right one and reports it. */
+	printf("PANDORA MPSS: the main image goes to %#llx+%#llx, its base is the carveout's base\n", MP_MEM_PA,
+	    MP_MEM_SIZE);
+	return true;
+}
+
+static bool
+step_image(void)
+{
+	if (pandora_pas_load(MP_FW_PART, "modem", MP_PAS, MP_MEM_PA, MP_MEM_SIZE)) {
+		printf("PANDORA MPSS: modem.mdt did not load\n");
+		return false;
+	}
+	mp_image_written = true;
+	return true;
+}
+
+/* ---- step 7: our SMP2P item and the GLINK marks -------------------------------------- */
+
+static bool
+mp_mutex_take(void)
+{
+	for (int i = 0; i < 1000; i++) {
+		mp_wr(mp_mutex, 0, 1);
+		if (mp_rd(mp_mutex, 0) == 1) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+mp_mutex_give(void)
+{
+	mp_wr(mp_mutex, 0, 0);
+}
+
+static int
+mp_smem_alloc(uint16_t item, uint32_t size)
+{
+	if (!mp_mutex_take()) {
+		return EBUSY;
+	}
+	int rc = qcom_smem_alloc(&mp_smem, &mp_part, item, size);
+	mp_mutex_give();
+	if (rc && rc != QcomSmemExists) {
+		printf("PANDORA MPSS: SMEM item %u (%u bytes) not allocated: %d\n", item, size, rc);
+		return EIO;
+	}
+	return 0;
+}
+
+static bool
+step_our_item(void)
+{
+	if (mp_smem_alloc(MP_ITEM_OUT, QCOM_SMP2P_ITEM_BYTES)) {
+		return false;
+	}
+	uint32_t osize = 0;
+	volatile uint8_t *out = mp_smem_item(MP_ITEM_OUT, &osize);
+	if (!out || osize < QCOM_SMP2P_ITEM_BYTES) {
+		printf("PANDORA MPSS: SMP2P item %u is %u bytes\n", MP_ITEM_OUT, osize);
+		return false;
+	}
+	qcom_smp2p_init_out(&mp_p2p, (volatile uint32_t *)out, 0, MP_PID);
+	mp_out_entry = qcom_smp2p_add_entry(&mp_p2p, "master-kernel");
+	mp_wr(mp_ipcc, IPCC_RECV_ENABLE, (MP_CLIENT << 16) | MP_SIG_SMP2P);
+	mp_wr(mp_ipcc, IPCC_RECV_ENABLE, (MP_CLIENT << 16) | MP_SIG_GLINK);
+	mp_p2p_on = true;
+	mp_wr(mp_ipcc, IPCC_SEND, (MP_CLIENT << 16) | MP_SIG_SMP2P);
+	printf("PANDORA MPSS: SMP2P item %u made (entry master-kernel %d), doorbells enabled (client %u)\n", MP_ITEM_OUT,
+	    mp_out_entry, MP_CLIENT);
+	return true;
+}
+
+/* ---- step 8: power ------------------------------------------------------------------- */
+
+static void
+mp_rails(uint32_t level)
+{
+	/*
+	 * The modem's supplies are voted through the RPMh ARC resources in the command DB. Which rails
+	 * a given SoC names is not guessable: HakiOS's Redwood uses "cx.lvl" and "mss.lvl", this
+	 * phone's camera and Wi-Fi use "mx.lvl"/"mmcxc.lvl"/"lmx.lvl", and canoe's MSS node carries a
+	 * single cx-supply. Vote every candidate and report which ones the command DB actually has, so
+	 * the first boot says rather than guesses.
+	 */
+	static const char *const names[] = {"cx.lvl", "mss.lvl", "mx.lvl", "lmx.lvl", "mmcx.lvl"};
+	unsigned voted = 0;
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		int rc = pandora_rpmh_arc(names[i], level);
+		if (!rc) {
+			voted++;
+		} else {
+			printf("PANDORA MPSS: rail %s: %d (no such ARC resource, not voted)\n", names[i], rc);
+		}
+	}
+	printf("PANDORA MPSS: %u rails voted to level %u\n", voted, level);
+}
+
+static void
+mp_ipcc_poll(void)
+{
+	for (int n = 0; n < 32; n++) {
+		uint32_t id = mp_rd(mp_ipcc, IPCC_RECV_ID);
+		if (id == IPCC_NONE) {
+			break;
+		}
+		mp_wr(mp_ipcc, IPCC_RECV_CLEAR, id);
+		if (id == ((MP_CLIENT << 16) | MP_SIG_SMP2P)) {
+			__atomic_fetch_add(&mp_bells_smp2p, 1, __ATOMIC_RELAXED);
+		} else if (id == ((MP_CLIENT << 16) | MP_SIG_GLINK)) {
+			__atomic_fetch_add(&mp_bells_glink, 1, __ATOMIC_RELAXED);
+		} else {
+			__atomic_fetch_add(&mp_bells_other, 1, __ATOMIC_RELAXED);
+		}
+	}
+}
+
+/* Services SMP2P; returns the modem's words. */
+static uint32_t
+mp_p2p_service(void)
+{
+	if (!mp_p2p_on) {
+		return 0;
+	}
+	if (!mp_p2p.in) {
+		uint32_t size = 0;
+		volatile uint8_t *in = mp_smem_item(MP_ITEM_IN, &size);
+		if (!in) {
+			return 0;
+		}
+		mp_p2p.in = (volatile uint32_t *)in;
+		printf("PANDORA MPSS: SMP2P item %u (%u bytes) there after %llu ms: check %d\n", MP_ITEM_IN, size,
+		    mp_ms(mp_t0), qcom_smp2p_check_in(mp_p2p.in, 0, MP_PID));
+	}
+	uint32_t value = 0, changed = 0;
+	if (qcom_smp2p_service(&mp_p2p, "slave-kernel", &value, &changed)) {
+		mp_wr(mp_ipcc, IPCC_SEND, (MP_CLIENT << 16) | MP_SIG_SMP2P);
+	}
+	if (changed) {
+		printf("PANDORA MPSS: slave-kernel %#x (changed %#x) after %llu ms\n", value, changed, mp_ms(mp_t0));
+	}
+	mp_slave = value;
+	return value;
+}
+
+static bool
+step_start(void)
+{
+	uint32_t wait_ms = 10000;
+	(void)PE_parse_boot_argn("pandora_mpss_wait", &wait_ms, sizeof(wait_ms));
+	if (!mp_dtb_written || !mp_image_written) {
+		printf("PANDORA MPSS: the images are not in place (dtb %d, main %d)\n", mp_dtb_written,
+		    mp_image_written);
+		return false;
+	}
+	/*
+	 * The buffer the modem keeps its four file systems in, and TrustZone told to let it in (HakiOS at
+	 * :2445-2451, before the rails and before AUTH_AND_RESET, because the modem starts asking for those
+	 * files as soon as it runs). Without boot-arg modem_buffer there is no address to share -- canoe's
+	 * rmtfs_sharedmem@0 reg is a bootloader placeholder, not memory -- so the modem starts anyway and
+	 * will offer little; pandora_rmtfs_buffer_make() has already printed why.
+	 */
+	if (pandora_option("modem_share_off")) {
+		printf("PANDORA MPSS: %u: the buffer is not shared with the modem (modem_share_off)\n", pandora_step);
+	} else if (!pandora_rmtfs_buffer_make() || !pandora_rmtfs_share(true)) {
+		printf("PANDORA MPSS: THE MODEM GETS NO BUFFER FOR ITS FILES: it is started all the same, and will offer "
+		    "little\n");
+	}
+	mp_rails(384);
+	mp_mailbox_send("{class: image, res: load_state, name: modem, val: on}");
+	if (pandora_pas_auth(MP_PAS)) {
+		printf("PANDORA MPSS: TrustZone refused the modem's image\n");
+		return false;
+	}
+	mp_started = true;
+	mp_t0 = mach_absolute_time();
+	printf("PANDORA MPSS: the modem has been let out of reset; watching for its words for %u ms\n", wait_ms);
+	for (unsigned waited = 0; waited < wait_ms; waited += 20) {
+		mp_ipcc_poll();
+		uint32_t words = mp_p2p_service();
+		if (words & MP_SLAVE_FATAL) {
+			printf("PANDORA MPSS: THE MODEM CRASHED: its words %#x after %llu ms\n", words, mp_ms(mp_t0));
+			return false;
+		}
+		if (words & MP_SLAVE_READY) {
+			printf("PANDORA MPSS: THE MODEM IS READY (%#x) %llu ms after the reset%s\n", words, mp_ms(mp_t0),
+			    (words & MP_SLAVE_HANDOVER) ? ", and has handed over" : "");
+			return true;
+		}
+		mp_sleep(20);
+	}
+	printf("PANDORA MPSS: the modem did not say it was ready in %u ms (its words %#x); doorbells SMP2P %u GLINK %u "
+	    "other %u\n", wait_ms, mp_slave, mp_bells_smp2p, mp_bells_glink, mp_bells_other);
+	return false;
+}
+
+/* ---- steps 9 and 10: GLINK ------------------------------------------------------------ */
+
+static void
+mp_gl_kick(void *ctx)
+{
+	(void)ctx;
+	mp_wr(mp_ipcc, IPCC_SEND, (MP_CLIENT << 16) | MP_SIG_GLINK);
+}
+
+static bool
+step_queues(void)
+{
+	uint32_t dsize = 0, was[4] = {0, 0, 0, 0};
+	volatile uint8_t *old = mp_smem_item(MP_ITEM_GL_DESC, &dsize);
+	if (old && dsize >= 16) {
+		const volatile uint32_t *w = (const volatile uint32_t *)old;
+		for (unsigned i = 0; i < 4; i++) {
+			was[i] = w[i];
+		}
+		printf("PANDORA MPSS: GLINK descriptor from an earlier session: our FIFO tail %u head %u, theirs tail %u head "
+		    "%u\n", was[0], was[1], was[2], was[3]);
+	}
+	int err = mp_smem_alloc(MP_ITEM_GL_DESC, 32);
+	if (!err) {
+		err = mp_smem_alloc(MP_ITEM_GL_TX, MP_GL_FIFO);
+	}
+	uint32_t tsize = 0;
+	volatile uint8_t *desc = mp_smem_item(MP_ITEM_GL_DESC, &dsize), *txf = mp_smem_item(MP_ITEM_GL_TX, &tsize);
+	printf("PANDORA MPSS: GLINK items %u (%u bytes) %u (%u bytes) -> %d\n", MP_ITEM_GL_DESC, dsize, MP_ITEM_GL_TX,
+	    tsize, err);
+	if (err || !desc || !txf || dsize < 32) {
+		return false;
+	}
+	volatile uint32_t *d = (volatile uint32_t *)desc;
+	QcomGlinkFifo tx = {&d[1], &d[0], txf, tsize}, rx = {&d[3], &d[2], NULL, 0};
+	qcom_glink_init(&mp_gl, tx, rx, mp_gl_kick, NULL);
+	mp_gl_on = true;
+	return true;
+}
+
+static bool
+step_link(void)
+{
+	if (!mp_gl_on) {
+		printf("PANDORA MPSS: the queues are not there\n");
+		return false;
+	}
+	if (!mp_gl.rx.data) {
+		uint32_t size = 0;
+		volatile uint8_t *rx = mp_smem_item(MP_ITEM_GL_RX, &size);
+		if (!rx) {
+			printf("PANDORA MPSS: the modem has not made its FIFO (item %u)\n", MP_ITEM_GL_RX);
+			return false;
+		}
+		qcom_glink_set_rx(&mp_gl, rx, size);
+		printf("PANDORA MPSS: GLINK item %u (%u bytes) there after %llu ms\n", MP_ITEM_GL_RX, size, mp_ms(mp_t0));
+	}
+	(void)qcom_glink_poll(&mp_gl);
+	printf("PANDORA MPSS: GLINK version %s, messages in %u out %u data %u, opens nobody serves %u (%s)\n",
+	    mp_gl.version_agreed ? "agreed" : "not agreed yet", mp_gl.rx_messages, mp_gl.tx_messages, mp_gl.rx_data,
+	    mp_gl.unknown_opens, mp_gl.unknown_names);
+
+	/*
+	 * Our side of the router's channel (hakios.mpss.c:2607 glink_offer, then :3004 glink_send's
+	 * neighbour glink_open). QcomGlink takes the open_now flag at creation, so the open is sent from
+	 * here once the version is agreed -- before that the DSP would not understand it.
+	 */
+	if (!mp_qrtr_channel && mp_gl.version_agreed) {
+		uint32_t bytes = MP_GL_INTENT_SIZE * MP_GL_INTENT_COUNT;
+
+		if (mp_gl_storage == NULL) {
+			mp_gl_storage = kalloc_data(bytes, Z_WAITOK | Z_ZERO);
+		}
+		if (mp_gl_storage == NULL) {
+			printf("PANDORA MPSS: no memory for the router's intents (%u bytes)\n", bytes);
+			return false;
+		}
+		static const QcomGlinkClient client = {mp_qrtr_state, mp_qrtr_receive};
+		mp_qrtr_channel = qcom_glink_channel(&mp_gl, MP_GL_CHANNEL, MP_GL_INTENT_SIZE, MP_GL_INTENT_COUNT,
+		    mp_gl_storage, &client, NULL, 1);
+		printf("PANDORA MPSS: channel %s %s (%u intents of %u bytes)\n", MP_GL_CHANNEL,
+		    mp_qrtr_channel != NULL ? "opened" : "NOT OPENED", MP_GL_INTENT_COUNT, MP_GL_INTENT_SIZE);
+		if (mp_qrtr_channel == NULL) {
+			return false;
+		}
+	}
+
+	/*
+	 * RMTFS, TFTP and servreg, on their own QRTR ports (HakiOS at :252, in the step that announces
+	 * GLINK's version). They are what the modem's four file systems are served over, and what the
+	 * modem reads its RF configuration from, so they must be up before NAS can register.
+	 */
+	if (pandora_rmtfs_start()) {
+		printf("PANDORA MPSS: RMTFS on port %u, and the services published\n", pandora_our_servers[0].port);
+	} else {
+		printf("PANDORA MPSS: THE MODEM'S FILES ARE NOT SERVED: no RMTFS port\n");
+	}
+
+	/*
+	 * The thread that keeps GLINK served and the doorbells answered while the system runs
+	 * (hakios.mpss.c:3441 link_thread, started at :2528). Without it nothing polls, the modem's
+	 * QRTR HELLO is never read, and RMTFS never answers a request.
+	 */
+	if (!mp_link_running) {
+		thread_t thread;
+
+		mp_link_stop = false;
+		if (kernel_thread_start(mp_link_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("PANDORA MPSS: no thread for the link: the modem's services are not answered\n");
+			return false;
+		}
+		thread_deallocate(thread);
+		printf("PANDORA MPSS: the link's thread started\n");
+	}
+	return mp_gl.version_agreed != 0;
+}
+
+/* ---- the steps, and their thread ------------------------------------------------------- */
+
+static bool
+step_qrtr(void)
+{
+	/* The QRTR block (bsd/dev/pandora_qrtr.c) owns the port table; this proves the link carries it. */
+	uint32_t listen = 3;
+	(void)PE_parse_boot_argn("pandora_mpss_listen", &listen, sizeof(listen));
+	printf("PANDORA MPSS: watching the link for %u s\n", listen);
+	for (unsigned waited = 0; waited < listen * 1000; waited += 20) {
+		mp_ipcc_poll();
+		(void)mp_p2p_service();
+		(void)qcom_glink_poll(&mp_gl);
+		mp_sleep(20);
+	}
+	printf("PANDORA MPSS: GLINK after the watch: version %s, in %u out %u data %u, opens nobody serves %u (%s), "
+	    "doorbells SMP2P %u GLINK %u\n", mp_gl.version_agreed ? "agreed" : "NOT AGREED", mp_gl.rx_messages,
+	    mp_gl.tx_messages, mp_gl.rx_data, mp_gl.unknown_opens, mp_gl.unknown_names, mp_bells_smp2p, mp_bells_glink);
+	return mp_gl.version_agreed != 0;
+}
+
+/*
+ * ---- QRTR's channel (bsd/dev/pandora_qrtr.c) ------------------------------------------------
+ *
+ * Everything of the router's channel that is GLINK's business is here: the channel object, the
+ * intents it advertises, the callback that hands each frame to the QRTR block, and the thread that
+ * keeps GLINK and the IPCC polls running while the system is up (hakios.mpss.c:3441 link_thread).
+ */
+
+/* A frame from the DSP on IPCRTR: one QRTR datagram (hakios.mpss.c:3476). */
+static void
+mp_qrtr_receive(void *context, QcomGlinkChannel *channel, const uint8_t *data, uint32_t length)
+{
+	(void)context;
+	(void)channel;
+	pandora_qrtr_input(data, length);
+}
+
+/* A channel came up, or went (hakios.mpss.c:3462). */
+static void
+mp_qrtr_state(void *context, QcomGlinkChannel *channel, int up)
+{
+	(void)context;
+	printf("PANDORA MPSS: channel %s %s\n", channel->name, up ? "up" : "down");
+}
+
+/* The link's thread: GLINK, the doorbells, the fresh lookups, and the modem's words (hakios.mpss.c:3441). */
+static void
+mp_link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	lck_mtx_lock(&mp_lock);
+	pandora_qrtr_link_thread = current_thread();
+	mp_link_running = true;
+	lck_mtx_unlock(&mp_lock);
+	printf("PANDORA MPSS: the link's thread is running\n");
+	while (!mp_link_stop) {
+		mp_ipcc_poll();
+		(void)mp_p2p_service();
+		(void)qcom_glink_poll(&mp_gl);
+		pandora_qrtr_fresh();
+		mp_sleep(20);
+	}
+	lck_mtx_lock(&mp_lock);
+	mp_link_running = false;
+	pandora_qrtr_link_thread = NULL;
+	lck_mtx_unlock(&mp_lock);
+	printf("PANDORA MPSS: the link's thread is over (GLINK in %u out %u data %u)\n", mp_gl.rx_messages,
+	    mp_gl.tx_messages, mp_gl.rx_data);
+	thread_terminate(current_thread());
+}
+
+/*
+ * ---- the three calls the QRTR block makes into this file ------------------------------------
+ *
+ * The QRTR block is the source's, and it talks to GLINK through three calls it cannot make
+ * itself because the channel belongs to this file (hakios.mpss.c:2591 CHANNEL_QRTR, :2625
+ * glink_send, :3004 its open flag). These are those three, in the names the block uses.
+ */
+struct pandora_glink_channel *pandora_mpss_glink_channel(const char *name);
+struct pandora_glink_channel *
+pandora_mpss_glink_channel(const char *name)
+{
+	QcomGlinkChannel *channel = mp_qrtr_channel;
+
+	if (name == NULL || channel == NULL || !channel->up || strcmp(channel->name, name) != 0) {
+		return NULL;
+	}
+	return (struct pandora_glink_channel *)channel;
+}
+
+int pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length);
+int
+pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length)
+{
+	return qcom_glink_send(&mp_gl, (QcomGlinkChannel *)channel, data, length);
+}
+
+static bool (*const mp_steps[MP_STEPS])(void) = {
+	step_survey, step_firmware, step_mailbox, step_dtb, step_header, step_image, step_our_item, step_start,
+	step_queues, step_link, step_qrtr,
+};
+
+static void
+mp_steps_over(uint32_t done)
+{
+	lck_mtx_lock(&mp_lock);
+	if (mp_started && done == mp_last_step && mp_keep) {
+		printf("PANDORA MPSS: THE MODEM STAYS ON while the system runs\n");
+	} else if (mp_started) {
+		(void)pandora_pas_shutdown(MP_PAS);
+		mp_started = false;
+	}
+	lck_mtx_unlock(&mp_lock);
+}
+
+static void
+mp_run_steps(void)
+{
+	uint32_t done = 0;
+	for (uint32_t s = 1; s <= mp_last_step; s++) {
+		pandora_step = s;
+		if (!mp_steps[s - 1]()) {
+			printf("PANDORA MPSS: step %u FAILED; the steps after it are not attempted\n", s);
+			break;
+		}
+		printf("PANDORA MPSS: step %u done\n", s);
+		done = s;
+	}
+	mp_new_from = MP_STEPS + 1;
+	mp_steps_over(done);
+	printf("PANDORA MPSS: over after step %u\n", done);
+	pandora_step = 0;
+}
+
+static void
+mp_steps_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	mp_run_steps();
+	thread_terminate(current_thread());
+}
+
+static void
+mp_whole_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	mp_run_steps();
+	if (mp_started && mp_gl_on && mp_gl.version_agreed) {
+		printf("PANDORA MPSS: THE MODEM IS UP AND LINKED, %llu ms after the kernel began on it\n", mp_ms(mp_t0));
+	}
+	thread_terminate(current_thread());
+}
+
+/* The windows both halves use. */
+static int
+mp_map_windows(void)
+{
+	if (mp_mapped) {
+		return 0;
+	}
+	mp_qmp = mp_map(MP_QMP_PA, MP_QMP_SIZE, VM_WIMG_IO);
+	mp_ipcc = mp_map(MP_IPCC_PA, MP_IPCC_SIZE, VM_WIMG_IO);
+	mp_smem_va = mp_map(MP_SMEM_PA, MP_SMEM_SIZE, VM_WIMG_IO);
+	mp_mutex = mp_map(MP_MUTEX_PA, MP_MUTEX_SIZE, VM_WIMG_IO);
+	if (!mp_qmp || !mp_ipcc || !mp_smem_va || !mp_mutex) {
+		printf("PANDORA MPSS: windows not mapped\n");
+		return ENOMEM;
+	}
+	mp_smem.base = (volatile uint8_t *)mp_smem_va;
+	mp_smem.size = MP_SMEM_SIZE;
+	mp_mapped = true;
+	return 0;
+}
+
+void pandora_mpss_stop(void);
+void
+pandora_mpss_stop(void)
+{
+	lck_mtx_lock(&mp_lock);
+	mp_link_stop = true;
+	pandora_rmtfs_stop();
+	if (mp_started) {
+		(void)pandora_pas_shutdown(MP_PAS);
+		mp_started = false;
+		printf("PANDORA MPSS: the modem is off\n");
+	}
+	lck_mtx_unlock(&mp_lock);
+}
+
+void pandora_mpss_quiesce(void);
+void
+pandora_mpss_quiesce(void)
+{
+	if (!mp_started) {
+		return;
+	}
+	mp_leaving = true;
+	mp_link_stop = true;
+	pandora_rmtfs_stop();
+	(void)pandora_pas_shutdown(MP_PAS);
+}
+
+/*
+ * Boot-arg pandora_mpss: 1 brings the whole modem up on a thread beside the system's start;
+ * pandora_mpss_step=N runs steps 1..N and stops, which is how each stage is proven on its own.
+ */
+void pandora_mpss_init(void);
+void
+pandora_mpss_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("pandora_mpss_step", &mp_last_step, sizeof(mp_last_step));
+	if (mp_last_step == 0 && (!PE_parse_boot_argn("pandora_mpss", &on, sizeof(on)) || on != 1)) {
+		return;
+	}
+	if (mp_map_windows()) {
+		return;
+	}
+	if (mp_last_step == 0) {
+		mp_last_step = MP_STEPS;
+		mp_keep = true;
+		mp_pause_ms = 0;
+		mp_new_from = MP_STEPS + 1;
+		if (kernel_thread_start(mp_whole_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("PANDORA MPSS: no thread: the modem is not brought up\n");
+			return;
+		}
+		thread_deallocate(thread);
+		printf("PANDORA MPSS: the modem is being brought up beside the system's start\n");
+		return;
+	}
+	if (mp_last_step > MP_STEPS) {
+		mp_last_step = MP_STEPS;
+	}
+	mp_keep = mp_option("pandora_mpss_keep");
+	mp_new_from = mp_last_step;
+	PE_parse_boot_argn("pandora_mpss_new", &mp_new_from, sizeof(mp_new_from));
+	PE_parse_boot_argn("pandora_mpss_pause", &mp_pause_ms, sizeof(mp_pause_ms));
+	printf("PANDORA MPSS: steps up to %u; those from %u on wait %u ms after each announcement\n", mp_last_step,
+	    mp_new_from, mp_pause_ms);
+	if (kernel_thread_start(mp_steps_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("PANDORA MPSS: no thread: the steps are not performed\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
diff --git a/bsd/dev/pandora_part.h b/bsd/dev/pandora_part.h
new file mode 100644
index 0000000..990fb47
--- /dev/null
+++ b/bsd/dev/pandora_part.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* A read-only handle on one of the phone's GPT partitions, found by name on any LUN. The UFS driver
+ * (bsd/dev/sweet_ufs.c) implements these; bsd/dev/pandora_adsp.c and bsd/dev/pandora_mpss.c each take
+ * their own handle, so the ADSP reading modem_<slot> and the modem reading modemfirmware_<slot> do not
+ * move each other's reads onto the wrong partition. */
+#ifndef PANDORA_PART_H
+#define PANDORA_PART_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pandora_part;
+
+/* Finds name (e.g. "modem_a", "modemfirmware_a") and returns a handle in *out: 0 or an errno. */
+int pandora_part_open(const char *name, struct pandora_part **out);
+/* Reads len bytes at byte offset off of the partition into dst: 0 or an errno. */
+int pandora_part_read(struct pandora_part *part, uint64_t off, void *dst, uint64_t len);
+/* The partition's length in bytes; 0 for no handle. */
+uint64_t pandora_part_size(struct pandora_part *part);
+/* Gives the handle back. Reads through it fail afterwards. */
+void pandora_part_close(struct pandora_part *part);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/pandora_pas.c b/bsd/dev/pandora_pas.c
new file mode 100644
index 0000000..5f2344c
--- /dev/null
+++ b/bsd/dev/pandora_pas.c
@@ -0,0 +1,265 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* A signed image loaded into a remote processor's memory and started, for the modem
+ * (bsd/dev/pandora_mpss.c) and anything else that needs two stages out of the firmware partition.
+ *
+ * This is the same sequence bsd/dev/pandora_adsp.c uses (which read it off
+ * drivers/remoteproc/qcom_q6v5_pas.c), separated out because the modem needs it twice: canoe's
+ * devicetree names TWO images, "modem.mdt\0modem_dtb.mdt", and Linux loads them in that order --
+ * the DTB image (pas 38) into q6_mpss_dtb_region, then the main image (pas 4) into mpss_region.
+ * Each stage is: metadata (ELF header + program headers, then the hash segment) in plain
+ * contiguous memory, PAS_INIT_IMAGE, PAS_MEM_SETUP when the image is relocatable, the segments
+ * copied into the carveout, and PAS_AUTH_AND_RESET. Loading the main image without the DTB image
+ * first is not an option: the modem would run with no RF configuration.
+ *
+ * No SHM bridge of our own: the SM8850 kernel's qcom_scm_pas_init_image says the hypervisor
+ * creates the bridge for PIL metadata itself and that a buffer already in a bridge makes the call
+ * fail (it did: -3145738 from init_image).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <arm/caches_internal.h>
+#include "pandora_pas.h"
+#include "pandora_fw.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern uint64_t kvtophys(vm_offset_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern void pandora_scm_call(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t *a0,
+    uint64_t *a1);
+/* The three-argument form (PAS_MEM_SETUP's pas, base, span); the two-argument one above covers the
+ * rest. Both serialize on the same lock and both handle a queued call. */
+extern void pandora_scm_call3(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4,
+    uint64_t *a0);
+
+#define PAS_MAX_SEGMENTS 64
+#define PAS_MDT_MAX      0x10000
+
+struct elf32_phdr {
+	uint32_t p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align;
+};
+#define MDT_TYPE_MASK    (7u << 24)
+#define MDT_TYPE_HASH    (2u << 24)
+#define MDT_RELOCATABLE  (1u << 27)
+
+#define SCM_FN(svc, cmd)  ((1ULL << 30) | (2ULL << 24) | (((uint64_t)(svc) & 0xff) << 8) | ((cmd) & 0xff))
+#define SCM_ARGS(n)       ((uint64_t)(n) & 0xf)
+#define SCM_RW            2u
+#define SCM_PAS_INIT_IMAGE   SCM_FN(2, 1)
+#define SCM_PAS_MEM_SETUP    SCM_FN(2, 2)
+#define SCM_PAS_AUTH_AND_RESET SCM_FN(2, 5)
+#define SCM_PAS_SHUTDOWN     SCM_FN(2, 6)
+
+static int
+mdt_loadable(const struct elf32_phdr *p)
+{
+	return p->p_type == 1 && (p->p_flags & MDT_TYPE_MASK) != MDT_TYPE_HASH && p->p_memsz;
+}
+
+/* Read segment i of base.mdt: from base.bNN (split images) or from the .mdt itself. */
+static int
+mdt_segment(const char *prefix, const char *base, const struct pandora_fw *mdt, const struct elf32_phdr *p,
+    unsigned i, void *dst)
+{
+	char name[PAS_FW_NAME];
+	struct pandora_fw *seg = NULL;
+	uint64_t size = 0;
+
+	snprintf(name, sizeof(name), "%s.b%02u", base, i);
+	if (pandora_fw_open(prefix, name, &seg, &size) == 0) {
+		int err = EINVAL;
+		if (size != p->p_filesz) {
+			printf("PANDORA PAS: %s is %llu bytes, segment wants %u\n", name, size, p->p_filesz);
+		} else {
+			err = pandora_fw_file_read(seg, 0, dst, p->p_filesz);
+		}
+		pandora_fw_close(seg);
+		return err;
+	}
+	if ((uint64_t)p->p_offset + p->p_filesz <= PAS_MDT_MAX) {
+		return pandora_fw_file_read((struct pandora_fw *)mdt, p->p_offset, dst, p->p_filesz);
+	}
+	printf("PANDORA PAS: segment %u of %s missing\n", i, base);
+	return ENOENT;
+}
+
+/*
+ * One image: metadata to TrustZone, init, mem setup when relocatable, segments into the carveout.
+ * Returns 0 or an errno; the caller authenticates separately so a two-stage load can be verified
+ * stage by stage.
+ */
+int
+pandora_pas_load(const char *prefix, const char *base, unsigned pas, uint64_t mem_pa, uint64_t mem_size)
+{
+	char name[PAS_FW_NAME];
+	struct pandora_fw *mdt = NULL;
+	uint64_t mdt_size = 0;
+	int err;
+
+	if (strchr(base, '.')) {
+		strlcpy(name, base, sizeof(name));      /* a whole image, e.g. gen80200_zap.mbn */
+	} else {
+		snprintf(name, sizeof(name), "%s.mdt", base);
+	}
+	err = pandora_fw_open(prefix, name, &mdt, &mdt_size);
+	if (err || mdt_size < 52 || mdt_size > PAS_MDT_MAX) {
+		printf("PANDORA PAS: %s missing in %s (%d, %llu bytes)\n", name, prefix, err, mdt_size);
+		if (!err) {
+			pandora_fw_close(mdt);
+		}
+		return err ? err : ENOENT;
+	}
+	uint8_t *hdr = (uint8_t *)kalloc_data(PAS_MDT_MAX, Z_WAITOK);
+	if (!hdr) {
+		pandora_fw_close(mdt);
+		return ENOMEM;
+	}
+	err = pandora_fw_file_read(mdt, 0, hdr, mdt_size);
+	if (err) {
+		goto out;
+	}
+	uint32_t phoff;
+	uint32_t phnum;
+	memcpy(&phoff, hdr + 28, 4);
+	phnum = (uint32_t)(hdr[44] | (hdr[45] << 8));
+	if (memcmp(hdr, "\177ELF", 4) || hdr[4] != 1 || phnum < 2 || phnum > PAS_MAX_SEGMENTS ||
+	    (uint64_t)phoff + (uint64_t)phnum * sizeof(struct elf32_phdr) > mdt_size) {
+		printf("PANDORA PAS: %s is not a 32-bit ELF header (phnum %u)\n", name, phnum);
+		err = EINVAL;
+		goto out;
+	}
+	const struct elf32_phdr *ph = (const struct elf32_phdr *)(hdr + phoff);
+	unsigned hash = 0;
+	uint64_t min = ~0ull, max = 0;
+	bool reloc = false;
+	for (unsigned i = 0; i < phnum; i++) {
+		if (!hash && i && (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			hash = i;
+		}
+		if (!mdt_loadable(&ph[i])) {
+			continue;
+		}
+		reloc = reloc || (ph[i].p_flags & MDT_RELOCATABLE) != 0;
+		min = MIN(min, (uint64_t)ph[i].p_paddr);
+		max = MAX(max, ((uint64_t)ph[i].p_paddr + ph[i].p_memsz + 0xfff) & ~0xfffull);
+	}
+	if (!hash || ph[0].p_type == 1 || min == ~0ull) {
+		printf("PANDORA PAS: %s: no hash segment\n", name);
+		err = EINVAL;
+		goto out;
+	}
+	uint32_t ehdr_size = ph[0].p_filesz;
+	uint32_t hash_size = ph[hash].p_filesz;
+	uint64_t md_size = ((uint64_t)ehdr_size + hash_size + 0xfff) & ~0xfffull;
+	printf("PANDORA PAS: %s: pas %u, %u segments, hash %u (%u bytes), load %#llx-%#llx%s, carveout %#llx+%#llx\n",
+	    name, pas, phnum, hash, hash_size, min, max, reloc ? " relocatable" : "", mem_pa, mem_size);
+	if (max - min > mem_size) {
+		printf("PANDORA PAS: %s does not fit its carveout\n", name);
+		err = EINVAL;
+		goto out;
+	}
+	vm_offset_t md = 0;
+	if (kmem_alloc_contig(kernel_map, &md, (vm_size_t)md_size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		err = ENOMEM;
+		goto out;
+	}
+	uint64_t md_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)md));
+	memcpy((void *)md, hdr, ehdr_size);
+	if (ehdr_size + hash_size == mdt_size) {
+		memcpy((void *)(md + ehdr_size), hdr + ehdr_size, hash_size);
+	} else if ((uint64_t)ph[hash].p_offset + hash_size <= mdt_size) {
+		memcpy((void *)(md + ehdr_size), hdr + ph[hash].p_offset, hash_size);
+	} else if ((err = mdt_segment(prefix, base, mdt, &ph[hash], hash, (void *)(md + ehdr_size)))) {
+		kmem_free(kernel_map, md, (vm_size_t)md_size);
+		goto out;
+	}
+	flush_dcache64((addr64_t)md_pa, (unsigned)md_size, TRUE);
+	uint64_t a0 = 0, a1 = 0;
+	pandora_scm_call(SCM_PAS_INIT_IMAGE, SCM_ARGS(2) | (SCM_RW << 6), pas, md_pa, &a0, &a1);
+	printf("PANDORA PAS: pas %u init_image (%u bytes) -> a0 %#llx (%d) a1 %#llx\n", pas,
+	    ehdr_size + hash_size, a0, (int)(int32_t)a0, a1);
+	if (a0 || a1) {
+		kmem_free(kernel_map, md, (vm_size_t)md_size);
+		err = EIO;
+		goto out;
+	}
+	if (reloc) {
+		/* pas, the carveout's base, and the span the image actually occupies */
+		pandora_scm_call3(SCM_PAS_MEM_SETUP, SCM_ARGS(3), pas, mem_pa, max - min, &a0);
+		printf("PANDORA PAS: pas %u mem_setup %#llx+%#llx -> a0 %#llx (%d)\n", pas, mem_pa, max - min,
+		    a0, (int)(int32_t)a0);
+		if (a0) {
+			kmem_free(kernel_map, md, (vm_size_t)md_size);
+			err = EIO;
+			goto out;
+		}
+	}
+	vm_offset_t mem = ml_io_map_unmappable((vm_offset_t)mem_pa, (vm_size_t)((mem_size + 0xfff) & ~0xfffull),
+	    VM_WIMG_WCOMB);
+	if (!mem) {
+		printf("PANDORA PAS: %s: carveout %#llx+%#llx not mapped\n", name, mem_pa, mem_size);
+		kmem_free(kernel_map, md, (vm_size_t)md_size);
+		err = ENOMEM;
+		goto out;
+	}
+	uint64_t reloc_base = reloc ? min : mem_pa, total = 0;
+	err = 0;
+	for (unsigned i = 0; i < phnum && !err; i++) {
+		if (!mdt_loadable(&ph[i])) {
+			continue;
+		}
+		uint64_t off = (uint64_t)ph[i].p_paddr - reloc_base;
+		if (off + ph[i].p_memsz > mem_size || ph[i].p_filesz > ph[i].p_memsz) {
+			printf("PANDORA PAS: %s segment %u outside the carveout\n", name, i);
+			err = EINVAL;
+			break;
+		}
+		if (ph[i].p_filesz && (err = mdt_segment(prefix, base, mdt, &ph[i], i, (void *)(mem + off)))) {
+			break;
+		}
+		if (ph[i].p_memsz > ph[i].p_filesz) {
+			bzero((void *)(mem + off + ph[i].p_filesz), ph[i].p_memsz - ph[i].p_filesz);
+		}
+		total += ph[i].p_filesz;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap(mem, (vm_size_t)((mem_size + 0xfff) & ~0xfffull));
+	kmem_free(kernel_map, md, (vm_size_t)md_size);
+	if (!err) {
+		printf("PANDORA PAS: %s: %llu bytes loaded at %#llx\n", name, total, mem_pa);
+	}
+out:
+	kfree_data(hdr, PAS_MDT_MAX);
+	pandora_fw_close(mdt);
+	return err;
+}
+
+/* PAS_AUTH_AND_RESET: lets the processor out of reset. */
+int
+pandora_pas_auth(unsigned pas)
+{
+	uint64_t t0 = mach_absolute_time(), ns = 0, a0 = 0, a1 = 0;
+	pandora_scm_call(SCM_PAS_AUTH_AND_RESET, SCM_ARGS(1), pas, 0, &a0, &a1);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("PANDORA PAS: pas %u auth_and_reset -> a0 %#llx (%d) a1 %#llx (%llu ms)\n", pas, a0,
+	    (int)(int32_t)a0, a1, ns / 1000000);
+	return (a0 || a1) ? EIO : 0;
+}
+
+/* PAS_SHUTDOWN: puts it back into reset. */
+int
+pandora_pas_shutdown(unsigned pas)
+{
+	uint64_t a0 = 0, a1 = 0;
+	pandora_scm_call(SCM_PAS_SHUTDOWN, SCM_ARGS(1), pas, 0, &a0, &a1);
+	printf("PANDORA PAS: pas %u shutdown -> a0 %#llx (%d) a1 %#llx\n", pas, a0, (int)(int32_t)a0, a1);
+	return (a0 || a1) ? EIO : 0;
+}
diff --git a/bsd/dev/pandora_pas.h b/bsd/dev/pandora_pas.h
new file mode 100644
index 0000000..743ff9a
--- /dev/null
+++ b/bsd/dev/pandora_pas.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* A signed image loaded into a remote processor's memory and started (bsd/dev/pandora_pas.c).
+ * The modem needs this twice: the DTB image (pas 38) into q6_mpss_dtb_region, then the main image
+ * (pas 4) into mpss_region, in that order. */
+#ifndef PANDORA_PAS_H
+#define PANDORA_PAS_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PAS_FW_NAME 48
+
+/* Loads base (e.g. "modem_dtb") out of the partition whose GPT name begins with prefix, as PAS
+ * image pas, into mem_pa+mem_size. Authenticates nothing: call pandora_pas_auth() after. */
+int pandora_pas_load(const char *prefix, const char *base, unsigned pas, uint64_t mem_pa, uint64_t mem_size);
+/* PAS_AUTH_AND_RESET: lets the processor out of reset. */
+int pandora_pas_auth(unsigned pas);
+/* PAS_SHUTDOWN: puts it back into reset. */
+int pandora_pas_shutdown(unsigned pas);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/pandora_qrtr.c b/bsd/dev/pandora_qrtr.c
new file mode 100644
index 0000000..4120699
--- /dev/null
+++ b/bsd/dev/pandora_qrtr.c
@@ -0,0 +1,533 @@
+/*
+ * PANDORA modem: QRTR -- the router's datagrams, and ports of ours.
+ *
+ * This is the QRTR block of HakiOS's drivers/modem/hakios.mpss.c ported verbatim: source lines 3056
+ * through 3433, from the banner "QRTR: the router's datagrams, and ports of ours (hakios.wifi.c)" to
+ * the closing brace of hakios_mpss_qrtr(). The tabs, the block comments, the order of the cases and
+ * the arithmetic are the source's. Nothing was improved, reformatted or reorganised; the only edits
+ * are the rename hakios_qrtr_* -> pandora_qrtr_*, hakios_mpss_qrtr -> pandora_mpss_qrtr,
+ * HAKIOS_QRTR_MAX -> PANDORA_QRTR_MAX, and the file-local names (qrtr_ports -> pq_ports, qrtr_lock ->
+ * pq_lock and the rest) that this file can no longer share with hakios.mpss.c's other blocks. Each
+ * deviation from a straight rename is marked PORTER'S NOTE at the place it happens, and they are all
+ * listed again at the foot of the file.
+ *
+ * HakiOS's block header, which says what the channel carries (sys/hakios.qrtr.h is pandora_qrtr.h
+ * here, and hakios.nas.c / hakios.qmi.c are not ported yet):
+ *
+ *   What goes over the channel: datagrams of Qualcomm's IPC router, each with a header that says who
+ *   sends it (a node, a port) and to whom, and of which kind. The control port hears of the services
+ *   the modem offers ("new server": a service, an instance, a node, a port), and later their going.
+ *   We are node 1 (Linux's default, and what this phone's Android is); the modem says who it is in
+ *   what it sends.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+
+#include "pandora_modem.h"
+#include "pandora_qrtr.h"
+
+/* ---- declared, not copied: what the caller provides instead of this file ----------------------------- */
+
+/*
+ * The link's IPCRTR channel, and one send on it. In HakiOS both are file statics of hakios.mpss.c that
+ * this block reaches for directly -- the channel table's entry (:2625, name "IPCRTR", intents 0x800,
+ * 0x2000 and 0x4400) and static int glink_send(struct glink_channel *, const void *, uint32_t)
+ * (:3004). They are the caller's here, because the GLINK instance belongs to bsd/dev/pandora_mpss.c:
+ * pandora_mpss_glink_channel() is "the channel of this name", NULL until the modem has opened it --
+ * which is exactly what glink.channel[CHANNEL_QRTR].open said -- and pandora_mpss_glink_send() is
+ * glink_send() with the channel handed in.
+ */
+struct pandora_glink_channel;
+extern struct pandora_glink_channel *pandora_mpss_glink_channel(const char *name);
+extern int pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length);
+
+/*
+ * printf() in this block is the port's plain log, defined once in bsd/dev/pandora_mpss.c as
+ * pandora_say() (HakiOS's say(), hakios.mpss.c:131) -- the same bridge pandora_rmtfs.c uses.
+ */
+#define printf pandora_say
+
+/*
+ * The lock group this file's two mutexes are in. HakiOS shares one group with the rest of
+ * hakios.mpss.c (:101, static LCK_GRP_DECLARE(mpss_lock_group, "hakios-mpss")); the QRTR state is this
+ * file's alone on this side, so the group is too. PORTER'S NOTE (not in the source's range).
+ */
+static LCK_GRP_DECLARE(pq_grp, "pandora-qrtr");
+
+/*
+ * glink.channel[CHANNEL_QRTR], which the block reaches for at :3135, :3417 and :3428. PORTER'S NOTE
+ * (not in the source's range): the one place the caller's channel name goes in.
+ */
+static struct pandora_glink_channel *
+pq_qrtr_channel(void)
+{
+	return pandora_mpss_glink_channel("IPCRTR");
+}
+
+/*
+ * The IPA's host port; the caller fills it in when its QMI handshake comes up, and
+ * pandora_rmtfs_start() publishes it as service 0x31 (:4010). HakiOS's hakios.ipa.c owns it there.
+ * PORTER'S NOTE (not in the source's range): pandora_modem.h declares it, this file stores it.
+ */
+struct pandora_qrtr_port *pandora_ipa_host_port;
+
+/* ---- QRTR: the router's datagrams, and ports of ours (hakios.wifi.c) ------------------------------ */
+
+/*
+ * What goes over the channel: datagrams of Qualcomm's IPC router, each with a header that says
+ * who sends it (a node, a port) and to whom, and of which kind. The control port hears of the
+ * services the modem offers ("new server": a service, an instance, a node, a port), and later
+ * their going. We are node 1 (Linux's default, and what this phone's Android is); the modem says
+ * who it is in what it sends. The interface for the rest of the kernel is sys/hakios.qrtr.h:
+ * the four calls at the end of this section, which the NAS client (hakios.nas.c) and the QMI
+ * helpers (hakios.qmi.c) take.
+ */
+#define PANDORA_QRTR_MAX        8192            /* the most a datagram holds, either way */
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu     /* the control port */
+#define QRTR_FIRST_PORT         0x4000u         /* where Linux begins numbering ports that ask for no number */
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7,
+       QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct pq_header {                            /* version 1, which Linux sends; version 2 is read as well */
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct pq_control_message {
+	uint32_t command;
+	uint32_t words[4];                      /* a server: service, instance, node, port; a client: node, port */
+};
+
+/* struct pandora_qrtr_port (:3082) is in pandora_qrtr.h now, unchanged and field for field: callers
+ * hold the pointer, and pandora_rmtfs.c has to be able to read its first field. */
+
+static LCK_MTX_DECLARE(pq_lock, &pq_grp);    /* the tables below */
+static LCK_MTX_DECLARE(pq_calling, &pq_grp); /* held by the link's thread around a callback */
+static struct pandora_qrtr_port pq_ports[16];
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} pq_servers[64];
+static uint32_t pq_peer;                      /* the modem's node; 0: it has not said */
+static uint32_t pq_next_port = QRTR_FIRST_PORT, pq_in, pq_out, pq_hellos, pq_lookups;
+thread_t pandora_qrtr_link_thread;
+
+/*
+ * The name service's side -- pandora_our_servers[4] (:3106) -- is pandora_our_servers here: the storage is
+ * pandora_rmtfs.c's and the declaration is pandora_modem.h's, because rmtfs_start() (:3995) is what
+ * publishes the four services. The counters beside it (:3108-3109) are pandora_rmtfs.c's too.
+ */
+
+/* One datagram out, of any type. */
+int
+pandora_mpss_qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct pq_header *packet;
+	int error;
+
+	if (length == 0 || length > PANDORA_QRTR_MAX) {
+		return EMSGSIZE;
+	}
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = pandora_mpss_glink_send(pq_qrtr_channel(), packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	pq_out += error == 0;
+	return error;
+}
+
+static bool
+pq_matches(uint32_t service, uint32_t instance, unsigned server)
+{
+	return pq_servers[server].there && pq_servers[server].service == service &&
+	       (instance == 0 || pq_servers[server].instance == instance);
+}
+
+/* Everybody who looked a service up is told that it has come, or gone. From the link's thread. */
+static void
+pq_tell(uint32_t service, uint32_t instance, uint32_t node, uint32_t port, bool arrived)
+{
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			pandora_qrtr_server_t server = NULL;
+			void *context;
+
+			lck_mtx_lock(&pq_lock);
+			if (pq_ports[p].number != 0 && pq_ports[p].lookups[l].asked && !pq_ports[p].lookups[l].fresh &&
+			    pq_ports[p].lookups[l].service == service &&
+			    (pq_ports[p].lookups[l].instance == 0 || pq_ports[p].lookups[l].instance == instance)) {
+				server = pq_ports[p].server;
+			}
+			context = pq_ports[p].context;
+			lck_mtx_unlock(&pq_lock);
+			if (server != NULL) {
+				server(context, arrived, service, instance & 0xff, instance >> 8, node, port);
+			}
+		}
+	}
+}
+
+/* pandora_qrtr_announce() and pandora_qrtr_announce_all() (:3172-3173, bodies at :3955 and :3967) are
+ * pandora_qrtr_announce() and pandora_qrtr_announce_all() here, defined in pandora_rmtfs.c and
+ * declared in pandora_qrtr.h. */
+
+/* The control port's part: Linux's name service, with our one service to tell of. */
+static void
+pq_control(const struct pq_header *header, const struct pq_control_message *control)
+{
+	struct pq_control_message hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (pq_hellos++ != 0) {
+			break;                                  /* (answered once: two that answer every hello never end) */
+		}
+		error = pandora_mpss_qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("mpss: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		pandora_qrtr_announce_all(header->from_node);    /* (the name service's part: what we offer) */
+		break;
+	case QRTR_NEW_SERVER:
+		lck_mtx_lock(&pq_lock);
+		for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]); i++) {
+			if (pq_servers[i].there && pq_servers[i].node == control->words[2] && pq_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!pq_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			pq_servers[found].there = true;
+			pq_servers[found].service = control->words[0];
+			pq_servers[found].instance = control->words[1];
+			pq_servers[found].node = control->words[2];
+			pq_servers[found].port = control->words[3];
+		}
+		lck_mtx_unlock(&pq_lock);
+		printf("mpss: qrtr: a service: %u (%#x), version %u, instance %u, at node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		pq_tell(control->words[0], control->words[1], control->words[2], control->words[3], true);
+		break;
+	case QRTR_DEL_SERVER:
+	case QRTR_BYE:
+		for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]); i++) {
+			bool gone;
+
+			lck_mtx_lock(&pq_lock);
+			gone = pq_servers[i].there && (control->command == QRTR_BYE ? pq_servers[i].node == header->from_node :
+			    pq_servers[i].node == control->words[2] && pq_servers[i].port == control->words[3]);
+			pq_servers[i].there = pq_servers[i].there && !gone;
+			lck_mtx_unlock(&pq_lock);
+			if (gone) {
+				printf("mpss: qrtr: service %u at node %u port %u has gone\n", pq_servers[i].service, pq_servers[i].node,
+				    pq_servers[i].port);
+				pq_tell(pq_servers[i].service, pq_servers[i].instance, pq_servers[i].node, pq_servers[i].port, false);
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP: {
+		/* the modem looks for a service: ours that match, then the empty "new server" that ends the answer */
+		unsigned matches = 0;
+
+		for (unsigned i = 0; i < sizeof(pandora_our_servers) / sizeof(pandora_our_servers[0]); i++) {
+			if (pandora_our_servers[i].port != 0 && (control->words[0] == 0 || pandora_our_servers[i].service == control->words[0]) &&
+			    (control->words[1] == 0 || pandora_our_servers[i].instance == control->words[1])) {
+				pandora_qrtr_announce(header->from_node, i, false);
+				matches++;
+			}
+		}
+		pandora_qrtr_announce(header->from_node, 0, true);
+		if (pq_lookups++ < 16) {
+			printf("mpss: qrtr: the modem looks for service %u (%#x), instance %u: %u of ours\n", control->words[0],
+			    control->words[0], control->words[1], matches);
+		}
+		break;
+	}
+	default:
+		break;                                  /* (a client's going, and what else there is: nothing here wants it) */
+	}
+}
+
+/* A message from the channel: one datagram. From the link's thread. */
+void
+pandora_qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct pq_header header;
+	pandora_qrtr_receive_t receive = NULL;
+	void *context = NULL;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		/* version 2: version, type, flags, a length of options; the size; then four numbers of 16 bits */
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("mpss: qrtr: %u bytes that are no datagram (they begin %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	if (header.size == 0 || at + header.size > length) {
+		printf("mpss: qrtr: a datagram of %u bytes in a message of %u: dropped\n", header.size, length);
+		return;
+	}
+	pq_in++;
+	if (pq_peer == 0) {
+		pq_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;                                 /* (we never ask for one: GLINK's intents hold us back already) */
+	}
+	if (header.confirm) {
+		/* the sender counts what it has sent to this port, and waits for this before it sends many more */
+		struct pq_control_message resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		pandora_mpss_qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct pq_control_message control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		pq_control(&header, &control);
+		return;
+	}
+	lck_mtx_lock(&pq_lock);
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		if (pq_ports[p].number == header.to_port && header.type == QRTR_DATA) {
+			receive = pq_ports[p].receive;
+			context = pq_ports[p].context;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	if (receive != NULL) {
+		receive(context, header.from_node, header.from_port, data + at, header.size);
+	} else if (pq_in <= 64) {
+		printf("mpss: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n", header.size,
+		    header.from_node, header.from_port, header.to_port);
+	}
+}
+
+/* Lookups made since the last look are told of the services that were there before them. From the link's thread. */
+void
+pandora_qrtr_fresh(void)
+{
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			pandora_qrtr_server_t server;
+			uint32_t service, instance;
+			void *context;
+
+			lck_mtx_lock(&pq_lock);
+			if (pq_ports[p].number == 0 || !pq_ports[p].lookups[l].fresh) {
+				lck_mtx_unlock(&pq_lock);
+				continue;
+			}
+			pq_ports[p].lookups[l].fresh = false;
+			server = pq_ports[p].server;
+			service = pq_ports[p].lookups[l].service;
+			instance = pq_ports[p].lookups[l].instance;
+			context = pq_ports[p].context;
+			lck_mtx_unlock(&pq_lock);
+			for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]) && server != NULL; i++) {
+				if (pq_matches(service, instance, i)) {
+					server(context, true, pq_servers[i].service, pq_servers[i].instance & 0xff,
+					    pq_servers[i].instance >> 8, pq_servers[i].node, pq_servers[i].port);
+				}
+			}
+		}
+	}
+}
+
+struct pandora_qrtr_port *
+pandora_qrtr_open(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server, void *context)
+{
+	struct pandora_qrtr_port *port = NULL;
+
+	lck_mtx_lock(&pq_lock);
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]) && port == NULL; p++) {
+		if (pq_ports[p].number == 0) {
+			port = &pq_ports[p];
+			bzero(port, sizeof(*port));
+			port->number = pq_next_port++;
+			port->receive = receive;
+			port->server = server;
+			port->context = context;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	return port;
+}
+
+int
+pandora_mpss_qrtr_send(struct pandora_qrtr_port *port, uint32_t node, uint32_t to, const void *data, size_t length)
+{
+	if (port == NULL || port->number == 0 || length > PANDORA_QRTR_MAX) {
+		return EINVAL;
+	}
+	return pandora_mpss_qrtr_out_packet(QRTR_DATA, port->number, node, to, data, (uint32_t)length);
+}
+
+int
+pandora_qrtr_lookup(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance)
+{
+	int error = ENOSPC;
+
+	lck_mtx_lock(&pq_lock);
+	for (unsigned l = 0; l < 4 && error != 0 && port != NULL && port->number != 0; l++) {
+		if (!port->lookups[l].asked) {
+			port->lookups[l].service = service;
+			port->lookups[l].instance = instance != 0 ? (version & 0xff) | instance << 8 : 0;
+			port->lookups[l].asked = true;
+			port->lookups[l].fresh = true;
+			error = 0;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	return error;
+}
+
+void
+pandora_qrtr_close(struct pandora_qrtr_port *port)
+{
+	struct pq_control_message gone = { .command = QRTR_DEL_CLIENT, .words = { QRTR_US, port ? port->number : 0 } };
+	bool outside = current_thread() != pandora_qrtr_link_thread;
+
+	if (port == NULL || port->number == 0) {
+		return;
+	}
+	if (outside) {
+		lck_mtx_lock(&pq_calling);            /* (a callback of the port's that is running ends first) */
+	}
+	lck_mtx_lock(&pq_lock);
+	port->number = 0;
+	lck_mtx_unlock(&pq_lock);
+	if (outside) {
+		lck_mtx_unlock(&pq_calling);
+	}
+	if (pq_peer != 0 && pq_qrtr_channel() != NULL) {
+		pandora_mpss_qrtr_out_packet(QRTR_DEL_CLIENT, gone.words[1], pq_peer, QRTR_CONTROL, &gone, sizeof(gone));
+	}
+}
+
+static const struct pandora_qrtr_ops qrtr_ops = { .open = pandora_qrtr_open, .send = pandora_mpss_qrtr_send, .lookup = pandora_qrtr_lookup, .close = pandora_qrtr_close };
+
+/* The modem's QRTR for the rest of the kernel: NULL until the link is up (sys/hakios.qrtr.h). */
+const struct pandora_qrtr_ops *
+pandora_mpss_qrtr(void)
+{
+	return pq_qrtr_channel() != NULL ? &qrtr_ops : NULL;
+}
+
+/*
+ * A port's number: its first field (:3083), which rmtfs_start() publishes as the service's port.
+ * PORTER'S NOTE (not in the source's range): a one-line accessor, because pandora_rmtfs.c had to
+ * foward-declare struct pandora_qrtr_port before pandora_qrtr.h existed.
+ */
+uint32_t
+pandora_qrtr_port_number(const struct pandora_qrtr_port *port)
+{
+	return port->number;
+}
+
+/*
+ * ---- deviations from a mechanical rename, quoted ----------------------------------------------
+ *
+ * 1. glink_send() and glink.channel[CHANNEL_QRTR]. (:3135, :3417, :3428)
+ *      error = glink_send(&glink.channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+ *      if (qrtr_peer != 0 && glink.channel[CHANNEL_QRTR].open) {
+ *      return glink.channel[CHANNEL_QRTR].open ? &qrtr_ops : NULL;
+ *    glink is pandora_mpss.c's, so the channel comes from pandora_mpss_glink_channel("IPCRTR") and the
+ *    send becomes pandora_mpss_glink_send(that channel, ...). The source's ".open" test becomes the
+ *    channel being non-NULL.
+ *
+ * 2. struct qrtr_header / struct qrtr_control (:3074, :3077) are struct pq_header /
+ *    struct pq_control_message. PORTER'S NOTE: forced -- qrtr_control() is a function in this block,
+ *    and pandora_rmtfs.c defines its own struct pandora_qrtr_control for the same wire format.
+ *
+ * 3. our_servers[] (:3106) is pandora_our_servers[4]: declared in pandora_modem.h, stored in
+ *    pandora_rmtfs.c (:105), filled in by rmtfs_start() (:3995). The counters beside it
+ *    (rmtfs_requests ... servreg_requests, :3108-3109) stayed with the blocks that use them and are
+ *    pandora_rmtfs.c's as well. The declaration and its comment are the only lines of the range that
+ *    are not here.
+ *
+ * 4. qrtr_announce() and qrtr_announce_all() (:3955, :3967) have bodies OUTSIDE the range but are
+ *    called by qrtr_control() at :3189, :3238 and :3242; they are pandora_rmtfs.c's here (it owns the
+ *    services they announce), declared in pandora_qrtr.h and not copied.
+ *
+ * 5. printf() (:3134, :3155, :3168, :3188, :3214, :3219, :3250) is pandora_say() from pandora_mpss.c.
+ *    No sleep_us(), now_us() or option() call occurs anywhere in 3056-3433, so none is declared.
+ *
+ * 6. mpss_lock_group (:3094-3095) is pq_grp, this file's own group: nothing outside the block touches
+ *    these two mutexes.
+ *
+ * ---- the extern symbols this file leaves undecided --------------------------------------------
+ *
+ * From bsd/dev/pandora_mpss.c (declared at the head of this file):
+ *
+ *   struct pandora_glink_channel;   opaque; HakiOS's struct glink_channel
+ *   pandora_mpss_glink_channel()    the IPCRTR channel, NULL until open
+ *   pandora_mpss_glink_send()       one datagram on it (was static glink_send(), :3004)
+ *   pandora_say()                   printf() in this block (was say(), :131)
+ *
+ * From bsd/dev/pandora_modem.h, either side:
+ *
+ *   pandora_our_servers[4]          the four services we publish (was our_servers[], :3106); storage
+ *                                   in pandora_rmtfs.c
+ *   pandora_ipa_host_port           the IPA's host port, stored here
+ *
+ * From bsd/dev/pandora_rmtfs.c (declared in pandora_qrtr.h):
+ *
+ *   pandora_qrtr_announce()         one of our servers told to a node (:3955)
+ *   pandora_qrtr_announce_all()     all of them that have a port (:3967)
+ *
+ * From the kernel, included above:
+ *
+ *   kalloc_data() kfree_data() Z_WAITOK Z_ZERO          <kern/kalloc.h>
+ *   lck_mtx_lock() lck_mtx_unlock() LCK_GRP_DECLARE LCK_MTX_DECLARE   <kern/locks.h>
+ *   current_thread() thread_t                           <kern/thread.h>
+ *   memcpy() bzero()                                    libkern's, force-included by the build
+ *   EMSGSIZE ENOMEM EINVAL ENOSPC                       <sys/errno.h>
+ *
+ * And this file defines, for the rest of the port:
+ *
+ *   pandora_qrtr_open()             a port of our node and its callbacks (:3356)
+ *   pandora_mpss_qrtr_send()        one QRTR_DATA datagram on a port (:3376)
+ *   pandora_qrtr_lookup()           a service looked up on a port (:3385)
+ *   pandora_qrtr_close()            the port given up, and DEL_CLIENT said if the link is up (:3404)
+ *   pandora_qrtr_port_number()      a port's number, its first field (:3083)
+ *   pandora_mpss_qrtr_out_packet()  one datagram of any type (:3114)
+ *   pandora_qrtr_input()            one message in from the link (:3256)
+ *   pandora_qrtr_fresh()            the lookups made since the last look (:3326)
+ *   pandora_mpss_qrtr()             the ops table, NULL until the channel is open (:3429)
+ *   pandora_qrtr_link_thread        the link thread's thread_t, set by the caller's link thread
+ *                                   (HakiOS :5078) so that close() can tell a call from inside a
+ *                                   callback (:3407) from one outside it
+ */
diff --git a/bsd/dev/pandora_qrtr.h b/bsd/dev/pandora_qrtr.h
new file mode 100644
index 0000000..db426f7
--- /dev/null
+++ b/bsd/dev/pandora_qrtr.h
@@ -0,0 +1,114 @@
+/*
+ * PANDORA QRTR: the port a caller holds, the two callbacks it is given, and the calls the QRTR block
+ * of bsd/dev/pandora_qrtr.c answers.
+ *
+ * The interface half is HakiOS's sys/hakios.qrtr.h one for one and in its order, with hakios_qrtr_*
+ * renamed pandora_qrtr_*: the receive and server callback types, struct pandora_qrtr_ops with its four
+ * commented members, and the four calls it describes. struct pandora_qrtr_port comes with them rather
+ * than beside them -- in HakiOS it is defined in the middle of hakios.mpss.c (:3082), but a caller on
+ * this side has to see its first field. No field was added, dropped or reordered.
+ *
+ * pandora_qrtr.c is the QRTR port itself: pandora_mpss.c feeds it the link's messages and pumps it,
+ * pandora_rmtfs.c and pandora_ipa.c open ports on it.
+ */
+#ifndef _BSD_DEV_PANDORA_QRTR_H_
+#define _BSD_DEV_PANDORA_QRTR_H_
+
+#if defined(PANDORA)
+
+#include <sys/types.h>
+#include <kern/thread.h>
+
+/* ---- the interface (HakiOS sys/hakios.qrtr.h, renamed) ---------------------------------------------- */
+
+struct pandora_qrtr_port;
+
+/*
+ * A datagram arrived at one of our ports: from (node, port), length bytes at data, which is only
+ * valid for the duration of the call.
+ */
+typedef void (*pandora_qrtr_receive_t)(void *context, uint32_t node, uint32_t port, const void *data,
+    size_t length);
+
+/*
+ * A service we looked up came (arrived) or went: service, and the version and instance as the wire
+ * has them, at (node, port).
+ */
+typedef void (*pandora_qrtr_server_t)(void *context, bool arrived, uint32_t service, uint32_t version,
+    uint32_t instance, uint32_t node, uint32_t port);
+
+/*
+ * The QRTR port, as HakiOS defines it at hakios.mpss.c:3082 with no field changed: number is 0 when the
+ * port is free, the table is sixteen of these (pq_ports), and the number is what a service is
+ * published under. Opaque to everything but pandora_qrtr.c, but for the number.
+ */
+struct pandora_qrtr_port {
+	uint32_t number;                        /* 0: free */
+	pandora_qrtr_receive_t receive;         /* a datagram arrived at this port */
+	pandora_qrtr_server_t server;           /* a lookup of ours got an answer */
+	void *context;
+	struct {
+		uint32_t service, instance;     /* the instance as on the wire: version | instance << 8; 0: any */
+		bool asked;
+		bool fresh;                     /* not yet told of the services that were there before it */
+	} lookups[4];
+};
+
+struct pandora_qrtr_ops {
+	/* A port of our node, with these callbacks; NULL when the table is full. */
+	struct pandora_qrtr_port * (*open)(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server,
+	    void *context);
+	/* One datagram to (node, port) on this port; 0, or an errno. */
+	int (*send)(struct pandora_qrtr_port *port, uint32_t node, uint32_t to_port, const void *data,
+	    size_t length);
+	/* Have this port told of a service, from now on and of those already there; 0, or an errno. */
+	int (*lookup)(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance);
+	/* Give the port up: no callback comes after this returns. */
+	void (*close)(struct pandora_qrtr_port *port);
+};
+
+/*
+ * The same four calls for callers that hold the port rather than the table. pandora_qrtr.c defines
+ * them all; pandora_mpss_qrtr() is the table, NULL until the link's IPCRTR channel is open.
+ */
+struct pandora_qrtr_port *pandora_qrtr_open(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server,
+    void *context);
+int pandora_mpss_qrtr_send(struct pandora_qrtr_port *port, uint32_t node, uint32_t to, const void *data,
+    size_t length);
+int pandora_qrtr_lookup(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance);
+void pandora_qrtr_close(struct pandora_qrtr_port *port);
+
+/* A port's number: its first field, for callers that publish a service on it (:3083). */
+uint32_t pandora_qrtr_port_number(const struct pandora_qrtr_port *port);
+
+/* One datagram of any type, the control port's included (:3114). */
+int pandora_mpss_qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port,
+    const void *data, uint32_t length);
+
+/* The link's side: one message in (:3256), and the lookups made since the last look (:3326). */
+void pandora_qrtr_input(const uint8_t *data, uint32_t length);
+void pandora_qrtr_fresh(void);
+
+/* The table, or NULL until the channel is open (:3429). */
+const struct pandora_qrtr_ops *pandora_mpss_qrtr(void);
+
+/*
+ * The link thread's thread_t, which the caller's link thread sets (HakiOS hakios.mpss.c:5078) so that
+ * pandora_qrtr_close() can tell a call from inside a callback (:3407) from one outside it.
+ */
+extern thread_t pandora_qrtr_link_thread;
+
+/* ---- what this file takes from the rest of the modem stack ------------------------------------------ */
+
+/*
+ * Our services announced to a node on the control port: one of pandora_our_servers[] (pandora_modem.h,
+ * stored in pandora_rmtfs.c), or, with end, the empty "new server" that ends an answer to a lookup.
+ * HakiOS's qrtr_announce() and qrtr_announce_all() (:3955, :3967), which bsd/dev/pandora_rmtfs.c
+ * defines here because it owns the services they announce.
+ */
+void pandora_qrtr_announce(uint32_t node, unsigned server, bool end);
+void pandora_qrtr_announce_all(uint32_t node);
+
+#endif /* PANDORA */
+
+#endif /* _BSD_DEV_PANDORA_QRTR_H_ */
diff --git a/bsd/dev/pandora_rmtfs.c b/bsd/dev/pandora_rmtfs.c
new file mode 100644
index 0000000..59b11cf
--- /dev/null
+++ b/bsd/dev/pandora_rmtfs.c
@@ -0,0 +1,1373 @@
+/*
+ * PANDORA: the modem's file systems for SM8850 "canoe" -- RMTFS, TFTP over QRTR, and the service
+ * registry's locator (pd-mapper).
+ *
+ * This is one self-contained block of HakiOS's hakios.mpss.c, mechanically ported:
+ *
+ *   upstream-fetch/hakios/drivers/modem/hakios.mpss.c lines ~3490 - ~4700
+ *     rmtfs_load, rmtfs_buffer_make, rmtfs_share, qmi_tlv, rmtfs_receive, qrtr_announce,
+ *     qrtr_announce_all, rmtfs_start, rmtfs_stop, tftp_error, tftp_transfer_end,
+ *     tftp_send_window, tftp_transfer_receive, tftp_file_of, tftp_receive, jsn_string,
+ *     servreg_load, servreg_receive, with their structs, globals and constants.
+ *
+ * (The source block also forward-declares tftp_receive and servreg_receive, and reaches into the
+ * IPA handshake's ipa_qmi_start/ipa_qmi_stop/ipa_host_port, which stay where they are; see the
+ * "declared, not copied" list below.)
+ *
+ * What changed, and only this:
+ *
+ *   1. Every rmtfs_*, tftp_*, servreg_*, qmi_tlv, jsn_string and qrtr_announce* identifier, and
+ *      every constant in the block, carries the pandora_/PANDORA_ prefix, so the block can be
+ *      linked beside pandora_mpss.c and the other bsd/dev/qcom code.
+ *   2. THE ONE LOGIC CHANGE -- the buffer's physical address. HakiOS's
+ *
+ *          #define RMTFS_BUFFER_PA_DEFAULT 0x9c700000ull
+ *
+ *      is a window into Redwood's reserved-memory cdsp@9c700000, and THAT REGION DOES NOT EXIST
+ *      ON CANOE. Canoe reserves cdsp_region@9b500000+0x1900000 instead, and canoe's own
+ *      /soc/qcom,rmtfs_sharedmem@0 node carries reg = <0x0 0x400000>, a placeholder that the
+ *      bootloader patches at boot -- not a usable address in a local DTB. The driver relocates
+ *      that node at boot, so the address must be an input, never a constant. On the observed
+ *      device the live region is at 0xd3900000, size 0x400000, as /sys/class/uio/uio0/maps/map0
+ *      reports it. Therefore:
+ *
+ *          modem_buffer       physical address of the buffer            REQUIRED
+ *          modem_buffer_size  its size, default 0x400000 (4 MiB)        optional
+ *
+ *      With no modem_buffer the buffer is never mapped, the share call prints a diagnostic and
+ *      returns false, and TrustZone is never handed a phantom range. Everything downstream
+ *      (ALLOC_BUFF, the RW_IOVEC bounds check, page->size) uses the boot-arg size, so 4 MiB and
+ *      HakiOS's 2.5 MiB both work as long as the size matches what the modem asks for.
+ *      The substituted code is pandora_rmtfs_buffer_make() and the guard at the top of
+ *      pandora_rmtfs_share(); both are marked "CANOE".
+ *   3. Functions that pandora_mpss.c calls from its step machine are no longer static (see
+ *      "exported" below), and the counters link_stop() prints are defined here.
+ *
+ * Everything else is byte-identical: the same QMI answer layout, the same QRTR announcement and
+ * lookup-terminator behaviour, the same TFTP option parsing and OACK order, the same servreg TLV
+ * build, the same tabs and the same comments. The log lines keep their "mpss:" prefix so this
+ * file diffs cleanly against the source it came from.
+ *
+ * Not here, on purpose (declared as extern, not copied):
+ *
+ *   struct pandora_qrtr_port          the QRTR port (pandora_qrtr.h -- that header does not exist
+ *                                     in the tree yet, so the struct is forward-declared below)
+ *   pandora_mpss_qrtr_send()          qrtr_send(): one datagram to (node, port)
+ *   pandora_qrtr_open/close()         qrtr_open()/qrtr_close()
+ *   pandora_mpss_qrtr_out_packet()    qrtr_out_packet(): a control-port datagram
+ *   pandora_our_servers[4]            our_servers[4] of hakios.mpss.c:3106, which the control port
+ *                                     answers lookups from
+ *   pandora_step, pandora_option, pandora_say, pandora_tell, pandora_announce, pandora_settle,
+ *   pandora_sleep_ms, pandora_scm, pandora_root_file, pandora_ufs_read_partition,
+ *   pandora_ipa_qmi_start/stop, pandora_ipa_host_port
+ *                                     the step machine, the logging, the SCM call primitive, the
+ *                                     firmware reader and the loader's UFS reader, all of which
+ *                                     live in pandora_mpss.c / pandora_adsp.c
+ *
+ * Exported for pandora_mpss.c's steps (in HakiOS these were static because it was one file):
+ *
+ *   pandora_rmtfs_load()            step 2  (hakios.mpss.c:1171 declaration, :3586 definition)
+ *   pandora_servreg_load()          step 2  (hakios.mpss.c:1172, :4557)
+ *   pandora_rmtfs_buffer_make()     step 7  (hakios.mpss.c:3632, called at :2448)
+ *   pandora_rmtfs_share()           step 7  (hakios.mpss.c:3659, called at :2448)
+ *   pandora_rmtfs_start()           step 9  (hakios.mpss.c:3987, called at :252)
+ *   pandora_rmtfs_stop()            shutdown (:4025)
+ *   pandora_qrtr_announce()
+ *   pandora_qrtr_announce_all()     the control port's NEW_SERVER path (:3955, :3969)
+ */
+#if defined(PANDORA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/memory_types.h>
+#include <mach/vm_statistics.h>
+#include <libkern/libkern.h>
+#include "pandora_modem.h"
+#include "pandora_part.h"
+
+/* ---- the kernel's own facilities, as hakios.mpss.c declares them (:85-94) ---------------------------- */
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);
+
+/* ---- declared, not copied: what lives elsewhere in pandora_mpss.c ------------------------------------ */
+
+/*
+ * The QRTR port. hakios.mpss.c's struct hakios_qrtr_port (:3082) comes from sys/hakios.qrtr.h; on
+ * this side it would be pandora_qrtr.h, which the build tree does not carry yet -- so it is
+ * forward-declared, and only the calls below are made through it. When pandora_qrtr.h lands,
+ * replace this forward declaration with the #include and delete these externs' prototypes in
+ * favour of its own.
+ */
+struct pandora_qrtr_port;
+
+/* qrtr_open(): a port of our node, and its callbacks (hakios.mpss.c:3356). */
+extern struct pandora_qrtr_port *pandora_qrtr_open(void (*receive)(void *, uint32_t, uint32_t, const void *, size_t),
+    void (*server)(void *, bool, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t), void *context);
+/* qrtr_send(): one datagram to (node, port); 0, or an errno (:3376). */
+extern int pandora_mpss_qrtr_send(struct pandora_qrtr_port *port, uint32_t node, uint32_t to, const void *data,
+    size_t length);
+/* qrtr_close(): no callback comes after this has returned (:3404). */
+extern void pandora_qrtr_close(struct pandora_qrtr_port *port);
+/*
+ * A port's number -- its first field, `uint32_t number` (:3083), which rmtfs_start() publishes as
+ * the service's port. The struct is incomplete in this file, so the field cannot be read through
+ * it, and this is the only member this block touches. When pandora_qrtr.h lands: replace the four
+ * calls below with `port->number` and delete this.
+ */
+extern uint32_t pandora_qrtr_port_number(const struct pandora_qrtr_port *port);
+/* qrtr_out_packet(): one datagram of any type, the control port's included (:3114). */
+extern int pandora_mpss_qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port,
+    const void *data, uint32_t length);
+
+/* QRTR's wire constants (:3067-3073); the names collided with pandora_qrtr.h's, so they are prefixed. */
+#define PANDORA_QRTR_US                 1u
+#define PANDORA_QRTR_CONTROL            0xfffffffeu     /* the control port */
+#define PANDORA_QRTR_NEW_SERVER         4               /* enum QRTR_NEW_SERVER */
+
+/* struct qrtr_control (:3077): a control-port message's command and its four words. */
+struct pandora_qrtr_control {
+	uint32_t command;
+	uint32_t words[4];                      /* a server: service, instance, node, port */
+};
+
+/* our_servers[4] of hakios.mpss.c:3106: the services we publish, told of on hello and on lookup.
+ * struct pandora_our_server and the array are declared in pandora_modem.h, because the control-port
+ * handler in pandora_qrtr.c reads them too; the storage is here. */
+struct pandora_our_server pandora_our_servers[4];
+
+/* The step counter, option(), say()/tell()/announce(), settle(), the SCM call, the firmware read and
+ * the raw partition read: defined in bsd/dev/pandora_mpss.c, declared in pandora_modem.h. */
+
+/* (mpss.c's #define printf say, :180: the plain log; pandora_tell() goes to the loader's as well) */
+#define printf pandora_say
+
+/* ---- the modem's file systems: RMTFS, a service of ours on QRTR ----------------------------------- */
+
+/*
+ * The modem keeps its own files -- its settings, its calibration, what it has learnt of the
+ * networks -- on four partitions of the phone's storage, which it cannot reach itself: the
+ * application processor reads and writes them for it, through QMI service 14, "RMTFS" (Linux:
+ * github.com/linux-msm/rmtfs, which this follows). Until that service is there the modem offers
+ * nothing beyond SSCTL and its service registry (service 43 and 66: what the first run saw), and
+ * waits. The modem opens a file by path (/boot/modem_fs1 and so on), asks for a buffer (2.5 MB
+ * of memory both can reach: dt qcom,rmtfs_sharedmem@0; TrustZone is asked to let the modem into
+ * it, as Linux's rmtfs_mem and Android's sharedmem do, and out again when it is shut down), and
+ * then reads and writes sectors of 512 bytes through that buffer.
+ *
+ * Here the four partitions are read whole into memory of ours when the steps begin (the phone's
+ * storage through the loader, hakios.ufs.c: ufs=2, which the ordinary run has), the modem is
+ * served out of that, and what it writes goes into that memory and no further: the storage is
+ * not written. The modem is content with that for a run; what it would have saved is lost when
+ * the run ends, as the next run reads the partitions afresh.
+ *
+ * QRTR's name service is the application processor's job as well (Linux: net/qrtr/ns.c): the
+ * modem is told of our service when it says hello and when it looks for one, with an empty
+ * "new server" to end an answer to a lookup, as Linux ends it.
+ */
+#define PANDORA_RMTFS_SERVICE           14
+#define PANDORA_RMTFS_VERSION           1
+#define PANDORA_RMTFS_INSTANCE          0
+#define PANDORA_RMTFS_SECTOR            512
+/*
+ * canoe: the size is an input now (boot-arg modem_buffer_size), and its default is the size canoe's
+ * rmtfs_sharedmem@0 node claims and the observed device's live region has: 4 MiB, not HakiOS's
+ * 0x280000. Both work; what matters is that it matches what the modem asks for in ALLOC_BUFF.
+ */
+#define PANDORA_RMTFS_BUFFER_SIZE_DEFAULT 0x400000u
+#define PANDORA_RMTFS_BUFFER_SIZE_MAX   0x10000000u     /* (a mistyped boot argument must not zero 4 GB) */
+#define PANDORA_RMTFS_OPEN              1
+#define PANDORA_RMTFS_CLOSE             2
+#define PANDORA_RMTFS_RW_IOVEC          3
+#define PANDORA_RMTFS_ALLOC_BUFF        4
+#define PANDORA_RMTFS_GET_DEV_ERROR     5
+#define PANDORA_QMI_REQUEST             0
+#define PANDORA_QMI_RESPONSE            2
+#define PANDORA_QMI_RESULT_FAILURE      1
+#define PANDORA_QMI_ERR_INTERNAL        1
+#define PANDORA_QMI_ERR_MALFORMED       2
+/* PANDORA_SCM_MP_ASSIGN, PANDORA_SCM_ASSIGN_ARGUMENTS, PANDORA_VMID_HLOS and
+ * PANDORA_VMID_MSS_MSA come from pandora_modem.h, which pandora_mpss.c defines along with the
+ * call itself. */
+#define PANDORA_VMID_NAV                0x2b            /* the modem's navigation side; dt: qcom,vm-nav-path of qcom,rmtfs_sharedmem@0 */
+#define PANDORA_VM_PERM_RW              6
+
+static struct {
+	const char *path, *partition;
+	uint8_t *data;
+	uint64_t size;
+	bool open;
+} pandora_rmtfs_files[4] = {
+	{ "/boot/modem_fs1", "modemst1", NULL, 0, false },
+	{ "/boot/modem_fs2", "modemst2", NULL, 0, false },
+	{ "/boot/modem_fsc", "fsc",      NULL, 0, false },
+	{ "/boot/modem_fsg", "fsg",      NULL, 0, false },
+};
+static struct pandora_qrtr_port *pandora_rmtfs_port;
+static vm_offset_t pandora_rmtfs_buffer;        /* the buffer, as this kernel sees it; 0: none yet */
+static volatile uint8_t *pandora_rmtfs_window;  /* ... and the uncached one it is used through */
+static uint64_t pandora_rmtfs_buffer_pa;
+static uint32_t pandora_rmtfs_buffer_size = PANDORA_RMTFS_BUFFER_SIZE_DEFAULT;  /* boot-arg modem_buffer_size */
+static bool pandora_rmtfs_shared;               /* the modem has been let into it */
+
+/* The counters link_stop() prints (hakios.mpss.c:3500-3504); its summary asks for these by name. */
+uint32_t pandora_rmtfs_requests, pandora_rmtfs_reads, pandora_rmtfs_writes, pandora_rmtfs_sectors_read,
+    pandora_rmtfs_sectors_written, pandora_rmtfs_refused;
+uint32_t pandora_tftp_requests, pandora_tftp_served, pandora_tftp_refused, pandora_servreg_requests;
+
+unsigned
+pandora_rmtfs_load(void)
+{
+	unsigned loaded = 0;
+
+	for (unsigned f = 0; f < 4; f++) {
+		uint64_t size = 0;
+		int error = pandora_ufs_read_partition(pandora_rmtfs_files[f].partition, 0, NULL, 0, &size);
+
+		if (error != 0 || size == 0 || size > (64u << 20)) {
+			printf("mpss: %u: the partition %s: %s (%d)\n", pandora_step, pandora_rmtfs_files[f].partition,
+			    error == ENXIO ? "no storage to read it from (the loader was not asked for ufs=2)" : "not read", error);
+			continue;
+		}
+		if (pandora_rmtfs_files[f].data == NULL || pandora_rmtfs_files[f].size != size) {
+			if (pandora_rmtfs_files[f].data != NULL) {
+				kfree_data(pandora_rmtfs_files[f].data, pandora_rmtfs_files[f].size);
+			}
+			pandora_rmtfs_files[f].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+			pandora_rmtfs_files[f].size = pandora_rmtfs_files[f].data == NULL ? 0 : size;
+		}
+		if (pandora_rmtfs_files[f].data == NULL) {
+			printf("mpss: %u: no memory for %s (%llu bytes)\n", pandora_step, pandora_rmtfs_files[f].partition, size);
+			continue;
+		}
+		error = pandora_ufs_read_partition(pandora_rmtfs_files[f].partition, 0, pandora_rmtfs_files[f].data, size, NULL);
+		if (error != 0) {
+			printf("mpss: %u: the partition %s: read error %d\n", pandora_step, pandora_rmtfs_files[f].partition, error);
+			continue;
+		}
+		printf("mpss: %u: the partition %s (%s): %llu bytes read into memory of ours\n", pandora_step,
+		    pandora_rmtfs_files[f].partition, pandora_rmtfs_files[f].path, size);
+		loaded++;
+	}
+	return loaded;
+}
+
+/*
+ * The buffer, once. The modem's requests carry addresses of 32 bits, so it has to be below 4 GB,
+ * and the kernel's free memory there is not to be had in one piece of MBs; so it is a region the
+ * bootloader has already reserved for it and that nothing of ours uses.
+ *
+ * CANOE -- the port's one logic change. HakiOS took the first 2.5 MB of the memory reserved for
+ * the compute DSP (dt: reserved-memory cdsp@9c700000, 30 MB, no-map) and hardcoded it as
+ *
+ *      #define RMTFS_BUFFER_PA_DEFAULT 0x9c700000ull
+ *
+ * That window is Redwood's and DOES NOT EXIST on canoe (canoe reserves cdsp_region@9b500000 +
+ * 0x1900000 instead). Canoe's own /soc/qcom,rmtfs_sharedmem@0 node is reg = <0x0 0x400000> -- a
+ * placeholder the bootloader patches, so even the deployed DTB does not carry a usable address
+ * until the relocating driver has run. On the observed device the live region is
+ * 0xd3900000 + 0x400000, as /sys/class/uio/uio0/maps/map0 reports it. So the address is required
+ * from the boot arguments and there is no default:
+ *
+ *      modem_buffer        0xd3900000      REQUIRED, physical, page-aligned
+ *      modem_buffer_size   0x400000        default 0x400000 (4 MiB), a multiple of 8
+ *
+ * Without modem_buffer nothing is mapped, the diagnostic below says so, and pandora_rmtfs_share()
+ * refuses -- TrustZone is never handed a range that is not memory.
+ */
+bool
+pandora_rmtfs_buffer_make(void)
+{
+	uint64_t pa = 0;
+	uint32_t size = PANDORA_RMTFS_BUFFER_SIZE_DEFAULT;
+
+	if (pandora_rmtfs_window != NULL) {
+		return true;
+	}
+	if (!PE_parse_boot_argn("modem_buffer", &pa, sizeof(pa)) || pa == 0) {
+		printf("mpss: %u: THE MODEM GETS NO BUFFER: no boot-arg modem_buffer=<physical address>. Canoe's "
+		    "rmtfs_sharedmem@0 reg is a bootloader placeholder (Redwood's cdsp window 0x9c700000 is not "
+		    "memory here), so the address must be given: the live region is what "
+		    "/sys/class/uio/uio0/maps/map0 calls rmtfs (observed: 0xd3900000, 0x400000)\n", pandora_step);
+		return false;
+	}
+	(void)PE_parse_boot_argn("modem_buffer_size", &size, sizeof(size));   /* (optional: 4 MiB by default) */
+	if ((pa & PAGE_MASK) != 0 || size < PAGE_SIZE || (size & 7) != 0 || size > PANDORA_RMTFS_BUFFER_SIZE_MAX) {
+		printf("mpss: %u: THE MODEM GETS NO BUFFER: modem_buffer=%#llx modem_buffer_size=%#x is not a page-aligned "
+		    "region of whole words (%u bytes at most)\n", pandora_step, pa, size, PANDORA_RMTFS_BUFFER_SIZE_MAX);
+		return false;
+	}
+	pandora_rmtfs_buffer_pa = pa;
+	pandora_rmtfs_buffer_size = size;
+	pandora_rmtfs_window = (volatile uint8_t *)ml_io_map_unmappable((vm_offset_t)pandora_rmtfs_buffer_pa,
+	    pandora_rmtfs_buffer_size, VM_WIMG_WCOMB);
+	if (pandora_rmtfs_window == NULL) {
+		printf("mpss: %u: the modem's buffer at %#llx cannot be mapped\n", pandora_step, pandora_rmtfs_buffer_pa);
+		return false;
+	}
+	pandora_rmtfs_buffer = (vm_offset_t)pandora_rmtfs_window;
+	for (uint32_t i = 0; i < pandora_rmtfs_buffer_size; i += 8) {
+		*(volatile uint64_t *)(pandora_rmtfs_window + i) = 0;
+	}
+	pandora_settle();
+	printf("mpss: %u: the modem's buffer: %u bytes at %#llx (boot-arg modem_buffer / modem_buffer_size)\n",
+	    pandora_step, pandora_rmtfs_buffer_size, pandora_rmtfs_buffer_pa);
+	return true;
+}
+
+/*
+ * TrustZone asked to let the modem into the buffer (Linux's qcom_scm_assign_mem(): the memory, who
+ * has it now, who is to have it and how), or, with `in` false, out of it again.
+ */
+bool
+pandora_rmtfs_share(bool in)
+{
+	struct {
+		uint64_t address, size;                 /* +0: the memory */
+		uint64_t pad0[6];
+		uint32_t sources[3];                    /* +64: who has it */
+		uint32_t pad1[13];
+		struct {                                /* +128: who is to have it */
+			uint32_t vmid, permission;
+			uint64_t context;
+			uint32_t context_size, unused;
+		} destinations[3];
+		uint8_t pad2[40];
+		uint64_t more[7];                       /* +240: the arguments beyond the registers */
+	} *page;
+	vm_offset_t memory = 0;
+	uint64_t answer = ~0ull, pa;
+	unsigned sources, destinations;
+	int32_t result;
+
+	/*
+	 * CANOE: with no buffer there is nothing to assign, and saying so is the point of the change --
+	 * a false returned in silence here reads, in a log, exactly like a TrustZone refusal.
+	 */
+	if (pandora_rmtfs_buffer == 0 || pandora_rmtfs_window == NULL) {
+		printf("mpss: %u: TRUSTZONE IS NOT ASKED TO %s: the modem's buffer has not been made (no boot-arg "
+		    "modem_buffer=<physical address>); RMTFS cannot serve its files\n", pandora_step,
+		    in ? "TAKE THE BUFFER IN" : "GIVE THE BUFFER BACK");
+		return false;
+	}
+	if (pandora_rmtfs_shared == in) {
+		return true;
+	}
+	if (kmem_alloc(kernel_map, &memory, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		return false;
+	}
+	page = (void *)memory;
+	page->address = pandora_rmtfs_buffer_pa;
+	page->size = pandora_rmtfs_buffer_size;
+	if (in) {
+		page->sources[0] = PANDORA_VMID_HLOS;
+		sources = 1;
+		page->destinations[0].vmid = PANDORA_VMID_HLOS;
+		page->destinations[0].permission = PANDORA_VM_PERM_RW;
+		page->destinations[1].vmid = PANDORA_VMID_MSS_MSA;
+		page->destinations[1].permission = PANDORA_VM_PERM_RW;
+		page->destinations[2].vmid = PANDORA_VMID_NAV;
+		page->destinations[2].permission = PANDORA_VM_PERM_RW;
+		destinations = pandora_option("modem_no_nav") ? 2 : 3;
+	} else {
+		page->sources[0] = PANDORA_VMID_HLOS;
+		page->sources[1] = PANDORA_VMID_MSS_MSA;
+		page->sources[2] = PANDORA_VMID_NAV;
+		sources = pandora_option("modem_no_nav") ? 2 : 3;
+		page->destinations[0].vmid = PANDORA_VMID_HLOS;
+		page->destinations[0].permission = PANDORA_VM_PERM_RW;
+		destinations = 1;
+	}
+	pa = kvtophys(memory);
+	page->more[0] = sources * 4;                                    /* argument 3: the size of the sources */
+	page->more[1] = pa + 128;                                       /* 4: the destinations */
+	page->more[2] = destinations * sizeof(page->destinations[0]);   /* 5: their size */
+	page->more[3] = 0;                                              /* 6: spare */
+	for (vm_offset_t line = memory; line < memory + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	pandora_settle();
+	pandora_announce(in ? "ask TrustZone to let the modem into our buffer for its files (the memory assigned to HLOS and MSS, both "
+	    "read and write)" : "ask TrustZone to take the buffer back from the modem (assigned to HLOS alone)");
+	result = pandora_scm(in ? "to share the buffer with the modem" : "to take the buffer back", PANDORA_SCM_MP_ASSIGN,
+	    PANDORA_SCM_ASSIGN_ARGUMENTS, pa, 16, pa + 64, pa + 240, &answer);
+	kmem_free(kernel_map, memory, PAGE_SIZE);
+	if (result != 0 || answer != 0) {
+		printf("mpss: %u: TRUSTZONE DOES NOT %s: the call returns %d, its answer is %#llx\n", pandora_step, in ? "SHARE THE BUFFER" :
+		    "TAKE THE BUFFER BACK", result, answer);
+		return false;
+	}
+	pandora_rmtfs_shared = in;
+	printf("mpss: %u: %s\n", pandora_step, in ? "THE MODEM MAY USE THE BUFFER" : "the buffer is ours alone again");
+	if (in && pandora_option("modem_share_test")) {
+		/* (an experiment: is the buffer still ours to write, now that it is shared? said aloud before and after) */
+		pandora_tell("mpss: %u: about to write a word into the shared buffer at %#llx, and read it back\n", pandora_step,
+		    pandora_rmtfs_buffer_pa + 0x200);
+		*(volatile uint32_t *)(pandora_rmtfs_window + 0x200) = 0x52545346;
+		pandora_settle();
+		pandora_tell("mpss: %u: the shared buffer takes our write: it reads %#x\n", pandora_step,
+		    *(volatile uint32_t *)(pandora_rmtfs_window + 0x200));
+	}
+	return true;
+}
+
+/* A TLV of a QMI message: its value and length, or NULL. */
+static const uint8_t *
+pandora_qmi_tlv(const uint8_t *m, size_t length, uint8_t type, uint16_t *size)
+{
+	for (size_t at = 7; at + 3 <= length;) {
+		uint16_t n = (uint16_t)(m[at + 1] | m[at + 2] << 8);
+
+		if (at + 3 + n > length) {
+			return NULL;
+		}
+		if (m[at] == type) {
+			*size = n;
+			return m + at + 3;
+		}
+		at += 3 + n;
+	}
+	return NULL;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)(p[0] | p[1] << 8 | p[2] << 16 | p[3] << 24);
+}
+
+/* The modem's request for its files: answered, the one TLV the answer carries besides the result made here. From the link's thread. */
+static void
+pandora_rmtfs_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[64], *tlv;
+	uint16_t message, size = 0, result = 0, error = 0, extra = 0;
+	unsigned file = 4;
+
+	if (length < 7 || m[0] != PANDORA_QMI_REQUEST) {
+		return;
+	}
+	message = (uint16_t)(m[3] | m[4] << 8);
+	pandora_rmtfs_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = PANDORA_QMI_RESPONSE;
+	answer[1] = m[1];
+	answer[2] = m[2];
+	answer[3] = m[3];
+	answer[4] = m[4];
+	tlv = answer + 7 + 7;                   /* (the result TLV, 7 bytes, comes first) */
+	switch (message) {
+	case PANDORA_RMTFS_OPEN:
+		/* (the path: the TLV's value is the string itself, with no length in front -- the modem sends it so) */
+		value = pandora_qmi_tlv(m, length, 1, &size);
+		for (unsigned f = 0; value != NULL && f < 4; f++) {
+			if (size == strlen(pandora_rmtfs_files[f].path) && memcmp(value, pandora_rmtfs_files[f].path, size) == 0) {
+				file = f;
+			}
+		}
+		if (file == 4 || pandora_rmtfs_files[file].data == NULL) {
+			printf("mpss: rmtfs: the modem opens \"%.*s\": NOT HERE\n", value != NULL ? (int)(size < 64 ? size : 64) : 0,
+			    value != NULL ? (const char *)value : "");
+			result = PANDORA_QMI_RESULT_FAILURE;
+			error = PANDORA_QMI_ERR_INTERNAL;
+			pandora_rmtfs_refused++;
+			break;
+		}
+		pandora_rmtfs_files[file].open = true;
+		printf("mpss: rmtfs: the modem opens %s (%s, %llu bytes): caller %u\n", pandora_rmtfs_files[file].path,
+		    pandora_rmtfs_files[file].partition, pandora_rmtfs_files[file].size, file + 1);
+		tlv[0] = 0x10;                  /* the caller's id: the file's number plus one */
+		tlv[1] = 4;
+		tlv[2] = 0;
+		tlv[3] = (uint8_t)(file + 1);
+		extra = 7;
+		break;
+	case PANDORA_RMTFS_CLOSE:
+		value = pandora_qmi_tlv(m, length, 1, &size);
+		file = value != NULL && size == 4 && le32(value) >= 1 && le32(value) <= 4 ? le32(value) - 1 : 4;
+		if (file < 4) {
+			pandora_rmtfs_files[file].open = false;
+			printf("mpss: rmtfs: the modem closes %s\n", pandora_rmtfs_files[file].path);
+		}
+		break;
+	case PANDORA_RMTFS_ALLOC_BUFF:
+		value = pandora_qmi_tlv(m, length, 2, &size);
+		if (value == NULL || size != 4 || le32(value) > pandora_rmtfs_buffer_size || pandora_rmtfs_buffer == 0 ||
+		    !pandora_rmtfs_shared) {
+			printf("mpss: rmtfs: the modem asks for a buffer of %u bytes: NOT GIVEN (ours is %u, %s)\n", value != NULL && size == 4 ?
+			    le32(value) : 0, pandora_rmtfs_buffer_size, pandora_rmtfs_shared ? "shared" : "NOT SHARED");
+			result = PANDORA_QMI_RESULT_FAILURE;
+			error = PANDORA_QMI_ERR_INTERNAL;
+			pandora_rmtfs_refused++;
+			break;
+		}
+		pandora_tell("mpss: rmtfs: the modem asks for a buffer of %u bytes: given ours at %#llx\n", le32(value),
+		    pandora_rmtfs_buffer_pa);
+		tlv[0] = 0x10;
+		tlv[1] = 8;
+		tlv[2] = 0;
+		for (unsigned b = 0; b < 8; b++) {
+			tlv[3 + b] = (uint8_t)(pandora_rmtfs_buffer_pa >> (8 * b));
+		}
+		extra = 11;
+		break;
+	case PANDORA_RMTFS_RW_IOVEC: {
+		const uint8_t *direction = pandora_qmi_tlv(m, length, 2, &size), *entries;
+		uint16_t direction_size = size, entries_size = 0;
+		bool write;
+		unsigned count;
+
+		value = pandora_qmi_tlv(m, length, 1, &size);
+		entries = pandora_qmi_tlv(m, length, 3, &entries_size);
+		file = value != NULL && size == 4 && le32(value) >= 1 && le32(value) <= 4 ? le32(value) - 1 : 4;
+		if (file == 4 || !pandora_rmtfs_files[file].open || direction == NULL || direction_size != 1 || entries == NULL ||
+		    entries_size < 1 || entries_size != 1 + 12 * entries[0] || pandora_rmtfs_window == NULL) {
+			result = PANDORA_QMI_RESULT_FAILURE;
+			error = PANDORA_QMI_ERR_MALFORMED;
+			pandora_rmtfs_refused++;
+			break;
+		}
+		write = direction[0] != 0;
+		count = entries[0];
+		{
+			/* (an experiment: the first request waited on, said aloud before and after, for the log to catch what follows) */
+			static bool first = true;
+			uint32_t delay = 0;
+
+			if (first && PE_parse_boot_argn("modem_rmtfs_delay", &delay, sizeof(delay)) && delay != 0) {
+				pandora_tell("mpss: rmtfs: the modem's first request (%s %u pieces of %s, from sector %u, %u sectors, to %#x): waiting %u s "
+				    "before it is served\n", write ? "write" : "read", count, pandora_rmtfs_files[file].partition,
+				    le32(entries + 1), le32(entries + 9), le32(entries + 5), delay);
+				for (uint32_t ms = 0; ms < delay * 1000; ms++) {
+					pandora_sleep_ms(1);
+				}
+				pandora_tell("mpss: rmtfs: serving it now\n");
+			}
+			first = false;
+		}
+		if (pandora_option("modem_rmtfs_rw_off")) {
+			/* (an experiment: the modem is told no, and the buffer is not touched from here) */
+			printf("mpss: rmtfs: the modem %s %u pieces of %s: REFUSED (modem_rmtfs_rw_off)\n", write ? "writes" : "reads", count,
+			    pandora_rmtfs_files[file].partition);
+			result = PANDORA_QMI_RESULT_FAILURE;
+			error = PANDORA_QMI_ERR_INTERNAL;
+			pandora_rmtfs_refused++;
+			break;
+		}
+		for (unsigned e = 0; e < count && result == 0; e++) {
+			uint64_t sector = le32(entries + 1 + 12 * e), physical = le32(entries + 5 + 12 * e), sectors = le32(entries + 9 + 12 * e);
+			uint64_t bytes = sectors * PANDORA_RMTFS_SECTOR;
+
+			if (physical < pandora_rmtfs_buffer_pa || physical - pandora_rmtfs_buffer_pa + bytes > pandora_rmtfs_buffer_size ||
+			    sector * PANDORA_RMTFS_SECTOR + bytes > pandora_rmtfs_files[file].size) {
+				printf("mpss: rmtfs: %s %llu sectors from %llu of %s at %#llx: OUTSIDE THE FILE OR THE BUFFER\n", write ? "write" :
+				    "read", sectors, sector, pandora_rmtfs_files[file].partition, physical);
+				result = PANDORA_QMI_RESULT_FAILURE;
+				error = PANDORA_QMI_ERR_MALFORMED;
+				pandora_rmtfs_refused++;
+				break;
+			}
+			if (write) {
+				for (uint64_t i = 0; i < bytes; i++) {
+					pandora_rmtfs_files[file].data[sector * PANDORA_RMTFS_SECTOR + i] =
+					    pandora_rmtfs_window[physical - pandora_rmtfs_buffer_pa + i];
+				}
+				pandora_rmtfs_sectors_written += sectors;
+			} else {
+				for (uint64_t i = 0; i < bytes; i++) {
+					pandora_rmtfs_window[physical - pandora_rmtfs_buffer_pa + i] =
+					    pandora_rmtfs_files[file].data[sector * PANDORA_RMTFS_SECTOR + i];
+				}
+				pandora_rmtfs_sectors_read += sectors;
+			}
+		}
+		pandora_settle();
+		if (pandora_option("modem_rmtfs_rw_fake")) {
+			/* (an experiment: the buffer is filled as asked, but the modem is told no: does the filling alone end the run?) */
+			pandora_tell("mpss: rmtfs: the buffer is filled for the modem's %s of %s, and it is told NO (modem_rmtfs_rw_fake)\n",
+			    write ? "write" : "read", pandora_rmtfs_files[file].partition);
+			result = PANDORA_QMI_RESULT_FAILURE;
+			error = PANDORA_QMI_ERR_INTERNAL;
+			break;
+		}
+		pandora_rmtfs_reads += !write;
+		pandora_rmtfs_writes += write;
+		if (pandora_rmtfs_reads + pandora_rmtfs_writes <= 12) {
+			pandora_tell("mpss: rmtfs: the modem %s %u pieces of %s%s: served\n", write ? "writes" : "reads", count,
+			    pandora_rmtfs_files[file].partition, write ? " (kept in memory, not on the storage)" : "");
+		}
+		break;
+	}
+	case PANDORA_RMTFS_GET_DEV_ERROR:
+		tlv[0] = 0x10;                  /* the device's error status: none */
+		tlv[1] = 1;
+		tlv[2] = 0;
+		tlv[3] = 0;
+		extra = 4;
+		break;
+	default:
+		printf("mpss: rmtfs: a request this does not know (%#x, %zu bytes)\n", message, length);
+		result = PANDORA_QMI_RESULT_FAILURE;
+		error = PANDORA_QMI_ERR_MALFORMED;
+		break;
+	}
+	answer[5] = (uint8_t)(7 + extra);
+	answer[6] = (uint8_t)((7 + extra) >> 8);
+	answer[7] = 2;                          /* the result TLV */
+	answer[8] = 4;
+	answer[9] = 0;
+	answer[10] = (uint8_t)result;
+	answer[11] = (uint8_t)(result >> 8);
+	answer[12] = (uint8_t)error;
+	answer[13] = (uint8_t)(error >> 8);
+	if (pandora_rmtfs_port != NULL) {
+		int sent = pandora_mpss_qrtr_send(pandora_rmtfs_port, node, port, answer, 7 + 7 + extra);
+
+		if (sent != 0) {
+			printf("mpss: rmtfs: the answer to %#x is NOT SENT (%d)\n", message, sent);
+		}
+	}
+}
+
+/* Our service announced to a node (its control port): a "new server", or the empty one that ends an answer to a lookup. */
+void
+pandora_qrtr_announce(uint32_t node, unsigned server, bool end)
+{
+	struct pandora_qrtr_control packet = { .command = PANDORA_QRTR_NEW_SERVER };
+
+	if (!end) {
+		packet.words[0] = pandora_our_servers[server].service;
+		packet.words[1] = pandora_our_servers[server].instance;
+		packet.words[2] = PANDORA_QRTR_US;
+		packet.words[3] = pandora_our_servers[server].port;
+	}
+	pandora_mpss_qrtr_out_packet(PANDORA_QRTR_NEW_SERVER, PANDORA_QRTR_CONTROL, node, PANDORA_QRTR_CONTROL, &packet,
+	    sizeof(packet));
+}
+
+void
+pandora_qrtr_announce_all(uint32_t node)
+{
+	for (unsigned i = 0; i < sizeof(pandora_our_servers) / sizeof(pandora_our_servers[0]); i++) {
+		if (pandora_our_servers[i].port != 0) {
+			pandora_qrtr_announce(node, i, false);
+		}
+	}
+}
+
+static void pandora_tftp_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length);
+static void pandora_servreg_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length);
+static struct pandora_qrtr_port *pandora_tftp_port, *pandora_servreg_port;
+
+/* The port, and the service on it; the partitions are read in step 2, the buffer shared in step 7. */
+bool
+pandora_rmtfs_start(void)
+{
+	if (pandora_rmtfs_port == NULL) {
+		pandora_rmtfs_port = pandora_qrtr_open(pandora_rmtfs_receive, NULL, NULL);
+	}
+	if (pandora_rmtfs_port == NULL) {
+		return false;
+	}
+	pandora_our_servers[0].service = PANDORA_RMTFS_SERVICE;
+	pandora_our_servers[0].instance = PANDORA_RMTFS_VERSION | PANDORA_RMTFS_INSTANCE << 8;
+	pandora_our_servers[0].port = pandora_qrtr_port_number(pandora_rmtfs_port);
+	if (!pandora_option("modem_no_tftp")) {
+		if (pandora_tftp_port == NULL) {
+			pandora_tftp_port = pandora_qrtr_open(pandora_tftp_receive, NULL, NULL);
+		}
+		if (pandora_tftp_port != NULL) {
+			pandora_our_servers[1].service = 4096;          /* TQFTP (below) */
+			pandora_our_servers[1].instance = 1;
+			pandora_our_servers[1].port = pandora_qrtr_port_number(pandora_tftp_port);
+		}
+		if (pandora_servreg_port == NULL) {
+			pandora_servreg_port = pandora_qrtr_open(pandora_servreg_receive, NULL, NULL);
+		}
+		if (pandora_servreg_port != NULL) {
+			pandora_our_servers[2].service = 64;            /* the service registry's locator (below) */
+			pandora_our_servers[2].instance = 257;
+			pandora_our_servers[2].port = pandora_qrtr_port_number(pandora_servreg_port);
+		}
+		if (pandora_ipa_qmi_start()) {
+			pandora_our_servers[3].service = 0x31;          /* the IPA's host service (below) */
+			pandora_our_servers[3].instance = 0x101;
+			pandora_our_servers[3].port = pandora_qrtr_port_number(pandora_ipa_host_port);
+		}
+	}
+	return true;
+}
+
+void
+pandora_rmtfs_stop(void)
+{
+	for (unsigned i = 0; i < sizeof(pandora_our_servers) / sizeof(pandora_our_servers[0]); i++) {
+		pandora_our_servers[i].port = 0;
+	}
+	if (pandora_rmtfs_port != NULL) {
+		pandora_qrtr_close(pandora_rmtfs_port);
+		pandora_rmtfs_port = NULL;
+	}
+	if (pandora_tftp_port != NULL) {
+		pandora_qrtr_close(pandora_tftp_port);
+		pandora_tftp_port = NULL;
+	}
+	if (pandora_servreg_port != NULL) {
+		pandora_qrtr_close(pandora_servreg_port);
+		pandora_servreg_port = NULL;
+	}
+	pandora_ipa_qmi_stop();
+	for (unsigned f = 0; f < 4; f++) {
+		pandora_rmtfs_files[f].open = false;
+	}
+}
+
+/* ---- TFTP over QRTR: the modem's files of configuration (tqftpserv) --------------------------------- */
+
+/*
+ * Besides its file systems, the modem reads files of its firmware partition -- the carrier
+ * configurations (mcfg), shared objects -- through TFTP carried in QRTR datagrams, from a
+ * service numbered 4096 that Linux's tqftpserv and Android's provide; until it has them it
+ * stays offline ("device not ready" to every request to go online). Here the partition's
+ * directory image/ is in the system image under /fw/image (userland/build.sh: fw-modem/image,
+ * pulled from the phone's /vendor/firmware_mnt/image), and served read-only: a read request
+ * names a file as /readonly/firmware/image/..., its options (RFC 2347: blksize, tsize, timeoutms;
+ * Qualcomm's wsize, a window of blocks sent without waiting, rsize, how much of the file, and
+ * seek, from where) are answered in an OACK, and the blocks go from a port of ours opened for the
+ * transfer, as TFTP wants. Writes (/readwrite/...) are refused: nothing of the modem's is kept
+ * here between runs.
+ */
+#define PANDORA_TQFTP_SERVICE           4096
+#define PANDORA_TQFTP_INSTANCE          1               /* version 1, instance 0 */
+#define PANDORA_TFTP_RRQ                1
+#define PANDORA_TFTP_WRQ                2
+#define PANDORA_TFTP_DATA               3
+#define PANDORA_TFTP_ACK                4
+#define PANDORA_TFTP_ERROR              5
+#define PANDORA_TFTP_OACK               6
+#define PANDORA_TFTP_ENOENT             1
+#define PANDORA_TFTP_EACCESS            2
+#define PANDORA_TFTP_EBADOP             4
+#define PANDORA_TFTP_END_OF_TRANSFER    9
+#define PANDORA_TFTP_MAX_BLOCK          8000            /* a datagram of ours holds 8192; the modem's intents 0x4400 */
+#define PANDORA_TFTP_MAX_WINDOW         4
+
+struct pandora_tftp_transfer {
+	struct pandora_qrtr_port *port;
+	uint32_t node, peer;
+	const uint8_t *data;                    /* a read: the file, whole, in memory of ours (pandora_root_file(), or pandora_tftp_files) */
+	uint64_t size;
+	uint32_t blksize, wsize, rsize, seek;
+	uint32_t sent;                          /* blocks sent so far */
+	bool done, writing, borrowed;           /* borrowed: data is a pandora_tftp_files entry's, not to be freed */
+	uint8_t *written;                       /* a write: what has come, up to PANDORA_TFTP_WRITE_MAX */
+	uint32_t written_size, expected;
+	char name[96];
+};
+static struct pandora_tftp_transfer pandora_tftp_transfers[4];
+
+/* What the modem writes, kept for the run (it reads some of it back); not on the storage. */
+#define PANDORA_TFTP_WRITE_MAX          (1u << 20)
+static struct {
+	char name[96];
+	uint8_t *data;
+	uint32_t size;
+} pandora_tftp_files[8];
+
+static void
+pandora_tftp_error(struct pandora_qrtr_port *from, uint32_t node, uint32_t port, uint16_t code, const char *text)
+{
+	uint8_t packet[64];
+	size_t n = strlen(text) + 1;
+
+	if (n > sizeof(packet) - 4) {
+		n = sizeof(packet) - 4;
+	}
+	packet[0] = 0;
+	packet[1] = PANDORA_TFTP_ERROR;
+	packet[2] = (uint8_t)(code >> 8);
+	packet[3] = (uint8_t)code;
+	memcpy(packet + 4, text, n);
+	packet[4 + n - 1] = 0;
+	pandora_mpss_qrtr_send(from, node, port, packet, 4 + n);
+}
+
+static void
+pandora_tftp_transfer_end(struct pandora_tftp_transfer *t)
+{
+	if (t->data != NULL && !t->borrowed) {
+		uint8_t *data = __DECONST(uint8_t *, t->data);
+
+		kfree_data(data, t->size);
+	}
+	t->data = NULL;
+	if (t->written != NULL) {
+		kfree_data(t->written, PANDORA_TFTP_WRITE_MAX);
+		t->written = NULL;
+	}
+	if (t->port != NULL) {
+		pandora_qrtr_close(t->port);
+		t->port = NULL;
+	}
+	t->done = true;
+}
+
+/* Blocks `from` + 1 onward, a window of them: TFTP's blocks are numbered from 1. */
+static void
+pandora_tftp_send_window(struct pandora_tftp_transfer *t, uint32_t from)
+{
+	uint8_t *packet = kalloc_data(t->blksize + 4, Z_WAITOK);
+
+	if (packet == NULL) {
+		return;
+	}
+	for (uint32_t w = 0; w < t->wsize; w++) {
+		uint32_t block = from + 1 + w;
+		uint64_t offset = (uint64_t)t->seek + (uint64_t)(block - 1) * t->blksize;
+		uint32_t n = offset >= t->size ? 0 : (uint32_t)(t->size - offset < t->blksize ? t->size - offset : t->blksize);
+
+		if (t->rsize != 0 && (uint64_t)(block - 1) * t->blksize >= t->rsize) {
+			break;                          /* (as much as was asked for has gone) */
+		}
+		if (t->rsize != 0 && (uint64_t)block * t->blksize > t->rsize) {
+			uint32_t left = (uint32_t)(t->rsize - (uint64_t)(block - 1) * t->blksize);
+
+			n = left < n ? left : n;        /* (as much as was asked for, and no more than the file has) */
+		}
+		packet[0] = 0;
+		packet[1] = PANDORA_TFTP_DATA;
+		packet[2] = (uint8_t)(block >> 8);
+		packet[3] = (uint8_t)block;
+		if (n != 0) {
+			memcpy(packet + 4, t->data + offset, n);
+		}
+		if (pandora_mpss_qrtr_send(t->port, t->node, t->peer, packet, 4 + n) != 0) {
+			break;
+		}
+		t->sent = block;
+		if (n < t->blksize) {
+			break;                          /* the last block */
+		}
+	}
+	kfree_data(packet, t->blksize + 4);
+}
+
+/* What the modem says to a transfer's port: acknowledgements, or an error that ends it. From the link's thread. */
+static void
+pandora_tftp_transfer_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	struct pandora_tftp_transfer *t = context;
+	const uint8_t *m = data;
+	uint16_t opcode, block;
+
+	if (t->done || node != t->node || port != t->peer || length < 4) {
+		return;
+	}
+	opcode = (uint16_t)(m[0] << 8 | m[1]);
+	block = (uint16_t)(m[2] << 8 | m[3]);
+	if (t->writing && opcode == PANDORA_TFTP_DATA) {
+		uint32_t n = (uint32_t)(length - 4);
+		uint8_t ack[4] = { 0, PANDORA_TFTP_ACK, (uint8_t)(block >> 8), (uint8_t)block };
+
+		if (block != t->expected) {
+			pandora_tftp_error(t->port, node, port, PANDORA_TFTP_EBADOP, "block out of sequence");
+			pandora_tftp_transfer_end(t);
+			return;
+		}
+		if (t->written_size + n > PANDORA_TFTP_WRITE_MAX) {
+			pandora_tftp_error(t->port, node, port, 3, "too much");
+			pandora_tftp_transfer_end(t);
+			return;
+		}
+		memcpy(t->written + t->written_size, m + 4, n);
+		t->written_size += n;
+		t->expected++;
+		if (block % t->wsize == 0 || n < t->blksize) {
+			pandora_mpss_qrtr_send(t->port, node, port, ack, sizeof(ack));
+		}
+		if (n < t->blksize) {
+			/* the last block: the file is kept, under its name, for the run */
+			unsigned f, free_slot = 8;
+
+			for (f = 0; f < 8; f++) {
+				if (pandora_tftp_files[f].data != NULL && strcmp(pandora_tftp_files[f].name, t->name) == 0) {
+					break;
+				}
+				if (pandora_tftp_files[f].data == NULL && free_slot == 8) {
+					free_slot = f;
+				}
+			}
+			if (f == 8) {
+				f = free_slot;
+			}
+			if (f < 8) {
+				if (pandora_tftp_files[f].data != NULL) {
+					kfree_data(pandora_tftp_files[f].data, pandora_tftp_files[f].size);
+				}
+				pandora_tftp_files[f].data = kalloc_data(t->written_size ? t->written_size : 1, Z_WAITOK);
+				if (pandora_tftp_files[f].data != NULL) {
+					memcpy(pandora_tftp_files[f].data, t->written, t->written_size);
+					pandora_tftp_files[f].size = t->written_size;
+					strlcpy(pandora_tftp_files[f].name, t->name, sizeof(pandora_tftp_files[f].name));
+				}
+			}
+			printf("mpss: tftp: the modem has written \"%s\": %u bytes, kept%s\n", t->name, t->written_size, f < 8 ? "" :
+			    " NOWHERE (no room)");
+			pandora_tftp_served++;
+			pandora_tftp_transfer_end(t);
+		}
+		return;
+	}
+	if (opcode == PANDORA_TFTP_ERROR) {
+		if (block != PANDORA_TFTP_END_OF_TRANSFER) {
+			printf("mpss: tftp: %s: the modem ends the transfer with error %u \"%.*s\"\n", t->name, block, (int)(length - 4), m + 4);
+		}
+		pandora_tftp_transfer_end(t);
+		return;
+	}
+	if (opcode != PANDORA_TFTP_ACK) {
+		pandora_tftp_error(t->port, node, port, PANDORA_TFTP_EBADOP, "expected ACK");
+		pandora_tftp_transfer_end(t);
+		return;
+	}
+	if ((uint64_t)t->seek + (uint64_t)block * t->blksize >= t->size || (t->rsize != 0 && (uint64_t)block * t->blksize >= t->rsize)) {
+		/* the acknowledged block was the last: over */
+		pandora_tftp_served++;
+		pandora_tftp_transfer_end(t);
+		return;
+	}
+	pandora_tftp_send_window(t, block);
+}
+
+static const char *
+pandora_tftp_file_of(const char *path)
+{
+	static const char *const prefixes[] = { "/readonly/firmware/image/", "/readonly/vendor/firmware_mnt/image/",
+		"/readonly/vendor/firmware/", "/readonly/firmware/" };
+
+	for (unsigned i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+		size_t n = strlen(prefixes[i]);
+
+		if (strncmp(path, prefixes[i], n) == 0 && strnstr(path + n, "..", strlen(path + n)) == NULL) {
+			return path + n;
+		}
+	}
+	return NULL;
+}
+
+/* A request to our TFTP port: a read starts a transfer on a port of its own; anything else is refused. From the link's thread. */
+static void
+pandora_tftp_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *m = data, *end = m + length;
+	const char *name, *mode, *p;
+	struct pandora_tftp_transfer *t = NULL;
+	uint32_t blksize = 512, wsize = 1, rsize = 0, seek = 0;
+	bool tsize = false, options = false;
+	char fwname[160];
+	uint64_t size = 0;
+	const uint8_t *file;
+	uint8_t oack[160];
+	unsigned at;
+
+	bool writing;
+
+	if (length < 4) {
+		return;
+	}
+	pandora_tftp_requests++;
+	writing = (m[0] << 8 | m[1]) == PANDORA_TFTP_WRQ;
+	if ((m[0] << 8 | m[1]) != PANDORA_TFTP_RRQ && !writing) {
+		printf("mpss: tftp: the modem's request %u: not a read nor a write, refused\n", m[0] << 8 | m[1]);
+		pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_EBADOP, "not a read nor a write");
+		pandora_tftp_refused++;
+		return;
+	}
+	name = (const char *)m + 2;
+	p = name;
+	while (p < (const char *)end && *p != 0) {
+		p++;
+	}
+	if (p >= (const char *)end) {
+		return;
+	}
+	mode = p + 1;
+	p = mode;
+	while (p < (const char *)end && *p != 0) {
+		p++;
+	}
+	if (p >= (const char *)end) {
+		return;
+	}
+	p++;
+	/* the options: name, value, name, value..., each ended by a zero */
+	while (p < (const char *)end) {
+		const char *option = p, *value;
+
+		while (p < (const char *)end && *p != 0) {
+			p++;
+		}
+		if (p >= (const char *)end) {
+			break;
+		}
+		value = ++p;
+		while (p < (const char *)end && *p != 0) {
+			p++;
+		}
+		if (p >= (const char *)end) {
+			break;
+		}
+		p++;
+		options = true;
+		if (strcmp(option, "blksize") == 0) {
+			blksize = (uint32_t)strtoul(value, NULL, 10);
+		} else if (strcmp(option, "wsize") == 0) {
+			wsize = (uint32_t)strtoul(value, NULL, 10);
+		} else if (strcmp(option, "rsize") == 0) {
+			rsize = (uint32_t)strtoul(value, NULL, 10);
+		} else if (strcmp(option, "seek") == 0) {
+			seek = (uint32_t)strtoul(value, NULL, 10);
+		} else if (strcmp(option, "tsize") == 0) {
+			tsize = true;
+		}
+	}
+	if (blksize < 8) {
+		blksize = 8;
+	}
+	if (blksize > PANDORA_TFTP_MAX_BLOCK) {
+		blksize = PANDORA_TFTP_MAX_BLOCK;
+	}
+	if (wsize < 1) {
+		wsize = 1;
+	}
+	if (wsize > PANDORA_TFTP_MAX_WINDOW) {
+		wsize = PANDORA_TFTP_MAX_WINDOW;
+	}
+	for (unsigned i = 0; i < sizeof(pandora_tftp_transfers) / sizeof(pandora_tftp_transfers[0]) && t == NULL; i++) {
+		if (pandora_tftp_transfers[i].port == NULL) {
+			t = &pandora_tftp_transfers[i];
+		}
+	}
+	if (t == NULL) {
+		printf("mpss: tftp: the modem %s \"%s\": NO FREE TRANSFER\n", writing ? "writes" : "reads", name);
+		pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_ENOENT, "busy");
+		pandora_tftp_refused++;
+		return;
+	}
+	if (writing) {
+		bzero(t, sizeof(*t));
+		t->written = kalloc_data(PANDORA_TFTP_WRITE_MAX, Z_WAITOK);
+		t->port = t->written == NULL ? NULL : pandora_qrtr_open(pandora_tftp_transfer_receive, NULL, t);
+		if (t->port == NULL) {
+			pandora_tftp_transfer_end(t);
+			pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_ENOENT, "no port");
+			return;
+		}
+		t->node = node;
+		t->peer = port;
+		t->writing = true;
+		t->expected = 1;
+		t->blksize = blksize;
+		t->wsize = wsize;
+		strlcpy(t->name, name, sizeof(t->name));
+		printf("mpss: tftp: the modem writes \"%s\": blocks of %u, window %u; taken into memory\n", name, blksize, wsize);
+		if (!options) {
+			uint8_t ack[4] = { 0, PANDORA_TFTP_ACK, 0, 0 };
+
+			pandora_mpss_qrtr_send(t->port, node, port, ack, sizeof(ack));
+			return;
+		}
+		size = 0;
+		goto oack;
+	}
+	/* a read: what the modem wrote earlier under that name, else the firmware partition's file */
+	file = NULL;
+	for (unsigned f = 0; f < 8 && file == NULL; f++) {
+		if (pandora_tftp_files[f].data != NULL && strcmp(pandora_tftp_files[f].name, name) == 0) {
+			file = pandora_tftp_files[f].data;
+			size = pandora_tftp_files[f].size;
+			t->borrowed = true;
+		}
+	}
+	if (file == NULL && pandora_tftp_file_of(name) == NULL) {
+		printf("mpss: tftp: the modem reads \"%s\": NOT A PATH SERVED HERE\n", name);
+		pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_ENOENT, "file not found");
+		pandora_tftp_refused++;
+		return;
+	}
+	if (file == NULL) {
+		snprintf(fwname, sizeof(fwname), "image/%s", pandora_tftp_file_of(name));
+		file = pandora_root_file(fwname, &size);
+	} else {
+		strlcpy(fwname, "(written by the modem)", sizeof(fwname));
+	}
+	if (file == NULL) {
+		printf("mpss: tftp: the modem reads \"%s\" (fw/%s): NOT HERE\n", name, fwname);
+		pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_ENOENT, "file not found");
+		pandora_tftp_refused++;
+		return;
+	}
+	{
+		bool borrowed = t->borrowed;
+
+		bzero(t, sizeof(*t));
+		t->borrowed = borrowed;
+	}
+	t->port = pandora_qrtr_open(pandora_tftp_transfer_receive, NULL, t);
+	if (t->port == NULL) {
+		if (!t->borrowed) {
+			uint8_t *gone = __DECONST(uint8_t *, file);
+
+			kfree_data(gone, size);
+		}
+		pandora_tftp_error(pandora_tftp_port, node, port, PANDORA_TFTP_ENOENT, "no port");
+		return;
+	}
+	t->node = node;
+	t->peer = port;
+	t->data = file;
+	t->size = size;
+	t->blksize = blksize;
+	t->wsize = wsize;
+	t->rsize = rsize;
+	t->seek = seek;
+	strlcpy(t->name, name, sizeof(t->name));
+	if (pandora_tftp_requests <= 40) {
+		printf("mpss: tftp: the modem reads \"%s\": %llu bytes; blocks of %u, window %u, %u asked for, from %u%s\n", name, size, blksize,
+		    wsize, rsize, seek, options ? "" : " (no options)");
+	}
+	if (!options) {
+		pandora_tftp_send_window(t, 0);
+		return;
+	}
+oack:
+	/* OACK: the options as taken, as tqftpserv answers them */
+	oack[0] = 0;
+	oack[1] = PANDORA_TFTP_OACK;
+	at = 2;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "blksize") + 1;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", blksize) + 1;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "timeoutms") + 1;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "1000") + 1;
+	if (tsize && !t->writing) {
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "tsize") + 1;
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%llu", size) + 1;
+	}
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "wsize") + 1;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", wsize) + 1;
+	if (rsize != 0) {
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "rsize") + 1;
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", rsize) + 1;
+	}
+	if (seek != 0) {
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "seek") + 1;
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", seek) + 1;
+	}
+	pandora_mpss_qrtr_send(t->port, node, port, oack, at);
+}
+
+/* ---- the service registry's locator (pd-mapper) ---------------------------------------------------- */
+
+/*
+ * The modem's protection domains register their services with a registry whose locator (QMI
+ * service 64) is the application processor's: asked for a service by name ("tms/servreg",
+ * "gps/gps_service"), it answers with the domains that provide it ("msm/modem/root_pd") and their
+ * QMI instance. Linux's pd-mapper reads the table from the *.jsn files beside the firmware; here
+ * they are read from /fw/image (the phone's own), each one domain with its services.
+ */
+#define PANDORA_SERVREG_SERVICE         64
+#define PANDORA_SERVREG_INSTANCE        257             /* what pd-mapper publishes: version 257 */
+#define PANDORA_SERVREG_GET_DOMAIN_LIST 0x21
+#define PANDORA_SERVREG_PFR             0x24
+
+static struct {
+	char service[48];                       /* provider/service */
+	char domain[48];                        /* soc/domain/subdomain */
+	uint32_t instance;
+} pandora_servreg_map[32];
+static unsigned pandora_servreg_maps;
+
+/* The text between the quotes after "key": in a JSON file of the registry's simple shape; NULL if there is none. */
+static const char *
+pandora_jsn_string(const char *from, const char *end, const char *key, char *out, size_t out_size)
+{
+	char quoted[48];
+	const char *at;
+
+	snprintf(quoted, sizeof(quoted), "\"%s\"", key);
+	at = strnstr(from, quoted, (size_t)(end - from));
+	if (at == NULL) {
+		return NULL;
+	}
+	at += strlen(quoted);
+	while (at < end && (*at == ':' || *at == ' ' || *at == '\t' || *at == '\n' || *at == '\r')) {
+		at++;
+	}
+	if (at >= end) {
+		return NULL;
+	}
+	if (*at == '"') {
+		const char *close = at + 1;
+
+		while (close < end && *close != '"') {
+			close++;
+		}
+		if (close >= end) {
+			return NULL;
+		}
+		snprintf(out, out_size, "%.*s", (int)(close - at - 1), at + 1);
+		return close + 1;
+	}
+	/* a number */
+	{
+		const char *close = at;
+
+		while (close < end && ((*close >= '0' && *close <= '9') || *close == '-')) {
+			close++;
+		}
+		snprintf(out, out_size, "%.*s", (int)(close - at), at);
+		return close;
+	}
+}
+
+void
+pandora_servreg_load(void)
+{
+	static const char *const files[] = { "modemr.jsn", "adspr.jsn", "adsps.jsn", "adspua.jsn", "battmgr.jsn", "cdspr.jsn", "wpssr.jsn" };
+
+	pandora_servreg_maps = 0;
+	for (unsigned f = 0; f < sizeof(files) / sizeof(files[0]); f++) {
+		char name[64], soc[24], domain[24], subdomain[24], instance[16], provider[24], service[24], full[48];
+		uint64_t size = 0;
+		const uint8_t *data;
+		const char *text, *end, *at;
+
+		snprintf(name, sizeof(name), "image/%s", files[f]);
+		data = pandora_root_file(name, &size);
+		if (data == NULL) {
+			continue;
+		}
+		text = (const char *)data;
+		end = text + size;
+		if (pandora_jsn_string(text, end, "soc", soc, sizeof(soc)) == NULL || pandora_jsn_string(text, end, "domain", domain, sizeof(domain)) == NULL ||
+		    pandora_jsn_string(text, end, "subdomain", subdomain, sizeof(subdomain)) == NULL ||
+		    pandora_jsn_string(text, end, "qmi_instance_id", instance, sizeof(instance)) == NULL) {
+			uint8_t *gone = __DECONST(uint8_t *, data);
+
+			printf("mpss: servreg: fw/%s: not of the shape this reads\n", name);
+			kfree_data(gone, size);
+			continue;
+		}
+		snprintf(full, sizeof(full), "%s/%s/%s", soc, domain, subdomain);
+		at = text;
+		while (pandora_servreg_maps < sizeof(pandora_servreg_map) / sizeof(pandora_servreg_map[0]) &&
+		    (at = pandora_jsn_string(at, end, "provider", provider, sizeof(provider))) != NULL &&
+		    pandora_jsn_string(at, end, "service", service, sizeof(service)) != NULL) {
+			snprintf(pandora_servreg_map[pandora_servreg_maps].service, sizeof(pandora_servreg_map[0].service), "%s/%s", provider, service);
+			strlcpy(pandora_servreg_map[pandora_servreg_maps].domain, full, sizeof(pandora_servreg_map[0].domain));
+			pandora_servreg_map[pandora_servreg_maps].instance = (uint32_t)strtoul(instance, NULL, 10);
+			pandora_servreg_maps++;
+		}
+		{
+			uint8_t *gone = __DECONST(uint8_t *, data);
+
+			kfree_data(gone, size);
+		}
+	}
+	printf("mpss: %u: the service registry: %u services of %u files\n", pandora_step, pandora_servreg_maps,
+	    (unsigned)(sizeof(files) / sizeof(files[0])));
+	for (unsigned i = 0; i < pandora_servreg_maps; i++) {
+		printf("mpss: %u:   %s at %s, instance %u\n", pandora_step, pandora_servreg_map[i].service, pandora_servreg_map[i].domain,
+		    pandora_servreg_map[i].instance);
+	}
+}
+
+/* A question to the locator, answered. From the link's thread. */
+static void
+pandora_servreg_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[512];
+	uint16_t message, size = 0;
+	unsigned at = 7 + 7, found = 0;
+	char wanted[64] = "";
+
+	if (length < 7 || m[0] != PANDORA_QMI_REQUEST) {
+		return;
+	}
+	message = (uint16_t)(m[3] | m[4] << 8);
+	pandora_servreg_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = PANDORA_QMI_RESPONSE;
+	answer[1] = m[1];
+	answer[2] = m[2];
+	answer[3] = m[3];
+	answer[4] = m[4];
+	answer[7] = 2;                          /* result: success */
+	answer[8] = 4;
+	if (message == PANDORA_SERVREG_GET_DOMAIN_LIST) {
+		value = pandora_qmi_tlv(m, length, 1, &size);
+		if (value != NULL) {
+			snprintf(wanted, sizeof(wanted), "%.*s", (int)(size < 63 ? size : 63), (const char *)value);
+		}
+		for (unsigned i = 0; i < pandora_servreg_maps; i++) {
+			found += strcmp(pandora_servreg_map[i].service, wanted) == 0;
+		}
+		/* TLV 0x10: how many domains in all; 0x11: the table's revision; 0x12: the list, each a string with a
+		 * byte of length, the instance (4 bytes), and the service data (a byte of validity, 4 bytes) */
+		answer[at++] = 0x10;
+		answer[at++] = 2;
+		answer[at++] = 0;
+		answer[at++] = (uint8_t)found;
+		answer[at++] = (uint8_t)(found >> 8);
+		answer[at++] = 0x11;
+		answer[at++] = 2;
+		answer[at++] = 0;
+		answer[at++] = 1;
+		answer[at++] = 0;
+		if (found != 0) {
+			unsigned list = at;
+
+			answer[at++] = 0x12;
+			at += 2;                        /* the length, filled in below */
+			answer[at++] = (uint8_t)found;
+			for (unsigned i = 0; i < pandora_servreg_maps && at + 64 < sizeof(answer); i++) {
+				if (strcmp(pandora_servreg_map[i].service, wanted) != 0) {
+					continue;
+				}
+				answer[at++] = (uint8_t)strlen(pandora_servreg_map[i].domain);
+				memcpy(answer + at, pandora_servreg_map[i].domain, strlen(pandora_servreg_map[i].domain));
+				at += (unsigned)strlen(pandora_servreg_map[i].domain);
+				for (unsigned b = 0; b < 4; b++) {
+					answer[at++] = (uint8_t)(pandora_servreg_map[i].instance >> (8 * b));
+				}
+				answer[at++] = 0;       /* no service data */
+				at += 4;
+			}
+			answer[list + 1] = (uint8_t)(at - list - 3);
+			answer[list + 2] = (uint8_t)((at - list - 3) >> 8);
+		}
+		printf("mpss: servreg: the modem asks where \"%s\" is: %u domain%s\n", wanted, found, found == 1 ? "" : "s");
+	} else if (message == PANDORA_SERVREG_PFR) {
+		value = pandora_qmi_tlv(m, length, 1, &size);
+		printf("mpss: servreg: the modem reports a failure of \"%.*s\"\n", value ? (int)(size < 63 ? size : 63) : 0,
+		    value ? (const char *)value : "");
+	} else {
+		printf("mpss: servreg: a request this does not know (%#x)\n", message);
+		answer[10] = PANDORA_QMI_RESULT_FAILURE;
+		answer[12] = PANDORA_QMI_ERR_MALFORMED;
+	}
+	answer[5] = (uint8_t)(at - 7);
+	answer[6] = (uint8_t)((at - 7) >> 8);
+	pandora_mpss_qrtr_send(pandora_servreg_port, node, port, answer, at);
+}
+#endif /* PANDORA */
