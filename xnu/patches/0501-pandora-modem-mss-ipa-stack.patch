+                    const struct cell_session *settings, uint8_t *reply, size_t *reply_length);
+static bool     cell_dhcp_request(const uint8_t *frame, size_t length, const uint8_t **udp);
+static bool     cell_dhcp_answer(const uint8_t *frame, size_t length, const uint8_t *udp,
