+
+int
+pandora_say(const char *format, ...)
+{
+	va_list ap;
+	int said;
+
+	va_start(ap, format);
+	said = vprintf(format, ap);
+	va_end(ap);
+	return said;
+}
+
+int
+pandora_tell(const char *format, ...)
+{
+	va_list ap;
+	int said;
+
+	va_start(ap, format);
+	said = vprintf(format, ap);
+	va_end(ap);
+	/* HakiOS also copies this into the loader's log there; here everything the kernel prints is
+	 * already on the console log that sweet_ufs.c writes to the pinned file. */
+	return said;
+}
