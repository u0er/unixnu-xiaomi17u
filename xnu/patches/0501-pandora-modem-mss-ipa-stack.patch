+/* ---- small helpers -------------------------------------------------------------------------- */
+
+static inline uint16_t
+get16(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] << 8 | p[1]);
+}
+
+/* Big-endian, which is what the wire under en1 is: see the top of the file on byte order. */
+static inline uint32_t
+get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static inline void
+put32(uint8_t *p, uint32_t value)
+{
+	p[0] = (uint8_t)(value >> 24);
+	p[1] = (uint8_t)(value >> 16);
+	p[2] = (uint8_t)(value >> 8);
+	p[3] = (uint8_t)value;
+}
+
+static inline void
+put16(uint8_t *p, uint32_t value)
+{
+	p[0] = (uint8_t)(value >> 8);
+	p[1] = (uint8_t)value;
+}
+
+/* The internet checksum of an IPv4 header or of a UDP pseudo-header payload (spec 2.1). */
+static uint16_t
+cell_checksum(const uint8_t *data, size_t length)
+{
+	uint32_t sum = 0;
+
+	for (size_t i = 0; i + 1 < length; i += 2) {
+		sum += (uint32_t)data[i] << 8 | data[i + 1];
+	}
+	if (length & 1) {
+		sum += (uint32_t)data[length - 1] << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+/* Milliseconds since boot, for the state machine's timers. */
+static uint64_t
+cell_now_ms(void)
+{
+	uint64_t uptime, nanoseconds;
+
+	clock_get_uptime(&uptime);
+	absolutetime_to_nanoseconds(uptime, &nanoseconds);
+	return nanoseconds / 1000000ull;
+}
+
+/* A "pandora_cell*" boot argument that is on: present and not zero (HakiOS option()). */
+static bool
+cell_option(const char *name)
+{
+	char full[48];
+	unsigned on = 0;
+
+	snprintf(full, sizeof(full), "pandora_cell%s", name);
+	return PE_parse_boot_argn(full, &on, sizeof(on)) && on != 0;
+}
+
+/* A boot argument with a value. */
+static bool
+cell_argument(const char *name, void *value, size_t size)
+{
+	char full[48];
+
+	snprintf(full, sizeof(full), "pandora_cell%s", name);
+	return PE_parse_boot_argn(full, value, (uint32_t)size);
+}
