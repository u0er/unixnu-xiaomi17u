index 0000000..4120699
--- /dev/null
+++ b/bsd/dev/pandora_qrtr.c
@@ -0,0 +1,533 @@
+/*
+ * PANDORA modem: QRTR -- the router's datagrams, and ports of ours.
+ *
+ * This is the QRTR block of HakiOS's drivers/modem/hakios.mpss.c ported verbatim: source lines 3056
+ * through 3433, from the banner "QRTR: the router's datagrams, and ports of ours (hakios.wifi.c)" to
+ * the closing brace of hakios_mpss_qrtr(). The tabs, the block comments, the order of the cases and
+ * the arithmetic are the source's. Nothing was improved, reformatted or reorganised; the only edits
+ * are the rename hakios_qrtr_* -> pandora_qrtr_*, hakios_mpss_qrtr -> pandora_mpss_qrtr,
+ * HAKIOS_QRTR_MAX -> PANDORA_QRTR_MAX, and the file-local names (qrtr_ports -> pq_ports, qrtr_lock ->
+ * pq_lock and the rest) that this file can no longer share with hakios.mpss.c's other blocks. Each
+ * deviation from a straight rename is marked PORTER'S NOTE at the place it happens, and they are all
+ * listed again at the foot of the file.
+ *
+ * HakiOS's block header, which says what the channel carries (sys/hakios.qrtr.h is pandora_qrtr.h
+ * here, and hakios.nas.c / hakios.qmi.c are not ported yet):
+ *
+ *   What goes over the channel: datagrams of Qualcomm's IPC router, each with a header that says who
+ *   sends it (a node, a port) and to whom, and of which kind. The control port hears of the services
+ *   the modem offers ("new server": a service, an instance, a node, a port), and later their going.
+ *   We are node 1 (Linux's default, and what this phone's Android is); the modem says who it is in
+ *   what it sends.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+
+#include "pandora_modem.h"
+#include "pandora_qrtr.h"
+
+/* ---- declared, not copied: what the caller provides instead of this file ----------------------------- */
+
+/*
+ * The link's IPCRTR channel, and one send on it. In HakiOS both are file statics of hakios.mpss.c that
+ * this block reaches for directly -- the channel table's entry (:2625, name "IPCRTR", intents 0x800,
+ * 0x2000 and 0x4400) and static int glink_send(struct glink_channel *, const void *, uint32_t)
+ * (:3004). They are the caller's here, because the GLINK instance belongs to bsd/dev/pandora_mpss.c:
+ * pandora_mpss_glink_channel() is "the channel of this name", NULL until the modem has opened it --
+ * which is exactly what glink.channel[CHANNEL_QRTR].open said -- and pandora_mpss_glink_send() is
+ * glink_send() with the channel handed in.
+ */
+struct pandora_glink_channel;
+extern struct pandora_glink_channel *pandora_mpss_glink_channel(const char *name);
+extern int pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length);
+
+/*
+ * printf() in this block is the port's plain log, defined once in bsd/dev/pandora_mpss.c as
+ * pandora_say() (HakiOS's say(), hakios.mpss.c:131) -- the same bridge pandora_rmtfs.c uses.
+ */
+#define printf pandora_say
+
+/*
+ * The lock group this file's two mutexes are in. HakiOS shares one group with the rest of
+ * hakios.mpss.c (:101, static LCK_GRP_DECLARE(mpss_lock_group, "hakios-mpss")); the QRTR state is this
+ * file's alone on this side, so the group is too. PORTER'S NOTE (not in the source's range).
+ */
+static LCK_GRP_DECLARE(pq_grp, "pandora-qrtr");
+
+/*
+ * glink.channel[CHANNEL_QRTR], which the block reaches for at :3135, :3417 and :3428. PORTER'S NOTE
+ * (not in the source's range): the one place the caller's channel name goes in.
+ */
+static struct pandora_glink_channel *
+pq_qrtr_channel(void)
+{
+	return pandora_mpss_glink_channel("IPCRTR");
+}
+
+/*
+ * The IPA's host port; the caller fills it in when its QMI handshake comes up, and
+ * pandora_rmtfs_start() publishes it as service 0x31 (:4010). HakiOS's hakios.ipa.c owns it there.
+ * PORTER'S NOTE (not in the source's range): pandora_modem.h declares it, this file stores it.
+ */
+struct pandora_qrtr_port *pandora_ipa_host_port;
+
+/* ---- QRTR: the router's datagrams, and ports of ours (hakios.wifi.c) ------------------------------ */
+
+/*
+ * What goes over the channel: datagrams of Qualcomm's IPC router, each with a header that says
+ * who sends it (a node, a port) and to whom, and of which kind. The control port hears of the
+ * services the modem offers ("new server": a service, an instance, a node, a port), and later
+ * their going. We are node 1 (Linux's default, and what this phone's Android is); the modem says
+ * who it is in what it sends. The interface for the rest of the kernel is sys/hakios.qrtr.h:
+ * the four calls at the end of this section, which the NAS client (hakios.nas.c) and the QMI
+ * helpers (hakios.qmi.c) take.
+ */
+#define PANDORA_QRTR_MAX        8192            /* the most a datagram holds, either way */
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu     /* the control port */
+#define QRTR_FIRST_PORT         0x4000u         /* where Linux begins numbering ports that ask for no number */
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7,
+       QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct pq_header {                            /* version 1, which Linux sends; version 2 is read as well */
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct pq_control_message {
+	uint32_t command;
+	uint32_t words[4];                      /* a server: service, instance, node, port; a client: node, port */
+};
+
+/* struct pandora_qrtr_port (:3082) is in pandora_qrtr.h now, unchanged and field for field: callers
+ * hold the pointer, and pandora_rmtfs.c has to be able to read its first field. */
+
+static LCK_MTX_DECLARE(pq_lock, &pq_grp);    /* the tables below */
+static LCK_MTX_DECLARE(pq_calling, &pq_grp); /* held by the link's thread around a callback */
+static struct pandora_qrtr_port pq_ports[16];
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} pq_servers[64];
+static uint32_t pq_peer;                      /* the modem's node; 0: it has not said */
+static uint32_t pq_next_port = QRTR_FIRST_PORT, pq_in, pq_out, pq_hellos, pq_lookups;
+thread_t pandora_qrtr_link_thread;
+
+/*
+ * The name service's side -- pandora_our_servers[4] (:3106) -- is pandora_our_servers here: the storage is
+ * pandora_rmtfs.c's and the declaration is pandora_modem.h's, because rmtfs_start() (:3995) is what
+ * publishes the four services. The counters beside it (:3108-3109) are pandora_rmtfs.c's too.
+ */
+
+/* One datagram out, of any type. */
+int
+pandora_mpss_qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct pq_header *packet;
+	int error;
+
+	if (length == 0 || length > PANDORA_QRTR_MAX) {
+		return EMSGSIZE;
+	}
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = pandora_mpss_glink_send(pq_qrtr_channel(), packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	pq_out += error == 0;
+	return error;
+}
+
+static bool
+pq_matches(uint32_t service, uint32_t instance, unsigned server)
+{
+	return pq_servers[server].there && pq_servers[server].service == service &&
+	       (instance == 0 || pq_servers[server].instance == instance);
+}
+
+/* Everybody who looked a service up is told that it has come, or gone. From the link's thread. */
+static void
+pq_tell(uint32_t service, uint32_t instance, uint32_t node, uint32_t port, bool arrived)
+{
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			pandora_qrtr_server_t server = NULL;
+			void *context;
+
+			lck_mtx_lock(&pq_lock);
+			if (pq_ports[p].number != 0 && pq_ports[p].lookups[l].asked && !pq_ports[p].lookups[l].fresh &&
+			    pq_ports[p].lookups[l].service == service &&
+			    (pq_ports[p].lookups[l].instance == 0 || pq_ports[p].lookups[l].instance == instance)) {
+				server = pq_ports[p].server;
+			}
+			context = pq_ports[p].context;
+			lck_mtx_unlock(&pq_lock);
+			if (server != NULL) {
+				server(context, arrived, service, instance & 0xff, instance >> 8, node, port);
+			}
+		}
+	}
+}
+
+/* pandora_qrtr_announce() and pandora_qrtr_announce_all() (:3172-3173, bodies at :3955 and :3967) are
+ * pandora_qrtr_announce() and pandora_qrtr_announce_all() here, defined in pandora_rmtfs.c and
+ * declared in pandora_qrtr.h. */
+
+/* The control port's part: Linux's name service, with our one service to tell of. */
+static void
+pq_control(const struct pq_header *header, const struct pq_control_message *control)
+{
+	struct pq_control_message hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (pq_hellos++ != 0) {
+			break;                                  /* (answered once: two that answer every hello never end) */
+		}
+		error = pandora_mpss_qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("mpss: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		pandora_qrtr_announce_all(header->from_node);    /* (the name service's part: what we offer) */
+		break;
+	case QRTR_NEW_SERVER:
+		lck_mtx_lock(&pq_lock);
+		for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]); i++) {
+			if (pq_servers[i].there && pq_servers[i].node == control->words[2] && pq_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!pq_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			pq_servers[found].there = true;
+			pq_servers[found].service = control->words[0];
+			pq_servers[found].instance = control->words[1];
+			pq_servers[found].node = control->words[2];
+			pq_servers[found].port = control->words[3];
+		}
+		lck_mtx_unlock(&pq_lock);
+		printf("mpss: qrtr: a service: %u (%#x), version %u, instance %u, at node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		pq_tell(control->words[0], control->words[1], control->words[2], control->words[3], true);
+		break;
+	case QRTR_DEL_SERVER:
+	case QRTR_BYE:
+		for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]); i++) {
+			bool gone;
+
+			lck_mtx_lock(&pq_lock);
+			gone = pq_servers[i].there && (control->command == QRTR_BYE ? pq_servers[i].node == header->from_node :
+			    pq_servers[i].node == control->words[2] && pq_servers[i].port == control->words[3]);
+			pq_servers[i].there = pq_servers[i].there && !gone;
+			lck_mtx_unlock(&pq_lock);
+			if (gone) {
+				printf("mpss: qrtr: service %u at node %u port %u has gone\n", pq_servers[i].service, pq_servers[i].node,
+				    pq_servers[i].port);
+				pq_tell(pq_servers[i].service, pq_servers[i].instance, pq_servers[i].node, pq_servers[i].port, false);
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP: {
+		/* the modem looks for a service: ours that match, then the empty "new server" that ends the answer */
+		unsigned matches = 0;
+
+		for (unsigned i = 0; i < sizeof(pandora_our_servers) / sizeof(pandora_our_servers[0]); i++) {
+			if (pandora_our_servers[i].port != 0 && (control->words[0] == 0 || pandora_our_servers[i].service == control->words[0]) &&
+			    (control->words[1] == 0 || pandora_our_servers[i].instance == control->words[1])) {
+				pandora_qrtr_announce(header->from_node, i, false);
+				matches++;
+			}
+		}
+		pandora_qrtr_announce(header->from_node, 0, true);
+		if (pq_lookups++ < 16) {
+			printf("mpss: qrtr: the modem looks for service %u (%#x), instance %u: %u of ours\n", control->words[0],
+			    control->words[0], control->words[1], matches);
+		}
+		break;
+	}
+	default:
+		break;                                  /* (a client's going, and what else there is: nothing here wants it) */
+	}
+}
+
+/* A message from the channel: one datagram. From the link's thread. */
+void
+pandora_qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct pq_header header;
+	pandora_qrtr_receive_t receive = NULL;
+	void *context = NULL;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		/* version 2: version, type, flags, a length of options; the size; then four numbers of 16 bits */
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("mpss: qrtr: %u bytes that are no datagram (they begin %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	if (header.size == 0 || at + header.size > length) {
+		printf("mpss: qrtr: a datagram of %u bytes in a message of %u: dropped\n", header.size, length);
+		return;
+	}
+	pq_in++;
+	if (pq_peer == 0) {
+		pq_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;                                 /* (we never ask for one: GLINK's intents hold us back already) */
+	}
+	if (header.confirm) {
+		/* the sender counts what it has sent to this port, and waits for this before it sends many more */
+		struct pq_control_message resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		pandora_mpss_qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct pq_control_message control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		pq_control(&header, &control);
+		return;
+	}
+	lck_mtx_lock(&pq_lock);
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		if (pq_ports[p].number == header.to_port && header.type == QRTR_DATA) {
+			receive = pq_ports[p].receive;
+			context = pq_ports[p].context;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	if (receive != NULL) {
+		receive(context, header.from_node, header.from_port, data + at, header.size);
+	} else if (pq_in <= 64) {
+		printf("mpss: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n", header.size,
+		    header.from_node, header.from_port, header.to_port);
+	}
+}
+
+/* Lookups made since the last look are told of the services that were there before them. From the link's thread. */
+void
+pandora_qrtr_fresh(void)
+{
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			pandora_qrtr_server_t server;
+			uint32_t service, instance;
+			void *context;
+
+			lck_mtx_lock(&pq_lock);
+			if (pq_ports[p].number == 0 || !pq_ports[p].lookups[l].fresh) {
+				lck_mtx_unlock(&pq_lock);
+				continue;
+			}
+			pq_ports[p].lookups[l].fresh = false;
+			server = pq_ports[p].server;
+			service = pq_ports[p].lookups[l].service;
+			instance = pq_ports[p].lookups[l].instance;
+			context = pq_ports[p].context;
+			lck_mtx_unlock(&pq_lock);
+			for (unsigned i = 0; i < sizeof(pq_servers) / sizeof(pq_servers[0]) && server != NULL; i++) {
+				if (pq_matches(service, instance, i)) {
+					server(context, true, pq_servers[i].service, pq_servers[i].instance & 0xff,
+					    pq_servers[i].instance >> 8, pq_servers[i].node, pq_servers[i].port);
+				}
+			}
+		}
+	}
+}
+
+struct pandora_qrtr_port *
+pandora_qrtr_open(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server, void *context)
+{
+	struct pandora_qrtr_port *port = NULL;
+
+	lck_mtx_lock(&pq_lock);
+	for (unsigned p = 0; p < sizeof(pq_ports) / sizeof(pq_ports[0]) && port == NULL; p++) {
+		if (pq_ports[p].number == 0) {
+			port = &pq_ports[p];
+			bzero(port, sizeof(*port));
+			port->number = pq_next_port++;
+			port->receive = receive;
+			port->server = server;
+			port->context = context;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	return port;
+}
+
+int
+pandora_mpss_qrtr_send(struct pandora_qrtr_port *port, uint32_t node, uint32_t to, const void *data, size_t length)
+{
+	if (port == NULL || port->number == 0 || length > PANDORA_QRTR_MAX) {
+		return EINVAL;
+	}
+	return pandora_mpss_qrtr_out_packet(QRTR_DATA, port->number, node, to, data, (uint32_t)length);
+}
+
+int
+pandora_qrtr_lookup(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance)
+{
+	int error = ENOSPC;
+
+	lck_mtx_lock(&pq_lock);
+	for (unsigned l = 0; l < 4 && error != 0 && port != NULL && port->number != 0; l++) {
+		if (!port->lookups[l].asked) {
+			port->lookups[l].service = service;
+			port->lookups[l].instance = instance != 0 ? (version & 0xff) | instance << 8 : 0;
+			port->lookups[l].asked = true;
+			port->lookups[l].fresh = true;
+			error = 0;
+		}
+	}
+	lck_mtx_unlock(&pq_lock);
+	return error;
+}
+
+void
+pandora_qrtr_close(struct pandora_qrtr_port *port)
+{
+	struct pq_control_message gone = { .command = QRTR_DEL_CLIENT, .words = { QRTR_US, port ? port->number : 0 } };
+	bool outside = current_thread() != pandora_qrtr_link_thread;
+
+	if (port == NULL || port->number == 0) {
+		return;
+	}
+	if (outside) {
+		lck_mtx_lock(&pq_calling);            /* (a callback of the port's that is running ends first) */
+	}
+	lck_mtx_lock(&pq_lock);
+	port->number = 0;
+	lck_mtx_unlock(&pq_lock);
+	if (outside) {
+		lck_mtx_unlock(&pq_calling);
+	}
+	if (pq_peer != 0 && pq_qrtr_channel() != NULL) {
+		pandora_mpss_qrtr_out_packet(QRTR_DEL_CLIENT, gone.words[1], pq_peer, QRTR_CONTROL, &gone, sizeof(gone));
+	}
+}
+
+static const struct pandora_qrtr_ops qrtr_ops = { .open = pandora_qrtr_open, .send = pandora_mpss_qrtr_send, .lookup = pandora_qrtr_lookup, .close = pandora_qrtr_close };
+
+/* The modem's QRTR for the rest of the kernel: NULL until the link is up (sys/hakios.qrtr.h). */
+const struct pandora_qrtr_ops *
+pandora_mpss_qrtr(void)
+{
+	return pq_qrtr_channel() != NULL ? &qrtr_ops : NULL;
+}
+
+/*
+ * A port's number: its first field (:3083), which rmtfs_start() publishes as the service's port.
+ * PORTER'S NOTE (not in the source's range): a one-line accessor, because pandora_rmtfs.c had to
+ * foward-declare struct pandora_qrtr_port before pandora_qrtr.h existed.
+ */
+uint32_t
+pandora_qrtr_port_number(const struct pandora_qrtr_port *port)
+{
+	return port->number;
+}
+
+/*
+ * ---- deviations from a mechanical rename, quoted ----------------------------------------------
+ *
+ * 1. glink_send() and glink.channel[CHANNEL_QRTR]. (:3135, :3417, :3428)
+ *      error = glink_send(&glink.channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+ *      if (qrtr_peer != 0 && glink.channel[CHANNEL_QRTR].open) {
+ *      return glink.channel[CHANNEL_QRTR].open ? &qrtr_ops : NULL;
+ *    glink is pandora_mpss.c's, so the channel comes from pandora_mpss_glink_channel("IPCRTR") and the
+ *    send becomes pandora_mpss_glink_send(that channel, ...). The source's ".open" test becomes the
+ *    channel being non-NULL.
+ *
+ * 2. struct qrtr_header / struct qrtr_control (:3074, :3077) are struct pq_header /
+ *    struct pq_control_message. PORTER'S NOTE: forced -- qrtr_control() is a function in this block,
+ *    and pandora_rmtfs.c defines its own struct pandora_qrtr_control for the same wire format.
+ *
+ * 3. our_servers[] (:3106) is pandora_our_servers[4]: declared in pandora_modem.h, stored in
+ *    pandora_rmtfs.c (:105), filled in by rmtfs_start() (:3995). The counters beside it
+ *    (rmtfs_requests ... servreg_requests, :3108-3109) stayed with the blocks that use them and are
+ *    pandora_rmtfs.c's as well. The declaration and its comment are the only lines of the range that
+ *    are not here.
+ *
+ * 4. qrtr_announce() and qrtr_announce_all() (:3955, :3967) have bodies OUTSIDE the range but are
+ *    called by qrtr_control() at :3189, :3238 and :3242; they are pandora_rmtfs.c's here (it owns the
+ *    services they announce), declared in pandora_qrtr.h and not copied.
+ *
+ * 5. printf() (:3134, :3155, :3168, :3188, :3214, :3219, :3250) is pandora_say() from pandora_mpss.c.
+ *    No sleep_us(), now_us() or option() call occurs anywhere in 3056-3433, so none is declared.
+ *
+ * 6. mpss_lock_group (:3094-3095) is pq_grp, this file's own group: nothing outside the block touches
+ *    these two mutexes.
+ *
+ * ---- the extern symbols this file leaves undecided --------------------------------------------
+ *
+ * From bsd/dev/pandora_mpss.c (declared at the head of this file):
+ *
+ *   struct pandora_glink_channel;   opaque; HakiOS's struct glink_channel
+ *   pandora_mpss_glink_channel()    the IPCRTR channel, NULL until open
+ *   pandora_mpss_glink_send()       one datagram on it (was static glink_send(), :3004)
+ *   pandora_say()                   printf() in this block (was say(), :131)
+ *
+ * From bsd/dev/pandora_modem.h, either side:
+ *
+ *   pandora_our_servers[4]          the four services we publish (was our_servers[], :3106); storage
+ *                                   in pandora_rmtfs.c
+ *   pandora_ipa_host_port           the IPA's host port, stored here
+ *
+ * From bsd/dev/pandora_rmtfs.c (declared in pandora_qrtr.h):
+ *
+ *   pandora_qrtr_announce()         one of our servers told to a node (:3955)
+ *   pandora_qrtr_announce_all()     all of them that have a port (:3967)
+ *
+ * From the kernel, included above:
+ *
+ *   kalloc_data() kfree_data() Z_WAITOK Z_ZERO          <kern/kalloc.h>
+ *   lck_mtx_lock() lck_mtx_unlock() LCK_GRP_DECLARE LCK_MTX_DECLARE   <kern/locks.h>
+ *   current_thread() thread_t                           <kern/thread.h>
+ *   memcpy() bzero()                                    libkern's, force-included by the build
+ *   EMSGSIZE ENOMEM EINVAL ENOSPC                       <sys/errno.h>
+ *
+ * And this file defines, for the rest of the port:
+ *
+ *   pandora_qrtr_open()             a port of our node and its callbacks (:3356)
+ *   pandora_mpss_qrtr_send()        one QRTR_DATA datagram on a port (:3376)
+ *   pandora_qrtr_lookup()           a service looked up on a port (:3385)
+ *   pandora_qrtr_close()            the port given up, and DEL_CLIENT said if the link is up (:3404)
+ *   pandora_qrtr_port_number()      a port's number, its first field (:3083)
+ *   pandora_mpss_qrtr_out_packet()  one datagram of any type (:3114)
+ *   pandora_qrtr_input()            one message in from the link (:3256)
+ *   pandora_qrtr_fresh()            the lookups made since the last look (:3326)
+ *   pandora_mpss_qrtr()             the ops table, NULL until the channel is open (:3429)
+ *   pandora_qrtr_link_thread        the link thread's thread_t, set by the caller's link thread
+ *                                   (HakiOS :5078) so that close() can tell a call from inside a
+ *                                   callback (:3407) from one outside it
+ */
diff --git a/bsd/dev/pandora_qrtr.h b/bsd/dev/pandora_qrtr.h
new file mode 100644
index 0000000..db426f7
--- /dev/null
+++ b/bsd/dev/pandora_qrtr.h
@@ -0,0 +1,114 @@
+/*
+ * PANDORA QRTR: the port a caller holds, the two callbacks it is given, and the calls the QRTR block
+ * of bsd/dev/pandora_qrtr.c answers.
+ *
+ * The interface half is HakiOS's sys/hakios.qrtr.h one for one and in its order, with hakios_qrtr_*
+ * renamed pandora_qrtr_*: the receive and server callback types, struct pandora_qrtr_ops with its four
+ * commented members, and the four calls it describes. struct pandora_qrtr_port comes with them rather
+ * than beside them -- in HakiOS it is defined in the middle of hakios.mpss.c (:3082), but a caller on
+ * this side has to see its first field. No field was added, dropped or reordered.
+ *
+ * pandora_qrtr.c is the QRTR port itself: pandora_mpss.c feeds it the link's messages and pumps it,
+ * pandora_rmtfs.c and pandora_ipa.c open ports on it.
+ */
+#ifndef _BSD_DEV_PANDORA_QRTR_H_
+#define _BSD_DEV_PANDORA_QRTR_H_
+
+#if defined(PANDORA)
+
+#include <sys/types.h>
+#include <kern/thread.h>
+
+/* ---- the interface (HakiOS sys/hakios.qrtr.h, renamed) ---------------------------------------------- */
+
+struct pandora_qrtr_port;
+
+/*
+ * A datagram arrived at one of our ports: from (node, port), length bytes at data, which is only
+ * valid for the duration of the call.
+ */
+typedef void (*pandora_qrtr_receive_t)(void *context, uint32_t node, uint32_t port, const void *data,
+    size_t length);
+
+/*
+ * A service we looked up came (arrived) or went: service, and the version and instance as the wire
+ * has them, at (node, port).
+ */
+typedef void (*pandora_qrtr_server_t)(void *context, bool arrived, uint32_t service, uint32_t version,
+    uint32_t instance, uint32_t node, uint32_t port);
+
+/*
+ * The QRTR port, as HakiOS defines it at hakios.mpss.c:3082 with no field changed: number is 0 when the
+ * port is free, the table is sixteen of these (pq_ports), and the number is what a service is
+ * published under. Opaque to everything but pandora_qrtr.c, but for the number.
+ */
+struct pandora_qrtr_port {
+	uint32_t number;                        /* 0: free */
+	pandora_qrtr_receive_t receive;         /* a datagram arrived at this port */
+	pandora_qrtr_server_t server;           /* a lookup of ours got an answer */
+	void *context;
+	struct {
+		uint32_t service, instance;     /* the instance as on the wire: version | instance << 8; 0: any */
+		bool asked;
+		bool fresh;                     /* not yet told of the services that were there before it */
+	} lookups[4];
+};
+
+struct pandora_qrtr_ops {
+	/* A port of our node, with these callbacks; NULL when the table is full. */
+	struct pandora_qrtr_port * (*open)(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server,
+	    void *context);
+	/* One datagram to (node, port) on this port; 0, or an errno. */
+	int (*send)(struct pandora_qrtr_port *port, uint32_t node, uint32_t to_port, const void *data,
+	    size_t length);
+	/* Have this port told of a service, from now on and of those already there; 0, or an errno. */
+	int (*lookup)(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance);
+	/* Give the port up: no callback comes after this returns. */
+	void (*close)(struct pandora_qrtr_port *port);
+};
+
+/*
+ * The same four calls for callers that hold the port rather than the table. pandora_qrtr.c defines
+ * them all; pandora_mpss_qrtr() is the table, NULL until the link's IPCRTR channel is open.
+ */
+struct pandora_qrtr_port *pandora_qrtr_open(pandora_qrtr_receive_t receive, pandora_qrtr_server_t server,
+    void *context);
+int pandora_mpss_qrtr_send(struct pandora_qrtr_port *port, uint32_t node, uint32_t to, const void *data,
+    size_t length);
+int pandora_qrtr_lookup(struct pandora_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance);
+void pandora_qrtr_close(struct pandora_qrtr_port *port);
+
+/* A port's number: its first field, for callers that publish a service on it (:3083). */
+uint32_t pandora_qrtr_port_number(const struct pandora_qrtr_port *port);
+
+/* One datagram of any type, the control port's included (:3114). */
+int pandora_mpss_qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port,
+    const void *data, uint32_t length);
+
+/* The link's side: one message in (:3256), and the lookups made since the last look (:3326). */
+void pandora_qrtr_input(const uint8_t *data, uint32_t length);
+void pandora_qrtr_fresh(void);
+
+/* The table, or NULL until the channel is open (:3429). */
+const struct pandora_qrtr_ops *pandora_mpss_qrtr(void);
+
+/*
+ * The link thread's thread_t, which the caller's link thread sets (HakiOS hakios.mpss.c:5078) so that
+ * pandora_qrtr_close() can tell a call from inside a callback (:3407) from one outside it.
+ */
+extern thread_t pandora_qrtr_link_thread;
+
+/* ---- what this file takes from the rest of the modem stack ------------------------------------------ */
+
+/*
+ * Our services announced to a node on the control port: one of pandora_our_servers[] (pandora_modem.h,
+ * stored in pandora_rmtfs.c), or, with end, the empty "new server" that ends an answer to a lookup.
+ * HakiOS's qrtr_announce() and qrtr_announce_all() (:3955, :3967), which bsd/dev/pandora_rmtfs.c
+ * defines here because it owns the services they announce.
+ */
+void pandora_qrtr_announce(uint32_t node, unsigned server, bool end);
+void pandora_qrtr_announce_all(uint32_t node);
+
+#endif /* PANDORA */
+
+#endif /* _BSD_DEV_PANDORA_QRTR_H_ */
diff --git a/bsd/dev/pandora_rmtfs.c b/bsd/dev/pandora_rmtfs.c
new file mode 100644
index 0000000..59b11cf
--- /dev/null
+++ b/bsd/dev/pandora_rmtfs.c
@@ -0,0 +1,1373 @@
+/*
+ * PANDORA: the modem's file systems for SM8850 "canoe" -- RMTFS, TFTP over QRTR, and the service
+ * registry's locator (pd-mapper).
+ *
+ * This is one self-contained block of HakiOS's hakios.mpss.c, mechanically ported:
+ *
+ *   upstream-fetch/hakios/drivers/modem/hakios.mpss.c lines ~3490 - ~4700
+ *     rmtfs_load, rmtfs_buffer_make, rmtfs_share, qmi_tlv, rmtfs_receive, qrtr_announce,
+ *     qrtr_announce_all, rmtfs_start, rmtfs_stop, tftp_error, tftp_transfer_end,
+ *     tftp_send_window, tftp_transfer_receive, tftp_file_of, tftp_receive, jsn_string,
+ *     servreg_load, servreg_receive, with their structs, globals and constants.
+ *
+ * (The source block also forward-declares tftp_receive and servreg_receive, and reaches into the
+ * IPA handshake's ipa_qmi_start/ipa_qmi_stop/ipa_host_port, which stay where they are; see the
+ * "declared, not copied" list below.)
+ *
+ * What changed, and only this:
+ *
+ *   1. Every rmtfs_*, tftp_*, servreg_*, qmi_tlv, jsn_string and qrtr_announce* identifier, and
+ *      every constant in the block, carries the pandora_/PANDORA_ prefix, so the block can be
+ *      linked beside pandora_mpss.c and the other bsd/dev/qcom code.
+ *   2. THE ONE LOGIC CHANGE -- the buffer's physical address. HakiOS's
+ *
+ *          #define RMTFS_BUFFER_PA_DEFAULT 0x9c700000ull
+ *
+ *      is a window into Redwood's reserved-memory cdsp@9c700000, and THAT REGION DOES NOT EXIST
+ *      ON CANOE. Canoe reserves cdsp_region@9b500000+0x1900000 instead, and canoe's own
+ *      /soc/qcom,rmtfs_sharedmem@0 node carries reg = <0x0 0x400000>, a placeholder that the
+ *      bootloader patches at boot -- not a usable address in a local DTB. The driver relocates
+ *      that node at boot, so the address must be an input, never a constant. On the observed
+ *      device the live region is at 0xd3900000, size 0x400000, as /sys/class/uio/uio0/maps/map0
+ *      reports it. Therefore:
+ *
+ *          modem_buffer       physical address of the buffer            REQUIRED
+ *          modem_buffer_size  its size, default 0x400000 (4 MiB)        optional
+ *
+ *      With no modem_buffer the buffer is never mapped, the share call prints a diagnostic and
+ *      returns false, and TrustZone is never handed a phantom range. Everything downstream
+ *      (ALLOC_BUFF, the RW_IOVEC bounds check, page->size) uses the boot-arg size, so 4 MiB and
+ *      HakiOS's 2.5 MiB both work as long as the size matches what the modem asks for.
+ *      The substituted code is pandora_rmtfs_buffer_make() and the guard at the top of
+ *      pandora_rmtfs_share(); both are marked "CANOE".
+ *   3. Functions that pandora_mpss.c calls from its step machine are no longer static (see
+ *      "exported" below), and the counters link_stop() prints are defined here.
+ *
+ * Everything else is byte-identical: the same QMI answer layout, the same QRTR announcement and
+ * lookup-terminator behaviour, the same TFTP option parsing and OACK order, the same servreg TLV
+ * build, the same tabs and the same comments. The log lines keep their "mpss:" prefix so this
+ * file diffs cleanly against the source it came from.
+ *
+ * Not here, on purpose (declared as extern, not copied):
+ *
+ *   struct pandora_qrtr_port          the QRTR port (pandora_qrtr.h -- that header does not exist
+ *                                     in the tree yet, so the struct is forward-declared below)
+ *   pandora_mpss_qrtr_send()          qrtr_send(): one datagram to (node, port)
+ *   pandora_qrtr_open/close()         qrtr_open()/qrtr_close()
+ *   pandora_mpss_qrtr_out_packet()    qrtr_out_packet(): a control-port datagram
+ *   pandora_our_servers[4]            our_servers[4] of hakios.mpss.c:3106, which the control port
+ *                                     answers lookups from
+ *   pandora_step, pandora_option, pandora_say, pandora_tell, pandora_announce, pandora_settle,
+ *   pandora_sleep_ms, pandora_scm, pandora_root_file, pandora_ufs_read_partition,
+ *   pandora_ipa_qmi_start/stop, pandora_ipa_host_port
