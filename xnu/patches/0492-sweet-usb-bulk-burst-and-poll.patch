 {
-	/* The Apple function runs at packet granularity so that a bulk transfer
-	 * never depends on the host appending a zero-length packet. The mux
-	 * layer does the reassembly. */
-	ud.rx_req = ud.personality == UD_APPLE ? 512 : UD_FRAME_MAX;
-	printf("SWEET USB: rx arm %u bytes\n", ud.rx_req);
+	/*
+	 * One bulk transfer per frame is what kept the pipe at 512 bytes per
+	 * poll round.  Asking for UD_RX_MAX instead lets the host push a whole
+	 * 16 KiB burst (many 512-byte packets, one TRB) before we look again;
+	 * the mux layer reassembles the pieces.  A host that stops mid-packet
+	 * still completes the transfer with a short length, so no ZLP is needed.
+	 */
+	ud.rx_req = ud.personality == UD_APPLE ? UD_RX_MAX : UD_FRAME_MAX;
+	if (ud.rx_frames < 12) {
+		printf("SWEET USB: rx arm %u bytes\n", ud.rx_req);
+	}
 	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, ud.rx_req, TRBCTL_NORMAL);
 }
 
