+				for (uint32_t y = 0; y < fHeight / 3; y++) {
+					uint32_t *row = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+					for (uint32_t x = 0; x < fWidth; x++) {
+						row[x] = bars[(x * 6) / fWidth];
+					}
+				}
+				__asm__ volatile ("dsb sy" ::: "memory");
+			}
+		}
 		last = mach_absolute_time();
 		(void)scanPanel();      /* 0555: retry until the panel memory is scanned */
 		(void)scanSettle();
