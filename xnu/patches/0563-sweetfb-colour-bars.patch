 			(void)pandora_gpu_wait(seq, 500 * NSEC_PER_MSEC);   /* at most 0.5 s */
 		}
 		present(rec);
+		/* 0563: calibration frame, after composition so the bars reach the panel. */
+		{
+			static int cbars = -1;
+			if (cbars < 0) {
+				cbars = 0;
+				PE_parse_boot_argn("pandora_cbars", &cbars, sizeof(cbars));
+				if (cbars) {
+					printf("PANDORA CBARS: memory bars R,G,B,C,M,Y (BGRA words)\n");
+				}
+			}
+			if (cbars) {
+				static const uint32_t bars[6] = {
+					0xffff0000u, 0xff00ff00u, 0xff0000ffu,
+					0xff00ffffu, 0xffff00ffu, 0xffffff00u,
