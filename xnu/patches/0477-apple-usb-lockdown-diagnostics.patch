+/*
+ * Bounded printable dump of a request body that carried no parsable Request
+ * key.  Non-printable bytes become '.' so the log line stays one line.
+ */
+static void
+lock_dump_body(const char *buf, uint32_t len)
+{
+	char out[49];
+	uint32_t n = len < 48 ? len : 48;
+
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = (buf[i] >= 0x20 && buf[i] < 0x7f) ? buf[i] : '.';
+	}
+	out[n] = '\0';
+	printf("APPLE LOCKDOWN: body %s\n", out);
+}
