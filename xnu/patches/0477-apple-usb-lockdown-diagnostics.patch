+/*
+ * The mux version declared in version_reply().  Apple's AMDS probes with
+ * major=1 and abandons a device that answers v2, while every v2-capable host
+ * (libimobiledevice, mux_client.py) adapts to whatever we declare.  v2 is the
+ * documented wire format (docs/usb/APPLE_USB_PROTOCOL_RESEARCH.md section 3),
+ * so we keep declaring it; real AMDS support would mean replying 1 to a
+ * major=1 probe and switching every frame to the 8-byte v1 header.
+ * (The "0471 mux-v1" patch only renamed a log string -- the protocol never
+ * changed, which is why the AMDS probes in the 0470/0471 runs went silent.)
+ */
+#define AMUX_VERSION_MAJOR 2
+
 #define TH_FIN 0x01
 #define TH_SYN 0x02
 #define TH_RST 0x04
