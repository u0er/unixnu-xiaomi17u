+/* Level 20.67 (v2064, 0602): monotonic milliseconds for the 0x19 delay. */
+static uint64_t
+bt_peri_uptime_ms(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+/* Level 20.67 (v2064, 0602): the map A tail gate.
+ *
+ * Called with the last map A byte already on the wire and its timestamp kept
+ * by bt_peri_tlv_stage(). Everything before 0x19 is either a timestamp read or
+ * the BID identity query the HAL itself does before its map; nothing drains,
+ * nothing waits for an ACK, and no reset happens on this path.
+ *
+ * Return 0 when 0x19 answered inside the two windows (map B may open), or
+ * BT_PERI_MAP_A_WITHHOLD when it stayed silent (map B must not be sent). The
+ * caller logs and returns; a withheld map B is a verdict, not an error to
+ * retry inside the same boot. */
+static int
+bt_peri_map_a_tail_gate(unsigned frames, const char *what)
+{
+	uint16_t bid = 0xffffu;
+	int err;
+	unsigned resident = 0;
+	unsigned seq_step = 0;
+
+	if (bt_map_a_last_tx != 0ull) {
+		unsigned d = (unsigned)(bt_peri_uptime_ms() - bt_map_a_last_tx);
+
+		printf("PANDORA BT: %s: 0x19 at +%u ms after map A last byte (%u frames, ack_ms 0, target <= 60 ms)\n",
+		    what, d, frames);
+	} else {
+		printf("PANDORA BT: %s: 0x19 after map A last byte: timestamp unavailable (%u frames, ack_ms 0)\n",
+		    what, frames);
+	}
+	pandora_log_sync();
+	/* BID is an identity query, not a state change: it can run on either side
+	 * of map A and the HAL asks it before its own map. A non-0000 id means the
+	 * wrong NVM variant and is a reason to stop, not to open B. */
+	(void)bt_peri_board_id_download(&bid);
+	printf("PANDORA BT: %s: BID pre %s (id %04x)\n", what,
+	    bid != 0xffffu ? "answered" : "silent", bid);
+	pandora_log_sync();
+	err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_FIRST_MS,
+	    "PERI TME-L map A tail 0x19");
+	if (err) {
+		printf("PANDORA BT: %s: 0x19 silent in the %u ms first window (error %d); second window %u ms\n",
+		    what, BT_PERI_MAP_A_0X19_FIRST_MS, err,
+		    BT_PERI_MAP_A_0X19_WIDE_MS);
+		pandora_log_sync();
+		err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_WIDE_MS,
+		    "PERI TME-L map A tail 0x19 retry");
+	}
+	if (err == 0) {
+		printf("PANDORA BT: %s: VS command 19 answered after map A; map A unproven (no sub-06 ACK), map B open on 0x19 only\n",
+		    what);
+		pandora_log_sync();
+		return 0;
+	}
+	/* Silence. Count what the ROM is doing instead: the resident f0 04
+	 * readback advancing is liveness, and its seq progress is the evidence
+	 * that the stream is the same one 0595 measured. */
+	(void)bt_peri_aseg_last_ack(frames, BT_PERI_MAP_A_TAIL_SCAN_MS,
+	    "PERI TME-L map A resident scan", &resident, &seq_step);
+	printf("PANDORA BT: %s: map A rejected: no sub-06 ACK, 0x19 silent in %u + %u ms, resident f0 04 record(s) %u, seq advanced %u\n",
+	    what, BT_PERI_MAP_A_0X19_FIRST_MS, BT_PERI_MAP_A_0X19_WIDE_MS,
+	    resident, seq_step);
+	pandora_log_sync();
+	(void)bt_peri_board_id_download(&bid);
+	printf("PANDORA BT: %s: BID post %s (id %04x)\n", what,
+	    bid != 0xffffu ? "answered" : "silent", bid);
+	pandora_log_sync();
+	if (bt_map_a_reset_arm >= 2 && bid == 0u) {
+		int r;
+
+		printf("PANDORA BT: %s: reset arm 2: reset -> arbitrate v3 -> version v3 -> GetVer(00) -> BID post -> full map A replay (%u frames) -> 0x19\n",
+		    what, frames);
+		pandora_log_sync();
+		r = bt_peri_reset();
+		if (r == 0) {
+			r = bt_peri_arbitrate_v3();
+		}
+		if (r == 0) {
+			r = bt_peri_version_v3();
+		}
+		if (r == 0) {
+			r = bt_peri_getver_window(700u);
+		}
+		if (r == 0) {
+			r = bt_peri_tlv_stage(pandora_peri_tmel_elf,
+			    sizeof(pandora_peri_tmel_elf),
+			    "PERI TME-L map A replay", 0x03, 0u);
+		}
+		if (r == 0) {
+			r = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_FIRST_MS,
+			    "PERI TME-L map A replay 0x19");
+		}
+		if (r != 0) {
+			r = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_WIDE_MS,
+			    "PERI TME-L map A replay 0x19 retry");
+		}
+		if (r == 0) {
+			printf("PANDORA BT: %s: reset recovered: map A replayed %u frames, 0x19 answered; map B open on the replay\n",
+			    what, frames);
+			pandora_log_sync();
+			return 0;
+		}
+		printf("PANDORA BT: %s: ROM DEAD after reset (chain stopped at error %d); map B stays withheld, needs a reboot\n",
+		    what, r);
+		pandora_log_sync();
+	}
+	printf("PANDORA BT: %s: map B withheld (0x19 silent, BID %04x, resident f0 04 seq advanced %u, %u frames already sent)\n",
+	    what, bid, seq_step, frames);
+	pandora_log_sync();
+	return BT_PERI_MAP_A_WITHHOLD;
+}
