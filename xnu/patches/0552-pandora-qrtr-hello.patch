 int pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length);
 int
 pandora_mpss_glink_send(struct pandora_glink_channel *channel, const void *data, uint32_t length)
 {
+	/*
+	 * 0552: a channel opened on another subsystem's link is sent on THAT link's gl.  Sending
+	 * it through mp_gl wrote to the modem's FIFO, which this boot never created (step 10
+	 * FAILED), so qcom_glink_send() returned argument error and the HELLO that came in on
+	 * the ADSP was answered into nothing.
+	 */
+	if (channel != NULL && (QcomGlinkChannel *)channel == mp_qrtr_attached_channel &&
+	    mp_qrtr_attached_gl != NULL) {
+		return qcom_glink_send(mp_qrtr_attached_gl, (QcomGlinkChannel *)channel, data, length);
+	}
 	return qcom_glink_send(&mp_gl, (QcomGlinkChannel *)channel, data, length);
 }
 
