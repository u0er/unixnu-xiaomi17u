-	return (struct pandora_glink_channel *)channel;
+	if (channel != NULL && channel->up && strcmp(channel->name, name) == 0) {
+		return (struct pandora_glink_channel *)channel;
+	}
+	/*
+	 * 0552: when step 10 failed there is no modem channel, and the only IPCRTR is the one
+	 * pandora_qrtr_attach() opened on the ADSP's link.  The QRTR block asks by name and cannot
+	 * tell the two links apart, so the attached channel stands in for the modem's.
+	 */
+	channel = mp_qrtr_attached_channel;
