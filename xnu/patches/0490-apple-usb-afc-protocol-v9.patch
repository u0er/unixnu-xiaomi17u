+static uint32_t
+afc_volume_kv(char *buf, uint32_t cap, uint32_t n, bool full)
+{
+	struct vfsstatfs *sfs = NULL;
+	char num[32];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+
+	if (vnode_lookup(AFC_ROOT, 0, &vp, vctx) == 0) {
+		mount_t mp = vnode_mount(vp);
+		if (mp != NULL) {
+			sfs = vfs_statfs(mp);
+		}
+		vnode_put(vp);
+	}
+	if (sfs == NULL) {
+		snprintf(num, sizeof(num), "%llu", (unsigned long long)(128ULL << 30));
+		n = afc_kv(buf, cap, n, "FSTotalBytes", num);
+		snprintf(num, sizeof(num), "%llu", (unsigned long long)(64ULL << 30));
+		n = afc_kv(buf, cap, n, "FSFreeBytes", num);
+		n = afc_kv(buf, cap, n, "FSBlockSize", "4096");
+		return n;
+	}
+	snprintf(num, sizeof(num), "%llu",
+	    (unsigned long long)sfs->f_blocks * (unsigned long long)sfs->f_bsize);
+	n = afc_kv(buf, cap, n, "FSTotalBytes", num);
+	snprintf(num, sizeof(num), "%llu",
+	    (unsigned long long)sfs->f_bavail * (unsigned long long)sfs->f_bsize);
+	n = afc_kv(buf, cap, n, "FSFreeBytes", num);
+	snprintf(num, sizeof(num), "%u", sfs->f_bsize);
+	n = afc_kv(buf, cap, n, "FSBlockSize", num);
+	if (full) {
+		n = afc_kv(buf, cap, n, "Model", "UniXNU");
+	}
+	return n;
+}
