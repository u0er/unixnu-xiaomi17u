 	btIterator = hfs_malloc_type(struct BTreeIterator);
+	/* 0505: callers now include the catalog read path; fail rather than
+	 * dereference a NULL iterator under memory pressure. */
+	if (btIterator == NULL) {
+		return memFullErr;
+	}
 
 	/* HFS Plus / HFSX */
 	if (vcb->vcbSigWord != kHFSSigWord) {
@@ -1978,3 +1983,34 @@
 	return TRUE;
 }
 
+
+/*
+ * 0505: exported predicate for the catalog reader.  A resident extent record
+ * holds at most eight extents; a fork whose tail lives in the extents overflow
+ * tree is consistent, not corrupt.  The catalog reader must ask that tree
+ * before it clamps totalBlocks and marks the volume inconsistent.
+ *
+ * Returns 0 (the conservative answer, which keeps the historical clamp) when
+ * the extents B-tree is not loaded yet or cannot be searched.
+ */
+int
+hfs_fork_has_overflow_extents(struct hfsmount *hfsmp, u_int8_t forkType,
+                              u_int32_t fileID, u_int32_t startBlock)
+{
+	HFSPlusExtentKey	foundKey;
+	HFSPlusExtentRecord	foundData;
+
+	if (hfsmp == NULL || hfsmp->extentsRefNum <= 0) {
+		return 0;
+	}
+	bzero(&foundKey, sizeof(foundKey));
+	bzero(&foundData, sizeof(foundData));
+	if (FindExtentRecord((const ExtendedVCB *)hfsmp, forkType, fileID,
+	                     startBlock, FALSE, &foundKey,
+	                     foundData, NULL) != noErr) {
+		return 0;
+	}
+	return (foundKey.fileID == fileID &&
+	        foundKey.forkType == forkType &&
+	        foundKey.startBlock == startBlock) ? 1 : 0;
+}
