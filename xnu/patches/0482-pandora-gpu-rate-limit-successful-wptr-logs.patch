--- a/bsd/dev/pandora_gpu.c
+++ b/bsd/dev/pandora_gpu.c
@@ -1524,8 +1524,12 @@ ring_kick(void)
 		if (!(gmu_rd(GMU_AHB_FENCE_STATUS) & 1)) {
 			break;
 		}
 		delay(10);
 	} while (++tries < 200);
