+static void
+bt_peri_records_line(const char *what, const struct bt_peri_record_scan *r)
+{
+	printf("PANDORA BT: %s: stream records: %u record(s), %u f0 04, "
+	    "seq %04x..%04x, step +1 %u/%u, resync %u, plen!=252 %u\n",
