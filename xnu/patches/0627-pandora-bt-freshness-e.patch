+/* 0627 (v2071): O(1) parser for the 34 00 ff record stream. Fed one byte at
+ * a time from the same bytes the drain/post/grace windows already consume;
+ * no second pass, no buffer growth, and no ACK decision depends on it.
+ *
+ *   record := 34 00 ff <plen> <body[plen]>
+ *   body[0..1] == f0 04 -> seq = body[2] | (body[3] << 8)
+ *
+ * A mismatch re-enters at the current byte when it is 0x34, else at HUNT.
+ * resync counts bytes discarded by that rule; plen_bad counts records whose
+ * plen is not the ROM's 252; truncated is set when a window ends inside a
+ * record. */
+struct bt_peri_record_scan {
+	unsigned state;		/* 0 hunt, 1 b1, 2 b2, 3 plen, 4 body */
+	unsigned plen;
+	unsigned need;
+	unsigned idx;
+	unsigned char body[4];
+	unsigned records;
+	unsigned f004;
+	unsigned f005;
+	unsigned other;
+	unsigned nonf0;
+	unsigned zero_plen;
+	unsigned plen_bad;
+	unsigned resync;
+	unsigned truncated;
+	unsigned first_seq;
+	unsigned last_seq;
+	unsigned have_seq;
+	unsigned step1;
+	unsigned step_total;
+};
+
+static void
+bt_peri_record_scan_reset(struct bt_peri_record_scan *r)
+{
+	memset(r, 0, sizeof(*r));
+}
+
+static void
+bt_peri_record_scan_classify(struct bt_peri_record_scan *r)
+{
+	unsigned seq;
+
+	r->records++;
+	if (r->plen != 252u) {
+		r->plen_bad++;
+	}
+	if (r->body[0] != 0xf0u) {
+		r->nonf0++;
+		return;
+	}
+	if (r->body[1] == 0x05u) {
+		r->f005++;
+		return;
+	}
+	if (r->body[1] != 0x04u) {
+		r->other++;
+		return;
+	}
+	r->f004++;
+	seq = (unsigned)r->body[2] | ((unsigned)r->body[3] << 8);
+	if (!r->have_seq) {
+		r->first_seq = seq;
+		r->have_seq = 1u;
+	} else {
+		unsigned d = (seq - r->last_seq) & 0xffffu;
+
+		r->step_total++;
+		if (d == 1u) {
+			r->step1++;
+		}
+	}
+	r->last_seq = seq;
+}
+
+static void
+bt_peri_record_scan_feed(struct bt_peri_record_scan *r, unsigned char b)
+{
+	switch (r->state) {
+	case 0u:
+		if (b == 0x34u) {
+			r->state = 1u;
+		} else {
+			r->resync++;
+		}
+		break;
+	case 1u:
+		if (b == 0x00u) {
+			r->state = 2u;
+		} else if (b == 0x34u) {
+			r->resync++;
+		} else {
+			r->resync += 2u;
+			r->state = 0u;
+		}
+		break;
+	case 2u:
+		if (b == 0xffu) {
+			r->state = 3u;
+		} else if (b == 0x34u) {
+			r->resync += 2u;
+			r->state = 1u;
+		} else {
+			r->resync += 3u;
+			r->state = 0u;
+		}
+		break;
+	case 3u:
+		if (b == 0u) {
+			r->zero_plen++;
+			r->state = 0u;
+		} else {
+			r->plen = b;
+			r->need = b;
+			r->idx = 0u;
+			r->state = 4u;
+		}
+		break;
+	default:
+		if (r->idx < 4u) {
+			r->body[r->idx] = b;
+		}
+		r->idx++;
+		if (--r->need == 0u) {
+			bt_peri_record_scan_classify(r);
+			r->state = 0u;
+		}
+		break;
+	}
+}
+
+static void
+bt_peri_record_scan_finish(struct bt_peri_record_scan *r)
+{
+	if (r->state != 0u) {
+		r->truncated++;
+	}
+}
