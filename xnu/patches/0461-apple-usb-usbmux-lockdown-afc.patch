+/*
+ * apple_services.c -- lockdown and AFC services for the UniXNU Apple USB stack.
+ *
+ * lockdown: XML plist request/response over a mux connection on port 62078.
+ * AFC:      "CFA6LPAA" packets over a mux connection on APPLE_AFC_PORT.
+ *
+ * Both are deliberately plaintext: lockdown answers StartSession with
+ * EnableSessionSSL=false, which is a protocol-legal path and keeps a TLS
+ * stack out of the kernel.  See docs/usb/APPLE_USB_PROTOCOL_RESEARCH.md.
+ *
+ * All of this runs in the gadget event thread, so static buffers are safe.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
