+/* ------------------------------------------------------------------ */
+/* byte helpers                                                       */
+/* ------------------------------------------------------------------ */
+
+uint32_t
+apple_be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+uint64_t
+apple_be64(const uint8_t *p)
+{
+	return ((uint64_t)apple_be32(p) << 32) | apple_be32(p + 4);
+}
+
+uint64_t
+apple_le64(const uint8_t *p)
+{
+	uint64_t v = 0;
+
+	for (int i = 7; i >= 0; i--) {
+		v = (v << 8) | p[i];
+	}
+	return v;
+}
+
+void
+apple_put_be32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+void
+apple_put_be16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+void
+apple_put_le64(uint8_t *p, uint64_t v)
+{
+	for (int i = 0; i < 8; i++) {
+		p[i] = (uint8_t)(v >> (8 * i));
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* bounded string builder                                             */
+/* ------------------------------------------------------------------ */
+
+struct abuf {
+	char    *p;
+	uint32_t len;
+	uint32_t cap;
+	bool     ovf;
+};
+
+static void
+ab_init(struct abuf *b, char *buf, uint32_t cap)
+{
+	b->p = buf;
+	b->len = 0;
+	b->cap = cap;
+	b->ovf = false;
+	if (cap != 0) {
+		buf[0] = '\0';
+	}
+}
+
+static void
+ab_raw(struct abuf *b, const char *s, uint32_t n)
+{
+	if (b->ovf || b->len + n >= b->cap) {
+		b->ovf = true;
+		return;
+	}
+	memcpy(b->p + b->len, s, n);
+	b->len += n;
+	b->p[b->len] = '\0';
+}
+
+static void
+ab_puts(struct abuf *b, const char *s)
+{
+	ab_raw(b, s, (uint32_t)strlen(s));
+}
+
+static void
+ab_kv_str(struct abuf *b, const char *k, const char *v)
+{
+	ab_puts(b, "<key>");
+	ab_puts(b, k);
+	ab_puts(b, "</key><string>");
+	ab_puts(b, v != NULL ? v : "");
+	ab_puts(b, "</string>");
+}
+
+static void
+ab_kv_int(struct abuf *b, const char *k, long long v)
+{
+	char tmp[32];
+
+	snprintf(tmp, sizeof(tmp), "%lld", v);
+	ab_puts(b, "<key>");
+	ab_puts(b, k);
+	ab_puts(b, "</key><integer>");
+	ab_puts(b, tmp);
+	ab_puts(b, "</integer>");
+}
+
+static void
+ab_kv_bool(struct abuf *b, const char *k, int v)
+{
+	ab_puts(b, "<key>");
+	ab_puts(b, k);
+	ab_puts(b, v ? "</key><true/>" : "</key><false/>");
+}
+
+static void
+ab_wrap_begin(struct abuf *b)
+{
+	ab_puts(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\"><dict>");
+}
+
+static void
+ab_wrap_end(struct abuf *b)
+{
+	ab_puts(b, "</dict></plist>\n");
+}
+
+/* ------------------------------------------------------------------ */
+/* very small plist reader                                            */
+/* ------------------------------------------------------------------ */
+
+static const char *
+mem_find(const char *hay, uint32_t haylen, const char *needle)
+{
+	uint32_t n = (uint32_t)strlen(needle);
+
+	if (n == 0 || haylen < n) {
+		return NULL;
+	}
+	for (uint32_t i = 0; i + n <= haylen; i++) {
+		if (memcmp(hay + i, needle, n) == 0) {
+			return hay + i;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Find <key>KEY</key> and return the text of the element that follows.
+ * Handles <string>, <integer>, <real>, <true/> and <false/>.
+ */
+static int
+plist_get(const char *xml, uint32_t len, const char *key, char *out, uint32_t outcap)
+{
+	char tag[96];
+	const char *p, *end;
+	uint32_t n;
+
+	snprintf(tag, sizeof(tag), "<key>%s</key>", key);
+	p = mem_find(xml, len, tag);
+	if (p == NULL) {
+		return 0;
+	}
+	end = xml + len;
+	p += strlen(tag);
+	while (p < end && (*p == ' ' || *p == '\n' || *p == '\t' || *p == '\r')) {
+		p++;
+	}
+	if (p + 8 <= end && memcmp(p, "<string>", 8) == 0) {
+		p += 8;
+		const char *e = mem_find(p, (uint32_t)(end - p), "</string>");
+		if (e == NULL) {
+			return 0;
+		}
+		n = (uint32_t)(e - p);
+		if (n >= outcap) {
+			n = outcap - 1;
+		}
+		memcpy(out, p, n);
+		out[n] = '\0';
+		return 1;
+	}
+	if (p + 9 <= end && memcmp(p, "<integer>", 9) == 0) {
+		p += 9;
+		const char *e = mem_find(p, (uint32_t)(end - p), "</integer>");
+		if (e == NULL) {
+			return 0;
+		}
+		n = (uint32_t)(e - p);
+		if (n >= outcap) {
+			n = outcap - 1;
+		}
+		memcpy(out, p, n);
+		out[n] = '\0';
+		return 1;
+	}
+	if (p + 6 <= end && memcmp(p, "<true/>", 7) == 0) {
+		snprintf(out, outcap, "1");
+		return 1;
+	}
+	if (p + 7 <= end && memcmp(p, "<false/>", 8) == 0) {
+		snprintf(out, outcap, "0");
+		return 1;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* lockdown                                                           */
+/* ------------------------------------------------------------------ */
+
+#define LOCK_PORT        62078
+#define LOCK_BUF         4096
+#define LOCK_SLOTS       2
+
+struct lock_ctx {
+	bool     used;
+	uint32_t len;
+	char     buf[LOCK_BUF];
+};
+
+static struct lock_ctx lock_pool[LOCK_SLOTS];
+static char lock_out[2048];
+static int  lock_paired;
+
+static void
+lock_open(void *conn, void **ctx)
+{
+	for (int i = 0; i < LOCK_SLOTS; i++) {
+		if (!lock_pool[i].used) {
+			lock_pool[i].used = true;
+			lock_pool[i].len = 0;
+			*ctx = &lock_pool[i];
+			printf("APPLE LOCKDOWN: session opened\n");
+			return;
+		}
+	}
+	*ctx = NULL;
+	apple_mux_close(conn);
+}
+
+static void
+lock_close(void *conn, void *ctx)
+{
+	struct lock_ctx *c = (struct lock_ctx *)ctx;
+
+	(void)conn;
+	if (c != NULL) {
+		c->used = false;
+		c->len = 0;
+	}
+	printf("APPLE LOCKDOWN: session closed\n");
+}
+
+static void
+lock_send(void *conn, struct abuf *b)
+{
+	if (b->ovf) {
+		printf("APPLE LOCKDOWN: response truncated\n");
+		return;
+	}
+	(void)apple_mux_send(conn, b->p, b->len);
+}
+
+static void
+lock_empty(void *conn)
+{
+	struct abuf b;
+
+	ab_init(&b, lock_out, sizeof(lock_out));
+	ab_wrap_begin(&b);
+	ab_wrap_end(&b);
+	lock_send(conn, &b);
+}
+
+static void
+lock_error(void *conn, const char *err)
+{
+	struct abuf b;
+
+	ab_init(&b, lock_out, sizeof(lock_out));
+	ab_wrap_begin(&b);
+	ab_kv_str(&b, "Error", err);
+	ab_wrap_end(&b);
+	lock_send(conn, &b);
+}
+
+static const char *
+lock_value_for(const char *key)
+{
+	if (strcmp(key, "ProductVersion") == 0) {
+		return "16.0";
+	}
+	if (strcmp(key, "BuildVersion") == 0) {
+		return "20A000";
+	}
+	if (strcmp(key, "ProductType") == 0) {
+		return "iPhone15,2";
+	}
+	if (strcmp(key, "ProductName") == 0) {
+		return "iPhone OS";
+	}
+	if (strcmp(key, "HardwareModel") == 0) {
+		return "D63AP";
+	}
+	if (strcmp(key, "UniqueDeviceID") == 0) {
+		return "00008120-000A1B2C3D4E5F60";
+	}
+	if (strcmp(key, "UniqueChipID") == 0) {
+		return "1234567890123";
+	}
+	if (strcmp(key, "SerialNumber") == 0) {
+		return "F2LXUNIXNU01";
+	}
+	if (strcmp(key, "ModelNumber") == 0) {
+		return "MQ0E3";
+	}
+	if (strcmp(key, "RegionInfo") == 0) {
+		return "CH/A";
+	}
+	if (strcmp(key, "CPUArchitecture") == 0) {
+		return "arm64e";
+	}
+	return NULL;
+}
+
+static void
+lock_request(void *conn, struct lock_ctx *c)
+{
+	char req[64];
+	char key[64];
+	char svc[96];
+	struct abuf b;
+
+	if (!plist_get(c->buf, c->len, "Request", req, sizeof(req))) {
+		printf("APPLE LOCKDOWN: request without Request key\n");
+		lock_empty(conn);
+		return;
+	}
+
+	if (strcmp(req, "QueryType") == 0) {
+		ab_init(&b, lock_out, sizeof(lock_out));
+		ab_wrap_begin(&b);
+		ab_kv_str(&b, "Type", "com.apple.mobile.lockdown");
+		ab_wrap_end(&b);
+		lock_send(conn, &b);
+		return;
+	}
+	if (strcmp(req, "GetValue") == 0) {
+		const char *v;
+
+		if (!plist_get(c->buf, c->len, "Key", key, sizeof(key))) {
+			lock_empty(conn);
+			return;
+		}
+		v = lock_value_for(key);
+		if (v == NULL) {
+			/* Certificates are not implemented yet; the host treats a
+			 * missing key as "not available" instead of aborting. */
+			printf("APPLE LOCKDOWN: GetValue %s -> unsupported\n", key);
+			lock_empty(conn);
+			return;
+		}
+		ab_init(&b, lock_out, sizeof(lock_out));
+		ab_wrap_begin(&b);
+		ab_kv_str(&b, "Key", key);
+		ab_kv_str(&b, "Value", v);
+		ab_wrap_end(&b);
+		lock_send(conn, &b);
+		return;
+	}
+	if (strcmp(req, "Pair") == 0) {
+		printf("APPLE LOCKDOWN: Pair accepted (no cryptographic pairing)\n");
+		lock_paired = 1;
+		ab_init(&b, lock_out, sizeof(lock_out));
+		ab_wrap_begin(&b);
+		ab_kv_int(&b, "EscrowBag", 0);
+		ab_wrap_end(&b);
+		lock_send(conn, &b);
+		return;
+	}
+	if (strcmp(req, "ValidatePair") == 0 || strcmp(req, "SetValue") == 0) {
+		lock_empty(conn);
+		return;
+	}
+	if (strcmp(req, "StartSession") == 0) {
+		ab_init(&b, lock_out, sizeof(lock_out));
+		ab_wrap_begin(&b);
+		ab_kv_bool(&b, "EnableSessionSSL", 0);
+		ab_kv_str(&b, "SessionID", "1");
+		ab_wrap_end(&b);
+		lock_send(conn, &b);
+		return;
+	}
+	if (strcmp(req, "StartService") == 0) {
+		if (!plist_get(c->buf, c->len, "Service", svc, sizeof(svc))) {
+			lock_error(conn, "InvalidService");
+			return;
+		}
+		if (strcmp(svc, "com.apple.afc") != 0) {
+			printf("APPLE LOCKDOWN: StartService %s unsupported\n", svc);
+			lock_error(conn, "InvalidService");
+			return;
+		}
+		ab_init(&b, lock_out, sizeof(lock_out));
+		ab_wrap_begin(&b);
+		ab_kv_str(&b, "Service", "com.apple.afc");
+		ab_kv_int(&b, "Port", APPLE_AFC_PORT);
+		ab_kv_bool(&b, "EnableServiceSSL", 0);
+		ab_wrap_end(&b);
+		lock_send(conn, &b);
+		printf("APPLE LOCKDOWN: AFC handed out on port %u\n", APPLE_AFC_PORT);
+		return;
+	}
+	printf("APPLE LOCKDOWN: unsupported request %s\n", req);
+	lock_empty(conn);
+}
+
+static void
+lock_input(void *conn, void *ctx, const uint8_t *buf, uint32_t len)
+{
+	struct lock_ctx *c = (struct lock_ctx *)ctx;
+	const char *p;
+	uint32_t end;
+
+	if (c == NULL) {
+		return;
+	}
+	if (len > LOCK_BUF - c->len) {
+		printf("APPLE LOCKDOWN: request too large, dropping\n");
+		c->len = 0;
+		return;
+	}
+	memcpy(c->buf + c->len, buf, len);
+	c->len += len;
+
+	/* One XML document per burst; the host waits for our answer before
+	 * sending the next request, so there is never more than one pending. */
+	p = mem_find(c->buf, c->len, "</plist>");
+	if (p == NULL) {
+		return;
+	}
+	end = (uint32_t)(p - c->buf) + (uint32_t)strlen("</plist>");
+	c->len = end;
+	c->buf[c->len] = '\0';
+	lock_request(conn, c);
+	c->len = 0;
+}
+
+struct apple_service apple_lockdown_service = {
+	.name  = "lockdown",
+	.port  = LOCK_PORT,
+	.open  = lock_open,
+	.input = lock_input,
+	.close = lock_close,
+};
+
+/* ------------------------------------------------------------------ */
+/* AFC                                                                */
+/* ------------------------------------------------------------------ */
+
+#define AFC_ROOT        "/private/var/mobile/Media/UniXNU"
+#define AFC_HDR         40
+#define AFC_BUF         8192
+#define AFC_SLOTS       2
+#define AFC_FILES       16
+#define AFC_IO_MAX      65536
+
+#define AFC_OP_STATUS    0x01
+#define AFC_OP_DATA      0x02
+#define AFC_OP_READ_DIR  0x03
+#define AFC_OP_REMOVE    0x08
+#define AFC_OP_MAKE_DIR  0x09
+#define AFC_OP_FILE_INFO 0x0A
+#define AFC_OP_DEVINFO   0x0B
+#define AFC_OP_FILE_OPEN 0x0D
+#define AFC_OP_FILE_OPEN_RES 0x0E
+#define AFC_OP_FILE_READ 0x0F
+#define AFC_OP_FILE_WRITE 0x10
+#define AFC_OP_FILE_SEEK 0x11
+#define AFC_OP_FILE_TELL 0x12
+#define AFC_OP_FILE_TELL_RES 0x13
+#define AFC_OP_FILE_CLOSE 0x14
+#define AFC_OP_RENAME    0x18
+
+#define AFC_E_SUCCESS    0
+#define AFC_E_UNKNOWN    1
+#define AFC_E_INVALID    7
+#define AFC_E_NOTFOUND   8
+#define AFC_E_ISDIR      9
+#define AFC_E_PERM      10
+#define AFC_E_NOSPACE   18
+#define AFC_E_IO        20
+
+struct afc_file {
+	bool     used;
+	vnode_t  vp;
+	uint64_t off;
+};
+
+struct afc_ctx {
+	bool     used;
+	uint32_t len;
+	uint64_t pktno;
+	char     buf[AFC_BUF];
+	struct afc_file files[AFC_FILES];
+};
+
+static struct afc_ctx afc_pool[AFC_SLOTS];
+static char     afc_out[AFC_HDR + AFC_BUF];
+static uint8_t  afc_io[AFC_IO_MAX];
+static bool     afc_root_ready;
+
+static int
+afc_make_root(void)
+{
+	if (afc_root_ready) {
+		return 0;
+	}
+	(void)pandora_mkdir(AFC_ROOT, 0755);
+	afc_root_ready = true;
+	return 0;
+}
+
+/*
+ * Map an AFC path onto the sandbox.  AFC paths are absolute inside the
+ * sandbox ("/", "/DCIM"); ".." is rejected outright.
+ */
+static int
+afc_path(const char *rel, char *out, size_t cap)
+{
+	size_t n = 0;
+	bool dotdot = false;
+
+	afc_make_root();
+	while (*rel == '/') {
+		rel++;
+	}
+	/* reject any ".." component */
+	for (const char *p = rel; *p != '\0'; p++) {
+		if (p[0] == '.' && p[1] == '.' &&
+		    (p == rel || p[-1] == '/') && (p[2] == '/' || p[2] == '\0')) {
+			dotdot = true;
+			break;
+		}
+	}
+	if (dotdot) {
+		return EPERM;
+	}
+	n = (size_t)snprintf(out, cap, "%s/%s", AFC_ROOT, rel);
+	if (n >= cap) {
+		return ENAMETOOLONG;
+	}
+	return 0;
+}
+
+static void
+afc_reply(void *conn, struct afc_ctx *c, uint64_t op, const void *payload, uint32_t len)
+{
+	uint8_t *h = (uint8_t *)afc_out;
+	uint32_t total = AFC_HDR + len;
+
+	if (len > AFC_BUF) {
+		len = AFC_BUF;
+		total = AFC_HDR + len;
+	}
+	memcpy(afc_out, "CFA6LPAA", 8);
+	apple_put_le64(h + 8, total);
+	apple_put_le64(h + 16, total);
+	apple_put_le64(h + 24, c->pktno++);
+	apple_put_le64(h + 32, op);
+	if (len != 0 && payload != NULL) {
+		memcpy(afc_out + AFC_HDR, payload, len);
+	}
+	(void)apple_mux_send(conn, afc_out, total);
+}
+
+static void
+afc_status(void *conn, struct afc_ctx *c, uint64_t status)
+{
+	uint8_t st[8];
+
+	apple_put_le64(st, status);
+	afc_reply(conn, c, AFC_OP_STATUS, st, sizeof(st));
+}
+
+static int
+afc_errno_to_afc(int err)
+{
+	switch (err) {
+	case 0:
+		return AFC_E_SUCCESS;
+	case ENOENT:
+		return AFC_E_NOTFOUND;
+	case EISDIR:
+		return AFC_E_ISDIR;
+	case EACCES:
+	case EPERM:
+		return AFC_E_PERM;
+	case ENOSPC:
+		return AFC_E_NOSPACE;
+	default:
+		return AFC_E_IO;
+	}
+}
+
+static struct afc_file *
+afc_file_get(struct afc_ctx *c, uint64_t handle)
+{
+	uint32_t idx = (uint32_t)handle;
+
+	if (idx >= AFC_FILES || !c->files[idx].used) {
+		return NULL;
+	}
+	return &c->files[idx];
+}
+
+static struct afc_file *
+afc_file_alloc(struct afc_ctx *c, vnode_t vp)
+{
+	for (uint32_t i = 0; i < AFC_FILES; i++) {
+		if (!c->files[i].used) {
+			c->files[i].used = true;
+			c->files[i].vp = vp;
+			c->files[i].off = 0;
+			return &c->files[i];
+		}
+	}
+	return NULL;
+}
+
+/* Append "key\0value\0" to a buffer, returns the new length. */
+static uint32_t
+afc_kv(char *buf, uint32_t cap, uint32_t off, const char *k, const char *v)
+{
+	uint32_t kn = (uint32_t)strlen(k) + 1;
+	uint32_t vn = (uint32_t)strlen(v) + 1;
+
+	if (off + kn + vn > cap) {
+		return off;
+	}
+	memcpy(buf + off, k, kn);
+	off += kn;
+	memcpy(buf + off, v, vn);
+	off += vn;
+	return off;
+}
+
+static void
+afc_open(void *conn, void **ctx)
+{
+	for (int i = 0; i < AFC_SLOTS; i++) {
+		if (!afc_pool[i].used) {
+			afc_pool[i].used = true;
+			afc_pool[i].len = 0;
+			afc_pool[i].pktno = 0;
+			memset(afc_pool[i].files, 0, sizeof(afc_pool[i].files));
+			*ctx = &afc_pool[i];
+			printf("APPLE AFC: session opened\n");
+			return;
+		}
+	}
+	*ctx = NULL;
+	apple_mux_close(conn);
+}
+
+static void
+afc_close(void *conn, void *ctx)
+{
+	struct afc_ctx *c = (struct afc_ctx *)ctx;
+	vfs_context_t vctx = vfs_context_kernel();
+
+	(void)conn;
+	if (c == NULL) {
+		return;
+	}
+	for (uint32_t i = 0; i < AFC_FILES; i++) {
+		if (c->files[i].used && c->files[i].vp != NULL) {
+			vnode_close(c->files[i].vp, 0, vctx);
+			c->files[i].used = false;
+			c->files[i].vp = NULL;
+		}
+	}
+	c->used = false;
+	c->len = 0;
+	printf("APPLE AFC: session closed\n");
+}
+
+static void
+afc_devinfo(void *conn, struct afc_ctx *c)
+{
+	uint32_t n = 0;
+
+	memset(afc_io, 0, 512);
+	n = afc_kv((char *)afc_io, 512, n, "Model", "UniXNU");
+	n = afc_kv((char *)afc_io, 512, n, "FSTotalBytes", "34359738368");
+	n = afc_kv((char *)afc_io, 512, n, "FSFreeBytes", "17179869184");
+	n = afc_kv((char *)afc_io, 512, n, "FSBlockSize", "4096");
+	afc_reply(conn, c, AFC_OP_DATA, afc_io, n);
+}
+
+static void
+afc_file_info(void *conn, struct afc_ctx *c, const char *rel)
+{
+	char path[512];
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	char num[32];
+	uint32_t n = 0;
+	int err;
+
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_lookup(path, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_type);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_data_size);
+	VATTR_WANTED(&va, va_nlink);
+	VATTR_WANTED(&va, va_modify_time);
+	VATTR_WANTED(&va, va_create_time);
+	err = vnode_getattr(vp, &va, vctx);
+	vnode_put(vp);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+
+	memset(afc_io, 0, 1024);
+	snprintf(num, sizeof(num), "%lld", (long long)va.va_data_size);
+	n = afc_kv((char *)afc_io, 1024, n, "st_size", num);
+	snprintf(num, sizeof(num), "%d", (int)((va.va_data_size + 511) / 512));
+	n = afc_kv((char *)afc_io, 1024, n, "st_blocks", num);
+	snprintf(num, sizeof(num), "%d", (int)va.va_nlink);
+	n = afc_kv((char *)afc_io, 1024, n, "st_nlink", num);
+	n = afc_kv((char *)afc_io, 1024, n, "st_ifmt",
+	    va.va_type == VDIR ? "S_IFDIR" :
+	    va.va_type == VLNK ? "S_IFLNK" : "S_IFREG");
+	snprintf(num, sizeof(num), "%lld", (long long)va.va_modify_time.tv_sec * 1000000000LL);
+	n = afc_kv((char *)afc_io, 1024, n, "st_mtime", num);
+	snprintf(num, sizeof(num), "%lld", (long long)va.va_create_time.tv_sec * 1000000000LL);
+	n = afc_kv((char *)afc_io, 1024, n, "st_birthtime", num);
+	afc_reply(conn, c, AFC_OP_DATA, afc_io, n);
+}
+
+static void
+afc_read_dir(void *conn, struct afc_ctx *c, const char *rel)
+{
+	char path[512];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	UIO_STACKBUF(uio_store, 1);
+	uio_t uio;
+	uint32_t out = 0;
+	int eofflag = 0, numdirent = 0, err;
+
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_lookup(path, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	if (vnode_vtype(vp) != VDIR) {
+		vnode_put(vp);
+		afc_status(conn, c, AFC_E_ISDIR);
+		return;
+	}
+	memset(afc_io, 0, 4096);
+	uio = uio_createwithbuffer(1, 0, UIO_SYSSPACE, UIO_READ, uio_store,
+	    sizeof(uio_store));
+	if (uio == NULL) {
+		vnode_put(vp);
+		afc_status(conn, c, AFC_E_IO);
+		return;
+	}
+	uio_addiov(uio, (user_addr_t)(uintptr_t)afc_io, 4096);
+	err = VNOP_READDIR(vp, uio, 0, &eofflag, &numdirent, vctx);
+	vnode_put(vp);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	{
+		uint32_t used = 4096 - (uint32_t)uio_resid(uio);
+
+		for (uint32_t o = 0; o + sizeof(struct dirent) <= used; ) {
+			struct dirent *dp = (struct dirent *)(void *)(afc_io + o);
+
+			if (dp->d_reclen == 0 || o + dp->d_reclen > used) {
+				break;
+			}
+			if (dp->d_namlen != 0 && dp->d_name[0] != '\0') {
+				uint32_t n = (uint32_t)dp->d_namlen + 1;
+				if (out + n + 1 > 4096) {
+					break;
+				}
+				memcpy(afc_io + out, dp->d_name, n);
+				out += n;
+			}
+			o += dp->d_reclen;
+		}
+	}
+	/* the list is terminated by an empty string */
+	if (out + 1 <= 4096) {
+		afc_io[out++] = '\0';
+	}
+	afc_reply(conn, c, AFC_OP_DATA, afc_io, out);
+}
+
+static void
+afc_file_open(void *conn, struct afc_ctx *c, const char *rel, uint32_t mode)
+{
+	char path[512];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	struct afc_file *f;
+	int flags, err;
+
+	switch (mode) {
+	case 1: flags = FREAD; break;
+	case 2: flags = FREAD | FWRITE; break;
+	case 3: flags = FWRITE | O_CREAT | O_TRUNC; break;
+	case 4: flags = FREAD | FWRITE | O_CREAT | O_TRUNC; break;
+	case 5: flags = FWRITE | O_CREAT | O_APPEND; break;
+	case 6: flags = FREAD | FWRITE | O_CREAT | O_APPEND; break;
+	default: flags = FREAD; break;
+	}
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_open(path, flags, 0644, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	f = afc_file_alloc(c, vp);
+	if (f == NULL) {
+		vnode_close(vp, flags, vctx);
+		afc_status(conn, c, AFC_E_UNKNOWN);
+		return;
+	}
+	{
+		uint8_t h[8];
+		apple_put_le64(h, (uint64_t)(f - &c->files[0]));
+		afc_reply(conn, c, AFC_OP_FILE_OPEN_RES, h, sizeof(h));
+	}
+}
+
+static void
+afc_file_read(void *conn, struct afc_ctx *c, uint64_t handle, uint64_t want)
+{
+	struct afc_file *f = afc_file_get(c, handle);
+	vfs_context_t vctx = vfs_context_kernel();
+	int resid = 0, err;
+
+	if (f == NULL) {
+		afc_status(conn, c, AFC_E_INVALID);
+		return;
+	}
+	if (want > AFC_IO_MAX) {
+		want = AFC_IO_MAX;
+	}
+	if (want == 0) {
+		afc_reply(conn, c, AFC_OP_DATA, NULL, 0);
+		return;
+	}
+	err = vn_rdwr(UIO_READ, f->vp, (caddr_t)(uintptr_t)afc_io, (int)want,
+	    (off_t)f->off, UIO_SYSSPACE, 0, vfs_context_ucred(vctx),
+	    &resid, vfs_context_proc(vctx));
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	{
+		uint32_t got = (uint32_t)((int)want - resid);
+
+		f->off += got;
+		afc_reply(conn, c, AFC_OP_DATA, afc_io, got);
+	}
+}
+
+static void
+afc_file_write(void *conn, struct afc_ctx *c, uint64_t handle, const uint8_t *data,
+    uint32_t len)
+{
+	struct afc_file *f = afc_file_get(c, handle);
+	vfs_context_t vctx = vfs_context_kernel();
+	int resid = 0, err;
+
+	if (f == NULL) {
+		afc_status(conn, c, AFC_E_INVALID);
+		return;
+	}
+	if (len > AFC_IO_MAX) {
+		len = AFC_IO_MAX;
+	}
+	memcpy(afc_io, data, len);
+	err = vn_rdwr(UIO_WRITE, f->vp, (caddr_t)(uintptr_t)afc_io, (int)len,
+	    (off_t)f->off, UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(vctx),
+	    &resid, vfs_context_proc(vctx));
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	f->off += len;
+	afc_status(conn, c, AFC_E_SUCCESS);
+}
+
+static void
+afc_dispatch(void *conn, struct afc_ctx *c, uint64_t op, const uint8_t *pl, uint32_t len)
+{
+	switch (op) {
+	case AFC_OP_DEVINFO:
+		afc_devinfo(conn, c);
+		break;
+	case AFC_OP_READ_DIR:
+		afc_read_dir(conn, c, (const char *)pl);
+		break;
+	case AFC_OP_FILE_INFO:
+		afc_file_info(conn, c, (const char *)pl);
+		break;
+	case AFC_OP_FILE_OPEN: {
+		size_t nlen = strlen((const char *)pl) + 1;
+		uint32_t mode;
+
+		if (len < nlen + 4) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		/* The AFC open payload is "path\0" followed by a little-endian u32. */
+		mode = (uint32_t)pl[nlen] | ((uint32_t)pl[nlen + 1] << 8) |
+		       ((uint32_t)pl[nlen + 2] << 16) | ((uint32_t)pl[nlen + 3] << 24);
+		afc_file_open(conn, c, (const char *)pl, mode);
+		break;
+	}
+	case AFC_OP_FILE_READ:
+		if (len < 16) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		afc_file_read(conn, c, apple_le64(pl), apple_le64(pl + 8));
+		break;
+	case AFC_OP_FILE_WRITE:
+		if (len < 8) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		afc_file_write(conn, c, apple_le64(pl), pl + 8, len - 8);
+		break;
+	case AFC_OP_FILE_CLOSE: {
+		struct afc_file *f;
+
+		if (len < 8) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		f = afc_file_get(c, apple_le64(pl));
+		if (f == NULL) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		vnode_close(f->vp, 0, vfs_context_kernel());
+		f->used = false;
+		f->vp = NULL;
+		afc_status(conn, c, AFC_E_SUCCESS);
+		break;
+	}
+	case AFC_OP_FILE_SEEK: {
+		struct afc_file *f;
+
+		if (len < 16) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		f = afc_file_get(c, apple_le64(pl));
+		if (f == NULL) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		f->off = apple_le64(pl + 8);
+		afc_status(conn, c, AFC_E_SUCCESS);
+		break;
+	}
+	case AFC_OP_FILE_TELL: {
+		struct afc_file *f;
+		uint8_t out[8];
+
+		if (len < 8) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		f = afc_file_get(c, apple_le64(pl));
+		if (f == NULL) {
+			afc_status(conn, c, AFC_E_INVALID);
+			break;
+		}
+		apple_put_le64(out, f->off);
+		afc_reply(conn, c, AFC_OP_FILE_TELL_RES, out, sizeof(out));
+		break;
+	}
+	case AFC_OP_MAKE_DIR: {
+		char path[512];
+
+		if (afc_path((const char *)pl, path, sizeof(path)) != 0) {
+			afc_status(conn, c, AFC_E_PERM);
+			break;
+		}
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(pandora_mkdir(path, 0755)));
+		break;
+	}
+	case AFC_OP_REMOVE: {
+		char path[512];
+		vnode_t vp = NULLVP;
+		vfs_context_t vctx = vfs_context_kernel();
+		int err;
+
+		if (afc_path((const char *)pl, path, sizeof(path)) != 0) {
+			afc_status(conn, c, AFC_E_PERM);
+			break;
+		}
+		err = vnode_lookup(path, 0, &vp, vctx);
+		if (err != 0) {
+			afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+			break;
+		}
+		err = unlink1(vctx, vp, USER_ADDR_NULL, UIO_SYSSPACE, 0);
+		vnode_put(vp);
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		break;
+	}
+	case AFC_OP_RENAME: {
+		char from[512], to[512];
+		size_t n = strlen((const char *)pl) + 1;
+
+		if (afc_path((const char *)pl, from, sizeof(from)) != 0 ||
+		    afc_path((const char *)pl + n, to, sizeof(to)) != 0) {
+			afc_status(conn, c, AFC_E_PERM);
+			break;
+		}
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(pandora_rename(from, to)));
+		break;
+	}
+	default:
+		printf("APPLE AFC: unsupported operation 0x%llx\n", (unsigned long long)op);
+		afc_status(conn, c, AFC_E_UNKNOWN);
+		break;
+	}
+}
+
+static void
+afc_input(void *conn, void *ctx, const uint8_t *buf, uint32_t len)
+{
+	struct afc_ctx *c = (struct afc_ctx *)ctx;
+
+	if (c == NULL) {
+		return;
+	}
+	if (len > AFC_BUF - c->len) {
+		printf("APPLE AFC: packet too large, dropping\n");
+		c->len = 0;
+		return;
+	}
+	memcpy(c->buf + c->len, buf, len);
+	c->len += len;
+
+	for (;;) {
+		uint64_t total, this_len, op;
+		uint32_t plen;
+
+		if (c->len < AFC_HDR) {
+			break;
+		}
+		if (memcmp(c->buf, "CFA6LPAA", 8) != 0) {
+			printf("APPLE AFC: bad magic, resync\n");
+			c->len = 0;
+			break;
+		}
+		total = apple_le64((const uint8_t *)c->buf + 8);
+		this_len = apple_le64((const uint8_t *)c->buf + 16);
+		op = apple_le64((const uint8_t *)c->buf + 32);
+		if (total < AFC_HDR || total > AFC_BUF || this_len < AFC_HDR ||
+		    this_len > total) {
+			printf("APPLE AFC: bad lengths %llu/%llu\n",
+			    (unsigned long long)total, (unsigned long long)this_len);
+			c->len = 0;
+			break;
+		}
+		if (c->len < total) {
+			break;
+		}
+		plen = (uint32_t)(this_len - AFC_HDR);
+		/* keep the request readable for the handler: it is NUL terminated
+		 * only when the host says so, so make sure of it */
+		if (plen != 0) {
+			c->buf[AFC_HDR + plen] = '\0';
+		}
+		afc_dispatch(conn, c, op, (const uint8_t *)c->buf + AFC_HDR, plen);
+		if (c->len > total) {
+			memmove(c->buf, c->buf + total, c->len - total);
+		}
+		c->len -= (uint32_t)total;
+	}
+}
+
+struct apple_service apple_afc_service = {
+	.name  = "afc",
+	.port  = APPLE_AFC_PORT,
+	.open  = afc_open,
+	.input = afc_input,
+	.close = afc_close,
+};
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
