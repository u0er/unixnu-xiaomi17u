diff --git a/bsd/dev/apple_usb.h b/bsd/dev/apple_usb.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/apple_usb.h
@@ -0,0 +1,55 @@
+/*
+ * apple_usb.h -- Apple USB device communication stack for UniXNU.
+ *
+ * Layer boundaries (see docs/usb/APPLE_USB_ARCHITECTURE.md):
+ *
+ *   transport (sweet_usb.c)  <->  mux (apple_usbmux.c)  <->  services
+ *
+ * The transport knows only bytes.  It hands complete bulk-OUT packets to
+ * apple_usbmux_input() and pulls bytes for bulk-IN from apple_usbmux_next_tx().
+ * The mux layer knows frames and connections but not plist or AFC payloads.
+ * Services (lockdown, AFC) know only their own protocol.
+ */
+#ifndef _BSD_DEV_APPLE_USB_H_
+#define _BSD_DEV_APPLE_USB_H_
+
+#include <sys/types.h>
+
+/* ---- transport -> mux ---- */
+void     apple_usbmux_input(const uint8_t *buf, uint32_t len);
+uint32_t apple_usbmux_next_tx(uint8_t *buf, uint32_t maxlen);
+void     apple_usbmux_link_up(void);
+void     apple_usbmux_link_down(void);
+int      apple_usbmux_active(void);
+
+/* ---- services -> mux ---- */
+int  apple_mux_send(void *conn, const void *buf, uint32_t len);
+void apple_mux_close(void *conn);
+
+/*
+ * A service is bound to a device-side TCP port.  open() returns a private
+ * context for the connection (or NULL to refuse it); close() must release it.
+ */
+struct apple_service {
+	const char *name;
+	uint16_t    port;
+	void      (*open)(void *conn, void **ctx);
+	void      (*input)(void *conn, void *ctx, const uint8_t *buf, uint32_t len);
+	void      (*close)(void *conn, void *ctx);
+};
+
+extern struct apple_service apple_lockdown_service;
+extern struct apple_service apple_afc_service;
+
+/* Set by the lockdown service once it hands out the AFC port. */
+#define APPLE_AFC_PORT  0x0F00
+
+/* Shared helpers (apple_services.c) */
+uint32_t apple_be32(const uint8_t *p);
+uint64_t apple_be64(const uint8_t *p);
+uint64_t apple_le64(const uint8_t *p);
+void     apple_put_be32(uint8_t *p, uint32_t v);
+void     apple_put_be16(uint8_t *p, uint16_t v);
+void     apple_put_le64(uint8_t *p, uint64_t v);
+
+#endif /* _BSD_DEV_APPLE_USB_H_ */
diff --git a/bsd/dev/apple_usbmux.c b/bsd/dev/apple_usbmux.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/apple_usbmux.c
@@ -0,0 +1,601 @@
+/*
+ * apple_usbmux.c -- Apple USB multiplexing ("usbmux") device side.
+ *
+ * Wire format (see work/references/apple-usb/usbmuxd-device.c):
+ *
+ *   struct mux_header { u32 protocol; u32 length; u32 magic; u16 tx_seq; u16 rx_seq; }
+ *   magic 0xfeedface, big endian; magic/seq only exist once the device is v2.
+ *
+ * Handshake:
+ *   host -> MUX_PROTO_VERSION {major,minor,padding}   (8-byte header)
+ *   dev  -> MUX_PROTO_VERSION {major=2,minor=0}       (8-byte header)
+ *   host -> MUX_PROTO_SETUP   payload 0x07            (16-byte header, seq reset)
+ *   then MUX_PROTO_TCP: 16-byte mux header + 20-byte tcphdr + payload
+ *
+ * Everything here runs in the gadget's single event thread (ud_thread), so
+ * there are no locks: input, next_tx and the service callbacks never overlap.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/kernel.h>
+#include <libkern/libkern.h>
+#include <vm/vm_kern.h>
+
+#include "apple_usb.h"
+
+#define AMUX_MAX_CONN   8
+#define AMUX_RXBUF      8192
+#define AMUX_RING       16384
+#define AMUX_CTRL_Q     8
+#define AMUX_CTRL_MAX   96
+#define AMUX_TCP_HDR    20
+#define AMUX_MUX_HDR    16
+
+#define MUX_PROTO_VERSION 0
+#define MUX_PROTO_CONTROL 1
+#define MUX_PROTO_SETUP   2
+#define MUX_PROTO_TCP     6
+#define MUX_MAGIC         0xfeedfaceu
+
+#define TH_FIN 0x01
+#define TH_SYN 0x02
+#define TH_RST 0x04
+#define TH_PSH 0x08
+#define TH_ACK 0x10
+
+struct amux_ring {
+	uint8_t *buf;
+	uint32_t cap;
+	uint32_t alloc;         /* bytes actually mapped (round_page(cap)) */
+	uint32_t head;
+	uint32_t count;
+};
+
+struct amux_conn {
+	bool     used;
+	uint16_t sport;         /* device-side port (host's destination port) */
+	uint16_t dport;         /* host-side port */
+	uint32_t tx_seq;
+	uint32_t rx_seq;
+	struct amux_ring in;
+	struct amux_ring out;
+	struct apple_service *svc;
+	void    *ctx;
+};
+
+struct amux_ctrl {
+	uint16_t len;
+	uint8_t  data[AMUX_CTRL_MAX];
+};
+
+static struct {
+	bool     up;
+	bool     neg;
+	bool     active;
+	uint16_t mux_tx_seq;
+	uint16_t mux_rx_seq;
+	uint8_t *rxbuf;
+	uint32_t rxbuf_alloc;
+	uint32_t rxlen;
+	struct amux_conn conn[AMUX_MAX_CONN];
+	struct amux_ctrl ctrl[AMUX_CTRL_Q];
+	uint32_t ctrl_head;
+	uint32_t ctrl_count;
+} am;
+
+/* ------------------------------------------------------------------ */
+/* rings                                                              */
+/* ------------------------------------------------------------------ */
+
+static int
+ring_init(struct amux_ring *r, uint32_t cap)
+{
+	vm_offset_t va = 0;
+	vm_size_t bytes = round_page((vm_size_t)cap);
+
+	if (r->buf != NULL) {
+		return 0;
+	}
+	if (kmem_alloc(kernel_map, &va, bytes,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	r->buf = (uint8_t *)va;
+	r->alloc = (uint32_t)bytes;
+	r->cap = cap;
+	r->head = 0;
+	r->count = 0;
+	return 0;
+}
+
+static void
+ring_free(struct amux_ring *r)
+{
+	if (r->buf != NULL) {
+		kmem_free(kernel_map, (vm_offset_t)r->buf, (vm_size_t)r->alloc);
+	}
+	r->buf = NULL;
+	r->cap = r->alloc = r->head = r->count = 0;
+}
+
+static uint32_t
+ring_push(struct amux_ring *r, const uint8_t *src, uint32_t len)
+{
+	uint32_t tail, first;
+
+	if (r->buf == NULL || len == 0) {
+		return 0;
+	}
+	if (len > r->cap - r->count) {
+		len = r->cap - r->count;        /* drop the excess */
+	}
+	tail = (r->head + r->count) % r->cap;
+	first = MIN(len, r->cap - tail);
+	memcpy(r->buf + tail, src, first);
+	if (len > first) {
+		memcpy(r->buf, src + first, len - first);
+	}
+	r->count += len;
+	return len;
+}
+
+static uint32_t
+ring_span(struct amux_ring *r, uint8_t **pp)
+{
+	uint32_t n = MIN(r->count, r->cap - r->head);
+	*pp = r->buf + r->head;
+	return n;
+}
+
+static void
+ring_drop(struct amux_ring *r, uint32_t len)
+{
+	if (len > r->count) {
+		len = r->count;
+	}
+	r->head = (r->head + len) % r->cap;
+	r->count -= len;
+}
+
+/* ------------------------------------------------------------------ */
+/* outgoing frames                                                    */
+/* ------------------------------------------------------------------ */
+
+static void
+ctrl_push(const uint8_t *data, uint32_t len)
+{
+	struct amux_ctrl *c;
+
+	if (len == 0 || len > AMUX_CTRL_MAX) {
+		return;
+	}
+	if (am.ctrl_count == AMUX_CTRL_Q) {
+		printf("APPLE MUX: control queue overflow\n");
+		return;
+	}
+	c = &am.ctrl[(am.ctrl_head + am.ctrl_count) % AMUX_CTRL_Q];
+	memcpy(c->data, data, len);
+	c->len = (uint16_t)len;
+	am.ctrl_count++;
+}
+
+static uint32_t
+tcp_build(uint8_t *out, uint16_t sport, uint16_t dport, uint32_t seq,
+    uint32_t ack, uint8_t flags, const uint8_t *data, uint32_t len)
+{
+	uint32_t total = AMUX_MUX_HDR + AMUX_TCP_HDR + len;
+
+	apple_put_be32(out, MUX_PROTO_TCP);
+	apple_put_be32(out + 4, total);
+	apple_put_be32(out + 8, MUX_MAGIC);
+	apple_put_be16(out + 12, am.mux_tx_seq++);
+	apple_put_be16(out + 14, am.mux_rx_seq);
+
+	apple_put_be16(out + 16, sport);
+	apple_put_be16(out + 18, dport);
+	apple_put_be32(out + 20, seq);
+	apple_put_be32(out + 24, ack);
+	out[28] = (uint8_t)((AMUX_TCP_HDR / 4) << 4);
+	out[29] = flags;
+	apple_put_be16(out + 30, 0xffff);
+	apple_put_be16(out + 32, 0);
+	apple_put_be16(out + 34, 0);
+	if (len != 0 && data != NULL) {
+		memcpy(out + AMUX_MUX_HDR + AMUX_TCP_HDR, data, len);
+	}
+	return total;
+}
+
+static void
+mux_send_small(uint16_t sport, uint16_t dport, uint32_t seq, uint32_t ack,
+    uint8_t flags)
+{
+	uint8_t buf[AMUX_MUX_HDR + AMUX_TCP_HDR];
+
+	ctrl_push(buf, tcp_build(buf, sport, dport, seq, ack, flags, NULL, 0));
+}
+
+static void
+version_reply(void)
+{
+	uint8_t buf[20];
+
+	apple_put_be32(buf, MUX_PROTO_VERSION);
+	apple_put_be32(buf + 4, sizeof(buf));
+	apple_put_be32(buf + 8, 2);             /* major */
+	apple_put_be32(buf + 12, 0);            /* minor */
+	apple_put_be32(buf + 16, 0);            /* padding */
+	ctrl_push(buf, sizeof(buf));
+}
+
+/* ------------------------------------------------------------------ */
+/* connections                                                        */
+/* ------------------------------------------------------------------ */
+
+static struct amux_conn *
+conn_find(uint16_t sport, uint16_t dport)
+{
+	for (int i = 0; i < AMUX_MAX_CONN; i++) {
+		if (am.conn[i].used && am.conn[i].sport == sport &&
+		    am.conn[i].dport == dport) {
+			return &am.conn[i];
+		}
+	}
+	return NULL;
+}
+
+static struct amux_conn *
+conn_alloc(void)
+{
+	for (int i = 0; i < AMUX_MAX_CONN; i++) {
+		if (!am.conn[i].used) {
+			return &am.conn[i];
+		}
+	}
+	return NULL;
+}
+
+static struct apple_service *
+service_for_port(uint16_t port)
+{
+	if (port == apple_lockdown_service.port) {
+		return &apple_lockdown_service;
+	}
+	if (port == apple_afc_service.port) {
+		return &apple_afc_service;
+	}
+	return NULL;
+}
+
+static void
+conn_release(struct amux_conn *c)
+{
+	if (!c->used) {
+		return;
+	}
+	if (c->svc != NULL && c->svc->close != NULL && c->ctx != NULL) {
+		c->svc->close(c, c->ctx);
+	}
+	ring_free(&c->in);
+	ring_free(&c->out);
+	memset(c, 0, sizeof(*c));
+}
+
+static void
+conn_release_all(void)
+{
+	for (int i = 0; i < AMUX_MAX_CONN; i++) {
+		conn_release(&am.conn[i]);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* receive                                                            */
+/* ------------------------------------------------------------------ */
+
+static void
+amux_syn(uint16_t hsport, uint16_t hdport, uint32_t seq)
+{
+	struct apple_service *svc = service_for_port(hdport);
+	struct amux_conn *c;
+
+	if (svc == NULL) {
+		printf("APPLE MUX: no service on port %u\n", hdport);
+		mux_send_small(hdport, hsport, 0, seq + 1, TH_RST | TH_ACK);
+		return;
+	}
+	c = conn_alloc();
+	if (c == NULL) {
+		mux_send_small(hdport, hsport, 0, seq + 1, TH_RST | TH_ACK);
+		return;
+	}
+	c->used = true;
+	c->sport = hdport;
+	c->dport = hsport;
+	c->tx_seq = 0x1000u + 0x400u * (uint32_t)(c - &am.conn[0]);
+	c->rx_seq = seq + 1;
+	c->svc = svc;
+	c->ctx = NULL;
+	(void)ring_init(&c->in, AMUX_RING);
+	(void)ring_init(&c->out, AMUX_RING);
+	if (svc->open != NULL) {
+		svc->open(c, &c->ctx);
+	}
+	mux_send_small(c->sport, c->dport, c->tx_seq, c->rx_seq, TH_SYN | TH_ACK);
+	c->tx_seq++;
+	printf("APPLE MUX: connect %u -> host %u (%s)\n", hdport, hsport, svc->name);
+}
+
+static void
+amux_tcp_input(uint8_t *seg, uint32_t len)
+{
+	uint16_t sport, dport;
+	uint32_t seq;
+	uint8_t off, flags, hlen;
+	const uint8_t *pl;
+	uint32_t plen;
+	struct amux_conn *c;
+
+	if (len < AMUX_TCP_HDR) {
+		return;
+	}
+	sport = (uint16_t)((seg[0] << 8) | seg[1]);
+	dport = (uint16_t)((seg[2] << 8) | seg[3]);
+	seq = apple_be32(seg + 4);
+	off = seg[12];
+	flags = seg[13];
+	hlen = (uint8_t)((off >> 4) * 4);
+	if (hlen < AMUX_TCP_HDR) {
+		hlen = AMUX_TCP_HDR;
+	}
+	if (len < hlen) {
+		return;
+	}
+	pl = seg + hlen;
+	plen = len - hlen;
+
+	if (flags & TH_RST) {
+		c = conn_find(dport, sport);
+		if (c != NULL) {
+			conn_release(c);
+		}
+		return;
+	}
+	if (flags & TH_SYN) {
+		amux_syn(sport, dport, seq);
+		return;
+	}
+
+	c = conn_find(dport, sport);
+	if (c == NULL) {
+		mux_send_small(dport, sport, 0, seq + plen, TH_RST | TH_ACK);
+		return;
+	}
+	if (plen != 0) {
+		c->rx_seq = seq + plen;
+		(void)ring_push(&c->in, pl, plen);
+		mux_send_small(c->sport, c->dport, c->tx_seq, c->rx_seq, TH_ACK);
+		if (c->svc != NULL && c->svc->input != NULL) {
+			c->svc->input(c, c->ctx, pl, plen);
+		}
+	}
+	if (flags & TH_FIN) {
+		c->rx_seq = seq + plen + 1;
+		mux_send_small(c->sport, c->dport, c->tx_seq, c->rx_seq, TH_FIN | TH_ACK);
+		conn_release(c);
+	}
+}
+
+static void
+amux_dispatch(uint8_t *pkt, uint32_t total, uint32_t hdr)
+{
+	uint32_t proto = apple_be32(pkt);
+
+	if (total >= AMUX_MUX_HDR) {
+		am.mux_rx_seq = (uint16_t)((pkt[14] << 8) | pkt[15]);
+	}
+
+	switch (proto) {
+	case MUX_PROTO_VERSION: {
+		uint32_t major;
+
+		if (total < hdr + 12) {
+			return;
+		}
+		major = apple_be32(pkt + hdr);
+		if (major != 1 && major != 2) {
+			printf("APPLE MUX: host version %u unsupported\n", major);
+			return;
+		}
+		version_reply();
+		am.neg = true;
+		am.active = false;
+		printf("APPLE MUX: host asked v%u.%u, replied v2.0\n", major,
+		    apple_be32(pkt + hdr + 4));
+		break;
+	}
+	case MUX_PROTO_SETUP:
+		am.active = true;
+		am.mux_tx_seq = 0;
+		am.mux_rx_seq = 0xffff;
+		printf("APPLE MUX: link active\n");
+		break;
+	case MUX_PROTO_CONTROL:
+		break;
+	case MUX_PROTO_TCP:
+		amux_tcp_input(pkt + hdr, total - hdr);
+		break;
+	default:
+		printf("APPLE MUX: protocol %u ignored\n", proto);
+		break;
+	}
+}
+
+void
+apple_usbmux_input(const uint8_t *buf, uint32_t len)
+{
+	if (!am.up || am.rxbuf == NULL || len == 0) {
+		return;
+	}
+	if (len > AMUX_RXBUF - am.rxlen) {
+		printf("APPLE MUX: reassembly overflow, dropping %u\n", am.rxlen);
+		am.rxlen = 0;
+		return;
+	}
+	memcpy(am.rxbuf + am.rxlen, buf, len);
+	am.rxlen += len;
+
+	for (;;) {
+		uint32_t need = am.neg ? AMUX_MUX_HDR : 8;
+		uint32_t total;
+
+		if (am.rxlen < need) {
+			break;
+		}
+		total = apple_be32(am.rxbuf + 4);
+		if (total < need || total > AMUX_RXBUF) {
+			printf("APPLE MUX: bad frame length %u, resync\n", total);
+			am.rxlen = 0;
+			break;
+		}
+		if (am.rxlen < total) {
+			break;
+		}
+		amux_dispatch(am.rxbuf, total, need);
+		if (am.rxlen > total) {
+			memmove(am.rxbuf, am.rxbuf + total, am.rxlen - total);
+		}
+		am.rxlen -= total;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* transmit                                                           */
+/* ------------------------------------------------------------------ */
+
+uint32_t
+apple_usbmux_next_tx(uint8_t *buf, uint32_t maxlen)
+{
+	if (!am.up || maxlen <= AMUX_MUX_HDR + AMUX_TCP_HDR) {
+		return 0;
+	}
+	if (am.ctrl_count != 0) {
+		struct amux_ctrl *c = &am.ctrl[am.ctrl_head];
+		uint32_t len = c->len;
+
+		memcpy(buf, c->data, len);
+		am.ctrl_head = (am.ctrl_head + 1) % AMUX_CTRL_Q;
+		am.ctrl_count--;
+		return len;
+	}
+	for (int i = 0; i < AMUX_MAX_CONN; i++) {
+		struct amux_conn *c = &am.conn[i];
+		uint32_t maxpay, n;
+		uint8_t *span = NULL;
+
+		if (!c->used || c->out.count == 0) {
+			continue;
+		}
+		maxpay = maxlen - (AMUX_MUX_HDR + AMUX_TCP_HDR);
+		n = ring_span(&c->out, &span);
+		if (n > maxpay) {
+			n = maxpay;
+		}
+		if (n == 0) {
+			continue;
+		}
+		tcp_build(buf, c->sport, c->dport, c->tx_seq, c->rx_seq,
+		    TH_ACK | TH_PSH, span, n);
+		ring_drop(&c->out, n);
+		c->tx_seq += n;
+		return AMUX_MUX_HDR + AMUX_TCP_HDR + n;
+	}
+	return 0;
+}
+
+int
+apple_mux_send(void *conn, const void *buf, uint32_t len)
+{
+	struct amux_conn *c = (struct amux_conn *)conn;
+
+	if (c == NULL || !c->used) {
+		return EINVAL;
+	}
+	return (int)ring_push(&c->out, (const uint8_t *)buf, len);
+}
+
+void
+apple_mux_close(void *conn)
+{
+	struct amux_conn *c = (struct amux_conn *)conn;
+
+	if (c == NULL || !c->used) {
+		return;
+	}
+	mux_send_small(c->sport, c->dport, c->tx_seq++, c->rx_seq, TH_FIN | TH_ACK);
+	conn_release(c);
+}
+
+/* ------------------------------------------------------------------ */
+/* link state                                                         */
+/* ------------------------------------------------------------------ */
+
+void
+apple_usbmux_link_up(void)
+{
+	if (am.rxbuf == NULL) {
+		vm_offset_t va = 0;
+		vm_size_t bytes = round_page((vm_size_t)AMUX_RXBUF);
+
+		if (kmem_alloc(kernel_map, &va, bytes,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+			printf("APPLE MUX: no reassembly buffer\n");
+			return;
+		}
+		am.rxbuf = (uint8_t *)va;
+		am.rxbuf_alloc = (uint32_t)bytes;
+	}
+	for (int i = 0; i < AMUX_MAX_CONN; i++) {
+		(void)ring_init(&am.conn[i].in, AMUX_RING);
+		(void)ring_init(&am.conn[i].out, AMUX_RING);
+	}
+	am.up = true;
+	am.neg = false;
+	am.active = false;
+	am.rxlen = 0;
+	am.ctrl_head = 0;
+	am.ctrl_count = 0;
+	am.mux_tx_seq = 0;
+	am.mux_rx_seq = 0;
+	printf("APPLE MUX: link up\n");
+}
+
+void
+apple_usbmux_link_down(void)
+{
+	if (!am.up) {
+		return;
+	}
+	am.up = false;
+	am.neg = false;
+	am.active = false;
+	am.rxlen = 0;
+	am.ctrl_head = 0;
+	am.ctrl_count = 0;
+	conn_release_all();
+	printf("APPLE MUX: link down\n");
+}
+
+int
+apple_usbmux_active(void)
+{
+	return am.active ? 1 : 0;
+}
