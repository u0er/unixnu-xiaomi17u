+/*
+ *	Routine:	ExtentBlocksReferencedByOtherFork
+ *
+ *	Purpose:	Report whether an allocation block described by extentRecord is
+ *				also mapped by another fork.  The extents B-tree is the only
+ *				place live mappings are recorded, so a hit means the blocks are
+ *				double-allocated and this fork may not release them on its own.
+ */
+static OSErr ExtentBlocksReferencedByOtherFork(
+	const ExtendedVCB			*vcb,
+	u_int8_t					forkType,
+	u_int32_t					fileID,
+	const HFSPlusExtentRecord	extentRecord,
+	Boolean						*referenced)
+{
+	FCB *					fcb;
+	struct BTreeIterator *	btIterator;
+	FSBufferDescriptor		btRecord;
+	HFSPlusExtentKey *		extentKeyPtr;
+	HFSPlusExtentRecord		foundData;
+	OSErr					err;
+	u_int16_t				btRecordSize = 0;
+	u_int32_t				extentIndex;
+	u_int32_t				foundIndex;
+
+	*referenced = false;
+
+	if (vcb->vcbSigWord == kHFSSigWord) {
+		return noErr;			/* plain HFS extent keys have another layout */
+	}
+
+	fcb = GetFileControlBlock(vcb->extentsRefNum);
+
+	btIterator = hfs_malloc_type(struct BTreeIterator);
+	extentKeyPtr = (HFSPlusExtentKey *) &btIterator->key;
+
+	btRecord.bufferAddress	= foundData;
+	btRecord.itemSize		= sizeof(HFSPlusExtentRecord);
+	btRecord.itemCount		= 1;
+
+	err = BTIterateRecord(fcb, kBTreeFirstRecord, btIterator, &btRecord, &btRecordSize);
+	while (err == noErr) {
+		if (extentKeyPtr->keyLength == kHFSPlusExtentKeyMaximumLength
+		&& (extentKeyPtr->fileID != fileID || extentKeyPtr->forkType != forkType)) {
+			for (extentIndex = 0; extentIndex < kHFSPlusExtentDensity; ++extentIndex) {
+				u_int64_t	targetStart;
+				u_int64_t	targetEnd;
+
+				if (extentRecord[extentIndex].blockCount == 0)
+					break;
+				targetStart = extentRecord[extentIndex].startBlock;
+				targetEnd = targetStart + extentRecord[extentIndex].blockCount;
+
+				for (foundIndex = 0; foundIndex < kHFSPlusExtentDensity; ++foundIndex) {
+					u_int64_t	foundStart;
+					u_int64_t	foundEnd;
+
+					if (foundData[foundIndex].blockCount == 0)
+						break;
+					foundStart = foundData[foundIndex].startBlock;
+					foundEnd = foundStart + foundData[foundIndex].blockCount;
+					if (targetStart < foundEnd && foundStart < targetEnd) {
+						*referenced = true;
+						break;
+					}
+				}
+				if (*referenced)
+					break;
+			}
+			if (*referenced)
+				break;
+		}
+		err = BTIterateRecord(fcb, kBTreeNextRecord, btIterator, &btRecord, &btRecordSize);
+	}
+	if (err == fsBTEndOfIterationErr || err == fsBTEmptyErr)
+		err = noErr;
+
+	hfs_free_type(btIterator, struct BTreeIterator);
+	return err;
+}
