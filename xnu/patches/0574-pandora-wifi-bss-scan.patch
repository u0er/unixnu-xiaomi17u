+/* Scan IEs are already bounded by ie_bytes; classify RSN (id 48) and the
+ * Microsoft WPA vendor IE (221/00:50:f2) without walking past the buffer. */
+static unsigned wifi_bss_ie_flags(const PeachWmiBss *b)
+{
+    unsigned flags = 0;
+    for (unsigned off = 0; off + 2 <= b->ie_bytes;) {
+        unsigned id = b->ies[off], len = b->ies[off + 1];
+        if (off + 2 + len > b->ie_bytes) break;
+        if (id == 48) flags |= 1u;
+        else if (id == 221 && len >= 4 && b->ies[off + 2] == 0x00 &&
+            b->ies[off + 3] == 0x50 && b->ies[off + 4] == 0xf2) flags |= 2u;
+        off += 2 + len;
+    }
+    return flags;
+}
