+/* Level 20.67 (v2063B, 0603): open map B immediately after map A's last byte.
+ *
+ * 0595's ring put map A's last byte at 2.137 s and the first resident f0 04
+ * record at 2.308 s (+171 ms); Android sends 0x19 at +54 ms. The old 500 ms
+ * silence drain therefore guaranteed the command missed the window. This
+ * function receives the timestamp captured inside bt_peri_tlv_stage at the
+ * end of the final frame and prints the measured delay, so "0x19 at +N ms"
+ * is evidence rather than a claim.
+ *
+ * First window 250 ms; a silent first window is retried once for 1500 ms.
+ * No drain, no reset and no re-send of map A between the two windows. */
+static int
+bt_peri_map_a_open(uint64_t last_tx_at, const char *what, const char *anchor)
+{
+	uint64_t ns = 0;
+	unsigned ms = 0;
+	int err;
+
+	bt_peri_vs_tx_at = 0;
+	err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_OPEN_MS, what);
+	if (bt_peri_vs_tx_at != 0u && last_tx_at != 0u &&
+	    bt_peri_vs_tx_at >= last_tx_at) {
+		/* Level 20.67 (v2063B, 0603): the delta is measured at the 0x19
+		 * request's own TX, not when its window returned, so the line is
+		 * the real map-A-last-byte to 0x19 gap. */
+		absolutetime_to_nanoseconds(bt_peri_vs_tx_at - last_tx_at, &ns);
+		ms = (unsigned)(ns / 1000000ull);
+	}
+	printf("PANDORA BT: %s: 0x19 at +%u ms after %s\n", what, ms, anchor);
+	if (ms > 60u) {
+		printf("PANDORA BT: %s: 0x19 MISSED the 60 ms window (+%u ms); sending anyway and recording it\n",
+		    what, ms);
+	}
+	pandora_log_sync();
+	if (err == 0) {
+		printf("PANDORA BT: %s: 0x19 answered in the first %u ms window\n",
+		    what, BT_PERI_MAP_A_OPEN_MS);
+		pandora_log_sync();
+		return 0;
+	}
+	printf("PANDORA BT: %s: 0x19 silent in %u ms (error %d); retrying %u ms, no reset, no replay yet\n",
+	    what, BT_PERI_MAP_A_OPEN_MS, err, BT_PERI_MAP_A_OPEN_RETRY_MS);
+	pandora_log_sync();
+	err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_OPEN_RETRY_MS,
+	    "PERI TME-L map B open retry");
+	if (err == 0) {
+		printf("PANDORA BT: %s: 0x19 answered in the retry window\n", what);
+		pandora_log_sync();
+	}
+	return err;
+}
