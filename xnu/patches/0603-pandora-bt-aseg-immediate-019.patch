+/* Level 20.67 (v2063B, 0603): the only reset in the map A path.
+ *
+ * Entered only when both 0x19 windows were silent AND BID-post still answered
+ * 0000 - i.e. the ROM is alive and its command path works, so the reset is a
+ * controlled experiment rather than a guess. A reset can drop the staged map
+ * A, so the whole 284-frame stage is replayed; the replay's own 0x19 is the
+ * acceptance evidence, never the reset's wake. */
+static int
+bt_peri_map_a_reset_replay(uint64_t *last_tx_at)
+{
+	uint16_t bid = 0xffff;
+	int err;
+
+	err = bt_peri_reset();
+	if (err) {
+		printf("PANDORA BT: map A replay: reset TX failed (error %d)\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_arbitrate_v3();
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: arbitrate v3 silent (error %d)\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_getver_window(700u);
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: GetVer(00) silent (error %d)\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_board_id_download(&bid);
+	printf("PANDORA BT: BID post-reset %04x\n", bid);
+	pandora_log_sync();
+	if (err || bid != 0u) {
+		printf("PANDORA BT: ROM DEAD after reset: BID post-reset %04x (error %d); not replaying\n",
+		    bid, err);
+		pandora_log_sync();
+		return ETIMEDOUT;
+	}
+	printf("PANDORA BT: reset ok; replaying map A (284 frames, full stage)\n");
+	pandora_log_sync();
+	err = bt_peri_tlv_stage(pandora_peri_tmel_elf,
+	    sizeof(pandora_peri_tmel_elf), "PERI TME-L map A replay", 0x03,
+	    BT_PERI_ASEG_ACK_MS, last_tx_at);
+	if (err) {
+		printf("PANDORA BT: map A replay failed (error %d)\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	printf("PANDORA BT: map A replay 284 frames sent; opening 0x19\n");
+	pandora_log_sync();
+	return bt_peri_map_a_open(*last_tx_at, "PERI TME-L map B open replay",
+	    "map A replay last byte");
+}
