+/* nezha_island_bench=1: a neutral-grey halo around the capsule. A black capsule
+ * on a black wallpaper cannot be segmented (island4 2026-11-26: 97% black frame),
+ * and a status bar that has to stay clear makes a full-width backdrop impossible.
+ * A 6 pt halo outside the capsule gives the judge a known background without
+ * touching the clock/battery/grabber zones, which are >=30 pt away. Opt-in only:
+ * no token, no pixels. */
+static void
+nezha_draw_bench_halo(SweetSurface *s)
+{
+	struct nezha_island_box b;
+	if (!nezha_island_geometry(s, &b)) {
+		return;
+	}
+	uintptr_t pixels = s->kernelAddress();
+	if (!pixels) {
+		return;
+	}
+	uint32_t m = s->width * 6 / 375;
+	if (m < 2) {
+		m = 2;
+	}
+	uint32_t ox = b.x0 > m ? b.x0 - m : 0;
+	uint32_t oy = b.y0 > m ? b.y0 - m : 0;
+	uint32_t ex = b.x0 + b.w + m;
+	uint32_t ey = b.y0 + b.h + m;
+	if (ex > s->width) ex = s->width;
+	if (ey > s->height) ey = s->height;
+	static int logged;
+	if (!logged) {
+		logged = 1;
+		IOLog("NEZHA island bench: halo %ux%u at %u,%u (margin %u)\n",
+		    ex - ox, ey - oy, ox, oy, m);
+	}
+	for (uint32_t y = oy; y < ey; y++) {
+		uint32_t *row = (uint32_t *)(pixels + s->offset + (uint64_t)y * s->bytesPerRow);
+		for (uint32_t x = ox; x < ex; x++) {
+			if (x >= b.x0 && x < b.x0 + b.w && y >= b.y0 && y < b.y0 + b.h) {
+				continue;
+			}
+			const uint32_t v = row[x];
+			/* Background only: a bright pixel is UI ink (clock/battery/date) and
+			 * stays untouched, so a mis-placed halo shows up as ink on grey in the
+			 * verdict instead of silently erasing the glyphs. */
+			if (((v & 0xffu) + ((v >> 8) & 0xffu) + ((v >> 16) & 0xffu)) < 96u) {
+				row[x] = 0xff808080u;
+			}
+		}
+		flush_dcache((vm_offset_t)(row + ox), (ex - ox) * 4, FALSE);
+	}
+}
