diff --git a/bsd/dev/pandora_vidc.c b/bsd/dev/pandora_vidc.c
index 241e1f7..ac9162e 100644
--- a/bsd/dev/pandora_vidc.c
+++ b/bsd/dev/pandora_vidc.c
@@ -992,12 +992,20 @@ vidc_fill_queues(void)
     }
     *(volatile uint32_t *)vidc_sfr_va = VIDC_SFR_BYTES;   /* [M] first word = SFR size */
     /* iris_vpu_common.c maps the UC region as its own 4 KiB page, zero-fills
-     * it and sets word 0 to 1; the core reads that page through 0xA0060.  All
-     * of the vendor's optional fields (page+0x2c..0x58) are zero on a fresh
-     * boot because their core-> fields are never written, so zeros are the
-     * honest content -- do not invent addresses here. */
+     * it and sets word 0 to 1; the core reads that page through 0xA0060.  It
+     * then fills a {DA,size} region list at page+0x2C..0x58 from the buffers
+     * mapped in venus_hfi_iommu_map_registers() [K 0x5b9b0-0x5ba10].  For a
+     * non-CP session only the first pair is non-zero: the queue-table device
+     * address and the published window -- the same values written to
+     * 0xA0064/0xA0068.  The other three pairs stay zero because their core
+     * fields are never written. */
     memset((void *)vidc_uc_va, 0, VIDC_UC_BYTES);
-    ((volatile uint32_t *)vidc_uc_va)[0] = 1;
+    {
+        volatile uint32_t *uc = (volatile uint32_t *)vidc_uc_va;
+        uc[0] = 1;
+        uc[0x2C / 4] = vidc_qtable_da();     /* [K 0x5b9c8] +0x2C = DA */
+        uc[0x30 / 4] = VIDC_QTABLE_BYTES;    /* [K 0x5b9d0] +0x30 = size */
+    }
 
     /* One clean for the header and every ring header the VPU will read. */
     vidc_sync_out(0, (unsigned)sizeof(*t));
