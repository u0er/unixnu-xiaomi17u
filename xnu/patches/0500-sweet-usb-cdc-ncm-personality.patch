+/*
+ * ---- CDC-NCM framing (personality UD_NCM) ----
+ *
+ * NCM batches several Ethernet frames into one USB transfer ("NTB").  The
+ * layout is: a 12-byte NTH16 header, then one or more NDP16 datagram tables
+ * (we always emit exactly one), each holding {offset,length} pairs that point
+ * back into the same buffer, then the frames themselves.
+ *
+ * The 4-byte datagram table alignment is why the payload starts at a fixed
+ * offset: the table grows with the datagram count, so if the payload began
+ * right after the table we would have to know the count before copying.  A
+ * fixed 56-byte header area (= 12 + 8 + (NCM_MAX_DATAGRAMS+1)*4) makes the
+ * builder a single forward pass and costs 32 bytes out of 2048.
+ */
+#define NCM_NDP16_CRC_SIGNATURE     0x314d434e      /* "NCM1" */
+#define NCM_NTB_PAYLOAD_OFF         56
+
+/* Explicit little-endian accessors.  The wire format is little-endian for every
+ * field; these avoid relying on struct packing and stay correct if the buffer
+ * is not naturally aligned for a given field. */
+static void
+ud_put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+}
+
+static uint16_t
+ud_get16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | ((uint16_t)p[1] << 8));
+}
+
+static void
+ud_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t
+ud_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Hand one received Ethernet frame to the stack. Returns true if it was queued. */
+static bool
+ud_if_input(const uint8_t *frame, size_t len)
+{
+	mbuf_t m = NULL;
+	struct ifnet_stat_increment_param stats = {};
+
+	if (ud.ifp == NULL) {
+		return false;
+	}
+	/*
+	 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket may
+	 * return a first mbuf of length 0: stripping the header from it panicked
+	 * "Failed mbuf validity check: len -14".)
+	 */
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		return false;
+	}
+	memcpy(mbuf_data(m), frame, len);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	void *frame_header = mbuf_data(m);
+	mbuf_pkthdr_setrcvif(m, ud.ifp);
+	mbuf_pkthdr_setheader(m, frame_header);
+	mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+	(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+	stats.packets_in = 1;
+	stats.bytes_in = len;
+	ifnet_input(ud.ifp, m, &stats);
+	return true;
+}
+
+/*
+ * Build one NTB from the transmit queue.  Returns the number of bytes to submit
+ * on the bulk-IN endpoint, or 0 when nothing was queued.  ud.lock held.
+ *
+ * Frames that do not fit are left in the queue for the next NTB rather than
+ * dropped, so a large burst just takes more transfers.
+ */
+static uint32_t
+ud_ncm_ntb_build(uint8_t *out, uint32_t cap)
+{
+	uint32_t off = NCM_NTB_PAYLOAD_OFF;
+	unsigned count = 0;
+	uint8_t *dpe = out + NCM_NTH16_LEN + NCM_NDP16_LEN;
+
+	while (ud.txq_count > 0 && count < NCM_MAX_DATAGRAMS) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		size_t len = mbuf_pkthdr_len(m);
+
+		if (len < ETHER_HDR_LEN || len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+			ud.txq_count--;
+			mbuf_freem(m);
+			continue;
+		}
+		if (off + len > cap) {
+			break;
+		}
+		mbuf_copydata(m, 0, len, out + off);
+		ud_put16(dpe + count * NCM_DPE16_LEN, (uint16_t)off);
+		ud_put16(dpe + count * NCM_DPE16_LEN + 2, (uint16_t)len);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		mbuf_freem(m);
+		off += len;
+		count++;
+	}
+	if (count == 0) {
+		return 0;
+	}
+	/*
+	 * The datagram table must end with a {0,0} pair.  This is not cosmetic:
+	 * Linux's cdc_ncm_rx_verify_ndp16() computes the entry count as
+	 * (wLength - 8) / 4 and then subtracts one, i.e. it never processes the
+	 * last pair -- so without the terminator the final datagram is invisible
+	 * to the host.
+	 */
+	ud_put16(dpe + count * NCM_DPE16_LEN, 0);
+	ud_put16(dpe + count * NCM_DPE16_LEN + 2, 0);
+
+	off = (off + 3u) & ~3u;         /* wBlockLength must stay 4-aligned */
+	if (off > cap) {
+		return 0;
+	}
+	ud_put32(out, NCM_NTH16_SIGNATURE);
+	ud_put16(out + 4, NCM_NTH16_LEN);
+	ud_put16(out + 6, (uint16_t)ud_ncm_sequence++);
+	ud_put16(out + 8, (uint16_t)off);
+	ud_put16(out + 10, NCM_NTH16_LEN);
+
+	uint32_t ndp_len = NCM_NDP16_LEN + (count + 1) * NCM_DPE16_LEN;
+	ud_put32(out + NCM_NTH16_LEN, NCM_NDP16_NOCRC_SIGNATURE);
+	ud_put16(out + NCM_NTH16_LEN + 4, (uint16_t)ndp_len);
+	ud_put16(out + NCM_NTH16_LEN + 6, 0);   /* wNextNdpIndex: single NDP */
+	return off;
+}
+
+/*
+ * Deliver every datagram of one received NTB.  Returns the number of frames
+ * handed to the stack.
+ *
+ * Every index and length is checked against the received block length before it
+ * is used: this buffer is filled by the host, so nothing here may be trusted.
+ */
+static unsigned
+ud_ncm_ntb_parse(const uint8_t *ntb, uint32_t len)
+{
+	unsigned delivered = 0;
+
+	if (len < NCM_NTH16_LEN + NCM_NDP16_LEN + NCM_DPE16_LEN) {
+		return 0;
+	}
+	if (ud_get32(ntb) != NCM_NTH16_SIGNATURE) {
+		return 0;
+	}
+	uint32_t block = ud_get16(ntb + 8);
+	uint32_t ndp = ud_get16(ntb + 10);
+	if (block > len) {
+		block = len;
+	}
+	if (ndp + NCM_NDP16_LEN + NCM_DPE16_LEN > block) {
+		return 0;
+	}
+	uint32_t sig = ud_get32(ntb + ndp);
+	if (sig != NCM_NDP16_NOCRC_SIGNATURE && sig != NCM_NDP16_CRC_SIGNATURE) {
+		return 0;
+	}
+	uint32_t nlen = ud_get16(ntb + ndp + 4);
+	if (nlen < NCM_NDP16_LEN + NCM_DPE16_LEN || ndp + nlen > block) {
+		return 0;
+	}
+	unsigned pairs = (nlen - NCM_NDP16_LEN) / NCM_DPE16_LEN;
+	if (pairs == 0) {
+		return 0;
+	}
+	unsigned usable = pairs - 1;    /* the last pair is the terminator */
+	for (unsigned i = 0; i < usable; i++) {
+		const uint8_t *e = ntb + ndp + NCM_NDP16_LEN + i * NCM_DPE16_LEN;
+		uint32_t index = ud_get16(e);
+		uint32_t dlen = ud_get16(e + 2);
+
+		if (index == 0 && dlen == 0) {
+			break;
+		}
+		if (dlen < ETHER_HDR_LEN || dlen > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			continue;
+		}
+		if (index < NCM_NTB_PAYLOAD_OFF || index + dlen > block) {
+			continue;
+		}
+		if (ud_if_input(ntb + index, dlen)) {
+			delivered++;
+		}
+	}
+	return delivered;
+}
+
 /* NETWORK_CONNECTION notification: the host brings its link up on it. */
 static void
 ud_notify_connected(void)
 {
 	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
 	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
-	n[2] = 1; n[3] = 0;             /* connected */
-	n[4] = 0; n[5] = 0;             /* interface 0 */
-	n[6] = 0; n[7] = 0;
+	n[2] = 1; n[3] = 0;             /* wValue: connected */
+	n[4] = 0; n[5] = 0;             /* wIndex: communication interface 0 */
+	n[6] = 0; n[7] = 0;             /* wLength: no payload */
 	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
 }
 
+/*
+ * CONNECTION_SPEED_CHANGE (CDC 1.2 section 6.3.3): 8-byte header plus an 8-byte payload
+ * carrying the downlink rate first and the uplink rate second, both in bits/s.
+ *
+ * NCM 1.1 section 9.1 asks for this BEFORE NETWORK_CONNECTION.  Linux's own f_ncm does
+ * the same (ncm_notify() starts in the SPEED state), and a host that never sees
+ * the speed notification keeps its carrier rate at zero, which on some stacks
+ * suppresses IPv6 router solicitation.
+ */
+static void
+ud_notify_speed(uint32_t downlink, uint32_t uplink)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x2a;       /* CONNECTION_SPEED_CHANGE */
+	n[2] = 0; n[3] = 0;             /* wValue */
+	n[4] = 0; n[5] = 0;             /* wIndex: communication interface 0 */
+	n[6] = 8; n[7] = 0;             /* wLength: 8 */
+	ud_put32(n + 8, downlink);
+	ud_put32(n + 12, uplink);
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 16, TRBCTL_NORMAL);
+}
