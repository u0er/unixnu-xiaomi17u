+/*
+ * NCM personality (sweetusb>=4): CDC-NCM instead of CDC-ECM.
+ *
+ * Why NCM and not ECM: a CarPlay head unit talks IP to the phone over NCM, not
+ * ECM, and NCM is the function that Apple's own gadget stack exposes
+ * (com.apple.driver.AppleUSBDeviceNCM and AppleUSBEthernetDevice's NCM-Lite
+ * both speak it).  ECM cannot frame more than one Ethernet packet per USB
+ * transfer, which is why the industry moved to NCM's NTB batching; presenting
+ * ECM to a head unit gets us nothing at C0.
+ *
+ * The descriptor set below is not hand-invented here: it is the exact byte
+ * sequence locked as NEZHA_NCM_EXPECTED in
+ * tools/ncm_ntb.py, which validates it against what Linux's cdc_ncm and
+ * Windows' UsbNcm actually require (204 self-checks, including the
+ * GET_NTB_PARAMETERS reply and NTB16 framing).  Any edit here must change that
+ * file too -- the two are meant to stay byte-identical.
+ *
+ * Endpoints are EP_RX/EP_TX/EP_INT, i.e. 0x01/0x81/0x82.  That is deliberate:
+ * reusing the endpoints the other personalities already drive means the TRB and
+ * DMA layout is untouched, so switching personality is a descriptor change and
+ * not a plumbing change.
+ */
+#define UD_NCM          2
+
+static const uint8_t ud_ncm_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x00, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_ncm_cfg_desc[86] = {
+	9, 2, 86, 0, 2, 1, 0, 0x80, 125,               /* config: 2 interfaces, 250 mA (bMaxPower is in 2 mA units) */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* if0 alt0: comm, NCM subclass 0Dh, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* CDC header, bcdCDC 0x0110 */
+	5, 0x24, 0x06, 0, 1,                            /* union: master 0, slave 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: iMAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM: bcdNcmVersion 0x0100, caps 0x00 */
+	7, 5, 0x82, 0x03, 64, 0, 1,                     /* ep 0x82 interrupt IN, 64 bytes, 1 uframe */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data alt 0: CDC data, proto 01h, no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data alt 1: same, two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/*
+ * Index 4 is the MAC the host adopts for its own end of the link, so it must be
+ * the PHONE's address: iMACAddress in the ethernet functional descriptor is what
+ * Linux hands to usbnet_get_ethernet_addr().  Same value as ud_phone_mac.
+ */
+static const char *const ud_ncm_strings[] = {
+	NULL, "UniXNU", "UniXNU iPhone (NCM)", "F2LXUNIXNU01", "02005E77EE02",
+};
+
+/*
+ * GET_NTB_PARAMETERS reply (NCM 1.1 section 6.2.1, 28 bytes).
+ *
+ * Field order is wLength, bmNtbFormatsSupported, dwNtbInMaxSize, wNdpInDivisor,
+ * wNdpInPayloadRemainder, wNdpInAlignment, wPadding1, dwNtbOutMaxSize,
+ * wNdpOutDivisor, wNdpOutPayloadRemainder, wNdpOutAlignment,
+ * wNtbOutMaxDatagrams -- 10 u16s and 2 u32s, no padding.  (An earlier draft of
+ * tools/ncm_ntb.py declared wNdpOutAlignment as u8 and the struct came out 27
+ * bytes; that is what the layout check in that file now guards.)
+ *
+ * bmNtbFormatsSupported advertises NTB-16 ONLY.  Advertising NTB-32 makes
+ * Windows set m_Use32BitNtb and send 32-bit NTH32/NDP32 headers we do not parse,
+ * and makes Linux issue SET_NTB_FORMAT.  NTB-32 buys nothing at 2 KiB.
+ *
+ * 2 KiB in/out because UD_RX and UD_TX are 2 KiB each (UD_FRAME_MAX); it is the
+ * NCM minimum and it is a legal value, so no DMA rework is needed.
+ * Alignment 4 / remainder 0 / divisor 4 keeps datagram starts 4-byte aligned.
+ */
+static const uint8_t ud_ncm_ntb_params[28] = {
+	28, 0,                          /* wLength */
+	0x01, 0x00,                     /* bmNtbFormatsSupported: NTB-16 only */
+	0x00, 0x08, 0x00, 0x00,         /* dwNtbInMaxSize 2048 */
+	4, 0, 0, 0,                     /* wNdpInDivisor 4, remainder 0 */
+	4, 0, 0, 0,                     /* wNdpInAlignment 4, wPadding1 0 */
+	0x00, 0x08, 0x00, 0x00,         /* dwNtbOutMaxSize 2048 */
+	4, 0, 0, 0,                     /* wNdpOutDivisor 4, remainder 0 */
+	4, 0,                           /* wNdpOutAlignment 4 */
+	8, 0,                           /* wNtbOutMaxDatagrams 8 */
+};
+
+/* NCM class requests (CDC NCM 1.1 Table 6-1) and NTB signatures. */
+#define NCM_GET_NTB_PARAMETERS      0x80
+#define NCM_GET_NTB_FORMAT          0x83
+#define NCM_SET_NTB_FORMAT          0x84
+#define NCM_GET_NTB_INPUT_SIZE      0x85
+#define NCM_SET_NTB_INPUT_SIZE      0x86
+#define NCM_SET_ETHERNET_PACKET_FILTER 0x43
+#define NCM_NTH16_SIGNATURE         0x484d434e      /* "NCMH" */
+#define NCM_NDP16_NOCRC_SIGNATURE   0x304d434e      /* "NCM0" */
+#define NCM_NTH16_LEN               12
+#define NCM_NDP16_LEN               8
+#define NCM_DPE16_LEN               4
+#define NCM_NTB_MAX                 2048
+#define NCM_MAX_DATAGRAMS           8
+
+static uint32_t ud_ncm_sequence;
+static uint32_t ud_ncm_in_max = NCM_NTB_MAX;
