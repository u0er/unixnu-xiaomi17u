+/*
+ * Make the metadata blob reachable by the secure world through an SHM bridge.
+ *
+ * Upstream's qcom_tzmem.c creates one for the PIL metadata when shm_bridge_enable() succeeded:
+ *     pfn_and_ns_perm = paddr | PERM_RW;  ipfn_and_s_perm = paddr | PERM_RW;
+ *     size_and_flags  = size | (1 << QCOM_SHM_BRIDGE_NUM_VM_SHIFT);   // NUM_VM_SHIFT = 9
+ *     qcom_scm_shm_bridge_create(..., QCOM_SCM_VMID_HLOS, &handle)    // svc 0xc, cmd 0x1e
+ * and deletes it once AUTH_AND_RESET has been made (svc 0xc, cmd 0x1d).  The handle comes back in
+ * a1.  Without the bridge TrustZone answers INIT_IMAGE with 0xffcfffbb on this generation, which is
+ * the answer nine different PAS ids gave on 2026-11-21.
+ */
+#define PAS_PERM_RW          0x6u
+#define PAS_VMID_HLOS        3u
+#define PAS_NUM_VM_SHIFT     9u
+#define PAS_SCM_SHIM_CREATE  SCM_FN(0xc, 0x1e)
+#define PAS_SCM_SHIM_DELETE  SCM_FN(0xc, 0x1d)
+
+static uint64_t
+pas_bridge_create(uint64_t pa, uint64_t size)
+{
+	uint64_t a0 = 0, a1 = 0;
+
+	if (!pas_bridge_on) {
+		return 0;
+	}
+	pandora_scm_call5(PAS_SCM_SHIM_CREATE, SCM_ARGS(4), pa | PAS_PERM_RW, pa | PAS_PERM_RW,
+	    size | (1ull << PAS_NUM_VM_SHIFT), PAS_VMID_HLOS, &a0, &a1);
+	printf("PANDORA PAS: shm_bridge_create(%#llx+%#llx) -> a0 %#llx (%d) handle %#llx\n", pa, size,
+	    a0, (int)(int32_t)a0, a1);
+	return (a0 || a1 == 0) ? 0 : a1;
+}
+
+static void
+pas_bridge_delete(uint64_t handle, unsigned pas)
+{
+	uint64_t a0 = 0, a1 = 0;
+
+	if (handle == 0) {
+		return;
+	}
+	pandora_scm_call(PAS_SCM_SHIM_DELETE, SCM_ARGS(1), handle, 0, &a0, &a1);
+	printf("PANDORA PAS: shm_bridge_delete(pas %u, *%#llx) -> a0 %#llx a1 %#llx\n", pas, handle, a0, a1);
+}
+
 /* PAS_AUTH_AND_RESET: lets the processor out of reset. */
 int
 pandora_pas_auth(unsigned pas)
