+/*
+ * GET_FILE_HASH (0x1D): [path\0] -> DATA with the raw 20-byte SHA-1 digest.
+ *
+ * Evidence: pymobiledevice3 PR #2128 (merged, "afc: Add hash, set-time,
+ * truncate, tell and positional I/O operations"), probed on iPhone18,4/iOS
+ * 27.2 afc-293 and vphone/iOS 27.0 afc-290.  Its get_file_hash() sends
+ * CSTRING.build(filename) and treats the DATA payload itself as the digest;
+ * the same probe fixes the error behaviour: a directory answers
+ * OBJECT_IS_DIR(9) and an empty file answers INVALID_ARG(7) -- the client has
+ * to special-case st_size == 0 and hash locally -- so this server reproduces
+ * both instead of inventing SHA-1("") for an empty file.
+ *
+ * libimobiledevice's afc.c has no client for 0x1D, so there is no diverging
+ * implementation to reconcile here.
+ *
+ * Why the body is [path\0] and not [u64 handle]: the merged afc.py in the PR
+ * (blob 3d6ad49, same hunk as the opcode enum) implements
+ *
+ *     return await self._do_operation(AfcOpcode.GET_FILE_HASH,
+ *                                     CSTRING.build(filename), filename)
+ *
+ * i.e. the payload is exactly the NUL-terminated name, with no numeric
+ * prefix.  Every handle-addressed op in that file packs a handle explicitly
+ * (ftell: U64_LE.pack(handle); ftruncate: AfcFileSetSizeRequest(handle,size);
+ * pread: AfcFreadOffsetRequest(handle,size,offset)), and the 0x1D tests are
+ * all path-addressed (test_get_file_hash_errors expects OBJECT_IS_DIR(9) for
+ * a directory path, which is meaningless for a handle).  The PR body's table
+ * maps "0x1D GetFileHash ... -> get_file_hash()" the same way.
+ */
+static void
+afc_file_hash(void *conn, struct afc_ctx *c, const char *rel)
+{
+	char path[512];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	struct vnode_attr va;
+	SHA1_CTX ctx;
+	uint8_t digest[SHA_DIGEST_LENGTH];
+	uint64_t size, off = 0;
+	int err;
+
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_open(path, FREAD, 0, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	err = vnode_getattr(vp, &va, vctx);
+	if (err != 0) {
+		vnode_close(vp, FREAD, vctx);
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	if (vnode_vtype(vp) == VDIR) {
+		vnode_close(vp, FREAD, vctx);
+		afc_status(conn, c, AFC_E_ISDIR);
+		return;
+	}
+	/*
+	 * A real device rejects an empty file with INVALID_ARG rather than
+	 * answering SHA-1(""); pymobiledevice3 compensates for that exact
+	 * status, so a host that hashes empty files locally only does so when
+	 * it sees 7 here.
+	 */
+	if (va.va_data_size == 0) {
+		vnode_close(vp, FREAD, vctx);
+		afc_status(conn, c, AFC_E_INVALID);
+		return;
+	}
+	size = (uint64_t)va.va_data_size;
+	SHA1Init(&ctx);
+	while (off < size) {
+		uint32_t want = (uint32_t)MIN(size - off,
+		    (uint64_t)AFC_IO_MAX);
+		int resid = 0;
+		uint32_t got;
+
+		err = vn_rdwr(UIO_READ, vp, (caddr_t)(uintptr_t)afc_io,
+		    (int)want, (off_t)off, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(vctx), &resid, vfs_context_proc(vctx));
+		if (err != 0) {
+			vnode_close(vp, FREAD, vctx);
+			afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+			return;
+		}
+		got = want - (uint32_t)resid;
+		/*
+		 * A short read before the size taken above means the file
+		 * shrank or the filesystem returned less than it promised.
+		 * Hashing the prefix would hand the host a digest that matches
+		 * no file at all, so report IO_ERROR instead of a wrong hash.
+		 */
+		if (got == 0) {
+			vnode_close(vp, FREAD, vctx);
+			afc_status(conn, c, AFC_E_IO);
+			return;
+		}
+		SHA1Update(&ctx, afc_io, got);
+		off += got;
+	}
+	vnode_close(vp, FREAD, vctx);
+	SHA1Final(digest, &ctx);
+	afc_reply(conn, c, AFC_OP_DATA, digest, sizeof(digest));
+}
