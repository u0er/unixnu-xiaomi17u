+/*
+ * SET_FILE_MOD_TIME (0x1E): [u64 mtime in ns since epoch][path\0] -> STATUS.
+ *
+ * Evidence: afc.c afc_set_file_time() writes htole64(mtime) followed by the
+ * NUL-terminated path (data_len = 8 + strlen(path) + 1) and expects a STATUS
+ * reply through afc_receive_data(NULL, &bytes); pymobiledevice3 PR #2128's
+ * AfcSetFileTimeRequest{mtime: u64, filename: CSTRING} sends the same bytes
+ * and its probe confirms the device stores the value ("microsecond
+ * resolution").  A missing path answers OBJECT_NOT_FOUND(8), which is what
+ * afc_errno_to_afc(ENOENT) already returns.
+ *
+ * The device-side extra ("moves st_birthtime back when mtime is earlier") is
+ * not implemented: it is not part of the wire request, afc.c never mentions
+ * it, and HFS+ create-time semantics through vnode_setattr() are unverified
+ * on this kernel.  Only the wire-visible modification time is set.
+ */
+static void
+afc_set_mtime(void *conn, struct afc_ctx *c, const char *rel,
+    uint64_t mtime_ns)
+{
+	char path[512];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	struct vnode_attr va;
+	struct timespec ts;
+	int err;
+
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_lookup(path, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	ts.tv_sec = (time_t)(mtime_ns / 1000000000ULL);
+	ts.tv_nsec = (long)(mtime_ns % 1000000000ULL);
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_modify_time, ts);
+	err = vnode_setattr(vp, &va, vctx);
+	vnode_put(vp);
+	afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+}
