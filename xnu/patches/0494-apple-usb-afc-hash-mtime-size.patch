+/*
+ * GET_SIZE_OF_PATH_CONTENTS (0x21): [u64 flags][path\0] -> DATA holding the
+ * same NUL-separated key/value text list GET_FILE_INFO uses, with the keys
+ * "st_size" and "st_blocks" (decimal strings).
+ *
+ * Evidence: pymobiledevice3 PR #2128 (merged 2026-10-28, probed on an
+ * iPhone18,4/iOS 27.2 and a vphone/iOS 27.0).  It sends
+ * AfcSizeOfPathContentsRequest{flags: u64, filename: CSTRING} and parses the
+ * reply with list_to_dict(), i.e. the payload is the key/value list and not a
+ * binary struct; get_size_of_path_contents() returns
+ * {"st_size": int, "st_blocks": int}.  The same PR fixes the semantics:
+ * it sums st_size/st_blocks of the regular files below a directory, a path
+ * that is itself a regular file reports zero, flags 0 counts regular files
+ * only and flags 1 additionally counts directories.  The PR author notes the
+ * device's flags=1 totals could not be explained and callers always send 0,
+ * so flags&1 here adds each directory's own size/blocks (the documented
+ * reading) -- inference, flagged in the delivery notes, not a verified byte.
+ *
+ * Symlinks and special files count as nothing: GET_FILE_INFO reports S_IFLNK
+ * / S_IFBLK / ... for them, so they are not "regular files".  Children are
+ * looked up with VNODE_LOOKUP_NOFOLLOW so a link can neither inflate the
+ * total nor form a traversal loop.  A child that disappears between READDIR
+ * and lookup is skipped; any other lookup/getattr/READDIR error aborts the
+ * walk with that errno, so a partial total is never reported as SUCCESS.
+ */
+#define AFC_SIZE_MAXDEPTH 16
+#define AFC_SIZE_DIRBUF   2048
+
+static int
+afc_size_recurse(const char *path, int depth, bool incl_dirs,
+    uint64_t *total_size, uint64_t *total_blocks)
+{
+	/*
+	 * One READDIR buffer and one child-name buffer per depth: a recursive
+	 * call must not clobber the caller's unprocessed records (the shared
+	 * afc_io buffer cannot be used across recursion).  The arrays stay
+	 * static (40 KiB of BSS) only because AFC dispatch is strictly serial
+	 * and non-reentrant, and that is documented by the surrounding code:
+	 *   - apple_services.c line 8: "All of this runs in the gadget event
+	 *     thread, so static buffers are safe."
+	 *   - apple_usbmux.c:15-16: "Everything here runs in the gadget's
+	 *     single event thread (ud_thread), so there are no locks: input,
+	 *     next_tx and the service callbacks never overlap."
+	 *   - amux_tcp_input() (apple_usbmux.c:394) calls svc->input()
+	 *     synchronously at apple_usbmux.c:443-444; the only caller of
+	 *     apple_usbmux_input() is ud_rx_done() in that same thread
+	 *     (sweet_usb.c:598, thread created at sweet_usb.c:1095).  The
+	 *     second thread, ud_log_thread() (sweet_usb.c:976), only drains
+	 *     the log ring and never touches the mux or a service.
+	 *   - afc_input() runs packets synchronously through afc_dispatch(),
+	 *     and afc_reply() -> apple_mux_send() only ring_push()es into
+	 *     c->out (apple_usbmux.c:610-619); no handler can re-enter
+	 *     dispatch.  The other AFC sessions (AFC_SLOTS = 4) can therefore
+	 *     only take the buffers between requests, never inside one.
+	 */
+	static uint8_t dbuf[AFC_SIZE_MAXDEPTH][AFC_SIZE_DIRBUF];
+	static char child[AFC_SIZE_MAXDEPTH][512];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	struct vnode_attr va;
+	UIO_STACKBUF(uio_store, 1);
+	off_t next = 0;
+	int err = 0, eofflag = 0;
+
+	if (depth >= AFC_SIZE_MAXDEPTH) {
+		return ELOOP;
+	}
+	err = vnode_lookup(path, 0, &vp, vctx);
+	if (err != 0) {
+		return err;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	err = vnode_getattr(vp, &va, vctx);
+	if (err != 0) {
+		vnode_put(vp);
+		return err;
+	}
+	if (incl_dirs) {
+		*total_size += (uint64_t)va.va_data_size;
+		*total_blocks += ((uint64_t)va.va_data_size + 511) / 512;
+	}
+	/* Bounded like afc_rmtree(): a directory is read to eofflag, and the
+	 * round cap keeps a broken filesystem from pinning this thread. */
+	for (int rounds = 0; rounds < 4096 && !eofflag; rounds++) {
+		uio_t uio;
+		uint32_t used, o;
+		int numdirent = 0;
+
+		memset(dbuf[depth], 0, AFC_SIZE_DIRBUF);
+		uio = uio_createwithbuffer(1, next, UIO_SYSSPACE, UIO_READ,
+		    uio_store, sizeof(uio_store));
+		if (uio == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		uio_addiov(uio, (user_addr_t)(uintptr_t)dbuf[depth],
+		    AFC_SIZE_DIRBUF);
+		eofflag = 0;
+		err = VNOP_READDIR(vp, uio, 0, &eofflag, &numdirent, vctx);
+		if (err != 0) {
+			break;
+		}
+		used = AFC_SIZE_DIRBUF - (uint32_t)uio_resid(uio);
+		next = uio_offset(uio);
+		if (used == 0 && !eofflag) {
+			err = EIO;      /* no forward progress */
+			break;
+		}
+		for (o = 0; o + DIRENT_RECLEN_MIN <= used; ) {
+			struct dirent *dp =
+			    (struct dirent *)(void *)(dbuf[depth] + o);
+			uint32_t reclen = dp->d_reclen;
+			uint32_t namlen = dp->d_namlen;
+			uint32_t maxlen;
+			vnode_t cvp = NULLVP;
+			struct vnode_attr cva;
+			int cerr;
+
+			if (reclen < DIRENT_RECLEN_MIN || o + reclen > used) {
+				err = EIO;
+				break;
+			}
+			maxlen = reclen -
+			    (uint32_t)offsetof(struct dirent, d_name);
+			o += reclen;
+			if (namlen == 0 || namlen >= maxlen ||
+			    (namlen == 1 && dp->d_name[0] == '.') ||
+			    (namlen == 2 && dp->d_name[0] == '.' &&
+			    dp->d_name[1] == '.')) {
+				continue;
+			}
+			if (snprintf(child[depth], sizeof(child[depth]),
+			    "%s/%.*s", path, (int)namlen, dp->d_name) >=
+			    (int)sizeof(child[depth])) {
+				continue;
+			}
+			cerr = vnode_lookup(child[depth],
+			    VNODE_LOOKUP_NOFOLLOW, &cvp, vctx);
+			if (cerr != 0) {
+				if (cerr == ENOENT) {
+					continue;   /* raced with unlink */
+				}
+				err = cerr;
+				break;
+			}
+			VATTR_INIT(&cva);
+			VATTR_WANTED(&cva, va_type);
+			VATTR_WANTED(&cva, va_data_size);
+			cerr = vnode_getattr(cvp, &cva, vctx);
+			if (cerr != 0) {
+				vnode_put(cvp);
+				err = cerr;
+				break;
+			}
+			if (cva.va_type == VREG) {
+				*total_size += (uint64_t)cva.va_data_size;
+				*total_blocks +=
+				    ((uint64_t)cva.va_data_size + 511) / 512;
+			}
+			vnode_put(cvp);
+			if (cva.va_type == VDIR) {
+				cerr = afc_size_recurse(child[depth],
+				    depth + 1, incl_dirs, total_size,
+				    total_blocks);
+				if (cerr != 0) {
+					err = cerr;
+					break;
+				}
+			}
+		}
+		if (err != 0) {
+			break;
+		}
+	}
+	vnode_put(vp);
+	return err;
+}
+
+static void
+afc_size_of_path_contents(void *conn, struct afc_ctx *c, const char *rel,
+    uint64_t flags)
+{
+	char path[512];
+	char num[32];
+	vnode_t vp = NULLVP;
+	vfs_context_t vctx = vfs_context_kernel();
+	uint64_t total_size = 0, total_blocks = 0;
+	uint32_t n = 0;
+	int err;
+
+	if (afc_path(rel, path, sizeof(path)) != 0) {
+		afc_status(conn, c, AFC_E_PERM);
+		return;
+	}
+	err = vnode_lookup(path, 0, &vp, vctx);
+	if (err != 0) {
+		afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+		return;
+	}
+	if (vnode_vtype(vp) != VDIR) {
+		/* A regular file reports zero: the op sums the *contents* of
+		 * a directory, it is not stat(). */
+		vnode_put(vp);
+	} else {
+		vnode_put(vp);
+		err = afc_size_recurse(path, 0, (flags & 1) != 0,
+		    &total_size, &total_blocks);
+		if (err != 0) {
+			afc_status(conn, c, (uint64_t)afc_errno_to_afc(err));
+			return;
+		}
+	}
+	memset(afc_io, 0, 128);
+	snprintf(num, sizeof(num), "%llu", (unsigned long long)total_size);
+	n = afc_kv((char *)afc_io, 128, n, "st_size", num);
+	snprintf(num, sizeof(num), "%llu",
+	    (unsigned long long)total_blocks);
+	n = afc_kv((char *)afc_io, 128, n, "st_blocks", num);
+	afc_reply(conn, c, AFC_OP_DATA, afc_io, n);
+}
