+/* 0633: read-only queue-table / UC / SMMU evidence dump.
+ *
+ * vidc9 closed the CORE_CLK arm (NO_READY_KEPT_4F).  This dump prints what the
+ * VPU actually reads, word for word, after the publish verdict:
+ *   - queue table header (version/size/qhdr0/qhdr_size/num_q/device_addr),
+ *   - all 14 words of every queue header (raw, so a wrong pack is visible),
+ *   - the UC descriptor page (word 0 and the raw 0x00..0x5C window),
+ *   - the apps-SMMU context: SCTLR/ACTLR/TCR2/TTBR0/TTBR1/TCR/CB_FSR/CB_FAR
+ *     and the global FSR.  A disabled bank or a real fault decides whether the
+ *     firmware ever translated an address; 0x400 alone is the FORMAT bit.
+ *
+ * Cache: the fill path cleaned these pages before release.  vidc_sync_in() is
+ * clean+invalidate, and a clean CPU line has nothing to write back, so it can
+ * only drop a stale line and reveal a firmware update (read/write idx).  It
+ * runs after the verdict, never between the release write and the ACK poll.
+ * Every register access below is a read; nothing here changes device state.
+ */
+static void
+vidc_diag_dump(const char *when)
+{
+    if (!vidc_qtable_va || !vidc_uc_va) {
+        printf("PANDORA VIDC: diag[%s] no buffers\n", when);
+        return;
+    }
+    struct vidc_queue_table *t = (struct vidc_queue_table *)vidc_qtable_va;
+    vidc_sync_in(0, (unsigned)sizeof(*t));
+    flush_dcache64((addr64_t)vidc_uc_pa, 0x60u, TRUE);
+
+    printf("PANDORA VIDC: diag[%s] table version=%u size=%u qhdr0=%u qhdr_size=%u "
+           "num_q=%u active=%u dev=%08x:%08x name0=%08x%08x%08x%08x\n",
+        when, t->version, t->size, t->qhdr0_offset, t->qhdr_size, t->num_q,
+        t->num_active_q, (uint32_t)(t->device_addr >> 32), (uint32_t)t->device_addr,
+        vidc_qt_rd(32), vidc_qt_rd(36), vidc_qt_rd(40), vidc_qt_rd(44));
+
+    for (unsigned i = 0; i < IFACEQ_NUMQ; i++) {
+        const uint32_t base = t->qhdr0_offset + i * t->qhdr_size;
+        for (unsigned w = 0; w < 14; w += 7)
+            printf("PANDORA VIDC: diag[%s] q%u w%u..%u: %08x %08x %08x %08x "
+                   "%08x %08x %08x\n", when, i, w, w + 6,
+                vidc_qt_rd(base + (w + 0) * 4), vidc_qt_rd(base + (w + 1) * 4),
+                vidc_qt_rd(base + (w + 2) * 4), vidc_qt_rd(base + (w + 3) * 4),
+                vidc_qt_rd(base + (w + 4) * 4), vidc_qt_rd(base + (w + 5) * 4),
+                vidc_qt_rd(base + (w + 6) * 4));
+        const struct vidc_queue_header *q = &t->qhdr[i];
+        printf("PANDORA VIDC: diag[%s] q%u type=%u hdr=%#x start=%08x q_size=%u "
+               "pkt=%u drop=%u rxwm=%u txwm=%u rxreq=%u txreq=%u rxirq=%08x "
+               "txirq=%08x rd=%u wr=%u\n", when, i, q->queue_type, q->header_type,
+            q->start_addr, q->q_size, q->pkt_size, q->pkt_drop_cnt, q->rx_wm,
+            q->tx_wm, q->rx_req, q->tx_req, q->rx_irq_status, q->tx_irq_status,
+            q->read_idx, q->write_idx);
+    }
+
+    {
+        const volatile uint32_t *uc = (const volatile uint32_t *)vidc_uc_va;
+        for (unsigned w = 0; w < 24; w += 8)
+            printf("PANDORA VIDC: diag[%s] uc[%02x..%02x]: %08x %08x %08x %08x "
+                   "%08x %08x %08x %08x\n", when, w * 4, w * 4 + 0x1c,
+                uc[w + 0], uc[w + 1], uc[w + 2], uc[w + 3],
+                uc[w + 4], uc[w + 5], uc[w + 6], uc[w + 7]);
+        printf("PANDORA VIDC: diag[%s] uc pairs %08x/%08x %08x/%08x %08x/%08x "
+               "%08x/%08x %08x/%08x %08x/%08x\n", when,
+            uc[0x2C / 4], uc[0x30 / 4], uc[0x34 / 4], uc[0x38 / 4],
+            uc[0x3C / 4], uc[0x40 / 4], uc[0x44 / 4], uc[0x48 / 4],
+            uc[0x4C / 4], uc[0x50 / 4], uc[0x54 / 4], uc[0x58 / 4]);
+    }
+
+    if (vidc_smmu_on) {
+        const uint32_t cb = (uint32_t)vidc_smmu_cb;
+        const uint64_t ttbr0 = vidc_ld64(vidc_smmu_va, cb + 0x20);
+        const uint64_t ttbr1 = vidc_ld64(vidc_smmu_va, cb + 0x28);
+        printf("PANDORA VIDC: diag[%s] smmu cb=%#x sctlr=%08x actlr=%08x tcr2=%08x "
+               "tcr=%08x ttbr0=%#llx ttbr1=%#llx fsr=%08x far=%08x gfsr=%08x\n",
+            when, cb, vidc_smmu_rd(cb), vidc_smmu_rd(cb + 0x04),
+            vidc_smmu_rd(cb + 0x10), vidc_smmu_rd(cb + 0x30),
+            ttbr0, ttbr1, vidc_smmu_rd(cb + 0x58), vidc_smmu_rd(cb + 0x60),
+            vidc_smmu_rd(0x48));
+    }
+}
