  * The vendor does this in set_hwmode, i.e. AFTER boot_firmware [K iris_core.c
@@ -1472,6 +1531,14 @@ vidc_power_up(void)
             vidc_cc_rd(rcgs[i].off + 8), vidc_cc_rd(rcgs[i].off + 0xC),
             vidc_cc_rd(rcgs[i].off + 0x10));
