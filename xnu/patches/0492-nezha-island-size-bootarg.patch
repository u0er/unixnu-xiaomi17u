+/*
+ * Mask geometry in 375-point units, overridable per boot.
+ *
+ * Defaults are the ORIGINAL Pro Max style 110x32 capsule, so an image built from
+ * this source is byte-compatible with the long-validated look. nezha_island_w /
+ * nezha_island_h override it, which keeps "which size" and "does the functional
+ * layer work" as independent single variables instead of costing one kernel build
+ * per size. The y anchor comes from the historical centre row (29.5 pt at 375),
+ * so a smaller capsule shrinks about its centre instead of drifting upward.
+ */
+static uint32_t
+nezha_island_logical_w(void)
+{
+	static uint32_t value;
+	if (value == 0) {
+		int parsed = 0;
+		value = (PE_parse_boot_argn("nezha_island_w", &parsed, sizeof(parsed)) &&
+		         parsed >= 40 && parsed <= 375) ? (uint32_t)parsed : 110;
+	}
+	return value;
+}
+
+static uint32_t
+nezha_island_logical_h(void)
+{
+	static uint32_t value;
+	if (value == 0) {
+		int parsed = 0;
+		value = (PE_parse_boot_argn("nezha_island_h", &parsed, sizeof(parsed)) &&
+		         parsed >= 10 && parsed <= 375) ? (uint32_t)parsed : 32;
+	}
+	return value;
+}
+
 /* Static iPhone 18 Pro small Dynamic Island mask, after the GPU fence and before
