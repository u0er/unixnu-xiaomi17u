+/* Level 20.68 (v2064, 0620): the only reset in the map A path, one per boot.
+ *
+ * Entered only when bt_peri_map_a_reset_allowed() says the ROM's own state
+ * leaves the reset as the only move: BID post 0000 (alive, map A rejected) or
+ * ffff (the command path stopped answering, so a reset cannot lose a staged
+ * map that is already unproven). A reset can drop the staged map A, so the
+ * whole 284-frame stage is replayed and the replay's own 0x19 is the
+ * acceptance evidence - never the reset's wake, never the pre-reset verdict.
+ *
+ * The identity read after the reset may answer 0000 or stay ffff: GetVer(00)
+ * already proved the TLV path answers, and a BID read that stays silent is
+ * the very fault this arm exists for. Any other id stops the arm before a
+ * single replay frame. */
+static int
+bt_peri_map_a_reset_replay(unsigned frames, uint16_t bid_post)
+{
+	const char *why = "";
+	uint16_t bid = 0xffffu;
+	unsigned quiet;
+	int err;
+
+	if (!bt_peri_map_a_reset_allowed(bid_post, &why)) {
+		printf("PANDORA BT: 0x19 silent and BID post %04x; not resetting (%s)\n",
+		    bid_post, why);
+		pandora_log_sync();
+		return BT_PERI_MAP_A_NO_ARM;
+	}
+	printf("PANDORA BT: reset arm: %s; one reset + full map A replay + 0x19 (one-shot, policy %d)\n",
+	    why, bt_map_a_reset_arm);
+	pandora_log_sync();
+	bt_map_a_reset_used = 1;
+	quiet = bt_peri_map_a_stream_quiesce(BT_PERI_MAP_A_QUIESCE_MAX_MS,
+	    BT_PERI_MAP_A_QUIESCE_QUIET_MS, "PERI TME-L map A");
+	(void)quiet;
+	printf("PANDORA BT: reset arm: chain reset -> arbitrate v3 -> version v3 -> GetVer(00) -> BID -> full map A replay (%u frames) -> 0x19\n",
+	    frames);
+	pandora_log_sync();
+	err = bt_peri_reset();
+	if (err) {
+		printf("PANDORA BT: reset arm: reset TX failed (error %d); map B stays withheld\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_arbitrate_v3();
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: arbitrate v3 silent (error %d); no replay\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_version_v3();
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: version v3 silent (error %d); no replay\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	err = bt_peri_getver_window(700u);
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: GetVer(00) silent (error %d); no replay\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	(void)bt_peri_board_id_download(&bid);
+	printf("PANDORA BT: BID post-reset %04x (trigger was %04x)\n", bid, bid_post);
+	pandora_log_sync();
+	if (bid != 0u && bid != 0xffffu) {
+		printf("PANDORA BT: ROM DEAD after reset: variant changed to %04x; not replaying\n", bid);
+		pandora_log_sync();
+		return ETIMEDOUT;
+	}
+	if (bid == 0xffffu) {
+		printf("PANDORA BT: reset arm: identity read still silent; GetVer(00) answered, replaying anyway\n");
+		pandora_log_sync();
+	} else {
+		printf("PANDORA BT: reset arm: identity restored, BID 0000; replaying map A\n");
+		pandora_log_sync();
+	}
+	err = bt_peri_tlv_stage(pandora_peri_tmel_elf,
+	    sizeof(pandora_peri_tmel_elf), "PERI TME-L map A replay", 0x03, 0u);
+	if (err) {
+		printf("PANDORA BT: map A replay failed (error %d); map B stays withheld\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	printf("PANDORA BT: map A replay %u frames sent; opening 0x19\n", frames);
+	pandora_log_sync();
+	err = bt_peri_map_a_open(bt_map_a_last_tx, frames,
+	    "PERI TME-L map B open replay", "map A replay last byte");
+	if (err) {
+		printf("PANDORA BT: ROM DEAD after reset: 0x19 silent after the replay (error %d); map B stays withheld, needs a reboot\n", err);
+		pandora_log_sync();
+		return err;
+	}
+	printf("PANDORA BT: reset recovered: 0x19 answered after the replay; map A unproven, map B open on the replay only\n");
+	pandora_log_sync();
+	return 0;
+}
