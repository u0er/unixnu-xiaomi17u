+/* Level 20.68 (v2064, 0620): the 0x19 windows, with the gap measured from the
+ * stage that just finished. 0602 measured only map A; the replay needs its own
+ * anchor, so the timestamp is a parameter and the log keeps 0602's shape. */
+static int
+bt_peri_map_a_open(uint64_t ts, unsigned frames, const char *what,
+    const char *anchor)
+{
+	int err;
+
+	if (ts != 0ull) {
+		unsigned d = (unsigned)(bt_peri_uptime_ms() - ts);
+
+		printf("PANDORA BT: %s: 0x19 at +%u ms after %s (%u frames, ack_ms 0, target <= 60 ms)\n",
+		    what, d, anchor, frames);
+	} else {
+		printf("PANDORA BT: %s: 0x19 after %s: timestamp unavailable (%u frames, ack_ms 0)\n",
+		    what, anchor, frames);
+	}
+	pandora_log_sync();
+	err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_FIRST_MS, what);
+	if (err == 0) {
+		printf("PANDORA BT: %s: 0x19 answered in the %u ms first window\n",
+		    what, BT_PERI_MAP_A_0X19_FIRST_MS);
+		pandora_log_sync();
+		return 0;
+	}
+	printf("PANDORA BT: %s: 0x19 silent in the %u ms first window (error %d); second window %u ms\n",
+	    what, BT_PERI_MAP_A_0X19_FIRST_MS, err, BT_PERI_MAP_A_0X19_WIDE_MS);
+	pandora_log_sync();
+	err = bt_peri_vs_cmd(0x19u, BT_PERI_MAP_A_0X19_WIDE_MS,
+	    "PERI TME-L map A tail 0x19 retry");
+	if (err == 0) {
+		printf("PANDORA BT: %s: 0x19 answered in the %u ms second window\n",
+		    what, BT_PERI_MAP_A_0X19_WIDE_MS);
+		pandora_log_sync();
+	}
+	return err;
+}
