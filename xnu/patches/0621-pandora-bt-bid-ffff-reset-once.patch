+/* Level 20.68 (v2064, 0620): the ffff arm (canonical 0602 line).
+ *
+ * 0602 gives the reset arm exactly one entry: BID post 0000, and only under
+ * pandora_bt_reset=2. bt2063B's live ring (2026-11-27 13:39, v2063B) ended in
+ * the other state: 0x19 at +2 ms, silent 250 + 1500 ms, BID post ffff (the
+ * board-id read got no reply at all, one byte d5 on the wire), GetVer(00) and
+ * a second 0x19 also silent - the PERI command path had stopped answering -
+ * and the gate withheld map B. That withhold is correct, and it is exactly
+ * the state where a reset is the only remaining move: 0000 means the ROM
+ * still answers and a reset can drop a validly staged map, ffff means
+ * nothing is left to lose.
+ *
+ * 0620 therefore arms one reset per boot on BID post ffff as well as 0000,
+ * drains the resident f0 04 stream first (bt2063b still saw 6,373 bytes in a
+ * 400 ms window 2.1 s after map A), then reset -> arbitrate v3 -> version v3
+ * -> GetVer(00) -> BID -> full 284-frame replay (ack_ms 0) -> 0x19. Only the
+ * replay's own 0x19 accepts; a silent replay is ROM DEAD after reset with map
+ * B withheld and zero B bytes.
+ *
+ * pandora_bt_reset: 0 (default) arms on 0000 or ffff, 1 never resets, 2 arms
+ * on any BID post. 0602 used 0 = never and 2 = 0000-only; the default is what
+ * bt2064 changes.
+ */
+#define BT_PERI_MAP_A_RESET_DEFAULT 0
+#define BT_PERI_MAP_A_RESET_NONE    1
+#define BT_PERI_MAP_A_RESET_FORCE   2
+#define BT_PERI_MAP_A_QUIESCE_MAX_MS   1200u
+#define BT_PERI_MAP_A_QUIESCE_QUIET_MS 120u
+#define BT_PERI_MAP_A_NO_ARM          0x0c06
+
+static int bt_map_a_reset_used;
