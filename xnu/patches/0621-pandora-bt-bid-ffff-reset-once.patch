-/* Level 20.67 (v2064, 0602): the map A tail gate.
+/* Level 20.68 (v2064, 0620): resident-stream quiesce before the reset.
+ *
+ * bt2063b's ring shows the ROM still emitting f0 04 records 2.1 s after map A
+ * (6,373 bytes inside the 400 ms liveness window), so a reset sent on top of
+ * that stream competes with it: the PERI block is mid-dump and will not read
+ * the 6-byte reset frame. Drain until quiet_ms of silence or max_ms, ACK every
+ * 0xfd wake like the other watch loops, and return the measured quiet stretch
+ * so the reset line carries evidence instead of a claim. */
+static unsigned
+bt_peri_map_a_stream_quiesce(unsigned max_ms, unsigned quiet_ms, const char *what)
+{
+	static const uint8_t ack = 0xfc;
+	uint8_t byte;
+	unsigned bytes = 0;
+	uint64_t start = bt_peri_uptime_ms();
+	uint64_t last = start;
+	unsigned elapsed;
+	unsigned quiet;
+
+	while ((unsigned)(bt_peri_uptime_ms() - start) < max_ms) {
+		uint64_t deadline;
+		unsigned field = 0;
+		int err;
+
+		clock_interval_to_deadline(quiet_ms, NSEC_PER_MSEC, &deadline);
+		err = bt_rx_exact(&byte, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (byte == 0xfdu) {
+			(void)bt_uart_tx(&ack, 1u, "map A quiesce ACK FC");
+		}
+		bytes++;
+		last = bt_peri_uptime_ms();
+	}
+	elapsed = (unsigned)(bt_peri_uptime_ms() - start);
+	quiet = (unsigned)(bt_peri_uptime_ms() - last);
+	printf("PANDORA BT: %s: pre-reset quiesce: %u byte(s) drained, %u ms quiet in %u ms (cap %u, quiet target %u)%s\n",
+	    what, bytes, quiet, elapsed, max_ms, quiet_ms,
+	    quiet >= quiet_ms ? "" : ", stream still active");
+	pandora_log_sync();
+	return quiet;
+}
