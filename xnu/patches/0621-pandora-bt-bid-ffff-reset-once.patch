+/* Level 20.68 (v2064, 0620): which BID-post states arm the single reset. */
+static int
+bt_peri_map_a_reset_allowed(uint16_t bid_post, const char **why)
+{
+	if (bt_map_a_reset_used) {
+		*why = "one-shot spent";
+		return 0;
+	}
+	if (bt_map_a_reset_arm == BT_PERI_MAP_A_RESET_NONE) {
+		*why = "policy 1 (never reset)";
+		return 0;
+	}
+	if (bt_map_a_reset_arm >= BT_PERI_MAP_A_RESET_FORCE) {
+		*why = "policy 2 (force on any BID post)";
+		return 1;
+	}
+	if (bid_post == 0xffffu) {
+		*why = "BID post ffff (identity path silent)";
+		return 1;
+	}
+	if (bid_post == 0u) {
+		*why = "BID post 0000 (ROM alive, map A rejected)";
+		return 1;
+	}
+	*why = "BID post names another NVM variant";
+	return 0;
+}
