+/* One bounded, event-driven wait for a worker publication. ta_notify() bumps
+ * the generation and wakes every waiter, so a signal published after this
+ * thread registers its wait cannot be missed. */
+static bool
+ta_await(uint32_t *flag, uint64_t deadline)
+{
+	for (;;) {
+		if (__atomic_load_n(flag, __ATOMIC_ACQUIRE)) return true;
+		uint32_t event = __atomic_load_n(&ta_event, __ATOMIC_ACQUIRE);
+		(void)assert_wait_deadline((event_t)&ta_event, THREAD_UNINT, deadline);
+		/* Recheck after registering: the publishing thread stores the flag
+		 * before ta_notify(), so a notification that lands between the load
+		 * above and this block must still win. */
+		if (__atomic_load_n(flag, __ATOMIC_ACQUIRE) ||
+		    __atomic_load_n(&ta_event, __ATOMIC_ACQUIRE) != event) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+			continue;
+		}
+		if (thread_block(THREAD_CONTINUE_NULL) == THREAD_TIMED_OUT) {
+			return __atomic_load_n(flag, __ATOMIC_ACQUIRE) != 0;
+		}
+	}
+}
