+/* Level 20.68 (v2064, 0606): monotonic milliseconds for the quiesce cap.
+ *
+ * 0603 measures the 0x19 gap with absolutetime_to_nanoseconds() at the TX
+ * itself and never needs a clock helper; the quiesce loop does, and an
+ * implicit declaration would fail the XNU build (first CI dispatch did
+ * exactly that), so it is defined here, once, above its only caller. */
+static uint64_t
+bt_peri_uptime_ms(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+/* Level 20.68 (v2064, 0606): let the resident stream run out before the reset.
+ *
+ * bt2063b's ring has the ROM still emitting f0 04 records 2.1 s after map A
+ * (6,373 bytes inside the 400 ms liveness window), so a reset sent on top of
+ * that stream competes with it: the PERI block is mid-dump and will not read
+ * the 6-byte reset frame. Drain until quiet_ms of silence or max_ms, ACK every
+ * 0xfd wake like the other watch loops, and return the measured quiet stretch
+ * so the reset line carries evidence instead of a claim. */
+static unsigned
+bt_peri_map_a_stream_quiesce(unsigned max_ms, unsigned quiet_ms, const char *what)
+{
+	static const uint8_t ack = 0xfc;
+	uint8_t byte;
+	unsigned bytes = 0;
+	uint64_t start = bt_peri_uptime_ms();
+	uint64_t last = start;
+	unsigned elapsed;
+	unsigned quiet;
+
+	while ((unsigned)(bt_peri_uptime_ms() - start) < max_ms) {
+		uint64_t deadline;
+		unsigned field = 0;
+		int err;
+
+		clock_interval_to_deadline(quiet_ms, NSEC_PER_MSEC, &deadline);
+		err = bt_rx_exact(&byte, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (byte == 0xfdu) {
+			(void)bt_uart_tx(&ack, 1u, "map A quiesce ACK FC");
+		}
+		bytes++;
+		last = bt_peri_uptime_ms();
+	}
+	elapsed = (unsigned)(bt_peri_uptime_ms() - start);
+	quiet = (unsigned)(bt_peri_uptime_ms() - last);
+	printf("PANDORA BT: %s: pre-reset quiesce: %u byte(s) drained, %u ms quiet in %u ms (cap %u, quiet target %u)%s\n",
+	    what, bytes, quiet, elapsed, max_ms, quiet_ms,
+	    quiet >= quiet_ms ? "" : ", stream still active");
+	pandora_log_sync();
+	return quiet;
+}
+
+/* Level 20.68 (v2064, 0606): which BID-post states arm the single reset.
+ *
+ * 0000: the ROM answers and map A was rejected -> one controlled reset.
+ * ffff: the identity read got nothing -> the only recovery left; this is the
+ *       state bt2063B stopped in, and the state 0603 refused to act on.
+ * other: a different NVM variant -> never reset, never replay.
+ * policy 1 refuses every arm; policy 2 arms on any state (diagnostic). The
+ * one-shot guard is checked first, so no policy can produce two resets. */
+static int
+bt_peri_map_a_reset_allowed(uint16_t bid_post, const char **why)
+{
+	if (bt_map_a_reset_used) {
+		*why = "one-shot spent";
+		return 0;
+	}
+	if (bt_map_a_reset_policy == BT_PERI_MAP_A_RESET_NONE) {
+		*why = "policy 1 (never reset)";
+		return 0;
+	}
+	if (bt_map_a_reset_policy >= BT_PERI_MAP_A_RESET_FORCE) {
+		*why = "policy 2 (force on any BID post)";
+		return 1;
+	}
+	if (bid_post == 0xffffu) {
+		*why = "BID post ffff (identity path silent)";
+		return 1;
+	}
+	if (bid_post == 0u) {
+		*why = "BID post 0000 (ROM alive, map A rejected)";
+		return 1;
+	}
+	*why = "BID post names another NVM variant";
+	return 0;
+}
