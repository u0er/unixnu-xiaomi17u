+		unsigned dead = 0;
+
+		for (unsigned i = 0; i < 3; i++) {
+			uint32_t a = pc_rd(phy0, lanes[i] + 0x178u);
+			uint32_t b = pc_rd(phy0, lanes[i] + 0x17cu);
+			uint32_t c = pc_rd(phy0, lanes[i] + 0x180u);
