+/* v30 experiment (ownership facts closed 2026-11-19/20, see
+ * android-cambist-mclk-20261119/FINDINGS.md): the RCG table is authoritative
+ * from cambistmclkcc-canoe.ko (mclkN cmd @0x4000+0x1C*N, branch @+0x18,
+ * plain clk_rcg2_ops + clk_branch2_ops, HW_CLK_CTRL root), so the MCLK
+ * stop path now mirrors the vendor clk_branch2 sequence instead of the
+ * earlier speculative RCG ROOT_OFF writes. The sensor-side rail ownership
+ * (wide/tele only, MX untouched, BOB1 voltage-only) still follows the
+ * provider trace and remains the part to validate on device.
+ *
+ * Draft intent: cycle the wide+tele resources enabled by pc_sensor_power_up(). The
+ * provider-probe trace shows wide shutdown as reset -> VIO/AVDD GPIO -> MCLK0
+ * -> AFVDD/BOB2, and tele shutdown as MCLK3 -> reset -> tele-only rails/GPIO.
+ * L5M_E1 and B2B_E0 are shared, so release them once after both resets. BOB1
+ * is voltage-voted but not disabled in the trace. Tracefs uses global GPIOs;
+ * pc_gpio_set() takes TLMM-local pins (global - 512): 619/628/625 -> 107/116/113.
+ */
+static int
+pc_sensor_power_down_probe_pair(void)
+{
+	static const uint32_t mclk_cmd[] = { 0x4000u, 0x4038u, 0x4054u, 0x4070u };
+	static const uint32_t mclk_cbcr[] = { 0x4018u, 0x4050u, 0x406cu, 0x4088u };
+	int first_error = 0;
+
+	if (pc_level >= 3u)
+		return EBUSY;
+	if (!pc_tlmm || !pc_bdistm)
+		return ENXIO;
+
+	pc_csiphy_mark("v30 probe-cycle down: assert wide+tele reset");
+	pc_gpio_set(106, 0, 0, 2, 0);
+	pc_gpio_set(105, 0, 0, 2, 0);
+	if ((pc_rd(pc_tlmm, PC_GPIO(106) + 4) & 0x2u) ||
+	    (pc_rd(pc_tlmm, PC_GPIO(105) + 4) & 0x2u)) {
+		printf("PANDORA CAMERA: v30 reset assertion readback failed\n");
+		(void)pandora_log_sync();
+		return EIO;
+	}
+	pc_sleep(1);
+
+	/* Wide shutdown trace drops shared VIO and the AVDD/DVDD GPIO first. */
+	int err = pandora_rpmh_resource("L5M_E1", 4, 0);
+	if (err) {
+		printf("PANDORA CAMERA: v30 L5M_E1 disable failed=%d\n", err);
+		if (!first_error) first_error = err;
+	}
+	pc_gpio_set(107, 0, 0, 2, 0);
+
+	/* Stop the four MCLK branches with the vendor clk_branch2 sequence:
+	 * clear CBCR BIT(0), then poll the CLK_OFF status bit (BIT(31), same
+	 * register, halt_check==1 semantics) with the vendor-scale timeout
+	 * (~200 x 5 ms). The RCGs use plain clk_rcg2_ops whose disable never
+	 * touches the CMD register — no park, no writable root bit — so the
+	 * previous ROOT_OFF writes are removed (mclk_cmd is kept only for the
+	 * final state printout). */
+	for (unsigned mi = 0; mi < 4; mi++) {
+		uint32_t cbcr = pc_rd(pc_bdistm, mclk_cbcr[mi]);
+		pc_wr(pc_bdistm, mclk_cbcr[mi], cbcr & ~PC_CBCR_ENABLE);
+		unsigned poll;
+		for (poll = 0; poll < 200; poll++) {
+			cbcr = pc_rd(pc_bdistm, mclk_cbcr[mi]);
+			if (cbcr & PC_CBCR_CLK_OFF)
+				break;
+			pc_sleep(1);
+		}
+		if (poll == 200) {
+			printf("PANDORA CAMERA: v30 MCLK%u halt timeout cbcr=%#x\n",
+			    mi, cbcr);
+			if (!first_error) first_error = ETIMEDOUT;
+		}
+	}
+	printf("PANDORA CAMERA: v30 MCLK stopped cmd0=%#x cbcr=%#x/%#x/%#x/%#x\n",
+	    pc_rd(pc_bdistm, mclk_cmd[0]), pc_rd(pc_bdistm, mclk_cbcr[0]),
+	    pc_rd(pc_bdistm, mclk_cbcr[1]), pc_rd(pc_bdistm, mclk_cbcr[2]),
+	    pc_rd(pc_bdistm, mclk_cbcr[3]));
+	if (first_error) {
+		printf("PANDORA CAMERA: v30 stopped before rail shutdown; MCLK error=%d\n",
+		    first_error);
+		(void)pandora_log_sync();
+		return first_error;
+	}
+
+	/* Tele's dedicated rails are released after its MCLK is stopped. */
+	err = pandora_rpmh_resource("L5N_E1", 4, 0);
+	if (err) {
+		printf("PANDORA CAMERA: v30 L5N_E1 disable failed=%d\n", err);
+		if (!first_error) first_error = err;
+	}
+	err = pandora_rpmh_resource("L3N_E1", 4, 0);
+	if (err) {
+		printf("PANDORA CAMERA: v30 L3N_E1 disable failed=%d\n", err);
+		if (!first_error) first_error = err;
+	}
+	pc_gpio_set(113, 0, 0, 2, 0);
+
+	/* AFVDD GPIO628 and shared BOB2 are the final wide power-down steps. */
+	pc_gpio_set(116, 0, 0, 2, 0);
+	err = pandora_rpmh_resource("B2B_E0", 4, 0);
+	if (err) {
+		printf("PANDORA CAMERA: v30 B2B_E0 disable failed=%d\n", err);
+		if (!first_error) first_error = err;
+	}
+	printf("PANDORA CAMERA: v30 probe-cycle down result=%d reset=%#x/%#x "
+	    "wide_gpio=%#x/%#x mclk0=%#x mclk3=%#x\n", first_error,
+	    pc_rd(pc_tlmm, PC_GPIO(106)), pc_rd(pc_tlmm, PC_GPIO(105)),
+	    pc_rd(pc_tlmm, PC_GPIO(107)), pc_rd(pc_tlmm, PC_GPIO(116)),
+	    pc_rd(pc_bdistm, mclk_cbcr[0]), pc_rd(pc_bdistm, mclk_cbcr[3]));
+	(void)pandora_log_sync();
+	return first_error;
+}
