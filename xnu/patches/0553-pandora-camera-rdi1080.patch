+		printf("PANDORA SLICEB: cphytest %s common1138="
+		    "%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x/"
+		    "%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x\n", phase,
+		    cs[0], cs[1], cs[2], cs[3], cs[4], cs[5], cs[6], cs[7],
+		    cs[8], cs[9], cs[10], cs[11], cs[12], cs[13], cs[14],
+		    cs[15], cs[16], cs[17], cs[18], cs[19]);
+	}
+	{
