+/* v32 burst-queue replay: one CCI queue per ~1000-byte payload chunk, matching
+ * the vendor camera_io_dev_write segmentation (5x1000B segments; the observed
+ * ~24 ms/segment is pure I2C bus time at the tuned clock, not an artificial
+ * delay). pc_sensor_apply_tbl's per-register path costs 1.18 ms/write (engine
+ * reset + timing + IRQ poll per register) vs the vendor's ~8 us/write — the
+ * register stream reached the sensor ~150x slower than Android. The burst
+ * queue keeps the vendor's pacing: every register write is one queue word
+ * (same packing as pc_cci_write_reg), the whole chunk executes at I2C speed,
+ * and one REPORT closes it. Q0 holds 1024 words; 333 entries x (2+1) bytes
+ * = 999 payload bytes fits with the command words to spare. */
+static int
+pc_cci_write_burst(vm_offset_t cci, unsigned master, uint8_t slave,
+    const struct pc_init_reg *t, unsigned start, unsigned end, int setup)
+{
+	uint32_t cur, words = 0;
+	int ret;
+
+	if (setup) {
+		pc_cci_reset_engine();
+		pc_cci_refresh_timing(1);	/* 37.5 MHz, verified talking to sensors */
+	}
+	pc_wr(cci, PC_CCI_IRQ_CLEAR_0, 0xffffffffu);
+	pc_wr(cci, PC_CCI_IRQ_GLOBAL_CLEAR_CMD, 1u);
+
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_SET_PARAM | ((uint32_t)slave & 0x7fu) << 4);
+	words++;
+	for (unsigned i = start; i < end; i++) {
+		unsigned db = t[i].width ? t[i].width : 1u;
+		if (t[i].reg == 0xffffu) {
+			pc_cci_payload_sent++;
+		}
+		if (db >= 2u) {
+			pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+			    pc_cci_load_word(PC_CCI_I2C_WRITE | (4u << 4),
+			        (uint32_t)(t[i].reg >> 8) & 0xffu,
+			        (uint32_t)t[i].reg & 0xffu,
+			        (uint32_t)(t[i].val >> 8) & 0xffu));
+			pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+			    (uint32_t)t[i].val & 0xffu);
+			words += 2;
+		} else {
+			pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+			    pc_cci_load_word(PC_CCI_I2C_WRITE | (3u << 4),
+			        (uint32_t)(t[i].reg >> 8) & 0xffu,
+			        (uint32_t)t[i].reg & 0xffu,
+			        (uint32_t)t[i].val & 0xffu));
+			words++;
+		}
+	}
+	pc_wr(cci, PC_CCI_Qn_LOAD_DATA(master, 0),
+	    PC_CCI_I2C_REPORT | PC_CCI_I2C_REPORT_IRQ_EN);
+	words++;
+
+	cur = pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 0));
+	if (cur == 0 || cur != words) {
+		printf("PANDORA CAMERA: cci_burst M%u queue word mismatch "
+		    "cur=%u want=%u\n", master, cur, words);
+		return EINVAL;
+	}
+	pc_wr(cci, PC_CCI_Qn_EXEC_WORD_CNT(master, 0), cur);
+	pc_wr(cci, PC_CCI_QUEUE_START, 1u << (master * 2u + 0u));
+	ret = pc_cci_wait_irq(cci, 1u << (4u + master * 12u));
+	if (ret == 0) {
+		pc_cci_burst_report++;
+		if (pc_cci_last_irq & (1u << (27u + master * 2u)))
+			pc_cci_burst_nack++;
+	} else {
+		pc_cci_burst_timeout++;
+	}
+	if (ret != 0) {
+		printf("PANDORA CAMERA: cci_burst M%u IRQ timeout status=%#x "
+		    "cur_cmd=%#x cur_words=%#x report=%#x\n", master,
+		    pc_rd(cci, PC_CCI_IRQ_STATUS_0),
+		    pc_rd(cci, PC_CCI_I2C_Mm_Qn_CUR_CMD(master, 0)),
+		    pc_rd(cci, PC_CCI_Qn_CUR_WORD_CNT(master, 0)),
+		    pc_rd(cci, PC_CCI_Qn_REPORT_STATUS(master, 0)));
 		return ret;
 	}
 	return 0;
