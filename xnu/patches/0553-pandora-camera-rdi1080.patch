+		0x210acu, 0x21110u,             /* tfe_1/2_main */
+		0x210d8u, 0x2113cu,             /* tfe_1/2_main_fast_ahb */
+		0x21124u, 0x21140u,             /* tfe_2_bayer / bayer_fast_ahb */
+		0x2130cu                        /* camnoc_xo */
+	};
+
+	for (unsigned i = 0; i < 4; i++)
+		(void)pc_tpg_gdsc_up(gdscs[i], gdsc_names[i]);
+	(void)pc_tpg_pll_enable(0x3000u, 0x00480025u, 0x8777u, 0x40fu, "pll3");
+	(void)pc_tpg_pll_enable(0x4000u, 0x00480025u, 0x8777u, 0x40fu, "pll4");
+	(void)pc_tpg_pll_enable(0x5000u, 0x00480025u, 0x8777u, 0x40fu, "pll5");
+	for (unsigned i = 0; i < PC_TPG_NRCG; i++)
+		(void)pc_tpg_rcg_set(&pc_tpg_rcgs[i]);
+	for (unsigned i = 0; i < sizeof(v12_rcgs) / sizeof(v12_rcgs[0]); i++)
+		(void)pc_tpg_rcg_set(&v12_rcgs[i]);
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR,
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR) | PC_CBCR_ENABLE);
+	pc_sleep(1);
+	for (unsigned i = 0; i < PC_TPG_NBRANCH; i++)
+		pc_wr(pc_camcc, pc_tpg_branches[i],
+		    pc_rd(pc_camcc, pc_tpg_branches[i]) | PC_CBCR_ENABLE);
+	pc_sleep(2);
+	for (unsigned i = 0; i < sizeof(v12_branches) / sizeof(v12_branches[0]); i++) {
+		pc_wr(pc_camcc, v12_branches[i],
+		    pc_rd(pc_camcc, v12_branches[i]) | PC_CBCR_ENABLE);
+		(void)pc_wait_branch_on(tag, v12_branches[i]);
+	}
+	printf("PANDORA SLICEB: %s infra core_ahb=%#x cpas_ahb=%#x fast_ahb=%#x "
+	    "rt=%#x nrt=%#x qdss=%#x tfe0main=%#x tfe1main=%#x tfe2main=%#x "
+	    "tfe2bayer=%#x tfe2bayer_fast=%#x camnoc_xo=%#x\n", tag,
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, 0x2137cu),
+	    pc_rd(pc_camcc, 0x2136cu), pc_rd(pc_camcc, 0x212e4u),
+	    pc_rd(pc_camcc, 0x212f8u), pc_rd(pc_camcc, 0x21330u),
+	    pc_rd(pc_camcc, 0x21030u), pc_rd(pc_camcc, 0x210acu),
+	    pc_rd(pc_camcc, 0x21110u), pc_rd(pc_camcc, 0x21124u),
+	    pc_rd(pc_camcc, 0x21140u), pc_rd(pc_camcc, 0x2130cu));
+	(void)pandora_log_sync();
+}
+
+/* v37: Android sets CAM_START_PHYDEV ~54 ms before the sensor starts
+ * streaming; our probe arms CSIPHY0 ~6 s before the replay tail writes
+ * 0x0100=1. Re-run the exact vendor 2.4.0 3-phase programming block AFTER
+ * the replay, while the sensor is already streaming, to test whether the
+ * PHY's lane/CDR state decays or latches off during that idle gap. The
+ * sequence and values are identical to the one at cphytest start; only the
+ * timing relative to sensor stream-on changes. */
+static void
+pc_csiphy0_rearm(vm_offset_t phy0, unsigned settle)
+{
+	static const uint32_t lanes[3] = { 0x0200u, 0x0600u, 0x0A00u };
+	static const struct { uint32_t addr; uint32_t val; } irq[11] = {
+		{ 0x102Cu, 0xffu }, { 0x1030u, 0xffu }, { 0x1034u, 0xfbu },
+		{ 0x1038u, 0xffu }, { 0x103Cu, 0x7fu }, { 0x1040u, 0xffu },
+		{ 0x1044u, 0xffu }, { 0x1048u, 0xefu }, { 0x104Cu, 0xffu },
+		{ 0x1050u, 0xffu }, { 0x1054u, 0xffu },
+	};
+
+	pc_wr(phy0, 0x1000u, 0x01u);
+	delay(20);
+	{
+		uint32_t refgen = 0;
+		unsigned waited = 0;
+
+		for (; waited < 100u; waited++) {
+			refgen = pc_rd(phy0, 0x1184u);
+			if (refgen & 0x80u)
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA SLICEB: v37 rearm refgen=%#x ready=%u wait_ms=%u\n",
+		    refgen, (refgen & 0x80u) ? 1u : 0u, waited);
+		(void)pandora_log_sync();
+	}
+	pc_wr(phy0, 0x1084u, 0x00u);
+	pc_wr(phy0, 0x108Cu, 0x0Eu);
+	pc_wr(phy0, 0x101Cu, 0x7Au);
+	pc_wr(phy0, 0x1018u, 0x01u);
+	/* v51: vendor update_lane_selection writes lane_enable_mask | readl(0x1014).
+	 * Android's live value is 0x2a. v49's 0x23a was wrong: 0x1014 does not carry
+	 * lane_assign (that is CSID RX_CFG0's 0x210), and bit9 filtered. */
+	pc_wr(phy0, PC_CSIPHY_V240_LANE_EN, 0x2Au);	/* v61: 0x2A lost lock */
+	for (unsigned l = 0; l < 3; l++) {
+		uint32_t off = lanes[l];
+
+		for (unsigned i = 0; i < PC_CSIPHY_3PH_BASE_REGS_N; i++) {
+			const struct pc_csiphy_3ph_reg *r = &pc_csiphy_3ph_base_regs[i];
+
+			pc_wr(phy0, off + r->addr, r->val);
+			if (r->delay_us)
+				delay(r->delay_us);
+		}
+		for (unsigned i = 0; i < PC_CSIPHY_3PH_4P0G_REGS_N; i++) {
+			const struct pc_csiphy_3ph_reg *r = &pc_csiphy_3ph_4p0g_regs[i];
+			uint32_t val = r->val;
+
+			if (r->type == 1u)
+				val = settle & 0xffu;
+			else if (r->type == 2u)
+				val = (settle >> 8) & 0xffu;
+			pc_wr(phy0, off + r->addr, val);
+			if (r->delay_us)
+				delay(r->delay_us);
+		}
+	}
+	pc_wr(phy0, PC_CSIPHY_V240_LANE_EN, 0x2Au);	/* v61: 0x2A lost lock */
+	for (unsigned pass = 0; pass < 2; pass++) {
+		for (unsigned k = 0; k < 11; k++) {
+			pc_wr(phy0, irq[k].addr, irq[k].val);
+			if (k == 10)
+				delay(100);
+		}
+	}
+	pc_wr(phy0, 0x1000u, 0x0Eu);
+	delay(10);
+	printf("PANDORA SLICEB: v37 rearm done ctrl0=%#x lane_en=%#x "
+	    "refgen=%#x\n", pc_rd(phy0, 0x1000u),
+	    pc_rd(phy0, PC_CSIPHY_V240_LANE_EN), pc_rd(phy0, 0x1184u));
+	(void)pandora_log_sync();
+}
+
+/* v45: the WM block is 0x1500 + 0x100*index on tfe1080, but the vendor
+ * rdi_hw_info table maps RDI0 to WM bit 12/13 (blocks 0x2100/0x2200), not
+ * mainline's 0x17 (0x2c00). Parameterize the block so one boot can sweep the
+ * three candidates and use frame bytes, not CSID BUF_DONE, as the oracle. */
+static void
+pc_sliceb_vfe2_arm_at(vm_offset_t vfe2, uint32_t wm)
+{
+	uint32_t stride = 4096u * 10u / 8u;               /* 5120 */
+	uint32_t incr = (stride * 2304u) >> 8;            /* 46080 */
+
+	pc_wr(vfe2, 0x1008u, 0x7ffffffu);  /* WM_CGC_OVERRIDE */
+	pc_wr(vfe2, 0x1128u, 0x0u);        /* WM_TEST_BUS_CTRL */
+	pc_wr(vfe2, wm + 0x08u, incr);     /* WM_FRAME_INCR */
+	pc_wr(vfe2, wm + 0x0cu, 0xffffu);  /* WM_IMAGE_CFG_0 */
+	pc_wr(vfe2, wm + 0x14u, 0xffffu);  /* WM_IMAGE_CFG_2 */
+	pc_wr(vfe2, wm + 0x18u, 0x0u);     /* WM_PACKER_CFG */
+	pc_wr(vfe2, wm + 0x30u, 0x0u);     /* IRQ_SUBSAMPLE_PERIOD */
+	pc_wr(vfe2, wm + 0x34u, 0x1u);     /* IRQ_SUBSAMPLE_PATTERN */
+	pc_wr(vfe2, wm + 0x38u, 0x0u);     /* FRAMEDROP_PERIOD */
+	pc_wr(vfe2, wm + 0x3cu, 0x1u);     /* FRAMEDROP_PATTERN */
+	pc_wr(vfe2, wm + 0x60u, 0x1u);     /* MMU_PREFETCH_CFG */
+	pc_wr(vfe2, wm + 0x64u, 0xffffffffu); /* MMU_PREFETCH_MAX_OFFSET */
+	pc_wr(vfe2, wm + 0x04u, (uint32_t)(PC_CAM_IOVA >> 8)); /* IMAGE_ADDR */
+	pc_wr(vfe2, wm + 0x00u, 0x10001u); /* WM_CFG: EN | MODE */
+	printf("PANDORA SLICEB: v45 VFE2 WM off=%#x cfg=%#x addr=%#x incr=%#x\n",
+	    wm, pc_rd(vfe2, wm), pc_rd(vfe2, wm + 0x04u),
+	    pc_rd(vfe2, wm + 0x08u));
+	(void)pandora_log_sync();
+}
+
+static void
+pc_sliceb_vfe2_arm(vm_offset_t vfe2)
+{
+	pc_sliceb_vfe2_arm_at(vfe2, 0x2c00u);
+}
+
+static void
+pc_sliceb_cphytest(void)
+{
+	static const uint32_t lane_off[] = { 0x0200u, 0x0600u, 0x0A00u };	/* v75: vendor/Android natural order */
+	static const uint32_t rcgs[2][2] = {
+		{ 0x21064u, 0x00100108u },	/* cphy_rx_clk_src 266.67 MHz */
+		{ 0x212a4u, 0x00100105u },	/* csid_clk_src 400 MHz */
+	};
+	vm_offset_t phy0, csid2, vfe2;
+	uint32_t seen_rdi = 0, base = 0, seen_buf = 0;
+	unsigned settle = 35u;	/* Android CAM_START_PHYDEV Settlecount */
+	int ret = 0;
+
+	pc_csiphy_mark("cphytest start: csiphy0 CPHY 3-lane -> CSID2");
+	phy0 = ml_io_map_unmappable(PC_CSIPHY0_PA, 0x2000u, VM_WIMG_IO);
+	csid2 = ml_io_map_unmappable(PC_CSID2_PA, 0x5e80u, VM_WIMG_IO);
+	vfe2 = ml_io_map_unmappable(PC_VFE2_PA, 0x4000u, VM_WIMG_IO);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!phy0 || !csid2 || !vfe2 || !pc_bdistm || !pc_tlmm || !pc_cci[0] ||
+	    !pc_camcc) {
+		printf("PANDORA SLICEB: cphytest map failed phy0=%#llx csid2=%#llx "
+		    "vfe2=%#llx\n", (unsigned long long)phy0,
+		    (unsigned long long)csid2, (unsigned long long)vfe2);
+		(void)pandora_log_sync();
+		return;
+	}
+	pc_csiphy0_va = phy0;
+
+	/* The slice-A clock bring-up enables PLL0 and reads MODE=0x20000105 at
+	 * 4.216 s; the same register only reads 0xe0000005 (LOCK_DET) about 97 ms
+	 * later. The v5 probe programmed the RCGs and branch enables inside that
+	 * lock window, so every CBCR still reported halted and CSID2's reset never
+	 * completed. Wait for LOCK_DET before touching any clock switch. */
+	{
+		uint32_t mode = 0;
+		unsigned waited = 0;
+
+		for (; waited < 300u; waited++) {
+			mode = pc_rd(pc_camcc, 0x00u);
+			if (mode & 0x80000000u)
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA SLICEB: cphytest pll0 mode=%#x locked=%u wait_ms=%u\n",
+		    mode, (mode & 0x80000000u) ? 1u : 0u, waited);
+		(void)pandora_log_sync();
+	}
+
+	/* Clock/power tree the TPG path proved against CSID0. Without the CPAS and
+	 * camnoc AHB clocks the CSID register file answers reads (AHB decode) but
+	 * its reset FSM never runs, which is exactly the w84 CSID2 symptom
+	 * (id readable, RST_CFG latched, INFO_RST_DONE never set). */
+	pc_sliceb_infra_up("cphytest");
+
+	/* v12 read-only instance map. The three CSID register files answer reads
+	 * (equal HW_VERSION), so print the per-instance resources no earlier
+	 * probe looked at: the head of each paired IFE window (the DT resolves
+	 * every CSID's rt-wrapper-base to 0x151000, i.e. inside ife0's window,
+	 * while ife1/ife2 have their own windows at 0x9171000/0x9191000), the
+	 * two CAMNOC windows and the CPAS top page (CPAS reg-names
+	 * cam_camnoc_rt/nrt/cam_cpas_top). Each IFE window read is gated on its
+	 * main branch having cleared halt: a read into a still-powered-off block
+	 * is a Synchronous External Abort (the TPG learned this on VFE0). */
+	{
+		static const struct { uint32_t pa; const char *name; } map[6] = {
+			{ 0x9151000u, "ife0" }, { 0x9171000u, "ife1" },
+			{ 0x9191000u, "ife2" }, { 0x9405000u, "camnoc_rt" },
+			{ 0x9117000u, "camnoc_nrt" }, { 0x900b000u, "cpas_top" }
+		};
+		static const uint32_t gate[3] = { 0x21030u, 0x210acu, 0x21110u };
+
+		for (unsigned i = 0; i < 6; i++) {
+			vm_offset_t b = ml_io_map_unmappable(map[i].pa, 0x100u, VM_WIMG_IO);
+
+			if (!b) {
+				printf("PANDORA SLICEB: %s map failed\n", map[i].name);
+				continue;
+			}
+			if (i < 3 && (pc_rd(pc_camcc, gate[i]) & 0x80000000u)) {
+				printf("PANDORA SLICEB: %s @%#x SKIPPED (main branch halted "
+				    "cbcr=%#x)\n", map[i].name, map[i].pa,
+				    pc_rd(pc_camcc, gate[i]));
+				continue;
+			}
+			printf("PANDORA SLICEB: %s @%#x = %#x %#x %#x\n", map[i].name,
+			    map[i].pa, pc_rd(b, 0x0), pc_rd(b, 0x4), pc_rd(b, 0x8));
+		}
+		(void)pandora_log_sync();
+	}
+
+	/* The PHY's 0.9 V analog rail is a camera-gated RPMh regulator.
+	 * DT `qcom,csiphy0@9523000`: csi-vdd-0p9-supply -> phandle 0x383 ->
+	 * /soc/rsc@18900000/drv@2/rpmh-regulator-l3i-e0 (regulator-name
+	 * pmh0110_i_l3, 880000-920000 uV, 151 mA), csi-vdd-1p2-supply ->
+	 * phandle 0x40 -> rpmh-regulator-l1d-e0 (pmh0110_d_l1, 1.2 V, already
+	 * enabled). The Android regulator class shows i_l3 DISABLED while the
+	 * camera is closed, and neither w79..w83 nor this probe's clock path
+	 * votes it. Without it the PHY keeps its register file readable over
+	 * AHB but cannot bring the lanes up. Vote it before touching the PHY. */
+	/* No PMIC rail writes here. Static review (see CAMERA_W84 §20) shows
+	 * pmh0110_i_l3 is a dynamic-domain rail whose TCS payloads are packed and
+	 * change every second; an earlier session was stopped from writing it.
+	 * Trials without this vote kept SpringBoard at 1 exec; every trial that
+	 * voted it re-exec'd SpringBoard ~20 times. The PHY's 0.9 V domain must be
+	 * handled by the proper domain vote, not a raw LDO write. */
+	/* Clock state copied from the streaming golden dump. The PLL0 is not
+	 * touched: L_VAL lives at 0x10 (0x0044003e) and USER_CTL at 0x18
+	 * (0x840f); w80 wrote 0x8608 into 0x10, which is not a clock control. */
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t cmd = pc_rd(pc_camcc, rcgs[i][0]);
+		pc_wr(pc_camcc, rcgs[i][0] + 4u, rcgs[i][1]);
+		pc_wr(pc_camcc, rcgs[i][0], (cmd & ~0x80000000u) | 0x3u);
+		for (unsigned k = 0; k < 50; k++) {
+			if (!(pc_rd(pc_camcc, rcgs[i][0]) & 0x1u))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA SLICEB: cphytest rcg%#x cmd=%#x cfg=%#x\n", rcgs[i][0],
+		    pc_rd(pc_camcc, rcgs[i][0]), pc_rd(pc_camcc, rcgs[i][0] + 4u));
+	}
+	pc_wr(pc_camcc, PC_CSIPHY0_CLK_CBCR,
+	    pc_rd(pc_camcc, PC_CSIPHY0_CLK_CBCR) | PC_CBCR_ENABLE);
+	/* cam_cc_csid_csiphy_rx_clk is the CSID-side gate of cphy_rx_clk_src and
+	 * appears in the CSID2 DT clock list ("csiphy_rx_clk"). Mainline
+	 * camcc-sm8750 registers it at 0x10020; every Canoe offset is that value
+	 * +0x10000 (camcc-canoe.ko contains no 0x1xxxx register constants), so
+	 * the Canoe register is 0x20020. Without it the CSID's PHY interface is
+	 * not clocked even though csid_clk itself is running. */
+	pc_wr(pc_camcc, 0x20020u, pc_rd(pc_camcc, 0x20020u) | PC_CBCR_ENABLE);
+	pc_wr(pc_camcc, 0x212bcu,
+	    pc_rd(pc_camcc, 0x212bcu) | PC_CBCR_ENABLE);
+	(void)pc_wait_branch_on("csiphy0", PC_CSIPHY0_CLK_CBCR);
+	(void)pc_wait_branch_on("csid_csiphy_rx", 0x20020u);
+	(void)pc_wait_branch_on("csid", 0x212bcu);
+	printf("PANDORA SLICEB: cphytest clocks csiphy0=%#x csid_rx=%#x csid=%#x "
+	    "core_ahb=%#x\n", pc_rd(pc_camcc, PC_CSIPHY0_CLK_CBCR),
+	    pc_rd(pc_camcc, 0x20020u), pc_rd(pc_camcc, 0x212bcu),
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR));
+	/* Bounded confirmation that the halt bit actually cleared; a halted
+	 * branch means CSID's reset will never acknowledge (v5 result). */
+	for (unsigned k = 0; k < 3; k++) {
+		uint32_t off = (k == 0) ? PC_CSIPHY0_CLK_CBCR :
+		    ((k == 1) ? 0x20020u : 0x212bcu);
+		unsigned ms = 0;
+
+		for (; ms < 100u; ms++) {
+			if (!(pc_rd(pc_camcc, off) & 0x80000000u))
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA SLICEB: cphytest branch%#x halt_clear_ms=%u cbcr=%#x\n",
+		    off, ms, pc_rd(pc_camcc, off));
+	}
+	(void)pandora_log_sync();
+
+	/* Stage 19: clocks only. No PHY, no sensor power, no CSID. */
+	if (pc_csiphy == 19u) {
+		printf("PANDORA SLICEB: cphytest stage19 done (clocks only)\n");
+		(void)pandora_log_sync();
+		return;
+	}
+
+	/* Vendor 2.4.0 order: reset asserted, common registers, per-lane 3-phase
+	 * table then the data-rate table at the same lane offset, lane enable,
+	 * and a 3-phase reset release writing 0x0E (not the D-PHY 0x02). */
+	pc_wr(phy0, 0x1000u, 0x01u);
+	delay(20);
+	/* Vendor start path polls the refgen status (0x1184, bit 7) after
+	 * enable_hw and before program_common_registers; configuring a PHY whose
+	 * reference generator is not up would silently lose the lane writes. */
+	{
+		uint32_t refgen = 0;
+		unsigned waited = 0;
+
+		for (; waited < 100u; waited++) {
+			refgen = pc_rd(phy0, 0x1184u);
+			if (refgen & 0x80u)
+				break;
+			pc_sleep(1);
+		}
+		printf("PANDORA SLICEB: cphytest refgen=%#x ready=%u wait_ms=%u\n",
+		    refgen, (refgen & 0x80u) ? 1u : 0u, waited);
+		(void)pandora_log_sync();
+	}
+	pc_wr(phy0, 0x1084u, 0x00u);
+	pc_wr(phy0, 0x108Cu, 0x0Eu);
+	pc_wr(phy0, 0x101Cu, 0x7Au);
+	pc_wr(phy0, 0x1018u, 0x01u);
+	pc_wr(phy0, PC_CSIPHY_V240_LANE_EN, 0x2Au);	/* v70: v65 lane enable */
+	for (unsigned l = 0; l < 3; l++) {
+		uint32_t off = lane_off[l];
+		for (unsigned i = 0; i < PC_CSIPHY_3PH_BASE_REGS_N; i++) {
+			const struct pc_csiphy_3ph_reg *r = &pc_csiphy_3ph_base_regs[i];
+			pc_wr(phy0, off + r->addr, r->val);
+			if (r->delay_us)
+				delay(r->delay_us);
+		}
+		for (unsigned i = 0; i < PC_CSIPHY_3PH_4P0G_REGS_N; i++) {
+			const struct pc_csiphy_3ph_reg *r = &pc_csiphy_3ph_4p0g_regs[i];
+			uint32_t val = r->val;
+			if (r->type == 1u)
+				val = settle & 0xffu;
+			else if (r->type == 2u)
+				val = (settle >> 8) & 0xffu;
+			pc_wr(phy0, off + r->addr, val);
+			if (r->delay_us)
+				delay(r->delay_us);
+		}
+	}
+	pc_wr(phy0, PC_CSIPHY_V240_LANE_EN, 0x2Au);	/* v70: v65 lane enable */
+	/* v27: do NOT run Force AON EQ here. Two complete Android dumps contain
+	 * zero AON Offset/Val write records and retain the base-table values
+	 * (lane+0x94 = 0x0d, +0x90 = 0x02). v26's forced sequence changed these
+	 * to 0x07/0x0f and was the only source of the artificial 0x13 trio state. */
+	/* v25: vendor csiphy_irq_reg_2_4_0 - cam_csiphy_cphy_irq_config() writes
+	 * these eleven 0x102C..0x1054 registers TWICE before the reset release
+	 * (the whole set read 0xff/0xfb/0x7f/0xef, i.e. IRQ sources ENABLED).
+	 * Slice A masked this exact window to 0 (CTRL11..21=0) and never
+	 * unmasked it; the C-PHY BIST status registers (lane+0x144) and the lane
+	 * event paths live in this domain, which explains the BIST=0 readings. */
+	{
+		static const struct { uint32_t addr; uint32_t val; } irq[11] = {
+			{ 0x102Cu, 0xffu }, { 0x1030u, 0xffu }, { 0x1034u, 0xfbu },
