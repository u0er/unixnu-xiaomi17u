+			(void)pandora_log_sync();
+		}
+		printf("PANDORA SLICEB: v42 VFE2 post-poll buf_done=%#x wm=%#x/%#x/%#x\n",
+		    seen_buf, pc_rd(vfe2, 0x2c00u), pc_rd(vfe2, 0x2c04u),
+		    pc_rd(vfe2, 0x2c08u));
+		(void)pandora_log_sync();
+		if (pc_frame_va) {
+			volatile uint32_t *fb = (volatile uint32_t *)pc_frame_va;
+			unsigned n_a5 = 0, n_other = 0, first_idx = 0;
+			uint32_t first_other = 0;
+
+			pc_dcache_invalidate(pc_frame_va, PC_CAM_FRAME_BYTES);
+			for (unsigned i = 0; i < 0x100000u / 4u; i++) {
+				uint32_t w = fb[i];
+
+				if (w == 0xa5a5a5a5u)
+					n_a5++;
+				else {
+					if (!n_other) {
+						first_idx = i;
+						first_other = w;
+					}
+					n_other++;
+				}
+			}
+			printf("PANDORA SLICEB: v42 frame first=%#x/%#x/%#x/%#x "
+			    "a5=%u other=%u first_other=%#x@%u\n", fb[0], fb[1],
+			    fb[2], fb[3], n_a5, n_other, first_other, first_idx);
+			(void)pandora_log_sync();
+			pc_wr(vfe2, 0x2c00u, 0x0u); /* stop VFE2 WM after one look */
+		}
+
+		/* v24: re-sweep the RX_CFG0 mux candidates INSIDE the stream window.
+		 * The w52-era sweep (phy 0/1 x lane_assign 0x210/0x0139) ran while
+		 * CSID2's reset never acked, i.e. the RX was dead for every
+		 * candidate - the sweep proved nothing. The reset is fixed now and
+		 * the sensor streams continuously (single table replay), so each
+		 * candidate gets a fresh arm (reset acked per candidate) + 300 ms
+		 * poll while real C-PHY data is flowing. */
+		pc_csiphy_mark("cphytest v24 RX_CFG0 mux re-sweep (reset fixed, sensor streaming)");
+		{
+			static const struct { uint32_t cfg; const char *name; } cands[6] = {
+				{ 0x01002102u, "cphy0/0x210" }, { 0x01102102u, "cphy1/0x210" },
+				{ 0x01102102u, "phy1/0x210" }, { 0x00002102u, "phy0/0x210" },
+				{ 0x00101392u, "phy1/0x0139" }, { 0x00001392u, "phy0/0x0139" },
+			};
+
+			for (unsigned i = 0; i < 6; i++) {
+				uint32_t b = pc_sliceb_arm(csid2, cands[i].cfg);
+
+				if (!b) {
+					printf("PANDORA SLICEB: v24 %s arm FAILED (rst_done=0)\n",
+					    cands[i].name);
+					continue;
+				}
+				uint32_t seen = pc_sliceb_poll(csid2, 300, NULL, NULL);
+				printf("PANDORA SLICEB: v24 %s rdi=%#x sof=%u eof=%u "
+				    "rx_irq=%#x rdin=%#x\n", cands[i].name, seen,
+				    (seen & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+				    (seen & PC_RDIN_INPUT_EOF) ? 1u : 0u,
+				    pc_rd(csid2, 0x1b0u), pc_rd(csid2, 0x224u));
+				(void)pandora_log_sync();
+			}
+		}
+	}
+	pc_sliceb_cphy_phy_status(phy0, "after-poll");
+	printf("PANDORA SLICEB: cphytest RESULT rdi=%#x rup=%u buf_done=%#x "
+	    "arm=%#x rx_irq=%#x frame_done_irq=none\n", seen_rdi,
+	    (seen_rdi & PC_RDIN_RUP_DONE) ? 1u : 0u, seen_buf, base,
+	    pc_rd(csid2, 0x1b0u));
+	(void)pandora_log_sync();
+
+	/* v19 TPG-mux bisect, dual test. v18 retargeted CSID2's RX to tpg2 but
+	 * stayed silent while CSID0 proved the same mux at w41 - the v18 attempt
+	 * skipped the AUP/RUP strobes that pc_sliceb_arm fires AFTER RX_CFG0.
+	 * This round runs BOTH instances with the full proven sequence:
+	 *   - CSID0 positive control: reset -> tpg2 config -> RX_CFG0=0x38032103
+	 *     -> RDI0 latch -> AUP/RUP -> poll (w41 expected SOF);
+	 *   - CSID2 retry: the same full sequence on CSID2 (no reset repeat; the
+	 *     reset already acked at arm time). */
+	pc_csiphy_mark("cphytest v19 TPG-mux dual test (CSID0 control + CSID2 retry)");
+	{
+		vm_offset_t tpg2 = ml_io_map_unmappable(PC_TPG2_PA, 0x400u, VM_WIMG_IO);
+		uint32_t tv = tpg2 ? pc_rd(tpg2, 0x0u) : 0u;
+
+		if (!tpg2) {
+			printf("PANDORA SLICEB: tpg2 map failed (bisect skipped)\n");
+		} else if (tv != 0x20040000u) {
+			printf("PANDORA SLICEB: tpg2 hwver=%#x unexpected (bisect skipped)\n",
+			    tv);
+		} else {
+			static const struct { uint32_t pa; const char *name; } inst[2] = {
+				{ 0x09253000u, "csid0" }, { 0x09273000u, "csid2" } };
+
+			printf("PANDORA SLICEB: tpg2 hwver=%#x (2.4.0)\n", tv);
+			/* v20: the TPG path's S9 step - enable the GCC camera hf/sf AXI
+			 * bridge BEFORE streaming. pc_tpg_p0_bringup does this between
+			 * the CAMCC tree and every successful TPG->CSID stream (w41);
+			 * the cphytest path never did, which is the one remaining
+			 * environment difference the v19 dual test had vs w41. */
+			vm_offset_t gccaxi = ml_io_map_unmappable(PC_GCC_CAM_AXI_PA,
+			    0x1000u, VM_WIMG_IO);
+
+			if (gccaxi) {
+				uint32_t hf = pc_rd(gccaxi, PC_GCC_HF_AXI_OFF);
+				uint32_t sf = pc_rd(gccaxi, PC_GCC_SF_AXI_OFF);
+
+				pc_wr(gccaxi, PC_GCC_HF_AXI_OFF, hf | PC_CBCR_ENABLE);
+				pc_wr(gccaxi, PC_GCC_SF_AXI_OFF, sf | PC_CBCR_ENABLE);
+				printf("PANDORA SLICEB: gcc cam-axi hf %#x->%#x sf "
+				    "%#x->%#x\n", hf, pc_rd(gccaxi, PC_GCC_HF_AXI_OFF),
+				    sf, pc_rd(gccaxi, PC_GCC_SF_AXI_OFF));
+				(void)pandora_log_sync();
+			} else {
+				printf("PANDORA SLICEB: gcc cam-axi map failed\n");
+			}
+			pc_wr(tpg2, PC_TPG_CTRL_CMD, PC_TPG_CMD_HW_RESET);
+			pc_sleep(1);
+			pc_wr(tpg2, 0x68u, 0x0u);         /* VC_0_CFG0: continuous */
+			pc_wr(tpg2, 0x6cu, 0x12345678u);  /* VC_0_LSFR_SEED */
+			pc_wr(tpg2, 0x70u, 0x442u);       /* VC_0_HBI_CFG */
+			pc_wr(tpg2, 0x74u, 0x30u);        /* VC_0_VBI_CFG */
+			pc_wr(tpg2, 0x78u, 0xa00u);       /* VC_0_COLOR_BARS_CFG */
+			pc_wr(tpg2, 0x7cu, 0x028001e0u);  /* DT_0_CFG_0: 640x480 */
+			pc_wr(tpg2, 0x80u, 0x2bu);        /* DT_0_CFG_1: RAW10 */
+			pc_wr(tpg2, 0x84u, 0x20000be8u);  /* DT_0_CFG_2: payload 8 */
+			pc_wr(tpg2, PC_TPG_CTRL, PC_TPG_CTRL_4LANE_1VC); /* 4 lane, 1 VC */
+			pc_sleep(2);
+			(void)pandora_log_sync();
+
+			for (unsigned i = 0; i < 2; i++) {
+				vm_offset_t c = ml_io_map_unmappable(inst[i].pa, 0x5e80u,
+				    VM_WIMG_IO);
+				unsigned rst = 0, try = 0;
+				uint32_t rdi_base = 0;
+
+				if (!c) {
+					printf("PANDORA SLICEB: %s map failed\n",
+					    inst[i].name);
+					continue;
+				}
+				if (i == 0) {
+					/* positive control: fresh reset on CSID0 */
+					rst = pc_csid_reset_once(c);
+				} else {
+					/* CSID2 already reset+armed at 4.3 s; do not repeat */
+					rst = 1;
+				}
+				printf("PANDORA SLICEB: %s rst=%u\n", inst[i].name, rst);
+				pc_wr(c, 0x880u, 0x38032103u);  /* RX_CFG0: tpg2 mux */
+				pc_wr(c, 0x884u, 0x1u);         /* RX_CFG1: ECC */
+				for (try = 0; try < 50; try++) {
+					pc_wr(c, PC_RDI_CFG0(0), 0x002bf160u);
+					if (pc_rd(c, PC_RDI_CFG0(0)) == 0x002bf160u) {
+						rdi_base = PC_RDI_CFG0(0);
+						break;
+					}
+					pc_sleep(1);
+				}
+				if (!rdi_base) {
+					printf("PANDORA SLICEB: %s RDI0 latch failed\n",
+					    inst[i].name);
+					continue;
+				}
+				pc_wr(c, PC_RDI_CFG0(0), 0x002bf160u);
+				pc_wr(c, PC_RDI_CFG1(0), 0x8000u);
+				pc_wr(c, 0x5498u, 0x9u);        /* PIX_STORE */
+				pc_wr(c, PC_RDI_CTRL(0), 0x0u); /* START_CMD: stop */
+				pc_wr(c, PC_RDI_CFG0(0),
+				    pc_rd(c, PC_RDI_CFG0(0)) | 0x80000000u);
+				for (unsigned k = 0; k < 2; k++) {
+					pc_wr(c, 0x118u, 0x100u);   /* AUP_CMD: RDI0 */
+					pc_wr(c, 0x11cu, 0x1u);     /* RUP_AUP_CMD */
+				}
+				pc_wr(c, 0x114u, 0x100u);       /* RUP_CMD: RDI0 */
+				pc_wr(c, 0x11cu, 0x1u);
+				pc_wr(c, PC_RDI_CTRL(0), PC_RDI_CTRL_START); /* START_CMD: 1 */
+				pc_sleep(2);
+				pc_rx_cfg0_report(c, "v19-bisect");
+				pc_rdi_irq_report(c, "v19-bisect");
+				pc_sleep(2);
+				/* v21: the missing piece v18-v20 had - the TPG only
+				 * produces frames after CTRL_CMD TEST_EN (P5b of the
+				 * proven stream: "start TPG after RX/RDI ready"). Fire it
+				 * once when the first instance's RX/RDI is ready; the
+				 * second instance's RX muxes to the same running TPG. */
+				if (i == 0) {
+					pc_wr(tpg2, PC_TPG_CTRL_CMD, PC_TPG_CMD_TEST_EN);
+					pc_sleep(2);
+					printf("PANDORA SLICEB: tpg2 TEST_EN fired "
+					    "ctrl_cmd=%#x hw_status=%#x\n",
+					    pc_rd(tpg2, 0x1f4u), pc_rd(tpg2, 0x4u));
+					(void)pandora_log_sync();
+				}
+				uint32_t seen_buf = 0;
+				uint32_t seen = pc_sliceb_poll(c, 500, NULL, &seen_buf);
+				if (i == 1) {
+					/* v45 differential: CSID2 has already proved TPG
+					 * EOF. Sweep the three WM block candidates and
+					 * use *frame bytes*, not BUF_DONE, as the oracle:
+					 * 0x2c00 = mainline WM 0x17; 0x2100/0x2200 =
+					 * vendor RDI0 bitmap bits 12/13. */
+					/* v87: 0x2100/0x2200 are not camera RDI0 WMs; v45
+					 * proved only 0x2c00 ever writes frame bytes. Do
+					 * not touch the two non-camera WM blocks while
+					 * checking the desktop. */
+					static const uint32_t wm_cands[] = { 0x2c00u };
+
+					for (unsigned wi = 0;
+					    wi < sizeof(wm_cands) / sizeof(wm_cands[0]);
+					    wi++) {
+						uint32_t wm = wm_cands[wi];
+						unsigned a5n = 0, other = 0;
+						uint32_t first = 0;
+						unsigned first_idx = 0;
+
+						if (pc_frame_va) {
+							volatile uint32_t *fb =
+							    (volatile uint32_t *)pc_frame_va;
+
+							for (unsigned k = 0;
+							    k < PC_CAM_FRAME_BYTES / 4; k++)
+								fb[k] = 0xa5a5a5a5u;
+							clean_dcache64(pc_frame_pa,
+							    PC_CAM_FRAME_BYTES, TRUE);
+						}
+						pc_sliceb_vfe2_arm_at(vfe2, wm);
+						pc_wr(vfe2, wm + 0x08u, 0x5dcu);
+						pc_wr(c, 0x1a8u, 0x10000u);
+						pc_wr(c, 0x114u, 0x100u);
+						pc_wr(c, 0x118u, 0x100u);
+						pc_wr(c, 0x11cu, 0x1u);
+						seen_buf = 0;
+						seen = pc_sliceb_poll(c, 500, NULL,
+						    &seen_buf);
+						if (pc_frame_va) {
+							volatile uint32_t *fb =
+							    (volatile uint32_t *)pc_frame_va;
+
+							pc_dcache_invalidate(pc_frame_va,
+							    PC_CAM_FRAME_BYTES);
+							for (unsigned k = 0;
+							    k < PC_CAM_FRAME_BYTES / 4; k++) {
+								uint32_t v = fb[k];
+
+								if (v == 0xa5a5a5a5u)
+									a5n++;
+								else {
+									if (!other) {
+										first = v;
+										first_idx = k;
+									}
+									other++;
+								}
+							}
+						}
+						printf("PANDORA SLICEB: v45 wmprobe "
+						    "off=%#x sof=%u eof=%u buf=%#x "
+						    "a5=%u other=%u first=%#x@%u\n",
+						    wm, (seen >> 12) & 1,
+						    (seen >> 9) & 1, seen_buf,
+						    a5n, other, first, first_idx);
+						(void)pandora_log_sync();
+						pc_wr(vfe2, wm, 0x0u);
+					}
+				}
+				printf("PANDORA SLICEB: %s TPG-mux RESULT rdi=%#x sof=%u "
+				    "eof=%u rx_irq=%#x rdin=%#x buf=%#x\n",
+				    inst[i].name, seen,
+				    (seen & PC_RDIN_INPUT_SOF) ? 1u : 0u,
+				    (seen & PC_RDIN_INPUT_EOF) ? 1u : 0u,
+				    pc_rd(c, 0x1b0u), pc_rd(c, 0x224u), seen_buf);
+				(void)pandora_log_sync();
+			}
+		}
+	}
+	pc_sliceb_stream_on(0);
+
+	/* v22 C-PHY BIST: the vendor 2.4.0 bist_3ph array programs a known
+	 * pattern into each lane's own receive path (final write 0x0040=0x85
+	 * arms it) and the per-lane BIST status/counters at lane+0x144 then
+	 * move. This bypasses the sensor entirely: nonzero counters = the
+	 * CSIPHY0 lane analog/digital receive path works, pointing the silent
+	 * real-sensor window at the sensor output or the electrical link; zero
+	 * counters = the lane receive path itself is dead (consistent with the
+	 * hw_version=0 anomaly). Runs last: the writes replace the lane receive
+	 * config, which is fine because every sensor-window measurement is done. */
+	pc_csiphy_mark("cphytest v22 C-PHY BIST on lanes 0/1/2");
+	{
+		static const struct { uint32_t addr; uint32_t val; } bist[15] = {
+			{ 0x0030u, 0x1Cu }, { 0x0034u, 0xFAu }, { 0x0038u, 0xD4u },
+			{ 0x003Cu, 0x59u }, { 0x0058u, 0x10u }, { 0x00C8u, 0xAAu },
+			{ 0x00D0u, 0xAAu }, { 0x00D4u, 0x64u }, { 0x00D8u, 0x3Eu },
+			{ 0x0048u, 0x00u }, { 0x004Cu, 0x07u }, { 0x0050u, 0x00u },
+			{ 0x0044u, 0xB1u }, { 0x005Cu, 0x04u }, { 0x0040u, 0x85u },
+		};
+		static const uint32_t lanes[3] = { 0x0200u, 0x0600u, 0x0A00u };
+
+		for (unsigned i = 0; i < 3; i++) {
+			for (unsigned k = 0; k < 15; k++)
+				pc_wr(phy0, lanes[i] + bist[k].addr, bist[k].val);
+			pc_sleep(5);
+			printf("PANDORA SLICEB: bist lane%u armed: st344=%#x st744=%#x "
+			    "stB44=%#x trio=%#x/%#x/%#x\n", i, pc_rd(phy0, 0x0344u),
+			    pc_rd(phy0, 0x0744u), pc_rd(phy0, 0x0B44u),
+			    pc_rd(phy0, 0x0358u), pc_rd(phy0, 0x0758u),
+			    pc_rd(phy0, 0x0B58u));
+		}
+		pc_sleep(50);
+		printf("PANDORA SLICEB: bist settle: st344=%#x st744=%#x stB44=%#x "
+		    "cnt348=%#x cnt748=%#x cntB48=%#x trio=%#x/%#x/%#x\n",
+		    pc_rd(phy0, 0x0344u), pc_rd(phy0, 0x0744u), pc_rd(phy0, 0x0B44u),
+		    pc_rd(phy0, 0x0348u), pc_rd(phy0, 0x0748u), pc_rd(phy0, 0x0B48u),
+		    pc_rd(phy0, 0x0358u), pc_rd(phy0, 0x0758u), pc_rd(phy0, 0x0B58u));
+		(void)pandora_log_sync();
+	}
+
+	/* v23 variant scan: the DT says csiphy0/3/4 are "qcom,csiphy-v2.4.0-1"
+	 * while csiphy1/2/5 are plain "qcom,csiphy-v2.4.0" - two register-set
+	 * variants of the same 2.4.0 hardware. Every anomaly (hw_version=0,
+	 * trio=0, BIST=0) was measured on the -1 variant with the plain-v2.4.0
+	 * tables. Scan ALL six PHYs with the identical probe (CTRL6=2 hw-version
+	 * strobe + lane0 BIST arm) and read back: if the plain-v2.4.0 PHYs
+	 * respond and the -1 ones do not, the w84 tables are the wrong variant
+	 * for this PHY and the whole receive bring-up must be redone from the
+	 * -1 register set. */
+	pc_csiphy_mark("cphytest v23 six-PHY variant scan");
+	{
+		static const struct { uint32_t pa; unsigned variant; } phys[6] = {
+			{ 0x09523000u, 1 }, { 0x09525000u, 0 }, { 0x09527000u, 0 },
+			{ 0x09529000u, 1 }, { 0x0952B000u, 1 }, { 0x0952D000u, 0 },
+		};
+
+		for (unsigned i = 0; i < 6; i++) {
+			vm_offset_t b = ml_io_map_unmappable(phys[i].pa, 0x2000u,
+			    VM_WIMG_IO);
+
+			if (!b) {
+				printf("PANDORA SLICEB: v23 csiphy%u map failed\n", i);
+				continue;
+			}
+			pc_wr(b, PC_CPHY_CTRL(6), 2u);
+			pc_sleep(1);
+			printf("PANDORA SLICEB: v23 csiphy%u (variant -%d) hwver=%#x "
+			    "%#x %#x %#x ctrl4=%#x\n", i, phys[i].variant,
+			    pc_rd(b, PC_CPHY_STATUS(12)), pc_rd(b, PC_CPHY_STATUS(13)),
+			    pc_rd(b, PC_CPHY_STATUS(14)), pc_rd(b, PC_CPHY_STATUS(15)),
+			    pc_rd(b, 0x0210u));
+			pc_wr(b, 0x0200u + 0x0040u, 0x85u); /* lane0 BIST arm */
+			pc_sleep(5);
+			printf("PANDORA SLICEB: v23 csiphy%u bist arm40=%#x st=%#x "
+			    "cnt=%#x trio=%#x\n", i, pc_rd(b, 0x0240u),
+			    pc_rd(b, 0x0344u), pc_rd(b, 0x0348u), pc_rd(b, 0x0358u));
+			(void)pandora_log_sync();
+		}
+	}
+	/* Drop the camera-gated 0.9 V analog vote again. */
+	pc_csiphy_mark("cphytest done (sensor left in standby)");
+}
+
+/* Stage 20 (pandora_csiphy=20): RPMh + sensor power path only.
+ * No CAMCC clock writes, no PHY register writes, no CSID touch. Used to
+ * bisect which probe side effect disturbs userland. */
+static void
+pc_sliceb_poweronly(void)
+{
+	int ret = 0;
+
+	pc_csiphy_mark("poweronly start: L3I_E0 + sensor power_up + replay");
+	if (!pc_bdistm)
+		pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000u, VM_WIMG_IO);
+	if (!pc_tlmm)
+		pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000u, VM_WIMG_IO);
+	if (!pc_cci[0])
+		pc_cci[0] = ml_io_map_unmappable(PC_CCI_PA(0), 0x1000u, VM_WIMG_IO);
+	if (!pc_bdistm || !pc_tlmm || !pc_cci[0]) {
+		printf("PANDORA SLICEB: poweronly map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	(void)pc_sensor_power_up();
+	pc_sleep(20);
+	pc_sensor_apply_tbl(pc_wide_tbl, pc_wide_tbl_n, PC_SLICEB_MASTER,
+	    PC_SLICEB_SLAVE, 1u, 0u, "wide-poweronly");
+	pc_sliceb_stream_on(0);
+	pc_sleep(2);
+	printf("PANDORA SLICEB: poweronly chip_id=%#x ret=%d\n",
+	    pc_sliceb_rd8(0x0000u, &ret), ret);
+	(void)pandora_log_sync();
+	pc_csiphy_mark("poweronly done");
+}
+
+/* Stage 21 (pandora_csiphy=21): read-only PHY liveness, no writes. */
+static void
+pc_sliceb_phyread(void)
+{
+	vm_offset_t phy0;
+
+	pc_csiphy_mark("phyread start: csiphy0 read-only");
+	phy0 = ml_io_map_unmappable(PC_CSIPHY0_PA, 0x2000u, VM_WIMG_IO);
+	if (!phy0) {
+		printf("PANDORA SLICEB: phyread map failed\n");
+		(void)pandora_log_sync();
+		return;
+	}
+	pc_csiphy0_va = phy0;
+	pc_sliceb_cphy_phy_status(phy0, "readonly");
+	printf("PANDORA SLICEB: phyread ctrl0=%#x lane_en=%#x ctrl6=%#x ctrl7=%#x "
+	    "common1084=%#x common108c=%#x\n", pc_rd(phy0, 0x1000u),
