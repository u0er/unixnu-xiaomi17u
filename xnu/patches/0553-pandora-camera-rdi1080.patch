+ * This probe applies the vendor 2.4.0 3-phase lane/datarate tables at the
+ * vendor CPHY lane offsets 0x0200/0x0600/0x0A00, enables the same clock state
+ * Android uses while streaming, and arms CSID2 with
+ * (phy 0 << 20) | (lane_assign 0x210 << 4) | (lane_cnt-1 = 2). */
+static void
+pc_sliceb_cphy_phy_status(vm_offset_t phy0, const char *phase)
+{
+	uint32_t t0 = pc_rd(phy0, 0x0358u), t1 = pc_rd(phy0, 0x0758u),
+	    t2 = pc_rd(phy0, 0x0B58u);
+
+	/* Vendor cam_csiphy_core.c reads each trio status masked with 0x1F and
+	 * treats 0 or 8 as the normal idle/locked value; anything else is worth
+	 * reporting. Raw values are printed so the mask is auditable. */
+	printf("PANDORA SLICEB: cphytest %s stat1138=%#x trio=%#x/%#x/%#x "
+	    "trio_low=%#x/%#x/%#x refgen=%#x irq=%#x/%#x\n", phase,
+	    pc_rd(phy0, 0x1138u), t0, t1, t2, t0 & 0x1Fu, t1 & 0x1Fu, t2 & 0x1Fu,
+	    pc_rd(phy0, 0x1184u), pc_rd(phy0, 0x1138u), pc_rd(phy0, 0x113cu));
