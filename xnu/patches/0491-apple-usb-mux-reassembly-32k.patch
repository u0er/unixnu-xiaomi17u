--- a/bsd/dev/apple_usbmux.c
+++ b/bsd/dev/apple_usbmux.c
@@ -28,7 +28,21 @@
 #include "apple_usb.h"
 
 #define AMUX_MAX_CONN   8
-#define AMUX_RXBUF      8192
+/*
+ * Reassembly window for one inbound mux frame, and therefore the largest
+ * frame a host may send: AMUX_MUX_HDR (16) + AMUX_TCP_HDR (20) + one AFC
+ * packet.  With this at 32768 the biggest usable AFC packet is 32732 bytes,
+ * which is an AFC header (40) plus an 8-byte handle plus a 32684-byte write
+ * chunk -- exactly the MAX_WRITE the host scripts use.
+ *
+ * At 8192 every 16 KiB host write chunk was torn apart: apple_usbmux_input()
+ * dropped the frame with "reassembly overflow", the residual payload bytes
+ * were then re-parsed as a frame header ("bad frame length %u, resync"), and
+ * neither path replies -- so the host saw a silent timeout and the AFC
+ * session never recovered.  That was the real reason a 123-byte loopback
+ * passed while every real upload hung.
+ */
+#define AMUX_RXBUF      32768
 #define AMUX_RING       65536   /* >= one 32 KiB AFC reply plus a queued one */
 #define AMUX_CTRL_Q     8
 #define AMUX_CTRL_MAX   96
@@ -327,6 +341,24 @@ amux_syn(uint16_t hsport, uint16_t hdport, uint32_t seq)
 		mux_send_small(hdport, hsport, 0, seq + 1, TH_RST | TH_ACK);
 		return;
 	}
+	/*
+	 * A retransmitted SYN for a 4-tuple we already own must re-answer, not
+	 * allocate a second connection.  conn_alloc() happily returned the next
+	 * free slot, which left the first connection unreachable (the new one
+	 * shadowed it in conn_find) while it still held a 64 KiB ring and an AFC
+	 * session slot; four SYNs were enough to exhaust AFC_SLOTS and every
+	 * later StartService got "refused port".
+	 */
+	c = conn_find(hdport, hsport);
+	if (c != NULL) {
+		c->rx_seq = seq + 1;
