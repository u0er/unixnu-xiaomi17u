-sweet_nub_vtable_ok(void)
-{
-	const uint64_t *vt = (const uint64_t *)SWEET_NUB_CTL_VTABLE;
-	if ((uint64_t)vt < SWEET_NUB_KERNEL_BASE)
+sweet_nub_vtable_ok(void **vt, uint64_t *pure_target)
+{
+	/*
+	 * 0509: validate the table the OBJECT actually carries, and treat the compile-time
+	 * address as an observation, not as ground truth. Measured on the 0508b prelink:
+	 * the table VA and slot 0 / slot 86 survived a kernel change, but the 18 pure slots
+	 * moved 0xfffffff0079eff24 -> 0xfffffff0079f0394 with the kernel text (that address
+	 * lives in __TEXT, not in the appended kext region). Requiring equality with the old
+	 * pure address would therefore reject a perfectly good prelink.
+	 *
+	 * The layout-independent invariants are: the pointer is in the kernel image, the
+	 * start slot holds a kernel function, and the 18 pure slots all hold the SAME kernel
+	 * function (__cxa_pure_virtual). That is what this checks.
+	 */
+	if (vt == NULL || (uint64_t)vt < SWEET_NUB_KERNEL_BASE)
 		return false;
 	if ((vt[SWEET_NUB_START_SLOT] & 0xfffffff000000000ULL) != SWEET_NUB_KERNEL_BASE)
 		return false;
-	for (unsigned i = 0; i < sizeof(sweet_nub_pure_slots) / sizeof(sweet_nub_pure_slots[0]); i++) {
-		uint64_t target = vt[sweet_nub_pure_slots[i]];
-		if ((target & 0xfffffff000000000ULL) != SWEET_NUB_KERNEL_BASE)
+	uint64_t first = (uint64_t)vt[sweet_nub_pure_slots[0]];
+	if ((first & 0xfffffff000000000ULL) != SWEET_NUB_KERNEL_BASE)
+		return false;
+	for (unsigned i = 1; i < sizeof(sweet_nub_pure_slots) / sizeof(sweet_nub_pure_slots[0]); i++) {
+		if ((uint64_t)vt[sweet_nub_pure_slots[i]] != first)
 			return false;
 	}
+	if (pure_target)
+		*pure_target = first;
 	return true;
 }
 
