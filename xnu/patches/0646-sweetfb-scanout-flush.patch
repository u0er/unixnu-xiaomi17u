+/* Patch 0646: with fill=1 the pipes read the client's surface straight from memory, and
+ * the only cache maintenance on that surface is the Metal client's own -finish flush,
+ * which runs after the fence the framebuffer waits on (ctc 0.9-2.9 ms in the img26g ring).
+ * A cacheable writer's dirty lines can therefore still sit in the CPU when the pipes latch
+ * the frame, and the screen shows a mix of this frame and the one before. img26i runs it by
+ * default: the scanned rectangle is cleaned right before the pipes are given it, the one
+ * ordering the display can rely on; sweetfb_scan_flush=0 restores the pre-0646 bytes. */
+static bool
+sweetfb_scan_flush(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		on = 1;
+		PE_parse_boot_argn("sweetfb_scan_flush", &on, sizeof(on));
+		if (on) {
+			IOLog("SWEET FB: scanout flush on (sweetfb_scan_flush=1 default; =0 off): surfaces cleaned before the pipes read them\n");
+		}
+	}
+	return on != 0;
+}
+
 /* LANE_ISLAND: UIKit frame {{132.5, 12.875}, {110, 32}} on the 375 pt logical
