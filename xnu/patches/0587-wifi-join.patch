     printf("NEZHA WIFI: passive scan completed with %u BSS; awaiting explicit network selection\n",
         wifi_wmi.bss_count);
     return 0;
@@ -1555,6 +1559,7 @@ wifi_thread(void *unused, wait_result_t result)
         wifi_net_state = PeachNetReady;
