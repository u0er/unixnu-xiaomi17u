diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -2484,6 +2484,7 @@
 	}
 	uint8_t *out = dst;
 	int error = 0;
+	uint64_t since_yield = 0;
 	lck_mtx_lock(&sweet_ufs_lock);
 	su.lun = p->lun;
 	while (len && !error) {
@@ -2500,6 +2501,22 @@
 		out += got;
 		off += got;
 		len -= got;
+		/*
+		 * 0598 (lane7 D): a 43 MB segment is read in one part_read() call, and the whole
+		 * call holds sweet_ufs_lock.  pl_thread's first flush waits on that lock, so the
+		 * ring stays empty until the reset.  Give the lock up for 1 ms after every
+		 * BOUNCE_SIZE (1 MiB) copied; the waiter hands off, the log thread runs, and the
+		 * read resumes where it stopped.  67 MiB costs 67 ms of delay.
+		 */
+		since_yield += got;
+		if (since_yield >= BOUNCE_SIZE) {
+			su.lun = 0;
+			lck_mtx_unlock(&sweet_ufs_lock);
+			delay(1000);
+			lck_mtx_lock(&sweet_ufs_lock);
+			su.lun = p->lun;
+			since_yield = 0;
+		}
 	}
 	su.lun = 0;
 	lck_mtx_unlock(&sweet_ufs_lock);
