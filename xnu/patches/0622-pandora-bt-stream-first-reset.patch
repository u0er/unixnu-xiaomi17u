+/* Level 20.69 (v2066, 0622a): D5 post-reset byte classification.
+ * Counts everything the ROM sends in a fixed window; the first 512 bytes are
+ * parsed for 34 00 ff / f0 04 records so the seq progress is evidence, not a
+ * claim. Only a 0-byte window may reach the DEAD literal in the arm. */
+static void
+bt_peri_post_reset_stream(unsigned window_ms, const char *what,
+    struct bt_peri_stream_obs *obs)
+{
+	static const uint8_t ack = 0xfc;
+	uint8_t head[BT_PERI_HEAD_KEEP];
+	unsigned n = 0;
+	uint64_t start = bt_peri_uptime_ms();
+	uint64_t deadline;
+
+	memset(obs, 0, sizeof(*obs));
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint32_t st = bt_rd(BT_W_SE, SE_RX_FIFO_ST);
+		unsigned words = st & 0x1ffffffu;
+
+		if (!words) {
+			bt_sleep(50);
+			continue;
+		}
+		while (words-- != 0u) {
+			uint8_t b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+
+			if (b == 0xfdu) {
+				(void)bt_uart_tx(&ack, 1u, "post-reset stream ACK FC");
+			}
+			obs->bytes++;
+			if (n < sizeof(head)) {
+				head[n++] = b;
+			}
+		}
+	}
+	obs->elapsed = (unsigned)(bt_peri_uptime_ms() - start);
+	obs->rate = obs->bytes * 1000u /
+	    (obs->elapsed != 0u ? obs->elapsed : 1u);
+	for (unsigned i = 0u; i + 4u <= n; ) {
+		unsigned plen;
+
+		if (head[i] != 0x34u || head[i + 1u] != 0x00u ||
+		    head[i + 2u] != 0xffu) {
+			i++;
+			continue;
+		}
+		plen = head[i + 3u];
+		if (i + 4u + plen > n) {
+			break;
+		}
+		if (plen >= 7u && head[i + 4u] == 0xf0u &&
+		    head[i + 5u] == 0x04u) {
+			obs->records++;
+			obs->seq = head[i + 6u];
+		}
+		i += 4u + plen;
+	}
+	printf("PANDORA BT: %s: post-reset stream: %u byte(s) in %u ms (%u B/s), "
+	    "%u f0 04 record(s) in the first %u byte(s), last seq %02x -> %s\n",
+	    what, obs->bytes, obs->elapsed, obs->rate, obs->records, n, obs->seq,
+	    obs->bytes == 0u ? "ROM SILENT" :
+	    (obs->bytes >= BT_STREAM_ALIVE_MIN_BYTES ? "ROM STILL STREAMING" :
+	    "BELOW LIVENESS FLOOR"));
+	pandora_log_sync();
+}
