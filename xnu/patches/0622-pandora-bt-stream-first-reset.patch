+/* Level 20.69 (v2066, 0622a): the reset arm, stream-first.
+ *
+ * Order is the whole experiment: drain to a real 200 ms silence (D1), then
+ * and only then decide whether to spend the once-per-boot reset (D2). If the
+ * stream never quiets the arm returns BT_PERI_MAP_A_DEFERRED with the
+ * one-shot untouched, so a later boot still owns it. With the line quiet the
+ * 6-byte reset and the fd wake go out together; a 300 ms single window counts
+ * any 34 00 ff event or fc/fe/ff as "ROM heard it" and charges every other
+ * byte to the stream (D3). The next 500 ms are classified by bytes before any
+ * protocol judgement (D5): >=1024 B and >=300 ms is NOT_LANDED and no DEAD
+ * literal is printed; 1..1023 B is INCONCLUSIVE; only 0 B re-enters the
+ * 0620 chain (arbitrate/version/GetVer/replay/0x19), whose waits alone are
+ * the tolerant ones (D4). */
+static int
+bt_peri_map_a_reset_run(unsigned frames, uint16_t *bid_io, const char *what)
+{
+	struct bt_peri_stream_obs drain;
+	struct bt_peri_stream_obs post;
+	uint16_t bid = *bid_io;
