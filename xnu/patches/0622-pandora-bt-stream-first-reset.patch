+/* Level 20.69 (v2066, 0622a): D3 reset with a wake verdict.
+ *
+ * 0620 (and 0621) returned 0 once the 6-byte frame was on the wire, so the
+ * arm could not tell "TX accepted" from "ROM heard it"; bt2064's wake loop
+ * burned 32 stream bytes in 2 ms, printed no answer, and still returned 0.
+ * This sends reset and fd together (the trace's order), then spends one
+ * 300 ms window: a 34 00 ff event or fc/fe/ff is "answered", every other byte
+ * is stream and is charged to a 4 KiB budget instead of EPROTO. The out
+ * parameter is the wake state, the return value is the TX result only. */
+static int
+bt_peri_reset_ex(unsigned *wake_out)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf1, 0xff, 0x01, 0x03 };
+	static const uint8_t wake = 0xfd;
+	static const uint8_t ack = 0xfc;
+	uint8_t rx[8];
+	unsigned dropped = 0;
+	unsigned heard = 0;
+	uint64_t start;
+	uint64_t deadline;
+	int err;
+
+	*wake_out = 0u;
+	err = bt_uart_tx(request, sizeof(request), "PERI reset request");
+	if (err) {
+		return err;
+	}
+	start = bt_peri_uptime_ms();
+	err = bt_uart_tx(&wake, 1u, "PERI wake FD");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(300, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline &&
+	    dropped < BT_PERI_WAKE_DISCARD_MAX) {
+		uint32_t st = bt_rd(BT_W_SE, SE_RX_FIFO_ST);
+		unsigned words = st & 0x1ffffffu;
+		uint8_t b;
+
+		if (!words) {
+			bt_sleep(50);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (b == 0xfdu) {
+			(void)bt_uart_tx(&ack, 1u, "PERI reset wake ACK FC");
+			continue;
+		}
+		if (b == 0x34u) {
+			unsigned n = 1u;
+			unsigned plen;
+			unsigned k = 0u;
+
+			rx[0] = b;
+			while (n < 4u && mach_absolute_time() < deadline) {
+				if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+					bt_sleep(50);
+					continue;
+				}
+				rx[n++] = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+			}
+			if (n < 4u || rx[1] != 0x00u || rx[2] != 0xffu) {
+				dropped += n;
+				continue;
+			}
+			plen = rx[3];
+			while (k < plen && mach_absolute_time() < deadline) {
+				if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+					bt_sleep(50);
+					continue;
+				}
+				(void)bt_rd(BT_W_SE, SE_RX_FIFO);
+				k++;
+			}
+			heard = 0x34u;
+			break;
+		}
+		if (b == 0xfcu || b == 0xfeu || b == 0xffu) {
+			heard = b;
+			break;
+		}
+		dropped++;
+	}
+	if (heard != 0u) {
+		printf("PANDORA BT: PERI reset: wake answered in %u ms "
+		    "(%u stream byte(s) discarded)%s\n",
+		    (unsigned)(bt_peri_uptime_ms() - start), dropped,
+		    heard == 0x34u ? " by a 34 00 ff event" : "");
+	} else {
+		printf("PANDORA BT: PERI reset: wake unanswered in %u ms "
+		    "(%u stream byte(s) discarded, budget %u)\n",
+		    (unsigned)(bt_peri_uptime_ms() - start), dropped,
+		    BT_PERI_WAKE_DISCARD_MAX);
+	}
+	pandora_log_sync();
+	*wake_out = heard;
+	return 0;
+}
