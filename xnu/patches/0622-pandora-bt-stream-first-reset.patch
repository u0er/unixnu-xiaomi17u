+/* Level 20.69 (v2066, 0622a): the arm's tolerant subcommand wait.
+ *
+ * Same 34 00 ff <plen> framing as bt_peri_wait_sub, but a non-event byte is
+ * charged to the stream instead of aborting with EPROTO: that abort is what
+ * ended bt2064 at 0.0 ms twice. FD is still answered with FC, FC/FE/FF are
+ * still ignorable padding, and the caller only ever sees ETIMEDOUT at the
+ * deadline. Used exclusively by *_stream mode functions called from the
+ * reset arm; the download phases keep the strict reader above. */
+static int
+bt_peri_wait_sub_stream(uint8_t *rx, unsigned cap, unsigned *got,
+    uint64_t deadline, uint8_t want_sub, const char *what, unsigned *dropped)
+{
+	static const uint8_t ack = 0xfc;
+	unsigned discards = 0;
+	int err = ETIMEDOUT;
+
+	*got = 0;
+	while (mach_absolute_time() < deadline) {
+		uint32_t st = bt_rd(BT_W_SE, SE_RX_FIFO_ST);
+		unsigned words = st & 0x1ffffffu;
+		uint8_t b;
+
+		if (!words) {
+			bt_sleep(50);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (b != 0x34u) {
+			if (b == 0xfdu) {
+				(void)bt_uart_tx(&ack, 1u, "PERI arm wait ACK FC");
+				continue;
+			}
+			if (b == 0xfcu || b == 0xfeu || b == 0xffu) {
+				continue;
+			}
+			discards++;
+			continue;
+		}
+		/* One whole 34 00 ff <plen> record; it is an ACK only if the subcmd
+		 * byte lands at offset 10 with the expected value. */
+		rx[0] = b;
+		for (unsigned i = 1u; i < 4u; i++) {
+			while (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+				if (mach_absolute_time() >= deadline) {
+					goto out;
+				}
+				bt_sleep(50);
+			}
+			rx[i] = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		}
+		if (rx[1] != 0x00u || rx[2] != 0xffu) {
+			discards += 4u;
+			continue;
+		}
+		{
+			unsigned plen = rx[3];
+			unsigned n = 4u;
+
+			while (n < 4u + plen) {
+				while (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+					if (mach_absolute_time() >= deadline) {
+						goto out;
+					}
+					bt_sleep(50);
+				}
+				if (n < cap) {
+					rx[n] = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+				} else {
+					(void)bt_rd(BT_W_SE, SE_RX_FIFO);
+				}
+				n++;
+			}
+			*got = n;
+			if (n >= 11u && rx[10] == want_sub) {
+				err = 0;
+				break;
+			}
+			discards += n;
+		}
+	}
+out:
+	if (discards != 0u) {
+		printf("PANDORA BT: %s: discarded %u stream byte(s) while waiting for subcmd %u\n",
+		    what, discards, want_sub);
+		pandora_log_sync();
+	}
+	*dropped = discards;
+	return err;
+}
