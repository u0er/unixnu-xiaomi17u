+/*
+ * P0-b: report each distinct (mount, fileID) fork invariant violation once.
+ * A poisoned volume can hit the getattr sanity check hundreds of times per
+ * boot, for many different files; a single latch hid every file after the
+ * first hit.  The ring is deliberately lock-free: a lost update only costs
+ * one duplicate report, and the volume is already marked inconsistent by
+ * then.  The mount pointer keeps a remount from suppressing reports.
+ */
+#define HFS_FORK_INVARIANT_HISTORY 16U
+
+struct hfs_fork_invariant_report {
+	struct hfsmount *hfsmp;
+	uint32_t fileid;
+};
+
+static struct hfs_fork_invariant_report
+    hfs_fork_invariant_reports[HFS_FORK_INVARIANT_HISTORY];
+static unsigned int hfs_fork_invariant_report_next;
+
+static boolean_t
+hfs_fork_invariant_reported(struct hfsmount *hfsmp, uint32_t fileid)
+{
+	unsigned int i;
+
+	for (i = 0; i < HFS_FORK_INVARIANT_HISTORY; i++) {
+		if (hfs_fork_invariant_reports[i].hfsmp == hfsmp &&
+		    hfs_fork_invariant_reports[i].fileid == fileid)
+			return TRUE;
+	}
+
+	i = hfs_fork_invariant_report_next;
+	hfs_fork_invariant_report_next = (i + 1) % HFS_FORK_INVARIANT_HISTORY;
+	hfs_fork_invariant_reports[i].hfsmp = hfsmp;
+	hfs_fork_invariant_reports[i].fileid = fileid;
+	return FALSE;
+}
+
+/* Forks without a usable cnode/vnode: report once, never mark the volume. */
+static boolean_t hfs_fork_invariant_unidentified_reported = FALSE;
