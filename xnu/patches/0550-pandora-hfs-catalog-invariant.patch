+		if (hfsmp && !hfs_fork_invariant_reported) {
+			hfs_fork_invariant_reported = TRUE;
+			printf("hfs: fork invariant violated for fileID %llu: "
+				   "size %lld, %u block(s) allocated, 0 loaned; "
+				   "refusing catalog update\n",
+				   (unsigned long long)FTOC(ff)->c_fileid,
+				   (long long)ff->ff_size, ff->ff_blocks);
