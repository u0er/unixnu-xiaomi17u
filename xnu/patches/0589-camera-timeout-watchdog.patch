+	/* Idle until the soft watchdog has fired: a healthy camera path must not
+	 * be reset by a hard deadline armed from boot. */
+	while (!pc_wd_fired) {
+		if (pc_camera_done && !pc_camera_timed_out)
+			goto out;
+		pc_wd_sleep(250);
+	}
+	while (mach_absolute_time() < pc_wd_grace_abs) {
+		pc_wd_sleep(250);
+	}
+	pandora_camera_hard_reset("camera watchdog");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
