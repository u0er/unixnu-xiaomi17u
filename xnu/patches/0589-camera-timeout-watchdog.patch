diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b875684..69fb54c 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -2017,6 +2017,27 @@ extern void sweet_bl_final(void);       /* SweetFramebuffer.cpp, 0263 */
 extern void pandora_mpss_quiesce(void); /* bsd/dev/pandora_mpss.c */
 #endif
 
+/*
+ * 0482: camera watchdog hard reset.  Called from a kernel thread only when the
+ * orderly reboot did not take the machine down inside pandora_camera_grace.
+ * The camera probe may have wedged while holding sweet_ufs_lock, inside a
+ * blocked log write, or on an unclocked MMIO read, so this path takes no lock,
+ * writes no log, quiesces no modem and touches no MMIO: PSCI SYSTEM_RESET
+ * only.  It cannot corrupt a volume that was already synced; it also cannot
+ * flush one, which is why the soft watchdog (reboot_kernel) remains the normal
+ * exit and this is only the last-resort bound.
+ */
+void
+pandora_camera_hard_reset(const char *why)
+{
+	(void)why;
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;	/* PSCI SYSTEM_RESET */
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
