--- a/bsd/sweet_hfs/core/hfs_vfsutils.c
+++ b/bsd/sweet_hfs/core/hfs_vfsutils.c
@@ -2489,6 +2489,18 @@
 	devvp = hfsmp->hfs_devvp;
 	dev_name = vnode_getname_printable(devvp);

+	/* If journalInfoBlock is 0, there is no journal info block on disk.
+	 * Trying to read block 0 as a JournalInfoBlock would misinterpret the
+	 * HFS+ boot blocks (first 1024 bytes of block 0) and lead to garbage
+	 * jib_flags / bogus journal offsets.  Mount without journal instead. */
+	if (SWAP_BE32(vhp->journalInfoBlock) == 0) {
+		printf("hfs: journalInfoBlock=0, mounting without journal\n");
+		hfsmp->jvp = NULL;
+		hfsmp->jnl_start = 0;
+		hfsmp->jnl_size = 0;
+		retval = 0;
+		goto cleanup_dev_name;
+	}
+
 	if (args != NULL && (args->flags & HFSFSMNT_EXTENDED_ARGS)) {
 		arg_flags  = args->journal_flags;
 		arg_tbufsz = args->journal_tbuffer_size;
