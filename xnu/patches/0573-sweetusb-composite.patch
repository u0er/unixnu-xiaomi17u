+/*
+ * Interface numbers of the NCM function.  The plain UD_NCM/UD_ECM sets put the
+ * control interface at 0 and the data interface at 1; the composite set puts
+ * them at 1 and 2 because interface 0 is the mux there.  The notification
+ * wIndex and the SET_INTERFACE/GET_INTERFACE target are derived from these, so
+ * there is one place to get them wrong instead of three.
+ */
+static unsigned
+ud_ncm_ctrl_ifnum(void)
+{
+	return ud.personality == UD_CARPLAY ? 1 : 0;
+}
+
+static unsigned
+ud_ncm_data_ifnum(void)
+{
+	return ud_ncm_ctrl_ifnum() + 1;
+}
