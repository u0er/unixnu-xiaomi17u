+/*
+ * Personality predicates.  UD_CARPLAY runs both functions, so every place that
+ * used to ask "is this the Apple personality" / "is this the NCM personality"
+ * asks whether that function exists instead.  For UD_ECM / UD_APPLE / UD_NCM the
+ * answer is identical to the old test, which is what keeps sweetusb=0..4
+ * byte-for-byte unchanged.
+ */
+static inline bool
+ud_has_mux(void)
+{
+	return ud.personality == UD_APPLE || ud.personality == UD_CARPLAY;
+}
+
+static inline bool
+ud_has_ncm(void)
+{
+	return ud.personality == UD_NCM || ud.personality == UD_CARPLAY;
+}
