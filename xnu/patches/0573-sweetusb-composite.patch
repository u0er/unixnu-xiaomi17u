+	9, 4, 0, 0, 2, 0xff, 0xfe, 0x02, 0,          /* if0: Apple mux / iAP2, 2 endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,             /* EP 0x81 bulk IN 512 */
