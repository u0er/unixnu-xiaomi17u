+	18, 1, 0x00, 0x02, 0x00, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_ncm_cfg_desc[86] = {
+	9, 2, 86, 0, 2, 1, 0, 0x80, 125,               /* config: 2 interfaces, 250 mA (bMaxPower is in 2 mA units) */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* if0 alt0: comm, NCM subclass 0Dh, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* CDC header, bcdCDC 0x0110 */
+	5, 0x24, 0x06, 0, 1,                            /* union: master 0, slave 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: iMAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM: bcdNcmVersion 0x0100, caps 0x00 */
+	7, 5, 0x82, 0x03, 64, 0, 1,                     /* ep 0x82 interrupt IN, 64 bytes, 1 uframe */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data alt 0: CDC data, proto 01h, no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data alt 1: same, two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
