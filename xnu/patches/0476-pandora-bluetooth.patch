+/* GetBoardIdReq between the ram patch and the NVM, as DownloadTlvFile
+ * orders it (six-byte 31 00 f0 ff 01 0a frame, level16-proven at 115200;
+ * re-asked here at 4 Mbps for fresh evidence). Board id 0x0000 selects
+ * the default NVM variant - the one embedded. The response scan discards
+ * stale sub-06 ACKs left over from the ram patch phase; a timeout or a
+ * malformed reply is evidence, not a stop (the HAL continues with the
+ * default NVM variant, and the Android trace shows the NVM proceeding
+ * while the board-id response is absent from the captured events). */
+static int
+bt_peri_board_id_download(uint16_t *bid)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x01, 0x0a };
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI board id request (download)");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x0a, "PERI board id");
+	if (err) {
+		/* The HAL treats a missing board-id as evidence, not a stop:
+		 * DownloadTlvFile only logs "failed to get PERI board id" and
+		 * goes on to load the NVM; board id 0000 (the level16-proven
+		 * reply on this board) selects the default variant, which is
+		 * exactly the embedded one. Keep bid unknown and continue. */
+		printf("PANDORA BT: board id (download): no response (error %d); HAL continues with the default NVM variant\n",
+		    err);
+		bt_dump("PERI board id raw", rx, got);
+		pandora_log_sync();
+		*bid = 0xffffu;
+		return 0;
+	}
+	if (got < 14u || memcmp(rx + 4, identity, sizeof(identity)) ||
+	    rx[9] != 0 || rx[10] != 0x0a || rx[11] != 2) {
+		printf("PANDORA BT: board id (download) rejected: status %u subcmd %u idlen %u, %u bytes; continuing with the default NVM variant\n",
+		    got >= 10u ? rx[9] : 0xffu, got >= 11u ? rx[10] : 0xffu,
+		    got >= 12u ? rx[11] : 0xffu, got);
+		bt_dump("PERI board id ACK", rx, got);
+		pandora_log_sync();
+		*bid = 0xffffu;
+		return 0;
+	}
+	*bid = (uint16_t)((rx[12] << 8) | rx[13]);
+	printf("PANDORA BT: board id %04x (%s)\n", *bid,
+	    *bid ? "non-default NVM variant would apply" : "default .bin variant; embedded NVM matches");
+	return 0;
+}
