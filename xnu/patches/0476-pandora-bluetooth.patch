+/* GetBuildInfoReq: Android's own post-download gate (failure = init
+ * reason 63). Level 19.6 sends the REAL request the HAL sends
+ * (PatchDLManager::GetBuildInfoReq, disasm dd8a8): the HCI vendor
+ * command 01 00 fc 01 20 - opcode 0xFC00, param len 1, param 0x20 - via
+ * HciSendVsCmd(.., 5); the trace carries the sibling sub-ops verbatim
+ * (01 00 fc 01 19 at t=10.199, the 0xFC00 large-data frames
+ * 01 00 fc f5 ...). The reply is the 115-byte EDL VSE event
+ * 34 00 ff 6f f0 01 01 f0 ff 00 09 00 <len> <ASCII...>: status at [9]
+ * (0), subcmd 9 at [10], evt[12] = the ASCII string length, evt[13..]
+ * the text ("BTFW.GAN...", 102 chars in the trace). The buffer is
+ * sized for the HAL's 260-byte event read and the length bound is
+ * evt[12] <= got - 13. The status byte at offset 9 is logged but not
+ * enforced, matching the HAL, which only requires the event read to
+ * succeed. The scan also absorbs a spontaneously pushed sub-09 event
+ * (the ROM's reply can land right after the NVM last-segment ACK. */
+static int
+bt_peri_build_info(void)
+{
+	/* Level 19.6: the REAL request. The 2026-11-18 00:11 device run sent
+	 * the fabricated EDL frame 31 00 f0 ff 02 09 00 and the ROM answered
+	 * with a diagnostic dump stream instead (f0 05 timestamped, f0 04
+	 * sequenced) - that frame never existed in the protocol. The HAL
+	 * (PatchDLManager::GetBuildInfoReq, disasm dd8a8) builds the HCI
+	 * vendor command 01 00 fc 01 20 (opcode 0xFC00, param len 1, param
+	 * 0x20) and sends it via HciSendVsCmd(.., 5); the trace shows the
+	 * sibling sub-op 01 00 fc 01 19 (t=10.199) and the 0xFC00 large-data
+	 * frames (01 00 fc f5 ...) verbatim. */
+	static const uint8_t request[] = { 0x01, 0x00, 0xfc, 0x01, 0x20 };
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	/* Level 19.7 - wait FIRST. The 19.6 run proved the ROM parses the
+	 * VSC (generic sub-06 ACK status 0 at +10 ms) but attaches no build
+	 * info; Android's own reply lands +0.6 ms after the NVM ACK with a
+	 * lost TX burst in between. If the event is a spontaneous
+	 * download-complete push, both our request TXs (sent +1 ms after the
+	 * ACK) suppressed it. So first observe with NO transmit at all: any
+	 * sub-9 event inside the observe window is the push. Any other
+	 * result of the window (timeout, junk events, overflow) falls
+	 * through to the request attempt. */
+	printf("PANDORA BT: build info observe window (150 ms, no TX)\n");
+	pandora_log_sync();
+	clock_interval_to_deadline(150, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x09,
+	    "PERI build info (observe)");
+	if (err == 0) {
+		printf("PANDORA BT: build info spontaneous event captured\n");
+		goto parse;
+	}
+	printf("PANDORA BT: observe window ended (error %d, %u bytes); sending the VS command\n",
+	    err, got);
+	pandora_log_sync();
+	err = bt_uart_tx(request, sizeof(request), "PERI build info VS command");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	/* Level 19.8 - after the download the ROM speaks HCI: the 19.7 run
+	 * PROVED it (VSC at +153 ms drew a reply starting with 0x04 - an HCI
+	 * event packet, msi the 04 0e-family Command Complete events Android
+	 * reads at 11.7 s). The old EDL-only reader aborted EPROTO on the
+	 * first 0x04. This reader accepts BOTH framings: 0x34 opens the EDL
+	 * VSE event (sub-09 = the build-info push Android captured at
+	 * t=9.927686), 0x04 opens an HCI event (read code+len, then the
+	 * payload; the build string is printable ASCII inside, detected by
+	 * the B,TFW,. signature). Padding bytes (ff/fd/fc/fe) are logged and
+	 * skipped; any other leader byte is logged and skipped too (bounded)
+	 * - evidence first, verdict second. */
+	for (unsigned leaders = 0; leaders < 16; leaders++) {
+		uint8_t lead = 0;
+		unsigned field = 0;
+
+		err = bt_rx_exact(&lead, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (lead == 0x34) {
+			got = 1;
+			rx[0] = lead;
+			err = bt_rx_exact(rx + 1, 3, &field, deadline);
+			got += field;
+			if (err || got < 4u) {
+				break;
+			}
+			if ((unsigned)rx[3] > sizeof(rx) - 4u) {
+				printf("PANDORA BT: build info: oversized EDL event (plen %u), draining\n",
+				    rx[3]);
+				uint8_t sink[32];
+				unsigned dropped = 0;
+				while (dropped < (unsigned)rx[3] &&
+				    dropped < 255u) {
+					unsigned take = (unsigned)rx[3] - dropped > sizeof(sink)
+					    ? sizeof(sink) : (unsigned)rx[3] - dropped;
+					err = bt_rx_exact(sink, take, &field, deadline);
+					if (err) {
+						break;
+					}
+					dropped += field;
+				}
+				continue;
+			}
+			err = bt_rx_exact(rx + 4, rx[3], &field, deadline);
+			got += field;
+			if (err) {
+				break;
+			}
+			if (got >= 11u && rx[10] == 0x09) {
+				goto parse;
+			}
+			printf("PANDORA BT: build info: EDL event subcmd %u (%u bytes), keep scanning\n",
+			    rx[10], got);
+			bt_dump("PERI build info EDL event", rx, got);
+			pandora_log_sync();
+			continue;
+		}
+		if (lead == 0x04) {
+			uint8_t hdr[2];
+			unsigned evlen;
+
+			err = bt_rx_exact(hdr, 2, &field, deadline);
+			if (err) {
+				break;
+			}
+			evlen = hdr[1];
+			printf("PANDORA BT: build info: HCI event 04 %02x len %u\n",
+			    hdr[0], evlen);
+			if (evlen > sizeof(rx)) {
+				uint8_t sink[32];
+				unsigned dropped = 0;
+				while (dropped < evlen) {
+					unsigned take = evlen - dropped > sizeof(sink)
+					    ? sizeof(sink) : evlen - dropped;
+					err = bt_rx_exact(sink, take, &field, deadline);
+					if (err) {
+						break;
+					}
+					dropped += field;
+				}
+				continue;
+			}
+			err = bt_rx_exact(rx, evlen, &field, deadline);
+			got = field;
+			if (err) {
+				break;
+			}
+			bt_dump("PERI build info HCI event", rx, got);
+			/* Extract printable runs; the build string carries the
+			 * B,TFW,. signature ("BTFW.GAN..." in every observed
+			 * form, EDL push and HCI complete alike). */
+			for (unsigned i = 0; i + 4u < got; i++) {
+				if (rx[i] == 'B' && rx[i + 1u] == 'T' &&
+				    rx[i + 2u] == 'F' && rx[i + 3u] == 'W' &&
+				    rx[i + 4u] == '.') {
+					unsigned end = i;
+					while (end < got &&
+					    ((rx[end] >= 0x20 && rx[end] < 0x7f) || rx[end] == '\n')) {
+						end++;
+					}
+						printf("PANDORA BT: build info (HCI) status %u, %u chars: ",
+						    got >= 4u ? rx[3] : 0xffu, end - i);
+					for (unsigned k = i; k < end && k - i < 120u; k++) {
+						printf("%c", rx[k]);
+					}
+					printf("\n");
+					pandora_log_sync();
+					return 0;
+				}
+			}
+			printf("PANDORA BT: build info: HCI event carries no BTFW signature, keep scanning\n");
+			pandora_log_sync();
+			continue;
+		}
+		printf("PANDORA BT: build info: leader byte %#x, keep scanning\n", lead);
+		pandora_log_sync();
+	}
+	if (err == 0) {
+		err = ETIMEDOUT;
+	}
+	got = 0;
+	if (err) {
+		printf("PANDORA BT: build info: no response (error %d) - HAL init failure reason 63\n",
+		    err);
+		bt_dump("PERI build info raw", rx, got);
+		pandora_log_sync();
+		return err;
+	}
+parse:
+	if (got < 14u || rx[12] > got - 13u || rx[12] > sizeof(rx) - 14u ||
+	    memcmp(rx + 4, identity, sizeof(identity)) || rx[10] != 0x09) {
+		printf("PANDORA BT: build info event rejected: status %u subcmd %u len %u, %u bytes\n",
+		    got >= 10u ? rx[9] : 0xffu, got >= 11u ? rx[10] : 0xffu,
+		    got >= 13u ? rx[12] : 0xffu, got);
+		bt_dump("PERI build info ACK", rx, got);
+		pandora_log_sync();
+		return EPROTO;
+	}
+	printf("PANDORA BT: build info event status %u, %u chars: ", rx[9], rx[12]);
+	for (unsigned i = 0; i < rx[12]; i++) {
+		printf("%c", rx[13 + i]);
+	}
+	printf("\n");
+	return 0;
+}
+
+/* Level 20: PeriReset and the TME-L patch-map phase, all frames verbatim
+ * from the captured Android trace (t=9.929180..10.199460).
+ *
+ * The post-download protocol map the trace pins down:
+ *   9.929180  TX 6   31 00 f1 ff 01 03        PeriReset (f1 family)
+ *   9.930053  TX 1   fd                        wake request
+ *   (ROM re-enters the download window: 9.930447 TX 8  31 00 f0 ff 03 08 03 00
+ *    - arbitrate variant subcmd 03 08 03 - and 9.930829 TX 7 31 00 f0 ff 02 05 03
+ *    - version re-check subcmd 02 05 03 - before the TME-L segments)
+ *   9.949244.. TX 251 31 00 f0 ff f6 06 03 <243B>  TME-L map segments
+ *            (sub-op 06 03 = TME-L; the file is tmel_peach_20.elf, 68,952 B
+ *             = 284 segments with a 183-byte tail. The map table carries two
+ *             builds and the platform key BRAHMA_VER_2_0 - this Nezha is
+ *             Ganges 2.0 - selects the 20 file. Level 20.2 proved the file is
+ *             NOT the discriminator: the 1.1 file (63,096 B / 260 segments)
+ *             and the 2.0 file get the SAME 63-byte status-2 event, byte for
+ *             byte, so it is the request cadence/arguments that the ROM
+ *             rejects, not the payload. Level 20.3 therefore streams the map
+ *             at full speed like Android does.)
+ *   10.199460 TX 5 01 00 fc 01 19               license prerequisite VSC
+ *   10.202237.. TX 249 01 00 fc f5 1e <243B>   license VSC segments (sub-op 1e)
+ * Each license segment is answered by a 04 0e 05 Command Complete
+ * (status 00 sub-op 1e); the last gets 04 0e 08 .. 23 (license complete).
+ *
+ * This device has no cnss_softsku_peach.pfm on /vendor/bt_firmware/image/
+ * (checked 2026-11-18), so like the HAL on this unit we SKIP the license
+ * phase and record the fact; TME-L is the level-20 gate. */
+/* Level 20.17: PERI GetVer with the EDL flag (31 00 f0 ff 02 05 00) at
+ * trace 9.766328, before ActivateSS (9.773776). 20.15/20.16 sent ActivateSS
+ * but never the GetVer that precedes it in the Android sequence; this is
+ * the remaining PERI-session frame. Observation only. */
+static int
+bt_peri_getver_window(unsigned window_ms)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x02, 0x05, 0x00 };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI GetVer(00)");
+	if (err) {
+		return err;
+	}
+	/* Level 20.61 (v2055-A): the window is a parameter so the withheld-B
+	 * liveness probe can ask the same question with 400 ms; the level-19
+	 * caller below keeps the 700 ms it has always used. */
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x05,
+	    "PERI GetVer(00)");
+	if (err) {
+		printf("PANDORA BT: GetVer(00): no reply (error %d, %u bytes); continuing\n",
+		    err, got);
+		bt_dump("PERI GetVer(00) raw", rx, got);
+		pandora_log_sync();
+		return err;
+	}
+	printf("PANDORA BT: GetVer(00) reply: status %u subcmd %u ssid %u, %u bytes\n",
+	    got >= 10u ? rx[9] : 0xffu, got >= 11u ? rx[10] : 0xffu,
+	    got >= 12u ? rx[11] : 0xffu, got);
+	bt_dump("PERI GetVer(00) reply", rx, got);
+	pandora_log_sync();
+	return 0;
+}
+
+/* The level-19 chain keeps its 700 ms window and its continue-on-silence
+ * behaviour; only the probe that needs the answer state takes the error. */
+static int
+bt_peri_getver_peri(void)
+{
+	(void)bt_peri_getver_window(700u);
+	return 0;
+}
+
+/* Level 20.15: the Android trace sends the f1-family ActivateSS frame
+ * 31 00 f1 ff 02 02 0f at 9.773776, between Peri GetVer (9.766328) and
+ * arbitrate (9.801908). Every 20.x build so far started at PeriReset and
+ * never activated the PERI/TME-L subsystem, so the map was accepted on the
+ * wire but never treated as a completed patch. This is the one f1 frame the
+ * trace contains that the driver does not. Observation only: a missing
+ * answer is logged and the level continues. */
+static int
+bt_peri_activate_ss(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf1, 0xff, 0x02, 0x02, 0x0f };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI ActivateSS");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x02,
+	    "PERI ActivateSS");
+	if (err) {
+		printf("PANDORA BT: ActivateSS: no reply (error %d, %u bytes); continuing\n",
+		    err, got);
+		bt_dump("PERI ActivateSS raw", rx, got);
+		pandora_log_sync();
+		return 0;
+	}
+	printf("PANDORA BT: ActivateSS reply (subcmd %u, %u bytes)\n",
+	    got >= 11u ? rx[10] : 0xffu, got);
+	bt_dump("PERI ActivateSS reply", rx, got);
+	pandora_log_sync();
+	return 0;
+}
+
+static int
+bt_peri_reset(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf1, 0xff, 0x01, 0x03 };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI reset request");
+	if (err) {
+		return err;
+	}
+	/* The trace shows no ACK for PeriReset itself before the fd wake;
+	 * the reply the ROM emits for the f1 family (34 00 ff 07 f0 01 01
+	 * f1 ff 01 02) belongs to the earlier ActivateSS at 9.773776. Wait
+	 * bounded for ANY event; the next phases re-synchronize anyway. */
+	clock_interval_to_deadline(300, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0xff, "PERI reset");
+	if (err) {
+		printf("PANDORA BT: PERI reset: no event (error %d, %u bytes) - continuing to the wake sequence\n",
+		    err, got);
+		pandora_log_sync();
+	} else {
+		printf("PANDORA BT: PERI reset event (subcmd %u, %u bytes)\n",
+		    got >= 11u ? rx[10] : 0xffu, got);
+		bt_dump("PERI reset raw", rx, got);
+		pandora_log_sync();
+	}
+	/* fd wake, verbatim t=9.930053. The ROM answers with fc. */
+	{
+		const uint8_t wake = 0xfd;
+
+		err = bt_uart_tx(&wake, 1, "PERI wake FD");
+		if (err) {
+			return err;
+		}
+	}
+	clock_interval_to_deadline(300, NSEC_PER_MSEC, &deadline);
+	for (unsigned controls = 0; controls < 32; controls++) {
+		unsigned field = 0;
+		uint8_t lead = 0;
+
+		err = bt_rx_exact(&lead, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (lead == 0xfc || lead == 0xfe || lead == 0xff) {
+			printf("PANDORA BT: PERI wake answer %#x\n", lead);
+			break;
+		}
+		if (lead == 0x34) {
+			/* an event arrived instead: consume nothing further,
+			 * log it, and continue (the wake exchange tolerates it) */
+			int e2;
+
+			got = 1;
+			rx[0] = lead;
+			e2 = bt_rx_exact(rx + 1, 3, &field, deadline);
+			if (!e2 && (unsigned)rx[3] <= sizeof(rx) - 4u) {
+				(void)bt_rx_exact(rx + 4, rx[3], &field, deadline);
+				got += field;
+				bt_dump("PERI wake event", rx, got);
+			}
+			pandora_log_sync();
+			break;
+		}
+		printf("PANDORA BT: PERI wake stray byte %#x\n", lead);
+	}
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 20.13: state[4] names, from ConfigureTMESoC @0x12c494 and
+ * TmelSocInit @0x12bc54. GetVsHciEvent @0x12d4bc writes rsp[9] into
+ * this byte; the TME-L Patch Ntf path (ReadVsAsyncEvent) also sets 23
+ * on success. */
+static const char *
+bt_peri_tme_state_name(unsigned state)
+{
+	switch (state) {
+	case 0: return "unpatched/not done";
+	case 5:
+	case 6: return "TME-L unsupported or not patched by other SS";
+	case 11: return "patching in progress by other SS";
+	case 23: return "patched (Patch Ntf success)";
+	default: return "unknown state";
+	}
+}
+
+/* Arbitrate variant + version re-check the trace shows AFTER the reset,
+ * verbatim: 31 00 f0 ff 03 08 03 00 (subcmd 8, the v3 flag byte 03 at
+ * offset 7) and 31 00 f0 ff 02 05 03 (version family, flag 03). */
+static int
+bt_peri_arbitrate_v3(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x03, 0x08, 0x03, 0x00 };
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI arbitrate v3 request");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x08,
+	    "PERI arbitrate v3");
+	if (err) {
+		printf("PANDORA BT: arbitrate v3: no ACK (error %d)\n", err);
+		bt_dump("PERI arbitrate v3 raw", rx, got);
+		pandora_log_sync();
+		return err;
+	}
+	if (got < 11u || memcmp(rx + 4, identity, sizeof(identity)) ||
+	    rx[9] != 0 || rx[10] != 0x08) {
+		printf("PANDORA BT: arbitrate v3 rejected: %u bytes\n", got);
+		bt_dump("PERI arbitrate v3 ACK", rx, got);
+		pandora_log_sync();
+		return EPROTO;
+	}
+	/* Level 20.13: rx[9] is not just the ACK status - the HAL's
+	 * GetVsHciEvent stores this same byte as state[4]
+	 * (str w8, [x0, #4]; w8 = rsp[9]) and ConfigureTMESoC then branches
+	 * on it: 0 = unpatched/not done, 23 = patched, 11 = another SS is
+	 * patching, 5..6 = TME-L unsupported/not patched. Print the raw
+	 * value and its meaning so the post-Stage-B re-query is decidable. */
+	printf("PANDORA BT: arbitrate v3 ACK status %u (%s) subcmd 8 (%u bytes), TME state %u (%s)\n",
+	    rx[9], bt_peri_tme_state_name(rx[9]), got, rx[9],
+	    bt_peri_tme_state_name(rx[9]));
+	pandora_log_sync();
+	return 0;
+}
+
+/* Version re-check after the reset, verbatim t=9.930829:
+ * 31 00 f0 ff 02 05 03. The 2026-11-18 12:0x level-20 run skipped this
+ * frame and the ROM rejected the TME-L segments with status 2
+ * (invalid patch version argument) - this gate is what it demanded. The
+ * reply is the version family (subcmd 5 at offset 10, like the
+ * 115200-phase version exchange). */
+static int
+bt_peri_version_v3(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x02, 0x05, 0x03 };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI version v3 request");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x05,
+	    "PERI version v3");
+	if (err) {
+		printf("PANDORA BT: version v3: no reply (error %d, %u bytes)\n", err, got);
+		bt_dump("PERI version v3 raw", rx, got);
+		pandora_log_sync();
+		return err;
+	}
+	/* Level 20.13: TMEPatchVerReq @0x12c0f4 only accepts a reply whose
+	 * rsp[9] == 0 and rsp[11] == 3; print both plus the full frame so the
+	 * post-Stage-B re-query can be compared against this pre-map one. */
+	printf("PANDORA BT: version v3 reply: status %u subcmd %u ssid %u, %u bytes%s\n",
+	    got >= 10u ? rx[9] : 0xffu, got >= 11u ? rx[10] : 0xffu,
+	    got >= 12u ? rx[11] : 0xffu, got,
+	    (got >= 12u && rx[9] == 0u && rx[11] == 3u)
+	    ? " (TMEPatchVerReq gate PASS)" : " (TMEPatchVerReq gate not met)");
+	bt_dump("PERI version v3 reply", rx, got);
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 20.13: one observation window that understands both framings the
+ * ROM uses around Stage B: 34 00 ff <plen> EDL events (what the HAL's
+ * PeriPatchDLManager reads) and 04 <evt> <plen> HCI events. The 34
+ * records whose body class is f0 04 / f0 05 are the ROM's resident
+ * notification stream (v213: 817 records, plen 252, ~144.7 ms apart);
+ * they are counted, never treated as ACKs. A 34 event carrying the EDL
+ * identity f0 01 01 f0 ff is decoded: status = rx[9], subcmd = rx[10],
+ * flag = rx[11]. Returns 0 when want_sub was seen, ETIMEDOUT otherwise. */
+/* Level 20.21: the post-map verdict probes are live again - bt_peri_level20
+ * calls bt_peri_tme_state_probe and bt_peri_tme_verdict_watch after closing
+ * the map with 0x20, exactly where TmelSocInit sends them in the HAL. */
+static int
+bt_peri_tme_probe_wait(uint8_t *rx, unsigned cap, unsigned *got, uint64_t deadline,
+    uint8_t want_sub, const char *what)
+{
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t sink[32];
+	unsigned packets = 0;
+	unsigned records = 0;
+	unsigned f004 = 0;
+	unsigned f005 = 0;
+	unsigned patch = 0;
+	unsigned hci = 0;
+	unsigned stray = 0;
+	unsigned named = 0;
+	int err = 0;
+
+	*got = 0;
+	while (packets < 320u && mach_absolute_time() < deadline) {
+		uint8_t lead = 0;
+		unsigned field = 0;
+
+		err = bt_rx_exact(&lead, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (lead == 0xfd) {
+			const uint8_t ack = 0xfc;
+
+			(void)bt_uart_tx(&ack, 1, "TME probe wake ACK FC");
+			continue;
+		}
+		if (lead == 0xfc || lead == 0xfe || lead == 0xff) {
+			continue;
+		}
+		packets++;
+		if (lead == 0x34u) {
+			uint8_t fh[3];
+			unsigned plen;
+
+			err = bt_rx_exact(fh, 3, &field, deadline);
+			if (err) {
+				break;
+			}
+			plen = (unsigned)fh[2];
+			rx[0] = 0x34u;
+			rx[1] = fh[0];
+			rx[2] = fh[1];
+			rx[3] = fh[2];
+			if (plen > cap - 4u) {
+				unsigned dropped = 0;
+
+				while (dropped < plen) {
+					unsigned take = plen - dropped > sizeof(sink)
+					    ? (unsigned)sizeof(sink) : plen - dropped;
+
+					err = bt_rx_exact(sink, take, &field, deadline);
+					if (err) {
+						break;
+					}
+					dropped += field;
+				}
+				records++;
+				if (err) {
+					break;
+				}
+				continue;
+			}
+			err = bt_rx_exact(rx + 4, plen, &field, deadline);
+			if (err) {
+				break;
+			}
+			*got = 4u + plen;
+			if (*got >= 6u && rx[4] == 0xf0u && rx[5] == 0x04u) {
+				f004++;
+				continue;
+			}
+			if (*got >= 6u && rx[4] == 0xf0u && rx[5] == 0x05u) {
+				f005++;
+				continue;
+			}
+			if (*got >= 9u && memcmp(rx + 4, identity, sizeof(identity)) == 0) {
+				unsigned sub = *got >= 11u ? rx[10] : 0xffu;
+				unsigned status = *got >= 10u ? rx[9] : 0xffu;
+
+				if (sub == want_sub) {
+					return 0;
+				}
+				if (sub == 0x03u) {
+					patch++;
+					printf("PANDORA BT: %s: EDL patch event subcmd 3, status %u (%s), %u bytes\n",
+					    what, status, bt_peri_edl_status_name(status), *got);
+					bt_dump_wide("TME-L patch event", rx, *got);
+					pandora_log_sync();
+					continue;
+				}
+				if (named++ < 8u) {
+					printf("PANDORA BT: %s: EDL event subcmd %u status %u (%s), %u bytes\n",
+					    what, sub, status, bt_peri_edl_status_name(status), *got);
+					bt_dump("TME probe EDL event", rx, *got);
+					pandora_log_sync();
+				}
+				continue;
+			}
+			stray++;
+			if (named++ < 8u) {
+				printf("PANDORA BT: %s: unrecognized 34 record (%u bytes, plen %u)\n",
+				    what, *got, plen);
+				bt_dump("TME probe record", rx, *got);
+				pandora_log_sync();
+			}
+			continue;
+		}
+		if (lead == 0x04u) {
+			uint8_t eh[2];
+			unsigned plen;
+
+			err = bt_rx_exact(eh, 2, &field, deadline);
+			if (err) {
+				break;
+			}
+			plen = (unsigned)eh[1];
+			hci++;
+			if (plen > cap) {
+				unsigned dropped = 0;
+
+				while (dropped < plen) {
+					unsigned take = plen - dropped > sizeof(sink)
+					    ? (unsigned)sizeof(sink) : plen - dropped;
+
+					err = bt_rx_exact(sink, take, &field, deadline);
+					if (err) {
+						break;
+					}
+					dropped += field;
+				}
+				if (err) {
+					break;
+				}
+				continue;
+			}
+			err = bt_rx_exact(rx, plen, &field, deadline);
+			if (err) {
+				break;
+			}
+			*got = plen;
+			printf("PANDORA BT: %s: HCI event %02x len %u\n", what, eh[0], plen);
+			bt_dump_wide("TME probe HCI event", rx, plen);
+			if (eh[0] == 0x0eu && plen >= 3u) {
+				/* rx starts after the 4-byte 04 0e len ncmds
+				 * header, so with the trace's 04 0e 05 01 00 fc
+				 * 00 1e this is rx = 01 00 fc 00 1e: rx[0] is the
+				 * command count, rx[1..2] the little-endian
+				 * opcode, rx[3] the status and rx[4] the
+				 * subcommand echo. */
+				printf("PANDORA BT: %s: Command Complete status %u opcode %02x %02x ncmds %u trailing %02x %02x %02x %02x\n",
+				    what, plen > 3u ? rx[3] : 0xffu, rx[2], rx[1], rx[0],
+				    plen > 4u ? rx[4] : 0xffu, plen > 5u ? rx[5] : 0xffu,
+				    plen > 6u ? rx[6] : 0xffu,
+				    plen > 7u ? rx[7] : 0xffu);
+			}
+			pandora_log_sync();
+			continue;
+		}
+		stray++;
+		printf("PANDORA BT: %s: stray byte %#x\n", what, lead);
+	}
+	printf("PANDORA BT: %s: probe window ends after %u packet(s), f0 04 %u, f0 05 %u, patch evt %u, HCI %u, records %u, stray %u (error %d)\n",
+	    what, packets, f004, f005, patch, hci, records, stray, err);
+	pandora_log_sync();
+	return err ? err : ETIMEDOUT;
+}
+
+/* Level 20.13: re-issue TMEArbitrate after Stage B and print rsp[9], the
+ * byte the HAL's GetVsHciEvent stores as state[4]. The frame is the same
+ * 8-byte v3 arbitrate sent before the map; only the position is new. If
+ * the ROM accepted the download it should now answer 23 ("patched"),
+ * instead of the 0 it returned before the map. Observation only. */
+static void
+bt_peri_tme_state_probe(const char *what)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x03, 0x08, 0x03, 0x00 };
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	printf("PANDORA BT: %s: post-stage-B TME state query 31 00 f0 ff 03 08 03 00\n",
+	    what);
+	pandora_log_sync();
+	err = bt_uart_tx(request, sizeof(request), "TME state query");
+	if (err) {
+		printf("PANDORA BT: %s: state query TX failed (error %d)\n", what, err);
+		pandora_log_sync();
+		return;
+	}
+	clock_interval_to_deadline(1500, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_tme_probe_wait(rx, sizeof(rx), &got, deadline, 0x08, what);
+	if (err) {
+		printf("PANDORA BT: %s: no subcmd-8 answer (error %d, %u bytes)\n",
+		    what, err, got);
+		bt_dump("TME state query raw", rx, got);
+		pandora_log_sync();
+		return;
+	}
+	if (got < 11u || memcmp(rx + 4, identity, sizeof(identity)) != 0) {
+		printf("PANDORA BT: %s: subcmd-8 answer malformed (%u bytes)\n", what, got);
+		bt_dump("TME state query answer", rx, got);
+		pandora_log_sync();
+		return;
+	}
+	printf("PANDORA BT: %s: TME state %u (%s), subcmd %u, flag %u, %u bytes\n",
+	    what, rx[9], bt_peri_tme_state_name(rx[9]), rx[10],
+	    got >= 12u ? rx[11] : 0xffu, got);
+	bt_dump("TME state query answer", rx, got);
+	pandora_log_sync();
+}
+
+/* Level 20.13: read-only verdict window after the probes. No TX except the
+ * fd-answer rule. Every 34 event that is not the resident f0 04/f0 05
+ * stream is printed whole; a subcmd-3 EDL patch event is named as such. */
+static void
+bt_peri_tme_verdict_watch(unsigned window_ms, const char *what)
+{
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+
+	printf("PANDORA BT: %s: verdict watch %u ms, no request\n", what, window_ms);
+	pandora_log_sync();
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	(void)bt_peri_tme_probe_wait(rx, sizeof(rx), &got, deadline, 0xffu, what);
+}
+
+/* Level 20.14: preserve the raw byte stream that follows the peri map,
+ * before any frame parser can drop or misalign it. The 20.10-20.13 runs
+ * all reported 108-120 "dropped" bytes at the first record boundary and
+ * never kept them; 20.13's Stage-B log showed the same class of unframed
+ * bytes (e4 28 47 ...). This reads bytes only (fd is answered with fc),
+ * prints the first 1024, and never treats a record as an ACK. */
+static void
+bt_peri_raw_dump(unsigned window_ms, const char *what)
+{
+	uint8_t buf[1024];
+	unsigned n = 0;
+	uint64_t deadline;
+
+	printf("PANDORA BT: %s: raw window %u ms, no frame parsing\n", what, window_ms);
+	pandora_log_sync();
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (n < sizeof(buf) && mach_absolute_time() < deadline) {
+		uint8_t byte = 0;
+		unsigned field = 0;
+		int err;
+
+		err = bt_rx_exact(&byte, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (byte == 0xfd) {
+			const uint8_t ack = 0xfc;
+
+			(void)bt_uart_tx(&ack, 1, "raw wake ACK FC");
+		}
+		buf[n++] = byte;
+	}
+	printf("PANDORA BT: %s: raw %u byte(s)\n", what, n);
+	bt_dump_wide("PERI TME-L raw stream", buf, n);
+	pandora_log_sync();
+}
+
+/* TlvDnldSegment sub-op 06 03 (the TME-L map download) is reached via
+ * bt_peri_tlv_download_sub(.., 0x03).
+ *
+ * Level 20.3 single variable: pace 1500 us -> 0 us (stream at full speed,
+ * exactly as the RAM patch already does and as the Android HAL streams the
+ * map: the trace shows the whole 68,952 B map going out inside ~250 ms with
+ * zero per-segment read). Level 20.1 and 20.2 both returned the same 63-byte
+ * status-2 event on the last segment while Android's own run had no RX at all
+ * between its map start and its PatchVerReq - so the paced cadence itself is
+ * now the suspect, not the file. */
+
+/* Level 20.3: drain the UART RX FIFO once after the TME-L download.
+ * Observability only - it issues no request and changes no transmission
+ * cadence, so the single variable (pace) stays clean. What it records is
+ * whatever the ROM sends unsolicited once the map is down: the HAL waits for
+ * the TME-L patch notification (ConfigureTMESoC, "Patch Ntf success" /
+ * "Patch Ntf failed"), and an unread notification would otherwise sit in the
+ * FIFO and pollute the next phase. */
+/* Level 20.11: ask the ROM for the TME-L patch verdict the way the HAL does.
+ * Android's trace after the map runs 01 00 fc 01 19 (license prerequisite,
+ * answered 04 0e 05 01 00 fc 00 1e), the license segments, then
+ * 01 00 fc 01 23, answered 04 0e 08 01 00 fc 00 23 02 00 00 - the only place
+ * in the capture where the ROM reports a status word after the map. This unit
+ * has no cnss_softsku_peach.pfm, so the probe sends the 0x23 command alone and
+ * records whatever answers it. Observation only: one 5-byte TX, no cadence
+ * change, no retry. */
+/* Level 20.11/20.12: send one 0xfc00 vendor command the way the HAL's
+ * HciSendVsCmd does and record the answer window. The reference trace uses
+ * this exact shape for four different sub-ops - 0x19 (start patch download,
+ * answered 04 0e 05 01 00 fc 00 1e), the 245-byte data packets, 0x23
+ * (answered 04 0e 08 01 00 fc 00 23 02 00 00) and 0x20 (end/verify) - so the
+ * sender is parameterised here and the caller names the phase. Observation
+ * only: one 5-byte TX, no retry, no cadence change. */
+/* Level 20.14's dormant probes (bt_peri_tme_vs_cmd and
+ * bt_peri_tme_hci_download) were retired in 20.21: their jobs are now done by
+ * bt_peri_vs_cmd and bt_peri_hci_stage above, which the map phases call
+ * directly and which carry the per-frame Command Complete check phase C needs.
+ * The old bodies also assumed 0x23 belonged at 82 % of the mbn stage; the
+ * trace shows it opens the nv stage instead, so that placement was wrong. */
+
+/* Level 20.9: watch long enough to see where the dump stops, and stop trusting
+ * a frame length that was not seen at a header boundary. l208 read 378 records
+ * (seq 20..397, ~99 KB) in 55 s and the window, not the ROM, ended it, so the
+ * size of the region is still unknown. This build keeps the same zero-request
+ * observation and only (a) stretches the window to 158 s inside a 180 s trial,
+ * (b) prints the raw 4-byte header on every record, and (c) logs every resync
+ * run with the bytes it dropped, because l208's plen-168 frame and 120 shifted
+ * bytes came from frame boundaries the reader could not vouch for. */
+#define BT_PERI_RECORD_WINDOW_MS	158000u
+#define BT_PERI_RECORD_SILENCE_MS	4000u
+#define BT_PERI_RECORD_CAP		1100u
+
+static void __unused
+bt_peri_record_watch(const char *what)
+{
+	uint8_t hdr[4];
+	uint8_t body[256];
+	unsigned records = 0;
+	unsigned bytes = 0;
+	unsigned f004 = 0;
+	unsigned f005 = 0;
+	unsigned other = 0;
+	unsigned resync = 0;
+	/* Level 20.10: count HCI event packets seen in the window. The Android
+	 * HAL's post-map exchange on 0xfc00 comes back as 04 0e Command Complete
+	 * (04 0e 05 01 00 fc 00 1e, then 04 0e 08 01 00 fc 00 23 02 00 00), not as
+	 * the 34 00 ff family; a verdict delivered that way used to be shifted
+	 * through as noise, so count and print it here. */
+	unsigned hci_evts = 0;
+	unsigned hci_ccs = 0;
+	/* Level 20.11: keep the bytes the resync walk discards. l209/l210 only
+	 * counted them (108 bytes at t_ms 62), and that run is exactly the ROM's
+	 * first answer to the last segment - it has to be read, not counted. */
+	uint8_t lost[128];
+	unsigned lost_len = 0;
+	unsigned first_seq = 0xffffu;
+	unsigned last_seq = 0xffffu;
+	unsigned span_ms;
+	uint64_t start = mach_absolute_time();
+	uint64_t prev = 0;
+	uint64_t until;
+	uint64_t total_ns = 0;
+	const char *why = "window";
+
+	printf("PANDORA BT: %s: record watch %u ms, silence %u ms, cap %u\n",
+	    what, BT_PERI_RECORD_WINDOW_MS, BT_PERI_RECORD_SILENCE_MS,
+	    BT_PERI_RECORD_CAP);
+	pandora_log_sync();
+	clock_interval_to_deadline(BT_PERI_RECORD_WINDOW_MS, NSEC_PER_MSEC, &until);
+
+	while (mach_absolute_time() < until && records < BT_PERI_RECORD_CAP) {
+		uint64_t deadline;
+		uint64_t now;
+		uint64_t gap_ns = 0;
+		uint64_t elapsed_ns = 0;
+		unsigned got = 0;
+		unsigned plen;
+		unsigned bad = 0;
+		unsigned shifted = 0;
+		bool ok = true;
+		int err;
+
+		clock_interval_to_deadline(BT_PERI_RECORD_SILENCE_MS,
+		    NSEC_PER_MSEC, &deadline);
+		if (deadline > until) {
+			deadline = until;
+		}
+		err = bt_rx_exact(hdr, 4, &got, deadline);
+		if (err) {
+			why = got ? "short header" : "silence";
+			break;
+		}
+		/* A stream that was interrupted mid-frame leaves a partial payload
+		 * in front of the next header; walk the window to a byte boundary
+		 * (bounded) instead of giving up on the first odd byte. */
+		while (!((hdr[0] == 0x34u && hdr[1] == 0x00u && hdr[2] == 0xffu) ||
+		    hdr[0] == 0x04u)) {
+			if (bad++ >= 128u) {
+				why = "no header in 128 bytes";
+				ok = false;
+				break;
+			}
+			if (lost_len < sizeof(lost)) {
+				lost[lost_len++] = hdr[0];
+			}
+			hdr[0] = hdr[1];
+			hdr[1] = hdr[2];
+			hdr[2] = hdr[3];
+			got = 0;
+			err = bt_rx_exact(hdr + 3, 1, &got, deadline);
+			if (err) {
+				why = "silence";
+				ok = false;
+				break;
+			}
+			resync++;
+			shifted++;
+		}
+		if (!ok) {
+			break;
+		}
+		/* Level 20.10: HCI event packet (04 <evt> <plen> <first param..>).
+	 * The 4-byte read above already holds type, event code, length and the
+	 * first parameter byte, so only len-1 more bytes remain. Consume them,
+	 * print the whole event, and decode Command Complete (04 0e) far enough
+	 * to name the 0xfc00 answer: status, opcode, and the trailing sub-op
+	 * bytes Android's own run got (00 fc 00 1e / 00 fc 00 23 02 00 00). */
+		if (hdr[0] == 0x04u) {
+		unsigned evlen = hdr[2];
+		unsigned params = 0;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - start,
+		    &gap_ns);
+		hci_evts++;
+		printf("PANDORA BT: %s: HCI event %02x len %u at t_ms %llu (resync %u)\n",
+		    what, hdr[1], evlen, gap_ns / 1000000ULL, shifted);
+		pandora_log_sync();
+		if (evlen == 0u) {
+			continue;
+		}
+		body[0] = hdr[3];
+		params = 1;
+		if (evlen > 1u) {
+			got = 0;
+			err = bt_rx_exact(body + 1, evlen - 1u, &got, deadline);
+			if (err) {
+				printf("PANDORA BT: %s: HCI event %02x body short (%u of %u)\n",
+				    what, hdr[1], params + got, evlen);
+				why = "short HCI event";
+				break;
+			}
+			params += got;
+		}
+		bt_dump_wide("PERI HCI event", body, params);
+		/* body[0] is the command count, body[1..2] the little-endian
+		 * opcode, body[3] the status and body[4] the subcommand echo
+		 * (the trace's 04 0e 05 01 00 fc 00 1e -> body = 01 00 fc 00 1e). */
+		if (hdr[1] == 0x0eu && params >= 3u && body[1] == 0xfcu &&
+		    body[2] == 0x00u) {
+			hci_ccs++;
+			printf("PANDORA BT: %s: 0xfc00 Command Complete status %u, %u trailing byte(s): %02x %02x %02x %02x %02x %02x\n",
+			    what, params > 3u ? body[3] : 0xffu, params - 3u,
+			    params > 4u ? body[4] : 0xffu, params > 5u ? body[5] : 0xffu,
+			    params > 6u ? body[6] : 0xffu, params > 7u ? body[7] : 0xffu,
+			    params > 8u ? body[8] : 0xffu, params > 9u ? body[9] : 0xffu);
+		} else if (hdr[1] == 0x0eu && params >= 3u) {
+			printf("PANDORA BT: %s: Command Complete status %u opcode %02x %02x\n",
+			    what, params > 3u ? body[3] : 0xffu, body[2], body[1]);
+		}
+		pandora_log_sync();
+		continue;
+		}
+		/* Level 20.9: a run of shifted bytes is where l208 lost alignment;
+		 * name it once, with the header the run landed on, so the drift can
+		 * be attributed instead of guessed at. */
+		if (shifted) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - start,
+			    &gap_ns);
+			printf("PANDORA BT: %s: resync dropped %u byte(s) before record %u at t_ms %llu, header now %02x %02x %02x %02x\n",
+			    what, shifted, records + 1u, gap_ns / 1000000ULL,
+			    hdr[0], hdr[1], hdr[2], hdr[3]);
+			bt_dump("PERI TME-L dropped bytes", lost, lost_len);
+			lost_len = 0;
+			pandora_log_sync();
+		}
+		/* plen is one byte, so 255 is the largest body asked for here
+		 * and body[256] always covers it. */
+		plen = hdr[3];
+		if (plen == 0u) {
+			continue;
+		}
+		/* Level 20.9: every frame in l208 was 252 except one that read as
+		 * 168. Flag any other length together with the header it came from,
+		 * so a real short record is never confused with a slipped reader. */
+		if (plen != 252u) {
+			printf("PANDORA BT: %s: frame plen %u is not 252, header %02x %02x %02x %02x, record %u\n",
+			    what, plen, hdr[0], hdr[1], hdr[2], hdr[3],
+			    records + 1u);
+			pandora_log_sync();
+		}
+		got = 0;
+		err = bt_rx_exact(body, plen, &got, deadline);
+		if (err) {
+			printf("PANDORA BT: %s: record body short (%u of %u bytes)\n",
+			    what, got, plen);
+			why = "short body";
+			break;
+		}
+		records++;
+		bytes += plen;
+		now = mach_absolute_time();
+		if (prev) {
+			absolutetime_to_nanoseconds(now - prev, &gap_ns);
+		}
+		prev = now;
+		absolutetime_to_nanoseconds(now - start, &elapsed_ns);
+		if (plen >= 4u && body[0] == 0xf0u) {
+			unsigned seq = (unsigned)body[2] |
+			    ((unsigned)body[3] << 8);
+
+			if (body[1] == 0x04u) {
+				f004++;
+			} else if (body[1] == 0x05u) {
+				f005++;
+			} else {
+				other++;
+			}
+			if (first_seq == 0xffffu) {
+				first_seq = seq;
+			}
+			last_seq = seq;
+			printf("PANDORA BT: %s: record %u hdr %02x %02x %02x %02x plen %u class %02x %02x seq %04x body %u gap_us %llu t_ms %llu\n",
+			    what, records, hdr[0], hdr[1], hdr[2], hdr[3], plen,
+			    body[0], body[1], seq, plen - 4u,
+			    gap_ns / 1000ULL, elapsed_ns / 1000000ULL);
+			bt_dump_wide("PERI record body", body + 4, plen - 4u);
+		} else {
+			other++;
+			printf("PANDORA BT: %s: non-record frame plen %u head %02x %02x %02x %02x t_ms %llu\n",
+			    what, plen, body[0], body[1], body[2], body[3],
+			    elapsed_ns / 1000000ULL);
+			bt_dump_wide("PERI non-record frame", body, plen);
+		}
+		pandora_log_sync();
+	}
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &total_ns);
+	span_ms = (unsigned)(total_ns / 1000000ULL);
+	printf("PANDORA BT: %s: watch ends (%s) after %u record(s), %u byte(s), seq %04x..%04x, class f0 04 %u / f0 05 %u / other %u, resync %u, HCI events %u (0xfc00 CC %u), %u ms\n",
+	    what, why, records, bytes, first_seq, last_seq, f004, f005, other,
+	    resync, hci_evts, hci_ccs, span_ms);
+	pandora_log_sync();
+}
+
+/* Level 20.21: non-blocking RX flush for the bulk-answered stages. The trace
+ * shows phase A and B produce no per-frame event, but a ROM that does answer
+ * per frame must not be allowed to fill the RX FIFO and lose the frame that
+ * matters. Everything read here is counted, not parsed; 0xfd is still answered
+ * with 0xfc because dropping the wake request would stall the next command. */
+static void
+bt_peri_flush(unsigned limit, unsigned *bytes, unsigned *wakes)
+{
+	static const uint8_t ack = 0xfc;
+	unsigned taken = 0;
+
+	uint8_t head[32];
+	unsigned hlen = 0;
+
+	while (taken < limit && (bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+		uint8_t b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (hlen < sizeof(head)) {
+			head[hlen++] = b;
+		}
+		if (b == 0xfdu) {
+			(void)bt_uart_tx(&ack, 1, "PERI flush wake ACK FC");
+			if (wakes != NULL) {
+				(*wakes)++;
+			}
+		}
+		taken++;
+	}
+	/* A silent stage that still flushed 543 bytes means the ROM was talking
+	 * and we were discarding it unread - which is exactly how a real reply can
+	 * vanish while the stage still reports success. Show the first few chunks
+	 * once each so the next run can identify what was thrown away. */
+	if (taken != 0u && hlen != 0u) {
+		static unsigned flush_shown;
+		if (flush_shown < 4u) {
+			flush_shown++;
+			printf("PANDORA BT: flush took %u byte(s), first %u:",
+			    taken, hlen);
+			for (unsigned i = 0; i < hlen && i < 16u; i++) {
+				printf(" %02x", head[i]);
+			}
+			printf("\n");
+		}
+	}
+	if (bytes != NULL) {
+		*bytes += taken;
+	}
+}
+
+/* Level 20.21: read exactly one HCI event, treating leading 0xfd as the ROM's
+ * wake request (answered 0xfc) and leading 0xfc/0xfe/0xff as line noise.
+ * The filter only runs while no event byte has been accepted yet: 0xfc is a
+ * legal payload byte inside the 0xfc00 Command Complete (04 0e 05 01 00 fc 00
+ * 1e), so filtering mid-event would corrupt the very event being read. */
+/* Record-skip state must survive a window boundary: a 34 00 ff <plen> record can
+ * be split between two calls, and restarting at "look for 0x34" would scan the
+ * leftover payload as if it were event starts (a stray 0x04 there can swallow the
+ * real ack). File scope + a reset at every protocol-phase entry keeps it honest. */
+static unsigned bt_vstate;
+static unsigned bt_vskip;
+
+static void
+bt_peri_record_state_reset(void)
+{
+	bt_vstate = 0;
+	bt_vskip = 0;
+}
+
+static int
+bt_peri_cc_read(unsigned window_ms, uint8_t *ev, unsigned cap, unsigned *got,
+    unsigned *wakes, const char *what, bool skip_records)
+{
+	static const uint8_t ack = 0xfc;
+	unsigned dropped = 0;
+	/* Records are only skipped when the caller asks for it. Phase C reads one
+	 * exact Command Complete per frame and must never swallow payload bytes:
+	 * a record header seen mid-stream (its start was drained by the previous
+	 * stage) would otherwise make us skip 252 bytes that contain the real ack,
+	 * which is exactly the timeout the 21:40 trial produced.
+	 *
+	 * The ROM also emits 0x34 vendor records: 34 00 ff <plen> <plen bytes>.
+	 * Their payload is arbitrary binary and routinely contains 0x04, which the
+	 * resync below would otherwise mistake for an HCI event header - that is how
+	 * a real Command Complete ended up being parsed as "event 04 8f status 242".
+	 * Skip the whole record by its declared length instead. */
+
+	uint64_t deadline;
+
+	*got = 0;
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint8_t b;
+
+		if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+			bt_sleep(100);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (bt_vstate != 0u) {
+			bool matched = true;
+
+			if (bt_vstate == 1u && b == 0x00u) {
+				bt_vstate = 2u;
+			} else if (bt_vstate == 2u && b == 0xffu) {
+				bt_vstate = 3u;
+			} else if (bt_vstate == 3u) {
+				bt_vskip = b;
+				bt_vstate = (bt_vskip != 0u) ? 4u : 0u;
+			} else if (bt_vstate == 4u) {
+				if (--bt_vskip == 0u) {
+					bt_vstate = 0u;
+				}
+			} else {
+				/* Not the expected 34 00 ff shape. Abandon the record and
+				 * fall through, so this byte still gets a chance to be the
+				 * first byte of a real event - dropping it could throw a
+				 * genuine 0x04 away. */
+				bt_vstate = 0u;
+				matched = false;
+			}
+			if (matched) {
+				continue;
+			}
+		}
+		if (skip_records && b == 0x34u && *got == 0u) {
+			/* Start of a 34 00 ff <plen> vendor record: validated and
+			 * skipped by the state machine above on the next bytes. */
+			bt_vstate = 1u;
+			continue;
+		}
+		if (*got == 0u) {
+			if (b == 0xfdu) {
+				printf("PANDORA BT: %s: wake 0xfd answered 0xfc\n", what);
+				pandora_log_sync();
+				(void)bt_uart_tx(&ack, 1, "PERI HCI CC wake ACK FC");
+				if (wakes != NULL) {
+					(*wakes)++;
+				}
+				continue;
+			}
+			/* An HCI event always starts with 0x04. Anything else before it
+			 * is line noise or a lost byte: record it and drop it instead of
+			 * letting it fill the buffer and turn into a bogus EMSGSIZE.
+			 * The trace shows the ROM's own dump frames start with 0x34, so
+			 * that case is logged once with its first byte. */
+			if (b != 0x04u) {
+				if (dropped < 8u) {
+					printf("PANDORA BT: %s: resync, dropped %#x before an HCI event\n",
+					    what, b);
+					pandora_log_sync();
+				}
+				dropped++;
+				continue;
+			}
+		}
+		ev[(*got)++] = b;
+		if (*got >= 3u && *got >= 3u + ev[2]) {
+			if (dropped != 0u) {
+				printf("PANDORA BT: %s: %u byte(s) dropped before event %02x %02x\n",
+				    what, dropped, ev[0], ev[1]);
+				pandora_log_sync();
+			}
+			return 0;
+		}
+		if (*got >= cap) {
+			return EMSGSIZE;
+		}
+	}
+	if (dropped != 0u || bt_vstate != 0u) {
+		printf("PANDORA BT: %s: window closed with %u byte(s) dropped, record state %u\n",
+		    what, dropped, bt_vstate);
+		pandora_log_sync();
+	}
+	return ETIMEDOUT;
+}
+
+/* One place for the version the driver prints. It used to be a literal inside the
+ * banner and fell seven levels behind (the log said 20.24 while the code was
+ * 20.35), which makes any post-hoc reading of a log attribute the wrong revision. */
+#define BT_PERI_VER "20.35"
+
+/* Level 20.43: drain the line to silence, the way upstream qbt_geni does.
+ *
+ * Every timing constant this lane has tried (40 ms, then 200 ms) was a guess at
+ * how long the ROM keeps talking after a bulk stage. Upstream UniXNU/QcaBluetooth
+ * does not guess: qbt_geni drains until the line goes quiet. That is the right
+ * criterion here too - phase B's residual stream is what buried the 0x23 answer,
+ * and a fixed window either cuts early (ack lost) or waits needlessly.
+ *
+ * quiet_ms is the gap that counts as silence; max_ms bounds the total wait and
+ * keeps the whole sequence inside the 30 s image timer. Wake bytes are answered
+ * but do not count as traffic. */
+static unsigned
+bt_peri_drain_silence(unsigned quiet_ms, unsigned max_ms, const char *what)
+{
+	uint64_t deadline, quiet_ticks, first_ticks, last_rx;
+	unsigned bytes = 0;
+	uint8_t head[48] = {0};
+	unsigned head_n = 0;
+	bool seen = false;   /* any byte at all, so the 48-byte head cap does not gate it */
+
+	/* Level 20.60 (v2054, hard cap): max_ms/quiet_ms are milliseconds, but
+	 * mach_absolute_time() counts timebase ticks - 19.2 MHz on this board, not
+	 * nanoseconds. The previous lines multiplied by NSEC_PER_MSEC and compared
+	 * the result against ticks, so the "500 ms" cap was 500e6 ticks = 26.04 s.
+	 * That is exactly the v2053 drain: map A ended at 2.137 and the log printed
+	 * "silenced" at 28.179, 26.04 s later, which stole 87 % of the 30 s window
+	 * from phases B and C. Convert with the kernel clock helpers so the cap is a
+	 * real 500 ms, the first-byte wait a real 200 ms, and quiet a real 4 ms. */
+	clock_interval_to_deadline(max_ms, NSEC_PER_MSEC, &deadline);
+	clock_interval_to_absolutetime_interval(quiet_ms, NSEC_PER_MSEC,
+	    &quiet_ticks);
+	/* Level 20.54: waiting for the first byte and waiting inside a stream are not
+	 * the same problem. With one 4 ms threshold the drain gives up before a late
+	 * answer even starts - exactly what 20.53 meant to fix (map A's answer arrived
+	 * after the fixed 60 ms drain). The first byte now gets up to 200 ms, the gaps
+	 * inside the stream keep the tight 4 ms that makes "silence" meaningful. */
+	clock_interval_to_absolutetime_interval(200u, NSEC_PER_MSEC, &first_ticks);
+	last_rx = mach_absolute_time();
+
+	while (mach_absolute_time() < deadline) {
+		uint8_t b;
+
+		if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+			if (mach_absolute_time() - last_rx >= (seen ? quiet_ticks : first_ticks)) {
+				break;
+			}
+			bt_sleep(100);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (b == 0xfdu) {
+			const uint8_t ack = 0xfc;
+
+			(void)bt_uart_tx(&ack, 1, "PERI silence wake ACK FC");
+			seen = true;
+			last_rx = mach_absolute_time();
+			continue;
+		}
+		seen = true;
+		bytes++;
+		if (head_n < sizeof(head)) {
+			/* What the drain is throwing away decides whether the line carries
+			 * our own frames, records, events, or noise. A count alone cannot
+			 * tell those apart - 165 KB of unknown bytes is exactly the kind of
+			 * thing that hid the 0x23 answer for two days. */
+			head[head_n++] = b;
+		}
+		last_rx = mach_absolute_time();
+	}
+	if (bytes == 0u) {
+		/* Nothing ever arrived: the wait was first_ticks (200 ms), not quiet_ms.
+		 * Printing "quiet 4 ms" here has already caused two misreadings today. */
+		printf("PANDORA BT: %s: no traffic within %u ms (first-byte wait)\n",
+		    what, 200u);
+	} else {
+		printf("PANDORA BT: %s: silenced after %u byte(s) (quiet %u ms)\n",
+		    what, bytes, quiet_ms);
+	}
+	if (head_n != 0u) {
+		bt_dump("PERI drain head", head, head_n);
+	}
+	pandora_log_sync();
+	return bytes;
+}
+
+/* Level 20.49: listen for the ROM's own frame at several rates.
+ *
+ * Phase B ends and the line then carries ~165 KB of unstructured bytes at a
+ * steady rate, with no loopback (routing loopback reads 0) and no CTS on this
+ * board (IOS 0x1). A patch that reconfigures its UART would produce exactly
+ * that: sampled at the wrong divisor, every frame becomes noise. QCA downloads
+ * do change rate mid-sequence (EDL_SET_BAUDRATE, and upstream's qbt_boot takes
+ * a baud argument), so this probe listens on each candidate and reports whether
+ * the 04 0e event prefix appears there. Reader is raw on purpose: the point is
+ * to detect framing, not to parse. */
+static void
+bt_peri_baud_probe(void)
+{
+	static const unsigned cand[] = { 4000000u, 3200000u, 3000000u, 2000000u,
+	    1500000u, 921600u };
+
+	for (unsigned k = 0; k < sizeof(cand) / sizeof(cand[0]); k++) {
+		uint8_t buf[64] = {0};
+		unsigned n = 0, pairs = 0;
+		uint64_t dl;
+
+		if (bt_uart_init(cand[k], false) != 0) {
+			printf("PANDORA BT: baud probe %u: init failed\n", cand[k]);
+			pandora_log_sync();
+			continue;
+		}
+		clock_interval_to_deadline(120u, NSEC_PER_MSEC, &dl);
+		while (mach_absolute_time() < dl && n < sizeof(buf)) {
+			if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+				bt_sleep(100);
+				continue;
+			}
+			buf[n] = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+			if (n >= 1u && buf[n - 1u] == 0x04u && buf[n] == 0x0eu) {
+				pairs++;
+			}
+			n++;
+		}
+		printf("PANDORA BT: baud probe %u: %u byte(s)/120 ms, 04 0e %u, head %02x %02x %02x %02x\n",
+		    cand[k], n, pairs, buf[0], buf[1], buf[2], buf[3]);
+		pandora_log_sync();
+	}
+	(void)bt_uart_init(4000000u, false);
+	printf("PANDORA BT: baud probe done; back to 4000000\n");
+	pandora_log_sync();
+}
+
+/* Level 20.21: phase A at the trace's own cadence.
+ *
+ * The 4 ms/segment pacing 20.13 introduced was a guess made before the Android
+ * capture was decoded. The trace settles it: phase A spans 9.949244-10.145364
+ * (196 ms) for 71,284 wire bytes, and 71,284 x 10 bits / 4 Mbaud = 178 ms - so
+ * the HAL runs the map at wire speed and the UART is the only limiter. This
+ * loop therefore sends every segment back to back and only polls the RX FIFO
+ * between frames, which keeps 0xfd answered without adding delay. */
+static int
+bt_peri_tlv_stage(const uint8_t *fw, unsigned size, const char *what, uint8_t sub06)
+{
+	bt_peri_record_state_reset();
+	uint8_t frame[BT_FW_SEG_MAX + 8u];
+	unsigned sent = 0;
+	unsigned seg = 0;
+	unsigned flushed = 0;
+	unsigned wakes = 0;
+	unsigned nseg = (size + BT_FW_SEG_MAX - 1u) / BT_FW_SEG_MAX;
+	unsigned last = size % BT_FW_SEG_MAX;
+	int err;
+
+	if (last == 0u) {
+		last = BT_FW_SEG_MAX;
+	}
+	/* Level 20.57: the log must not claim wire speed while 20.51 paces this stage.
+	 * The v2050 log still said "wire speed" for map A even though every segment
+	 * now waits 1.5 ms - a lie of exactly the kind that has misled this lane
+	 * three times today (a stale marker, a discarded payload, a mis-scaled drain). */
+	printf("PANDORA BT: %s: TLV 06 %02x stage, %u bytes -> %u frames (last %u), %s\n",
+	    what, sub06, size, nseg, last,
+	    (bt_level >= 20) ? "paced 1500 us" : "wire speed");
+	pandora_log_sync();
+	bt_tx_long_quiet = true;
+	bt_tx_long_frames = 0;
+	bt_tx_long_bytes = 0;
+	while (sent < size) {
+		unsigned len = size - sent;
+
+		if (len > BT_FW_SEG_MAX) {
+			len = BT_FW_SEG_MAX;
+		}
+		frame[0] = 0x31;
+		frame[1] = 0x00;
+		frame[2] = 0xf0;
+		frame[3] = 0xff;
+		frame[4] = (uint8_t)(len + 3u);
+		frame[5] = 0x06;
+		frame[6] = sub06;
+		frame[7] = (uint8_t)len;
+		for (unsigned i = 0; i < len; i++) {
+			frame[8u + i] = fw[sent + i];
+		}
+		err = bt_uart_tx_long(frame, len + 8u, what);
+		if (err == 0 && bt_level >= 20) {
+			bt_sleep(BT_PERI_TLV_PACE_US);
+		}
+		if (err) {
+			bt_tx_long_quiet = false;
+			printf("PANDORA BT: %s: frame %u/%u failed (error %d) after %u bytes\n",
+			    what, seg + 1u, nseg, err, sent);
+			pandora_log_sync();
+			return err;
+		}
+		sent += len;
+		seg++;
+		/* Do not flush after the final frame: the ROM's bulk answer arrives
+		 * exactly then, and flush discards everything that is not 0xfd. The
+		 * caller's bt_peri_bulk_drain is what should read it. */
+		if (sent < size) {
+			bt_peri_flush(64u, &flushed, &wakes);
+		}
+		if ((seg & 63u) == 0u) {
+			pandora_log_sync();
+		}
+	}
+	bt_tx_long_quiet = false;
+	printf("PANDORA BT: %s: %u frames sent (%u bytes), %u wake(s), %u byte(s) flushed\n",
+	    what, seg, sent, wakes, flushed);
+	printf("PANDORA BT: %s: %u TX command(s), %llu byte(s) on the wire, no per-frame log\n",
+	    what, bt_tx_long_frames, (unsigned long long)bt_tx_long_bytes);
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 20.38: wait for one specific VS Command Complete by exact prefix.
+ *
+ * The Android trace answers 0x23 with an 11-byte event
+ *   04 0e 08 01 00 fc 00 23 02 00 00
+ * 0.34 ms after the command. Our generic reader entered its 34 00 ff record-skip
+ * state on the bytes that arrive just before it and swallowed the whole event
+ * (real log: "window closed with 147 byte(s) dropped, record state 4"), so the
+ * command looked unanswered.
+ *
+ * This matcher cannot fall into that state: it looks only for the fixed prefix
+ * 04 0e <len> 01 00 fc 00 <sub> and drops everything else. */
+static int
+bt_peri_wait_cc_sub(uint8_t sub, unsigned window_ms, uint8_t *ev, unsigned cap,
+    unsigned *got, uint8_t *tail, unsigned tail_cap, unsigned *tail_len,
+    const char *what)
+{
+	uint8_t win[8] = {0};
+
+	/* A HCI event is at most 258 bytes, but the caller's buffer is its own
+	 * business: refuse rather than write eight bytes into something small. */
+	if (ev == NULL || cap < sizeof(win)) {
+		printf("PANDORA BT: %s: ev buffer too small (%u < 8)\n", what, cap);
+		return EINVAL;
+	}
+	unsigned filled = 0, dropped = 0;
+	uint64_t deadline;
+
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint8_t b;
+
+		if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+			bt_sleep(100);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (b == 0xfdu) {
+			const uint8_t ack = 0xfc;
+
+			(void)bt_uart_tx(&ack, 1, "PERI sub wake ACK FC");
+			continue;
+		}
+		if (filled < sizeof(win)) {
+			win[filled++] = b;
+		} else {
+			for (unsigned i = 1; i < sizeof(win); i++) {
+				win[i - 1u] = win[i];
+			}
+			win[sizeof(win) - 1u] = b;
+		}
+		if (filled < sizeof(win)) {
+			continue;
+		}
+		if (win[0] == 0x04u && win[1] == 0x0eu && win[3] == 0x01u &&
+		    win[4] == 0x00u && win[5] == 0xfcu && win[6] == 0x00u &&
+		    win[7] == sub) {
+			for (unsigned i = 0; i < sizeof(win); i++) {
+				ev[i] = win[i];
+			}
+			if (got != NULL) {
+				*got = sizeof(win);
+			}
+			/* The event is 3 + plen bytes in total and only 8 were consumed.
+			 * Leaving the tail in the FIFO poisons the next reader: for 0x23 it
+			 * is 3 bytes, but the 0x20 build-info answer has plen = 117 and would
+			 * leave 111 bytes behind. Drain what belongs to this event. */
+			if (tail_len != NULL) {
+				*tail_len = 0;
+			}
+			if (win[2] > 5u) {
+				unsigned rest = (unsigned)win[2] - 5u;
+				uint64_t tail_deadline;
+
+				clock_interval_to_deadline(50u, NSEC_PER_MSEC, &tail_deadline);
+				while (rest != 0u && mach_absolute_time() < tail_deadline) {
+					uint8_t tb;
+
+					if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+						bt_sleep(50);
+						continue;
+					}
+					tb = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+					if (tb == 0xfdu) {
+						/* A wake byte is not payload: still answer it, or the
+						 * ROM waits for the ack while we drain its event. */
+						const uint8_t ack = 0xfc;
+
+						(void)bt_uart_tx(&ack, 1, "PERI tail wake ACK FC");
+						continue;
+					}
+					/* Keep the payload when the caller asked for it: the
+					 * 0x20 build-info answer carries oBTFW.GANGES in these
+					 * bytes, so discarding them would throw away evidence. */
+					if (tail != NULL && tail_len != NULL &&
+					    *tail_len < tail_cap) {
+						tail[(*tail_len)++] = tb;
+					}
+					rest--;
+				}
+				if (rest != 0u) {
+					printf("PANDORA BT: %s: sub %02x event tail %u byte(s) left\n",
+					    what, sub, rest);
+					pandora_log_sync();
+				}
+			}
+			if (dropped != 0u) {
+				printf("PANDORA BT: %s: %u byte(s) before the sub %02x CC\n",
+				    what, dropped, sub);
+				pandora_log_sync();
+			}
+			return 0;
+		}
+		dropped++;
+	}
+	printf("PANDORA BT: %s: no sub %02x CC within %u ms (%u byte(s) dropped)\n",
+	    what, sub, window_ms, dropped);
+	pandora_log_sync();
+	return ETIMEDOUT;
+}
+
+/* Level 20.30: match the phase-C Command Complete by exact byte pattern.
+ *
+ * The generic event parser is the wrong tool here. Phase C must return exactly
+ * one known ack per frame, and the stream around it also carries dump payload:
+ * eight consecutive 0x04 bytes (common inside a 34 00 ff record) each start a
+ * bogus "event" with plen=4, and two retries of the generic parser then consume
+ * the real ack before it can be read - verified by replay, not assumed.
+ *
+ * A sliding 8-byte window cannot be fooled that way: it looks only for the one
+ * pattern the ROM sends as a per-frame ack, 04 0e 05 01 00 fc 00 1e, and drops
+ * everything else. */
+static int
+bt_peri_wait_cc8(unsigned window_ms, uint8_t *ev, const char *what)
+{
+	static const uint8_t want[8] = { 0x04, 0x0e, 0x05, 0x01, 0x00, 0xfc, 0x00, 0x1e };
+	uint8_t win[8] = {0};
+	uint8_t head[48] = {0};  /* first bytes seen, for identification on timeout */
+	unsigned head_n = 0;
+	unsigned filled = 0;
+	uint64_t total = 0;      /* every byte read, for an exact drop count */
+	uint64_t deadline;
+
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint8_t b;
+
+		if (!(bt_rd(BT_W_SE, SE_RX_FIFO_ST) & 0x1ffffffu)) {
+			bt_sleep(100);
+			continue;
+		}
+		b = (uint8_t)bt_rd(BT_W_SE, SE_RX_FIFO);
+		if (b == 0xfdu) {
+			const uint8_t ack = 0xfc;
+
+			(void)bt_uart_tx(&ack, 1, "PERI CC8 wake ACK FC");
+			continue;
+		}
+		total++;
+		if (head_n < sizeof(head)) {
+			/* Keeping the leading bytes is the difference between "the ack
+			 * never came" and knowing what did arrive - the 1,024-byte stream
+			 * this lane keeps seeing could not be identified because only a
+			 * count was logged. */
+			head[head_n++] = b;
+		}
+		if (filled < sizeof(win)) {
+			win[filled++] = b;
+		} else {
+			for (unsigned i = 1; i < sizeof(win); i++) {
+				win[i - 1u] = win[i];
+			}
+			win[sizeof(win) - 1u] = b;
+		}
+		if (filled < sizeof(win)) {
+			continue;
+		}
+		if (__builtin_memcmp(win, want, sizeof(want)) == 0) {
+			for (unsigned i = 0; i < sizeof(win); i++) {
+				ev[i] = win[i];
+			}
+			if (total > sizeof(win)) {
+				/* exact: everything read minus the eight that matched */
+				printf("PANDORA BT: %s: %llu byte(s) before the Command Complete\n",
+				    what, (unsigned long long)(total - sizeof(win)));
+				pandora_log_sync();
+			}
+			return 0;
+		}
+	}
+	if (total != 0u) {
+		printf("PANDORA BT: %s: window closed after %llu byte(s) without a CC\n",
+		    what, (unsigned long long)total);
+		bt_dump("PERI CC8 window head", head, head_n);
+		pandora_log_sync();
+	}
+	return ETIMEDOUT;
+}
+
+/* Level 20.21: one HCI 0xfc00 data stage. Frame layout is the one the trace
+ * and PatchDLManager::FrameHciPkt agree on:
+ *     01 00 fc <seglen+2> 1e <seglen> <seglen bytes>
+ * per_frame_cc selects the ROM's answer discipline: phase C (the nv stage)
+ * gets one 8-byte Command Complete per frame and needs the RX FIFO drained
+ * frame by frame; phases A and B are answered only in bulk at their end, so
+ * they run at wire speed and the caller drains afterwards. */
+static int
+bt_peri_hci_stage(const uint8_t *fw, unsigned size, const char *what,
+    bool per_frame_cc)
+{
+	bt_peri_record_state_reset();
+	uint8_t frame[6u + BT_FW_SEG_MAX];
+	/* The ROM's answers are not 8 bytes in general: the 0x23 reply is 11 B and
+	 * the 0x20 build-info reply is 117 B. A 16-byte buffer made the very first
+	 * C frame return EMSGSIZE before the event could even be parsed. */
+	uint8_t ev[BT_PERI_EVT_MAX];
+	unsigned sent = 0;
+	unsigned seg = 0;
+	unsigned ccs = 0;
+	unsigned wakes = 0;
+	unsigned flushed = 0;
+	uint8_t last_sub = 0;
+	unsigned nseg = (size + BT_FW_SEG_MAX - 1u) / BT_FW_SEG_MAX;
+	unsigned last = size % BT_FW_SEG_MAX;
+	int err;
+
+	if (last == 0u) {
+		last = BT_FW_SEG_MAX;
+	}
+	printf("PANDORA BT: %s: HCI 0xfc00 stage, %u bytes -> %u frames (last %u), %s\n",
+	    what, size, nseg, last,
+	    per_frame_cc ? "one Command Complete per frame" : "wire speed, bulk answer");
+	pandora_log_sync();
+	bt_tx_long_quiet = true;
+	bt_tx_long_frames = 0;
+	bt_tx_long_bytes = 0;
+	while (sent < size) {
+		unsigned len = size - sent;
+
+		if (len > BT_FW_SEG_MAX) {
+			len = BT_FW_SEG_MAX;
+		}
+		frame[0] = 0x01;
+		frame[1] = 0x00;
+		frame[2] = 0xfc;
+		frame[3] = (uint8_t)(len + 2u);
+		frame[4] = 0x1e;
+		frame[5] = (uint8_t)len;
+		for (unsigned i = 0; i < len; i++) {
+			frame[6u + i] = fw[sent + i];
+		}
+		err = bt_uart_tx_long(frame, len + 6u, what);
+		if (err) {
+			bt_tx_long_quiet = false;
+			printf("PANDORA BT: %s: frame %u/%u failed (error %d) after %u bytes\n",
+			    what, seg + 1u, nseg, err, sent);
+			pandora_log_sync();
+			return err;
+		}
+		sent += len;
+		seg++;
+		if (per_frame_cc) {
+			/* The trace's per-frame ack is 04 0e 05 01 00 fc 00 1e:
+			 * plen 5, one command, opcode 0xfc00, status 0, and the
+			 * subcommand echo last. Late acks from the previous bulk
+			 * stage look like 04 0e 08 01 00 fc 00 23 ... (plen 8),
+			 * so they are logged and skipped instead of being taken
+			 * for this frame's ack or aborting the stage. */
+			unsigned tries = 0;
+			bool acked = false;
+
+			/* Time budget. The trace spaces phase C one frame every 2.70 ms
+			 * and the ROM answers inside 2 ms, so 40 ms per try is a 15x
+			 * margin. Eight 200 ms tries would allow 1.6 s per frame and
+			 * 91 s for the 57 frames - past the whole 30 s trial. Four tries
+			 * at 40 ms caps the stage at 9.1 s in the worst case. */
+			while (!acked && tries < 1u) {
+				tries++;
+				/* bt_peri_wait_cc8() returns only when the exact 8-byte
+				 * Command Complete has been matched, so there is nothing left
+				 * to validate here - and nothing that can fail. An earlier
+				 * revision kept the old got>=8 && ev[2]==5 checks after the
+				 * switch to the matcher, but `got` is never advanced by it:
+				 * those tests were permanently false and phase C would have
+				 * failed on every frame even with a perfect ack. */
+				err = bt_peri_wait_cc8(200u, ev, what);
+				if (err) {
+					bt_tx_long_quiet = false;
+					printf("PANDORA BT: %s: frame %u/%u got no Command Complete (error %d)\n",
+					    what, seg, nseg, err);
+					pandora_log_sync();
+					return err;
+				}
+				acked = true;
+				last_sub = ev[7];
+				ccs++;
+				continue;
+			}
+			if (!acked) {
+				bt_tx_long_quiet = false;
+				printf("PANDORA BT: %s: frame %u/%u never acked after %u event(s)\n",
+				    what, seg, nseg, tries);
+				pandora_log_sync();
+				return EPROTO;
+			}
+		}
+		if (!per_frame_cc && (seg & 63u) == 0u && sent < size) {
+			/* Same rule as tlv_stage: keep the last frame's answer for the
+			 * caller's drain instead of throwing it away here. */
+			bt_peri_flush(4096u, &flushed, &wakes);
+			pandora_log_sync();
+		}
+	}
+	bt_tx_long_quiet = false;
+	/* Level 20.56: the bulk path must consume its own final Command Complete.
+	 *
+	 * Only the per-frame path (phase C) waits for a CC, so the 1,374-frame bulk
+	 * stage reported "0 Command Complete(s)". btqca states the last segment is
+	 * always acknowledged, and the v2050 log shows the cost of ignoring it: the
+	 * next command reported "no sub 19 CC within 500 ms (7965 byte(s) dropped)",
+	 * i.e. B's trailing CC was eaten by the following window.
+	 *
+	 * Wait once, bounded, and say so in the log. */
+	if (!per_frame_cc && sent != 0u) {
+		uint8_t lcc[BT_PERI_EVT_MAX];
+		int cerr = bt_peri_wait_cc8(500u, lcc, what);
+
+		if (cerr == 0) {
+			last_sub = lcc[7];
+			ccs++;
+		}
+		printf("PANDORA BT: %s: final Command Complete %s (error %d)\n",
+		    what, cerr == 0 ? "received" : "missing", cerr);
+		pandora_log_sync();
+	}
+	printf("PANDORA BT: %s: %u frames sent (%u bytes), %u Command Complete(s), last sub %02x, %u wake(s), %u byte(s) flushed\n",
+	    what, seg, sent, ccs, last_sub, wakes, flushed);
+	printf("PANDORA BT: %s: %u TX command(s), %llu byte(s) on the wire, no per-frame log\n",
+	    what, bt_tx_long_frames, (unsigned long long)bt_tx_long_bytes);
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 20.21: send one 5-byte 0xfc00 vendor command (01 00 fc 01 <subcmd>) the
+ * way HciSendVsCmd does, and record the answer without making it fatal: the
+ * trace shows three of them (0x19 opens the mbn stage, 0x23 opens the nv stage,
+ * 0x20 closes the map) and their answers differ in length but never in shape.
+ * Returns 0 when any HCI event came back, ETIMEDOUT when the window closed. */
+static int
+bt_peri_vs_cmd(uint8_t sub, unsigned window_ms, const char *what)
+{
+	bt_peri_record_state_reset();
+	uint8_t request[5] = { 0x01, 0x00, 0xfc, 0x01, 0x00 };
+	uint8_t ev[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	unsigned tlen = 0;
+	int err;
+
+	request[4] = sub;
+	printf("PANDORA BT: %s: VS command 01 00 fc 01 %02x\n", what, sub);
+	pandora_log_sync();
+	err = bt_uart_tx(request, sizeof(request), "PERI TME-L VS command");
+	if (err) {
+		printf("PANDORA BT: %s: VS command TX failed (error %d)\n", what, err);
+		pandora_log_sync();
+		return err;
+	}
+	/* The ROM echoes the subcommand in ev[7]: the trace answers 0x19 with
+	 * 04 0e 05 01 00 fc 00 19, 0x23 with ... 00 23 and 0x20 with ... 00 20.
+	 * Accepting any event here let a stale reply stand in for this command
+	 * (the real one was then eaten by the next stage), so match the echo and
+	 * skip up to four foreign events before giving up. */
+	err = ETIMEDOUT;
+	for (unsigned tries = 0; tries < 4u; tries++) {
+		unsigned w = (tries == 0u) ? window_ms : 50u;
+		/* Exact-prefix matcher instead of the generic reader: the generic one
+		 * enters its 34 00 ff record state on the bytes preceding the answer
+		 * and then swallows the whole event (measured: 147 bytes dropped,
+		 * record state 4, 0x23 reported unanswered). */
+		err = bt_peri_wait_cc_sub(sub, w, ev, sizeof(ev), &got,
+			ev + 8u, sizeof(ev) - 8u, &tlen, what);
+		if (err) {
+			break;
+		}
+		if (ev[0] == 0x04u && ev[1] == 0x0eu && got >= 8u && ev[7] == sub) {
+			if (tlen != 0u) {
+				/* The payload is what carries the evidence for 0x20
+				 * (oBTFW.GANGES in a 117-byte build-info answer). Without this
+				 * line the plan's criterion cannot be checked from the log at
+				 * all - tlen was captured and then never reported. */
+				bool has_tag = false;
+				unsigned lim = (tlen > 96u) ? 96u : tlen;
+
+				for (unsigned i = 0u; i + 5u <= tlen; i++) {
+					if (__builtin_memcmp(ev + 8u + i, "oBTFW", 5) == 0) {
+						has_tag = true;
+						break;
+					}
+				}
+				printf("PANDORA BT: %s: VS command %02x payload %u byte(s), oBTFW %s\n",
+				    what, sub, tlen, has_tag ? "present" : "absent");
+				bt_dump("VS payload head", ev + 8u, lim);
+				pandora_log_sync();
+			}
+			if (ev[6] != 0x00u) {
+				printf("PANDORA BT: %s: VS command %02x answered status %u\n",
+				    what, sub, ev[6]);
+			} else {
+				/* Level 20.59: success used to be silent, so "map B open got its
+				 * sub 19 CC" - a pre-registered criterion for the next run - had no
+				 * line to grep. A criterion that cannot be observed is not a
+				 * criterion; this lane has lost hours to exactly that pattern. */
+				printf("PANDORA BT: %s: VS command %02x answered (status 0, %u byte(s))\n",
+				    what, sub, got);
+			}
+			pandora_log_sync();
+			err = 0;
+			break;
+		}
+		printf("PANDORA BT: %s: VS command %02x skipped foreign event %02x %02x len %u echo %02x\n",
+		    what, sub, ev[0], got > 1u ? ev[1] : 0u, got > 2u ? ev[2] : 0u,
+		    got >= 8u ? ev[7] : 0x00u);
+		pandora_log_sync();
+	}
+	if (err) {
+		printf("PANDORA BT: %s: VS command %02x answered nothing in %u ms (error %d)\n",
+		    what, sub, window_ms, err);
+		pandora_log_sync();
+		return err;
+	}
+	/* Status is ev[6] and the subcommand echo is ev[7]: the trace's
+	 * 04 0e 08 01 00 fc 00 23 02 00 00 (the 0x23 answer) and
+	 * 04 0e 75 01 00 fc 00 20 6f 42 54 46 ... (the 0x20 answer, whose
+	 * payload is the ASCII "oBTFW...") both put status first. */
+	printf("PANDORA BT: %s: VS command answered event %02x %02x len %u status %u sub %02x\n",
+	    what, ev[0], got > 1u ? ev[1] : 0u, got > 2u ? ev[2] : 0u,
+	    (ev[0] == 0x04u && got >= 7u) ? ev[6] : 0xffu,
+	    (ev[0] == 0x04u && got >= 8u) ? ev[7] : 0x00u);
+	bt_dump_wide("PERI VS answer", ev, got < sizeof(ev) ? got : sizeof(ev));
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 20.61 (v2055-A): both 0x19 windows closed and the B stage was
+ * withheld. Two states produce that log and the fix differs: the ROM
+ * stopped answering, or it still lives and only the 0x19 open is rejected.
+ * Ask the two paths that answered before the B open, each with a 400 ms
+ * window (the post-B liveness probe uses the same 400 ms and answered at
+ * 0.44 s in the 0568 capture). GetVer(00) goes first so a 0x19 answer is
+ * not masked by the PERI frame in front of it. Observation only: two TX
+ * commands, no retry, no stage change; the caller returns either way. */
+static void
+bt_peri_b_open_liveness(void)
+{
+	int gerr = bt_peri_getver_window(400u);
+	int verr = bt_peri_vs_cmd(0x19u, 400u,
+	    "PERI map B open liveness probe (0x19)");
+	const char *g = (gerr == 0) ? "answered" : "silent";
+	const char *v = (verr == 0) ? "answered" : "silent";
+	const char *why;
+
+	if (gerr == 0 && verr == 0) {
+		why = "ROM alive, only the 0x19 open rejected";
+	} else if (gerr == 0) {
+		why = "ROM alive on GetVer, 0x19 path stalled";
+	} else if (verr == 0) {
+		why = "0x19 answered, GetVer path stalled";
+	} else {
+		why = "ROM stalled, no probe answered";
+	}
+	printf("PANDORA BT: map B open liveness: GetVer(00) %s (error %d), 0x19 %s (error %d) -> %s\n",
+	    g, gerr, v, verr, why);
+	pandora_log_sync();
+}
+
+/* Level 20.61 (v2055-A): keep the f0 04 dc..df vendor records whole. The
+ * 0568 capture put four of them (dc/dd/de/df) in the first 1024 bytes after
+ * the withheld B open, each inside a 34 00 ff fc record; bt_peri_raw_dump
+ * keeps a flat 1024-byte window, so a record can be cut at the cap and the
+ * log carries no boundary to say which bytes belong to which packet. Parse
+ * the record header here and print 4 + plen bytes per match, so the payload
+ * can be decoded offline without guessing where a record starts. */
+static void
+bt_peri_vendor_dcdf_dump(unsigned window_ms, const char *what)
+{
+	static const uint8_t ack = 0xfc;
+	uint8_t buf[2048];
+	unsigned n = 0;
+	unsigned records = 0;
+	unsigned matches = 0;
+	unsigned cut = 0;
+	uint64_t deadline;
+
+	printf("PANDORA BT: %s: vendor watch %u ms, whole 34 00 ff packet(s)\n",
+	    what, window_ms);
+	pandora_log_sync();
+	clock_interval_to_deadline(window_ms, NSEC_PER_MSEC, &deadline);
+	while (n < sizeof(buf) && mach_absolute_time() < deadline) {
+		uint8_t byte = 0;
+		unsigned field = 0;
+		int err;
+
+		err = bt_rx_exact(&byte, 1, &field, deadline);
+		if (err) {
+			break;
+		}
+		if (byte == 0xfdu) {
+			(void)bt_uart_tx(&ack, 1, "vendor watch ACK FC");
+		}
+		buf[n++] = byte;
+	}
+	printf("PANDORA BT: %s: vendor watch %u byte(s)\n", what, n);
+
+	for (unsigned i = 0; i + 4u <= n; ) {
+		unsigned plen;
+		const uint8_t *body;
+
+		if (buf[i] != 0x34u || buf[i + 1u] != 0x00u || buf[i + 2u] != 0xffu) {
+			i++;
+			continue;
+		}
+		plen = buf[i + 3u];
+		if (i + 4u + plen > n) {
+			cut++;
+			printf("PANDORA BT: %s: record at %u declares %u body byte(s), %u captured\n",
+			    what, i, plen, n - i - 4u);
+			break;
+		}
+		body = buf + i + 4u;
+		records++;
+		if (plen >= 7u && body[0] == 0xf0u && body[1] == 0x04u &&
+		    body[2] >= 0xdcu && body[2] <= 0xdfu) {
+			matches++;
+			printf("PANDORA BT: %s: record %u at %u: plen %u, vendor event f0 04 %02x, %u byte(s) whole\n",
+			    what, records, i, plen, body[2], 4u + plen);
+			bt_dump_wide("PERI f0 04 dc-df record", buf + i, 4u + plen);
+			pandora_log_sync();
+		}
+		i += 4u + plen;
+	}
+	if (matches == 0u && n != 0u) {
+		bt_dump("PERI vendor watch head", buf, n < 32u ? n : 32u);
+	}
+	printf("PANDORA BT: %s: %u record(s), %u matching f0 04 dc-df, %u truncated\n",
+	    what, records, matches, cut);
+	pandora_log_sync();
+}
+
+/* Level 20.21: drain whatever the ROM left after a bulk-answered stage, then
+ * answer its wake request. Phases A and B produce no per-frame event, but the
+ * ROM does raise 0xfd once the batch is complete - and the trace shows that
+ * 0xfd must be answered 0xfc before the next command is accepted. */
+static void
+bt_peri_bulk_drain(unsigned window_ms, const char *what)
+{
+	bt_peri_record_state_reset();
+	uint8_t ev[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	unsigned wakes = 0;
+
+	/* Drain what the ROM left, not just the first event: a single leftover
+	 * event would otherwise be consumed by the next VS command and the real
+	 * reply would stall phase C until its 8 tries are gone. */
+	unsigned n = 0;
+	while (n < 8u) {
+		/* Only the first read may use the caller's full window: passing
+		 * window_ms to every iteration turned a 1,000 ms drain into eight
+		 * seconds and would have eaten a 30 s trial on its own. Later
+		 * events are already queued, so a short settle is enough. */
+		unsigned wait = (n == 0u) ? window_ms : 30u;
+		if (bt_peri_cc_read(wait, ev, sizeof(ev), &got, &wakes, what, true) != 0) {
+			break;
+		}
+		n++;
+		printf("PANDORA BT: %s: bulk answer %u event %02x %02x len %u\n",
+		    what, n, ev[0], got > 1u ? ev[1] : 0u, got > 2u ? ev[2] : 0u);
+		bt_dump_wide("PERI bulk answer", ev, got);
+	}
+	if (n == 0u) {
+		printf("PANDORA BT: %s: no bulk answer in %u ms (%u wake(s))\n",
+		    what, window_ms, wakes);
+	} else {
+		printf("PANDORA BT: %s: %u bulk answer(s) drained\n", what, n);
+	}
+	pandora_log_sync();
+}
+
+/* Level 20 orchestrator: after the level-19 download chain passes, reset
+ * the PERI, then replay the Android trace's three map phases in order. */
+static int
+bt_peri_level20(void)
+{
+	bt_peri_record_state_reset();
+	int err;
+
+	printf("PANDORA BT: level 20: TME-L map A %u B (TLV) + B %u B + C %u B (HCI 0xfc00) (" BT_PERI_VER ")\n",
+	    (unsigned)sizeof(pandora_peri_tmel_elf),
+	    (unsigned)sizeof(pandora_peri_tmel_mbn),
+	    (unsigned)sizeof(pandora_peri_tmel_nvm));
+	pandora_log_sync();
+	/* Level 20.19: GetVer(00) and ActivateSS now happen in the level-19 chain
+	 * (trace order), so the TME-L phase starts with the same three frames
+	 * Android sends at 9.929180-9.930829: reset (31 00 f1 ff 01 03), the
+	 * fd wake, arbitrate v3, GetVer(03). No second ActivateSS. */
+	err = bt_peri_reset();
+	if (err) {
+		return err;
+	}
+	err = bt_peri_arbitrate_v3();
+	if (err) {
+		return err;
+	}
+	err = bt_peri_version_v3();
+	if (err) {
+		return err;
+	}
+	/* Phase A (trace 9.949244-10.145364): the 68,952-byte map ELF as 284
+	 * sub-op 06 03 TLV frames at wire speed - the trace's 196 ms for 71,284
+	 * bytes is exactly the 4 Mbaud wire time, so the old 4 ms/segment pacing
+	 * was a guess that cost 0.94 s of silence the ROM never asked for. */
+	err = bt_peri_tlv_stage(pandora_peri_tmel_elf,
+	    sizeof(pandora_peri_tmel_elf), "PERI TME-L map A", 0x03);
+	if (err) {
+		printf("PANDORA BT: level 20 phase A failed (error %d)\n", err);
+		pandora_log_sync();
+		bt_peri_raw_dump(2000u, "PERI TME-L map A failure raw");
+		return err;
+	}
+	/* Measured from the trace: phase A's last frame to the 0x19 command is
+	 * 54.1 ms, and phase A produces no ROM traffic, so 60 ms covers a wake
+	 * request without holding the next command back by the old 150 ms. */
+	/* Level 20.53: drain map A to silence instead of a fixed 60 ms.
+	 *
+	 * Once map A is paced (20.51), its bulk answer arrives later than the 60 ms
+	 * window allowed: the v2050 log shows "map A: no bulk answer in 60 ms" and then
+	 * "map B open: no sub 19 CC within 500 ms (7965 byte(s) dropped)" - those 7,965
+	 * bytes are map A's late answer arriving inside the next command's window and
+	 * burying it. Pacing fixed the ROM dump but moved the answer past the drain.
+	 *
+	 * Silence is the right criterion here for the same reason it was right after
+	 * phase B: the gap is what tells us the stage is over, not a constant. */
+	(void)bt_peri_drain_silence(4u, 500u, "PERI TME-L map A tail");
+	/* Phase B (trace 10.199460 start command, then 1374 frames to 11.189057):
+	 * the 333,868-byte gngbtfw20.mbn as HCI 0xfc00/subcmd 0x1e frames of 243
+	 * bytes (last 229). Wire speed: Android's stage spans 0.99 s for 342 KB,
+	 * i.e. no artificial pacing - the UART itself is the limiter. */
+	/* Level 20.60 (v2054): the 0x19 open is the only gate between map A's
+	 * tail and 333,868 bytes of B frames. v2053 gave it a single 500 ms window,
+	 * logged "no sub 19 CC within 500 ms (7911 byte(s) dropped)" and then sent
+	 * all 1,374 B frames anyway - into a ROM that had not answered: 0 Command
+	 * Complete, last sub 00. Give the open 1500 ms and one explicit retry; if
+	 * both windows close, withhold the B frames so a failed open is the logged
+	 * cause instead of a 334 KB stage whose silence has to be interpreted. */
+	err = bt_peri_vs_cmd(0x19u, 1500u, "PERI TME-L map B open");
+	if (err) {
+		printf("PANDORA BT: level 20 phase B open retry after 1500 ms (error %d)\n", err);
+		pandora_log_sync();
+		err = bt_peri_vs_cmd(0x19u, 1500u, "PERI TME-L map B open retry");
+	}
+	if (err) {
+		printf("PANDORA BT: level 20 phase B open command unanswered after 2 x 1500 ms (error %d); withholding %u B frame(s)\n",
+		    err, (unsigned)sizeof(pandora_peri_tmel_mbn));
+		pandora_log_sync();
+		bt_peri_b_open_liveness();
+		bt_peri_vendor_dcdf_dump(2000u, "PERI TME-L map B open failure raw");
+		return err;
+	}
+	err = bt_peri_hci_stage(pandora_peri_tmel_mbn,
+	    sizeof(pandora_peri_tmel_mbn), "PERI TME-L map B", false);
+	if (err) {
+		printf("PANDORA BT: level 20 phase B failed (error %d)\n", err);
+		pandora_log_sync();
+		bt_peri_raw_dump(2000u, "PERI TME-L map B failure raw");
+		return err;
+	}
+	/* Measured: phase B's last frame is answered at t=11.209250, 100 us before
+	 * the 0x23 command itself (20.3 ms after the frame). The old 1000 ms window
+	 * delayed the next command by ~980 ms for no reason; 40 ms still catches
+	 * that trailing Command Complete. */
+	/* Drain to silence before asking for the board id: upstream qbt_geni uses
+	 * exactly this criterion, and the fixed windows tried earlier are why the
+	 * 0x23 answer kept being buried in phase B's residual stream. */
+	(void)bt_peri_drain_silence(4u, 200u, "PERI TME-L map B tail");
+	/* Level 20.52: ask about liveness BEFORE the baud probe.
+	 *
+	 * The probe reconfigures the SE six times and discards whatever arrives
+	 * during 720 ms. Running it first therefore contaminates the very verdict
+	 * the liveness check is supposed to produce: "0x19 silent" would be
+	 * indistinguishable from "0x19 answered but the probe ate it". Order matters
+	 * more than the 0.7 s saved by doing otherwise. */
+
+	/* Level 20.48: probe liveness before asking for the board id.
+	 *
+	 * Two boots in a row (19:5x and 20:52) measured the same thing after phase B:
+	 * 165,005 bytes of unstructed RX (drain head 5b 59 1d ee ...), 7,715 more bytes
+	 * inside the 0x23 window, six ROM diagnostic dumps and no BID answer. CTS reads
+	 * idle low on this board, so flow control is not an option and pacing or a
+	 * re-sync is. Before redesigning phase B, settle what state the ROM is in:
+	 * ask something it has already answered today (0x19 at 0.44 s). A reply means
+	 * the ROM lives and only the BID path is broken; silence means phase B knocked
+	 * it over and the fix belongs in how phase B transmits. */
+	{
+		uint8_t lev[BT_PERI_EVT_MAX];
+		unsigned lgot = 0;
+		int lerr = bt_peri_vs_cmd(0x19u, 400u, "PERI post-B liveness probe (0x19)");
+
+		(void)lev; (void)lgot;
+		printf("PANDORA BT: post-B liveness: 0x19 %s (error %d)\n",
+		    lerr == 0 ? "answered" : "silent", lerr);
+		pandora_log_sync();
+	}
+	/* Level 20.58: the baud scan used to sit here, between the liveness probe and
+	 * the 0x23 request. It reconfigures the SE six times, so putting a diagnostic
+	 * directly in front of a command we need answered is backwards. It now runs
+	 * after the phase C attempt, where it cannot disturb a command/answer pair. */
+	/* Phase C (trace 11.209352 0x23, then 57 frames to 11.380534): the nv
+	 * stage carries gngbtnv20.bin behind a 4-byte 04 22 4c 00 header. This
+	 * is the only stage the ROM answers frame by frame, so it runs with the
+	 * per-frame Command Complete check. */
+	err = bt_peri_vs_cmd(0x23u, 500u, "PERI TME-L map C open");
+	if (err) {
+		printf("PANDORA BT: level 20 phase C open command unanswered (error %d); continuing\n", err);
+		pandora_log_sync();
+	}
+	{
+		/* 04 22 4c 00 + the nv bytes, exactly the stream the trace carries
+		 * for this stage (13,836 B -> 57 frames, last 228 B). */
+		static uint8_t nv_stage[4u + sizeof(pandora_peri_tmel_nvm)];
+		nv_stage[0] = 0x04;
+		nv_stage[1] = 0x22;
+		nv_stage[2] = 0x4c;
+		nv_stage[3] = 0x00;
+		memcpy(&nv_stage[4], pandora_peri_tmel_nvm, sizeof(pandora_peri_tmel_nvm));
+		err = bt_peri_hci_stage(nv_stage, 4u + sizeof(pandora_peri_tmel_nvm),
+		    "PERI TME-L map C", true);
+		if (err) {
+			printf("PANDORA BT: level 20 phase C failed (error %d)\n", err);
+			pandora_log_sync();
+			bt_peri_raw_dump(2000u, "PERI TME-L map C failure raw");
+			return err;
+		}
+	}
+	/* Measured: the 0x20 close command follows phase C's last frame by 380.9 ms
+	 * in the trace, so 400 ms keeps our cadence where Android's is instead of
+	 * 1000 ms. */
+	bt_peri_bulk_drain(400u, "PERI TME-L map C");
+	/* Phase D (trace 11.761406): the closing 0x20, answered with the 117-byte
+	 * build-info event whose payload carries "oBTFW.GANGES.". Android reaches
+	 * a live HCI state right after it. */
+	bt_peri_baud_probe();
+	err = bt_peri_vs_cmd(0x20u, 2000u, "PERI TME-L map close");
+	if (err) {
+		printf("PANDORA BT: level 20 close command unanswered (error %d)\n", err);
+		pandora_log_sync();
+	}
+	/* Verdict: the same two observation frames the HAL sends in TmelSocInit,
+	 * then a read-only window for the Patch Ntf. */
+	(void)bt_peri_version_v3();
+	(void)bt_peri_tme_state_probe("PERI TME-L post-map");
+	bt_peri_tme_verdict_watch(3000u, "PERI TME-L post-map");
+	printf("PANDORA BT: level 20 TME-L done; license phase skipped (no cnss_softsku_peach.pfm on this device - HAL does the same)\n");
+	pandora_log_sync();
+	return 0;
+}
+
+/* Level 19 orchestrator: the HAL download chain at the proven 4 Mbps link.
+ * Arbitrate -> ram patch (142 segments, last-segment ACK only) -> board
+ * id -> NVM (4 segments) -> build info gate. No reset, no ActivateSS,
+ * no further state change (level 20). */
+static int
+bt_peri_download(void)
+{
+	bt_peri_record_state_reset();
+	uint16_t bid = 0xffff;
+	int err;
+
+	printf("PANDORA BT: level 19 download: ram patch %u B + NVM %u B, 243-byte segments, last-segment ACK at 4 Mbps\n",
+	    (unsigned)sizeof(pandora_peri_fw_mbn), (unsigned)sizeof(pandora_peri_nvm_bin));
+	pandora_log_sync();
+	/* PatchConfigReq skipped exactly like the HAL's no_value property
+	 * path: that path sets the per-segment skip mode (SKIP_EVT_VSE_CC)
+	 * and skips the config command; both behaviors are replicated by
+	 * the segment loop below (non-last segments do not wait). */
+	printf("PANDORA BT: PatchConfigReq skipped (HAL no_value attribute path: non-last segments skip the ACK wait)\n");
+	pandora_log_sync();
+	/* Level 20.19: the trace sends ActivateSS (31 00 f1 ff 02 02 0f) at
+	 * 9.773776, right after GetVer(00) and BEFORE Arbitrate + the ram patch.
+	 * 20.15-20.18 sent it after the patch (inside the level-20 phase); the
+	 * 20.18 device run then answered the (Android-proven) TLV end frame with
+	 * the ROM's diagnostic dump instead of the 12-byte ACK + sub-09 build
+	 * info push. The only known state difference at TLV end time was that
+	 * ActivateSS had never been sent, so replay the trace order here. */
+	/* Only level 20 replays the trace's ActivateSS position. A plain level-19
+	 * run must keep the exact wire sequence it was accepted with, so these two
+	 * frames stay out of that path. */
+	if (bt_level >= 20) {
+		(void)bt_peri_getver_peri();
+		(void)bt_peri_activate_ss();
+	}
+	err = bt_peri_arbitrate();
+	if (err) {
+		return err;
+	}
+	/* Level 20.50: pace the ram patch the same way the NVM is paced.
+	 *
+	 * This driver already inserts BT_PERI_NVM_PACE_US between NVM segments - the
+	 * author knew full speed is risky - yet the ram patch went out at pace 0u.
+	 * That patch is the 1,374-frame bulk write after which two boots measured
+	 * 165 KB of unstructured RX, six ROM diagnostic dumps and a board-id request
+	 * that never got an answer. 1,374 x 1.5 ms costs 2.06 s; the level budget
+	 * moves from 23.18 s to 25.2 s and the image timer is 30 s, so it fits.
+	 *
+	 * CTS is not an option here: this board reads IOS 0x1, so CTS idles low and
+	 * hardware flow control cannot back-pressure us. The gap between segments is
+	 * the only throttle available. */
+	err = bt_peri_tlv_download(pandora_peri_fw_mbn, sizeof(pandora_peri_fw_mbn),
+	    "PERI ram patch", BT_PERI_NVM_PACE_US, 1000u);
+	if (err) {
+		return err;
+	}
+	err = bt_peri_board_id_download(&bid);
+	if (err) {
+		return err;
+	}
+	if (bid && bid != 0xffffu) {
+		printf("PANDORA BT: board id %04x != 0000: HAL would load a .b%04x NVM variant; continuing with the embedded default variant as evidence only\n",
+		    bid, bid);
+		pandora_log_sync();
+	}
+	err = bt_peri_tlv_download(pandora_peri_nvm_bin, sizeof(pandora_peri_nvm_bin),
+	    "PERI NVM", BT_PERI_NVM_PACE_US, BT_PERI_NVM_LAST_ACK_MS);
+	if (err) {
+		return err;
+	}
+	/* Level 20.20: do NOT send the TLV end here. Both device runs that sent it
+	 * (20.18 and 20.19) got the ROM's diagnostic dump instead of the 12-byte
+	 * ACK + sub-09 build info push, even with ActivateSS already sent before
+	 * the patch; build info then read 0 bytes and level 19 failed. Keep the
+	 * function for the deferred (b) route, but leave the proven 20.17b chain:
+	 * NVM -> build info VSC. */
+	err = bt_peri_build_info();
+	if (err) {
+		printf("PANDORA BT: level 19 download %s (error %d)\n",
+		    err ? "FAIL" : "PASS", err);
+		pandora_log_sync();
+		return err;
+	}
+	printf("PANDORA BT: level 19 download PASS (error 0); no reset, no ActivateSS, link stays at 4 Mbps\n");
+	pandora_log_sync();
+	return 0;
+}
+
+static void
+bt_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	printf("PANDORA BT: thread start level=%d\n", bt_level);
+	pandora_log_sync();
+	if (bt_map_all()) {
+		printf("PANDORA BT: map_all FAILED\n");
+		pandora_log_sync();
+		goto out;
+	}
+	printf("PANDORA BT: mapped vote=%#llx rcg=%#llx halt=%#llx se=%#llx sw=%#llx uart=%#llx\n",
+	    (unsigned long long)bt_wins[BT_W_VOTE].va, (unsigned long long)bt_wins[BT_W_RCG].va,
+	    (unsigned long long)bt_wins[BT_W_HALT].va, (unsigned long long)bt_wins[BT_W_SE].va,
+	    (unsigned long long)bt_wins[BT_W_SWCTRL].va, (unsigned long long)bt_wins[BT_W_UART].va);
+	pandora_log_sync();
+	if (bt_level == 7) {
+		/* No BT rail votes, reset pulse, or TLMM programming in this mode.
+		 * The QUP clocks and UART configuration are still changed. */
+		if (bt_clocks()) {
+			goto out;
+		}
+		bt_loopback();
+		bt_report();
+		goto out;
+	}
+	if (bt_level >= 2) {
+		if (bt_power()) {
+			bt_report();
+			goto out;
+		}
+		if (bt_rf_clk()) {
+			goto out;
+		}
+		if (bt_level < 3 || bt_level == 6 || bt_level >= 8) {
+			/* level 6 also needs the SPMI windows mapped for its retries. */
+			if (bt_en_pulse()) {
+				goto out;
+			}
+		} else {
+			/* Preserve the inherited pad configuration. Its output level and
+			 * controller readiness have not been established by MODE alone. */
+			printf("PANDORA BT: level 3 keeps the iBoot BT_RESET level\n");
+			pandora_log_sync();
+		}
+		/* CTS in, RTS out LOW (the asserted "ready to receive" level Android
+		 * shows), TX out high, RX in; the UART mux is function 1. */
+		bt_pin(24, 1, 0, 2, -1);
+		bt_pin(25, 1, 1, 2, 0);
+		bt_pin(26, 1, 3, 2, 1);
+		bt_pin(27, 1, 0, 2, -1);
+		printf("PANDORA BT: RX pin level before the UART %#x (1 = WCN TX idle high)\n",
+		    bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT);
+		pandora_log_sync();
+		if (bt_level == 4) {
+			/* Isolated historical wait experiment; cold retries must not
+			 * silently inherit its 60-second delay. */
+			unsigned waited = 0;
+			uint32_t lvl = 0;
+			for (unsigned i = 0; i < 600; i++) {
+				lvl = bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT;
+				if (lvl) {
+					break;
+				}
+				bt_sleep(100 * 1000);
+				waited += 100;
+			}
+			printf("PANDORA BT: level 4 waited %u ms for the chip, RX %#x\n", waited, lvl);
+			pandora_log_sync();
+		}
+		if (bt_clocks()) {
+			bt_report();
+			goto out;
+		}
+		if (bt_level >= 8) {
+			int err = bt_uart_init(115200, false);
+			if (!err) {
+				bt_uart_dump();
+				err = bt_peri_probe();
+				if (!err && bt_level >= 16) {
+					/* Single board-id inquiry right after the successful
+				 * version exchange; silence is evidence, not a retry. */
+					err = bt_peri_board_id();
+				}
+				if (!err && bt_level >= 17) {
+					/* 4 Mbps negotiation after the read-only probes;
+					 * ends stopped at 4 Mbps for this one-shot probe. */
+					err = bt_peri_baud_switch();
+				}
+				if (!err && bt_level >= 19) {
+					/* Level 19: PERI firmware download at the proven
+					 * 4 Mbps link; the HAL's own gates are the success
+					 * criteria (per-segment ACK status 0, the level16
+					 * board-id reply, the post-download build info).
+					 * Level 20 continues with PeriReset + TME-L. */
+					err = bt_peri_download();
+					if (!err && bt_level >= 20) {
+						err = bt_peri_level20();
+					}
+				}
+				bt_uart_dump();
+			}
+			int stop_err = bt_uart_stop();
+			printf("PANDORA BT: PERI probe ended (error %d, UART stop %d)\n", err, stop_err);
+			bt_report();
+			goto out;
+		}
+		for (unsigned attempt = 1; attempt <= 3; attempt++) {
+			if (bt_uart_init(bt_level == 5 ? 4000000 : 115200, false) == 0) {
+				bt_uart_dump();
+				if (bt_try_hci_reset()) {
+					printf("PANDORA BT: controller answered on attempt %u\n", attempt);
+					pandora_log_sync();
+					break;
+				}
+			}
+			if (bt_level < 6 || attempt == 3) {
+				break;
+			}
+			/* hci_qca retries qca_power_on after a failed setup: drop the
+			 * enable pad, wait, then bring it back up before retrying. */
+			printf("PANDORA BT: attempt %u failed (RX %#x): power cycling\n", attempt,
+			    bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT);
+			pandora_log_sync();
+			if (bt_spmi_gpio(bt_bus0, bt_bus1, BT_SPMI_GPIO_PPID, 0x00, 1, "retry BT_RESET low")) {
+				goto out;
+			}
+			bt_sleep(100 * 1000);
+			if (bt_spmi_gpio(bt_bus0, bt_bus1, BT_SPMI_GPIO_PPID, 0x01, 1, "retry BT_RESET high")) {
+				goto out;
+			}
+			bt_sleep(150 * 1000);
+		}
+	} else {
+		bt_pmic_report();
+		printf("PANDORA BT: about to read RCG\n");
+		bt_rate = bt_rcg_rate();
+	}
+	printf("PANDORA BT: about to report\n");
+	pandora_log_sync();
+	bt_report();
+out:
+	pandora_log_sync();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_bt_init(void)
