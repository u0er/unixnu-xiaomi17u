+/* GetBuildInfoReq: Android's own post-download gate (failure = init
+ * reason 63). Frame 31 00 f0 ff 02 09 00, seven bytes; evt[12] is the
+ * build-info string length, evt[13..] the ASCII text. The trace's real
+ * response (t=9.9277) is 115 bytes total with 102 chars "BTFW.GAN...",
+ * so the buffer is sized for the HAL's 260-byte event read and the
+ * length bound is evt[12] <= got - 13 (evt[13..12+len] must fit in what
+ * actually arrived). The status byte at offset 9 is logged but not
+ * enforced, matching the HAL, which only requires the event read to
+ * succeed; Android's own trace shows the ROM may also emit this event
+ * on its own right after the NVM last-segment ACK. */
+static int
+bt_peri_build_info(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x02, 0x09, 0x00 };
+	static const uint8_t identity[] = { 0xf0, 0x01, 0x01, 0xf0, 0xff };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI build info request");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	/* The scan discards stale sub-06 ACKs (the trace's extra ACK at
+	 * t=9.921419 shows the ROM can emit one in this phase) before the
+	 * sub-09 build-info event is taken. */
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x09, "PERI build info");
+	if (err) {
+		printf("PANDORA BT: build info: no response (error %d) - HAL init failure reason 63\n",
+		    err);
+		bt_dump("PERI build info raw", rx, got);
+		pandora_log_sync();
+		return err;
+	}
+	if (got < 14u || rx[12] > got - 13u || rx[12] > sizeof(rx) - 14u ||
+	    memcmp(rx + 4, identity, sizeof(identity)) || rx[10] != 0x09) {
+		printf("PANDORA BT: build info event rejected: status %u subcmd %u len %u, %u bytes\n",
+		    got >= 10u ? rx[9] : 0xffu, got >= 11u ? rx[10] : 0xffu,
+		    got >= 13u ? rx[12] : 0xffu, got);
+		bt_dump("PERI build info ACK", rx, got);
+		pandora_log_sync();
+		return EPROTO;
+	}
+	printf("PANDORA BT: build info event status %u, %u chars: ", rx[9], rx[12]);
+	for (unsigned i = 0; i < rx[12]; i++) {
+		printf("%c", rx[13 + i]);
+	}
+	printf("\n");
+	return 0;
+}
+
+/* Level 19 orchestrator: the HAL download chain at the proven 4 Mbps link.
+ * Arbitrate -> ram patch (142 segments, last-segment ACK only) -> board
+ * id -> NVM (4 segments) -> build info gate. No reset, no ActivateSS,
+ * no further state change (level 20). */
+static int
+bt_peri_download(void)
+{
+	uint16_t bid = 0xffff;
+	int err;
+
+	printf("PANDORA BT: level 19 download: ram patch %u B + NVM %u B, 243-byte segments, last-segment ACK at 4 Mbps\n",
+	    (unsigned)sizeof(pandora_peri_fw_mbn), (unsigned)sizeof(pandora_peri_nvm_bin));
+	pandora_log_sync();
+	/* PatchConfigReq skipped exactly like the HAL's no_value property
+	 * path: that path sets the per-segment skip mode (SKIP_EVT_VSE_CC)
+	 * and skips the config command; both behaviors are replicated by
+	 * the segment loop below (non-last segments do not wait). */
+	printf("PANDORA BT: PatchConfigReq skipped (HAL no_value attribute path: non-last segments skip the ACK wait)\n");
+	pandora_log_sync();
+	err = bt_peri_arbitrate();
+	if (err) {
+		return err;
+	}
+	err = bt_peri_tlv_download(pandora_peri_fw_mbn, sizeof(pandora_peri_fw_mbn),
+	    "PERI ram patch", 0u, 1000u);
+	if (err) {
+		return err;
+	}
+	err = bt_peri_board_id_download(&bid);
+	if (err) {
+		return err;
+	}
+	if (bid && bid != 0xffffu) {
+		printf("PANDORA BT: board id %04x != 0000: HAL would load a .b%04x NVM variant; continuing with the embedded default variant as evidence only\n",
+		    bid, bid);
+		pandora_log_sync();
+	}
+	err = bt_peri_tlv_download(pandora_peri_nvm_bin, sizeof(pandora_peri_nvm_bin),
+	    "PERI NVM", BT_PERI_NVM_PACE_US, BT_PERI_NVM_LAST_ACK_MS);
+	if (err) {
+		return err;
+	}
+	err = bt_peri_build_info();
+	printf("PANDORA BT: level 19 download %s (error %d); no reset, no ActivateSS, link stays at 4 Mbps\n",
+	    err ? "FAIL" : "PASS", err);
+	pandora_log_sync();
+	return err;
+}
+
+static void
+bt_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	printf("PANDORA BT: thread start level=%d\n", bt_level);
+	pandora_log_sync();
+	if (bt_map_all()) {
+		printf("PANDORA BT: map_all FAILED\n");
+		pandora_log_sync();
+		goto out;
+	}
+	printf("PANDORA BT: mapped vote=%#llx rcg=%#llx halt=%#llx se=%#llx sw=%#llx uart=%#llx\n",
+	    (unsigned long long)bt_wins[BT_W_VOTE].va, (unsigned long long)bt_wins[BT_W_RCG].va,
+	    (unsigned long long)bt_wins[BT_W_HALT].va, (unsigned long long)bt_wins[BT_W_SE].va,
+	    (unsigned long long)bt_wins[BT_W_SWCTRL].va, (unsigned long long)bt_wins[BT_W_UART].va);
+	pandora_log_sync();
+	if (bt_level == 7) {
+		/* No BT rail votes, reset pulse, or TLMM programming in this mode.
+		 * The QUP clocks and UART configuration are still changed. */
+		if (bt_clocks()) {
+			goto out;
+		}
+		bt_loopback();
+		bt_report();
+		goto out;
+	}
+	if (bt_level >= 2) {
+		if (bt_power()) {
+			bt_report();
+			goto out;
+		}
+		if (bt_rf_clk()) {
+			goto out;
+		}
+		if (bt_level < 3 || bt_level == 6 || bt_level >= 8) {
+			/* level 6 also needs the SPMI windows mapped for its retries. */
+			if (bt_en_pulse()) {
+				goto out;
+			}
+		} else {
+			/* Preserve the inherited pad configuration. Its output level and
+			 * controller readiness have not been established by MODE alone. */
+			printf("PANDORA BT: level 3 keeps the iBoot BT_RESET level\n");
+			pandora_log_sync();
+		}
+		/* CTS in, RTS out LOW (the asserted "ready to receive" level Android
+		 * shows), TX out high, RX in; the UART mux is function 1. */
+		bt_pin(24, 1, 0, 2, -1);
+		bt_pin(25, 1, 1, 2, 0);
+		bt_pin(26, 1, 3, 2, 1);
+		bt_pin(27, 1, 0, 2, -1);
+		printf("PANDORA BT: RX pin level before the UART %#x (1 = WCN TX idle high)\n",
+		    bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT);
+		pandora_log_sync();
+		if (bt_level == 4) {
+			/* Isolated historical wait experiment; cold retries must not
+			 * silently inherit its 60-second delay. */
+			unsigned waited = 0;
+			uint32_t lvl = 0;
+			for (unsigned i = 0; i < 600; i++) {
+				lvl = bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT;
+				if (lvl) {
+					break;
+				}
+				bt_sleep(100 * 1000);
+				waited += 100;
+			}
+			printf("PANDORA BT: level 4 waited %u ms for the chip, RX %#x\n", waited, lvl);
+			pandora_log_sync();
+		}
+		if (bt_clocks()) {
+			bt_report();
+			goto out;
+		}
+		if (bt_level >= 8) {
+			int err = bt_uart_init(115200, false);
+			if (!err) {
+				bt_uart_dump();
+				err = bt_peri_probe();
+				if (!err && bt_level >= 16) {
+					/* Single board-id inquiry right after the successful
+				 * version exchange; silence is evidence, not a retry. */
+					err = bt_peri_board_id();
+				}
+				if (!err && bt_level >= 17) {
+					/* 4 Mbps negotiation after the read-only probes;
+					 * ends stopped at 4 Mbps for this one-shot probe. */
+					err = bt_peri_baud_switch();
+				}
+				if (!err && bt_level >= 19) {
+					/* Level 19: PERI firmware download at the proven
+					 * 4 Mbps link; the HAL's own gates are the success
+					 * criteria (per-segment ACK status 0, the level16
+					 * board-id reply, the post-download build info).
+					 * No reset, no ActivateSS, no further state change. */
+					err = bt_peri_download();
+				}
+				bt_uart_dump();
+			}
+			int stop_err = bt_uart_stop();
+			printf("PANDORA BT: PERI probe ended (error %d, UART stop %d)\n", err, stop_err);
+			bt_report();
+			goto out;
+		}
+		for (unsigned attempt = 1; attempt <= 3; attempt++) {
+			if (bt_uart_init(bt_level == 5 ? 4000000 : 115200, false) == 0) {
+				bt_uart_dump();
+				if (bt_try_hci_reset()) {
+					printf("PANDORA BT: controller answered on attempt %u\n", attempt);
+					pandora_log_sync();
+					break;
+				}
+			}
+			if (bt_level < 6 || attempt == 3) {
+				break;
+			}
+			/* hci_qca retries qca_power_on after a failed setup: drop the
+			 * enable pad, wait, then bring it back up before retrying. */
+			printf("PANDORA BT: attempt %u failed (RX %#x): power cycling\n", attempt,
+			    bt_rd(BT_W_UART, 3 * 0x1000u + 0x4) & BT_PIN_INPUT);
+			pandora_log_sync();
+			if (bt_spmi_gpio(bt_bus0, bt_bus1, BT_SPMI_GPIO_PPID, 0x00, 1, "retry BT_RESET low")) {
+				goto out;
+			}
+			bt_sleep(100 * 1000);
+			if (bt_spmi_gpio(bt_bus0, bt_bus1, BT_SPMI_GPIO_PPID, 0x01, 1, "retry BT_RESET high")) {
+				goto out;
+			}
+			bt_sleep(150 * 1000);
+		}
+	} else {
+		bt_pmic_report();
+		printf("PANDORA BT: about to read RCG\n");
+		bt_rate = bt_rcg_rate();
+	}
+	printf("PANDORA BT: about to report\n");
+	pandora_log_sync();
+	bt_report();
+out:
+	pandora_log_sync();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_bt_init(void)
+{
+	(void)PE_parse_boot_argn("pandora_bt", &bt_level, sizeof(bt_level));
+	if (!bt_level) {
+		return;
+	}
+	if (bt_level < 1 || bt_level > 19) {
+		printf("PANDORA BT: unsupported pandora_bt=%d (expected 1..19)\n", bt_level);
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(bt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* PANDORA */
