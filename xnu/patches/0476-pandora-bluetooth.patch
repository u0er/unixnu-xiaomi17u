+/* Level 20.18: TlvDnldEnd / DownloadAndCmdExeStatus at trace 9.921517:
+ * 31 00 f0 ff 0f 06 00 0c 01 01 00 x10 (20 bytes). Android sends it after
+ * the PERI patch and NVM and before build info; every earlier build skipped
+ * it, then went straight to PeriReset + the TME-L map. Observation only:
+ * a missing reply is logged and the level continues. */
+static int __unused
+bt_peri_tlv_end(void)
+{
+	static const uint8_t request[] = { 0x31, 0x00, 0xf0, 0xff, 0x0f, 0x06,
+	    0x00, 0x0c, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	    0x00, 0x00, 0x00, 0x00 };
+	uint8_t rx[BT_PERI_EVT_MAX] = {0};
+	unsigned got = 0;
+	uint64_t deadline;
+	int err;
+
+	err = bt_uart_tx(request, sizeof(request), "PERI TLV end");
+	if (err) {
+		return err;
+	}
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	err = bt_peri_wait_sub(rx, sizeof(rx), &got, deadline, 0x06,
+	    "PERI TLV end");
+	if (err) {
+		printf("PANDORA BT: TLV end: no reply (error %d, %u bytes); continuing\n",
+		    err, got);
+		bt_dump("PERI TLV end raw", rx, got);
+		pandora_log_sync();
+		return 0;
+	}
+	printf("PANDORA BT: TLV end reply subcmd %u status %u, %u bytes\n",
+	    got >= 11u ? rx[10] : 0xffu, got >= 10u ? rx[9] : 0xffu, got);
+	bt_dump("PERI TLV end reply", rx, got);
+	pandora_log_sync();
+	return 0;
+}
