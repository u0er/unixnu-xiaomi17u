+/* ---------------------------------------------------------------------------
+ * camera7b: guarded C-PHY lane mode word (lane+0x94).
+ *
+ * Android's live dump and the vendor 3-phase table both read 0x0d; every probe
+ * through camera6 wrote 0x01 and still saw CPHY header errors with no EOF.
+ * camera7 (0582) wrote 0x0d from the lane table with no guard and that boot
+ * never came back, so the word is applied here as a single-variable trial with
+ * a hard ceiling: establish 0x01 (the value every earlier boot survived),
+ * write 0x0d, settle, read all three lanes back, wait a bounded time, and on
+ * mismatch/timeout restore 0x01 and report. The wait cannot manufacture a
+ * pass; it only stops a non-answering PHY from holding the boot, and the probe
+ * then continues on the known-good word.
+ * ------------------------------------------------------------------------- */
+#define PC_CPHY_LANE94        0x94u
+#define PC_CPHY_LANE94_SAFE   0x01u
+#define PC_CPHY_LANE94_TRIAL  0x0du
+#define PC_CPHY_REFGEN        0x1184u
+#define PC_CPHY_REFGEN_READY  0x80u
+#define PC_CPHY_RESET         0x1000u
+#define PC_CPHY_RESET_ASSERT  0x01u
+#define PC_CPHY_SETTLE_US     200u
+#define PC_CPHY_TRIAL_MS      100u
+
+/* Write one lane word to all three C-PHY lane banks and read it back. pc_wr()
+ * already reads its own register back; this adds the cross-lane check that a
+ * single table entry cannot express. */
+static int
+pc_cphy_lane94_rw(vm_offset_t phy0, const uint32_t lane_off[3], uint32_t val,
+    uint32_t rb[3])
+{
+	for (unsigned i = 0; i < 3; i++)
+		pc_wr(phy0, lane_off[i] + PC_CPHY_LANE94, val);
+	delay(PC_CPHY_SETTLE_US);
+	for (unsigned i = 0; i < 3; i++)
+		rb[i] = pc_rd(phy0, lane_off[i] + PC_CPHY_LANE94);
+	return (rb[0] == val && rb[1] == val && rb[2] == val) ? 0 : -1;
+}
+
+/* Bounded readiness wait: require_release=0 asks only for refgen up (the word
+ * is written while reset is still asserted); 1 also asks reset to be released. */
+static int
+pc_cphy_wait(vm_offset_t phy0, unsigned budget_ms, int require_release)
+{
+	for (unsigned waited = 0; waited < budget_ms; waited++) {
+		if (pc_rd(phy0, PC_CPHY_REFGEN) & PC_CPHY_REFGEN_READY) {
+			if (!require_release ||
+			    !(pc_rd(phy0, PC_CPHY_RESET) & PC_CPHY_RESET_ASSERT))
+				return 0;
+		}
+		pc_sleep(1);
+	}
+	return -1;
+}
+
+/* Mask every PHY IRQ source in the v25 window. Used on a failed trial so a
+ * dead 0x0d lane cannot leave the BIST/event domain enabled while the probe
+ * continues on 0x01. */
+static void
+pc_cphy_irq_mask(vm_offset_t phy0)
+{
+	for (uint32_t o = 0x102Cu; o <= 0x1054u; o += 4u)
+		pc_wr(phy0, o, 0u);
+}
+
+__attribute__((noinline))
+static int
+pc_cphy_lane94_trial(vm_offset_t phy0, const uint32_t lane_off[3])
+{
+	uint32_t pre[3], rb[3];
+
+	(void)pc_cphy_lane94_rw(phy0, lane_off, PC_CPHY_LANE94_SAFE, pre);
+	if (pc_cphy_lane94_rw(phy0, lane_off, PC_CPHY_LANE94_TRIAL, rb)) {
+		printf("PANDORA SLICEB: camera7b lane94 w=%#x rb=%#x/%#x/%#x "
+		    "mismatch -> restore %#x\n", PC_CPHY_LANE94_TRIAL, rb[0],
+		    rb[1], rb[2], PC_CPHY_LANE94_SAFE);
+		(void)pc_cphy_lane94_rw(phy0, lane_off, PC_CPHY_LANE94_SAFE, rb);
+		pc_cphy_irq_mask(phy0);
+		printf("PANDORA SLICEB: camera7b RESULT lane94=0x01 "
+		    "fallback=readback rb=%#x/%#x/%#x irq=masked\n", rb[0], rb[1], rb[2]);
+		(void)pandora_log_sync();
+		return -1;
+	}
+	if (pc_cphy_wait(phy0, PC_CPHY_TRIAL_MS, 0)) {
+		printf("PANDORA SLICEB: camera7b lane94 CPHY timeout %ums "
+		    "refgen=%#x ctrl0=%#x\n", PC_CPHY_TRIAL_MS,
+		    pc_rd(phy0, PC_CPHY_REFGEN), pc_rd(phy0, PC_CPHY_RESET));
+		(void)pc_cphy_lane94_rw(phy0, lane_off, PC_CPHY_LANE94_SAFE, rb);
+		pc_cphy_irq_mask(phy0);
+		printf("PANDORA SLICEB: camera7b RESULT lane94=0x01 "
+		    "fallback=timeout rb=%#x/%#x/%#x irq=masked\n", rb[0], rb[1], rb[2]);
+		(void)pandora_log_sync();
+		return -1;
+	}
+	printf("PANDORA SLICEB: camera7b RESULT lane94=0x0d trial=ok "
+	    "w=%#x rb=%#x/%#x/%#x pre=%#x/%#x/%#x wait<=%ums\n",
+	    PC_CPHY_LANE94_TRIAL, rb[0], rb[1], rb[2], pre[0], pre[1],
+	    pre[2], PC_CPHY_TRIAL_MS);
+	(void)pandora_log_sync();
+	return 0;
+}
