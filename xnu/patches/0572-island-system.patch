 		uint32_t inset = 0;
-		while ((2 * (int64_t)inset + 1 - h) * (2 * (int64_t)inset + 1 - h) + dy * dy > (int64_t)h * h) {
+		while ((2 * (int64_t)inset + 1 - b.h) * (2 * (int64_t)inset + 1 - b.h) + dy * dy > (int64_t)b.h * b.h) {
 			inset++;
 		}
-		uint32_t *row = (uint32_t *)(pixels + s->offset + (uint64_t)(y0 + y) * s->bytesPerRow);
-		for (uint32_t x = x0 + inset; x < x0 + w - inset; x++) {
+		uint32_t *row = (uint32_t *)(pixels + s->offset + (uint64_t)(b.y0 + y) * s->bytesPerRow);
+		for (uint32_t x = b.x0 + inset; x < b.x0 + b.w - inset; x++) {
 			row[x] = 0xff000000;
 		}
-		flush_dcache((vm_offset_t)(row + x0), w * 4, FALSE);
+		flush_dcache((vm_offset_t)(row + b.x0), b.w * 4, FALSE);
+	}
+}
+
+/* nezha_system_island=1: the UIKit-shaped capsule (radius 16, 4x4 AA edges). */
+static void
+nezha_draw_system_capsule(SweetSurface *s)
+{
+	struct nezha_island_box b;
+	if (!nezha_island_geometry(s, &b)) {
+		return;
+	}
+	uintptr_t pixels = s->kernelAddress();
+	if (!pixels) {
+		return;
+	}
+	static int logged;
+	if (!logged) {
+		logged = 1;
+		IOLog("NEZHA island: UIKit capsule %ux%u at %u,%u r=%u\n", b.w, b.h, b.x0, b.y0, b.r);
+	}
+	for (uint32_t y = 0; y < b.h; y++) {
+		uint32_t *row = (uint32_t *)(pixels + s->offset + (uint64_t)(b.y0 + y) * s->bytesPerRow);
+		for (uint32_t x = 0; x < b.w; x++) {
+			const uint32_t cov = nezha_island_coverage(b.x0 + x, b.y0 + y, &b);
+			if (cov == 0) {
+				continue;
+			}
+			uint32_t *p = row + b.x0 + x;
+			*p = cov == 16 ? 0xff000000u :
+			    (0xff000000u | (sweet_fb_scale(*p, (16 - cov) * 16) & 0x00ffffffu));
+		}
+		flush_dcache((vm_offset_t)(row + b.x0), b.w * 4, FALSE);
 	}
 }
