+/* LANE_ISLAND: UIKit frame {{132.5, 12.875}, {110, 32}} on the 375 pt logical
+ * screen, radius 16. Both paths rasterize that one integer box, so a UIKit
+ * aperture and this capsule cannot show a second black edge. */
+struct nezha_island_box {
+	uint32_t x0, y0, w, h, r;
+};
+
+static bool
+nezha_island_geometry(SweetSurface *s, struct nezha_island_box *b)
 {
 	if (!s->memory || s->pixelFormat != 0x42475241 || s->bytesPerElement != 4 ||
 	    s->elementWidth != 1 || s->elementHeight != 1 || s->width < 375 ||
 	    s->bytesPerRow < (uint64_t)s->width * 4 ||
 	    (uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height > s->memory->getLength()) {
+		return false;
+	}
+	b->w = s->width * 110 / 375;
+	b->h = s->width * 32 / 375;
+	b->x0 = (s->width - b->w) / 2;
+	b->y0 = s->width * 14 / 375 - (s->width * 2 + 600) / 1200;
+	b->r = b->h / 2;
+	return b->w >= 4 && b->h >= 4 && b->y0 + b->h <= s->height;
+}
+
+/* 4x4 subpixel coverage of one pixel against the capsule; integer only. */
+static uint32_t
+nezha_island_coverage(uint32_t x, uint32_t y, const struct nezha_island_box *b)
+{
+	const int64_t c1 = ((int64_t)b->x0 + b->r) * 16, c2 = ((int64_t)b->x0 + b->w - b->r) * 16;
+	const int64_t cy = ((int64_t)b->y0 * 2 + b->h) * 8;
+	const int64_t r2 = (int64_t)b->r * b->r * 256;
+	uint32_t cov = 0;
+
+	for (uint32_t i = 0; i < 4; i++) {
+		const int64_t sx = (int64_t)x * 16 + 4 * (int64_t)i + 2;
+		const int64_t dx = sx < c1 ? c1 - sx : (sx > c2 ? sx - c2 : 0);
+		for (uint32_t j = 0; j < 4; j++) {
+			const int64_t sy = (int64_t)y * 16 + 4 * (int64_t)j + 2;
+			const int64_t dy = sy - cy;
+			if (dx * dx + dy * dy <= r2) {
+				cov++;
+			}
+		}
+	}
+	return cov;
+}
+
