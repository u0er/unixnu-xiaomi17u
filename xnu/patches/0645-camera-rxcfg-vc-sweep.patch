index b5f071514b4b..9fb1164826b7 100644
--- a/bsd/dev/pandora_camera.c
+++ b/bsd/dev/pandora_camera.c
@@ -6625,6 +6625,50 @@
 	pc_sliceb_vfe2_arm_at(vfe2, 0x2c00u);
