diff --git a/bsd/dev/apple_usbmux.c b/bsd/dev/apple_usbmux.c
--- a/bsd/dev/apple_usbmux.c
+++ b/bsd/dev/apple_usbmux.c
@@ -322,6 +322,16 @@
 	(void)ring_init(&c->out, AMUX_RING);
 	if (svc->open != NULL) {
 		svc->open(c, &c->ctx);
+		if (c->ctx == NULL) {
+			/* the service has no room: refuse here instead of letting
+			 * input() see a NULL context.  conn_release() first so the
+			 * slot is free again before the RST goes out. */
+			printf("APPLE MUX: service %s refused port %u\n",
+			    svc->name, hdport);
+			conn_release(c);
+			mux_send_small(hdport, hsport, 0, seq + 1, TH_RST | TH_ACK);
+			return;
+		}
 	}
 	mux_send_small(c->sport, c->dport, c->tx_seq, c->rx_seq, TH_SYN | TH_ACK);
 	c->tx_seq++;
