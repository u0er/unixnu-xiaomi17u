+/*
+ *	Total number of blocks described by one extent record.
+ */
+static u_int32_t ExtentRecordBlocks(
+	const HFSPlusExtentRecord	extents)
+{
+	u_int32_t	blocks = 0;
+	int			index;
+
+	for (index = 0; index < kHFSPlusExtentDensity; ++index) {
+		if (extents[index].blockCount == 0)
+			break;
+		blocks += extents[index].blockCount;
+	}
+
+	return blocks;
+}
