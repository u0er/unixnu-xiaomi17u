+/*
+ *	Routine:	FindNextExtentRecord
+ *
+ *	Purpose:	Find the first extent record of a fork whose key is greater
+ *				than startBlock.  A hit means the fork has records that its
+ *				chain cannot reach, which is how a hole is told apart from the
+ *				end of the chain.
+ */
+static OSErr FindNextExtentRecord(
+	const ExtendedVCB		*vcb,
+	u_int8_t				forkType,
+	u_int32_t				fileID,
+	u_int32_t				startBlock,
+	HFSPlusExtentKey		*foundKey,
+	HFSPlusExtentRecord		foundData,
+	u_int32_t				*foundHint)
+{
+	FCB *					fcb;
+	struct BTreeIterator *	btIterator = NULL;
+	FSBufferDescriptor		btRecord;
+	HFSPlusExtentKey *		extentKeyPtr;
+	OSErr					err;
+	u_int16_t				btRecordSize = 0;
+
+	fcb = GetFileControlBlock(vcb->extentsRefNum);
+
+	btIterator = hfs_malloc_type(struct BTreeIterator);
+	extentKeyPtr = (HFSPlusExtentKey*) &btIterator->key;
+	extentKeyPtr->keyLength	 = kHFSPlusExtentKeyMaximumLength;
+	extentKeyPtr->forkType	 = forkType;
+	extentKeyPtr->pad		 = 0;
+	extentKeyPtr->fileID	 = fileID;
+	extentKeyPtr->startBlock = startBlock;
+
+	btRecord.bufferAddress	= foundData;
+	btRecord.itemSize		= sizeof(HFSPlusExtentRecord);
+	btRecord.itemCount		= 1;
+
+	/*
+	 *	A miss leaves the iterator at the insert point, so one "next record"
+	 *	step lands on the first record with a greater key; a hit is stepped
+	 *	over for the same reason.
+	 */
+	err = BTSearchRecord(fcb, btIterator, &btRecord, &btRecordSize, btIterator);
+	if (err == noErr || err == btNotFound)
+		err = BTIterateRecord(fcb, kBTreeNextRecord, btIterator, &btRecord, &btRecordSize);
+
+	if (err == noErr) {
+		if (extentKeyPtr->fileID != fileID || extentKeyPtr->forkType != forkType) {
+			err = btNotFound;			/* following record is another fork */
+		} else {
+			if (foundKey)
+				BlockMoveData(extentKeyPtr, foundKey, sizeof(HFSPlusExtentKey));
+			if (foundHint)
+				*foundHint = btIterator->hint.nodeNum;
+		}
+	}
+
+	hfs_free_type(btIterator, struct BTreeIterator);
+	return err;
+}
