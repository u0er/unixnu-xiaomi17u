+/*
+ *	Report whether every extent of a record is present.  Only the last record
+ *	of a chain may be partially filled.
+ */
+static Boolean ExtentRecordFull(
+	const HFSPlusExtentRecord	extents)
+{
+	int	index;
+
+	for (index = 0; index < kHFSPlusExtentDensity; ++index) {
+		if (extents[index].blockCount == 0)
+			return false;
+	}
+	return true;
+}
+
+
+/*
+ *	Report whether two extent records map any of the same volume blocks.
+ */
+static Boolean ExtentRunsOverlap(
+	const HFSPlusExtentRecord	first,
+	const HFSPlusExtentRecord	second)
+{
+	int			firstIndex;
+	int			secondIndex;
+
+	for (firstIndex = 0; firstIndex < kHFSPlusExtentDensity; ++firstIndex) {
+		u_int64_t	firstStart;
+		u_int64_t	firstEnd;
+
+		if (first[firstIndex].blockCount == 0)
+			break;
+		firstStart = first[firstIndex].startBlock;
+		firstEnd = firstStart + first[firstIndex].blockCount;
+
+		for (secondIndex = 0; secondIndex < kHFSPlusExtentDensity; ++secondIndex) {
+			u_int64_t	secondStart;
+			u_int64_t	secondEnd;
+
+			if (second[secondIndex].blockCount == 0)
+				break;
+			secondStart = second[secondIndex].startBlock;
+			secondEnd = secondStart + second[secondIndex].blockCount;
+			if (firstStart < secondEnd && secondStart < firstEnd)
+				return true;
+		}
+	}
+
+	return false;
+}
+
