+/*
+ *	Routine:	CheckExtentChain
+ *
+ *	Purpose:	Preflight the overflow chain a truncate is about to release.
+ *				Every record must sit exactly at the cursor defined by the
+ *				catalog-inline record and the records already walked, must be
+ *				non-empty and fit below chainEnd, and may not re-map a block
+ *				the inline record owns.  Nothing is released here.
+ *
+ *				The inline extents belong to the fork whose record the caller
+ *				passed in, so their owner is known.  A double allocation
+ *				between an overflow record and *another* fork's inline extents
+ *				cannot be attributed without a catalog-wide block index, which
+ *				HFS+ does not keep; the exact cursor walk is the defense in
+ *				depth for that residual case.
+ */
+static OSErr CheckExtentChain(
+	ExtendedVCB					*vcb,
+	u_int8_t					forkType,
+	u_int32_t					fileID,
+	const HFSPlusExtentRecord	inlineExtents,
+	u_int32_t					startBlock,
+	u_int32_t					chainEnd)
+{
+	HFSPlusExtentKey	key;
+	HFSPlusExtentRecord	extents;
+	u_int32_t			hint;
+	u_int32_t			cursor;
+	u_int32_t			recordBlocks;
+	OSErr				err = noErr;
+	int					lockflags;
+
+	if (vcb->vcbSigWord == kHFSSigWord) {
+		return noErr;		/* plain HFS extent keys have another layout */
+	}
+
+	if (startBlock > chainEnd
+	||  ExtentRecordBlocks(inlineExtents) > chainEnd) {
+		hfs_mark_inconsistent((struct hfsmount *)vcb, HFS_INCONSISTENCY_DETECTED);
+		return ESTALE;
+	}
+
+	/*
+	 *	A catalog-inline record that is not full ends the fork's mapping, so
+	 *	no overflow record may follow it.
+	 */
+	if (!ExtentRecordFull(inlineExtents) && startBlock < chainEnd) {
+		hfs_mark_inconsistent((struct hfsmount *)vcb, HFS_INCONSISTENCY_DETECTED);
+		return ESTALE;
+	}
+
+	lockflags = hfs_systemfile_lock(vcb, SFL_EXTENTS, HFS_EXCLUSIVE_LOCK);
+
+	cursor = startBlock;
+	while (cursor < chainEnd) {
+		err = FindExtentRecord(vcb, forkType, fileID, cursor, false, &key, extents, &hint);
+		if (err == btNotFound) {
+			/*
+			 *	A record at a higher key is a hole; no record at all is a
+			 *	short chain.  Both leave [cursor, chainEnd) unmapped.
+			 */
+			err = ESTALE;
+			break;
+		}
+		if (err != noErr)
+			break;
+
+		recordBlocks = ExtentRecordBlocks(extents);
+		if (key.startBlock != cursor
+		||  recordBlocks == 0
+		||  recordBlocks > chainEnd - cursor
+		||  ExtentRunsOverlap(extents, inlineExtents)) {
+			err = ESTALE;
+			break;
+		}
+
+		/*
+		 *	Only the last record of a chain may be partially filled.
+		 */
+		if (!ExtentRecordFull(extents) && cursor + recordBlocks < chainEnd) {
+			err = ESTALE;
+			break;
+		}
+
+		cursor += recordBlocks;
+	}
+	hfs_systemfile_unlock(vcb, lockflags);
+
+	if (err == ESTALE)
+		hfs_mark_inconsistent((struct hfsmount *)vcb, HFS_INCONSISTENCY_DETECTED);
+
+	return err;
+}
