+/*
+ * Carrier has exactly ONE source of truth: ud_carrier_up().  SIOCGIFMEDIA (what
+ * configd's KernelEventMonitor reads), the KEV_DL_LINK_ON/OFF event and the
+ * console line all call it, so the ring cannot disagree with the state the
+ * stack acts on.
+ *
+ * It is a LINK property, not a traffic property: ue0 carries frames whenever
+ * ud.configured is true (ud_if_output only checks that), and a host that
+ * leaves the NCM data interface at alt 0 still hands us NTBs.  That is why
+ * "rx/tx frames" could never prove the link was up.
+ */
+static bool
+ud_carrier_up(void)
+{
+	if (!ud.configured) {
+		return false;
+	}
+	/* NCM 1.1 section 6.2.2: alt 0 is the reset state of the data interface,
+	 * so the NCM link only exists at alt 1.  ECM and the Apple mux have a
+	 * single altsetting, where "configured" is the whole answer. */
+	if (ud_has_ncm()) {
+		return ud.data_alt == 1;
+	}
+	return true;
+}
+
+/*
+ * Publish a carrier transition once: the console line whose boot-time
+ * acceptance token is "ue0 carrier=1", plus the link event that belongs with
+ * it.  A repeated state prints nothing, so re-selects and re-enumerations
+ * cannot fake a second link-up.
+ */
+static void
+ud_carrier_publish(const char *why)
+{
+	static int last = -1;
+	int        up = ud_carrier_up() ? 1 : 0;
+
+	if (up == last) {
+		return;
+	}
+	last = up;
+	ud_link_event(up != 0);
+	printf("SWEET USB: ue0 carrier=%d (configured %u data_alt %u, %s)\n",
+	    up, ud.configured ? 1 : 0, (unsigned)ud.data_alt, why);
+}
